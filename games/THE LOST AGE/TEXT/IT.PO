msgctxt "message"
msgid "05885"
msgstr "Si sente il rumore dell'acqua{line_break}laggiù in fondo.{end_wait}"

msgctxt "message"
msgid "05886"
msgstr "Non si vede il fondo{line_break}del pozzo. Dev'essere{line_break}profondissimo.{end_wait}"

msgctxt "message"
msgid "05887"
msgstr "Guardando meglio,{line_break}pare che il pozzo{line_break}sia asciutto.{end_wait}"

msgctxt "message"
msgid "05888"
msgstr "È un pozzo pulito,{line_break}molto ben tenuto.{end_wait}"

msgctxt "message"
msgid "05889"
msgstr "È pieno d'acqua{line_break}limpida e fresca.{end_wait}"

msgctxt "message"
msgid "05890"
msgstr "Dal fondo si sentono{line_break}le rane gracidare.{end_wait}"

msgctxt "message"
msgid "05891"
msgstr "Oh, Kraden... per quanto ancora{line_break}quest'isola continuerà{line_break}a muoversi?{end_wait}"

msgctxt "message"
msgid "05892"
msgstr "Non lo so...{line_break}Speravo che lo{line_break}sapessi tu.{end_wait}"

msgctxt "message"
