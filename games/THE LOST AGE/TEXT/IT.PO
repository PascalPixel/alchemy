msgctxt "message"
msgid "12799"
msgstr "Sembra che l'acqua di mare{line_break}sia entrata nel pozzo.{page_break}Sarà impossibile usarlo{line_break}per qualche tempo.{end_wait}"

msgctxt "message"
msgid "12800"
msgstr "C'è un passaggio{line_break}in fondo al pozzo!{page_break}Chissà se anche altri{line_break}lo sanno...{end_wait}"

msgctxt "message"
msgid "12801"
msgstr "È pieno d'acqua.{line_break}Il fondo è profondo.{end_wait}"

msgctxt "message"
msgid "12802"
msgstr "Che? Ho visto la figura{line_break}di un uomo nel pozzo!{end_wait}"

msgctxt "message"
msgid "12803"
msgstr "Sembra che questo pozzo{line_break}non venga usato.{page_break}Forse perché è così{line_break}lontano dal centro della città.{end_wait}"

msgctxt "message"
msgid "12804"
msgstr "C'è pochissima acqua{line_break}in fondo al pozzo.{page_break}Fa così caldo qui che{line_break}l'acqua evapora in fretta.{end_wait}"

msgctxt "message"
msgid "12805"
msgstr "Questo pozzo è antico.{page_break}È rimasto identico{line_break}a come era allora.{end_wait}"

msgctxt "message"
msgid "12806"
msgstr "Ci sono delle patate che{line_break}bollono in pentola.{page_break}Forse servono per{line_break}un'insalata di patate.{end_wait}"

msgctxt "message"
msgid "12807"
msgstr "Fanno il pane.{page_break}È strano, però...{line_break}Qui a Madra, ci mettono{line_break}noci e uvetta.{end_wait}"

msgctxt "message"
msgid "12808"
msgstr "Tutte le spezie sono{line_break}ben preparate.{page_break}La tavola a Madra non{line_break}sarebbe pronta senza di esse.{end_wait}"

msgctxt "message"
msgid "12809"
msgstr "Il pollo al curry{line_break}cuoce lentamente.{page_break}A giudicare dall'odore{line_break}e dal colore rosso, devono{line_break}esserci molti pomodori.{end_wait}"

msgctxt "message"
msgid "12810"
msgstr "Il tè Masala{line_break}sta bollendo.{page_break}È pieno di latte, ed ha{line_break}un profumo delizioso.{line_break}Mmm... che buono!{end_wait}"

msgctxt "message"
msgid "12811"
msgstr "Cucinano pollo tandoori.{page_break}A Madra, lo cucinano alla{line_break}griglia. È uno dei loro{line_break}piatti più famosi.{end_wait}"

msgctxt "message"
msgid "12812"
msgstr "Il pollo arrosto{line_break}è così grande che non{line_break}entra nel forno!{page_break}Hmm... chissà se è{line_break}il pollo che stava{line_break}fuori! Speriamo di no!{end_wait}"

msgctxt "message"
msgid "12813"
msgstr "Uova fresche...{line_break}Alcuni ci preparano{line_break}l'omelette!{page_break}Per colazione sono{line_break}buonissime!{end_wait}"

msgctxt "message"
msgid "12814"
msgstr "Quel formaggio sembra{page_break}ottimo...{line_break}Forse con un po' di pane...{line_break}Ahh! Che fame!{end_wait}"

msgctxt "message"
msgid "12815"
msgstr "Bleah!{line_break}Friggono le larve!!!{page_break}Che schifo!{line_break}Ma che BUON odore!{end_wait}"

msgctxt "message"
msgid "12816"
msgstr "Cucinano agnello{line_break}alla fiamma. La carne{line_break}è ben cotta e succosa.{page_break}Si noterebbe se ne{line_break}sparisse un pezzo... Peccato.{end_wait}"

msgctxt "message"
msgid "12817"
msgstr "Cos'è!?{line_break}Aragosta alla griglia!{page_break}Vorrei provare una{line_break}tale delizia, almeno{line_break}una volta nella vita!{end_wait}"

msgctxt "message"
msgid "12818"
msgstr "Cucinano qualcosa{line_break}a fiamma alta.{page_break}Sarà del cibo, o{line_break}preparano una medicina?{end_wait}"

msgctxt "message"
msgid "12819"
msgstr "Ci sono delle strane{line_break}piante che bollono{line_break}in pentola.{page_break}L'odore è familiare, ma{line_break}non so cosa sia.{end_wait}"

msgctxt "message"
msgid "12820"
msgstr "Verdure di stagione{line_break}cucinate con l'agnello.{page_break}Il condimento di ostriche{line_break}è invitante.{end_wait} "

msgctxt "message"
msgid "12821"
msgstr "C'è un tortino che{line_break}cuoce nel forno.{page_break}La sua reputazione{line_break}precede il suo odore fragrante.{end_wait}"

msgctxt "message"
msgid "12822"
msgstr "Sembra una zuppa{line_break}di pesce.{page_break}Odora di oceano!{end_wait}"

msgctxt "message"
msgid "12823"
msgstr "È la famosa aragosta{line_break}bollita di Alhafra!{page_break}È più grande di{line_break}quanto si possa immaginare!{end_wait}"

msgctxt "message"
msgid "12824"
msgstr "La zuppa ha una{line_break}grande varietà di pesce.{page_break}Un solo boccone{line_break}e non potrei smettere!{end_wait}"

msgctxt "message"
msgid "12825"
msgstr "L'acciaio che riposa fra le{line_break}fiamme è rosso fuoco.{page_break}Dev'essere qui che forgiano{line_break}gli oggetti.{end_wait}"

msgctxt "message"
msgid "12826"
msgstr "A cuocere c'è del pesce che{line_break}non ho mai visto prima.{page_break}Mi chiedo come possa{line_break}essere questa zuppa...{line_break}Forse non voglio saperlo.{end_wait}"

msgctxt "message"
msgid "12827"
msgstr "Preparano una zuppa{line_break}di fagioli e{line_break}pomodori rossi.{page_break}L'odore è incredibile,{line_break}ma potrebbe essere{line_break}troppo piccante per me.{end_wait}"

msgctxt "message"
msgid "12828"
msgstr "Ah, l'odore del pane fresco{line_break}che cuoce nel forno!{page_break}Ho già l'acquolina{line_break}in bocca!{end_wait}"

msgctxt "message"
msgid "12829"
msgstr "Contigo è famosa per i{line_break}biscotti...{page_break}Anche se si ha la{line_break}ricetta, ci vogliono anni{line_break}per imparare a prepararli.{end_wait}"

msgctxt "message"
msgid "12830"
msgstr "Il pesce che sta arrostendo{line_break}viene dal fiume.{page_break}Il fumo mi va negli occhi.{end_wait}"

msgctxt "message"
msgid "12831"
msgstr "Questa è una zuppa{line_break}tradizionale.{page_break}È una ricetta tramandata{line_break}di generazione in{line_break}generazione.{end_wait}"

msgctxt "message"
msgid "12832"
msgstr "Non ho mai visto delle{line_break}verdure così.{page_break}Bleah! Che puzza!{line_break}Ma le mangiano davvero!?{end_wait}"

msgctxt "message"
msgid "12833"
msgstr "Questo è stufato Kaltic,{line_break}con agnello e patate.{page_break}Ottimo, se piace{line_break}la carne bollita.{end_wait}"

msgctxt "message"
msgid "12834"
msgstr "Le verdure che bollono{line_break}sembrano erbacce.{page_break}Di certo non sarò io{line_break}a doverle assaggiare.{end_wait}"

msgctxt "message"
msgid "12835"
msgstr "C'è del formaggio nello{page_break}stufato. Ehi! Ha la muffa!{line_break}È normale?{end_wait}"

msgctxt "message"
msgid "12836"
msgstr "Questo è un piatto preparato{line_break}con uova di pesce.{page_break}C'è qualcosa che fuoriesce,{line_break}chissà se è normale.{end_wait}"

msgctxt "message"
msgid "12837"
msgstr "La carne che usano,{line_break}non l'ho mai vista prima.{page_break}Invece della legna, usano{line_break}corna di cervo per{line_break}cucinare.{page_break}Chissà se carne e{line_break}corna provengono dallo{line_break}stesso animale.{end_wait}"

msgctxt "message"
msgid "12838"
msgstr "C'è un diario del{line_break}capitano qui.{page_break}Si parla di un viaggio{line_break}segreto a Lemuria...{line_break}Non c'è altro.{end_wait}"

msgctxt "message"
msgid "12839"
msgstr "C'è un libro intitolato: \"Le{line_break}grandi avventure di Lunpa\".{line_break}Scritto da Lunpa.{page_break}\"Quando venne l'inondazione,{line_break}ce ne andammo in nave.{line_break}Le onde ci presero.{page_break}Arrivammo in una strana{line_break}terra, chiamata Lemuria\".{end_wait}"

msgctxt "message"
msgid "12840"
msgstr "C'è una lettera di Babi.{line_break}All'esterno, c'è scritto:{line_break}\"Al mio caro amico Lunpa\".{page_break}Babi ha scritto, \"Perdonami,{line_break}Lunpa, ma devo lasciare{line_break}l'isola senza di te\".{end_wait} "

msgctxt "message"
msgid "12841"
msgstr "C'è un libro intitolato:{line_break}\"La storia di Lemuria\".{page_break}Un estratto: \"Solo le tracce{line_break}di quella terra d'oro{line_break}rimangono oggi\".{end_wait}"

msgctxt "message"
msgid "12842"
msgstr "C'è un libro intitolato:{line_break}\"I fari elementali\".{page_break}Dice: \"I fari dei{line_break}quattro elementi illuminano{line_break}gli angoli di Weyard\".{end_wait}"

msgctxt "message"
msgid "12843"
msgstr "C'è un libro intitolato: \"La{line_break}gente di Lemuria\".{page_break}\"Il maestro dell'acqua{line_break}sarà un figlio di{line_break}Lemuria\". {end_wait}"

msgctxt "message"
msgid "12844"
msgstr "C'è un libro intitolato:{line_break}\"L'Alchimia e le antiche{line_break}civiltà - Parte I\".{page_break}\"Con l'uso dell'Alchimia,{line_break}la civiltà affronta{line_break}cambiamenti enormi\".{end_wait}"

msgctxt "message"
msgid "12845"
msgstr "C'è un libro intitolato:{line_break}\"L'Alchimia e le antiche{line_break}civiltà - Parte II\".{page_break}\"Chi domina l'Alchimia,{line_break}domina il mondo\".{end_wait}"

msgctxt "message"
msgid "12846"
msgstr "C'è un libro intitolato:{line_break}\"Il diario di Hydros\".{page_break}\"{actor_name:8} è ancora{line_break}vivo. Prego{line_break}per il suo ritorno\".{end_wait}"

msgctxt "message"
msgid "12847"
msgstr "È piacevolmente fresco.{end_wait}"

msgctxt "message"
msgid "12848"
msgstr "Che...!!! {control_15:4}{control_15:4}{page_break}{control_12:11}Perché tanti accappatoi?!?{line_break}Dove sono i bagni?{end_wait}"

msgctxt "message"
msgid "12849"
msgstr "Finalmente! Siamo a Vale.{end_wait}"

msgctxt "message"
msgid "12850"
msgstr "... ...{end_wait}"

msgctxt "message"
msgid "12851"
msgstr "Che c'è, {actor_name:2}?{line_break}Sei a casa.{line_break}Non sei contento?{end_wait}"

msgctxt "message"
msgid "12852"
msgstr "{actor_name:2} è solo preoccupato{line_break}che sia successo qualcosa{line_break}agli abitanti di Vale.{end_wait}"

msgctxt "message"
msgid "12853"
msgstr "È oltre quella{line_break}collina?{end_wait}"

msgctxt "message"
msgid "12854"
msgstr "Sono curioso di scoprire{line_break}com'è la vostra cittadina.{end_wait}"

msgctxt "message"
msgid "12855"
msgstr "È bellissima... sono certo{line_break}che ti piacerà, {actor_name:8}.{end_wait}"

msgctxt "message"
msgid "12856"
msgstr "Io chiuderò gli occhi...{line_break}Qualcuno mi dica,{line_break}se posso aprirli.{end_wait}"

msgctxt "message"
msgid "12857"
msgstr "Anch'io... mi direste{line_break}come stanno le cose?{end_wait}"

msgctxt "message"
msgid "12858"
msgstr "Andrò io, vieni con{line_break}me, {actor_name:5}.{end_wait}"

msgctxt "message"
msgid "12859"
msgstr "Cosa vedi, {actor_name:1}?{end_wait}"

msgctxt "message"
msgid "12860"
msgstr "Ci siamo quasi...{end_wait}"

msgctxt "message"
msgid "12861"
msgstr "Non... non può essere...{end_wait}"

msgctxt "message"
msgid "12862"
msgstr "Che c'è, {actor_name:1}?{line_break}{actor_name:5}? Dite qualcosa!{end_wait}"

msgctxt "message"
msgid "12863"
msgstr "Mi dispiace, {actor_name:6}, ma...{line_break}Vale... il Monte Aleph...{line_break}sono spariti!{end_wait}"

msgctxt "message"
msgid "12864"
msgstr "Cosa!?{end_wait}"

msgctxt "message"
msgid "12865"
msgstr "È... è terribile.{end_wait}"

msgctxt "message"
msgid "12866"
msgstr "Quello è il Monte Aleph?{end_wait}"

msgctxt "message"
msgid "12867"
msgstr "Mamma...{end_wait}"

msgctxt "message"
msgid "12868"
msgstr "Dora...{end_wait}"

msgctxt "message"
msgid "12869"
msgstr "Mamma... papà...{end_wait}"

msgctxt "message"
msgid "12870"
msgstr "{actor_name:1}... {actor_name:2}...{line_break}Cosa posso fare?{line_break}Come posso aiutarvi?{end_wait}"

msgctxt "message"
msgid "12871"
msgstr "Sono qui...{line_break}Devono essere qui...{end_wait}"

msgctxt "message"
msgid "12872"
msgstr "Cosa possiamo fare? Come{line_break}possiamo aiutarli ora?{end_wait}"

msgctxt "message"
msgid "12873"
msgstr "Non so... chiamiamoli...{line_break}Che tragedia...{end_wait}"

msgctxt "message"
msgid "12874"
msgstr "Li chiamerò io...{end_wait}"

msgctxt "message"
msgid "12875"
msgstr "{actor_name:1}...{line_break}{actor_name:2}...{end_wait}"

msgctxt "message"
msgid "12876"
msgstr "So cosa provate.{line_break}L'ho provato anch'io.{end_wait}"

msgctxt "message"
msgid "12877"
msgstr "Ma stare qui, non{line_break}li riporterà indietro.{end_wait}"

msgctxt "message"
msgid "12878"
msgstr "Torniamo a Vault. Potremo{line_break}riposare e pensare...{end_wait}"

msgctxt "message"
msgid "12879"
msgstr "... ...{end_wait}"

msgctxt "message"
msgid "12880"
msgstr "... ...{end_wait}"

msgctxt "message"
msgid "12881"
msgstr "La tua famiglia è salva,{line_break}{actor_name:5}. Non devi più{line_break}preoccuparti...{end_wait}"

msgctxt "message"
msgid "12882"
msgstr "Ma cosa farò io adesso?{line_break}Sono solo.{end_wait}"

msgctxt "message"
msgid "12883"
msgstr "Ahh... poverino...{end_wait}"

msgctxt "message"
msgid "12884"
msgstr "{actor_name:7}, che hai?{line_break}Come puoi prenderti{line_break}gioco di {actor_name:2}?{end_wait}"

msgctxt "message"
msgid "12885"
msgstr "Eh, eh! Chissà...{end_wait}"

msgctxt "message"
msgid "12886"
msgstr "{actor_name:7}, {actor_name:4}!? Credete{line_break}sia divertente!? Ho perso{line_break}tutta la mia famiglia!{end_wait}"

msgctxt "message"
msgid "12887"
msgstr "{actor_name:2}!{line_break}Non essere triste!{end_wait}"

msgctxt "message"
msgid "12888"
msgstr "???{end_wait}"

msgctxt "message"
msgid "12889"
msgstr "Pensavo saresti diventato{line_break}più sicuro, dopo tutte{line_break}le tue avventure!{end_wait}"

msgctxt "message"
msgid "12890"
msgstr "!{end_wait}"

msgctxt "message"
msgid "12891"
msgstr "Ah ah! Ho visto mio{line_break}fratello piangere!{end_wait}"

msgctxt "message"
msgid "12892"
msgstr "!!!{end_wait}"

msgctxt "message"
msgid "12893"
msgstr "Ce l'hai fatta, {actor_name:2}...{line_break}Sapevo che ci{line_break}saresti riuscito, figliolo.{end_wait}"

msgctxt "message"
msgid "12894"
msgstr "Bentornato, {actor_name:2}...{end_wait}"

msgctxt "message"
msgid "12895"
msgstr "Sembri sorpreso di{line_break}vederci, {actor_name:2}.{end_wait}"

msgctxt "message"
msgid "12896"
msgstr "Come siete sopravvissuti?{end_wait}"

msgctxt "message"
msgid "12897"
msgstr "Il Saggio ci ha avvertiti{line_break}del pericolo. Ci ha portati{line_break}qui, in salvo.{end_wait}"

msgctxt "message"
msgid "12898"
msgstr "È stato tutto distrutto...{line_break}Le nostre case, la città...{end_wait}"

msgctxt "message"
msgid "12899"
msgstr "Ma il Saggio vi ha{line_break}salvato tutti?{end_wait}"

msgctxt "message"
msgid "12900"
msgstr "Non... non sono solo!{end_wait}"

msgctxt "message"
msgid "12901"
msgstr "Ce l'ha fatta{line_break}anche Dora?{end_wait}"

msgctxt "message"
msgid "12902"
msgstr "Dora...{end_wait}"

msgctxt "message"
msgid "12903"
msgstr "Mamma...{end_wait}"

msgctxt "message"
msgid "12904"
msgstr "Bentornati a casa,{line_break}Kyle... {actor_name:1}...{end_wait}"

msgctxt "message"
msgid "12905"
msgstr "Sei viva!!!{end_wait}"

msgctxt "message"
msgid "12906"
msgstr "Anche tu...{end_wait}"

msgctxt "message"
msgid "12907"
msgstr "Sono il custode dell'acqua.{line_break}Se vuoi ottenere il mio potere,{line_break}dimostrami quanto vali.{end_wait}"

msgctxt "message"
msgid "12908"
msgstr "Sono il custode del fuoco.{line_break}Se vuoi ottenere il mio potere,{line_break}dimostrami quanto vali.{end_wait}"

msgctxt "message"
msgid "12909"
msgstr "Sono il custode del vento.{line_break}Se vuoi ottenere il mio potere,{line_break}dimostrami quanto vali.{end_wait}"

msgctxt "message"
msgid "12910"
msgstr "Abbiamo ereditato il potere della{line_break}terra per portare l'oscurità.{pause_60}{page_break}Se vuoi questo potere,{line_break}tocca questa stele!{end_wait}"

msgctxt "message"
