"moins il ne sera pas seul."

#, alchemy-end-wait
msgctxt "MsgVaultSinceYoureHelpingIvanIllTell"
msgid "04701"
msgstr ""
"Puisque vous aidez\n"
"{actor_name:3}, je vais vous\n"
"dire un secret...{page_break}"
