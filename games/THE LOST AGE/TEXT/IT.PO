msgctxt "message"
msgid "11200"
msgstr "Oh, è terribile! Oltre{line_break}ogni dire, basta, basta!{end_wait}"

msgctxt "message"
msgid "11201"
msgstr "Non andare a sud,{line_break}Hai capito?{line_break}Parlo seriamente...{end_wait}"

msgctxt "message"
msgid "11202"
msgstr "Strano... tutto è offuscato...{line_break}Grigio o come pieno di nebbia...{page_break}Il mondo sta cambiando,{line_break}parrebbe.{end_wait} "

msgctxt "message"
msgid "11203"
msgstr "Vuoi conoscere{line_break}il tuo destino?{end_now}"

msgctxt "message"
msgid "11204"
msgstr "Tanto meglio. Le cose{line_break}che vedo non sono{line_break}comprensibili a tutti.{end_wait}"

msgctxt "message"
msgid "11205"
msgstr "Sono di buon umore...{line_break}Ora ti dico!{end_wait}"

msgctxt "message"
msgid "11206"
msgstr "Palapadula!{end_wait}"

msgctxt "message"
msgid "11207"
msgstr "Hulabadula!{end_wait}"

msgctxt "message"
msgid "11208"
msgstr "Parapapò!{end_wait}"

msgctxt "message"
msgid "11209"
msgstr "Lo vedo chiaramente...{line_break}Cammini con il pericolo al fianco...{end_wait}"

msgctxt "message"
msgid "11210"
msgstr "Ooh... wow! Che forza...{line_break}Ascolta non andare{line_break}a nordest. Brutta roba lassù.{end_wait}"

msgctxt "message"
msgid "11211"
msgstr "Oh, è terribile! Oltre{line_break}ogni dire, basta, basta!{end_wait}"

msgctxt "message"
msgid "11212"
msgstr "Ascolta, promettimi che{line_break}non andrai MAI a nord{line_break}nordest, va bene?{end_wait}"

msgctxt "message"
msgid "11213"
msgstr "Strano... tutto è offuscato...{line_break}Grigio o come{line_break}pieno di nebbia...{page_break}Il mondo sta cambiando,{line_break}parrebbe.{end_wait} "

msgctxt "message"
msgid "11214"
msgstr "I vostri attacchi hanno forza{line_break}e velocità, ma se combatteremo{line_break}ancora, non perderò.{end_wait}"

msgctxt "message"
msgid "11215"
msgstr "Non credo che saremo{line_break}perdonati per aver perso{line_break}sulla Via delle Prove.{page_break}Se sapessero quanto{line_break}siete forti, non{line_break}parlerebbero più.{end_wait}"

msgctxt "message"
msgid "11216"
msgstr "Anche solo arrivare alla fine{line_break}della Via delle Prove è difficile.{page_break}Dev'essere stata dura{line_break}anche per Yegelos e Hoabna.{end_wait}"

msgctxt "message"
msgid "11217"
msgstr "Non è giusto... Ero{line_break}così stanco dopo la{line_break}scalata... Come potevo lottare?{page_break}Come ha fatto Hoabna a{line_break}combattere così, dopo{line_break}l'arrampicata!?{end_wait}"

msgctxt "message"
msgid "11218"
msgstr "Mi avete battuto e ancora{line_break}non conosco i vostri{line_break}nomi... Me li direte?{end_now}"

msgctxt "message"
msgid "11219"
msgstr "Un guerriero che non{line_break}rivela il suo nome è{line_break}invero modesto.{end_wait}"

msgctxt "message"
msgid "11220"
msgstr "{actor_name:5}, {actor_name:6}, {actor_name:7}{line_break}e {actor_name:8}. Ricorderò{line_break}questi nomi.{page_break}Non scordiamo i nomi{line_break}degli eroi che mi hanno{line_break}battuto.{end_wait}"

msgctxt "message"
msgid "11221"
msgstr "Moapa ha detto di non{line_break}conoscere i nomi degli{line_break}eroi che l'hanno battuto...{page_break}Gli dispiace di non averli{line_break}chiesti. Forse dovreste{line_break}dirglieli.{end_wait}"

msgctxt "message"
msgid "11222"
msgstr "In una sfida formale,{line_break}è onorevole dare{line_break}il proprio nome.{page_break}Non è tardi per voi...{line_break}Per favore, dite a mio{line_break}padre i vostri nomi.{end_wait}"

msgctxt "message"
msgid "11223"
msgstr "Cosa importa se conosci{line_break}il nome di chi ti{line_break}ha battuto o meno?{end_wait}"

msgctxt "message"
msgid "11224"
msgstr "Se un guerriero ti batte,{line_break}devi impararne il nome...{page_break}Non sono molti quelli{line_break}che mi hanno battuto{line_break}e meritano rispetto.{end_wait}"

msgctxt "message"
msgid "11225"
msgstr "Mi dispiacerebbe non{line_break}conoscere il nome del{line_break}guerriero che mi ha battuto...{end_wait}"

msgctxt "message"
msgid "11226"
msgstr "Che vergogna... Mio padre{line_break}sconfitto da degli stranieri{line_break}ignoranti e maleducati.{end_wait}"

msgctxt "message"
msgid "11227"
msgstr "È così vecchio stile{line_break}dichiarare il proprio nome{line_break}prima di una battaglia.{end_wait}"

msgctxt "message"
msgid "11228"
msgstr "Non dimentico mai{line_break}il nome di chi affronto.{end_wait}"

msgctxt "message"
msgid "11229"
msgstr "Mi ha sorpreso che{line_break}Moapa sia stato sconfitto...{page_break}Le sue armi erano di{line_break}mia produzione, mi{line_break}sento responsabile.{end_wait}"

msgctxt "message"
msgid "11230"
msgstr "Da quando Moapa ha perso,{line_break}sono tutti depressi. Dovrebbero{line_break}gioire per la venuta dell'eroe!{end_wait}"

msgctxt "message"
msgid "11231"
msgstr "Ma non sarebbe giusto{line_break}dire che ha perso per{line_break}le armi che ha usato.{page_break}Sarei rovinato se si{line_break}spargesse una voce simile.{end_wait}"

msgctxt "message"
msgid "11232"
msgstr "Mio marito si preoccupa che{line_break}le sue armi abbiano{line_break}causato la sconfitta.{end_wait}"

msgctxt "message"
msgid "11233"
msgstr "Avete viaggiato per molte{line_break}terre, vero?{end_now}"

msgctxt "message"
msgid "11234"
msgstr "Questo spiega tutto...{line_break}È l'unica ragione per{line_break}cui avete vinto...{page_break}Sono state le vostre{line_break}strane armi esotiche,{line_break}non la vostra abilità.{end_wait}"

msgctxt "message"
msgid "11235"
msgstr "Avrei giurato che quella{line_break}bella nave fosse vostra...{page_break}Se potete permettervi una{line_break}nave così, potete anche{line_break}permettervi buone armi.{end_wait}"

msgctxt "message"
msgid "11236"
msgstr "Siamo fieri di Moapa.{line_break}È un grande capo.{page_break}Se qualcuno in città{line_break}dice altrimenti,{line_break}perdonatelo.{end_wait}"

msgctxt "message"
msgid "11237"
msgstr "Sono rimasto chiuso in{line_break}casa tutto il giorno!{line_break}Ora devo muovermi!{end_wait}"

msgctxt "message"
msgid "11238"
msgstr "Ah... è tanto che non esco...{line_break}Credo che farò un picnic!{line_break}Ma cosa dovrei mangiare?{end_wait}"

msgctxt "message"
msgid "11239"
msgstr "Qui, le persone amano{line_break}una bistecca, qualche{line_break}patata, i fagioli...{page_break}Voi forestieri sarete{line_break}abituati ai cibi esotici, ma{line_break}noi amiamo i piatti semplici.{end_wait}"

msgctxt "message"
msgid "11240"
msgstr "Moapa è sempre triste{line_break}da quando è stato sconfitto.{line_break}Vorrei poterlo aiutare.{end_wait}"

msgctxt "message"
msgid "11241"
msgstr "Mi dà fastidio che{line_break}tutti qui si esaltino{line_break}per Moapa.{end_wait}"

msgctxt "message"
msgid "11242"
msgstr "Tutti gli anziani{line_break}sono furiosi perché{line_break}Moapa ha perso...{page_break}A noi ragazzi non importa.{line_break}Credo che siano troppo{line_break}attaccati alle tradizioni.{end_wait} "

msgctxt "message"
msgid "11243"
msgstr "Ho fame! Non posso{line_break}aspettare! Adoro la carne{line_break}e le patate! E i FAGIOLI!!!{page_break}Devono essere le spezie{line_break}che usa il cuoco... Molto sale,{line_break}e molto pepe!{end_wait}"

msgctxt "message"
msgid "11244"
msgstr "I cuochi stranieri{line_break}usano molte spezie per{line_break}nascondere il gusto dei cibi.{page_break}Per quanto mi riguarda,{line_break}ci sono solo due spezie:{line_break}sale e pepe.{end_wait}"

msgctxt "message"
msgid "11245"
msgstr "Avete battuto Moapa? Incredibile!{line_break}Non che avessi dei dubbi!{end_wait}"

msgctxt "message"
msgid "11246"
msgstr "Non siate troppo felici{line_break}di aver battuto Moapa.{page_break}Prima o poi,{line_break}assalteremo Contigo,{line_break}e ve la faremo vedere!{end_wait}"

msgctxt "message"
msgid "11247"
msgstr "Per favore... c'è bisogno{line_break}che nasca un vero guerriero{line_break}nel villaggio, per favore!{end_wait}"

msgctxt "message"
msgid "11248"
msgstr "Gli anziani del villaggio{line_break}sono furiosi perché Moapa{line_break}è stato battuto.{page_break}Speriamo non ricominci{line_break}la faida con Contigo.{end_wait}"

msgctxt "message"
msgid "11249"
msgstr "Moapa doveva essere{line_break}affamato dopo la scalata{line_break}della montagna...{page_break}È l'unica spiegazione. Altrimenti{line_break}non avrebbe mai perso contro{line_break}quei miserabili di Contigo.{end_wait}"

msgctxt "message"
msgid "11250"
msgstr "Non posso accettare che{line_break}gli eroi di Contigo{line_break}abbiano battuto Moapa...{page_break}Spero che nasca un eroe{line_break}nel villaggio, uno che possa{line_break}spezzare i barbari di Contigo...{end_wait}"

msgctxt "message"
msgid "11251"
msgstr "{actor_name:5}, l'eroe di Contigo!{line_break}Non ti dimenticherò,{line_break}sei stato l'unico a battermi!{end_wait}"

msgctxt "message"
msgid "11252"
msgstr "{actor_name:5}, {actor_name:6}, {actor_name:7},{line_break}e {actor_name:8}... Non{line_break}dimenticherò questi nomi...{page_break}Un giorno saranno incisi{line_break}sui totem che portano{line_break}alla Via delle Prove.{end_wait}"

msgctxt "message"
msgid "11253"
msgstr "Ahhhh!!!"

msgctxt "message"
msgid "11254"
msgstr "{actor_name:4}!"

msgctxt "message"
msgid "11255"
msgstr "Noooo!!!"

msgctxt "message"
msgid "11256"
msgstr "Ehi!"

msgctxt "message"
msgid "11257"
msgstr "{actor_name:4}!"

msgctxt "message"
msgid "11258"
msgstr "{actor_name:2}!"

msgctxt "message"
msgid "11259"
msgstr "Quello è...{pause_20_skippable} È {actor_name:1}{line_break}con gli altri!{end_wait}"

msgctxt "message"
msgid "11260"
msgstr "{actor_name:1}? Non è un tuo{line_break}amico, {actor_name:5}?{end_now}"

msgctxt "message"
msgid "11261"
msgstr "Entrambi sono di Vale, e{line_break}al contrario di quanto crede{line_break}{actor_name:1}, ora devono allearsi!{end_wait}"

msgctxt "message"
msgid "11262"
msgstr "Non fare così! Voi due{line_break}avete molto in comune,{line_break}anche se siete distanti ora...{end_wait}"

msgctxt "message"
msgid "11263"
msgstr "Ma {actor_name:1} e gli altri{line_break}sono venuti qui per{line_break}fermarci!{end_wait}"

msgctxt "message"
msgid "11264"
msgstr "Ma non avete sentito?{line_break}Sembrava un grido d'aiuto...{line_break}E se sono nei guai?{end_wait}"

msgctxt "message"
msgid "11265"
msgstr "Resisti, {actor_name:4}!{line_break}Non temere, {actor_name:2}!{line_break}Tutto andrà bene!{end_wait}"

msgctxt "message"
msgid "11266"
msgstr "Non preoccuparti per me...{line_break}Sto bene, ma {actor_name:2}...{end_wait}"

msgctxt "message"
msgid "11267"
msgstr "{actor_name:2}, sei aggrappato solo{line_break}con un braccio... Che c'è?{end_wait}"

msgctxt "message"
msgid "11268"
msgstr "Non so... Credo di essermi{line_break}ferito durante la caduta...{line_break}Non posso muoverlo!{end_wait}"

msgctxt "message"
msgid "11269"
msgstr "Non avresti dovuto provare{line_break}a salvarmi quando sono{line_break}caduta in quella trappola...{end_wait}"

msgctxt "message"
msgid "11270"
msgstr "Oh, {actor_name:4}, non è colpa{line_break}tua... Non ti avrei mai{line_break}lasciata là!{end_wait}"

msgctxt "message"
msgid "11271"
msgstr "È inutile! Non riesco a{line_break}sollevarti, {actor_name:2}! Non{line_break}sono abbastanza forte!{end_wait}"

msgctxt "message"
msgid "11272"
msgstr "{actor_name:1}, per favore!{line_break}Devi salvare {actor_name:2}!{end_wait}"

msgctxt "message"
msgid "11273"
msgstr "Non va bene così...{line_break}Dobbiamo salvare {actor_name:2},{line_break}e in fretta!{end_wait}"

msgctxt "message"
msgid "11274"
msgstr "No, temo che{line_break}non lo farete...{end_wait}"

msgctxt "message"
msgid "11275"
msgstr "Chi sei!?{end_wait}"

msgctxt "message"
msgid "11276"
msgstr "Io? Io sono Karst.{end_wait}"

msgctxt "message"
msgid "11277"
msgstr "Ed io Agatio.{end_wait}"

msgctxt "message"
msgid "11278"
msgstr "Se non siete qui per aiutare{line_break}il mio amico, allora spostatevi,{line_break}e lasciate che lo faccia io!{end_wait}"

msgctxt "message"
msgid "11279"
msgstr "I tuoi amici dovranno{line_break}cavarsela da soli. Tu{line_break}hai un debito da saldare.{end_wait}"

msgctxt "message"
msgid "11280"
msgstr "Un debito? Ma di che parli?{line_break}Non ti avevo neppure{line_break}mai visto prima!{end_wait}"

msgctxt "message"
msgid "11281"
msgstr "Non importa, hai fatto a Karst{line_break}un grave torto, e cominci{line_break}a darci molto fastidio.{end_wait}"

msgctxt "message"
msgid "11282"
msgstr "Un momento... voi due, mi sembrate{line_break}familiari in qualche maniera...{line_break}Conoscete Saturos e Adexia?{end_wait}"

msgctxt "message"
msgid "11283"
msgstr "Allora non sei così sciocco,{line_break}{actor_name:1}! Hai ragione, noi siamo{line_break}del loro stesso clan.{page_break}Il Clan del Fuoco, dalle lande{line_break}ghiacciate di Prox, a nord!{end_wait}{end_wait}"

msgctxt "message"
msgid "11284"
msgstr "Prox? Mai sentita.{end_wait}"

msgctxt "message"
msgid "11285"
msgstr "Non mi sorprende.{line_break}La nostra città è sull'orlo{line_break}del baratro.{end_wait}"

msgctxt "message"
msgid "11286"
msgstr "E la colpa è del sigillo{line_break}posto sull'Alchimia!{end_wait}"

msgctxt "message"
msgid "11287"
msgstr "Cosa dite? Non{line_break}capisco.{end_wait}"

msgctxt "message"
msgid "11288"
msgstr "Poco importa! Presto, Prox{line_break}riprenderà le sue forze...{end_wait}"

msgctxt "message"
msgid "11289"
msgstr "Salveremo Prox dall'abisso,{line_break}e la gente di Weyard si{line_break}inginocchierà davanti a noi!{end_wait}"

msgctxt "message"
msgid "11290"
msgstr "Pensate che vi lasceremo fare,{line_break}dopo tante sciocchezze?{end_wait}"

msgctxt "message"
msgid "11291"
msgstr "Vedi! Sei una piattola!{end_wait}"

msgctxt "message"
msgid "11292"
msgstr "E {actor_name:5} cercava{line_break}di aiutarvi?{end_wait}"

msgctxt "message"
msgid "11293"
msgstr "In realtà... Non conosciamo{line_break}gli obiettivi di {actor_name:5}.{end_wait}"

msgctxt "message"
msgid "11294"
msgstr "E non ci interessano, almeno{line_break}fin quando accenderà{line_break}il Faro di Giove.{end_wait}"

msgctxt "message"
msgid "11295"
msgstr "Allora cedete il passo! Noi{line_break}siamo qui per fermare {actor_name:5}!{end_wait}"

msgctxt "message"
msgid "11296"
msgstr "Spostatevi, o vi{line_break}sposteremo noi!{end_wait}"

msgctxt "message"
msgid "11297"
msgstr "Hai sentito, Karst?{line_break}Vogliono davvero combattere?{end_wait}"

msgctxt "message"
msgid "11298"
msgstr "Volete dirci che{line_break}lascereste il vostro amico...{line_break}in sospeso?{end_wait}"

msgctxt "message"
msgid "11299"
msgstr "Faceva tutto parte{line_break}del vostro piano?{end_wait}"

msgctxt "message"
msgid "11300"
msgstr "Codardi! Basta trucchetti,{line_break}affrontateci onestamente!{end_wait}"

msgctxt "message"
msgid "11301"
msgstr "Se siete stati voi, ad aver{line_break}ucciso Saturos ed Adexia,{line_break}vi siete fatti dei nuovi nemici!{end_wait}"

msgctxt "message"
msgid "11302"
msgstr "Rispondete a questo:{line_break}vi lamentereste anche se ci{line_break}affrontaste quattro contro due?{end_wait}"

msgctxt "message"
msgid "11303"
msgstr "È per questo che siete qui?{line_break}Per tendere una trappola e{line_break}far cadere {actor_name:4} e {actor_name:2}?{end_wait}"

msgctxt "message"
msgid "11304"
msgstr "Non pensavamo{line_break}di prenderne due... è stata{line_break}{text_effect:2}una{reset_text_style} piacevole sorpresa!{end_wait}"

msgctxt "message"
msgid "11305"
msgstr "Quindi è così?{line_break}Siete venuti qui ad affrontarci.{end_wait}"

msgctxt "message"
msgid "11306"
msgstr "L'hai capito tutto da solo?{line_break}Notevole! I ragazzi intelligenti{line_break}mi sono sempre piaciuti...{end_wait}"

msgctxt "message"
msgid "11307"
msgstr "Spero non pensiate che{line_break}abbiamo paura di{line_break}affrontarvi due contro due...{end_wait}"

msgctxt "message"
msgid "11308"
msgstr "Due contro due?{end_wait}"

msgctxt "message"
msgid "11309"
msgstr "Scusate se mi sono spiegato{line_break}male... Noi siamo in tre...{line_break}Alex!{end_wait}"

msgctxt "message"
msgid "11310"
msgstr "Alex?{pause_20_skippable} Dov'è?{end_wait}"

msgctxt "message"
msgid "11311"
msgstr "Che c'è, Karst?{end_wait}"

msgctxt "message"
msgid "11312"
msgstr "Alex! Se n'è andato!{end_wait}"

msgctxt "message"
msgid "11313"
msgstr "Cosa!?{end_wait}"

msgctxt "message"
msgid "11314"
msgstr "Alex!"

msgctxt "message"
msgid "11315"
msgstr "Alex?"

msgctxt "message"
msgid "11316"
msgstr "Qualcuno ha visto{line_break}dov'è andato?{end_wait}"

msgctxt "message"
msgid "11317"
msgstr "Dimenticalo! Onestamente,{line_break}pensavo di fare a lui{line_break}quello che faremo a loro!{end_wait}"

msgctxt "message"
msgid "11318"
msgstr "Mi dispiace solo{line_break}che non potrò togliergli{line_break}quel sorriso dalla faccia.{end_wait}"

msgctxt "message"
msgid "11319"
msgstr "Scarica la tua{line_break}aggressività su di loro...{line_break}Ti sentirai meglio, vedrai!{end_wait}"

msgctxt "message"
msgid "11320"
msgstr "{actor_name:5}! Agatio e Karst{line_break}attaccano {actor_name:1}{line_break}e gli altri!{end_wait}"

msgctxt "message"
msgid "11321"
msgstr "Credi che {actor_name:1} e{line_break}{actor_name:3} possano cavarsela{line_break}senza {actor_name:4} e {actor_name:2}?{end_wait}"

msgctxt "message"
msgid "11322"
msgstr "Sono disgustato da Karst.{line_break}Piazzare delle trappole{line_break}è disonorevole!{end_wait}"

msgctxt "message"
msgid "11323"
msgstr "Che succederà se {actor_name:2} perde{line_break}la presa mentre loro combattono?{end_wait}"

msgctxt "message"
msgid "11324"
msgstr "C'è ancora tempo! Dobbiamo{line_break}aiutare {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "11325"
msgstr "Ah, {actor_name:5}... Ti{line_break}aspettavo.{end_wait}"

msgctxt "message"
msgid "11326"
msgstr "Sei venuto ad{line_break}accendere il faro?{end_now}"

msgctxt "message"
msgid "11327"
msgstr "Questa è l'unica{line_break}{text_effect:2}cosa{reset_text_style} che farai?{end_wait}"

msgctxt "message"
msgid "11328"
msgstr "Mah. Ti considerano un nemico{line_break}e tu hai pietà di loro.{end_wait}"

msgctxt "message"
msgid "11329"
msgstr "Ti ho visto mentre guardavi{line_break}l'amico di {actor_name:1}{line_break}cadere nella trappola di Karst.{end_wait}"

msgctxt "message"
msgid "11330"
msgstr "Ti conosco, {actor_name:5}.{pause_20_skippable}{line_break}So che se abbandonassi{line_break}{actor_name:1}, te ne pentiresti.{end_wait}"

msgctxt "message"
msgid "11331"
msgstr "Non sei come me. Tu non{line_break}riesci ad abbandonare qualcuno{line_break}di cui non hai più bisogno.{end_wait}"

msgctxt "message"
msgid "11332"
msgstr "È meglio che ti sbrighi,{line_break}se vuoi riuscire a salvarli.{end_wait}"

msgctxt "message"
msgid "11333"
msgstr "Tutti sono al massimo delle forze.{end_wait}"

msgctxt "message"
msgid "11334"
msgstr "Ecco! Consideralo un{line_break}regalo. Puoi ancora{line_break}farcela. Forza...{end_wait}"

msgctxt "message"
msgid "11335"
msgstr "È tempo che tu segua{line_break}i tuoi sentimenti.{line_break}Salva i tuoi amici.{end_wait}"

msgctxt "message"
msgid "11336"
msgstr "Anch'io vorrei andare{line_break}da {actor_name:4}, ed aiutarla...{line_break}Sono un debole...{page_break}Non ho altra scelta che{line_break}separarmi da Agatio{line_break}e Karst.{end_wait}"

msgctxt "message"
msgid "11337"
msgstr "{actor_name:1}... mi dispiace...{line_break}Non ce la faccio più...{end_wait}"

msgctxt "message"
msgid "11338"
msgstr "Resisti, {actor_name:3}!{end_wait}"

msgctxt "message"
msgid "11339"
msgstr "Ah! Sciocco! In battaglia{line_break}non devi distrarti mai!{end_wait}"

msgctxt "message"
msgid "11340"
msgstr "AHHHHHHHH!!!{end_wait}"

msgctxt "message"
msgid "11341"
msgstr "Ce l'abbiamo fatta, Agatio!{end_wait}"

msgctxt "message"
msgid "11342"
msgstr "C'è mancato poco, ma...{end_wait}"

msgctxt "message"
msgid "11343"
msgstr "Eh... Non è un vero guerriero.{line_break}La preoccupazione per il{line_break}suo amico lo ha sconfitto!{end_wait}"

msgctxt "message"
msgid "11344"
msgstr "Cosa? È ancora vivo!?{line_break}Dopo quel colpo?{end_wait}"

msgctxt "message"
msgid "11345"
msgstr "Sarebbe un peccato rimpiangere{line_break}di averlo lasciato{line_break}in vita...{end_wait}"

msgctxt "message"
msgid "11346"
msgstr "{actor_name:1}! Attento!{end_wait}"

msgctxt "message"
msgid "11347"
msgstr "È ancora vivo! Se vogliamo agire,{line_break}{actor_name:5}, dobbiamo farlo ora!{end_wait}"

msgctxt "message"
msgid "11348"
msgstr "Uccideranno {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "11349"
msgstr "No! Non lascerò{line_break}che succeda!{end_wait}"

msgctxt "message"
msgid "11350"
msgstr "Siamo con te, {actor_name:6}!{end_wait}"

msgctxt "message"
msgid "11351"
msgstr "{actor_name:5}? Che c'è?{end_wait}"

msgctxt "message"
msgid "11352"
msgstr "Dovresti ringraziarci! Ti{line_break}abbiamo fatto un favore!{end_wait}"

msgctxt "message"
msgid "11353"
msgstr "Sapevo che acceso il Faro di{line_break}Venere, la terra ha tremato così{line_break}forte che si è creato un baratro.{page_break}Strano che non sia successo qui!{end_wait}"

msgctxt "message"
msgid "11354"
msgstr "Non hai ancora acceso il{line_break}faro, vero? Dopo tutto quello{line_break}che abbiamo fatto per te!{end_wait}"

msgctxt "message"
msgid "11355"
msgstr "Adesso accenderemo{line_break}il faro...{end_wait}"

msgctxt "message"
msgid "11356"
msgstr "Se è vero, è meglio che{line_break}lo facciate!{end_wait}"

msgctxt "message"
msgid "11357"
msgstr "Ma non abbandoneremo{line_break}{actor_name:1}.{end_wait}"

msgctxt "message"
msgid "11358"
msgstr "Oh, perfetto... Adesso{line_break}ci tradirete?{end_now}"

msgctxt "message"
msgid "11359"
msgstr "Tipico. Volete fermarci{line_break}prima che li finiamo,{line_break}giusto?{end_wait}"

msgctxt "message"
msgid "11360"
msgstr "Non mentire... Lo leggiamo{line_break}nei vostri occhi,{line_break}cosa volete fare davvero.{end_wait}"

msgctxt "message"
msgid "11361"
msgstr "Se siete venuti qui solo{line_break}per permetterci di accendere{line_break}il faro, allora potete andare.{end_wait}"

msgctxt "message"
msgid "11362"
msgstr "{actor_name:1} si è dimostrato{line_break}troppo forte. Non possiamo{line_break}lasciarlo in vita.{end_wait}"

msgctxt "message"
msgid "11363"
msgstr "Pensa a quanto erano forti{line_break}senza l'aiuto di un Adepto{line_break}d'Acqua. Dobbiamo finirli.{end_wait}"

msgctxt "message"
msgid "11364"
msgstr "Se li volete, dovrete{line_break}affrontare noi, prima!{end_wait}"

msgctxt "message"
msgid "11365"
msgstr "Siete entrambi{line_break}feriti... Non potete{line_break}affrontarli tutti e quattro.{page_break}Sarebbe meglio se{line_break}ve ne andaste ora.{end_wait}"

msgctxt "message"
msgid "11366"
msgstr "Non abbiamo molta scelta...{end_wait}"

msgctxt "message"
msgid "11367"
msgstr "Karst, no!{end_wait}"

msgctxt "message"
msgid "11368"
msgstr "Agatio, se affrontiamo {actor_name:5}{line_break}adesso... saremo spazzati via.{end_wait}"

msgctxt "message"
msgid "11369"
msgstr "{actor_name:1} ha ucciso tua sorella!{line_break}Dov'è la tua rabbia!?{end_wait}"

msgctxt "message"
msgid "11370"
msgstr "Ne sono piena, ma non fino{line_break}al punto da esserne accecata.{end_wait}"

msgctxt "message"
msgid "11371"
msgstr "E allora? Ci arrendiamo?{end_wait}"

msgctxt "message"
msgid "11372"
msgstr "Va bene! Ma non finisce qui.{end_wait}"

msgctxt "message"
msgid "11373"
msgstr "Fate di {actor_name:1}{line_break}ciò che volete.{end_wait}"

msgctxt "message"
msgid "11374"
msgstr "Ma giurate:{line_break}se ce ne andiamo ora,{line_break}accenderete il faro.{end_now}"

msgctxt "message"
msgid "11375"
msgstr "Non mi importa se{line_break}aiutate {actor_name:2} o no!{line_break}Il faro viene prima!{end_wait}"

msgctxt "message"
msgid "11376"
msgstr "Non possiamo aspettare{line_break}che salviate {actor_name:2}!{end_wait}"

msgctxt "message"
msgid "11377"
msgstr "Vai, {actor_name:5}.{line_break}Curerò io {actor_name:2}.{end_wait}"

msgctxt "message"
msgid "11378"
msgstr "E prendi anche{line_break}l'Astro Marte che{line_break}{actor_name:1} porta con sé.{end_wait}"

msgctxt "message"
msgid "11379"
msgstr "Come fate a conoscere{line_break}l'Astro Marte?{end_wait}"

msgctxt "message"
msgid "11380"
msgstr "Pensavi che fossimo qui{line_break}solo per vendicarci?{line_break}Ce ne ha parlato Alex!{end_wait}"

msgctxt "message"
