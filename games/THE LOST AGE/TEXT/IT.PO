msgctxt "message"
msgid "06831"
msgstr "La cella è in disordine...{end_wait}"

msgctxt "message"
msgid "06832"
msgstr "Mi chiedo cosa sia successo qui...{end_wait}"

msgctxt "message"
msgid "06833"
