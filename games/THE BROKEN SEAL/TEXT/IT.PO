msgctxt "message"
msgid "07595"
msgstr "(Ma che problema c'è?{line_break}Abbiamo dei guerrieri{line_break}a proteggerci...){end_wait}"

msgctxt "message"
msgid "07596"
msgstr "(Forse non avremmo{line_break}dovuto prenderlo.){end_wait}"

msgctxt "message"
msgid "07597"
msgstr "Ehi!{pause_20_skippable} Ehi, voi!{line_break}Cosa ci{line_break}fate qui?{end_wait}"

msgctxt "message"
msgid "07598"
msgstr "Avete sentito cosa ha detto il{line_break}capitano: la nave non parte!{end_wait}"

msgctxt "message"
msgid "07599"
msgstr "Ci mancava anche{line_break}di perdere il ciondolo{line_break}portafortuna!{page_break}Questa nave non salperà finché{line_break}non l'avremo trovato!{end_wait}"

msgctxt "message"
msgid "07600"
msgstr "Magnifico: proprio quando{line_break}avevano trovato dei guerrieri{line_break}per proteggere la nave...{end_wait}"

msgctxt "message"
msgid "07601"
