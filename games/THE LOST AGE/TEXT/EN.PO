msgid "05231"
msgstr "I am a traveling warrior.{line_break}I came here to become{line_break}stronger...{page_break}Listen to me on{line_break}this: Don't underestimate{line_break}the monsters here...{end_wait}"

msgctxt "message"
msgid "05232"
msgstr "You aren't too bad.{line_break}But don't become too{line_break}arrogant from this{page_break}victory. Continue to{line_break}train yourselves.{end_wait}"

msgctxt "message"
msgid "05233"
msgstr "You have to train more.{page_break}Put your heart into{line_break}it when you fight.{end_wait}"

