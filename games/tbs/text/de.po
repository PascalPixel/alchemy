"Viele Spielwürfel rollen\n"
"hier herum."

#, alchemy-end-wait
msgctxt "MsgBabiPalaceTheresAHeadbandItSaysNever"
msgid "10644"
msgstr ""
"Da ist ein Stirnband.{page_break}"
