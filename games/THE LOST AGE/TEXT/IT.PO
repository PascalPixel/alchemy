msgid "08926"
msgstr "Quella notte, i champa vennero{line_break}da est e i kibombo da{line_break}ovest. Dov'è l'alleanza?{end_wait}"

msgctxt "message"
msgid "08927"
msgstr "Il mio fidanzato, Shin, sembra{line_break}un po' giù ultimamente...{line_break}Spero stia bene.{end_wait}"

msgctxt "message"
msgid "08928"
msgstr "Ho detto a mia sorella di{line_break}non preoccuparsi per Shin.{line_break}È un duro... Almeno lo era...{end_wait}"

msgctxt "message"
msgid "08929"
msgstr "Shin sembra terrificato{line_break}da {actor_name:8}. Chissà cosa{line_break}è successo tra loro.{page_break}Però questo spiegherebbe{line_break}perché è così{line_break}nervoso ultimamente.{end_wait}"

msgctxt "message"
msgid "08930"
msgstr "Shin di solito è così{line_break}gentile. Spero superi{line_break}il brutto periodo in cui si trova.{end_wait}"

msgctxt "message"
msgid "08931"
msgstr "Ho notato che la{line_break}temperatura dell'oceano{line_break}è lentamente aumentata.{page_break}È un cattivo presagio.{line_break}Fate attenzione se{line_break}volete partire presto.{end_wait}"

msgctxt "message"
msgid "08932"
