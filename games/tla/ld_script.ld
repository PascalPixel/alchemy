/* The Lost Age, all six editions: the one linker script, run through the C
   preprocessor with -DTLA_EDITION_<LANG>=1 as the C is. version.h gives it
   LANGUAGE and the patch levels, so an edition's differences here are the
   same tests the C makes.

   The build preprocesses it once for the main image, and once for each
   overlay with OVERLAY defined as the overlay's number; it reads each
   image's objects from the statements below, in order, and links them in
   that order.

   The main image lists its objects in the order the Game Pak holds them;
   each statement names the sections of its object it places there. */
#include "version.h"

/* The shift test (make SHIFT=n) moves everything after the header n bytes,
   so every bank starts n bytes later; 0 in every other build. */
#ifndef ROM_SHIFT
#define ROM_SHIFT 0
#endif
#if ROM_SHIFT % 4 != 0
#error "SHIFT must be a multiple of 4: words and Thumb literal pools in byte-aligned sections would misalign"
#endif

/* Where the far-call banks that move start, in each edition. English and
   Italian share every address; Japanese and French share the last ones
   with them. The other banks start at the same address in every edition. */
#if LANGUAGE == LANGUAGE_JAPANESE
#define GAME_BANK_START           0x080a8000
#define FIELD_SEQUENCE_BANK_START 0x080c8000
#define MENU_BANK_START           0x080f8000
#define SHOP_BANK_START           0x08108000
#elif LANGUAGE == LANGUAGE_GERMAN
#define GAME_BANK_START           0x080ba000
#define FIELD_SEQUENCE_BANK_START 0x080d5000
#define MENU_BANK_START           0x08102000
#define SHOP_BANK_START           0x08110000
#elif LANGUAGE == LANGUAGE_SPANISH
#define GAME_BANK_START           0x080b6000
#define FIELD_SEQUENCE_BANK_START 0x080d1000
#define MENU_BANK_START           0x080fe000
#define SHOP_BANK_START           0x0810c000
#elif LANGUAGE == LANGUAGE_FRENCH
#define GAME_BANK_START           0x080b2000
#define FIELD_SEQUENCE_BANK_START 0x080cd000
#define MENU_BANK_START           0x080fa000
#define SHOP_BANK_START           0x08108000
#else
#define GAME_BANK_START           0x080ad000
#define FIELD_SEQUENCE_BANK_START 0x080c8000
#define MENU_BANK_START           0x080f8000
#define SHOP_BANK_START           0x08108000
#endif

#ifdef OVERLAY
#include "src/system/overlay/overlay.ld"
#else
OUTPUT_ARCH(arm)
ENTRY(Entry)
Resource_Decode2CodeSize = Resource_Decode2End - Resource_Decode2Code;
Tile_Decompress4bppCodeSize = Tile_Decompress4bppEnd - Tile_Decompress4bppCode;
Tile_ExpandMaskedCodeSize = Tile_ExpandMaskedEnd - Tile_ExpandMaskedCode;
Tile_ExpandOpaqueCodeSize = Tile_ExpandOpaqueEnd - Tile_ExpandOpaqueCode;
Tile_BuildCellPicturesCodeSize = Tile_Decompress4bppCode - Tile_BuildCellPicturesCode;
Glyph_DrawCodeSize = Tile_BuildCellPicturesCode - Glyph_DrawCode;
BattleEffect_DecodePictureBlockSize = BattleEffect_DecodePictureEnd - BattleEffect_DecodePictureCode;
Render_DecodePictureBlockSize = Render_DecodePictureEnd - Render_DecodePictureCode;
Text_DecodeSymbolCodeSize = Text_DecodeSymbolEnd - Text_DecodeSymbolCode;
BattleEffect_ExpandCodeSize = BattleEffect_DotProduct2 - BattleEffect_ExpandCode;
BattleEffect_Expand2CodeSize = BattleEffect_Expand2End - BattleEffect_Expand2Code;
Model_DecodeCodeSize = Model_DecodeEnd - Model_DecodeCode;
Data_08021824Size = Resource_GetMetadataRecordFar - Data_08021824;
Data_0802146cSize = Render_ConvertMapCode - Data_0802146c;

MEMORY
{
    EWRAM (rwx) : ORIGIN = 0x2000000, LENGTH = 256K
    IWRAM (rwx) : ORIGIN = 0x3000000, LENGTH = 32K
    ROM    (rx) : ORIGIN = 0x8000000, LENGTH = 32M
}
