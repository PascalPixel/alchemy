#, alchemy-end-wait
msgctxt "message"
msgid "04094"
msgstr "Beau travail, {actor_name:1}!"

#, alchemy-end-wait
msgctxt "message"
msgid "04095"
msgstr "D'où vient ce trou?"

#, alchemy-end-wait
msgctxt "message"
msgid "04096"
