msgid "05364"
msgstr "He's making{line_break}hot bean curd.{page_break}Tastes good with rice...{end_wait}"

msgctxt "message"
msgid "05365"
msgstr "There are many{line_break}chopsticks...{page_break}but not a single spoon{line_break}can be seen.{end_wait}"

msgctxt "message"
msgid "05366"
msgstr "There are medicinal{line_break}herbs.{page_break}They have special{line_break}scents.{end_wait}"

msgctxt "message"
msgid "05367"
msgstr "There's a kimono.{page_break}It looks like a{line_break}nightgown for guests{line_break}staying at the inn.{end_wait}"

msgctxt "message"
msgid "05368"
msgstr "It's just a sales report.{page_break}It has lots of{line_break}numbers in a line.{line_break}Looks boring.{end_wait}"

msgctxt "message"
msgid "05369"
msgstr "The pots and pans{line_break}are rusted...{end_wait}"

msgctxt "message"
msgid "05370"
msgstr "He is making{line_break}roast beef.{page_break}Even the peppers{line_break}look appetizing!{end_wait}"

msgctxt "message"
msgid "05371"
msgstr "He is making{line_break}shrimp in a chili sauce.{page_break}The shrimp looks so{line_break}scrumptious...{line_break}My mouth is watering.{end_wait}"

msgctxt "message"
msgid "05372"
msgstr "There is a book titled{line_break}\"Altin: The Mining{line_break}Village.\"{page_break}Altin mines are famous{line_break}for their beautiful gems,{line_break}according to the book.{end_wait}"

