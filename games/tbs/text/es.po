"ser útiles para el combate.{end_wait}"

msgctxt "message"
msgid "08380"
msgstr ""
"Ésta es la zona de batalla.\n"
"Después de llegar aquí, los\n"
"guerreros combaten.{end_wait}"

msgctxt "message"
msgid "08381"
