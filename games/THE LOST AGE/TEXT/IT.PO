msgid "06934"
msgstr "Auuu auuu auuu!!!{end_wait}"

msgctxt "message"
msgid "06935"
msgstr "Cos'era!?{end_wait}"

msgctxt "message"
msgid "06936"
msgstr "Auuuuuu!!!{end_wait}"

msgctxt "message"
msgid "06937"
msgstr "Auuuu!!!{end_wait}"

msgctxt "message"
msgid "06938"
msgstr "Ahh!{end_wait}"

msgctxt "message"
msgid "06939"
msgstr "Non posso crederci!{line_break}Era un...{end_wait}"

msgctxt "message"
msgid "06940"
msgstr "Un cosa? Kraden, tu sai{line_break}cos'era quella cosa?{end_wait}"

msgctxt "message"
msgid "06941"
msgstr "Forse... sì...{end_wait}"

