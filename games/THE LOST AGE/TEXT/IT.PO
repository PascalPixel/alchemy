msgctxt "message"
msgid "05647"
msgstr "Forza! Faremo meglio{line_break}la prossima volta.{end_wait}"

msgctxt "message"
msgid "05648"
msgstr "Avresti dovuto scegliere{line_break}qualcun altro.{line_break}Sono responsabile della sconfitta.{end_wait}"

msgctxt "message"
msgid "05649"
msgstr "Non ho aiutato molto,{line_break}vero? Mi dispiace...{end_wait}"

msgctxt "message"
msgid "05650"
msgstr "?"

msgctxt "message"
msgid "05651"
msgstr "Però, ci hanno proprio{line_break}massacrato... ma cosa è successo?{end_wait}"

msgctxt "message"
msgid "05652"
msgstr "Io ho fatto ciò che potevo.{line_break}Spero anche tu.{end_wait}"

msgctxt "message"
msgid "05653"
msgstr "Forse era meglio{line_break}che non partecipassi...{end_wait}"

msgctxt "message"
msgid "05654"
msgstr "A volte si vince e altre no.{line_break}Questa è la vita.{end_wait}"

msgctxt "message"
msgid "05655"
msgstr "Cosa? Hai perso? Così impari{line_break}a lasciarmi qui!{end_wait}"

msgctxt "message"
msgid "05656"
msgstr "Non fa niente, {actor_name:5}.{line_break}Andrà meglio la prossima volta.{end_wait}"

msgctxt "message"
msgid "05657"
msgstr "So che non c'ero,{line_break}ma mi sento responsabile...{end_wait}"

msgctxt "message"
msgid "05658"
msgstr "?"

msgctxt "message"
msgid "05659"
msgstr "Certo che perderai{line_break}se continui ad avere{line_break}questo atteggiamento terribile!{end_wait}"

msgctxt "message"
msgid "05660"
msgstr "Se mi avessi preso con te,{line_break}niente di tutto questo{line_break}sarebbe accaduto, non scordarlo.{end_wait}"

msgctxt "message"
msgid "05661"
msgstr "Avresti dovuto chiedere{line_break}il mio aiuto. Ne{line_break}avresti avuto bisogno.{end_wait}"

msgctxt "message"
msgid "05662"
msgstr "Io starò a guardare.{line_break}Ma voi che{line_break}andate in battaglia,{page_break}fate del vostro meglio.{end_wait}"

msgctxt "message"
msgid "05663"
msgstr "{text_effect:4}Non ho il coraggio{line_break}di scendere nell'arena.{line_break}Mi siederò qui, se per te è uguale.{end_wait}"

msgctxt "message"
msgid "05664"
msgstr "Sembri magrolino,{line_break}ma a volte i tipi come te{line_break}sono davvero forti...{end_wait}"

msgctxt "message"
msgid "05665"
msgstr "Combattere contro uno come{line_break}te, mi stancherebbe{line_break}da morire.{end_wait}"

msgctxt "message"
msgid "05666"
msgstr "Farò il tifo per te!{line_break}Dai!{end_wait}"

msgctxt "message"
msgid "05667"
msgstr "Mi piace l'uomo macho.{line_break}Tu non fai esercizio,{line_break}vero?{end_wait}"

msgctxt "message"
msgid "05668"
msgstr "Hmm... Si fa così...{line_break}Poi si fa così...{line_break}Argh, non va bene...{end_wait}"

msgctxt "message"
msgid "05669"
msgstr "Puoi usare la Psinergia,{line_break}i Djinn e tutto il resto! Ci{line_break}sono molte strategie...{end_wait}"

msgctxt "message"
msgid "05670"
msgstr "Vinci con uno{line_break}e poi perdi con{line_break}l'altro.{page_break}A seconda del nemico,{line_break}devi cambiare{line_break}strategia.{end_wait}"

msgctxt "message"
msgid "05671"
msgstr "Devo diventare più{line_break}forte, ma non ho{line_break}idee, forse un frullato?{end_wait}"

msgctxt "message"
msgid "05672"
msgstr "Quando scateni un Djinn{line_break}la tua classe può cambiare.{page_break}Devi starci attento{line_break}perché altrimenti puoi{line_break}avere dei guai seri.{end_wait}"

msgctxt "message"
msgid "05673"
msgstr "Dovrei partecipare, o no?{line_break}Sono così indeciso...{end_wait}"

msgctxt "message"
msgid "05674"
msgstr "Pare che sia la prima{line_break}volta per te qui.{page_break}Ti insegnerò cosa{line_break}significa combattere{line_break}in uno scontro.{end_wait}"

msgctxt "message"
msgid "05675"
msgstr "Hai vinto {argument_signed_number}{line_break}Scontr{control:13}{page_break} in link. Continua{line_break}a lavorare sodo!{end_wait}"

msgctxt "message"
msgid "05676"
msgstr "Pare che sia la prima{line_break}volta per te qui.{page_break}Se vuoi posso dirti{line_break}i risultati dello{line_break}scontro, OK?{end_wait}"

msgctxt "message"
msgid "05677"
msgstr "Hai vinto {argument_signed_number}{line_break}Scontr{control:13}{page_break} in link.{page_break}Guarda sulla tabella{line_break}i migliori risultati{line_break}fino ad ora.{end_wait}"

msgctxt "message"
msgid "05678"
msgstr "Alle finali di uno{line_break}Scontro in link possono{line_break}partecipare fino{page_break}a tre alleati. I risultati{line_break}variano molto a seconda{line_break}dei Djinn piazzati.{end_wait}"

msgctxt "message"
msgid "05679"
msgstr "Che grande{line_break}scontro...{line_break}Stupefacente!{end_wait}"

msgctxt "message"
msgid "05680"
msgstr "Peccato... a volte, per vincere{line_break}ci vuole anche fortuna. Non{line_break}devi prendertela...{end_wait}"

msgctxt "message"
msgid "05681"
msgstr "È l'Area di combattimento{line_break}di cui parlava quel vecchio?{line_break}Pensavo che fosse solo{page_break}un sogno... O mi trovo{line_break}dentro al sogno di{line_break}quel vecchio?!{end_wait}"

msgctxt "message"
msgid "05682"
msgstr "Ehi! Siete molto{line_break}più forti di{line_break}quanto sembriate!{end_wait}"

msgctxt "message"
msgid "05683"
msgstr "Che vi è successo? Dovete{line_break}impegnarvi di più!{end_wait}"

msgctxt "message"
msgid "05684"
msgstr "Sembri magrolino,{line_break}ma i tipi come te possono{line_break}essere davvero forti...{end_wait}"

msgctxt "message"
msgid "05685"
msgstr "Combattere uno come{line_break}te, mi stancherebbe{line_break}da morire.{end_wait}"

msgctxt "message"
msgid "05686"
msgstr "Farò il tifo per te!{line_break}Dai!{end_wait}"

msgctxt "message"
msgid "05687"
msgstr "Mi piace l'uomo macho.{line_break}Tu non fai esercizio,{line_break}vero?{end_wait}"

msgctxt "message"
msgid "05688"
msgstr "Hmm... Si fa così...{line_break}Poi si fa così...{line_break}Argh, non va bene...{end_wait}"

msgctxt "message"
msgid "05689"
msgstr "Hmm... Si fa così...{line_break}Poi si fa così...{line_break}Argh, non va bene...{end_wait}"

msgctxt "message"
msgid "05690"
msgstr "Hmm... Si fa così...{line_break}Poi si fa così...{line_break}Argh, non va bene...{end_wait}"

msgctxt "message"
msgid "05691"
msgstr "Sono un guerriero{line_break}viaggiatore. Sono qui{line_break}per diventare più forte!{page_break}Datemi retta: non{line_break}sottovalutate questi{line_break}mostri...{end_wait}"

msgctxt "message"
msgid "05692"
msgstr "Non siete male, ma{line_break}ora non montatevi la{line_break}testa per questa{page_break}vittoria! Continuate{line_break}ad allenarvi.{end_wait}"

msgctxt "message"
msgid "05693"
msgstr "Devi allenarti di più!{page_break}Devi metterci il cuore{line_break}quando combatti!{end_wait}"

msgctxt "message"
msgid "05694"
msgstr "Ti dirò le tue vittorie{line_break}totali quando avrai finito{line_break}le finali in link.{end_wait}"

msgctxt "message"
msgid "05695"
msgstr "Ti dirò le tue vittorie{line_break}consecutive quando avrai{line_break}terminato le finali in link.{end_wait}"

msgctxt "message"
msgid "05696"
msgstr "Hai vinto {argument_signed_number}{line_break}Scontr{control:13}{page_break} coi mostri{line_break}consecutivamente.{page_break}Continua così!{end_wait}"

msgctxt "message"
msgid "05697"
msgstr "Non vedo l'ora di{line_break}sapere quanti Scontri coi{line_break}mostri saprete vincere.{page_break}Conto su{line_break}di voi!{end_wait}"

msgctxt "message"
msgid "05698"
msgstr "Alle finali di uno{line_break}Scontro in link possono{line_break}partecipare fino a tre{page_break}alleati. Ne hai quattro{line_break}in squadra: quello più a{line_break}destra non sarà ammesso.{end_wait}"

msgctxt "message"
msgid "05699"
msgstr "Scontro in link:{line_break}possono partecipare fino{page_break}a tre alleati. Quindi{line_break}potete partecipare tutti!{end_wait}"

msgctxt "message"
msgid "05700"
msgstr "Nello schermo di stato puoi{line_break}cambiare l'ordine degli{line_break}alleati in squadra.{page_break}Lo sapevi già, no?{end_wait}"

msgctxt "message"
msgid "05701"
msgstr "Fino a tre alleati combattono{line_break}con te negli Scontri in link.{page_break}La tua squadra ha{line_break}un totale di otto elementi, ma{line_break}solo i tre a sinistra combattono.{end_wait}"

msgctxt "message"
msgid "05702"
msgstr "Nelle finali in link, dopo{line_break}che il tuo avversario ha{line_break}scelto una mossa, hai 15{page_break}secondi di tempo per scegliere{line_break}un comando... Altrimenti{line_break}difenderai automaticamente.{end_wait}"

msgctxt "message"
msgid "05703"
msgstr "Secondo le regole dello{line_break}Scontro coi mostri, un mostro{line_break}va affrontato in squadra.{page_break}Per combattere in squadra,{line_break}potrai usare le stesse{line_break}tattiche che hai usato{page_break}durante i tuoi viaggi.{end_wait}"

msgctxt "message"
msgid "05704"
msgstr "Vinci con uno{line_break}e poi perdi con{line_break}l'altro.{page_break}A seconda del nemico,{line_break}devi cambiare{line_break}strategia.{end_wait}"

msgctxt "message"
msgid "05705"
msgstr "Puoi usare la Psinergia,{line_break}i Djinn, e tutto il resto! Ci{line_break}sono molte strategie...{end_wait}"

msgctxt "message"
msgid "05706"
msgstr "Dovrei partecipare, o no?{line_break}Sono così indeciso...{end_wait}"

msgctxt "message"
msgid "05707"
msgstr "Un Djinn, per essere{line_break}evocato velocemente,{line_break}deve essere \"attivo\".{page_break}Ma per migliorare la{line_break}tua classe, deve essere{line_break}\"piazzato\"... Che dilemma...{end_wait}"

msgctxt "message"
msgid "05708"
msgstr "Prima della lotta piazzi{line_break}i Djinn o li attivi?{line_break}Io di solito li piazzo{page_break}per aumentare la mia{line_break}classe prima di un{line_break}combattimento.{end_wait}"

msgctxt "message"
msgid "05709"
msgstr "Rimuovi i Djinn che{line_break}usi raramente, così{line_break}puoi evocarli velocemente.{page_break}Io sono impaziente,{line_break}preferisco gli{line_break}scontri brevi{end_wait}"

msgctxt "message"
msgid "05710"
msgstr "Quando scateni un Djinn{line_break}la tua classe può cambiare.{page_break}Devi starci attento{line_break}perché altrimenti puoi{line_break}avere dei guai seri.{end_wait}"

msgctxt "message"
msgid "05711"
msgstr "Tutti i guerrieri sono{line_break}molto forti! Prima di{line_break}iniziare ho una tensione...{end_wait}"

msgctxt "message"
msgid "05712"
msgstr "Se partecipassi mi{line_break}potrei fare male,{line_break}e sarebbe stupido...{end_wait}"

msgctxt "message"
msgid "05713"
msgstr "Vuoi scegliere una canzone?{end_wait} "

msgctxt "message"
msgid "05714"
msgstr "Torna quando vuoi{line_break}ballare!{end_wait}"

