msgctxt "message"
msgid "07615"
msgstr "Era in cima all'albero?{line_break}Ma come ha fatto a finire lì?{end_wait}"

msgctxt "message"
msgid "07616"
msgstr "Io... non so cosa{line_break}dire... Grazie.{line_break}Ora possiamo salpare.{end_wait}"

msgctxt "message"
msgid "07617"
msgstr "Siete saliti sull'albero{line_break}per vedere il Nido del{line_break}Corvo?{page_break}Perché mai ci{line_break}siete saliti?{end_wait}"

msgctxt "message"
msgid "07618"
