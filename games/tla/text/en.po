#, alchemy-end-wait
msgctxt "message"
msgid "08030"
msgstr ""
"At last! The Great Gabomba\n"
"accepts me!"

#, alchemy-end-wait
msgctxt "message"
msgid "08031"
msgstr ""
"I shall answer his call! I shall\n"
"enter the Great Gabomba!\n"
"Wait for me, my people!"

#, alchemy-end-wait
msgctxt "MsgTheBlackOrb"
