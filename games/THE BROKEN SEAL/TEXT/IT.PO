msgctxt "message"
msgid "07499"
msgstr "Gli diciamo di salpare.{end_wait}"

msgctxt "message"
msgid "07500"
msgstr "E se si rifiuta? {end_wait}"

msgctxt "message"
msgid "07501"
msgstr "In quel caso, faremo del{line_break}nostro meglio per{line_break}{pause_20_skippable}convincerlo...{page_break}Mi spiego, Ouranos?{end_wait}"

msgctxt "message"
msgid "07502"
msgstr "Ma è una pazzia!{end_wait}"

msgctxt "message"
msgid "07503"
msgstr "È{pause_20_skippable} un'idea grandiosa!{line_break}Conta su di me.{end_wait}"

msgctxt "message"
msgid "07504"
msgstr "Non voglio{line_break}nessuna violenza!{end_wait}"

msgctxt "message"
msgid "07505"
msgstr "Qualcuno li fermi...{end_wait}"

msgctxt "message"
msgid "07506"
msgstr "Non possono fare{line_break}un ammutinamento...{end_wait}"

msgctxt "message"
msgid "07507"
msgstr "Quei guerrieri erano stufi{line_break}di aspettare, così sono{line_break}andati dal capitano. {end_wait}"

msgctxt "message"
msgid "07508"
