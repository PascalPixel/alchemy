msgctxt "message"
msgid "07791"
msgstr "Aaah... {pause_20_skippable}Pensa che{line_break}per un momento... mi si{line_break}è fermato il cuore!{end_wait}"

msgctxt "message"
msgid "07792"
msgstr "Quel povero rematore. Mi{line_break}dispiace per lui...{page_break}Cosa?{pause_20_skippable} Vuoi che{line_break}prenda il suo posto?{end_now}"

msgctxt "message"
msgid "07793"
msgstr "Come puoi chiedere ad una{line_break}signora di prendere il suo{line_break}posto? Non è giusto!{end_wait}"

msgctxt "message"
msgid "07794"
msgstr "Ah, volevo ben dire. Non si{line_break}può chiedere ad una signora{line_break}di fare un lavoro sporco!{end_wait}"

msgctxt "message"
msgid "07795"
msgstr "Con tutta questa gente, vuoi{line_break}chiedere di remare ad un{line_break}vecchio come me?{end_now}"

msgctxt "message"
msgid "07796"
msgstr "Se mi verrà un collasso{line_break}ti pentirai amaramente{line_break}di avermelo chiesto!{end_wait}"

msgctxt "message"
msgid "07797"
msgstr "Ho capito...{line_break}Non mi sceglierà{line_break}mai nessuno.{end_wait}"

msgctxt "message"
msgid "07798"
msgstr "Un mostro marino ha{line_break}ferito un rematore?{page_break}Mi basta solo che{line_break}non debba prendere{line_break}io il suo posto!{end_wait}"

msgctxt "message"
msgid "07799"
msgstr "Non mi sceglie nessuno...{line_break}Eppure sono la guida{line_break}della gita!{end_wait}"

msgctxt "message"
msgid "07800"
msgstr "Pare che laggiù ci sia{line_break}bisogno di un rematore...{line_break}Non guardate me!{end_wait}"

msgctxt "message"
msgid "07801"
msgstr "Remare è faticoso,{pause_20_skippable}{line_break}vero?{pause_20_skippable}{line_break}No, non fa per me!{end_wait}"

msgctxt "message"
msgid "07802"
msgstr "Ehi! Questo ragazzo mi sta{line_break}guardando da quando siamo{line_break}partiti... Forse gli piaccio!{end_wait}"

msgctxt "message"
msgid "07803"
msgstr "Oh!{pause_20_skippable} Oh, no! Non vorrà{line_break}per caso chiedermi di{line_break}remare, vero?{end_wait}"

msgctxt "message"
msgid "07804"
msgstr "Ti prego... {pause_20_skippable}{line_break}Ti prego... Fa che{line_break}non scelga me!{end_wait}"

msgctxt "message"
msgid "07805"
msgstr "Che vuoi da me?{line_break}Cerca tra gli{line_break}uomini, no!?{end_wait}"

msgctxt "message"
msgid "07806"
msgstr "Ma perché mi preoccupo{line_break}tanto?{page_break}Non sceglierà di certo{line_break}un vecchio decrepito{line_break}come me!{end_wait}"

msgctxt "message"
msgid "07807"
msgstr "Abbiamo già avuto problemi{line_break}a trovare passeggeri!{page_break}Non possiamo contare su{line_break}rematori di riserva...{end_wait}"

msgctxt "message"
msgid "07808"
msgstr "Pare che ti abbiano{line_break}scelto per aiutare{line_break}a remare, vero?{page_break}Beh, allora che aspetti?{line_break}Rema!{end_wait}"

msgctxt "message"
msgid "07809"
msgstr "Ah ah ah!{pause_20_skippable}{line_break}T'hanno preso a{line_break}remare, eh?{end_wait}"

msgctxt "message"
msgid "07810"
msgstr "Alla fine hai trovato{line_break}qualcuno, vero? Bene,{line_break}vediamo cosa sa fare!{end_wait}"

msgctxt "message"
msgid "07811"
msgstr "Ho i brividi a pensare{line_break}che avrei potuto{line_break}essere io.{end_wait}"

msgctxt "message"
msgid "07812"
msgstr "Ehi, {actor_name:1}. Hai{line_break}scelto bene!{end_wait}"

msgctxt "message"
msgid "07813"
msgstr "È questa la persona{line_break}scelta per remare?{page_break}Bella scelta!{line_break}Sembra in gamba.{end_wait}"

msgctxt "message"
msgid "07814"
msgstr "Se hai scelto il{line_break}rematore, iniziamo{line_break}a remare!{end_wait}"

msgctxt "message"
msgid "07815"
msgstr "Hanno scelto te{line_break}per remare? Che{line_break}onore!{end_wait}"

msgctxt "message"
msgid "07816"
msgstr "Oh oh! È questa la persona che{line_break}ci farà arrivare a Tolbi?{end_wait}"

msgctxt "message"
msgid "07817"
msgstr "Mi dà ai nervi vederti{line_break}lì in piedi alla ricerca{line_break}di un rematore.{end_wait}"

msgctxt "message"
msgid "07818"
msgstr "Sudavo freddo pensando{line_break}che avresti potuto{line_break}scegliere me!{end_wait}"

msgctxt "message"
msgid "07819"
msgstr "Questo stupidello è così{line_break}triste che fra un po' si{line_break}mette a piangere!{end_wait}"

msgctxt "message"
msgid "07820"
msgstr "Oh, no. No... Quando t'ho{line_break}guardato in faccia, ho{line_break}capito tutto.{end_wait}"

msgctxt "message"
msgid "07821"
msgstr "È normale che non abbiano{line_break}scelto me.{end_wait}"

msgctxt "message"
msgid "07822"
msgstr "Per stavolta l'ho fatta{line_break}franca... Ma la prossima volta?{end_wait}"

msgctxt "message"
msgid "07823"
msgstr "Ehi... Con quel guerriero non{line_break}si scherza! Meno male che{line_break}non ha scelto me.{end_wait}"

msgctxt "message"
msgid "07824"
msgstr "Con quello lì{line_break}bisogna rigare{line_break}dritti...{end_wait}"

msgctxt "message"
msgid "07825"
msgstr "Fai attenzione...{pause_20_skippable}{line_break}Non guardarlo negli occhi.{line_break}Guarda dall'altra parte.{end_wait}"

msgctxt "message"
msgid "07826"
msgstr "È stato ferito un{line_break}altro rematore...{page_break}Dobbiamo trovare un{line_break}sostituto{line_break}tra i passeggeri.{end_wait}"

msgctxt "message"
msgid "07827"
msgstr "Mi dispiace per i{line_break}rematori che sono{line_break}stati feriti.{page_break}Cerchiamo di impedire che{line_break}si faccia male qualcun{line_break}altro, OK, {actor_name:1}?{end_wait}"

msgctxt "message"
msgid "07828"
msgstr "Un rematore è stato ferito?{end_wait}"

msgctxt "message"
msgid "07829"
msgstr "Non c'è tempo da perdere.{line_break}Dobbiamo tirarci fuori{line_break}dalle acque di Kalagol!{end_wait}"

msgctxt "message"
msgid "07830"
msgstr "Nessuno può dire quando i{line_break}mostri marini{line_break}attaccheranno di nuovo.{page_break}Ma farò in modo che{line_break}smettano di{line_break}infastidirci!{end_wait}"

msgctxt "message"
msgid "07831"
msgstr "Oooh. Se guardo l'acqua{line_break}mi sento male.{page_break}Chissà quanto dovremmo ancora{line_break}lottare in queste condizioni...{end_wait}"

msgctxt "message"
msgid "07832"
msgstr "Sapevamo i rischi che{line_break}avremmo corso...{page_break}Ma è sempre triste quando{line_break}dei membri dell'equipaggio{line_break}vengono feriti.{end_wait}"

msgctxt "message"
msgid "07833"
msgstr "{actor_name:1}, sei tornato.{end_wait}"

msgctxt "message"
msgid "07834"
msgstr "EHi!{pause_20_skippable} Dov'è il{line_break}sostituto per il{line_break}rematore ferito?{end_wait}"

msgctxt "message"
msgid "07835"
msgstr "Come? Non hai trovato{line_break}nessun sostituto?{end_wait}"

msgctxt "message"
msgid "07836"
msgstr "Se non abbiamo abbastanza{line_break}rematori la nave non{line_break}potrà muoversi!{end_wait}"

msgctxt "message"
msgid "07837"
msgstr "Mi spiace dirtelo, ma{line_break}devi assolutamente{line_break}trovare qualcuno!{end_wait}"

msgctxt "message"
msgid "07838"
msgstr "{actor_name:1}, sei tornato!{line_break}E hai portato un{line_break}rematore con te!{end_wait}"

msgctxt "message"
msgid "07839"
msgstr "Bene, ora tu{line_break}dovrai remare.{end_wait}"

msgctxt "message"
msgid "07840"
msgstr "Vai al tuo{line_break}posto, dai.{end_wait}"

msgctxt "message"
msgid "07841"
msgstr "Ora dovremo di nuovo{line_break}proteggere questa{line_break}zona, {actor_name:1}.{end_wait}"

msgctxt "message"
msgid "07842"
msgstr "Se non{line_break}partiamo subito...{end_wait}"

msgctxt "message"
msgid "07843"
msgstr "Che problema ci sarà?{pause_20_skippable}{line_break}La nave oscilla{line_break}in modo strano.{end_wait}"

msgctxt "message"
msgid "07844"
msgstr "{actor_name:1}!{end_wait}"

msgctxt "message"
msgid "07845"
msgstr "{actor_name:1}, sul ponte!{end_wait}"

msgctxt "message"
msgid "07846"
msgstr "{actor_name:1}, c'è{line_break}un orribile mostro marino{line_break}sulla nave!{end_wait}"

msgctxt "message"
msgid "07847"
msgstr "Se non facciamo qualcosa...{line_break}...affonderemo! Devi{line_break}aiutarci!{end_wait}"

msgctxt "message"
msgid "07848"
msgstr "Se la nave affonda{line_break}tutti i nostri sforzi{line_break}saranno stati inutili...{page_break}Dobbiamo distruggere{line_break}quei mostri marini!{end_wait}"

msgctxt "message"
msgid "07849"
msgstr "Immagina quanto è{line_break}grande quella bestia!{page_break}Come si fa ad uccidere{line_break}un essere così enorme?{end_wait}"

msgctxt "message"
msgid "07850"
msgstr "Questi mostri marini{line_break}continuano ad arrivare{line_break}uno dopo l'altro.{end_wait}"

msgctxt "message"
msgid "07851"
msgstr "A giudicare dalla reazione{line_break}di Kaja dev'essere una{line_break}bestia davvero spaventosa...{end_wait}"

msgctxt "message"
msgid "07852"
msgstr "Kaja non ci chiederebbe{line_break}aiuto se non ci fosse{line_break}un serio pericolo.{end_wait}"

msgctxt "message"
msgid "07853"
msgstr "La nave sta oscillando!{line_break}Quel mostro dev'essere{line_break}gigantesco!{end_wait}"

msgctxt "message"
msgid "07854"
msgstr "È tutto apposto. Con{line_break}voi qui, nulla può{line_break}farci paura.{end_wait}"

msgctxt "message"
msgid "07855"
msgstr "Se la nave affonda{line_break}è finita per noi.{end_wait}"

msgctxt "message"
msgid "07856"
msgstr "Kaja e i suoi uomini sono{line_break}molto preoccupati: sarà{line_break}una lotta durissima.{end_wait}"

msgctxt "message"
msgid "07857"
msgstr "Mostri ovunque...{line_break}E io sono qui a remare!{line_break}Dovevo starmene a casa!{end_wait}"

msgctxt "message"
msgid "07858"
msgstr "La nave si sta inclinando...{line_break}Se non facciamo qualcosa,{line_break}affonderà!{end_wait}"

msgctxt "message"
msgid "07859"
msgstr "Ma quanti mostri{line_break}ci sono là fuori?{end_wait}"

msgctxt "message"
msgid "07860"
msgstr "Un altro mostro? E{line_break}pensare che ho pagato un{line_break}biglietto di prima classe!{end_wait}"

msgctxt "message"
msgid "07861"
msgstr "Le mie mani sono piene di{line_break}calli da quanto ho remato!{end_wait}"

msgctxt "message"
msgid "07862"
msgstr "Che ci fa qui?{line_break}Non dovrebbe lottare contro{line_break}i mostri sul ponte?{end_wait}"

msgctxt "message"
msgid "07863"
msgstr "Che succede? Quanti mostri{line_break}sono con questo?{end_wait}"

msgctxt "message"
msgid "07864"
msgstr "Ma che razza di mostro può{line_break}fare oscillare la nave...{line_break}Voglio dare un'occhiata...{end_wait}"

msgctxt "message"
msgid "07865"
msgstr "Abbiamo sempre meno{line_break}rematori e mi sto{line_break}innervosendo...{end_wait}"

msgctxt "message"
msgid "07866"
msgstr "Sto facendo una pausa{line_break}aspettando che i mostri{line_break}marini siano battuti.{end_wait}"

msgctxt "message"
msgid "07867"
msgstr "È un bene che abbiamo{line_break}dei forti guerrieri{line_break}sulla nave.{end_wait}"

msgctxt "message"
msgid "07868"
msgstr "Chissà se il mostro è{line_break}abbastanza grande da far{line_break}affondare la nave.{end_wait}"

msgctxt "message"
msgid "07869"
msgstr "Sbrigatevi a far fuori{line_break}quella bestia, a{line_break}qualsiasi costo!{end_wait}"

msgctxt "message"
msgid "07870"
msgstr "Se arrivano dei{line_break}mostri... Dategli una{line_break}bella lezione!{end_wait}"

msgctxt "message"
msgid "07871"
msgstr "La nave oscilla{line_break}spaventosamente...{line_break}È la fine!{end_wait}"

msgctxt "message"
msgid "07872"
msgstr "Non pensavo che ci{line_break}fossero tanti{line_break}mostri in mare...{end_wait}"

msgctxt "message"
msgid "07873"
msgstr "Siamo circondati dai{line_break}mostri, e la terra ferma{line_break}non si vede ancora...{end_wait}"

msgctxt "message"
msgid "07874"
msgstr "Chissà se dopo aver sconfitto{line_break}il mostro ci faranno{line_break}remare di nuovo.{end_wait}"

msgctxt "message"
msgid "07875"
msgstr "Grazie, {actor_name:1}.{line_break}Hai lottato bene{line_break}contro il Kraken.{end_wait}"

msgctxt "message"
msgid "07876"
msgstr "Ma abbiamo perso{line_break}un altro rematore.{end_wait}"

msgctxt "message"
msgid "07877"
msgstr "Devo controllare lo scafo.{line_break}Tu vai a cercare qualcuno{line_break}che possa remare.{end_wait}"

msgctxt "message"
msgid "07878"
msgstr "Terra!{end_wait}"

msgctxt "message"
msgid "07879"
msgstr "Ehi,{pause_20_skippable} vedo la terraferma!{end_wait}"

msgctxt "message"
msgid "07880"
msgstr "Pare che ce l'abbiamo fatta!{end_wait}"

msgctxt "message"
msgid "07881"
msgstr "Ce l'abbiamo fatta?{pause_20_skippable}{line_break}Finalmente! È una fortuna{line_break}essere ancora vivi!{end_wait}"

msgctxt "message"
msgid "07882"
msgstr "Gli altri passeggeri sono{line_break}già sbarcati...{line_break}Non hanno neppure salutato.{end_wait}"

msgctxt "message"
msgid "07883"
msgstr "Non dobbiamo più{line_break}remare? Ah, che{line_break}sollievo!{end_wait}"

msgctxt "message"
msgid "07884"
msgstr "Era tanto che{line_break}non lavoravo{line_break}così duro!{end_wait}"

msgctxt "message"
msgid "07885"
msgstr "Remare in una nave è più{line_break}divertente di quanto credessi!{line_break}Mi sento muscolosissimo!{end_wait}"

msgctxt "message"
msgid "07886"
msgstr "Che tristezza... Ho fatto{line_break}un viaggio in mare e non{line_break}l'ho neppure visto!{end_wait}"

msgctxt "message"
msgid "07887"
msgstr "Prima costringi un vecchio a{line_break}remare per poi maltrattarlo{line_break}sulla terraferma?{page_break}È patetico.{end_wait}"

msgctxt "message"
msgid "07888"
msgstr "Grazie per tutto il{line_break}lavoro che avete fatto.{end_wait}"

msgctxt "message"
msgid "07889"
msgstr "Grazie a voi questa nave{line_break}è salva.{end_wait}"

msgctxt "message"
msgid "07890"
msgstr "Grazie ancora.{end_wait}"

msgctxt "message"
msgid "07891"
msgstr "Ehi, sbrigatevi! Il{line_break}Colossum di Tolbi è{line_break}già iniziato!{end_wait}"

msgctxt "message"
msgid "07892"
msgstr "Fareste bene ad andare a{line_break}Tolbi anche voi.{end_wait}"

msgctxt "message"
msgid "07893"
msgstr "Credo che per un bel po'{line_break}nessuno potrà{line_break}attraversare Karagol...{page_break}I rematori si rifiuteranno{line_break}di lavorare per noi.{end_wait}"

msgctxt "message"
msgid "07894"
msgstr "Avete combattuto{line_break}davvero bene.{end_wait}"

msgctxt "message"
msgid "07895"
msgstr "Molti rematori sono{line_break}rimasti feriti{line_break}durante il viaggio.{page_break}Nessuno di loro lavorerà{line_break}più finché il Mare di Karagol{line_break}non sarà tornato tranquillo.{end_wait}"

msgctxt "message"
msgid "07896"
msgstr "Siamo salvi! Tutto perché{line_break}avete sconfitto{line_break}quei mostri!{end_wait}"

msgctxt "message"
msgid "07897"
msgstr "Ho fatto il rematore per{line_break}tutta la vita ma quest'ultimo{line_break}viaggio è stato il peggiore!{end_wait}"

msgctxt "message"
msgid "07898"
msgstr "Andate avanti voi... Subito{line_break}dopo aver visto che tutto era{line_break}andato per il meglio, mi si{page_break}è bloccata la schiena: ora{line_break}non posso muovermi.{end_wait}"

msgctxt "message"
msgid "07899"
msgstr "Non troveremo nessuno che{line_break}sostituisca i rematori.{end_wait}"

msgctxt "message"
msgid "07900"
msgstr "Mi fa solo piacere che quel{line_break}Kraken non m'abbia colpito.{end_wait}"

msgctxt "message"
msgid "07901"
msgstr "La paga sarà anche buona, ma{line_break}non voglio lavorare in{line_break}mezzo al pericolo.{end_wait}"

msgctxt "message"
msgid "07902"
msgstr "{actor_name:1} e i suoi{line_break}compagni sono stati{line_break}gentili ad aiutarci.{end_wait}"

msgctxt "message"
msgid "07903"
msgstr "Ora sto meglio, ma{line_break}mentre remavo ho{line_break}avuto una paura!{end_wait}"

msgctxt "message"
msgid "07904"
msgstr "Me la prendo con calma...{line_break}Potrebbe essere l'ultima volta{line_break}che salgo su una nave.{end_wait}"

msgctxt "message"
msgid "07905"
msgstr "Sean e Ouranos sono andati{line_break}a Tolbi insieme al{line_break}gruppo in gita.{page_break}Immagino che andassero{line_break}al Colossum.{end_wait}"

msgctxt "message"
msgid "07906"
msgstr "Andate anche voi{line_break}al Colossum?{end_now}"

msgctxt "message"
msgid "07907"
msgstr "Lo sapevo. In questo{line_break}periodo dell'anno vanno{line_break}quasi tutti là.{page_break}Quei sei che abbiamo{line_break}trasportato qualche{line_break}tempo fa...Erano{page_break}davvero strani.{end_wait}"

msgctxt "message"
msgid "07908"
msgstr "Abbiamo fatto tutta questa{line_break}strada per non andare{line_break}al Colossum?{page_break}Prima il gruppo di quel{line_break}vecchio, quei sei tipi{line_break}strambi, e ora voi...{page_break}La gente è proprio strana!{end_wait}"

msgctxt "message"
msgid "07909"
msgstr "Il gruppo dell'ultimo{line_break}viaggio ne ha fatte{line_break}delle bravate.{page_break}A dire il vero li{line_break}stavo spiando.{end_wait}"

msgctxt "message"
msgid "07910"
msgstr "Sean e Ouranos potrebbero{line_break}vincere al Colossum{line_break}quest'anno ma se partecipa{page_break}anche {actor_name:1} non credo{line_break}che avranno qualche{line_break}possibilità.{end_wait}"

msgctxt "message"
msgid "07911"
msgstr "Ora voglio passare un{line_break}po' di tempo a Tolbi{line_break}in santa pace.{end_wait}"

msgctxt "message"
msgid "07912"
msgstr "Mi chiedo cosa sia successo{line_break}a quello strano gruppo{line_break}che è andato a Tolbi.{end_wait}"

msgctxt "message"
msgid "07913"
msgstr "Quando il mare è così{line_break}pericoloso non si{line_break}può navigare.{page_break}Non so che fare...{line_break}Mi farò venire un'idea{line_break}mentre visito il Colossum...{end_wait}"

msgctxt "message"
msgid "07914"
msgstr "Visto? La nostra nave ha{line_break}resistito agli attacchi ed{line_break}è arrivata sana e salva.{page_break}Questo dimostra che{line_break}l'ancora portafortuna{line_break}è davvero efficace!{end_wait}"

msgctxt "message"
msgid "07915"
msgstr "Ho sentito che avete fatto un{line_break}viaggio orribile: v'hanno{line_break}persino attaccato i mostri!{end_now}"

msgctxt "message"
msgid "07916"
msgstr "Chissà perché il mare è{line_break}diventato improvvisamente{line_break}così pericoloso...{end_wait}"

msgctxt "message"
msgid "07917"
msgstr "E li hai uccisi tutti{line_break}tu da solo?{line_break}...Non ci credo!{page_break}Lo sanno tutti che è{line_break}stato Kaja ad uccidere{line_break}il Kraken!{end_wait}"

msgctxt "message"
msgid "07918"
msgstr "Sigh...{pause_20_skippable} Non potremo{line_break}navigare per un bel po'.{page_break}Abbiamo già perso una{line_break}nave... Cos'altro{line_break}possiamo fare?{end_wait}"

msgctxt "message"
msgid "07919"
msgstr "Penso che per un bel{line_break}po' nessuno ritornerà{line_break}a casa ad Angara.{end_wait}"

msgctxt "message"
msgid "07920"
msgstr "Credo che quella nave{line_break}si sia imbattuta{line_break}nel Kraken...{end_wait}"

msgctxt "message"
msgid "07921"
msgstr "Mi spiace, ma al{line_break}momento non possiamo{line_break}vendere biglietti.{page_break}Il mare è troppo pericoloso,{line_break}quindi le partenze sono{line_break}tutte cancellate.{end_wait}"

msgctxt "message"
msgid "07922"
msgstr "Ho dato la casa in affitto a{line_break}delle persone venute per il{line_break}Colossum, e  ora non si parte!{page_break}Se la nave non parte, il{line_break}mio viaggio va in fumo!{end_wait}"

msgctxt "message"
msgid "07923"
msgstr "Ho dato casa mia in affitto.{line_break}Se la nave non parte, io e la{line_break}mia famiglia dove dormiamo?{end_wait}"

msgctxt "message"
msgid "07924"
msgstr "Stiamo perdendo parecchi{line_break}soldi non potendo viaggiare.{line_break}Se non è sfortuna questa...{end_wait}"

msgctxt "message"
msgid "07925"
msgstr "Credo che staremo qui{line_break}finché non parte la nave.{end_wait}"

msgctxt "message"
msgid "07926"
msgstr "Dovremo dormire per{line_break}terra finché la nave{line_break}non riparte?{end_wait}"

msgctxt "message"
msgid "07927"
msgstr "I turisti non sembrano tanto{line_break}contenti. Hanno sofferto{line_break}il mal di mare?{end_now}"

msgctxt "message"
msgid "07928"
msgstr "Il mare era calmo, ma la{line_break}nave deve aver ballato{line_break}parecchio per quel mostro.{end_wait}"

msgctxt "message"
msgid "07929"
msgstr "La nave è stata attaccata{line_break}dai mostri? Stava davvero per{line_break}affondare? Ma non mi dire...{end_wait}"

msgctxt "message"
msgid "07930"
msgstr "La Strada della Seta è{line_break}bloccata, quindi pensavo che{line_break}i miei genitori venissero{page_break}in nave... Ma non{line_break}li vedo...{end_wait}"

msgctxt "message"
msgid "07931"
msgstr "Come?{pause_20_skippable} Hai un{line_break}messaggio da parte{line_break}dei miei genitori?{end_now}"

msgctxt "message"
msgid "07932"
msgstr "Ah, davvero? Non sono{line_break}venuti perché il biglietto{line_break}era troppo caro?{page_break}Ah, grazie per{line_break}avermelo fatto sapere!{end_wait}"

msgctxt "message"
msgid "07933"
msgstr "Spero solo che non{line_break}sia accaduto loro{line_break}nulla di grave...{end_wait}"

msgctxt "message"
msgid "07934"
msgstr "Grazie per avermi{line_break}riferito il messaggio{line_break}dei miei genitori.{end_wait}"

msgctxt "message"
msgid "07935"
msgstr "Per Tolbi, si deve{line_break}andare sempre ad ovest.{line_break}È impossibile sbagliare.{end_wait}"

msgctxt "message"
msgid "07936"
msgstr "I partecipanti della gita{line_break}al Colossum sono partiti per{line_break}Tolbi già da molto tempo.{end_wait}"

msgctxt "message"
msgid "07937"
msgstr "Dopo aver visto le{line_break}facce dei passeggeri,{page_break}non me la sentirei{line_break}di partire.{end_wait}"

msgctxt "message"
msgid "07938"
msgstr "È stata una traversata{line_break}molto rischiosa. È meglio{line_break}che non siano venuti...{end_wait}"

msgctxt "message"
msgid "07939"
msgstr "Credo che per un po'{line_break}non ci saranno{line_break}viaggi in mare.{end_wait}"

msgctxt "message"
msgid "07940"
msgstr "Avete attraversato il mare{line_break}soltanto per il Colossum?{line_break}Che impresa!{end_wait}"

msgctxt "message"
msgid "07941"
msgstr "Umm... {pause_20_skippable} E così siamo{line_break}a Tolbi finalmente!{end_wait}"

msgctxt "message"
msgid "07942"
msgstr "Umm... No.{page_break}Non mi pare che sia{line_break}la costa di Tolbi...{end_wait}"

msgctxt "message"
msgid "07943"
msgstr "Forse abbiamo sbagliato{line_break}rotta... Non riconosco{line_break}questo posto.{end_wait}"

msgctxt "message"
msgid "07944"
msgstr "È vero...{line_break}Sembra un'isola.{end_wait}"

msgctxt "message"
msgid "07945"
msgstr "Beh, forse possiamo{line_break}fermarci per un minuto.{end_wait}"

msgctxt "message"
msgid "07946"
msgstr "Ci serve tempo per calcolare{line_break}la posizione della nave...{page_break}Puntiamo verso quell'{line_break}isola e cerchiamo{line_break}di orientarci.{end_wait}"

msgctxt "message"
msgid "07947"
msgstr "Abbiamo raggiunto l'isola!{pause_20_skippable}{line_break}Rematori, ora{line_break}potete riposarvi!{end_wait}"

msgctxt "message"
msgid "07948"
msgstr "Un'isola? Ma allora{line_break}non siamo a Tolbi?{end_wait}"

msgctxt "message"
msgid "07949"
msgstr "Come, un'isola?{line_break}Non siamo a Tolbi?{end_wait}"

msgctxt "message"
msgid "07950"
msgstr "Ma... Tolbi non è{line_break}un'isola, vero?{end_wait}"

msgctxt "message"
msgid "07951"
msgstr "Siamo andati fuori rotta{line_break}e ora non... non sappiamo{line_break}con precisione dove siamo!{page_break}Faremo sosta su quest'isola{line_break}per poter calcolare la{line_break}nostra posizione.{end_wait}"

msgctxt "message"
msgid "07952"
msgstr "Ora potete lasciare i remi{line_break}e riposarvi un po'.{end_wait}"

msgctxt "message"
msgid "07953"
msgstr "Farò un controllo{line_break}dei passeggeri.{end_wait}"

msgctxt "message"
msgid "07954"
msgstr "Se la nave non parte,{line_break}non ha senso che io{line_break}stia qui ad aspettare.{page_break}Andrò a{line_break}fare un giro.{end_wait}"

msgctxt "message"
msgid "07955"
msgstr "Se non devo remare,{line_break}che ci sto a fare qui?{page_break}Andrò a dare un'occhiata{line_break}là fuori.{end_wait}"

msgctxt "message"
msgid "07956"
msgstr "Finché non ripartiamo,{line_break}non serve che io{line_break}resti qui dentro.{page_break}Me n'andrò un po' in giro.{end_wait}"

msgctxt "message"
msgid "07957"
msgstr "Navigo da anni ormai,{line_break}ma non ho mai visto{line_break}quest'isola prima d'ora!{end_wait}"

msgctxt "message"
msgid "07958"
msgstr "Ma guarda!{pause_20_skippable} Ho una{line_break}vescica sulla mano...{end_wait}"

msgctxt "message"
msgid "07959"
msgstr "Chissà se è il posto giusto{line_break}per lasciare la nave...{end_wait}"

msgctxt "message"
msgid "07960"
msgstr "Tutte queste pause sono{line_break}più faticose che se si{line_break}remasse tutto il giorno.{end_wait}"

msgctxt "message"
msgid "07961"
msgstr "Vediamo, le isole del{line_break}Mare di Karagol...{pause_20_skippable}{pause_20_skippable}{line_break}Fammi pensare...{end_wait}"

msgctxt "message"
msgid "07962"
msgstr "Quando remi{line_break}sei sempre{line_break}in movimento...{page_break}Stare qui seduto{line_break}a far niente{line_break}mi rende nervoso.{end_wait}"

msgctxt "message"
msgid "07963"
msgstr "È assurdo far remare{line_break}dei passeggeri senza{line_break}alcuna esperienza.{end_wait}"

msgctxt "message"
msgid "07964"
msgstr "Questo viaggio è molto{line_break}faticoso per me.{end_wait}"

msgctxt "message"
msgid "07965"
msgstr "Spero solo che non ci{line_break}attacchi un altro mostro...{end_wait}"

msgctxt "message"
msgid "07966"
msgstr "Era da molto tempo{line_break}che non mi facevano{line_break}male i muscoli...{end_wait}"

msgctxt "message"
msgid "07967"
msgstr "Non sarà mica l'isola dove{pause_20_skippable}{line_break}dicono che sia sepolto{line_break}un tesoro?{page_break}Anche se lo fosse, ho troppa{line_break}paura dei mostri per{line_break}lasciare la nave.{end_wait}"

msgctxt "message"
msgid "07968"
msgstr "Forse è ora che{line_break}mi ritiri...{end_wait}"

msgctxt "message"
msgid "07969"
msgstr "È assurdo esplorare{line_break}l'isola! Troppo pericoloso!{page_break}E se incontrassimo{line_break}dei mostri?{end_wait}"

msgctxt "message"
msgid "07970"
msgstr "Ma se in mare c'erano{line_break}dei mostri, forse è meno{line_break}pericoloso sulla terraferma!{end_wait}"

msgctxt "message"
msgid "07971"
msgstr "Siamo rimasti già troppo{line_break}a lungo su quella nave.{page_break}Ora che siamo qui,{line_break}sgranchiamoci le gambe!{end_wait}"

msgctxt "message"
msgid "07972"
msgstr "Potrebbero esserci dei mostri{line_break}qui in giro... Forse è meglio{line_break}rimanere sulla nave.{end_wait}"

msgctxt "message"
msgid "07973"
msgstr "La nave continua ad oscillare!{line_break}Non ce la fa più!{page_break}Voglio mettere finalmente{line_break}piede sulla terraferma!{end_wait}"

msgctxt "message"
msgid "07974"
msgstr "Perché dovremmo aspettare{line_break}su questa barchetta?{end_wait}"

msgctxt "message"
msgid "07975"
msgstr "Se ci sono dei mostri,{line_break}io non mi muovo di qui.{end_wait}"

msgctxt "message"
msgid "07976"
msgstr "Sean e Ouranos potrebbero{line_break}vincere al Colossum{line_break}quest'anno, ma se partecipa{page_break}anche {actor_name:1} non credo{line_break}che avranno qualche{line_break}possibilità.{end_wait}"

msgctxt "message"
msgid "07977"
msgstr "Non mi sento bene...{line_break}Stammi alla larga...{end_wait}"

msgctxt "message"
msgid "07978"
msgstr "Odio discutere...{end_wait}"

msgctxt "message"
msgid "07979"
msgstr "Che fare...{line_break}La sorte dei passeggeri{line_break}mi sta a cuore.{end_wait}"

msgctxt "message"
msgid "07980"
msgstr "Ma perché dovrebbero restare{line_break}se possono scendere{line_break}a terra?{end_wait}"

msgctxt "message"
msgid "07981"
msgstr "Non ce la faccio più su{line_break}questa nave... Scendo a terra!{end_wait}"

msgctxt "message"
msgid "07982"
msgstr "I mostri di terra non mi{line_break}preoccupano, ma quelli{line_break}marini... sono disgustosi!{end_wait}"

msgctxt "message"
msgid "07983"
msgstr "Non ce la faccio più di{line_break}barcollare su questa{line_break}bagnarola!{end_wait}"

msgctxt "message"
msgid "07984"
msgstr "Ora scendo a terra! E{line_break}provate a fermarmi!!!{end_wait}"

msgctxt "message"
msgid "07985"
msgstr "Spero solo di non{line_break}rivedere quell'orribile{line_break}Kraken...{end_wait}"

msgctxt "message"
msgid "07986"
msgstr "Allora... Qualcuno sa{line_break}se ci sono dei mostri{line_break}là fuori?{end_wait}"

msgctxt "message"
msgid "07987"
msgstr "È raccappricciante...{end_wait}"

msgctxt "message"
msgid "07988"
msgstr "In un mondo perfetto, non ci{line_break}sarebbero mostri pronti{line_break}a saltarmi addosso...{end_wait}"

msgctxt "message"
msgid "07989"
msgstr "{protagonist_name}, non dovresti{line_break}parlare così.{pause_20_skippable} Non è{line_break}meglio ascoltarli?{end_now}"

msgctxt "message"
msgid "07990"
msgstr "Kaja e il capitano sono{line_break}dei professionisti.{page_break}Dobbiamo fidarci e aspettare,{line_break}come hanno detto.{end_wait}"

msgctxt "message"
msgid "07991"
msgstr "{actor_name:1}, hai parlato{line_break}con i passeggeri,{line_break}vero?{page_break}Quelli della gita stanno{line_break}decidendo se scendere{line_break}a terra o no.{end_wait}"

msgctxt "message"
msgid "07992"
msgstr "Vorremmo scendere a terra{line_break}per vedere se ci{line_break}sono pericoli...{page_break}Ma abbiamo promesso{line_break}di proteggere la nave.{end_wait}"

msgctxt "message"
msgid "07993"
msgstr "{actor_name:1}!{page_break}Potresti fare un giro{line_break}sull'isola per vedere se{line_break}ci sono dei mostri?{end_now}"

msgctxt "message"
msgid "07994"
msgstr "I passeggeri sembrano un{line_break}po' agitati, è meglio{line_break}assecondarli.{end_wait}"

msgctxt "message"
msgid "07995"
msgstr "Sì, è meglio aiutarli.{line_break}Non possono farcela{line_break}da soli.{end_wait}"

msgctxt "message"
msgid "07996"
msgstr "Sarebbe bello esplorare{line_break}l'isola!{line_break}Che ne dici, {actor_name:1}?{end_now}"

msgctxt "message"
msgid "07997"
msgstr "Ah, capisco... Andrai{line_break}tu per noi.{page_break}Se eslporassimo l'isola{line_break}nessuno avrebbe{line_break}da ridire.{end_wait}"

msgctxt "message"
msgid "07998"
msgstr "Potrebbe esserci{line_break}di tutto là fuori.{line_break}Sii prudente,{page_break}mi raccomando!{end_wait}"

msgctxt "message"
msgid "07999"
msgstr "Finora abbiamo{line_break}difeso molto bene{line_break}questa nave!{page_break}{actor_name:1}, penseremo{line_break}a tutto noi mentre{line_break}sei via.{end_wait}"

msgctxt "message"
msgid "08000"
msgstr "Voglio diventare un marinaio{line_break}come Kaja e imparare a leggere{line_break}i venti e le onde...{end_wait}"

msgctxt "message"
msgid "08001"
msgstr "Mi arrendo! Fate un{line_break}po' come volete!{end_wait}"

msgctxt "message"
msgid "08002"
msgstr "Basta litigare...{end_wait}"

msgctxt "message"
msgid "08003"
msgstr "Quell'isola mi mette{line_break}i brividi...{end_wait}"

msgctxt "message"
msgid "08004"
msgstr "Cosa possiamo fare ora{line_break}per proteggere la nave...{end_wait}"

msgctxt "message"
msgid "08005"
msgstr "Attenzione! Potrebbero{line_break}esserci mostri{line_break}qui intorno.{end_wait}"

msgctxt "message"
msgid "08006"
msgstr "Potreste essere sorpresi{line_break}dai tesori che si possono{line_break}trovare qui in giro.{end_wait}"

msgctxt "message"
msgid "08007"
msgstr "Abbiamo perso la rotta,{line_break}ma siamo comunque{line_break}molto avanti...{end_wait}"

msgctxt "message"
msgid "08008"
msgstr "Stiamo calcolando la{line_break}posizione della nave.{line_break}Ci vorrà ancora un po'...{end_wait}"

msgctxt "message"
msgid "08009"
msgstr "È sorprendente che nel{line_break}Mare di Karagol ci sia{line_break}un'isola del genere.{end_wait}"

msgctxt "message"
msgid "08010"
msgstr "Dal mare e dalla direzione{line_break}del vento... Si direbbe che{line_break}siamo vicini a Tolbi.{end_wait}"

msgctxt "message"
msgid "08011"
msgstr "Allora, {actor_name:1}?{pause_20_skippable}{line_break}Hai esplorato{line_break}tutta l'isola?{end_now}"

msgctxt "message"
msgid "08012"
msgstr "Finché non decidiamo se{line_break}scendere a terra o no, non{line_break}smetteranno più di piangere.{page_break}Non vorrei chiedertelo, ma{line_break}potresti esplorare l'isola{line_break}ancora una volta?{end_wait}"

msgctxt "message"
msgid "08013"
msgstr "Beh...{pause_20_skippable} Hai{line_break}visto qualche mostro?{end_now}"

msgctxt "message"
msgid "08014"
msgstr "...Capisco.{pause_20_skippable} Allora{line_break}è meglio non fare scendere{line_break}i turisti?{end_wait}"

msgctxt "message"
msgid "08015"
msgstr "Se non ci sono mostri,{line_break}{pause_20_skippable} penso che si possa{line_break}fare scendere i turisti!{end_wait}"

msgctxt "message"
msgid "08016"
msgstr "I passeggeri sono fuori{line_break}di testa, è impossibile{line_break}contenerli!{page_break}Bisogna lasciarli{line_break}scendere a{line_break}terra!{end_wait}"

msgctxt "message"
msgid "08017"
msgstr "Non ce n'è bisogno.{end_wait}"

msgctxt "message"
msgid "08018"
msgstr "Abbiamo studiato{line_break}la rotta per Tolbi.{end_wait}"

msgctxt "message"
msgid "08019"
msgstr "Davvero? Possiamo andare?{end_wait}"

msgctxt "message"
msgid "08020"
msgstr "Partiamo per Tolbi prima che{line_break}il mare diventi mosso.{page_break}I turisti potranno{line_break}sbarcare quando saremo{line_break}a destinazione.{end_wait}"

msgctxt "message"
msgid "08021"
msgstr "È troppo tardi...{line_break}Non c'è modo di{line_break}persuaderli.{end_wait}"

msgctxt "message"
msgid "08022"
msgstr "Se ci sbrighiamo arriveremo{line_break}in tempo per il Colossum.{end_wait}"

msgctxt "message"
msgid "08023"
msgstr "Bene!{pause_20_skippable} Se li portiamo{line_break}al Colossum saranno{line_break}finalmente contenti.{end_wait}"

msgctxt "message"
msgid "08024"
msgstr "Bene, allora... Andate{line_break}a informare i turisti.{end_wait}"

msgctxt "message"
msgid "08025"
msgstr "Non siamo lontani.{line_break}Chiederò ai rematori di{line_break}fare un ultimo sforzo.{end_wait}"

msgctxt "message"
msgid "08026"
msgstr "I due rematori a destra{line_break}devono scambiarsi di posto{line_break}con quelli di sinistra.{page_break}Siamo andati fuori rotta{line_break}perché i rematori a sinistra{line_break}erano fuori tempo.{end_wait}"

msgctxt "message"
msgid "08027"
msgstr "Un ultimo sforzo, ragazzi!{line_break}Siamo quasi arrivati.{line_break}Mettetecela tutta!{end_wait}"

msgctxt "message"
msgid "08028"
msgstr "Bene!{pause_20_skippable} Salpiamo{line_break}per Tolbi, e speriamo{line_break}che sia la volta buona!{end_wait}"

msgctxt "message"
msgid "08029"
msgstr "Diffondo la buona volontà{line_break}ovunque, mentre viaggio.{end_wait}"

msgctxt "message"
msgid "08030"
msgstr "È vero che sono contro la{line_break}violenza, ma non posso{line_break}perdermi il Colossum.{end_wait}"

msgctxt "message"
msgid "08031"
msgstr "I miei uomini devono{line_break}essere pronti a tutto,{line_break}e io sono con loro.{page_break}Chiedi a qualcun{line_break}altro di remare.{end_wait}"

msgctxt "message"
msgid "08032"
msgstr "Non posso remare, ma{line_break}spero che la nave{line_break}non abbia problemi.{end_wait}"

msgctxt "message"
msgid "08033"
msgstr "I miei uomini devono{line_break}essere pronti a tutto,{line_break}e io sono con loro.{page_break}Chiedi a qualcun{line_break}altro di remare.{end_wait}"

msgctxt "message"
msgid "08034"
msgstr "Tutte queste traversie...{line_break}Faranno parte di un{line_break}piano del fato?{end_wait}"

msgctxt "message"
msgid "08035"
msgstr "È un bene che la nave sia{line_break}arrivata sana e salva.{end_wait}"

msgctxt "message"
msgid "08036"
msgstr "Siamo arrivati in tempo{line_break}per il Colossum!{end_wait}"

msgctxt "message"
msgid "08037"
msgstr "È pericoloso viaggiare di{line_break}questi tempi... Ci sono{line_break}troppi mostri!{page_break}Non ripartirà{line_break}per un bel po'.{end_wait}"

msgctxt "message"
msgid "08038"
msgstr "Che noia...{pause_20_skippable}{line_break}Quando riprenderemo{line_break}il largo?{end_wait}"

msgctxt "message"
msgid "08039"
msgstr "La nave non è tornata, quindi{line_break}non potremmo salpare{line_break}neppure se volessimo.{end_wait}"

msgctxt "message"
msgid "08040"
msgstr "Oh oh! Senza la nave, non{line_break}si possono fare affari...{end_wait}"

msgctxt "message"
msgid "08041"
msgstr "Io sono fortunato perché{line_break}lavoro a terra... Ma sono{line_break}in ansia per gli altri.{end_wait}"

msgctxt "message"
msgid "08042"
msgstr "Non vorrei che fossero stati{line_break}tutti presi dai mostri.{end_wait}"

msgctxt "message"
msgid "08043"
msgstr "Incredibile! Allora è{line_break}questo l'oceano{line_break}di cui parlava Kraden!{end_wait}"

msgctxt "message"
msgid "08044"
msgstr "Il Karagol è un mare chiuso,{line_break}quindi tecnicamente{line_break}non è un oceano.{page_break}Un vero oceano è{line_break}totalmente aperto.{end_wait}"

msgctxt "message"
msgid "08045"
msgstr "Sì, ma è del tutto{line_break}simile alla descrizione{line_break}di Kraden!{end_wait}"

msgctxt "message"
msgid "08046"
msgstr "Un giorno o l'altro{line_break}voglio vedere un vero{line_break}oceano, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "08047"
msgstr "Durante il Colossum, Tolbi{line_break}è in fermento.{page_break}Il festival c'è solo{line_break}una volta all'anno,{line_break}quindi è un grande evento!{end_wait}"

msgctxt "message"
msgid "08048"
msgstr "Il Colossum si svolge{line_break}nell'arena, nel{line_break}cuore di Tolbi.{page_break}Se non andiamo subito{line_break}troveremo i posti peggiori!{line_break}E non ci divertiremo!{end_wait}"

msgctxt "message"
msgid "08049"
msgstr "Oggi nell'arena sono iniziate{line_break}le gare preliminari.{page_break}Penso di andare a{line_break}vedere le finali!{end_wait}"

msgctxt "message"
msgid "08050"
msgstr "Il Colossum avrebbe dovuto{line_break}iniziare oggi. Ma{line_break}cosa sta succedendo?{page_break}Ho visto girare le{line_break}guardie del corpo di Babi.{page_break}Sarà successo qualcosa{line_break}al nostro capo?{end_wait}"

msgctxt "message"
msgid "08051"
msgstr "Babi era già vecchio{line_break}prima che{line_break}nascessi.{page_break}Ora ho 65 anni, quindi{line_break}immagino come possa{line_break}essere vecchio!{end_wait}"

msgctxt "message"
msgid "08052"
msgstr "Sarà possibile vivere{line_break}per più di cent'anni?{end_now}"

msgctxt "message"
msgid "08053"
msgstr "Sì, ma Babi è{line_break}senz'altro{line_break}molto più vecchio...{end_wait}"

msgctxt "message"
msgid "08054"
msgstr "Forse hai ragione, ma{line_break}cosa mi dici di{line_break}Babi, il capo di Tolbi?{page_break}Deve averne{line_break}almeno 150!{end_wait}"

msgctxt "message"
msgid "08055"
msgstr "Ehi, c'è un festival! Il{line_break}Festival del Colossum! Cosa{page_break}comprerò con i soldi che{line_break}mi ha dato la mia mamma?{line_break}Non lo so ancora!{end_wait}"

msgctxt "message"
msgid "08056"
msgstr "Ehi! Ha detto che quei soldi{line_break}erano per tutti e due!{end_wait}"

msgctxt "message"
msgid "08057"
msgstr "Prendete un ricordo del{line_break}Colossum! Hanno dei{line_break}ricordini strepitosi!{end_wait}"

msgctxt "message"
msgid "08058"
msgstr "Comprate da bere e da{line_break}mangiare prima di entrare{line_break}nell'arena!{end_wait}"

msgctxt "message"
msgid "08059"
msgstr "Alla fine ho deciso di{line_break}non lottare al Colossum.{page_break}Avete visto i partecipanti?{line_break}Sono{line_break}ENORMI!{end_wait}"

msgctxt "message"
msgid "08060"
msgstr "Il festival di Tolbi è{line_break}enorme! Che{line_break}emozione!{end_wait}"

msgctxt "message"
msgid "08061"
msgstr "Oh no! Abbiamo dormito{line_break}troppo e ora il Colossum{line_break}è già pieno!{page_break}Così ci facciamo un{line_break}giro per Tolbi, non{line_break}abbiamo scelta...{end_wait}"

msgctxt "message"
msgid "08062"
msgstr "Ehi, quel gioco con i dadi{line_break}sembra proprio divertente.{page_break}Se ti diverti a giocare e{line_break}puoi anche vincere un premio,{line_break}è il massimo, no?{end_wait}"

msgctxt "message"
msgid "08063"
msgstr "Ai giovani piacciono i{line_break}ricordini, vero?{end_now}"

msgctxt "message"
msgid "08064"
msgstr "Lo so che ti piacciono,{line_break}non provare a nasconderlo!{line_break}Piacevano anche a me!{page_break}Ma mia moglie non{line_break}mi compra mai{line_break}niente...{end_wait}"

msgctxt "message"
msgid "08065"
msgstr "Dici così soltanto perché{line_break}i tuoi genitori non te li{line_break}hanno mai regalati!{end_wait}"

msgctxt "message"
msgid "08066"
msgstr "Un po' di pazienza!{end_wait}"

msgctxt "message"
msgid "08067"
msgstr "Ti comprerò dolci{line_break}migliori{line_break}più tardi.{end_wait}"

msgctxt "message"
msgid "08068"
msgstr "{text_effect:4}Dai!{reset_text_style} Comprami{line_break}dei dolci! Dai! Dai!{line_break}Dei dolci!{end_wait}"

msgctxt "message"
msgid "08069"
msgstr "Sto qui perché le locande{line_break}sono tutte piene.{page_break}L'arco mi protegge dalla{line_break}pioggia, quindi ci si sta{line_break}meglio che in una locanda...{end_wait}"

msgctxt "message"
msgid "08070"
msgstr "Non sono solo i{line_break}turisti ad amare{line_break}il Colossum! È il massimo!{end_wait}"

msgctxt "message"
msgid "08071"
msgstr "Oggi al Colossum iniziano{line_break}le gare preliminari.{page_break}Chi le supera può{line_break}andare in finale.{end_wait}"

msgctxt "message"
msgid "08072"
msgstr "La fase preliminare è{line_break}divertente, ma la parte{line_break}migliore sono le finali.{end_wait}"

msgctxt "message"
msgid "08073"
msgstr "Ultimamente non ci{line_break}sono stati{line_break}problemi...{page_break}Chissà perché i soldati{line_break}di Babi si sono messi{line_break}in movimento.{end_wait}"

msgctxt "message"
msgid "08074"
msgstr "Io invecchio ogni anno{line_break}di più, mentre Babi resta{line_break}sempre uguale.{end_wait}"

msgctxt "message"
msgid "08075"
msgstr "Non sarà che Babi è stato{line_break}sostituito da{line_break}qualcun altro e {page_break}nessuno{line_break}lo sa?{end_wait}"

msgctxt "message"
msgid "08076"
msgstr "Sono io il fratello{line_break}maggiore: perché dovrei{line_break}spartire i soldi?{end_wait}"

msgctxt "message"
msgid "08077"
msgstr "La mamma ha detto che i soldi{line_break}erano da spartire: mio fratello{line_break}ha la memoria corta...{end_wait}"

msgctxt "message"
msgid "08078"
msgstr "Dobbiamo vendere tutti i{line_break}ricordini prima che{line_break}finisca il Colossum.{end_wait}"

msgctxt "message"
msgid "08079"
msgstr "Li vendono anche nell'arena,{line_break}ma là sono molto{line_break}più cari!{end_wait}"

msgctxt "message"
msgid "08080"
msgstr "Ho visto quelli che si{line_break}preparano a lottare:{line_break}mettono proprio paura!{end_wait}"

msgctxt "message"
msgid "08081"
msgstr "Tolbi non è come Xian.{line_break}Qui c'è molta più vita!{end_wait}"

msgctxt "message"
msgid "08082"
msgstr "Non lo dico perché me{line_break}ne vergogno, ma non ho messo{page_break}la sveglia di proposito:{line_break}l'idea di andare al Colossum{line_break}mi terrorizzava!{end_wait}"

msgctxt "message"
msgid "08083"
msgstr "Giocare al Dado fortunato,{line_break}ma se non faccio attenzione{line_break}spenderò tutti i soldi!{end_wait}"

msgctxt "message"
msgid "08084"
msgstr "Il cibo che vendono lungo{line_break}la strada sembra{line_break}davvero delizioso! Se i{page_break}miei figli comprano qualcosa{line_break}l'assaggio anch'io.{end_wait}"

msgctxt "message"
msgid "08085"
msgstr "Chissà perché i bambini sono{line_break}attratti da quella robaccia...{page_break}Io ai miei non gliela{line_break}comprerò mai!{end_wait}"

msgctxt "message"
msgid "08086"
msgstr "Quei dolci sono super!{line_break}Starò qui finché{line_break}non me li compri.{end_wait}"

msgctxt "message"
msgid "08087"
msgstr "Ho tenuto i posti, ma{line_break}non so se ne valga{line_break}la pena.{page_break}Chissà dove si sono{line_break}cacciati i miei amici...{end_wait}"

msgctxt "message"
msgid "08088"
msgstr "Ehi, hai visto qualcuno{line_break}che ha questa faccia?{end_now}"

msgctxt "message"
msgid "08089"
msgstr "Babi dev'essere qui in giro!{end_wait}"

msgctxt "message"
msgid "08090"
msgstr "Ma Babi dov'è!? Non lo{line_break}vedo da nessuna parte.{line_break}Guardiamo un po' in giro.{end_wait}"

msgctxt "message"
msgid "08091"
msgstr "Chi l'ha visto?"

msgctxt "message"
msgid "08092"
msgstr "Tolbi è piena di gente{line_break}durante il Colossum, e le{line_break}locande sono al completo.{page_break}Io ho piazzato due{line_break}letti e...{line_break}...ho messo su una locanda!{end_wait}"

msgctxt "message"
msgid "08093"
msgstr "Volete fermarvi{line_break}qui da noi?{end_now}"

msgctxt "message"
msgid "08094"
msgstr "Purtroppo siamo già{line_break}al completo... Non ho{line_break}posto per voi.{end_wait}"

msgctxt "message"
msgid "08095"
msgstr "Meglio così, perché{line_break}siamo al completo.{end_wait}"

msgctxt "message"
msgid "08096"
msgstr "La notte scorsa non{line_break}ho chiuso occhio: il tipo{line_break}vicino a me russava!{page_break}Che stanchezza... E ora{line_break}come affronto il Colossum?{end_wait}"

msgctxt "message"
msgid "08097"
msgstr "Con tutta quella gente{line_break}nell'arena c'è da{line_break}impazzire!{end_wait}"

msgctxt "message"
msgid "08098"
msgstr "Durante il Colossum si{line_break}fanno soldi a palate:{line_break}che soddisfazione!{end_wait}"

msgctxt "message"
msgid "08099"
msgstr "È troppo tardi: non troveranno{line_break}mai un posto dove pernottare.{line_break}I combattenti del Colossum{page_break}dormono tutti nel{line_break}palazzo di Babi.{end_wait}"

msgctxt "message"
msgid "08100"
msgstr "Se avessi dormito la notte{line_break}scorsa, ora al Colossum{line_break}mi divertirei.{end_wait}"

msgctxt "message"
msgid "08101"
msgstr "Odio la{line_break}folla.{page_break}Ma come mai il capo di Tolbi,{line_break}Babi, o come diavolo si{line_break}chiama, non è qui?{end_wait}"

msgctxt "message"
msgid "08102"
msgstr "Ehi, fuori di qui! Sai quanto{line_break}ci è costato affittare questa{line_break}casa per il Colossum?!{end_wait}"

msgctxt "message"
msgid "08103"
msgstr "Potremo rimanere qui finché{line_break}non torneranno i proprietari.{end_wait}"

msgctxt "message"
msgid "08104"
msgstr "Anch'io vorrei andare{line_break}a vedere il Colossum!{page_break}Ma l'arena è così piena...{line_break}Penso che andrò a vedere{line_break}soltanto le finali.{end_wait}"

msgctxt "message"
msgid "08105"
msgstr "Voglio andare al Colossum,{line_break}ma non trovo nessuno che{line_break}mi ci porti!{end_wait}"

msgctxt "message"
msgid "08106"
msgstr "Ho sbagliato... Avevo detto:{line_break}\"Non vedrò neanche una{line_break}gara preliminare!\"{page_break}Ma ora me ne pento...{end_wait}"

msgctxt "message"
msgid "08107"
msgstr "Papà non mi porterà mai{line_break}al Colossum, nemmeno se{line_break}piango per tre ore!{end_wait}"

msgctxt "message"
msgid "08108"
msgstr "Dicono che Babi{line_break}sia introvabile...{page_break}Se è vero, cosa{line_break}accadrà al{line_break}Colossum?{end_wait}"

msgctxt "message"
msgid "08109"
msgstr "Nessuno spettatore{line_break}ha visto Babi{line_break}al Colossum...{end_wait}"

msgctxt "message"
msgid "08110"
msgstr "È strano che i soldati{line_break}di Babi siano in giro{line_break}per la città.{page_break}Le sue guardie del corpo{line_break}probabilmente lo{line_break}stavano cercando...{end_wait}"

msgctxt "message"
msgid "08111"
msgstr "Che strano... Babi va sempre{line_break}al Colossum, ma nessuno{line_break}l'ha visto nell'arena...{page_break}Forse quel ragazzo aveva{line_break}ragione... Babi{line_break}non si trova...{end_wait}"

msgctxt "message"
msgid "08112"
msgstr "Con il Colossum si{line_break}fanno buoni affari.{page_break}Ma chi fa più soldi{line_break}è Babi, chiaramente.{end_wait}"

msgctxt "message"
msgid "08113"
msgstr "Ho sentito dire che Babi{line_break}sta facendo costruire{line_break}un faro a Gondowan.{page_break}Lo chiamano tutti il{line_break}Faro di Babi.{end_wait}"

msgctxt "message"
msgid "08114"
msgstr "Si prende una parte di{line_break}tutti i nostri guadagni...{line_break}È così che fa i soldi!{end_wait}"

msgctxt "message"
msgid "08115"
msgstr "Battezzare con il proprio{line_break}nome quella lanterna è stato{line_break}un peccato di vanità...{end_wait}"

msgctxt "message"
msgid "08116"
msgstr "Sembri forte...{line_break}Combatti nel Colossum!{end_wait}"

msgctxt "message"
msgid "08117"
msgstr "Ora che ci penso... Le gare{line_break}preliminari sono già{line_break}iniziate!{page_break}Quindi, anche volendo,{line_break}forse non posso partecipare{line_break}al Colossum...{end_wait}"

msgctxt "message"
msgid "08118"
msgstr "Comunque non sarei{line_break}mai arrivato alle{line_break}finali...{end_wait}"

msgctxt "message"
msgid "08119"
msgstr "È la prima volta{line_break}che venite a Tolbi?{end_now}"

msgctxt "message"
msgid "08120"
msgstr "Tolbi offre molte possibilità{line_break}ai forti guerrieri.{page_break}Soprattutto, possono{line_break}partecipare al Colossum.{end_wait}"

msgctxt "message"
msgid "08121"
msgstr "Anche se ci vieni mille{line_break}volte, il Colossum è{line_break}sempre divertente!{page_break}Fateci un salto: vi{line_break}divertirete.{end_wait}"

msgctxt "message"
msgid "08122"
msgstr "A Tolbi vendono molte{line_break}cose interessanti.{line_break}Date un'occhiata!{end_wait}"

msgctxt "message"
msgid "08123"
msgstr "Chi si fa valere al{line_break}Colossum potrebbe{line_break}diventare una{page_break}delle guardie{line_break}di Babi.{end_wait}"

msgctxt "message"
msgid "08124"
msgstr "Babi sceglie le sue guardie{line_break}tra i vincitori del Colossum,{line_break}per la loro abilità.{end_wait}"

msgctxt "message"
msgid "08125"
msgstr "Durante il Colossum è{line_break}sempre tutto prenotato{line_break}da parecchio tempo.{page_break}Non sarà facile per voi{line_break}trovare una camera{line_break}in città.{end_wait}"

msgctxt "message"
msgid "08126"
msgstr "Nel periodo del Colossum è{line_break}sempre tutto esaurito.{page_break}Se tornate l'anno{line_break}prossimo vi conviene{line_break}prenotare ora.{end_wait}"

msgctxt "message"
msgid "08127"
msgstr "È tremendo... Siamo così{line_break}pieni di lavoro che non{line_break}possiamo vedere il Colossum.{end_wait}"

msgctxt "message"
msgid "08128"
msgstr "Quest'anno è venuto un{line_break}gruppo in gita da Kalay.{page_break}Sono in tanti, ma hanno{line_break}prenotato soltanto{line_break}due camere...{end_wait}"

msgctxt "message"
msgid "08129"
msgstr "Quest'anno non andremo{line_break}a vedere il{line_break}Colossum.{page_break}Iniziamo a preparare la{line_break}cena per i nostri ospiti{line_break}già dalla mattina.{end_wait}"

msgctxt "message"
msgid "08130"
msgstr "Il Colossum non mi{line_break}interessa... È{line_break}troppo violento.{end_wait}"

msgctxt "message"
msgid "08131"
msgstr "Oh, no! Siamo arrivati a{line_break}Tolbi per miracolo e non{line_break}possiamo vedere il Colossum.{page_break}Ma cosa ci siamo{line_break}venuti a fare!?{end_wait}"

msgctxt "message"
msgid "08132"
msgstr "Se solo fossimo arrivati{line_break}un po' prima ci avrebbero{line_break}fatti entrare.{end_wait}"

msgctxt "message"
msgid "08133"
msgstr "Quelli della gita stanno un{line_break}po' stretti in quelle camere.{page_break}Per l'anno prossimo{line_break}dovremmo costruire una{line_break}locanda più grande.{end_wait}"

msgctxt "message"
msgid "08134"
msgstr "Non si può avere{line_break}tutti questi{line_break}ospiti!{end_wait}"

msgctxt "message"
msgid "08135"
msgstr "Cascasse il mondo,{line_break}voglio andare a vedere{line_break}le finali del Colossum!{end_wait}"

msgctxt "message"
msgid "08136"
msgstr "Non c'è abbastanza{line_break}posto per il{line_break}gruppo in gita da Kalay.{page_break}Dove dormiranno?{end_wait}"

msgctxt "message"
msgid "08137"
msgstr "Il locandiere m'ha detto{line_break}di preparare un pranzo da{line_break}re, ma come faccio?{page_break}Già riuscire a{line_break}sfamare tutti{line_break}è un'impresa.{end_wait}"

msgctxt "message"
msgid "08138"
msgstr "Sto già male al solo{line_break}pensiero di tutti{line_break}quegli ospiti.{end_wait}"

msgctxt "message"
msgid "08139"
msgstr "Anche se non posso partecipare{line_break}al Colossum penso comunque{line_break}di andare a vederlo.{page_break}Dopo aver fatto tutta{line_break}questa strada voglio almeno{line_break}godermi lo spettacolo.{end_wait}"

msgctxt "message"
msgid "08140"
msgstr "Se avessimo partecipato al{line_break}Colossum la vittoria sarebbe{line_break}stata assicurata!{end_wait}"

msgctxt "message"
msgid "08141"
msgstr "Che disdetta essere costretti{line_break}a rimanere qui e non poter{line_break}vedere il festival!{end_wait}"

msgctxt "message"
msgid "08142"
msgstr "Chissà come stanno andando{line_break}le gare preliminari... Non{line_break}riesco a pensare ad altro.{end_wait}"

msgctxt "message"
msgid "08143"
msgstr "Di solito nessuno può{line_break}entrare nel palazzo di{line_break}Babi, tranne{page_break}durante il{line_break}Colossum.{end_wait}"

msgctxt "message"
msgid "08144"
msgstr "Alcune delle camere nel{line_break}palazzo sono disponibili per{line_break}i concorrenti del Colossum.{page_break}Lord Babi tratta{line_break}gli ospiti con{line_break}grande riguardo.{end_wait}"

msgctxt "message"
msgid "08145"
msgstr "È giusto che il palazzo{line_break}sia aperto al pubblico{line_break}in queste occasioni?{end_wait}"

msgctxt "message"
msgid "08146"
msgstr "Chissà quante persone{line_break}resteranno al palazzo di{line_break}Babi dopo il Colossum...{end_wait}"

msgctxt "message"
msgid "08147"
msgstr "Avete visto dei soldati{line_break}di Babi in città?{end_now}"

msgctxt "message"
msgid "08148"
msgstr "Quindi non l'hanno{line_break}ancora trovato...{end_wait}"

msgctxt "message"
msgid "08149"
msgstr "Ma come? Ho ordinato{line_break}di cercare in ogni angolo{line_break}della città...{end_wait}"

msgctxt "message"
msgid "08150"
msgstr "Se volete partecipare al{line_break}Colossum, affrettatevi ad{line_break}andare all'arena.{page_break}Ma anche se andate ora,{line_break}forse è troppo tardi per{line_break}le gare preliminari...{end_wait}"

msgctxt "message"
msgid "08151"
msgstr "Chissà se i soldati di{line_break}Babi lo stanno cercando{line_break}con impegno...{end_wait}"

msgctxt "message"
msgid "08152"
msgstr "I guerrieri che non gareggiano{line_break}nel Colossum non possono{line_break}rimanere nel palazzo!{end_wait}"

msgctxt "message"
msgid "08153"
msgstr "Abbiamo abbastanza{line_break}letti per tutti in{line_break}questa stanza.{page_break}Seguitemi.{end_wait}"

msgctxt "message"
msgid "08154"
msgstr "Potete usare questi{line_break}quattro letti.{page_break}Andate subito a{line_break}dormire?{end_now}"

msgctxt "message"
msgid "08155"
msgstr "Buonanotte.{end_wait}"

msgctxt "message"
msgid "08156"
msgstr "Behm, quando vi verrà{line_break}sonno, potrete{line_break}dormire qui.{end_wait}"

msgctxt "message"
msgid "08157"
msgstr "Volete andare a{line_break}dormire ora?{end_now}"

msgctxt "message"
msgid "08158"
msgstr "Oooh, che sonno...{end_wait}"

msgctxt "message"
msgid "08159"
msgstr "Non pensavo che avremmo{line_break}trovato un posto per{line_break}dormire! Meno male!{end_wait}"

msgctxt "message"
msgid "08160"
msgstr "Riposiamoci{line_break}per domani.{end_wait}"

msgctxt "message"
msgid "08161"
msgstr "Buonanotte.{end_wait}"

msgctxt "message"
msgid "08162"
msgstr "Notte.{end_wait}"

msgctxt "message"
msgid "08163"
msgstr "Sogni d'oro.{end_wait}"

msgctxt "message"
msgid "08164"
msgstr "Buongiorno.{end_wait}"

msgctxt "message"
msgid "08165"
msgstr "Buongiorno.{end_wait}"

msgctxt "message"
msgid "08166"
msgstr "Buongiorno.{end_wait}"

msgctxt "message"
msgid "08167"
msgstr "Bene, {actor_name:1}! Ci{line_break}aspetta una{line_break}giornata impegnativa!{end_wait}"

msgctxt "message"
msgid "08168"
msgstr "Volete partecipare{line_break}al Colossum?{end_now}"

msgctxt "message"
msgid "08169"
msgstr "Beh, allora dovete{line_break}muovervi!{page_break}Sono già iniziate le{line_break}gare preliminari: andate{line_break}subito all'arena!{end_wait}"

msgctxt "message"
msgid "08170"
msgstr "Vi siete infortunati{line_break}anche voi?{page_break}Infortunarsi prima delle{line_break}gare preliminari è il{line_break}massimo della sfortuna.{end_wait}"

msgctxt "message"
msgid "08171"
msgstr "Non posso lottare solo{line_break}per una stupida indigestione?{line_break}Ma è ridicolo!{end_wait}"

msgctxt "message"
msgid "08172"
msgstr "Non devo dare peso a{line_break}questo mal di pancia...{line_break}Devo partecipare al Colossum!{end_wait}"

msgctxt "message"
msgid "08173"
msgstr "Non ce la faccio! Mi{line_break}fa male lo stomaco!{end_wait}"

msgctxt "message"
msgid "08174"
msgstr "Anch'io voglio guardare le{line_break}gare del Colossum.{page_break}Ma il mio lavoro è{line_break}incitare i guerrieri{line_break}perché diano il massimo.{end_wait}"

msgctxt "message"
msgid "08175"
msgstr "Mi fa una rabbia vedere{line_break}tutti quei guerrieri{line_break}lottare nel Colossum...{page_break}Ho avuto uno strappo alla{line_break}schiena in allenamento, e{line_break}ora non posso muovermi.{end_wait}"

msgctxt "message"
msgid "08176"
msgstr "Forse ieri avrei{line_break}dovuto mangiare{line_break}un po' meno...{end_wait}"

msgctxt "message"
msgid "08177"
msgstr "Solo i guerrieri che si fanno{line_break}valere nelle finali possono{line_break}diventare soldati qui.{page_break}Quasi tutti partecipano al{line_break}Colossum nella speranza di{line_break}essere poi presi qui.{end_wait}"

msgctxt "message"
msgid "08178"
msgstr "Lord Babi sta facendo{line_break}costruire un faro come{line_break}simbolo del suo potere.{end_wait}"

msgctxt "message"
msgid "08179"
msgstr "Babi ha dato il suo{line_break}nome a quel{line_break}faro. È un'impresa{page_break}enorme, per questo il{line_break}faro è vigilato{line_break}giorno e notte.{end_wait}"

msgctxt "message"
msgid "08180"
msgstr "Anche se Lord Babi non{line_break}ritorna, la costruzione{line_break}del suo faro andrà{page_break}avanti... Non mi darò pace{line_break}finché non avrò saputo{line_break}dov'è Babi.{end_wait}"

msgctxt "message"
msgid "08181"
msgstr "La mia prima volta al{line_break}Colossum è stata bellissima.{page_break}Quest'anno le gare saranno{line_break}particolarmente entusiasmanti.{end_wait}"

msgctxt "message"
msgid "08182"
msgstr "Quando il faro sarà terminato{line_break}il nome di Babi sarà{line_break}consegnato all'eternità.{end_wait}"

msgctxt "message"
msgid "08183"
msgstr "Senza questi lasciapassare{line_break}che ci ha dato Iodem non{line_break}potremmo avvicinarci al faro.{end_wait}"

msgctxt "message"
msgid "08184"
msgstr "Ho sentito che quella ragazza{line_break}andrà alla prossima campagna.{line_break}Cosa vuol dire?{end_wait}"

msgctxt "message"
msgid "08185"
msgstr "Un tempo, su questo lato{line_break}del Faro di Babi c'erano{line_break}delle antiche rovine.{page_break}Pare che sotto quelle{line_break}rovine ci fosse un{line_break}tunnel lunghissimo.{end_wait}"

msgctxt "message"
msgid "08186"
msgstr "Per quanto possa ripetere{line_break}l'esperimento, non{line_break}otterrò mai i risultati{page_break}che voglio! Le mie abilità{line_break}con l'Alchimia sono diminuite,{line_break}come aveva detto Kraden.{end_wait}"

msgctxt "message"
msgid "08187"
msgstr "Si dice che un tempo il{line_break}potere dell'Alchimia{line_break}fosse sigillato.{page_break}Ma perché era stato{line_break}sigillato?{end_wait}"

msgctxt "message"
msgid "08188"
msgstr "Sotto il Faro di Babi, un{line_break}tempo c'erano le{line_break}Rovine di Venere.{end_wait}"

msgctxt "message"
msgid "08189"
msgstr "Babi fa compiere ricerche{line_break}di tutti i tipi{line_break}ai suoi studiosi.{page_break}Chissà dov'è lo studioso{line_break}prediletto di Babi,{line_break}Kraden...{end_wait}"

msgctxt "message"
msgid "08190"
msgstr "Nessuno ha mai raggiunto{line_break}la fine del tunnel{line_break}delle antiche rovine...{page_break}Mi piacerebbe molto{line_break}sapere cosa c'è alla{line_break}fine del tunnel.{end_wait}"

msgctxt "message"
msgid "08191"
msgstr "I miei esperimenti di{line_break}Alchimia stanno procedendo{line_break}meglio che mai.{page_break}Forse le ricerche di Kraden{line_break}stanno dando i loro frutti...{end_wait}"

msgctxt "message"
msgid "08192"
msgstr "Il viaggio di Kraden avrebbe{line_break}dovuto riscoprire l'arte{line_break}dell'Alchimia.{page_break}Forse potrà anche scoprire{line_break}perché era stata{line_break}sigillata.{end_wait}"

msgctxt "message"
msgid "08193"
msgstr "Le Rovine di Venere sono{line_break}ciò che resta di una{line_break}straordinaria civiltà.{page_break}Stanno costruendo il{line_break}faro sulle Rovine di{line_break}Venere.{end_wait}"

msgctxt "message"
msgid "08194"
msgstr "Lord Babi si attendeva{line_break}grandi risultati{line_break}dal viaggio di Kraden.{page_break}Chissà cosa si{line_break}aspettava precisamente{line_break}da quelle ricerche...{end_wait}"

msgctxt "message"
msgid "08195"
msgstr "Iodem, Iodem!{end_wait}"

msgctxt "message"
msgid "08196"
msgstr "Siamo andati alla Grotta di{line_break}Altmiller, come hai comandato.{end_wait}"

msgctxt "message"
msgid "08197"
msgstr "Allora?{line_break}Avete trovato{line_break}tracce di Babi?{end_wait}"

msgctxt "message"
msgid "08198"
msgstr "{pause_20_skippable}È stato inutile...{end_wait}"

msgctxt "message"
msgid "08199"
msgstr "Iodem, perché ci hai{line_break}mandato a cercare Babi{line_break}in un posto simile?{end_wait}"

msgctxt "message"
msgid "08200"
msgstr "Perché Lord Babi dovrebbe{line_break}entrare da solo in un{line_break}posto così pericoloso? È...{end_wait}"

msgctxt "message"
msgid "08201"
msgstr "Inconcepibile?{line_break}È questo ciò che{line_break}stavi per dire?{end_wait}"

msgctxt "message"
msgid "08202"
msgstr "La Grotta di Altmiller{line_break}è un luogo pericoloso.{end_wait}"

msgctxt "message"
msgid "08203"
msgstr "Se Babi è andato là da{line_break}solo, un mostro potrebbe...{end_wait}"

msgctxt "message"
msgid "08204"
msgstr "Sapevo che la Grotta di{line_break}Altmiller è{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable} singolare.{end_wait}"

msgctxt "message"
msgid "08205"
msgstr "Lo sapevi? Ma allora{line_break}perché ci hai{line_break}mandato là?{end_wait}"

msgctxt "message"
msgid "08206"
msgstr "Non è la prima volta{line_break}che Lord Babi fugge...{end_wait}"

msgctxt "message"
msgid "08207"
msgstr "Vuoi dire che Lord{line_break}Babi è già scomparso altre{line_break}volte in passato, Iodem?{end_wait}"

msgctxt "message"
msgid "08208"
msgstr "E dove si era{line_break}nascosto?{end_wait}"

msgctxt "message"
msgid "08209"
msgstr "Un volta ho seguito{line_break}Lord Babi...{end_wait}"

msgctxt "message"
msgid "08210"
msgstr "Ero certo che sarebbe{line_break}andato alla Grotta{line_break}di Altmiller...{end_wait}"

msgctxt "message"
msgid "08211"
msgstr "Hai già esplorato{line_break}quella grotta, Iodem?{end_wait}"

msgctxt "message"
msgid "08212"
msgstr "Cosa faceva in{line_break}quella grotta?{end_wait}"

msgctxt "message"
msgid "08213"
msgstr "Appena entrato, Lord{line_break}Babi scomparve sotto{pause_20_skippable}{line_break}ai miei occhi.{end_wait}"

msgctxt "message"
msgid "08214"
msgstr "Scomparso?{end_wait}"

msgctxt "message"
msgid "08215"
msgstr "Vuoi dire che hai perso{line_break}di vista Lord Babi?{end_wait}"

msgctxt "message"
msgid "08216"
msgstr "Entrai nella grotta{line_break}e lo seguii, ma{line_break}Lord Babi...{page_break}...era scomparso,{line_break}senza lasciare traccia.{end_wait}"

msgctxt "message"
msgid "08217"
msgstr "Provai a seguirlo molte{line_break}altre volte.{page_break}Ogni volta, pochi secondi{line_break}dopo essere entrato nella{line_break}grotta, scompariva.{end_wait}"

msgctxt "message"
msgid "08218"
msgstr "E pensi che Lord Babi{line_break}sia tornato lì anche{line_break}stamattina, Iodem?{end_wait}"

msgctxt "message"
msgid "08219"
msgstr "Ma se in passato è sempre{line_break}ritornato dalla Grotta{line_break}di Altmiller...{end_wait}"

msgctxt "message"
msgid "08220"
msgstr "Tornerà anche{line_break}questa volta, no?{end_wait}"

msgctxt "message"
msgid "08221"
msgstr "No. Questa volta è{line_break}diverso... Qualcosa{line_break}non quadra...{end_wait}"

msgctxt "message"
msgid "08222"
msgstr "Cosa intendi dire?{end_wait}"

msgctxt "message"
msgid "08223"
msgstr "Intanto, è strano che Lord{line_break}Babi si sia allontanato{line_break}subito prima del Colossum.{page_break}Ma non è solo{line_break}questo...{end_wait}"

msgctxt "message"
msgid "08224"
msgstr "Che altro c'è?{end_wait}"

msgctxt "message"
msgid "08225"
msgstr "Stamattina, il{line_break}letto di Babi non{line_break}era disfatto.{end_wait}"

msgctxt "message"
msgid "08226"
msgstr "E questo cosa{line_break}significa?{end_wait}"

msgctxt "message"
msgid "08227"
msgstr "La notte scorsa Lord Babi{line_break}non ha dormito nel suo letto.{line_break}E questo è strano...{end_wait}"

msgctxt "message"
msgid "08228"
msgstr "Lord Babi è introvabile{line_break}dalla notte{line_break}scorsa.{end_wait}"

msgctxt "message"
msgid "08229"
msgstr "Questo è un particolare{line_break}inquietante: non l'aveva mai{line_break}fatto prima d'ora.{end_wait}"

msgctxt "message"
msgid "08230"
msgstr "Non sapevamo che mancasse{line_break}da così tanto tempo...{end_wait}"

msgctxt "message"
msgid "08231"
msgstr "Non penserai mica che Lord{line_break}Babi sia stato ucc...{end_wait}"

msgctxt "message"
msgid "08232"
msgstr "Ehi, non scherziamo!{line_break}Sono certo che Lord Babi{line_break}sia vivo e stia bene!{end_wait}"

msgctxt "message"
msgid "08233"
msgstr "Beh, senz'altro.{end_wait}"

msgctxt "message"
msgid "08234"
msgstr "Ora vado all'arena al{line_break}posto di Lord Babi.{line_break}Dovete trovarlo...{end_wait}"

msgctxt "message"
msgid "08235"
msgstr "Continueremo{line_break}le nostre{line_break}ricerche.{end_wait}"

msgctxt "message"
msgid "08236"
msgstr "Lord Babi, dove{line_break}sei andato?{end_wait}"

msgctxt "message"
msgid "08237"
msgstr "Pare che Lord Babi non{line_break}abbia dormito nel{line_break}suo letto...{page_break}Cosa significa?{end_wait}"

msgctxt "message"
msgid "08238"
msgstr "Credo che Lord Babi non{line_break}sia andato a dormire{line_break}la notte scorsa.{end_wait}"

msgctxt "message"
msgid "08239"
msgstr "{actor_name:7} è ospite{line_break}di Lord Babi già{line_break}da qualche tempo.{page_break}Proviene dalla città{line_break}di Lalivero, nel{line_break}continente di Gondowan.{end_wait}"

msgctxt "message"
msgid "08240"
msgstr "Nella sua città, {actor_name:7}{line_break}era venerata come una{line_break}figlia degli dei...{page_break}Ma a me pare una{line_break}bambina normalissima.{end_wait}"

msgctxt "message"
msgid "08241"
msgstr "Babi mi tiene in ostaggio{line_break}per completare il suo{line_break}faro a Lalivero.{page_break}Potrò mai{line_break}ritornare a{line_break}casa mia?{end_wait}"

msgctxt "message"
msgid "08242"
msgstr "{actor_name:7} è stata presa in{line_break}ostaggio per costringere la{line_break}gente di Lalivero a costruire{page_break}il Faro di Babi. Fa stringere{line_break}il cuore sentirla piangere{line_break}e implorare.{end_wait}"

msgctxt "message"
msgid "08243"
msgstr "{actor_name:7} non può{line_break}lasciare questa stanza.{line_break}Anche se fosse davvero{page_break}una figlia degli dei,{line_break}non potrebbe mai tornare{line_break}a Gondowan da sola.{end_wait}"

msgctxt "message"
msgid "08244"
msgstr "Anche se fuggissi dal palazzo{line_break}di Babi, non potrei mai{line_break}raggiungere Lalivero da sola.{page_break}Non potrei mai{line_break}attraversare da sola{line_break}il terribile Suhalla.{end_wait}"

msgctxt "message"
msgid "08245"
msgstr "Hai appena...{end_wait}"

msgctxt "message"
msgid "08246"
msgstr "No, niente...{end_wait}"

msgctxt "message"
msgid "08247"
msgstr "In questo momento si stanno{line_break}svolgendo le eliminatorie{line_break}del Colossum.{page_break}I vincitori di queste{line_break}gare accederanno{line_break}alle finali.{end_wait}"

msgctxt "message"
msgid "08248"
msgstr "L'arena è piena di{line_break}gente... Non mi faranno{line_break}mai entrare.{end_wait}"

msgctxt "message"
msgid "08249"
msgstr "Sperate di vedere il{line_break}Colossum ora?{end_now}"

msgctxt "message"
msgid "08250"
msgstr "I novellini fanno tutti{line_break}lo stesso errore.{page_break}Per vedere il Colossum{line_break}bisogna presentarsi{line_break}all'arena molto presto.{end_wait}"

msgctxt "message"
msgid "08251"
msgstr "Buona scelta... Se volete{line_break}entrare, tornate domani{line_break}di prima mattina.{end_wait}"

msgctxt "message"
msgid "08252"
msgstr "Se fai il colpaccio alla{line_break}\"Scommessa fortunata\",{line_break}puoi vincere parecchio.{page_break}Osservate bene le{line_break}eliminatorie per decidere{line_break}su chi puntare.{end_wait}"

msgctxt "message"
msgid "08253"
msgstr "Sono anni che partecipo{line_break}alla Scommessa fortunata, ma{line_break}non ho mai vinto.{page_break}Vorrei vincere almeno una{line_break}volta in vita mia.{end_wait}"

msgctxt "message"
msgid "08254"
msgstr "La Scommessa Fortunata{line_break}del Colossum rende le lotte{line_break}ancora più entusiasmanti.{end_wait}"

msgctxt "message"
msgid "08255"
msgstr "Voglio vincere parecchio,{line_break}quindi punterò su un guerriero{line_break}che nessun altro ha scelto.{end_wait}"

msgctxt "message"
msgid "08256"
msgstr "Conosci il gioco della{line_break}Scommessa fortunata?{end_now}"

msgctxt "message"
msgid "08257"
msgstr "I partecipanti non possono{line_break}puntare sulla propria squadra.{page_break}Altrimenti le gare non{line_break}sarebbero regolari.{end_wait}"

msgctxt "message"
msgid "08258"
msgstr "È un gioco in cui si deve{line_break}cercare di indovinare quale{line_break}guerriero vincerà le finali.{page_break}Se azzecchi la puntata{line_break}puoi vincere bellissimi{line_break}premi.{end_wait}"

msgctxt "message"
msgid "08259"
msgstr "Chi sarà il guerriero{line_break}che vincerà le{line_break}finali?{page_break}Non sto nella pelle!{end_wait}"

msgctxt "message"
msgid "08260"
msgstr "È assurdo doversi svegliare{line_break}così presto per poter{line_break}entrare nell'arena.{end_wait}"

msgctxt "message"
msgid "08261"
msgstr "Sono tantissimi quelli che{line_break}non riescono ad entrare{line_break}perché arrivano tardi.{page_break}Domani gli spettatori{line_break}arriveranno{line_break}senz'altro presto.{end_wait}"

msgctxt "message"
msgid "08262"
msgstr "Voglio puntare sul{line_break}guerriero più{line_break}forte!{end_wait}"

msgctxt "message"
msgid "08263"
msgstr "Questa è la volta{line_break}buona: posso{line_break}vincere!{end_wait}"

msgctxt "message"
msgid "08264"
msgstr "Tutti rischiano sempre{line_break}di più, così la posta{line_break}in palio è enorme!{page_break}Se vince un guerriero su cui{line_break}hanno puntato in pochi, il{line_break}premio sarà davvero grosso!{end_wait}"

msgctxt "message"
msgid "08265"
msgstr "Ogni anno mi propongo di{line_break}vincere il più possibile,{line_break}ma con scarsi risultati...{page_break}Non riesco proprio{line_break}a smettere...{end_wait}"

msgctxt "message"
msgid "08266"
msgstr "Come ogni anno, dopo le{line_break}eliminatorie qui ci sarà una{line_break}folla spaventosa.{end_wait}"

msgctxt "message"
msgid "08267"
msgstr "Dai, forza!{line_break}Faccio il tifo per{line_break}te, ragazzo!{end_wait}"

msgctxt "message"
msgid "08268"
msgstr "Guardare le eliminatorie{line_break}mi diverte tantissimo.{line_break}Sono incredibili!{end_wait}"

msgctxt "message"
msgid "08269"
msgstr "Veder lottare guerrieri{line_break}così esperti è{line_break}divertentissimo.{end_wait}"

msgctxt "message"
msgid "08270"
msgstr "È un anno intero che aspetto{line_break}il Colossum... Non vedo l'ora{line_break}che inizino le finali!{end_wait}"

msgctxt "message"
msgid "08271"
msgstr "!!!{end_wait}"

msgctxt "message"
msgid "08272"
msgstr "Per raggiungere le finali{line_break}bisogna superare{line_break}molte lotte.{page_break}Quel guerriero non ha{line_break}passato le eliminatorie, quindi{line_break}non parteciperà alle finali.{end_wait}"

msgctxt "message"
msgid "08273"
msgstr "Per raggiungere le finali{line_break}bisogna possedere una{line_break}tecnica perfetta.{page_break}Quel guerriero ha passato{line_break}le eliminatorie, ma non{line_break}vincerà mai le finali.{end_wait}"

msgctxt "message"
msgid "08274"
msgstr "Anche i guerrieri più esili{line_break}possono farcela se sono{line_break}abbastanza determinati!{end_wait}"

msgctxt "message"
msgid "08275"
msgstr "Le eliminatorie consistono{line_break}in sfide personali.{line_break}Che divertimento!{end_wait}"

msgctxt "message"
msgid "08276"
msgstr "Che corpi muscolosi!{line_break}Se solo fossi un po'{line_break}più giovane...{end_wait}"

msgctxt "message"
msgid "08277"
msgstr "Non pensavo che le{line_break}eliminatorie fossero{line_break}così intense...{page_break}Non oso immaginare{line_break}come saranno{line_break}le finali!{end_wait}"

msgctxt "message"
msgid "08278"
msgstr "Per quanto un guerriero{line_break}sia forte, c'è sempre{line_break}qualcuno che lo supera.{end_wait}"

msgctxt "message"
msgid "08279"
msgstr "{actor_name:1} osserva il cartello.{page_break}La locanda è al completo{line_break}Tutto esaurito{end_wait}"

msgctxt "message"
msgid "08280"
msgstr "Questo è il round {argument_signed_number}{line_break}della prima{line_break}finale.{end_wait}"

msgctxt "message"
msgid "08281"
msgstr "Questo è il round {argument_signed_number}{line_break}della prima{line_break}finale.{end_wait}"

msgctxt "message"
msgid "08282"
msgstr "Questo è il round {argument_signed_number}{line_break}della seconda{line_break}finale.{end_wait}"

msgctxt "message"
msgid "08283"
msgstr "Questo è il round {argument_signed_number}{line_break}della seconda{line_break}finale.{end_wait}"

msgctxt "message"
msgid "08284"
msgstr "Questo è il round {argument_signed_number}{line_break}della terza{line_break}finale.{end_wait}"

msgctxt "message"
msgid "08285"
msgstr "Questo è il round {argument_signed_number}{line_break}della terza{line_break}finale.{end_wait}"

msgctxt "message"
msgid "08286"
msgstr "Desideri una{line_break}descrizione di{line_break}questo livello?{end_now}"

msgctxt "message"
msgid "08287"
msgstr "Vuoi che un tuo amico faccia{line_break}il tifo per te qui?{end_now}"

msgctxt "message"
msgid "08288"
msgstr "Se vuoi che qualcuno{line_break}faccia il tifo per te{line_break}fammi sapere chi!{end_wait}"

msgctxt "message"
msgid "08289"
msgstr "{argument_actor_name:1} farà il tifo{line_break}per te? Da questa{line_break}parte, prego.{end_wait}"

msgctxt "message"
msgid "08290"
msgstr "Descrizioni"

msgctxt "message"
msgid "08291"
msgstr "Fare il tifo"

msgctxt "message"
msgid "08292"
msgstr "Nulla"

msgctxt "message"
msgid "08293"
msgstr "Bene, fai del tuo meglio!{end_wait}"

msgctxt "message"
msgid "08294"
msgstr "Purtroppo siamo al completo.{line_break}Dovrai scegliere qualcun{line_break}altro per cui fare il tifo.{end_wait}"

msgctxt "message"
msgid "08295"
msgstr "La gara sta per{line_break}iniziare: ai{line_break}vostri posti.{end_wait}"

msgctxt "message"
msgid "08296"
msgstr "Eh? Non vuoi{line_break}fare il tifo?{end_now}"

msgctxt "message"
msgid "08297"
msgstr "Bene. Aspetta qui{line_break}l'inizio della gara.{end_wait}"

msgctxt "message"
msgid "08298"
msgstr "Beh, allora fai{line_break}del tuo meglio!{end_wait}"

msgctxt "message"
msgid "08299"
msgstr "Sì"

msgctxt "message"
msgid "08300"
msgstr "No"

msgctxt "message"
msgid "08301"
msgstr "L'obiettivo di questa{line_break}prova è liberare il sentiero{line_break}al più presto.{end_wait}"

msgctxt "message"
msgid "08302"
msgstr "Si chiama{line_break}Sfida rocciosa.{end_wait}"

msgctxt "message"
msgid "08303"
msgstr "I guerrieri devono creare{line_break}gradini da usare per{line_break}giungere al traguardo.{end_wait}"

msgctxt "message"
msgid "08304"
msgstr "In questa prova i guerrieri{line_break}possono usare soltanto i loro{line_break}oggetti, insieme alla forza{page_break}e all'ingegno, per raggiungere{line_break}il livello successivo.{end_wait}"

msgctxt "message"
msgid "08305"
msgstr "L'obiettivo di questo{line_break}livello è fare buon uso{line_break}dei piatti della bilancia.{end_wait}"

msgctxt "message"
msgid "08306"
msgstr "Quest'area è chiamata{line_break}Teoria di tubi.{end_wait}"

msgctxt "message"
msgid "08307"
msgstr "Vedi quei tubi d'acqua?{line_break}Formano una specie{line_break}di bilancia.{end_wait}"

msgctxt "message"
msgid "08308"
msgstr "Quando un lato scende,{line_break}l'altro sale.{end_wait}"

msgctxt "message"
msgid "08309"
msgstr "Sapendo questo, dovrai trovare{line_break}un modo per raggiungere il{line_break}livello successivo.{end_wait}"

msgctxt "message"
msgid "08310"
msgstr "L'addetto del{line_break}ponte farà il tifo per{line_break}te in questo livello.{end_wait}"

msgctxt "message"
msgid "08311"
msgstr "Questo livello si chiama{line_break}Ponte rotto.{end_wait}"

msgctxt "message"
msgid "08312"
msgstr "Scegli il momento adatto{line_break}per attraversare il ponte e{line_break}passare al prossimo livello.{end_wait}"

msgctxt "message"
msgid "08313"
msgstr "Se calcoli male il tempo{line_break}cadrai, e ciò ti farà{line_break}perdere tempo.{end_wait}"

msgctxt "message"
msgid "08314"
msgstr "Per passare questo livello{line_break}devi concentrarti sui tronchi.{end_wait}"

msgctxt "message"
msgid "08315"
msgstr "Questo livello si{line_break}chiama Attraversamento{line_break}sui tronchi.{end_wait}"

msgctxt "message"
msgid "08316"
msgstr "L'ostacolo in questo livello è{line_break}quel grande serbatoio d'acqua.{end_wait}"

msgctxt "message"
msgid "08317"
msgstr "Se riesci a fare{line_break}l'attraversamento tutto{line_break}in una volta, non dovrai{page_break}prestarvi{line_break}molta attenzione.{end_wait}"

msgctxt "message"
msgid "08318"
msgstr "Ma per raggiungere la cassa{line_break}del tesoro dovrai calcolare{line_break}bene le tue mosse.{end_wait}"

msgctxt "message"
msgid "08319"
msgstr "In questo livello, ciò che{line_break}importa è procedere{line_break}attraverso il labirinto...{page_break}...senza perdersi o farsi{line_break}prendere dal panico.{end_wait}"

msgctxt "message"
msgid "08320"
msgstr "Questo livello è chiamato{line_break}il Minilabirinto.{end_wait}"

msgctxt "message"
msgid "08321"
msgstr "Le regole sono semplici:{line_break}attraversare al più{line_break}presto il labirinto.{end_wait}"

msgctxt "message"
msgid "08322"
msgstr "Ma dovrai essere rapido e{line_break}preciso nei movimenti{line_break}per vincere.{end_wait}"

msgctxt "message"
msgid "08323"
msgstr "L'addetto degli{line_break}ascensori farà il{line_break}tifo per te.{end_wait}"

msgctxt "message"
msgid "08324"
msgstr "Questo è il livello dei{line_break}piani in movimento.{end_wait}"

msgctxt "message"
msgid "08325"
msgstr "Cerca di saltare da un{line_break}piano mobile{line_break}all'altro.{end_wait}"

msgctxt "message"
msgid "08326"
msgstr "Se non calcoli bene i tuoi{line_break}salti, perderai{line_break}tempo prezioso.{end_wait}"

msgctxt "message"
msgid "08327"
msgstr "Il tuo obiettivo qui è{line_break}correre sui tronchi il{line_break}più rapidamente possibile.{end_wait}"

msgctxt "message"
msgid "08328"
msgstr "È il livello dei{line_break}Tronchi rotolanti.{end_wait}"

msgctxt "message"
msgid "08329"
msgstr "Usa i tronchi per attraversare{line_break}l'acqua e giungere{line_break}dall'altra parte.{end_wait}"

msgctxt "message"
msgid "08330"
msgstr "Raggiungi la riva opposta{line_break}per poter passare{line_break}al livello successivo.{end_wait}"

msgctxt "message"
msgid "08331"
msgstr "In questo livello, ciò{line_break}che più importa è scalare la{line_break}parete rapidamente.{end_wait}"

msgctxt "message"
msgid "08332"
msgstr "Questo livello si chiama{line_break}semplicemente Parete.{end_wait}"

msgctxt "message"
msgid "08333"
msgstr "Scala il muro per primo,{line_break}fatti coraggio e...{line_break}salta giù!{end_wait}"

msgctxt "message"
msgid "08334"
msgstr "Cerca le posizioni{line_break}migliori da cui puoi{line_break}lasciarti cadere rapidamente.{end_wait}"

msgctxt "message"
msgid "08335"
msgstr "In questo livello dovrai{line_break}far rotolare i tronchi{line_break}per formare un sentiero.{end_wait}"

msgctxt "message"
msgid "08336"
msgstr "Questo livello si chiama{line_break}Passeggiata di tronchi.{end_wait}"

msgctxt "message"
msgid "08337"
msgstr "I tronchi{line_break}bloccano{line_break}il cammino.{end_wait}"

msgctxt "message"
msgid "08338"
msgstr "Facendo rotolare i tronchi,{line_break}dovrai liberare un sentiero per{line_break}passare al livello successivo.{end_wait}"

msgctxt "message"
msgid "08339"
msgstr "Il tuo obiettivo in questo{line_break}livello è superare i vuoti{line_break}con la massima rapidità.{end_wait}"

msgctxt "message"
msgid "08340"
msgstr "Questo livello è{line_break}chiamato Bilancia{line_break}della giustizia.{end_wait}"

msgctxt "message"
msgid "08341"
msgstr "Due piattaforme{line_break}costituiscono una{line_break}specie di bilancia.{end_wait}"

msgctxt "message"
msgid "08342"
msgstr "Se una parte si solleva,{line_break}l'altra scende.{end_wait}"

msgctxt "message"
msgid "08343"
msgstr "Usa queste bilance per{line_break}superare i vuoti e passare{line_break}al livello successivo.{end_wait}"

msgctxt "message"
msgid "08344"
msgstr "L'obiettivo di questo{line_break}livello è semplice: trovare{line_break}la via più breve.{end_wait}"

msgctxt "message"
msgid "08345"
msgstr "È il livello chiamato{line_break}Saltamasso.{end_wait}"

msgctxt "message"
msgid "08346"
