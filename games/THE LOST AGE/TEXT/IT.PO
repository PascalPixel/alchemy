msgctxt "message"
msgid "07004"
msgstr "Mi spiace, ma nelle notti{line_break}di luna piena, vendiamo{line_break}solo zanne ed artigli.{page_break}Voi... probabilmente{line_break}non sapreste cosa{line_break}farvene!{end_wait}"

msgctxt "message"
msgid "07005"
