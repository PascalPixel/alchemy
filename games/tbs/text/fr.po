"Merci. A nous trois,\n"
"je pense qu'on pourra\n"
"récupérer le bâton."

#, alchemy-end-wait
msgctxt "message"
msgid "04674"
msgstr "Vous vous appelez..."

#, alchemy-end-wait
msgctxt "message"
msgid "04675"
msgstr ""
"{actor_name:1} et {actor_name:2}.\n"
"Je suis {actor_name:3}.\n"
