msgctxt "message"
msgid "09835"
msgstr "La statua parla al{line_break}cuore di {actor_name:1}...{page_break}Tu che aspiri a salire al{line_break}Faro di Venere dovrai ottenere{line_break}il permesso della signora.{page_break}Solo allora si aprirà la via.{line_break}La signora custodisce{line_break}il luogo che cerchi{page_break}ai suoi piedi,{line_break}attendendo il{line_break}tuo arrivo.{end_wait}"

msgctxt "message"
msgid "09836"
msgstr "La statua parla al{line_break}cuore di {actor_name:1}...{page_break}Tu che aspiri a salire{line_break}al Faro di Venere, la{line_break}signora conosce i tuoi{page_break}desideri. La strada non{line_break}potrà aprirsi qui.{end_wait}"

