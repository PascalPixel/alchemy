msgctxt "message"
msgid "08381"
msgstr "Vous pouvez obtenir des{line_break}armes dans l'arène, mais{line_break}l'une d'entre elles est{page_break}plus puissante que l'autre.{end_wait}"

msgctxt "message"
msgid "08382"
msgstr "Si vous arrivez le{line_break}premier, vous aurez{line_break}l'avantage.{end_wait}"

msgctxt "message"
msgid "08383"
msgstr "Vous pourrez vous servir{line_break}de l'équipement que vous{line_break}aurez trouvé dans{page_break}votre prochain duel.{end_wait}"

