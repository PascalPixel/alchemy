msgctxt "message"
msgid "08807"
msgstr "Tu as du rêver,{line_break}{actor_name:1}.{end_wait}"

msgctxt "message"
msgid "08808"
msgstr "Tu as l'air éreinté,{line_break}c'est pour ça que{line_break}tu as eu des cauchemars.{page_break}Tu vas mieux, {actor_name:1}?{end_now}"

msgctxt "message"
msgid "08809"
msgstr "Tu penses pouvoir{line_break}y arriver?{page_break}Je comprends, mais n'en{line_break}fais pas trop, OK {actor_name:1}!{end_wait}"

