# The layout of SGL's own sample code, on clang-format's LLVM style: a tab of
# four columns for each level, a function's brace on a line of its own, else
# after the closing brace, no space between a control word and its
# parenthesis, a continued line one tab in, and comments after code lined up.
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Always
ColumnLimit: 80
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  BeforeElse: false
AllowShortFunctionsOnASingleLine: None
ContinuationIndentWidth: 4
AlignAfterOpenBracket: DontAlign
AlignOperands: DontAlign
AlignTrailingComments: true
AlignConsecutiveMacros: AcrossComments
AlignEscapedNewlines: DontAlign
AlignConsecutiveDeclarations: Consecutive
SeparateDefinitionBlocks: Always
# Include order is load-bearing here: it decides which declarations are in
# scope, and so the generated bytes.
SortIncludes: Never
# The integer types the games and the development kit define, so that a cast
# such as (Uint32)&x is read as a cast and not as a bitwise and.
TypeNames: [Uint8, Sint8, Uint16, Sint16, Uint32, Sint32, Uint64, Sint64, Bool, u8, s8, u16, s16, u32, s32]
# Loop macros, so that the statement after one is indented as a loop body,
# written as calls, with no space before the parenthesis.
ForEachMacros: [EFFECT_FOR_EACH_TARGET]
# Macros that expand to a whole definition and take no semicolon, so that
# the line after one, even after an UNUSED one, starts a new declaration.
StatementMacros: [DEFINE_EFFECT_KIND]
SpaceBeforeParens: Never
