msgctxt "message"
msgid "05890"
msgstr ""
"Vous pouvez entendre\n"
"des coassements de\n"
"grenouille venant de{page_break}"
"l'intérieur.{end_wait}"

msgctxt "message"
msgid "05891"
msgstr ""
"Thélos... Combien de\n"
"temps penses-tu que\n"
"cet îlot va dériver?{end_wait}"

msgctxt "message"
msgid "05892"
msgstr ""
"Je n'en ai pas la\n"
"moindre idée!{end_wait}"

msgctxt "message"
msgid "05893"
msgstr ""
"Pffff... Tu ne sers pas\n"
"à grand-chose.{end_wait}"

msgctxt "message"
msgid "05894"
msgstr "Hé, j'ai faim...{end_wait}"

msgctxt "message"
msgid "05895"
msgstr ""
"Comment peux-tu\n"
"penser à manger?{end_wait}"

msgctxt "message"
msgid "05896"
msgstr ""
"Je me demande ce\n"
"qui est arrivé à\n"
"mon frère...{end_wait}"

msgctxt "message"
msgid "05897"
msgstr ""
"Je n'en suis pas sûr,{pause_20_skippable}\n"
"mais on dirait qu'il a\n"
"réussi à allumer le phare.{end_wait}"

msgctxt "message"
msgid "05898"
msgstr ""
"Je le savais déjà.\n"
"C'est pour ça qu'on\n"
"est en train de dériver.{end_wait}"

msgctxt "message"
msgid "05899"
msgstr ""
"Tu es de mauvais poil,\n"
"aujourd'hui, {actor_name:6}!{end_wait}"

msgctxt "message"
msgid "05900"
msgstr ""
"Bah,{pause_20_skippable} je suppose que\n"
"tu te fais du souci\n"
"pour {actor_name:5}.{end_wait}"

msgctxt "message"
msgid "05901"
msgstr ""
"{actor_name:1} et ses amis\n"
"ne devaient pas être\n"
"bien loin...{end_wait}"

msgctxt "message"
msgid "05902"
msgstr "Ils sont sans doute...{end_wait}"

msgctxt "message"
msgid "05903"
msgstr ""
"Ils me manquent...\n"
"{actor_name:1}...\n"
"{actor_name:5}...{end_wait}"

msgctxt "message"
msgid "05904"
msgstr ""
"J'aimerais vous montrer\n"
"quelque chose.{end_wait}"

msgctxt "message"
msgid "05905"
msgstr "Par ici.{end_wait}"

