{
  "name": "alchemy-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "build:claimed": "bun tools/build_claimed.ts",
    "build:asm": "bun tools/build_asm.ts",
    "build:assets": "bun tools/build_assets.ts",
    "build:semantic": "bun tools/build_semantic.ts",
    "semantic:queue": "bun tools/semantic_queue.ts",
    "semantic:check": "bun tools/semantic_owner_scope.ts --check",
    "core:retained:check": "bun tools/core_retained_audit.ts --check",
    "build:full": "bun tools/build_full.ts",
    "build:rom": "bun tools/build_rom.ts",
    "verify": "bun run build:inventory && bun run test:statement-order && bun run test && bun run test:overlay-candidate-rank && bun run build:claimed && bun run build:semantic && bun run semantic:check && bun tools/build_full.ts --source-only && bun run build:full && bun run core:retained:check && bun tools/semantic_superseded.ts --check && bun run sanctum && bun run progress:check",
    "progress": "bun tools/full_c_progress.ts",
    "coverage": "bun tools/coverage_map.ts --write",
    "coverage:check": "bun tools/coverage_map.ts --check",
    "progress:check": "bun tools/full_c_progress.ts --check",
    "progress:subject": "bun tools/full_c_progress.ts --subject",
    "progress:history": "bun tools/full_c_history.ts --write",
    "verify:showcase": "bun tools/overlay_showcase.ts --all",
    "test:compiler-explorer": "bun tools/mode_sweep.ts --self-test",
    "test:compiler-cohort": "bun tools/mode_cohort.ts --self-test",
    "test:overlay-compiler-cohort": "bun tools/overlay_mode_cohort.ts --self-test",
    "test:compiler-corpus": "bun tools/compiler_corpus_regression.ts --self-test",
    "test:compiler-batch": "bun tools/search_compiler_modes.ts --self-test",
    "test:overlay-candidate-rank": "bun tools/overlay_candidate_rank.ts --self-test",
    "test:statement-order": "bun tools/statement_order_sweep_main.ts --self-test",
    "test": "bun run lint && bun tools/self_test.ts",
    "build:inventory": "bun tools/overlay_inventory.ts",
    "sanctum": "bun tools/check_sanctum.ts",
    "lint": "bun tools/no_asm_c.ts && bun tools/decomp_targets.ts && bun tools/cache_key_lint.ts && bun tools/alchemy_gcc.ts --lint",
    "typecheck": "tsc --noEmit && tsc -p tools/dashboard/tsconfig.json --noEmit"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "dependencies": {
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
