msgctxt "message"
msgid "07604"
msgstr "Se avessimo lavorato insieme{line_break}avremmo potuto già essere{line_break}salpati...{page_break}Ma ormai è troppo tardi...{line_break}A causa di quel ciondolo,{line_break}non si va da nessuna parte.{end_wait}"

msgctxt "message"
msgid "07605"
msgstr "Beh, allora, perché non{line_break}vi fate un giro{line_break}della nave?{page_break}Potrei aver bisogno di{line_break}voi più tardi. Spero che{line_break}possiate aiutarmi.{end_wait}"

msgctxt "message"
msgid "07606"
msgstr "Se fosse arrivata la nave{line_break}da Tolbi mi sentirei{line_break}meglio, ma a questo{page_break}punto non possiamo{line_break}certamente salpare!{page_break}Chissà che fine a fatto il{line_break}ciondolo portafortuna.{end_wait}"

msgctxt "message"
msgid "07607"
msgstr "La nave non partirà{line_break}finché non avremo trovato{line_break}l'ancora portafortuna.{page_break}Beh, forse non{line_break}salperemo affatto.{end_wait}"

msgctxt "message"
msgid "07608"
msgstr "È ridicolo che la nave non{line_break}possa salpare a causa di{line_break}un ciondolo portafortuna!{end_wait}"

msgctxt "message"
msgid "07609"
