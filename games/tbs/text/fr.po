#, alchemy-end-wait
msgctxt "message"
msgid "04596"
msgstr ""
"Si ça continue comme\n"
"ça, ils ne partiront\n"
"jamais."

#, alchemy-end-wait
msgctxt "message"
msgid "04597"
msgstr ""
"Allez,{pause_20_skippable} un dernier\n"
"au revoir!"

#, alchemy-end-wait
msgctxt "MsgValeFarewell"
msgid "04598"
msgstr "{text_effect:2}Au revoir!{reset_text_style}"

#, alchemy-end-wait
msgctxt "MsgWorldMapWeCantStayAnotherMinute"
msgid "04599"
msgstr ""
"Nous ne pouvons pas\n"
"rester un instant de\n"
"plus dans un endroit{page_break}"
"aussi dangereux.\n"
"Retournons à Kalay!"

#, alchemy-end-wait
msgctxt "message"
msgid "04600"
msgstr ""
"Maître Hammet! C'est\n"
"terrible! Le pont a\n"
