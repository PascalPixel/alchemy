msgctxt "message"
msgid "10480"
msgstr ""
"Esto es un barco lemurio.\n"
"Yo creo que sí.{end_wait}"

msgctxt "message"
msgid "10481"
msgstr ""
"Creo que es difícil\n"
"saberlo. Pero ya no\n"
"podemos volver atrás...{end_wait}"

msgctxt "message"
msgid "10482"
msgstr "Bueno... ¿nos vamos?{end_wait}"

msgctxt "message"
msgid "10483"
msgstr "A la mar...{end_wait}"

msgctxt "message"
msgid "10484"
msgstr ""
"¡{actor_name:6} nos está\n"
"esperando!{end_wait}"

msgctxt "MsgWorldMapKradenHowLongWillIsland"
msgid "10485"
msgstr ""
"Kraden... ¿Cuánto tiempo\n"
"vamos a estar a la deriva\n"
"en esta isla?{end_wait}"

msgctxt "message"
msgid "10486"
msgstr ""
"No lo sé...\n"
"Esperaba que me\n"
"lo dijeras tú.{end_wait}"

msgctxt "message"
msgid "10487"
msgstr ""
"Vaya... En momentos\n"
"así no sirves para nada.{end_wait}"

msgctxt "message"
msgid "10488"
msgstr "Eh, tengo hambre...{end_wait}"

msgctxt "message"
msgid "10489"
msgstr ""
"¿Cómo puedes\n"
"pensar en comida?{end_wait}"

msgctxt "message"
msgid "10490"
msgstr ""
"¿Qué le habrá\n"
"sucedido a mi\n"
"hermano...?{end_wait}"

msgctxt "message"
msgid "10491"
msgstr ""
"No estoy seguro,{pause_20_skippable} pero\n"
"parece que encendieron\n"
"el Faro de Venus.{end_wait}"

msgctxt "message"
msgid "10492"
msgstr ""
"Eso ya lo sé. Por eso\n"
"acabamos aquí, ¿o no?{end_wait}"

msgctxt "message"
msgid "10493"
msgstr ""
"Estás un poco quisquillosa\n"
