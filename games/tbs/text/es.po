"Creo que adivinaron\n"
"nuestra estrategia.{end_wait}"

msgctxt "message"
msgid "10581"
msgstr ""
"Quizás tenga que\n"
"mejorar mi técnica...{end_wait}"

msgctxt "message"
msgid "10582"
msgstr "?"

msgctxt "message"
msgid "10583"
msgstr "¡Hemos perdido!{end_wait}"

