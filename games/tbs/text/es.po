msgctxt "MsgLaliveroIfYouDefeatedThatEvilBunch"
msgid "10407"
msgstr ""
"¡Si acabasteis con ese grupo\n"
"malvado, debéis de ser unos\n"
"guerreros poderosos!{end_wait}"

msgctxt "MsgLaliveroActorJumpedIntoTheOceanFrom"
