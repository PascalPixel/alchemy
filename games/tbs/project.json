{
  "format": 2,
  "game": "tbs",
  "canonical_edition": "ja",
  "default_target": "tbs-en",
  "build_model": "shared-source-edition-defines",
  "layout": {
    "source": "games/tbs/SRC",
    "source_paths": "games/tbs/source-paths.json",
    "assembly": "games/tbs/asm",
    "assets": "games/tbs/assets",
    "include": "games/tbs/INCLUDE",
    "metrics": "games/tbs/metrics",
    "reconstruction": "games/tbs/recon",
    "semantic": "games/tbs/semantic"
  },
  "cross_edition_calibration": "games/tbs/recon/cross-edition.json",
  "reports": {
    "directory": "out/tbs-en/reports",
    "refresh": "make reports"
  },
  "editions": {
    "ja": {
      "target": "tbs-ja",
      "define": "TBS_EDITION_JA",
      "role": "canonical",
      "rom": "roms/tbs-ja.gba",
      "output": "out/tbs-ja",
      "verification": "compile-only"
    },
    "en": {
      "target": "tbs-en",
      "define": "TBS_EDITION_EN",
      "role": "derived-default",
      "rom": "roms/tbs-en.gba",
      "output": "out/tbs-en",
      "verification": "full"
    },
    "de": {
      "target": "tbs-de",
      "define": "TBS_EDITION_DE",
      "role": "derived",
      "rom": "roms/tbs-de.gba",
      "output": "out/tbs-de",
      "verification": "compile-only"
    },
    "es": {
      "target": "tbs-es",
      "define": "TBS_EDITION_ES",
      "role": "derived",
      "rom": "roms/tbs-es.gba",
      "output": "out/tbs-es",
      "verification": "compile-only"
    },
    "fr": {
      "target": "tbs-fr",
      "define": "TBS_EDITION_FR",
      "role": "derived",
      "rom": "roms/tbs-fr.gba",
      "output": "out/tbs-fr",
      "verification": "compile-only"
    },
    "it": {
      "target": "tbs-it",
      "define": "TBS_EDITION_IT",
      "role": "derived",
      "rom": "roms/tbs-it.gba",
      "output": "out/tbs-it",
      "verification": "compile-only"
    }
  },
  "policy": {
    "source_direction": "ja-to-derived-editions",
    "draft_source_claims_done_bytes": false,
    "exactness_is_per_edition": true,
    "rom_fallback_is_build_progress": false
  }
}
