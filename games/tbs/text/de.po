#, alchemy-end-wait
msgctxt "message"
msgid "06798"
msgstr ""
"Wenn so viele Leute nach\n"
"Tolbi wollen, werden sicher\n"
"einige an Colosso teilnehmen."

#, alchemy-end-wait
msgctxt "message"
msgid "06799"
msgstr ""
"Ich bin wegen der seltsamen\n"
"Vorkommnisse der letzten\n"
"Zeit etwas besorgt."

#, alchemy-end-wait
msgctxt "message"
msgid "06800"
