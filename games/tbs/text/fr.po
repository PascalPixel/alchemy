#, alchemy-end-wait
msgctxt "message"
msgid "09319"
msgstr ""
"Un instant de plus et\n"
"c'en était fini de vous!"

#, alchemy-end-wait
msgctxt "message"
msgid "09320"
msgstr "Vil serpent!"

#, alchemy-end-wait
msgctxt "message"
msgid "09321"
msgstr ""
"Dodonpa, tu es pourri\n"
"jusqu'à la moelle!"

#, alchemy-end-wait
msgctxt "message"
msgid "09322"
