#, alchemy-end-wait
msgctxt "message"
msgid "09295"
msgstr "Dodonpa!"

#, alchemy-end-wait
msgctxt "message"
msgid "09296"
msgstr ""
"Navré d'interrompre\n"
"cette touchante petite\n"
"réunion, Hammet!"

#, alchemy-end-wait
msgctxt "message"
msgid "09297"
