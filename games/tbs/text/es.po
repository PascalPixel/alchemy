msgctxt "message"
msgid "09868"
msgstr ""
"Estamos bien...\n"
"Debéis apresuraros\n"
"hacia el faro.{end_wait}"

msgctxt "message"
msgid "09869"
msgstr ""
"El faro... {actor_name:7}...\n"
