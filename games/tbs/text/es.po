"miraré luchar.{end_wait}"

msgctxt "message"
msgid "10565"
msgstr "Me siento... aliviado.{end_wait}"

msgctxt "message"
msgid "10566"
msgstr ""
"Espero que mis ruegos\n"
"sean escuchados...{end_wait}"

msgctxt "message"
msgid "10567"
msgstr "?"

msgctxt "message"
msgid "10568"
msgstr "¡A por ellos!{end_wait}"

