"Qui étaient ces gens\n"
"qui sont entrés à\n"
"l'intérieur?"

#, alchemy-end-wait
msgctxt "MsgLunpaGuardsWarnPartyAway"
msgid "09404"
msgstr ""
"Ne vous approchez pas\n"
"de la forteresse!"

#, alchemy-end-wait
msgctxt "MsgLunpaLeftGuardRecognizesHammet"
msgid "09405"
