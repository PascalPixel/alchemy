#, alchemy-end-wait
msgctxt "message"
msgid "08976"
msgstr "You have my sincerest thanks."

#, alchemy-end-wait
msgctxt "message"
msgid "08977"
msgstr "Where are you going?"

#, alchemy-end-wait
msgctxt "message"
msgid "08978"
msgstr "To Kushinada, of course."

#, alchemy-end-wait
msgctxt "MsgGaiaRockInside08"
msgid "08979"
