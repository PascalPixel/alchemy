"{actor_name:6}."

#, alchemy-end-now
msgctxt "message"
msgid "10306"
msgstr ""
"N'est-ce pas,\n"
"{actor_name:1}?"

#, alchemy-end-wait
msgctxt "MsgLaliveroDoNotWorryAboutSheba"
msgid "10307"
