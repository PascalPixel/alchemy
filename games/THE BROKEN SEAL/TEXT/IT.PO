msgctxt "message"
msgid "07562"
msgstr "Saremo lieti di{line_break}aiutarvi contro{line_break}i mostri.{end_wait}"

msgctxt "message"
msgid "07563"
msgstr "Ah,{pause_20_skippable} davvero?{end_wait}"

msgctxt "message"
msgid "07564"
msgstr "Ehi, Ouranos, pensavo che...{end_wait}"

msgctxt "message"
msgid "07565"
msgstr "Dobbiamo arrivare in tempo{line_break}per il Colossum...{pause_20_skippable} Se facciamo{line_break}tardi non ci fanno entrare.{end_wait}"

msgctxt "message"
msgid "07566"
msgstr "Questo è vero, ma...{end_wait}"

msgctxt "message"
msgid "07567"
