msgctxt "message"
msgid "09605"
msgstr "È il continente ad{line_break}ovest? Si trova dall'altra{line_break}parte del mare?{end_wait}"

msgctxt "message"
msgid "09606"
msgstr "Non perdiamo tempo in{line_break}chiacchiere. Dobbiamo{line_break}partire immediatamente.{end_wait}"

msgctxt "message"
msgid "09607"
msgstr "Prendete il Bastone{line_break}sciamanico e andate verso{line_break}l'Hesperia.{page_break}E...{pause_20_skippable}siate prudenti!{end_wait}"

msgctxt "message"
msgid "09608"
