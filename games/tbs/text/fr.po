"il va rentrer avec nous!"

#, alchemy-end-wait
msgctxt "message"
msgid "09304"
msgstr ""
"Je suis désolé, je ne\n"
"peux pas vous laisser\n"
"faire cela."

#, alchemy-end-wait
msgctxt "message"
msgid "09305"
msgstr ""
"Hammet est ce que j'aime\n"
"appeler ma poule\n"
"aux ¾ufs d'or."

#, alchemy-end-wait
msgctxt "message"
msgid "09306"
msgstr "Espèce d'ordure!"

#, alchemy-end-wait
msgctxt "message"
msgid "09307"
msgstr ""
"Les insultes ne vous\n"
"mèneront nulle part!\n"
"Hammet va rester ici!"

#, alchemy-end-wait
msgctxt "message"
msgid "09308"
msgstr ""
"Dodonpa actionne\n"
"un levier."

#, alchemy-end-wait
msgctxt "message"
msgid "09309"
msgstr ""
"Ce petit piège marque\n"
"la fin de vos petites\n"
"aventures!"

#, alchemy-end-wait
msgctxt "MsgLunpaPrepareBecomeMonster"
msgid "09310"
msgstr ""
"Préparez-vous à\n"
"devenir de la purée!"

#, alchemy-end-wait
msgctxt "MsgLunpaBackMoreGuess"
msgid "09311"
msgstr ""
"Vous en voulez encore?\n"
"Vous n'avez pas retenu\n"
"la leçon?"

#, alchemy-end-wait
msgctxt "MsgLunpaDodonpaPulledLever"
msgid "09312"
msgstr ""
"Dodonpa actionne\n"
"un levier."

#, alchemy-end-wait
msgctxt "message"
msgid "09313"
msgstr ""
"Essayez autant que\n"
"vous voulez, vous ne\n"
"gagnerez jamais!"

#, alchemy-end-wait
msgctxt "message"
msgid "09314"
msgstr ""
"Préparez-vous à\n"
"devenir de la purée!"

#, alchemy-end-wait
msgctxt "MsgLunpaUhnnGetOff"
