msgctxt "message"
msgid "07717"
msgstr "Sto girando!{end_wait}"

msgctxt "message"
msgid "07718"
msgstr "È troppo tardi!{end_wait}"

msgctxt "message"
msgid "07719"
msgstr "{text_effect:4}Arrgh!{end_wait}"

msgctxt "message"
msgid "07720"
