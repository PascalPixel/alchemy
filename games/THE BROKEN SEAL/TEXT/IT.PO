msgctxt "message"
msgid "07773"
msgstr "Ehi...{pause_20_skippable} stai scherzando?{line_break}Vuoi farmi remare?{end_now}"

msgctxt "message"
msgid "07774"
msgstr "Ma cosa t'ho{line_break}fatto di male?{end_wait}"

msgctxt "message"
msgid "07775"
msgstr "Ah, bene. Io me la cavo{line_break}meglio con un mestolo che{line_break}con un remo.{end_wait}"

msgctxt "message"
msgid "07776"
msgstr "Non vorrai{pause_20_skippable} chiedere{line_break}ad una donna di remare?{end_now}"

msgctxt "message"
msgid "07777"
msgstr "Come?{pause_20_skippable} Non ci credo!{pause_20_skippable}{line_break}Sei un villano! Non dimenticherò{line_break}quest'offesa!{end_wait}"

msgctxt "message"
msgid "07778"
msgstr "Ah, per un momento l'ho{line_break}temuto! Non farmi mai più{line_break}scherzi del genere!{end_wait}"

msgctxt "message"
msgid "07779"
msgstr "Come? {text_effect:4}Oooh nooo...{pause_20_skippable}{line_break}{reset_text_style}Vuoi farmi{line_break}remare?{end_now}"

msgctxt "message"
msgid "07780"
msgstr "Eh?{pause_20_skippable} VUOI{line_break}farmi remare?{page_break}E va bene, vado.{line_break}Ma non scorderò mai{line_break}questo affronto...{end_wait}"

msgctxt "message"
msgid "07781"
msgstr "Davvero?{pause_20_skippable} Non{line_break}mi fai remare? Sei{line_break}un bravo ragazzo!{end_wait}"

msgctxt "message"
msgid "07782"
msgstr "Si tratta di remare?{line_break}Scegli pure chi{line_break}preferisci.{end_wait}"

msgctxt "message"
msgid "07783"
msgstr "Come?{pause_20_skippable} Me? Stai{line_break}scherzando, vero?{end_now}"

msgctxt "message"
msgid "07784"
msgstr "{text_effect:4}Aaah!{pause_20_skippable}{reset_text_style}{line_break}Questo è troppo,{line_break}per me!{end_wait}"

msgctxt "message"
msgid "07785"
msgstr "Non farmi più uno{line_break}scherzo del genere!{end_wait}"

msgctxt "message"
msgid "07786"
