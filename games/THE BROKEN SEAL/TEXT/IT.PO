msgstr "Niente da fare? Ma era{line_break}un'ottima offerta...{page_break}"

msgctxt "message"
msgid "03545"
msgstr "Cerchi rarità? Torna{line_break}più tardi, va bene?{end_wait}"

msgctxt "message"
msgid "03546"
msgstr "Cerchi rarità? Sei nel{page_break}posto che fa per te!{end_now}"

msgctxt "message"
msgid "03547"
msgstr "Riparo strumenti: cosa{page_break}vuoi che ti ripari?{end_now}"

msgctxt "message"
msgid "03548"
msgstr "Non riparo questi{line_break}strumenti.{page_break}"

msgctxt "message"
msgid "03549"
msgstr "{plural_suffix} {argument_item_name:1}{line_break}non ha alcun danno.{page_break}"

msgctxt "message"
msgid "03550"
