"J'ai l'impression que\n"
"tout va de mal en pis."

#, alchemy-end-wait
msgctxt "MsgLunpaInteriorsThirdHomeBReopened"
msgid "09428"
msgstr ""
"Papi m'a dit que\n"
"l'éruption du Mont\n"
