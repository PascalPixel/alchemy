"preocupaciones.{end_wait}"

msgctxt "message"
msgid "10576"
msgstr ""
"¡Habéis vuelto\n"
"sanos y salvos!{page_break}"
"¡Mis ruegos han debido\n"
"de ser escuchados!{end_wait}"

msgctxt "message"
msgid "10577"
msgstr "?"

msgctxt "message"
msgid "10578"
msgstr "¿Habéis ganado?{end_wait}"

msgctxt "MsgLobbyNotFaultLost"
msgid "10579"
msgstr ""
"{actor_name:1}, no es culpa\n"
"mía que hayamos perdido.{page_break}"
"¡Tenemos que mejorar\n"
"nuestro trabajo en\n"
"equipo la próxima vez!{end_wait}"

msgctxt "message"
msgid "10580"
msgstr ""
