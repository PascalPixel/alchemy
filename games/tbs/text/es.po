msgid "10519"
msgstr ""
"No tienes un oponente.\n"
"¿Quieres desafiar a un\n"
"monstruo?{end_now}"

msgctxt "message"
msgid "10520"
msgstr ""
"Entonces, espera a que\n"
"aparezca un oponente,\n"
"por favor.{end_wait}"

