msgctxt "message"
msgid "06951"
msgstr "Possono incutere{line_break}timore...{page_break}Ma dobbiamo cercare di{line_break}comunicare con loro.{end_wait}"

msgctxt "message"
msgid "06952"
msgstr "Licantropi... lupi{line_break}mannari... un intero{line_break}villaggio che si nasconde...{end_wait}"

msgctxt "message"
msgid "06953"
msgstr "Sono io...{page_break}oppure Kraden sembra{line_break}TROPPO felice di{line_break}aver trovato dei lupi mannari?{end_now}"

msgctxt "message"
msgid "06954"
msgstr "Cosa? Io? Felice per{line_break}aver trovato i licantropi?{line_break}Starai scherzando!{end_wait}"

