#, alchemy-end-wait
msgctxt "MsgLunpaOwwwDontHurt"
msgid "09251"
msgstr ""
"Aouch! Hé! Me faites\n"
"plus mal, bande de\n"
"petits vauriens!{page_break}"
"Je vous déteste! Allez\n"
"sauver Hammet qu'on\n"
"n'en parle plus."

#, alchemy-end-wait
msgctxt "MsgLunpaShouldNotHaveFought"
msgid "09252"
msgstr ""
"Qui aurait pu penser\n"
