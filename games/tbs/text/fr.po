#, alchemy-end-wait
msgctxt "MsgLunpaItemMerchantReopened"
msgid "09435"
msgstr ""
"Les marchands d'armes et\n"
"d'armures ont l'air\n"
"désespérés.{page_break}"
"Ils sont en train\n"
"d'épuiser leurs\n"
"stocks."

#, alchemy-end-wait
msgctxt "MsgLunpaIsntWeaponsVendors"
msgid "09436"
