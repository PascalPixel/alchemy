{
  "name": "alchemy-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "build:claimed": "tools-rs/build-claimed/target/release/build-claimed",
    "build:asm": "bun tools/make/build_asm.ts",
    "build:assets": "bun tools/make/build_assets.ts",
    "build:semantic": "bun tools/make/build_semantic.ts",
    "semantic:queue": "tools-rs/semantic-queue/target/release/semantic-queue",
    "semantic:check": "tools-rs/semantic-owner-scope/target/release/semantic-owner-scope --check",
    "core:retained:check": "tools-rs/core-retained-audit/target/release/core-retained-audit --check",
    "build:full": "bun tools/make/build_full.ts",
    "build:rom": "tools-rs/build-rom/target/release/build-rom",
    "verify": "bun run build:inventory && bun run test:statement-order && bun run test && bun run test:overlay-candidate-rank && bun run build:claimed && bun run build:semantic && bun run semantic:check && bun tools/make/build_full.ts --source-only && bun run build:full && bun run core:retained:check && tools-rs/semantic-superseded/target/release/semantic-superseded --check && bun run sanctum && bun run progress:check",
    "progress": "tools-rs/full-c-progress/target/release/full-c-progress",
    "coverage": "tools-rs/coverage-map/target/release/coverage-map --write",
    "coverage:check": "tools-rs/coverage-map/target/release/coverage-map --check",
    "progress:check": "tools-rs/full-c-progress/target/release/full-c-progress --check",
    "progress:subject": "tools-rs/full-c-progress/target/release/full-c-progress --subject",
    "progress:history": "tools-rs/full-c-history/target/release/full-c-history --write",
    "verify:showcase": "tools-rs/overlay-showcase/target/release/overlay-showcase --all",
    "test:compiler-explorer": "tools-rs/mode-sweep/target/release/mode-sweep --self-test",
    "test:compiler-cohort": "tools-rs/mode-cohort/target/release/mode-cohort --self-test",
    "test:overlay-compiler-cohort": "tools-rs/overlay-mode-cohort/target/release/overlay-mode-cohort --self-test",
    "test:compiler-corpus": "tools-rs/compiler-corpus-regression/target/release/compiler-corpus-regression --self-test",
    "test:compiler-batch": "tools-rs/search-compiler-modes/target/release/search-compiler-modes --self-test",
    "test:overlay-candidate-rank": "tools-rs/overlay-candidate-rank/target/release/overlay-candidate-rank --self-test",
    "test:statement-order": "tools-rs/statement-order-sweep-main/target/release/statement-order-sweep-main --self-test",
    "test": "bun run lint && tools-rs/self-test/target/release/self-test",
    "build:inventory": "tools-rs/overlay-inventory/target/release/overlay-inventory",
    "sanctum": "tools-rs/check-sanctum/target/release/check-sanctum",
    "lint": "bun run typecheck && tools-rs/architecture/target/release/architecture && tools-rs/source-citations/target/release/source-citations && tools-rs/target/release/no-asm-c && tools-rs/decomp-targets/target/release/decomp-targets --self-test && tools-rs/target/release/cache-key-lint && bun tools/lib/alchemy_gcc.ts --lint",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "dependencies": {
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
