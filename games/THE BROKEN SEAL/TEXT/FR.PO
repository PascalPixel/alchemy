msgctxt "message"
msgid "08793"
msgstr "On dirait que nous{line_break}n'avons pas le choix.{page_break}Nous devons participer{line_break}aux finales!{end_wait}"

msgctxt "message"
msgid "08794"
msgstr "Ca causerait des{line_break}problèmes si nous ne{line_break}le faisions pas?{end_wait}"

msgctxt "message"
msgid "08795"
msgstr "Je ne veux pas causer{line_break}d'ennuis à qui que{line_break}ce soit!{page_break}Allons combattre.{end_wait}"

msgctxt "message"
msgid "08796"
