msgctxt "message"
msgid "09808"
msgstr "Iodem, guarda!{line_break}L'ingresso del Faro di{line_break}Venere è aperto...{page_break}Dopo{pause_20_skippable} anni di studi...{line_break}...alla fine i nostri sogni{line_break}sono diventati realtà!{end_wait}"

msgctxt "message"
msgid "09809"
