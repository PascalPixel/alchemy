#, alchemy-end-wait
msgctxt "message"
msgid "05248"
msgstr ""
"Do you put Djinn on\n"
"standby before a battle,\n"
"or do you set them?{page_break}"
"I usually set them to\n"
"raise my class before\n"
"I fight."

