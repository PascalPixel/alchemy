msgctxt "message"
msgid "08861"
msgstr "{actor_name:5}?{end_wait}"

msgctxt "message"
msgid "08862"
msgstr "Ti... ti ha appena chiamato{line_break}{actor_name:5}, giusto?{end_wait}"

msgctxt "message"
msgid "08863"
msgstr "Come ho fatto a non capirlo?{line_break}Tu sei {actor_name:5}!{end_wait}"

msgctxt "message"
msgid "08864"
msgstr "Allora anche Adexia dovrebbe{line_break}essere qui attorno...{line_break}eppure...{end_wait}"

msgctxt "message"
msgid "08865"
msgstr "Non incontrerai mai più{line_break}Saturos e Adexia.{line_break}{actor_name:1} li ha uccisi.{page_break}Probabilmente ora{line_break}riposano in fondo al mare...{end_wait}"

msgctxt "message"
msgid "08866"
msgstr "{actor_name:7}! Silenzio!{end_wait}"

msgctxt "message"
msgid "08867"
msgstr "Hmph! Ho sentito,{line_break}piccola strega!{end_wait}"

msgctxt "message"
msgid "08868"
msgstr "Ma è vero? Mia{line_break}sorella... morta?{end_now}"

msgctxt "message"
msgid "08869"
msgstr "No? Allora dov'è!?{line_break}Ridatemi mia sorella!{end_wait}"

msgctxt "message"
msgid "08870"
msgstr "Che c'è? È così difficile?{line_break}Voi viaggiavate{line_break}con lei, ridatemela!{end_wait}"

msgctxt "message"
msgid "08871"
msgstr "Non vi avrebbe mai abbandonati...{line_break}eppure siete qui{line_break}soli...{pause_20_skippable} Allora è vero? Lei è...{end_wait}"

