msgid "08367"
msgstr ""
"Bueno, no... En realidad\n"
"es más que eso.{end_wait}"

msgctxt "message"
msgid "08368"
msgstr "¿Qué más está involucrado?{end_wait}"

msgctxt "message"
msgid "08369"
msgstr ""
"Los guerreros compiten\n"
"para llegar aquí antes\n"
"y coger el mejor objeto.{end_wait}"

msgctxt "message"
msgid "08370"
msgstr ""
"Así que hay ventaja\n"
"para quien llegue primero.\n"
"¡Menudo desafío!{end_wait}"

msgctxt "message"
msgid "08371"
msgstr ""
"Es demasiado para {actor_name:1}.\n"
"Tenemos que ayudarle en lo\n"
"que podamos...{end_wait}"

msgctxt "message"
msgid "08372"
msgstr ""
"Mmm, ¿no quieres oír\n"
