msgctxt "message"
msgid "07690"
msgstr "Chi proteggerà la{line_break}nave dai mostri{line_break}marini?{end_wait}"

msgctxt "message"
msgid "07691"
msgstr "Io, Ouranos, e{line_break}Sean sul{line_break}ponte e...{end_wait}"

msgctxt "message"
msgid "07692"
