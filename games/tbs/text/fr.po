"j'avais su..."

#, alchemy-end-wait
msgctxt "message"
msgid "09237"
msgstr ""
"Qui se faufilerait\n"
"sans raison dans un\n"
"lieu aussi dangereux?"

#, alchemy-end-wait
msgctxt "MsgLunpaWontTellAnyone"
msgid "09238"
msgstr ""
"Je ne le raconterai à\n"
"personne, mais vous\n"
"devriez partir avant{page_break}"
