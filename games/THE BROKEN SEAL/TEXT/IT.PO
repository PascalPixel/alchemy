msgctxt "message"
msgid "09493"
msgstr "Scommetto che non{line_break}potevi aprire il{line_break}cancello in nessun modo.{end_wait}"

msgctxt "message"
msgid "09494"
msgstr "Ma poi, improvvisamente,{line_break}si è mosso. E mi sono{line_break}nascosto dietro ad un masso.{end_wait}"

msgctxt "message"
msgid "09495"
msgstr "Ti abbiamo spaventato,{line_break}vero, Bunza?{end_wait}"

msgctxt "message"
msgid "09496"
msgstr "Ciò che importa è{line_break}che Hammet sia{line_break}sano e salvo!{end_wait}"

msgctxt "message"
msgid "09497"
msgstr "Perché dici così,{line_break}Bunza?{end_wait}"

msgctxt "message"
msgid "09498"
msgstr "Gli scagnozzi di Dodonpa{line_break}stanno perlustrando l'area!{end_wait}"

msgctxt "message"
msgid "09499"
msgstr "Non stanno cercando Hammet,{line_break}ma se lo trovano...{end_wait}"

msgctxt "message"
msgid "09500"
