"no es el comienzo.{page_break}"
"El verdadero comienzo está\n"
"en antiguos pasadizos\n"
"de tierras lejanas.{end_wait}"

msgctxt "message"
msgid "09829"
msgstr "="

msgctxt "message"
msgid "09830"
msgstr "="

msgctxt "message"
msgid "09831"
msgstr "="

msgctxt "message"
msgid "09832"
msgstr "="

msgctxt "message"
msgid "09833"
