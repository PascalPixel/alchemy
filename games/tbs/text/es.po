msgctxt "message"
msgid "10542"
msgstr ""
"¡¡Increíble!!\n"
"¿Quieres luchar contra\n"
"el próximo monstruo?{end_now}"

msgctxt "message"
msgid "10543"
msgstr ""
"¡¡Increíble!! ¡El próximo\n"
"monstruo está más allá de\n"
"lo que puedas imaginar!{page_break}"
"Te enfrentarás a él,\n"
"¿verdad?{end_now}"

msgctxt "MsgLobbyCantWaitLets"
msgid "10544"
msgstr ""
"¡Qué ganas, {actor_name:1}!\n"
"¡Vamos a por ellos!{end_wait}"

msgctxt "message"
msgid "10545"
