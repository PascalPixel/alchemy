msgctxt "MsgContigo01"
msgid "05454"
msgstr ""
"Hé, toi, tu veux\n"
"tenter ta chance\n"
"aux dés?{page_break}"
"C'est {argument_signed_number} pièce{control:13}\n"
"la partie.{end_now}"

msgctxt "message"
msgid "05455"
msgstr ""
"OK! Prends\n"
"les dés.{end_wait}"

msgctxt "message"
msgid "05456"
msgstr ""
"Non? Oh, bien.\n"
"Qui est le suivant?{end_wait}"

msgctxt "MsgContigo02"
msgid "05457"
msgstr ""
"Lis la pancarte si tu ne\n"
"connais pas les règles.{end_wait}"

msgctxt "MsgContigo03"
msgid "05458"
msgstr ""
"Hé! T'as pas assez de\n"
"pièces! Il faut payer\n"
"pour jouer.{end_wait}"

msgctxt "MsgContigo04"
msgid "05459"
msgstr ""
"{argument_signed_number} pièce{control:13}!\n"
"Tu parles d'un veinard!{end_wait}"

msgctxt "MsgContigo05"
msgid "05460"
msgstr ""
"T'as perdu {argument_signed_number} pièce{control:13}.\n"
"Reviens tenter ta chance.{end_wait}"

msgctxt "MsgContigo06"
msgid "05461"
msgstr "Dés du destin{page_break}"

msgctxt "message"
msgid "05462"
msgstr ""
"Lance les dés sur\n"
"la table et essaie\n"
"d'avoir des paires.{page_break}"

msgctxt "message"
msgid "05463"
msgstr ""
"Les prix dépendent des\n"
"chiffres et de l'endroit\n"
"où s'arrêtent les dés.{page_break}"

msgctxt "message"
msgid "05464"
msgstr ""
"Plus les nombres\n"
"sont identiques,\n"
"plus tu gagnes.{end_wait}"

msgctxt "MsgContigo07"
msgid "05465"
msgstr "Dés du destin{page_break}"

msgctxt "message"
msgid "05466"
msgstr ""
"Si les chiffres sur\n"
"les dés ou la table\n"
"sont identiques...{page_break}"

msgctxt "message"
msgid "05467"
msgstr ""
"c'est une paire et\n"
"tu ne perds ni ne\n"
"gagnes rien.{page_break}"

msgctxt "message"
msgid "05468"
msgstr ""
"Deux paires, tu doubles\n"
"ta mise. Brelan, tu\n"
"triples ta mise.{page_break}"

msgctxt "message"
msgid "05469"
msgstr ""
"Quatre nombres identiques,\n"
"c'est un sans faute. Tu\n"
"rafles cinq fois la mise.{page_break}"

msgctxt "message"
msgid "05470"
msgstr ""
"En plus, si tes dés\n"
"atterrissent sur le\n"
"coin bonus de la{page_break}"
"table, tu gagnes\n"
"un bonus encore\n"
"plus gros!{end_wait}"

msgctxt "message"
msgid "05471"
msgstr ""
"T'as gagné {argument_signed_number} pièce{control:13}!\n"
"Sacré veinard!{end_wait}"

msgctxt "message"
msgid "05472"
msgstr ""
"T'as perdu {argument_signed_number} pièce{control:13}.\n"
"T'as pas eu de chance.{end_wait}"

msgctxt "message"
msgid "05473"
msgstr ""
"C'est la première fois\n"
"que tu joues aux\n"
"Dés du destin?{end_now}"

msgctxt "message"
msgid "05474"
msgstr ""
"Une fois que tu auras\n"
"commencé, tu ne\n"
"t'arrêteras plus!{page_break}"
"Il n'y a aucun jeu\n"
"qui soit aussi accrocheur\n"
"que celui-là.{end_wait}"

msgctxt "message"
msgid "05475"
msgstr ""
"Les Dés du destin font\n"
"fureur à Tolbi. On peut\n"
"y jouer toute l'année.{end_wait}"

msgctxt "message"
msgid "05476"
msgstr ""
"Waouh! Trois chiffres\n"
"identiques! C'est balèze!{end_wait}"

msgctxt "message"
msgid "05477"
msgstr ""
"Je ne veux pas arrêter\n"
"de jouer aux Dés du destin,\n"
"mais je suis ruinée!{end_wait}"

msgctxt "MsgContigo08"
msgid "05478"
msgstr ""
"La victoire dépend\n"
"uniquement de la chance.\n"
"Je ne triche pas.{end_wait}"

msgctxt "MsgContigo09"
msgid "05479"
msgstr ""
"Les règles des Dés du\n"
"destin sont simples.{page_break}"
"Tu peux même les\n"
"apprendre en jouant.{end_wait}"

msgctxt "message"
msgid "05480"
msgstr ""
"Quelque fois, les gens\n"
"qui n'y ont jamais joué\n"
"gagnent le plus.{page_break}"
"On appelle ça la\n"
"chance du débutant.{end_wait}"

msgctxt "message"
msgid "05481"
msgstr ""
"Réfléchir ne te fera\n"
"pas gagner plus.\n"
"A chaque fois que{page_break}"
"j'essaie de réfléchir,\n"
"je perds. Peut-être\n"
"que je pense trop.{end_wait}"

msgctxt "message"
msgid "05482"
msgstr ""
"J'ai épuisé mes\n"
"réserves de chance. Je\n"
"devrais arrêter de jouer.{end_wait}"

msgctxt "MsgContigo10"
msgid "05483"
msgstr ""
"Avance et tente ta\n"
"chance au Jackpot\n"
"du destin!{end_wait}"

msgctxt "message"
msgid "05484"
msgstr ""
"Tu dois avoir des\n"
"tickets pour jouer.{end_wait}"

msgctxt "message"
msgid "05485"
msgstr ""
"Tu as {argument_signed_number}\n"
"ticket{control:13} de jeu,\n"
"{protagonist_name}.{page_break}"
"Veux-tu t'en\n"
"servir?{end_now}"

msgctxt "MsgContigo11"
msgid "05486"
msgstr ""
"Les règles sont écrites\n"
"sur la pancarte. Lis-les\n"
"attentivement.{end_wait}"

msgctxt "message"
msgid "05487"
msgstr ""
"Tu ne peux plus rien\n"
"porter. Es-tu certain\n"
"de vouloir jouer?{end_now}"

msgctxt "message"
msgid "05488"
msgstr ""
"Si tu as trop d'objets,\n"
"tu ne pourras pas\n"
"emporter ton lot.{page_break}"
"Tu es d'accord?{end_now}"

msgctxt "MsgContigo12"
msgid "05489"
msgstr ""
"Alors débarrasse-toi\n"
"de quelques objets et\n"
"reviens ici.{end_wait}"

msgctxt "MsgContigo13"
msgid "05490"
msgstr ""
"Approche et amuse-toi\n"
"comme un fou.{end_wait}"

msgctxt "message"
msgid "05491"
msgstr ""
"Combien de tickets\n"
"veux-tu utiliser?{end_wait}"

msgctxt "message"
msgid "05492"
msgstr "Veux-tu vraiment arrêter?{end_now}"

msgctxt "message"
msgid "05493"
msgstr ""
"Commençons la\n"
"manche {argument_signed_number}.{end_wait}"

msgctxt "MsgContigo14"
msgid "05494"
msgstr "Félicitations!{end_wait}"

msgctxt "MsgContigo15"
msgid "05495"
msgstr ""
"Tu as gagné: {argument_item_name:1}!\n"
"Bravo!{end_wait}"

msgctxt "MsgContigo16"
msgid "05496"
msgstr ""
"Et tu as gagné:\n"
"{argument_item_name:1}!\n"
"Bravo!{end_wait}"

msgctxt "MsgContigo17"
msgid "05497"
msgstr "Reviens bientôt!{end_wait}"

msgctxt "MsgContigo18"
msgid "05498"
msgstr ""
"Dommage...\n"
"Reviens quand tu auras\n"
"gagné quelques tickets.{end_wait}"

msgctxt "MsgContigo19"
msgid "05499"
msgstr ""
"Dommage...{page_break}"
"Veux-tu utiliser\n"
"tes tickets pour\n"
"continuer à jouer?{end_now}"

msgctxt "MsgContigo20"
msgid "05500"
msgstr "Règles du Jackpot du destin.{page_break}"

msgctxt "message"
msgid "05501"
msgstr ""
"Tire le levier et\n"
"aligne des icônes\n"
"identiques pour gagner.{page_break}"

msgctxt "message"
msgid "05502"
msgstr ""
"Tu as droit à 5 essais\n"
"pour réussir.{page_break}"

msgctxt "message"
msgid "05503"
msgstr ""
"Appuie sur l'étoile\n"
"pour bloquer une roue.{page_break}"

msgctxt "message"
msgid "05504"
msgstr ""
"Tu as une ligne pour\n"
"1 ticket de jeu,\n"
"3 lignes pour 2 tickets,{page_break}"

msgctxt "message"
msgid "05505"
msgstr ""
"5 lignes pour 3 tickets,\n"
"7 lignes pour 4 tickets.{page_break}"
"Utilise tous tes\n"
"tickets sur le\n"
"Jackpot du destin!{end_wait}"

msgctxt "MsgContigo21"
msgid "05506"
msgstr "Lots du Jackpot du destin{page_break}"

msgctxt "message"
msgid "05507"
msgstr ""
"Les lots dépendent des\n"
"icônes que vous alignez.{page_break}"

msgctxt "message"
msgid "05508"
msgstr ""
"Chemises pour des chemises,\n"
"Anneaux pour des anneaux,\n"
"Bottes pour des bottes,{page_break}"

msgctxt "message"
msgid "05509"
msgstr ""
"Etoiles et C¾urs donnent\n"
"divers objets...{page_break}"

msgctxt "message"
msgid "05510"
msgstr ""
"Lunes donnent\n"
"n'importe quel type de lot.{end_wait}"

msgctxt "message"
msgid "05511"
msgstr ""
"Voulez-vous essayer la\n"
"fontaine de Tolbi?{end_now}"

msgctxt "MsgWhatWillYou"
msgid "05512"
msgstr "Qu'allez-vous lancer?{end_now}"

msgctxt "message"
msgid "05513"
msgstr "Vous n'avez pas de pièce!{end_wait}"

msgctxt "message"
msgid "05514"
msgstr "Plus de porte-bonheur!{end_wait}"

msgctxt "MsgYouWonCoin"
msgid "05515"
msgstr ""
"Vous avez gagné\n"
"{argument_signed_number} pièce{control:13}!{end_wait}"

msgctxt "message"
msgid "05516"
msgstr ""
"Votre inventaire est plein.\n"
"Continuer à jouer?{end_now}"

msgctxt "message"
msgid "05517"
msgstr "{protagonist_name} a abandonné!{end_wait}"

msgctxt "MsgCoins2"
msgid "05518"
msgstr "Pièces"

msgctxt "message"
msgid "05519"
msgstr "Porte-bonheur"

msgctxt "message"
msgid "05520"
msgstr "#"

msgctxt "MsgToss2"
msgid "05521"
msgstr "{button_icon:1} Lancer"

msgctxt "message"
msgid "05522"
msgstr "{button_icon:2} Quitter"

msgctxt "message"
msgid "05523"
msgstr ""
"Ça me stresse de lancer\n"
"la pièce en arrière. Ah, si\n"
"je pouvais me retourner...{end_wait}"

msgctxt "message"
msgid "05524"
msgstr ""
"Pourquoi personne ne me\n"
"donne de porte-bonheur?{end_wait}"

msgctxt "message"
msgid "05525"
msgstr ""
"C'est un porte-bonheur!\n"
"Ça me laisse plus de\n"
"marge d'erreur...{page_break}"
"J'ai besoin de toute la\n"
"chance que je peux avoir.{end_wait}"

msgctxt "MsgContigo22"
msgid "05526"
msgstr ""
"Hum... Je me demande si\n"
"ces gamins prendront les\n"
"meilleurs objets...{end_wait}"

msgctxt "MsgContigo23"
msgid "05527"
msgstr ""
"Bienvenue! Avance et\n"
"tente ta chance aux\n"
"Dés de la fortune!{end_now}"

msgctxt "message"
msgid "05528"
msgstr "Vas-y, fais rouler!{end_wait}"

msgctxt "message"
msgid "05529"
msgstr ""
"Oh, vraiment?\n"
"Dommage!{end_wait}"

msgctxt "MsgContigo24"
msgid "05530"
msgstr ""
"Tu peux lire les\n"
"règles du jeu sur\n"
"la pancarte.{end_wait}"

msgctxt "MsgContigo25"
msgid "05531"
msgstr ""
"Dés de la fortune\n"
"Règles du jeu.{page_break}"

msgctxt "message"
msgid "05532"
msgstr ""
"Lance les 4 dés\n"
"sur la table, en\n"
"même temps.{page_break}"

msgctxt "message"
msgid "05533"
msgstr ""
"Si tu obtiens une\n"
"paire, tu empoches\n"
"ta mise.{page_break}"

msgctxt "message"
msgid "05534"
msgstr ""
"Un brelan te permet\n"
"de remporter deux\n"
"fois la mise.{page_break}"

msgctxt "message"
msgid "05535"
msgstr ""
"Avec deux paires,\n"
"tu gagnes trois\n"
"fois la mise.{page_break}"

msgctxt "message"
msgid "05536"
msgstr ""
"Si les 4 dés affichent\n"
"le même chiffre, tu\n"
"gagnes 8 fois la mise!{page_break}"

msgctxt "message"
msgid "05537"
msgstr ""
"Avec une paire, deux paires,\n"
"un brelan ou un 4 parfait,\n"
"joue au Plus-moins!{page_break}"

msgctxt "message"
msgid "05538"
msgstr ""
"Devine si le prochain total\n"
"est supérieur ou inférieur\n"
"au total actuel de tes dés.{page_break}"

msgctxt "message"
msgid "05539"
msgstr ""
"Si tu gagnes au Plus-moins,\n"
"tu doubles tes gains. Cinq\n"
"lancers sont permis.{end_wait}"

msgctxt "MsgContigo26"
msgid "05540"
msgstr ""
"Hé, as-tu déjà joué\n"
"aux Dés de la fortune?{end_now}"

msgctxt "message"
msgid "05541"
msgstr ""
"Mais tu n'as jamais\n"
"gagné, pas vrai? C'est\n"
"écrit dans tes yeux.{end_wait}"

msgctxt "message"
msgid "05542"
msgstr ""
"C'est un jeu simple,\n"
"mais passionnant.{end_wait}"

msgctxt "MsgContigo27"
msgid "05543"
msgstr ""
"Si tu perds au Plus-moins,\n"
"tu perds tout. Il faut donc\n"
"connaître ses limites!{end_wait}"

msgctxt "MsgContigo28"
msgid "05544"
msgstr ""
"J'obtiens toujours une\n"
"paire, mais je perds tout\n"
"au jeu du Plus-moins!{end_wait}"

msgctxt "MsgContigo29"
msgid "05545"
msgstr ""
"Quand ils perdent, je triche.\n"
"Quand ils gagnent, ils sont\n"
"doués. Mais c'est de la chance!{end_wait}"

msgctxt "MsgContigo30"
msgid "05546"
msgstr ""
"Avec un peu de\n"
"pratique, tu trouveras\n"
"ce jeu très simple...{end_wait}"

msgctxt "MsgContigo31"
msgid "05547"
msgstr ""
"Cet enfant sent la\n"
"poisse à plein nez.{page_break}"
"La malchance est\n"
"contagieuse... Pourvu\n"
"qu'il ne me ruine pas.{end_wait}"

msgctxt "MsgContigo32"
msgid "05548"
msgstr ""
"C'est difficile de savoir\n"
"quand se retirer du jeu\n"
"pour limiter les dégâts.{end_wait}"

msgctxt "MsgContigo33"
msgid "05549"
msgstr ""
"Je peux gagner, je peux\n"
"gagner... Je vais perdre...{end_wait}"

msgctxt "MsgContigo34"
msgid "05550"
msgstr ""
"Désolé mon vieux, mais\n"
"il te faut plus de pièces.{end_wait}"

msgctxt "MsgTheLinkWas"
msgid "05551"
msgstr ""
"La connexion a été\n"
"interrompue.{end_wait}"

msgctxt "MsgAwaitingYourOpponent"
msgid "05552"
msgstr "En attente...{end_now}"

msgctxt "MsgNoteYouCan"
msgid "05553"
msgstr ""
"Note: vous ne pouvez pas\n"
"utiliser la fonction\n"
"veille pendant des duels!{end_wait}"

msgctxt "message"
msgid "05554"
msgstr "Sauvegarde résultats.{end_now}"

msgctxt "MsgBattleResultsWere"
msgid "05555"
msgstr "Résultats sauvegardés.{end_wait}"

msgctxt "message"
msgid "05556"
msgstr ""
"Sauvegarde résultats\n"
"Arène des monstres.{end_now}"

msgctxt "MsgMonsterBattleResults"
msgid "05557"
msgstr ""
"Résultats Arène des\n"
"monstres sauvegardés.{end_wait}"

msgctxt "MsgIfYouWantToParticipate"
msgid "05558"
msgstr ""
"Si vous voulez participer,\n"
"veuillez prendre place\n"
"dans le cercle!{end_wait}"

msgctxt "MsgWelcomeToBattle"
msgid "05559"
msgstr ""
"Bienvenue dans l'Arène!\n"
"Ici se retrouvent les\n"
"vrais combattants!{page_break}"
"Testez vos capacités\n"
"lors de duels en Link\n"
"et lors de combats{page_break}"
"dans l'Arène des\n"
"monstres!{page_break}"
"Parlez à la demoiselle\n"
"au comptoir si vous\n"
"voulez vous battre!{end_wait}"

msgctxt "MsgPleaseSpeakTo"
msgid "05560"
msgstr ""
"Veuillez me prévenir\n"
"si vous voulez combattre\n"
"dans l'arène.{end_wait}"

msgctxt "message"
msgid "05561"
msgstr "Voulez-vous participer?{end_now}"

msgctxt "message"
msgid "05562"
msgstr ""
"Votre adversaire vous\n"
"a défié.{page_break}"
"Relevez-vous le défi?{end_now}"

msgctxt "message"
msgid "05563"
msgstr ""
"Quand vous aurez fini vos\n"
"préparatifs, placez-vous\n"
"dans le cercle!{end_wait}"

msgctxt "message"
msgid "05564"
msgstr ""
"Vous avez lancé un\n"
"défi.{page_break}"
"Nous vous préviendrons si\n"
"votre adversaire accepte.\n"
"Veuillez patienter.{end_wait}"

msgctxt "message"
msgid "05565"
msgstr ""
"Vous n'avez pas\n"
"d'adversaire. Voulez-vous\n"
"combattre un monstre?{end_now}"

msgctxt "message"
msgid "05566"
msgstr ""
"Dans ce cas, veuillez\n"
"attendre l'arrivée de\n"
"votre adversaire.{end_wait}"

msgctxt "message"
msgid "05567"
msgstr ""
"Placez-vous dans le cercle\n"
"quand vous aurez fini vos\n"
"préparatifs!{end_wait}"

msgctxt "message"
msgid "05568"
msgstr ""
"Le monstre est prêt.{page_break}"
"Placez-vous dans le\n"
"cercle une fois vos\n"
"préparatifs terminés.{end_wait}"

msgctxt "MsgYouWonBattlePlease"
msgid "05569"
msgstr ""
"Vous avez gagné\n"
"{argument_signed_number} combat{control:13}.{page_break}"
"Prévenez-moi si vous\n"
"voulez combattre\n"
"à nouveau.{end_wait}"

msgctxt "MsgYouWonBattleI"
msgid "05570"
msgstr ""
"Vous avez gagné\n"
"{argument_signed_number} combat{control:13}.{page_break}"
"Je vous avais prévenus\n"
