"Pero sobrevivir a una\n"
"mar tan agitada tiene\n"
"que ser muy difícil.{end_wait}"

msgctxt "MsgLaliveroAfterEverythingThatsHappenedLaliveroNo"
msgid "10413"
msgstr ""
"Después de lo sucedido,\n"
"Lalivero no volverá a\n"
"sentirse segura nunca más.{end_wait}"

msgctxt "MsgLaliveroVenusLighthouseHasBeenTheSymbol"
msgid "10414"
