#, alchemy-end-wait
msgctxt "MsgLunpaMoment"
msgid "09460"
msgstr "Un instant!"

#, alchemy-end-wait
msgctxt "message"
msgid "09461"
msgstr "C'est toi, Bunza?"

#, alchemy-end-wait
msgctxt "message"
msgid "09462"
msgstr "Cette voix!"

#, alchemy-end-wait
msgctxt "message"
msgid "09463"
msgstr "C'est Hammet!"

#, alchemy-end-wait
msgctxt "MsgLunpaDodonpaNeverIntention"
msgid "09464"
msgstr ""
"Alors Dodonpa n'avait pas\n"
