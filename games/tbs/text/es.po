msgctxt "message"
msgid "10499"
msgstr "Venid por aquí.{end_wait}"

msgctxt "message"
msgid "10500"
msgstr "{actor_name:5}... {actor_name:7}...{end_now}"

msgctxt "message"
msgid "10501"
msgstr "¡{actor_name:5}! ¡{actor_name:7}!{end_now}"

msgctxt "message"
msgid "10502"
msgstr "Están... {pause_20_skippable}están vivos.{end_wait}"

msgctxt "message"
msgid "10503"
