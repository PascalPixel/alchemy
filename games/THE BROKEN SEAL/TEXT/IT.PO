msgctxt "message"
msgid "07492"
msgstr "Beh, se non salpiamo{line_break}ora, quando{line_break}mai partiremo?{end_wait}"

msgctxt "message"
msgid "07493"
msgstr "Beh...{pause_20_skippable} non è davvero{line_break}facile dirlo...{end_wait}"

msgctxt "message"
msgid "07494"
msgstr "È una domanda a cui{line_break}non potresti rispondere?{end_wait}"

msgctxt "message"
msgid "07495"
