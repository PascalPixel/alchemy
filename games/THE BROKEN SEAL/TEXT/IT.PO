msgctxt "message"
msgid "03670"
msgstr "Ehi! {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "03671"
msgstr "*Ah* {pause_20_skippable}*Ah*{end_wait}"

msgctxt "message"
msgid "03672"
