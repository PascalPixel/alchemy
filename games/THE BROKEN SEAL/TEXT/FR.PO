msgctxt "message"
msgid "08768"
msgstr "Désolé, mais il y a{line_break}certaines règles qu'on{line_break}se doit de respecter.{page_break}Les guerriers participant{line_break}aux finales et leurs{line_break}équipiers n'ont pas le{page_break}droit de jouer.{end_wait}"

msgctxt "message"
msgid "08769"
