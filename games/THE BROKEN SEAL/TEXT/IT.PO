msgctxt "message"
msgid "07760"
msgstr "Ehi, tutto apposto?{end_wait}"

msgctxt "message"
msgid "07761"
msgstr "Pare che vi siate occupati{line_break}di quei mostri.{end_wait}"

msgctxt "message"
msgid "07762"
msgstr "Abbiamo perso un rematore!{end_wait}"

msgctxt "message"
msgid "07763"
msgstr "Oh no!{pause_20_skippable} Ha perso conoscenza!{end_wait}"

msgctxt "message"
msgid "07764"
msgstr "Pare che i mostri marini{line_break}si siano presi{line_break}uno dei nostri rematori...{end_wait}"

msgctxt "message"
msgid "07765"
msgstr "Non c'è altra{line_break}soluzione...{page_break}{actor_name:1}{pause_20_skippable}, vai a chiedere{line_break}ad uno dei passeggeri di{line_break}remare, va bene?{end_now}"

msgctxt "message"
msgid "07766"
msgstr "Sbrigati!{end_wait}"

msgctxt "message"
msgid "07767"
msgstr "So che non vorresti{line_break}farlo, ma l'avevi{line_break}promesso...{end_wait}"

msgctxt "message"
msgid "07768"
msgstr "Vai a chiedere ad un{line_break}passeggero di aiutarci.{end_wait}"

msgctxt "message"
msgid "07769"
