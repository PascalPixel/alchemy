msgctxt "message"
msgid "07496"
msgstr "Andiamo?{pause_20_skippable} Dove?{end_wait}"

msgctxt "message"
msgid "07497"
msgstr "Nella cabina del{line_break}capitano, e dove{line_break}sennò?{end_wait}"

