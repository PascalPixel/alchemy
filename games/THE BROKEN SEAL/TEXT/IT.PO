msgctxt "message"
msgid "03595"
msgstr "Liberati di qualche{line_break}strumento e poi{line_break}torna qui.{end_wait}"

msgctxt "message"
msgid "03596"
msgstr "Salta su e{line_break}divertiti!{end_wait}"

msgctxt "message"
msgid "03597"
msgstr "Decidi quanti{line_break}biglietti usare.{end_wait}"

msgctxt "message"
msgid "03598"
msgstr "Sei pronto per uscire?{end_now}"

msgctxt "message"
msgid "03599"
msgstr "Sta per iniziare il{line_break}round {argument_signed_number}.{end_wait}"

msgctxt "message"
msgid "03600"
msgstr "Congratulazioni!{end_wait}"

msgctxt "message"
msgid "03601"
msgstr "Hai vinto {argument_item_name:1}!{line_break}Ecco a te!{end_wait}"

msgctxt "message"
msgid "03602"
msgstr "Tu hai vinto{line_break}{argument_item_name:1}!{line_break}Ecco qui.{end_wait}"

msgctxt "message"
msgid "03603"
msgstr "Torna a trovarci!{end_wait}"

msgctxt "message"
msgid "03604"
msgstr "Male...{line_break}Procurati i biglietti{line_break}e poi torna qui.{end_wait}"

msgctxt "message"
msgid "03605"
msgstr "Peccato...{page_break}Vuoi usare altri{line_break}biglietti e{line_break}continuare?{end_now}"

msgctxt "message"
msgid "03606"
msgstr "Ruote della fortuna{page_break}Tira la leva e allinea{line_break}i simboli per vincere{line_break}molte monete.{page_break}Puoi tirare la leva{line_break}per cinque volte.{page_break}Premendo la stella,{line_break}bloccherai la ruota{line_break}corrispondente.{page_break}Con 1 biglietto giochi{line_break}su 1 riga, con 2 giochi{line_break}su 3 righe, con 3{page_break}giochi su 5 righe e con{line_break}4 biglietti hai 7 righe.{page_break}Punta i tuoi biglietti{line_break}sulle Ruote della{line_break}fortuna!{end_wait}"

msgctxt "message"
msgid "03607"
msgstr "I premi dipendono{line_break}dalle combinazioni.{page_break}Con le camicie vinci{line_break}camicie, con gli anelli{line_break}anelli, con gli stivali{page_break}stivali; con stelle e cuori{line_break}vinci strumenti, con le{line_break}lune qualsiasi cosa.{end_wait}"

msgctxt "message"
msgid "03608"
msgstr "Girato di spalle, tira{line_break}una moneta nella{line_break}Fontana di Tolbi.{page_break}Se hai fortuna, potrà{line_break}succedere qualcosa{line_break}di bello!{end_wait}"

msgctxt "message"
msgid "03609"
msgstr "Se tiri una Medaglia{line_break}gioco e hai davvero{line_break}molta fortuna, potrai{page_break}vincere un premio{line_break}maggiore di quello che{line_break}avresti con una moneta.{end_wait}"

msgctxt "message"
msgid "03610"
msgstr "La Fontana di Tolbi ha{line_break}dei poteri misteriosi.{page_break}Prova a tirare una{line_break}moneta nella fontana{line_break}girandoti di spalle!{end_wait}"

msgctxt "message"
msgid "03611"
msgstr "Hai una Medaglia{line_break}gioco?{end_now}"

msgctxt "message"
msgid "03612"
msgstr "Ehi.{pause_20_skippable}.{pause_20_skippable}. che fortuna!{page_break}Beh, sarai ancora più{line_break}fortunato se la tirerai{line_break}nella fontana!{end_wait}"

msgctxt "message"
msgid "03613"
msgstr "Beh... Se volessi tentare{line_break}la sorte, userei una{line_break}Medaglia gioco.{end_wait}"

msgctxt "message"
msgid "03614"
msgstr "Che peccato, ho solo{line_break}una Medaglia gioco!{page_break}Non voglio giocarmela,{line_break}altrimenti resto{line_break}senza...{end_wait}"

msgctxt "message"
msgid "03615"
