#, alchemy-end-wait
msgctxt "message"
msgid "06488"
msgstr ""
"I don't believe it!\n"
"Was that a°"

#, alchemy-end-wait
msgctxt "message"
msgid "06489"
msgstr ""
"A what? Kraden, do you\n"
