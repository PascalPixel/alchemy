msgctxt "message"
msgid "07746"
msgstr "{text_effect:4}Ehi{pause_20_skippable},{actor_name:1},{line_break}non dovremmo andare un{line_break}po' più velocemente?{end_wait}"

msgctxt "message"
msgid "07747"
