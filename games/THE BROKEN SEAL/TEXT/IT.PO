msgctxt "message"
msgid "09501"
msgstr "Ma dobbiamo fuggire senza{line_break}essere visti dagli scagnozzi{line_break}di Dodonpa...{end_wait}"

msgctxt "message"
msgid "09502"
msgstr "Che dobbiamo fare,{line_break}{actor_name:1}? Stiamo{line_break}qui e li affrontiamo?{end_now}"

msgctxt "message"
msgid "09503"
msgstr "Salvare Hammet dalla{line_break}fortezza è stato{line_break}già abbastanza pericoloso...{end_wait}"

msgctxt "message"
msgid "09504"
msgstr "E adesso, affrontarli{line_break}qui sarebbe ancora{line_break}più azzardato.{end_wait}"

msgctxt "message"
msgid "09505"
msgstr "E allora cosa dobbiamo{line_break}fare, Bunza?{end_wait}"

msgctxt "message"
msgid "09506"
