msgctxt "MsgContigo01"
msgid "05497"
msgstr ""
"Hey, Kumpel, willst\n"
"du dein Glück beim{page_break}"
"Würfeln versuchen?{page_break}"
"Ein Spiel kostet\n"
"{argument_signed_number} {control:13}{end_wait}.{end_now}"

msgctxt "message"
msgid "05498"
msgstr ""
"O.K.! Dann greif\n"
"zu den Würfeln.{end_wait}"

msgctxt "message"
msgid "05499"
msgstr ""
"Nein? Na gut.\n"
"Wer ist der Nächste?{end_wait}"

msgctxt "MsgContigo02"
msgid "05500"
msgstr ""
"Falls du die Regeln\n"
"nicht kennst, solltest{page_break}"
"du das Schild lesen.{end_wait}"

msgctxt "MsgContigo03"
msgid "05501"
msgstr ""
"Hey! Du hast nicht\n"
"genug Geld!{page_break}"
"Ohne Moos nix los!{end_wait}"

msgctxt "MsgContigo04"
msgid "05502"
msgstr ""
"Du hast {argument_signed_number} {control:13}{end_wait}\n"
"gewonnen!{page_break}"
"Das nenne ich Glück!{end_wait}"

msgctxt "MsgContigo05"
msgid "05503"
msgstr ""
"Du hast {argument_signed_number} {control:13}{end_wait}\n"
"verloren.{page_break}"
"Vielleicht klappt's\n"
"beim nächsten Mal!{end_wait}"

msgctxt "MsgContigo06"
msgid "05504"
msgstr "Die Glückswürfel{page_break}"

msgctxt "message"
msgid "05505"
msgstr ""
"Wirf die Würfel auf\n"
"den Tisch und versuche,\n"
"die gleichen Zahlen{page_break}"
"zu werfen.{page_break}"

msgctxt "message"
msgid "05506"
msgstr ""
"Der Preis, den du gewinnen\n"
"kannst, hängt davon ab,\n"
"welche Zahlen du{page_break}"
"geworfen hast und wo\n"
"die Würfel gelandet sind.{page_break}"

msgctxt "message"
msgid "05507"
msgstr ""
"Je mehr Zahlen gleich-\n"
"lautend sind, desto mehr\n"
"kannst du gewinnen!{end_wait}"

msgctxt "MsgContigo07"
msgid "05508"
msgstr "Die Glückswürfel{page_break}"

msgctxt "message"
msgid "05509"
msgstr ""
"Wenn zwei Zahlen entweder\n"
"auf den Würfeln oder mit\n"
"jenen am Tisch überein-{page_break}"

msgctxt "message"
msgid "05510"
msgstr ""
"stimmen, nennt man das\n"
"ein Paar. Damit kannst du weder\n"
"gewinnen noch verlieren.{page_break}"

msgctxt "message"
msgid "05511"
msgstr ""
"Zwei Paare verdoppeln\n"
"deinen Einsatz, drei\n"
"verdreifachen ihn.{page_break}"

msgctxt "message"
msgid "05512"
msgstr ""
"Sollten dir die Würfel einen\n"
"Perfekt-Bonus bescheren,{page_break}"
"fällt dein Gewinn sogar\n"
"noch höher aus!{page_break}"

msgctxt "message"
msgid "05513"
msgstr ""
"Sollten deine Würfel auf dem\n"
"Perfekt-Feld landen, fällt\n"
"dein Gewinn noch höher aus!{end_wait}"

msgctxt "message"
msgid "05514"
msgstr ""
"Du hast {argument_signed_number} {control:13}{end_wait}\n"
"gewonnen! Was für ein\n"
"Glück!{end_wait}"

msgctxt "message"
msgid "05515"
msgstr ""
"Du hast {argument_signed_number} {control:13}{end_wait}\n"
"verloren. Mehr Glück\n"
"beim nächsten Mal!{end_wait}"

msgctxt "message"
msgid "05516"
msgstr ""
"Ist das dein erster\n"
"Versuch beim\n"
"Würfelspiel?{end_now}"

msgctxt "message"
msgid "05517"
msgstr ""
"Fängst du erst mal an,\n"
"willst du nie mehr\n"
"aufhören!{page_break}"
"Auf der ganzen Welt\n"
"wirst du kein Spiel\n"
"finden, das dir so{page_break}"
"viel Vergnügen\n"
"bereitet!{end_wait}"

msgctxt "message"
msgid "05518"
msgstr ""
"Der \"Glückswürfel\"\n"
"ist momentan in Tolbi\n"
"DER Renner!{page_break}"
"Du kannst das ganze\n"
"Jahr an den Spielen\n"
"teilnehmen!{end_wait}"

msgctxt "message"
msgid "05519"
msgstr ""
"Wow! Drei gleiche\n"
"Nummern zu würfeln\n"
"ist richtig hart!{end_wait}"

msgctxt "message"
msgid "05520"
msgstr ""
"Ich will nicht auf-\n"
"hören, Glückswürfel zu\n"
"spielen!{page_break}"
"Aber ich habe kein\n"
"Geld mehr!{end_wait}"

msgctxt "MsgContigo08"
msgid "05521"
msgstr ""
"Sieg oder Niederlage -\n"
"alles eine Frage des\n"
"Glücks!{page_break}"
"Ich hau niemanden\n"
"über's Ohr.{end_wait}"

msgctxt "MsgContigo09"
msgid "05522"
msgstr ""
"Die Regeln für die\n"
"Glückswürfel sind\n"
"ganz einfach.{page_break}"
"Du kannst sie sogar\n"
"lernen, während du\n"
"spielst.{end_wait}"

msgctxt "message"
msgid "05523"
msgstr ""
"Manchmal sind es\n"
"gerade die Leute, die\n"
"noch nie gespielt{page_break}"
"haben, die am meisten\n"
"abräumen.{page_break}"
"Das nennt man wohl\n"
"Anfängerglück.{end_wait}"

msgctxt "message"
msgid "05524"
msgstr ""
"Strategie wird dir bei\n"
"diesem Spiel nicht\n"
"helfen.{page_break}"
"Wenn ich darüber nach-\n"
"denke, wie ich die\n"
"Würfel rollen soll,{page_break}"
"verliere ich garantiert.\n"
"Vielleicht denke ich\n"
"einfach zu viel.{end_wait}"

msgctxt "message"
msgid "05525"
msgstr ""
"Mein Glück lässt mich\n"
"im Stich. Ich sollte\n"
"besser aufhören.{end_wait}"

msgctxt "MsgContigo10"
msgid "05526"
msgstr ""
"Komm nur näher und\n"
"versuche dein Glück\n"
"an dieser Maschine.{end_wait}"

msgctxt "message"
msgid "05527"
msgstr ""
"Um hier spielen zu\n"
"können, brauchst du\n"
"Tickets.{end_wait}"

msgctxt "message"
msgid "05528"
msgstr ""
"Du hast {argument_signed_number}\n"
"{control:13}{pause_60}, {protagonist_name}.{page_break}"
"Möchtest du diese\n"
"Tickets einsetzen?{end_now}"

msgctxt "MsgContigo11"
msgid "05529"
msgstr ""
"Die Regeln stehen\n"
"auf dem Schild. Lies\n"
"sie nur!{end_wait}"

msgctxt "message"
msgid "05530"
msgstr ""
"Du hast keinen Platz\n"
"für weitere Items.{page_break}"
"Bist du sicher, dass\n"
"du spielen willst?{end_now}"

msgctxt "message"
msgid "05531"
msgstr ""
"Wenn dein Inventar voll\n"
"ist und du etwas ge-\n"
"winnst,{page_break}"
"kannst du es nicht\n"
"mitnehmen.\n"
"Ist das in Ordnung?{end_now}"

msgctxt "MsgContigo12"
msgid "05532"
msgstr ""
"Dann wirf Ballast\n"
"ab und komm wieder.{end_wait}"

msgctxt "MsgContigo13"
msgid "05533"
msgstr ""
"Komm nur her und hab\n"
"deinen Spaß!{end_wait}"

msgctxt "message"
msgid "05534"
msgstr ""
"Wähle, wie viele\n"
"Tickets du einsetzen\n"
"möchtest.{end_wait}"

msgctxt "message"
msgid "05535"
msgstr ""
"Bist du bereit,\n"
"aufzugeben?{end_now}"

msgctxt "message"
msgid "05536"
msgstr ""
"Beginnen wir mit\n"
"Runde {argument_signed_number}.{end_wait}"

msgctxt "MsgContigo14"
msgid "05537"
msgstr "Ich gratuliere!{end_wait}"

msgctxt "MsgContigo15"
msgid "05538"
msgstr ""
"Dies ist dein Gewinn:\n"
"{argument_item_name:1}!\n"
"Hier, bitte!{end_wait}"

msgctxt "MsgContigo16"
msgid "05539"
msgstr ""
"Und du gewinnst\n"
"{argument_item_name:1}!\n"
"Hier, bitte!{end_wait}"

msgctxt "MsgContigo17"
msgid "05540"
msgstr ""
"Besuche uns bald\n"
"wieder!{end_wait}"

msgctxt "MsgContigo18"
msgid "05541"
msgstr ""
"So ein Pech...\n"
"Komm wieder, wenn du\n"
"ein paar Tickets hast.{end_wait}"

msgctxt "MsgContigo19"
msgid "05542"
msgstr ""
"So ein Pech...{page_break}"
"Möchtest du trotzdem\n"
"deine Tickets nutzen,\n"
"um weiterzuspielen?{end_now}"

msgctxt "MsgContigo20"
msgid "05543"
msgstr "Regeln für Glückswalzen{page_break}"

msgctxt "message"
msgid "05544"
msgstr ""
"Zieh am Hebel und\n"
"versuche, gleiche\n"
"Symbole zu erhalten.{page_break}"

msgctxt "message"
msgid "05545"
msgstr ""
"Du hast nur 5 x die\n"
"Möglichkeit, am Hebel\n"
"zu ziehen.{page_break}"

msgctxt "message"
msgid "05546"
msgstr ""
"Drücke den Stern, um\n"
"eine Walze festzu-\n"
"halten.{page_break}"

msgctxt "message"
msgid "05547"
msgstr ""
"1 Reihe für 1 Ticket,\n"
"3 Reihen für 2 Tickets,{page_break}"

msgctxt "message"
msgid "05548"
msgstr ""
"5 Reihen für 3 Tickets\n"
"und 7 Reihen für 4 Tickets.{page_break}"
"Verwende all deine Tickets\n"
"für die Glückswalzen!{end_wait}"

msgctxt "MsgContigo21"
msgid "05549"
msgstr "Preise an den Glückswalzen{page_break}"

msgctxt "message"
msgid "05550"
msgstr ""
"Die Preise hängen von\n"
"den Symbolen ab, die\n"
"angehalten werden.{page_break}"

msgctxt "message"
msgid "05551"
msgstr ""
"Bei Hemden gewinnst\n"
"du Unterhemden,{page_break}"
"bei Ringen gibt es\n"
"Ringe,{page_break}"
"Stiefel stehen für\n"
"Stiefel,{page_break}"

msgctxt "message"
msgid "05552"
msgstr ""
"Sterne und Herzen\n"
"bringen dir Items{page_break}"

msgctxt "message"
msgid "05553"
msgstr ""
"und bei Monden kann\n"
"es alles Mögliche sein.{end_wait}"

msgctxt "message"
msgid "05554"
msgstr ""
"Möchtest du dein\n"
"Glück am Brunnen von\n"
"Tolbi versuchen?{end_now}"

msgctxt "MsgWhatWillYou"
msgid "05555"
msgstr ""
"Was möchtest du\n"
"werfen?{end_now}"

msgctxt "message"
msgid "05556"
msgstr "Du hast keine Münzen!{end_wait}"

msgctxt "message"
msgid "05557"
msgstr ""
"Du hast keine Glücks-\n"
"medaillen!{end_wait}"

msgctxt "MsgYouWonCoin"
msgid "05558"
msgstr ""
"Du hast {argument_signed_number} {control:13}{end_wait}\n"
"gewonnen!{end_wait}"

msgctxt "message"
msgid "05559"
msgstr ""
"Du hast keinen Platz für\n"
"weitere Items.{page_break}"
"Möchtest du trotzdem\n"
"spielen?{end_now}"

msgctxt "message"
msgid "05560"
msgstr ""
"{protagonist_name} hat\n"
"aufgegeben!{end_wait}"

msgctxt "MsgCoins2"
msgid "05561"
msgstr "Münzen"

msgctxt "message"
msgid "05562"
msgstr "Glücksmed."

msgctxt "message"
msgid "05563"
msgstr "#"

msgctxt "MsgToss2"
msgid "05564"
msgstr "{button_icon:1} Werfen"

msgctxt "message"
msgid "05565"
msgstr "{button_icon:2} Ende"

msgctxt "message"
msgid "05566"
msgstr ""
"Wenn ich Münzen hinter\n"
"mich werfe, werde ich\n"
"nervös.{page_break}"
"Ich wünschte, ich\n"
"könnte mich umdrehen...{end_wait}"

msgctxt "message"
msgid "05567"
msgstr ""
"Warum will mir\n"
"niemand eine Glücks-\n"
"medaille geben?{end_wait}"

msgctxt "message"
msgid "05568"
msgstr ""
"Das hier ist eine\n"
"Glücksmedaille.{page_break}"
"Also ist es nicht so\n"
"schlimm, wenn ich\n"
"ein bisschen{page_break}"
"daneben werfe. Ich\n"
"brauche alles Glück,\n"
"das ich kriegen kann!{end_wait}"

msgctxt "MsgContigo22"
msgid "05569"
msgstr ""
"Hmm... Ich frage mich,\n"
"ob diese Kinder hier\n"
"die besten Items{page_break}"
"wegschnappen werden...{end_wait}"

msgctxt "MsgContigo23"
msgid "05570"
msgstr ""
"Willkommen! Nur hereinspaziert!\n"
"Wie wäre es mit einer Runde\n"
"Super-Glückswürfel?{end_now}"

msgctxt "message"
msgid "05571"
msgstr "Gut, dann lass die Würfel rollen!{end_wait}"

msgctxt "message"
msgid "05572"
msgstr ""
"Ach, ehrlich?\n"
"Was für ein Jammer...{end_wait}"

msgctxt "MsgContigo24"
msgid "05573"
msgstr ""
"Wenn du die Regeln für die\n"
"Super-Glückswürfel lernen\n"
"möchtest,{page_break}"
"dann solltest du einen Blick\n"
"auf das Schild werfen.{end_wait}"

msgctxt "MsgContigo25"
msgid "05574"
msgstr ""
"Super-Glückswürfel\n"
"Die Spielregeln:{page_break}"

msgctxt "message"
msgid "05575"
msgstr ""
"Wirf alle vier Würfel auf\n"
"einmal.{page_break}"

msgctxt "message"
msgid "05576"
msgstr ""
"Zeigen zwei der Würfel die\n"
"gleiche Zahl, ist das ein\n"
"Pasch und du gewinnst{page_break}"
"deinen Einsatz zurück.{page_break}"

msgctxt "message"
msgid "05577"
msgstr ""
"Passen sogar drei Würfel\n"
"zusammen, wird dein Einsatz\n"
"verdoppelt.{page_break}"

msgctxt "message"
msgid "05578"
msgstr ""
"Sind es zwei Paare zahlen-\n"
"gleicher Würfel, gewinnst du\n"
"den dreifachen Einsatz.{page_break}"

msgctxt "message"
msgid "05579"
msgstr ""
"Zeigen alle vier Würfel die\n"
"gleiche Zahl, ist dir ein\n"
"perfekter Wurf gelungen!{page_break}"
"In diesem Fall erhältst du den\n"
"(Trommelwirbel...) ACHT-\n"
"FACHEN Einsatz zurück!{page_break}"

msgctxt "message"
msgid "05580"
msgstr ""
"Gelingt dir ein Pasch, zwei Paare,\n"
"drei Gleiche oder ein perfekter\n"
"Wurf,{page_break}"
"darfst du das Glücksraten\n"
"versuchen!{page_break}"

msgctxt "message"
msgid "05581"
msgstr ""
"Du musst raten, ob der nächste\n"
"Wurf höher oder niedriger als\n"
"der letzte sein wird.{page_break}"

msgctxt "message"
msgid "05582"
msgstr ""
"Rätst du richtig, kannst du\n"
"damit deinen Gewinn\n"
"verdoppeln!{page_break}"
"Du kannst das bis zu\n"
"fünfmal machen.{page_break}"

msgctxt "MsgContigo26"
msgid "05583"
msgstr ""
"Also, Kumpel, sag es mir!\n"
"Hast du schon jemals zuvor\n"
"Super-Glückswürfel gespielt?{end_now}"

msgctxt "message"
msgid "05584"
msgstr ""
"Gut, aber du hast sicher noch\n"
"nie gewonnen. Das sehe ich dir\n"
"doch an der Nasenspitze an!{end_wait}"

msgctxt "message"
msgid "05585"
msgstr ""
"Nun, es mag zwar etwas simpel\n"
"sein, dennoch ist es mein\n"
"Lieblings-Würfelspiel!{end_wait}"

msgctxt "MsgContigo27"
msgid "05586"
msgstr ""
"Verlierst du allerdings das Rate-\n"
"spiel, gewinnst du gar nichts...{page_break}"
"Du musst wissen, wann es\n"
"Zeit ist aufzuhören!{end_wait}"

msgctxt "MsgContigo28"
msgid "05587"
msgstr ""
"Meistens schaffe ich einen\n"
"Pasch, aber dann verliere ich\n"
"alles beim Glücksraten!{end_wait}"

msgctxt "MsgContigo29"
msgid "05588"
msgstr ""
"Verlieren die Leute, bin ich ein\n"
"Schwindler, gewinnen sie, sind\n"
"sie Profis...{page_break}"
"Völliger Schwachsinn!!!\n"
"Alles eine Frage des Glücks!{end_wait}"

msgctxt "MsgContigo30"
msgid "05589"
msgstr ""
"Das Spiel ist nicht schwierig.\n"
"Nicht, wenn du oft genug spielst.\n"
"Du kannst spielend lernen!{end_wait}"

msgctxt "MsgContigo31"
msgid "05590"
msgstr ""
"Diesem Kind steht das Unglück\n"
"ins Gesicht geschrieben.{page_break}"
"Ein Pechvogel reicht, um allen\n"
"den Spaß zu verderben!{page_break}"
"Hoffentlich wirkt sich das\n"
"nicht auf meine Glückssträhne\n"
"aus!{end_wait}"

msgctxt "MsgContigo32"
msgid "05591"
msgstr ""
"Es ist nicht einfach zu ent-\n"
"scheiden, ob man aufhören oder\n"
"weitermachen soll.{end_wait}"

msgctxt "MsgContigo33"
msgid "05592"
msgstr ""
"Ich gewinne, ich gewinne, ich...\n"
"Oh nein! Ich verliere!!!{end_wait}"

msgctxt "MsgContigo34"
msgid "05593"
msgstr ""
"Tut mir Leid, Kumpel. Aber wenn\n"
"du spielen willst, musst du mehr\n"
"Geld aufbringen!{end_wait}"

msgctxt "MsgTheLinkWas"
msgid "05594"
msgstr ""
"Die Verbindung wurde\n"
"unterbrochen.{end_wait}"

msgctxt "MsgAwaitingYourOpponent"
msgid "05595"
msgstr ""
"Wir erwarten deinen\n"
"Gegner...{end_now}"

msgctxt "MsgNoteYouCan"
msgid "05596"
msgstr ""
"Hinweis: Die Funktion\n"
"\"Schlafen\" kann hier\n"
"nicht ausgeführt werden!{end_wait}"

msgctxt "message"
msgid "05597"
msgstr "Resultate werden gespeichert.{end_now}"

msgctxt "MsgBattleResultsWere"
msgid "05598"
msgstr "Resultate wurden gespeichert.{end_wait}"

msgctxt "message"
msgid "05599"
msgstr ""
"Monster-Kampf-Resultate\n"
"werden gespeichert.{end_now}"

msgctxt "MsgMonsterBattleResults"
msgid "05600"
msgstr ""
"Monster-Kampf-Resultate\n"
"wurden gespeichert.{end_wait}"

msgctxt "MsgIfYouWantToParticipate"
msgid "05601"
msgstr ""
"Wenn du teilnehmen willst,\n"
"tritt bitte in den Kreis.{end_wait}"

msgctxt "MsgWelcomeToBattle"
msgid "05602"
msgstr ""
"Willkommen in der Kampf-\n"
"Arena, wo sich Krieger,\n"
"die sich nach einem Kampf{page_break}"
"sehnen, zusammenfinden!\n"
"Beweise dein Geschick\n"
"in Link-Kämpfen und{page_break}"
"Monster-Kämpfen! Sprich\n"
"mit dem Mädchen hinter\n"
"dem Tresen, wenn du dich{page_break}"
"der Herausforderung stellen\n"
"willst!{end_wait}"

msgctxt "MsgPleaseSpeakTo"
msgid "05603"
msgstr ""
"Wenn du an einem Kampf\n"
"teilnehmen willst, wende\n"
"dich bitte an mich.{end_wait}"

msgctxt "message"
msgid "05604"
msgstr "Möchtest du dich anmelden?{end_now}"

msgctxt "message"
msgid "05605"
msgstr ""
"Dein Gegner fordert dich\n"
"heraus. Nimmst du die\n"
"Herausforderung an?{end_now}"

msgctxt "message"
msgid "05606"
msgstr ""
"Wenn du deine Vorbereitungen\n"
"getroffen hast, tritt bitte\n"
"in den Kreis!{end_wait}"

msgctxt "message"
msgid "05607"
msgstr ""
"Du möchtest also kämpfen.{page_break}"
"Bitte warte. Wir werden\n"
"deinen Namen rufen, wenn\n"
"dein Gegner bereit ist.{end_wait}"

msgctxt "message"
msgid "05608"
msgstr ""
"Du hast keinen Gegner.\n"
"Möchtest du gegen ein\n"
"Monster antreten?{end_now}"

msgctxt "message"
msgid "05609"
msgstr ""
"Dann warte bitte, bis\n"
"ein Gegner eingetroffen\n"
"ist.{end_wait}"

msgctxt "message"
msgid "05610"
msgstr ""
"Wenn du deine Vorbereitungen\n"
"getroffen hast, tritt bitte\n"
"in den Kreis!{end_wait}"

msgctxt "message"
msgid "05611"
msgstr ""
"Das Monster ist nun bereit.{page_break}"
"Bitte beende deine\n"
"Vorbereitungen und tritt\n"
"in den Kreis.{end_wait}"

msgctxt "MsgYouWonBattlePlease"
msgid "05612"
msgstr ""
"Gewonnene Kämpfe: {argument_signed_number}{page_break}"
"Wenn du nochmals kämpfen\n"
"willst, wende dich bitte\n"
"an mich.{end_wait}"

msgctxt "MsgYouWonBattleI"
msgid "05613"
msgstr ""
"Gewonnene Kämpfe: {argument_signed_number}{page_break}"
"Ich sagte doch, dass\n"
"unsere Monster nicht\n"
"schlecht sind!{end_wait}"

msgctxt "MsgGoodLuck2"
msgid "05614"
msgstr "Viel Glück!{end_wait}"

msgctxt "MsgYouWonBattle"
msgid "05615"
msgstr ""
"Gewonnene Kämpfe: {argument_signed_number}\n"
"Ein neuer Rekord!{end_wait}"

msgctxt "MsgYourOpponentHas"
msgid "05616"
msgstr ""
"Dein Gegner ist\n"
"eingetroffen!{end_wait}"

msgctxt "MsgNotBadWould"
msgid "05617"
msgstr ""
"Nicht übel! Möchtest du\n"
"gegen das nächste Monster\n"
"antreten?{end_now}"

msgctxt "message"
msgid "05618"
msgstr ""
"Du {text_effect:2}bist{reset_text_style} gut! Möchtest\n"
"du gegen ein stärkeres\n"
"Monster kämpfen?{end_now}"

msgctxt "message"
msgid "05619"
msgstr ""
"Gute Arbeit! Möchtest\n"
"du gegen das nächste\n"
"Monster antreten?{end_now}"

msgctxt "message"
msgid "05620"
msgstr ""
"Du bist stark! Möchtest\n"
"du gegen ein noch stärkeres\n"
"Monster antreten?{end_now}"

msgctxt "message"
msgid "05621"
msgstr ""
"Du {text_effect:2}bist{reset_text_style} gut! Möchtest\n"
"du gegen das nächste\n"
"Monster kämpfen?{end_now}"

msgctxt "message"
msgid "05622"
msgstr ""
"Du bist stark! Möchtest\n"
"du gegen ein noch stärkeres\n"
"Monster antreten?{end_now}"

msgctxt "message"
msgid "05623"
msgstr ""
"Du bist stark! Möchtest\n"
"du gegen das nächste\n"
"Monster kämpfen?{end_now}"

msgctxt "message"
msgid "05624"
msgstr ""
"Du bist sehr stark!{page_break}"
"Möchtest du gegen ein\n"
"sehr starkes Monster\n"
"antreten?{end_now}"

msgctxt "message"
msgid "05625"
msgstr ""
"Du bist sehr stark!\n"
"Möchtest du gegen das\n"
"nächste Monster kämpfen?{end_now}"

msgctxt "message"
msgid "05626"
msgstr ""
"Du bist unglaublich! Möchtest\n"
"du gegen eines der stärksten\n"
"Monster kämpfen?{end_now}"

msgctxt "message"
msgid "05627"
msgstr ""
"Du bist unglaublich! Möchtest\n"
"du gegen das nächste Monster\n"
"kämpfen?{end_now}"

msgctxt "message"
msgid "05628"
msgstr ""
"Du bist erstaunlich!!!{page_break}"
"Möchtest du gegen ein\n"
"überwältigendes Monster\n"
"kämpfen?{end_now}"

msgctxt "message"
msgid "05629"
msgstr ""
"Du bist erstaunlich!!!\n"
"Möchtest du gegen das\n"
"nächste Monster kämpfen?{end_now}"

msgctxt "message"
msgid "05630"
msgstr ""
"Unglaublich!!! Das nächste\n"
"Monster verfügt über Stärke\n"
"jenseits alles Bekannten!{page_break}"
"Du wirst doch kämpfen,\n"
"oder?{end_now}"

msgctxt "message"
msgid "05631"
msgstr ""
"Unglaublich!!! Möchtest\n"
"du gegen das nächste\n"
"Monster kämpfen?{end_now}"

msgctxt "message"
msgid "05632"
msgstr ""
"Unglaublich!!! Das nächste\n"
"Monster verfügt über Stärke\n"
"jenseits alles Bekannten!{page_break}"
"Du wirst doch kämpfen,\n"
"oder?{end_now}"

msgctxt "MsgItSOur"
msgid "05633"
msgstr ""
"Es geht los!\n"
"Vorwärts, {actor_name:5}!{end_wait}"

msgctxt "message"
msgid "05634"
msgstr ""
"Hey, {actor_name:5}, ich bin\n"
"bereit, alles zu geben!{end_wait}"

msgctxt "message"
msgid "05635"
msgstr ""
"Wenn du willst, dass ich kämpfe,\n"
"werde ich es tun. Aber erwarte\n"
"nichts Großartiges von mir.{end_wait}"

msgctxt "message"
msgid "05636"
msgstr "Ich werde tun, was ich kann!{end_wait}"

msgctxt "message"
msgid "05637"
msgstr "?"

msgctxt "message"
msgid "05638"
msgstr ""
"Hey, ich gebe mein Bestes, wenn\n"
"du es auch tust!{end_wait}"

msgctxt "message"
msgid "05639"
msgstr ""
"Machst du einen Rückzieher?\n"
"Ich zeige dir meine Stärke!{end_wait}"

msgctxt "message"
msgid "05640"
msgstr ""
"Also gut, {actor_name:5}, wir\n"
"machen es zusammen!{end_wait}"

msgctxt "MsgOkWeRe"
msgid "05641"
msgstr ""
"Wir sind bereit, {actor_name:5}.\n"
"Aber vergiss nicht, dass du hier\n"
"das Kommando hast, ja?{end_wait}"

msgctxt "message"
msgid "05642"
msgstr ""
"Was? Ich soll Pause machen?\n"
"Warum ausgerechnet ich?{end_wait}"

msgctxt "message"
msgid "05643"
msgstr ""
"Es ist nicht schön, wenn einem\n"
"gesagt wird, dass man zurück-\n"
"bleiben soll...{end_wait}"

msgctxt "message"
msgid "05644"
msgstr ""
"Schön! Ich habe sowieso eine\n"
"kleine Pause nötig.{end_wait}"

msgctxt "message"
msgid "05645"
msgstr "?"

msgctxt "message"
msgid "05646"
msgstr ""
"Gut, dann warte ich hier. Gebt\n"
"euer Bestes und kommt bald\n"
"wieder zurück!{end_wait}"

msgctxt "message"
msgid "05647"
msgstr ""
"Willst du mich nicht mehr in\n"
"deiner Nähe haben, {actor_name:5}?{end_wait}"

msgctxt "message"
msgid "05648"
msgstr ""
"Versuchst du mir etwas zu\n"
"sagen, {actor_name:5}?{end_wait}"

msgctxt "MsgILlFight"
msgid "05649"
msgstr ""
"Meine Kampfkraft wird für\n"
"zwei reichen!{end_wait}"

msgctxt "message"
msgid "05650"
msgstr ""
"Wenn du nicht kämpfen willst,\n"
"dann lass es bleiben! Du würdest\n"
"uns ohnehin nur im Weg stehen!{end_wait}"

msgctxt "message"
msgid "05651"
msgstr ""
"Wie? Niemals!\n"
"Bitte spring für mich ein!{end_wait}"

msgctxt "message"
msgid "05652"
msgstr "Ich werde mein Bestes geben!{end_wait}"

msgctxt "message"
msgid "05653"
msgstr "?"

msgctxt "message"
msgid "05654"
msgstr ""
"Warte! Ich sage, dass ich kämpfen\n"
"möchte und du ziehst den\n"
"Schwanz ein? Was soll das?{end_wait}"

msgctxt "message"
msgid "05655"
msgstr ""
"Viel Glück, {actor_name:5}!\n"
"Wenn du mich brauchst, weißt du,\n"
"wo du mich findest.{end_wait}"

msgctxt "message"
msgid "05656"
msgstr ""
"Also nur ich. Ist das auch in\n"
"Ordnung? Ich bin ein wenig nervös.{end_wait}"

msgctxt "message"
msgid "05657"
msgstr ""
"Es ist mir egal, gegen wen ich\n"
"kämpfe. Ich werde alles geben,\n"
"was ich habe.{end_wait}"

msgctxt "message"
msgid "05658"
msgstr ""
"Ich möchte zu gerne wissen, wem\n"
"ich eins in die Fresse hauen darf!{end_wait}"

msgctxt "message"
msgid "05659"
msgstr ""
"Jetzt, da ich zum Kampf bereit bin,\n"
"macht es mir nichts mehr aus,\n"
"eventuell auch zu verlieren.{end_wait}"

msgctxt "message"
msgid "05660"
msgstr ""
"Ich bin mir nicht sicher, ob meine\n"
"Psynergy und meine Waffen für\n"
"den Kampf ausreichend sind...{end_wait}"

msgctxt "message"
msgid "05661"
msgstr "?"

msgctxt "message"
msgid "05662"
msgstr ""
"Die können in die Arena schicken,\n"
"wen sie wollen! Ich mache sowieso\n"
"alles platt!{end_wait}"

msgctxt "message"
msgid "05663"
msgstr ""
"Ich hoffe, unser Gegner ist richtig\n"
"groß und stark! Ich brauche eine\n"
"Herausforderung.{end_wait}"

msgctxt "message"
msgid "05664"
msgstr ""
"Was auch immer auf uns wartet,\n"
"ich bin sicher, wir werden damit\n"
"fertig.{end_wait}"

msgctxt "message"
msgid "05665"
msgstr "Ich überlasse die Sache dir.{end_wait}"

msgctxt "message"
msgid "05666"
msgstr ""
"Diese Warterei ist total langweilig.\n"
"Beeile dich und hau denen mal\n"
"richtig auf die Mütze!{end_wait}"

msgctxt "message"
msgid "05667"
msgstr ""
"Zu wissen, dass du nicht\n"
"teilnimmst, weckt nicht gerade\n"
"Vertrauen in mir.{end_wait}"

msgctxt "message"
msgid "05668"
msgstr ""
"Ich hoffe nur, dass alle die Sache\n"
"hier heil überstehen...{end_wait}"

msgctxt "message"
msgid "05669"
msgstr "?"

msgctxt "message"
msgid "05670"
msgstr ""
"Es würde mir besser gehen, wenn\n"
"ich da draußen bei dir wäre.{end_wait}"

msgctxt "message"
msgid "05671"
msgstr ""
"Wenn du mich zurücklässt und\n"
"deswegen verlierst, werde ich\n"
"dir niemals verzeihen!{end_wait}"

msgctxt "message"
msgid "05672"
msgstr ""
"Ich hoffe nur, dass deine Ziel-\n"
"sicherheit nicht versagt....{end_wait}"

msgctxt "MsgEverybodyDeservesA"
msgid "05673"
msgstr ""
"Für diesen Sieg verdient jeder\n"
"ein gewisses Maß an Lob!{end_wait}"

msgctxt "message"
msgid "05674"
msgstr ""
"Du kannst auf mich zählen,\n"
"durch dick und dünn!{end_wait}"

msgctxt "message"
msgid "05675"
msgstr ""
"Wenn ich etwas nervös gewirkt\n"
"haben sollte, dann nur, weil ich\n"
"nicht wusste,{page_break}"
"ob du dich auch richtig\n"
"vorbereitet hast.{end_wait}"

msgctxt "message"
msgid "05676"
msgstr ""
"Ich bin froh, dass wir gewonnen\n"
"haben. Aber tun dir denn deine\n"
"Gegner nicht Leid?{end_wait}"

msgctxt "message"
msgid "05677"
msgstr "?"

msgctxt "message"
msgid "05678"
msgstr ""
"Du weißt, dass du ohne mich\n"
"niemals gewonnen hättest.{end_wait}"

msgctxt "message"
msgid "05679"
msgstr ""
"Tja, das war ja nun wirklich\n"
"keine Herausforderung.{end_wait}"

msgctxt "message"
msgid "05680"
msgstr ""
"Wie du sehen kannst, habe\n"
"ich wirklich mein Bestes\n"
"gegeben!{end_wait}"

msgctxt "MsgEverybodyDidGreat"
msgid "05681"
msgstr ""
"Ihr wart alle ganz großartig!\n"
"Ich musste mir gar keine\n"
"Sorgen machen!{end_wait}"

msgctxt "message"
msgid "05682"
msgstr ""
"Ihr habt gewonnen? Ohne mich?\n"
"Wow! Ich komme mir jetzt irgend-\n"
"wie so nutzlos vor...{end_wait}"

msgctxt "message"
msgid "05683"
msgstr ""
"In der Hitze der Schlacht hast du\n"
"dich wirklich souverän gehalten.\n"
"Gute Arbeit!{end_wait}"

msgctxt "message"
msgid "05684"
msgstr ""
"Das Wichtigste ist, dass niemand\n"
"verletzt worden ist. Mit Aus-\n"
"nahme der Gegner natürlich...{end_wait}"

msgctxt "message"
msgid "05685"
msgstr "?"

msgctxt "message"
msgid "05686"
msgstr ""
"Gut, du hast zwar gewonnen, aber\n"
"wäre es nicht einfacher gewesen,\n"
"wenn ich dabei gewesen wäre?{end_wait}"

msgctxt "message"
msgid "05687"
msgstr ""
"Oh, du hast gewonnen? Schön\n"
"für dich. Aber du hast mich\n"
"zurückgelassen...{end_wait}"

msgctxt "message"
msgid "05688"
msgstr ""
"Das war ja ein spannender Kampf!\n"
"Ich konnte nicht ruhig sitzen\n"
"bleiben!{end_wait}"

msgctxt "MsgDonTBlame"
msgid "05689"
msgstr ""
"Nimm es nicht zu schwer... Die\n"
"Strategie war einfach falsch.{end_wait}"

msgctxt "message"
msgid "05690"
msgstr ""
"Reiß dich zusammen! Nächstes\n"
"Mal schaffen wir es!{end_wait}"

msgctxt "message"
msgid "05691"
msgstr ""
"Du hättest jemand anderen\n"
"wählen sollen. Es ist nur\n"
"meine Schuld,{page_break}"
"dass wir verloren haben.{end_wait}"

msgctxt "message"
msgid "05692"
msgstr ""
"Ich war wohl nicht von\n"
"großem Nutzen, oder?\n"
"Es tut mir sehr Leid...{end_wait}"

msgctxt "message"
msgid "05693"
msgstr "?"

msgctxt "message"
msgid "05694"
msgstr ""
"Hoho! Das hat ordentlich ge-\n"
"scheppert! Was ist da nur\n"
"in die Hose gegangen?{end_wait}"

msgctxt "message"
msgid "05695"
msgstr ""
"Ich habe mein Bestes gegeben!\n"
"Ich hoffe, ich war damit nicht\n"
"allein auf weiter Flur...{end_wait}"

msgctxt "message"
msgid "05696"
msgstr ""
"Vielleicht wäre es besser\n"
"gewesen, wenn ich nicht\n"
"mitgekommen wäre...{end_wait}"

msgctxt "MsgYouWinSome"
msgid "05697"
msgstr ""
"Manchmal gewinnt man, manchmal\n"
"nicht. Das liegt in der Natur der\n"
"Sache.{end_wait}"

msgctxt "message"
msgid "05698"
msgstr ""
"Was? Ihr habt verloren? Das\n"
"hast du davon! Hättest du\n"
"mich mitgenommen!{end_wait}"

msgctxt "message"
msgid "05699"
msgstr ""
"Keine Sorge, {actor_name:5}.\n"
"Nächstes Mal geht es sicher\n"
"besser.{end_wait}"

msgctxt "message"
msgid "05700"
msgstr ""
"Ich weiß, ich stand da draußen\n"
"nicht an deiner Seite. Dennoch\n"
"fühle ich mich verantwortlich.{end_wait}"

msgctxt "message"
msgid "05701"
msgstr "?"

msgctxt "message"
msgid "05702"
msgstr ""
"Mit einer solchen Haltung\n"
"ist es kein Wunder, dass\n"
"du nicht gewinnst!{end_wait}"

msgctxt "message"
msgid "05703"
msgstr ""
"Hättest du mich mitgenommen,\n"
"wäre all das nicht passiert.\n"
"Vergiss das bloß nicht!{end_wait}"

msgctxt "message"
msgid "05704"
msgstr ""
"Du hättest mich um Hilfe bitten\n"
"sollen. So wie es aussieht, hättest\n"
"du sie brauchen können...{end_wait}"

msgctxt "message"
msgid "05705"
msgstr ""
"Ich werde nur zusehen. Aber\n"
"ihr zieht nun in den Kampf.\n"
"Nun, gebt euer Bestes!{end_wait}"

msgctxt "MsgIDonTHaveThe"
msgid "05706"
msgstr ""
"{text_effect:4}Ich bin nicht gemacht\n"
"für den Kampf in der Arena! Ich\n"
"würde lieber nur zusehen.{end_wait}"

msgctxt "message"
msgid "05707"
msgstr ""
"Du wirkst ein wenig dürr.\n"
"Aber Kerle wie du sind oft\n"
"überraschend stark!{end_wait}"

msgctxt "message"
msgid "05708"
msgstr ""
"Gegen einen Kerl von solcher\n"
"Statur zu kämpfen, würde mich\n"
"völlig fertig machen!{end_wait}"

msgctxt "message"
msgid "05709"
msgstr ""
"Ich werde euch anfeuern!\n"
"Gebt euer Bestes!{end_wait}"

msgctxt "message"
msgid "05710"
msgstr ""
"Ich stehe auf richtige Männer!\n"
"Hm... du gehst nicht\n"
"wirklich oft trainieren, oder?{end_wait}"

msgctxt "message"
msgid "05711"
msgstr ""
"Hm... Das wäre die Eröffnung...\n"
"Dann folgt ein Ausfall und...\n"
"Neineinein... So nicht...{end_wait}"

msgctxt "message"
msgid "05712"
msgstr ""
"Du kannst Psynergy, Dschinns,\n"
"Beschwörungen und auch Items\n"
"einsetzen!{page_break}"
"Die Möglichkeiten sind nahezu\n"
"unbegrenzt!!!{end_wait}"

msgctxt "message"
msgid "05713"
msgstr ""
"Du machst also einen Gegner\n"
"platt und der andere wischt\n"
"mit dir den Fußboden?{page_break}"
"Du musst deine Kampf-\n"
"taktik dem jeweiligen\n"
"Gegner anpassen!{end_wait}"

msgctxt "message"
msgid "05714"
msgstr ""
"Ich muss irgendwie stärker\n"
"werden, aber mir fällt nichts\n"
"mehr ein. Was soll ich tun?{end_wait}"

msgctxt "message"
msgid "05715"
msgstr ""
"Manchmal ändert sich deine\n"
"Klasse, nachdem du einen\n"
"Dschinn eingesetzt hast.{page_break}"
"Sei bloß vorsichtig, sonst\n"
"könnte die Sache gehörig\n"
"ins Auge gehen!{end_wait}"

msgctxt "message"
msgid "05716"
msgstr ""
"Soll ich teilnehmen oder nicht?\n"
"Das bereitet mir wirklich\n"
"Kopfzerbrechen...{end_wait}"

msgctxt "MsgItLooksLikeThisIs"
msgid "05717"
msgstr ""
"Sieht so aus, als wärst\n"
"du zum ersten Mal hier.{page_break}"
"Ich werde dir erklären,\n"
"wie die Kämpfe hier\n"
"ablaufen.{end_wait}"

msgctxt "message"
msgid "05718"
msgstr ""
"Gewonnene Link-Kämpfe:\n"
"{argument_signed_number}\n"
"Nur weiter so!{end_wait}"

msgctxt "MsgItLooksLikeThisIsYour"
msgid "05719"
msgstr ""
"Sieht so aus, als wärst\n"
"du zum ersten Mal hier.{page_break}"
"Kommst du später wieder\n"
"zu mir, kann ich dir deine\n"
"Kampfergebnisse nennen.{end_wait}"

msgctxt "message"
msgid "05720"
msgstr ""
"Gewonnene Link-Kämpfe:\n"
"{argument_signed_number}{page_break}"
"Schau dir die Tafel an\n"
"der Wand an, um die besten\n"
"Ergebnisse einzusehen.{end_wait}"

msgctxt "message"
msgid "05721"
msgstr ""
"Bis zu drei Kämpfer\n"
"können in einem Link-\n"
"Kampf antreten.{page_break}"
"Die Resultate hängen stark\n"
"davon ab, wen du mit welchen\n"
"Dschinns verbündest.{end_wait}"

msgctxt "message"
msgid "05722"
msgstr ""
"Das war ein großartiger\n"
"Kampf!\n"
"Sehr aufregend!{end_wait}"

msgctxt "message"
msgid "05723"
msgstr ""
"So ein Pech! Manchmal hängt\n"
"der Sieg auch vom Glück ab.\n"
"Sei nicht zu enttäuscht.{end_wait}"

msgctxt "message"
msgid "05724"
msgstr ""
"Ist das die Kampf-Arena,\n"
"von der der alte Mann\n"
"gesprochen hat?{page_break}"
"Ich dachte, das sei nur\n"
"eine Legende!{page_break}"
"Oder ist es vielleicht\n"
"der Traum des alten\n"
"Mannes?{end_wait}"

msgctxt "message"
msgid "05725"
msgstr ""
"Wow! Ihr seid ja viel\n"
"stärker, als ihr ausseht!{end_wait}"

msgctxt "message"
msgid "05726"
msgstr ""
"Was ist geschehen? Strengt\n"
"euch mehr an!{end_wait}"

msgctxt "MsgYouLookA"
msgid "05727"
msgstr ""
"Du wirkst ein wenig dürr.\n"
"Aber Kerle wie du sind oft\n"
"überraschend stark!{end_wait}"

msgctxt "message"
msgid "05728"
msgstr ""
"Gegen einen Kerl von solcher\n"
"Statur zu kämpfen, würde mich\n"
"völlig fertig machen!{end_wait}"

msgctxt "MsgILlBe"
msgid "05729"
msgstr ""
"Ich werde euch anfeuern!\n"
"Gebt euer Bestes!{end_wait}"

msgctxt "MsgILikeMy"
msgid "05730"
msgstr ""
"Ich stehe auf richtige Männer!\n"
"Hm... du gehst nicht\n"
"wirklich oft trainieren, oder?{end_wait}"

msgctxt "MsgHmItComes"
msgid "05731"
msgstr ""
"Hm... Das wäre die Eröffnung...\n"
"Dann folgt ein Ausfall und...\n"
"Neineinein... So nicht...{end_wait}"

msgctxt "message"
msgid "05732"
msgstr ""
"Hm... Das wäre die Eröffnung...\n"
"Dann folgt ein Ausfall und...\n"
"Neineinein... So nicht...{end_wait}"

msgctxt "message"
msgid "05733"
msgstr ""
"Hm... Das wäre die Eröffnung...\n"
"Dann folgt ein Ausfall und...\n"
"Neineinein... So nicht...{end_wait}"

msgctxt "message"
msgid "05734"
msgstr ""
"Ich bin ein wandernder\n"
"Krieger. Ich kam hierher,\n"
"um stärker zu werden.{page_break}"
"Glaubt mir dies: Ihr dürft\n"
"die Monster hier nicht\n"
"unterschätzen!{end_wait}"

msgctxt "message"
msgid "05735"
msgstr ""
"Ihr seid nicht schlecht.\n"
"Aber werdet bloß nicht\n"
"überheblich!{page_break}"
"Ihr dürft nicht aufhören\n"
"zu trainieren.{end_wait}"

msgctxt "message"
msgid "05736"
msgstr ""
"Ihr müsst mehr trainieren.{page_break}"
"Kämpft mit euren Herzen!{end_wait}"

msgctxt "MsgIWillTell"
msgid "05737"
msgstr ""
"Ich werde euch eure\n"
"Gesamt-Ergebnisse\n"
"mitteilen,{page_break}"
"wenn ihr das Link-Finale\n"
"bestanden habt.{end_wait}"

msgctxt "MsgIWillTellYou"
msgid "05738"
msgstr ""
"Wenn ihr das Finale\n"
"überstanden habt,\n"
"erfahrt ihr hier,{page_break}"
"wie oft ihr in Folge\n"
"gewonnen habt.{end_wait}"

msgctxt "MsgYouVeWon"
msgid "05739"
msgstr ""
"Gewinne in Folge\n"
"bei Monster-Kämpfen:\n"
"{argument_signed_number}{page_break}"
"Macht weiter so!{end_wait}"

msgctxt "MsgICanTWaitTo"
msgid "05740"
msgstr ""
"Ich kann es kaum erwarten\n"
"zu sehen, wie viele\n"
"Monster-Kämpfe ihr{page_break}"
"gewinnen werdet! Ich\n"
"rechne mit eurem Sieg!{end_wait}"

msgctxt "MsgUpToThreeAlliesCan"
msgid "05741"
msgstr ""
"Bis zu drei Kämpfer\n"
"können im Finale der\n"
"Link-Kämpfe antreten.{page_break}"
"Du hast vier Leute im\n"
"Team, also muss der\n"
"rechts außen aussetzen.{end_wait}"

msgctxt "MsgUpToThreeAllies"
msgid "05742"
msgstr ""
"Bis zu drei Kämpfer\n"
"können im Finale der\n"
"Link-Kämpfe antreten.{page_break}"
"Also darf dein momentanes\n"
"Team teilnehmen.{end_wait}"

msgctxt "MsgYouCanChange"
msgid "05743"
msgstr ""
"Du kannst die Reihenfolge\n"
"deiner Mitglieder im Status-\n"
"Bildschirm verändern.{page_break}"
"Das wusstest du sicher\n"
"schon, oder?{end_wait}"

msgctxt "MsgUpToThree"
msgid "05744"
msgstr ""
"Bis zu drei Kämpfer\n"
"können gemeinsam in den\n"
"Link-Kämpfen antreten.{page_break}"
"Deine Truppe umfasst acht\n"
"Mitstreiter. Nur die drei auf\n"
"der linken Seite können{page_break}"
"am Kampf teilnehmen.{end_wait}"

msgctxt "MsgInTheLinked"
msgid "05745"
msgstr ""
"Im Link-Finale kannst du\n"
"nicht ewig überlegen.{page_break}"
"Hast du nicht 15 Sekunden\n"
"nach der Eingabe deines\n"
"Gegners deine Kommandos{page_break}"
"gewählt, gehst du automatisch\n"
"zur Verteidigung über.{end_wait}"

msgctxt "MsgMonsterBattleRules"
msgid "05746"
msgstr ""
"Die Regeln für den Monster-\n"
"Kampf besagen, dass man nur\n"
"als Team antreten darf.{page_break}"
"Als Team könnt ihr die\n"
"gleichen Taktiken anwenden,\n"
"wie ihr sie von eurem{page_break}"
"Abenteuer her kennt.{end_wait}"

msgctxt "MsgSoYouWin"
msgid "05747"
msgstr ""
"Du machst also einen Gegner\n"
"platt und der andere wischt\n"
"mit dir den Fußboden?{page_break}"
"Du musst deine Kampf-\n"
"taktik dem jeweiligen\n"
"Gegner anpassen!{end_wait}"

msgctxt "MsgYouCouldUse"
msgid "05748"
msgstr ""
"Du kannst Psynergy, Dschinns,\n"
"Beschwörungen und auch Items\n"
"einsetzen!{page_break}"
"Die Möglichkeiten sind nahezu\n"
"unbegrenzt!!!{end_wait}"

msgctxt "MsgShouldIEnter"
msgid "05749"
msgstr ""
"Soll ich teilnehmen oder nicht?\n"
"Das bereitet mir wirklich\n"
"Kopfzerbrechen...{end_wait}"

msgctxt "message"
msgid "05750"
msgstr ""
"Um eine Beschwörung schnell\n"
"ausführen zu können, müssen\n"
"die Dschinns auf Standby sein.{page_break}"
"Aber um deine Werte zu\n"
"verbessern, musst du dich\n"
"mit den Dschinns verbünden.{page_break}"
"Hm, so viel Auswahl...{end_wait}"

msgctxt "message"
msgid "05751"
msgstr ""
"Setzt du deine Dschinns vor\n"
"einem Kampf auf Standby\n"
"oder gehst du mit ihnen{page_break}"
"ein Bündnis ein? Ich ziehe\n"
"vor einem Kampf ein Bündnis\n"
"vor, um meine Werte anzuheben.{end_wait}"

msgctxt "message"
msgid "05752"
msgstr ""
"Entferne Dschinns, die du\n"
"nur selten einsetzt, damit\n"
"du schneller beschwören kannst.{page_break}"
"Ich bin ungeduldig, daher\n"
"bevorzuge ich schnelle\n"
"Kämpfe.{end_wait}"

msgctxt "MsgSometimesYourClass"
msgid "05753"
msgstr ""
"Manchmal ändert sich deine\n"
"Klasse, nachdem du einen\n"
"Dschinn eingesetzt hast.{page_break}"
"Sei bloß vorsichtig, sonst\n"
"könnte die Sache gehörig\n"
"ins Auge gehen!{end_wait}"

msgctxt "message"
msgid "05754"
msgstr ""
"All die Krieger sind\n"
"wirklich beeindruckend!{page_break}"
"Daher werde ich vor den\n"
"Kämpfen immer nervös.{end_wait}"

msgctxt "message"
msgid "05755"
msgstr ""
"Ich könnte teilnehmen,\n"
"aber ich würde nur verletzt\n"
"werden. Das wäre dumm.{end_wait}"

msgctxt "MsgYouHaveA"
msgid "05756"
msgstr "Hast du einen Musikwunsch?{end_wait}"

msgctxt "MsgComeBackWhen"
msgid "05757"
msgstr ""
"Komm wieder, wenn du bereit bist,\n"
"das Tanzbein zu schwingen!{end_wait}"

