"puedo esperar. ¿Verdad, {actor_name:1}?{end_wait}"

msgctxt "message"
msgid "10560"
msgstr ""
"Lo haré lo mejor que pueda,\n"
"pero me cubrirás cuando lo\n"
"necesite, ¿verdad, {actor_name:1}?{end_wait}"

msgctxt "message"
msgid "10561"
