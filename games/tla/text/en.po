#, alchemy-end-wait
msgctxt "MsgMadraInteriors40"
msgid "06399"
msgstr ""
"Our inn is quite safe...\n"
"The Champa themselves\n"
"couldn't fight their way in!"

#, alchemy-end-wait
msgctxt "MsgMadraInteriors41"
msgid "06400"
msgstr ""
"I hope those Champa\n"
"don't come back for\n"
"a rematch..."

#, alchemy-end-wait
msgctxt "MsgMadraInteriors42"
msgid "06401"
