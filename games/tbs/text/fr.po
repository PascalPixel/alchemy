"dans la forteresse.{page_break}"
"Vous savez ce que\n"
"c'était?"

#, alchemy-end-wait
msgctxt "MsgLunpaInteriorsSecondHomeBReopened"
msgid "09424"
msgstr ""
"Peu m'importe ce\n"
