msgctxt "message"
msgid "07646"
msgstr "Dovremo chiedere aiuto{line_break}agli altri passeggeri.{end_wait}"

msgctxt "message"
msgid "07647"
msgstr "Perché non chiediamo{line_break}ai passeggeri che{line_break}partecipano alla gita?{end_wait}"

msgctxt "message"
msgid "07648"
