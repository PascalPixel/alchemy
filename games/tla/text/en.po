#, alchemy-end-wait
msgctxt "message"
msgid "08015"
msgstr "Silence! SILENCE!"

#, alchemy-end-wait
msgctxt "message"
msgid "08016"
msgstr ""
"Do not be hasty! The Great\n"
"Gabomba has not opened\n"
"his eyes in anger!"

#, alchemy-end-wait
msgctxt "message"
msgid "08017"
msgstr ""
"Your prayers...have not\n"
