msgctxt "message"
msgid "08934"
msgstr "Sapevo che la temperatura{line_break}stava lentamente aumentando...{page_break}Ma ora è ovvio{line_break}che l'aumento è{line_break}molto veloce.{end_wait}"

msgctxt "message"
msgid "08935"
