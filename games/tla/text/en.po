#, alchemy-end-wait
msgctxt "message"
msgid "08018"
msgstr ""
"Pray! You must pray more!\n"
"Let the Great Gabomba hear\n"
"our desires!"

#, alchemy-end-wait
msgctxt "message"
msgid "08019"
msgstr "Drums! More drums!!!"

#, alchemy-end-wait
msgctxt "MsgLookTheGreat"
msgid "08020"
msgstr ""
"Look! The Great Gabomba has\n"
"responded to our gift!"

#, alchemy-end-wait
msgctxt "message"
msgid "08021"
msgstr ""
"Wahhh! The Great Gabomba\n"
"spews jets of flame!"

#, alchemy-end-wait
msgctxt "message"
msgid "08022"
msgstr ""
"It is the end of Kibombo!\n"
"Our village is doomed!"

#, alchemy-end-wait
msgctxt "message"
msgid "08023"
msgstr "Silence! SILENCE!"

#, alchemy-end-wait
msgctxt "message"
msgid "08024"
msgstr ""
"Do not be hasty, my people!\n"
"The Great Gabomba is not\n"
"angered by our ceremony!"

#, alchemy-end-wait
msgctxt "message"
msgid "08025"
msgstr ""
"He is angered by the presence\n"
