"cerca.{end_wait}"

msgctxt "message"
msgid "10496"
msgstr "Supongo que sí...{end_wait}"

msgctxt "message"
msgid "10497"
msgstr ""
"Los echo de menos...\n"
"{actor_name:1}...\n"
"{actor_name:5}...{end_wait}"

msgctxt "message"
msgid "10498"
msgstr ""
"Hay algo que desearía\n"
