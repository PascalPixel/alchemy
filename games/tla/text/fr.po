msgctxt "message"
msgid "05586"
msgstr ""
"Vous êtes étonnants!!!\n"
"Voulez-vous combattre\n"
"le monstre suivant?{end_now}"

msgctxt "message"
msgid "05587"
msgstr ""
"Vous êtes redoutables!!!\n"
"La puissance du prochain\n"
"défie votre entendement.{page_break}"
"Vous voulez le\n"
"combattre?{end_now}"

msgctxt "message"
msgid "05588"
msgstr ""
"Vous êtes redoutables!!!\n"
"Voulez-vous combattre\n"
"le monstre suivant?{end_now}"

msgctxt "message"
msgid "05589"
msgstr ""
"Vous êtes redoutables!!!\n"
"La puissance du prochain\n"
"défie votre entendement.{page_break}"
"Vous voulez le\n"
"combattre?{end_now}"

msgctxt "MsgItSOur"
msgid "05590"
msgstr ""
"C'est notre tour.\n"
"Allons-y, {actor_name:5}.{end_wait}"

msgctxt "message"
msgid "05591"
msgstr ""
"Hé, {actor_name:5}, je\n"
"vais mettre le paquet.{end_wait}"

msgctxt "message"
msgid "05592"
msgstr ""
"Je me bats si tu veux.\n"
"Mais ne t'attends\n"
"pas à un exploit.{end_wait}"

msgctxt "message"
msgid "05593"
msgstr "Je ferai de mon mieux!{end_wait}"

msgctxt "message"
msgid "05594"
msgstr "?"

msgctxt "message"
msgid "05595"
msgstr ""
"Je me battrai avec la\n"
"même détermination\n"
"que toi!{end_wait}"

msgctxt "message"
msgid "05596"
msgstr ""
"Tu ne veux même pas\n"
"essayer? Je vais te\n"
"montrer ma force.{end_wait}"

msgctxt "message"
msgid "05597"
msgstr ""
"D'accord, {actor_name:5},\n"
"unissons nos forces!{end_wait}"

msgctxt "MsgOkWeRe"
msgid "05598"
msgstr ""
"Nous sommes prêts,\n"
"{actor_name:5}. Mais à toi de\n"
"choisir la stratégie!{end_wait}"

msgctxt "message"
msgid "05599"
msgstr ""
"Quoi? Je dois faire une\n"
"pause, mais pourquoi?{end_wait}"

msgctxt "message"
msgid "05600"
msgstr ""
"Comme c'est pathétique de\n"
"rester sur le banc de touche.{end_wait}"

msgctxt "message"
msgid "05601"
msgstr ""
"Bah, un peu de repos\n"
"ne me fera pas de mal.{end_wait}"

msgctxt "message"
msgid "05602"
msgstr "?"

msgctxt "message"
msgid "05603"
msgstr ""
"OK, j'attends ici. Donnez\n"
"le meilleur de vous.{end_wait}"

msgctxt "message"
msgid "05604"
msgstr ""
"Tu ne veux plus de\n"
"moi, {actor_name:5}?{end_wait}"

msgctxt "message"
msgid "05605"
msgstr ""
"Tu veux me dire quelque\n"
"chose, {actor_name:5}?{end_wait}"

msgctxt "MsgILlFight"
msgid "05606"
msgstr ""
"Je me battrai\n"
"pour deux...{end_wait}"

msgctxt "message"
msgid "05607"
msgstr ""
"Si tu ne veux pas te\n"
"battre, nous nous\n"
"débrouillerons sans toi.{end_wait}"

msgctxt "message"
msgid "05608"
msgstr ""
"Quoi? Pas du tout!\n"
"Remplacez-moi!{end_wait}"

msgctxt "message"
msgid "05609"
msgstr "Je ferai de mon mieux.{end_wait}"

msgctxt "message"
msgid "05610"
msgstr "?"

msgctxt "message"
msgid "05611"
msgstr ""
"Je rentre dans l'arène\n"
"et tu te dérobes? A\n"
"quoi joues-tu?{end_wait}"

msgctxt "message"
msgid "05612"
msgstr ""
"Bonne chance, {actor_name:5}!\n"
"Si tu as besoin de moi,\n"
"n'hésite pas.{end_wait}"

msgctxt "message"
msgid "05613"
msgstr ""
"Je suis seul, pas vrai?\n"
"Comme c'est stressant!{end_wait}"

msgctxt "message"
msgid "05614"
msgstr ""
"Peu importe l'adversaire,\n"
"il saura ce que j'ai dans\n"
"le ventre.{end_wait}"

msgctxt "message"
msgid "05615"
msgstr ""
"J'ai hâte de me trouver\n"
"face à mon adversaire.{end_wait}"

msgctxt "message"
msgid "05616"
msgstr ""
"Je suis prêt à me battre\n"
"et je me moque de l'issue\n"
"du combat...{end_wait}"

msgctxt "message"
msgid "05617"
msgstr ""
"J'espère que mes armes\n"
"et ma Psynergie vont\n"
"m'apporter la victoire...{end_wait}"

msgctxt "message"
msgid "05618"
msgstr "?"

msgctxt "message"
msgid "05619"
msgstr ""
"Personne ne me\n"
"mettra KO!{end_wait}"

msgctxt "message"
msgid "05620"
msgstr ""
"J'espère que nos ennemis\n"
"nous donneront du fil à\n"
"retordre. J'aime les défis.{end_wait}"

msgctxt "message"
msgid "05621"
msgstr ""
"Je suis sûr que nous\n"
"pouvons remporter la\n"
"victoire.{end_wait}"

msgctxt "message"
msgid "05622"
msgstr "Je te laisse la main.{end_wait}"

msgctxt "message"
msgid "05623"
msgstr ""
"J'en ai assez d'attendre!\n"
"Dépêchez-vous d'en finir!{end_wait}"

msgctxt "message"
msgid "05624"
msgstr ""
"Je suis déstabilisé car tu\n"
"ne te bats pas à mes côtés.{end_wait}"

msgctxt "message"
msgid "05625"
msgstr ""
"J'espère que tout le\n"
"monde s'en sortira...{end_wait}"

msgctxt "message"
msgid "05626"
msgstr "?"

msgctxt "message"
msgid "05627"
msgstr ""
"Je serais rassurée si\n"
"j'étais à tes côtés.{end_wait}"

msgctxt "message"
msgid "05628"
msgstr ""
"Si tu m'exclus et que\n"
"tu perds, je ne te le\n"
"pardonnerai pas!{end_wait}"

msgctxt "message"
msgid "05629"
msgstr ""
"Je prie pour que la\n"
"chance soit avec toi...{end_wait}"

msgctxt "MsgEverybodyDeservesA"
msgid "05630"
msgstr ""
"Tout le monde a contribué\n"
"à cette victoire!{end_wait}"

msgctxt "message"
msgid "05631"
msgstr ""
"Dans tous les cas, tu\n"
"peux compter sur moi!{end_wait}"

msgctxt "message"
msgid "05632"
msgstr ""
"J'étais nerveux, car\n"
"tu ne me semblais\n"
"pas prêt.{end_wait}"

msgctxt "message"
msgid "05633"
msgstr ""
"Je suis contente d'avoir\n"
"gagné. Mais n'as-tu pas\n"
"pitié des perdants?{end_wait}"

msgctxt "message"
msgid "05634"
msgstr "?"

msgctxt "message"
msgid "05635"
msgstr ""
"Tu n'aurais jamais\n"
"gagné sans moi.{end_wait}"

msgctxt "message"
msgid "05636"
msgstr ""
"Aucun adversaire n'était\n"
"vraiment de taille.{end_wait}"

msgctxt "message"
msgid "05637"
msgstr ""
"J'ai incontestablement\n"
"donné le meilleur de moi.{end_wait}"

msgctxt "MsgEverybodyDidGreat"
msgid "05638"
msgstr ""
"Comme d'habitude, tout\n"
"le monde a été génial!{end_wait}"

msgctxt "message"
msgid "05639"
msgstr ""
"Tu as gagné? Sans moi?\n"
"Waouh... Je me sens\n"
"inutile tout à coup.{end_wait}"

msgctxt "message"
msgid "05640"
msgstr ""
"Tu es resté de marbre\n"
"alors que tu étais en\n"
"difficulté. Bravo!{end_wait}"

msgctxt "message"
msgid "05641"
msgstr ""
"L'important, c'est que\n"
"personne ne soit blessé.\n"
"Hormis tes adversaires.{end_wait}"

msgctxt "message"
msgid "05642"
msgstr "?"

msgctxt "message"
msgid "05643"
msgstr ""
"Tu as gagné, mais... si\n"
"j'avais été là, je t'aurais\n"
"facilité la tâche, non?{end_wait}"

msgctxt "message"
msgid "05644"
msgstr ""
"Oh, tu as gagné? C'est\n"
"super. Mais tu m'as tout\n"
"de même négligée!{end_wait}"

msgctxt "message"
msgid "05645"
msgstr ""
"Quel combat passionnant!\n"
"J'ai failli tomber de mon siège.{end_wait}"

msgctxt "MsgDonTBlame"
msgid "05646"
msgstr ""
"Ne sois pas triste...\n"
"La stratégie n'était\n"
"pas la bonne.{end_wait}"

msgctxt "message"
msgid "05647"
msgstr ""
"Reprends-toi! Nous\n"
"gagnerons la prochaine fois.{end_wait}"

msgctxt "message"
msgid "05648"
msgstr ""
"Tu aurais dû choisir\n"
"un autre partenaire.\n"
"Mea-culpa.{end_wait}"

msgctxt "message"
msgid "05649"
msgstr ""
"J'ai été nulle, pas vrai?\n"
"Je suis désolée...{end_wait}"

msgctxt "message"
msgid "05650"
msgstr "?"

msgctxt "message"
msgid "05651"
msgstr ""
"Waouh. Quelle cuisante\n"
"défaite... Que nous est-il\n"
"arrivé?{end_wait}"

msgctxt "message"
msgid "05652"
msgstr ""
"J'ai fait de mon mieux.\n"
"J'espère que vous aussi.{end_wait}"

msgctxt "message"
msgid "05653"
msgstr ""
"Peut-être n'aurais-je\n"
"pas dû venir...{end_wait}"

msgctxt "MsgYouWinSome"
msgid "05654"
msgstr ""
"On ne peut pas toujours\n"
"gagner. C'est la vie.{end_wait}"

msgctxt "message"
msgid "05655"
msgstr ""
"Quoi? Tu as perdu? Ça\n"
"t'apprendra à me\n"
"faire sortir de l'arène!{end_wait}"

msgctxt "message"
msgid "05656"
msgstr ""
"Ce n'est rien, {actor_name:5}.\n"
"Tu auras ta revanche.{end_wait}"

msgctxt "message"
msgid "05657"
msgstr ""
"Je m'en veux, même si, au\n"
"fond, je n'y suis pour rien.{end_wait}"

msgctxt "message"
msgid "05658"
msgstr "?"

msgctxt "message"
msgid "05659"
msgstr ""
"Comment veux-tu\n"
"gagner avec une\n"
"attitude pareille!{end_wait}"

msgctxt "message"
msgid "05660"
msgstr ""
"Avec moi, rien de tout\n"
"cela ne se serait passé.\n"
"Ne l'oublie jamais.{end_wait}"

msgctxt "message"
msgid "05661"
msgstr ""
"Tu aurais dû solliciter\n"
"mon aide, car tu en\n"
"avais grand besoin.{end_wait}"

msgctxt "message"
msgid "05662"
msgstr ""
"Je vais me contenter\n"
"de regarder. Allez-vous\n"
"vous battre?{page_break}"
"Bonne chance.{end_wait}"

msgctxt "MsgIDonTHaveThe"
msgid "05663"
msgstr ""
"{text_effect:4}Je n'ai pas le courage\n"
"de rejoindre l'arène. Je vais\n"
"m'asseoir sagement ici, OK?{end_wait}"

msgctxt "message"
msgid "05664"
msgstr ""
"Les guerriers efflanqués\n"
"sont en fait les plus forts.\n"
"C'est sûrement votre cas.{end_wait}"

msgctxt "message"
msgid "05665"
msgstr ""
"Comme cela doit être\n"
"épuisant d'affronter un\n"
"guerrier aussi costaud!{end_wait}"

msgctxt "message"
msgid "05666"
msgstr ""
"Vous avez mon soutien!\n"
"Faites de votre mieux!{end_wait}"

msgctxt "message"
msgid "05667"
msgstr ""
"J'aime les hommes musclés.\n"
"Pour sûr, toi, tu ne suis pas\n"
"d'entraînement intensif...{end_wait}"

msgctxt "message"
msgid "05668"
msgstr ""
"Hum... Faites d'abord\n"
"ceci, puis cela... Non,\n"
"pas comme ça...{end_wait}"

msgctxt "message"
msgid "05669"
msgstr ""
"Tous les coups sont\n"
"permis! Il y a des milliers\n"
"de stratégies de combat...{end_wait}"

msgctxt "message"
msgid "05670"
msgstr ""
"Tu gagnes contre cet\n"
"adversaire, tu perds\n"
"contre un autre.{page_break}"
"Il faut adapter ta\n"
"tactique en fonction\n"
"de l'ennemi.{end_wait}"

msgctxt "message"
msgid "05671"
msgstr ""
"Je dois trouver un moyen\n"
"de décupler mes forces.\n"
"Mais je n'ai pas d'idée.{end_wait}"

msgctxt "message"
msgid "05672"
msgstr ""
"L'utilisation de Djinn\n"
"peut changer ta classe.{page_break}"
"Tu devrais faire attention,\n"
"car tu pourrais te retrouver\n"
"dans un sacré pétrin.{end_wait}"

msgctxt "message"
msgid "05673"
msgstr ""
"Dois-je entrer ou pas?\n"
"Cela me stresse...{end_wait}"

msgctxt "MsgItLooksLikeThisIs"
msgid "05674"
msgstr ""
"On dirait que c'est votre\n"
"premier combat ici.{page_break}"
"Je vais vous apprendre\n"
"les bases du combat\n"
"en arène.{end_wait}"

msgctxt "message"
msgid "05675"
msgstr ""
"Vous avez gagné {argument_signed_number}\n"
"combat{control:13} en Link.\n"
"Continuez comme ça!{end_wait}"

msgctxt "MsgItLooksLikeThisIsYour"
msgid "05676"
msgstr ""
"On dirait que c'est\n"
"votre première fois ici.{page_break}"
"Vous pouvez me demander\n"
"les résultats de vos\n"
"combats. OK?{end_wait}"

msgctxt "message"
msgid "05677"
msgstr ""
"Vous avez gagné {argument_signed_number}\n"
"combat{control:13} en Link.{page_break}"
"Regardez sur le tableau\n"
"noir sur le mur pour\n"
"voir les records.{end_wait}"

msgctxt "message"
msgid "05678"
msgstr ""
"Jusqu'à trois alliés\n"
"peuvent combattre dans des\n"
"finales du duel en Link.{page_break}"
"Les résultats dépendent\n"
"des combinaisons des\n"
"Djinn que vous liez.{end_wait}"

msgctxt "message"
msgid "05679"
msgstr ""
"Ce combat était génial!\n"
"Quel talent!{end_wait}"

msgctxt "message"
msgid "05680"
msgstr ""
"Dommage. Il faut avoir un\n"
"peu de chance pour gagner.\n"
"Ne soyez pas déçus.{end_wait}"

msgctxt "message"
msgid "05681"
msgstr ""
"Est-ce l'arène dont\n"
"parlait le vieil homme?{page_break}"
"Je pensais que c'était\n"
"des histoires à dormir{page_break}"
"debout. Mais peut-être\n"
"qu'on est en train de\n"
"dormir???{end_wait}"

msgctxt "message"
msgid "05682"
msgstr ""
"Waouh...\n"
"Vous êtes plus forts que\n"
"vous en avez l'air.{end_wait}"

msgctxt "message"
msgid "05683"
msgstr ""
"Que s'est-il passé?\n"
"Il faut mieux faire!{end_wait}"

msgctxt "MsgYouLookA"
msgid "05684"
msgstr ""
"Les guerriers efflanqués\n"
"sont en fait les plus forts.\n"
"C'est sûrement votre cas.{end_wait}"

msgctxt "message"
msgid "05685"
msgstr ""
"Comme cela doit être\n"
"épuisant d'affronter un\n"
"guerrier aussi costaud!{end_wait}"

msgctxt "MsgILlBe"
msgid "05686"
msgstr ""
"Vous avez mon soutien!\n"
"Faites de votre mieux!{end_wait}"

msgctxt "MsgILikeMy"
msgid "05687"
msgstr ""
"J'aime les hommes\n"
"musclés. Tu ne t'entraînes\n"
"pas beaucoup toi, pas vrai?{end_wait}"

msgctxt "MsgHmItComes"
msgid "05688"
msgstr ""
"Hum... Faites d'abord\n"
"ceci, puis cela... Non,\n"
"pas comme ça...{end_wait}"

msgctxt "message"
msgid "05689"
msgstr ""
"Hum... Faites d'abord\n"
"ceci, puis cela... Non,\n"
"pas comme ça...{end_wait}"

msgctxt "message"
msgid "05690"
msgstr ""
"Hum... Faites d'abord\n"
"ceci, puis cela... Non,\n"
"pas comme ça...{end_wait}"

msgctxt "message"
msgid "05691"
msgstr ""
"Je suis un guerrier\n"
"itinérant. Je suis venu\n"
"pour devenir plus fort...{page_break}"
"Ne sous-estimez pas\n"
"les monstres que vous\n"
"trouverez ici...{end_wait}"

msgctxt "message"
msgid "05692"
msgstr ""
"Vous n'êtes pas mauvais.\n"
"Que cette victoire ne vous\n"
"rende pas trop sûrs{page_break}"
"de vous. Continuez à\n"
"vous entraîner.{end_wait}"

msgctxt "message"
msgid "05693"
msgstr ""
"Entraînez-vous plus.{page_break}"
"Mettez un peu de\n"
"c¾ur à l'ouvrage.{end_wait}"

msgctxt "MsgIWillTell"
msgid "05694"
msgstr ""
"Je vous dirai votre\n"
"nombre total de victoires\n"
"lorsque vous aurez terminé{page_break}"
"les finales en Link.{end_wait}"

msgctxt "MsgIWillTellYou"
msgid "05695"
msgstr ""
"Je vous dirai votre\n"
"nombre de victoires\n"
"consécutives lorsque vous{page_break}"
"aurez terminé les\n"
"finales en Link.{end_wait}"

msgctxt "MsgYouVeWon"
msgid "05696"
msgstr ""
"Vous avez gagné {argument_signed_number}\n"
"combat{control:13} consécutif{control:13} dans\n"
"l'Arène des monstres.{page_break}"
"Continuez comme ça!{end_wait}"

msgctxt "MsgICanTWaitTo"
msgid "05697"
msgstr ""
"J'ai hâte de savoir\n"
"combien de combats vous\n"
"gagnerez dans{page_break}"
"l'Arène des monstres.\n"
"Je vais compter vos\n"
"victoires!{end_wait}"

msgctxt "MsgUpToThreeAlliesCan"
msgid "05698"
msgstr ""
"Jusqu'à trois alliés\n"
"peuvent combattre dans\n"
"les finales en link.{page_break}"
"Vous êtes un groupe de\n"
"quatre, donc celui qui\n"
"est le plus à droite{page_break}"
"sera sur le banc\n"
"de touche.{end_wait}"

msgctxt "MsgUpToThreeAllies"
msgid "05699"
msgstr ""
"Jusqu'à trois alliés\n"
"peuvent combattre dans\n"
"les finales en link.{page_break}"
"Vous pouvez tous\n"
"combattre!{end_wait}"

msgctxt "MsgYouCanChange"
msgid "05700"
msgstr ""
"Vous pouvez changer\n"
"l'ordre de votre groupe\n"
"sur l'écran de statut.{page_break}"
"Mais vous le saviez, non?{end_wait}"

msgctxt "MsgUpToThree"
msgid "05701"
msgstr ""
"Jusqu'à trois alliés peuvent\n"
"participer aux finales en link.{page_break}"
"Votre groupe compte huit\n"
"membres. Seuls les trois alliés\n"
"de gauche peuvent combattre.{end_wait}"

msgctxt "MsgInTheLinked"
msgid "05702"
msgstr ""
"Dans les finales en link,\n"
"si vous attendez plus de\n"
"15 secondes après que votre{page_break}"
"adversaire a choisi un\n"
"coup, vous vous défendrez\n"
"automatiquement.{end_wait}"

msgctxt "MsgMonsterBattleRules"
msgid "05703"
msgstr ""
"Les règles de l'Arène des\n"
"monstres stipulent que vous\n"
"devez combattre un monstre{page_break}"
"en équipe. De cette\n"
"manière, vous pourrez\n"
"utiliser les mêmes{page_break}"
"tactiques que pendant\n"
"votre voyage.{end_wait}"

msgctxt "MsgSoYouWin"
msgid "05704"
msgstr ""
"Tu gagnes contre cet\n"
"adversaire, tu perds\n"
"contre un autre.{page_break}"
"Il faut adapter ta\n"
"tactique en fonction\n"
"de l'ennemi.{end_wait}"

msgctxt "MsgYouCouldUse"
msgid "05705"
msgstr ""
"Tous les coups sont\n"
"permis! Il y a des milliers\n"
"de stratégies de combat...{end_wait}"

msgctxt "MsgShouldIEnter"
msgid "05706"
msgstr ""
"Dois-je entrer ou pas?\n"
"Cela me stresse...{end_wait}"

msgctxt "message"
msgid "05707"
msgstr ""
"Pour Invoquer très vite,\n"
"les Djinn doivent être\n"
"en attente.{page_break}"
"Mais pour avoir accès\n"
"aux classes supérieures,\n"
"les Djinn doivent être{page_break}"
"liés...\n"
"Hum... Des choix\n"
"difficiles...{end_wait}"

msgctxt "message"
msgid "05708"
msgstr ""
"Vous mettez vos Djinn en\n"
"attente ou vous les liez?{page_break}"
"Je les lie pour améliorer\n"
"mes caractéristiques\n"
"avant un combat.{end_wait}"

msgctxt "message"
msgid "05709"
msgstr ""
"Enlevez les Djinn\n"
"dont vous ne vous servez\n"
"pas pour pouvoir les{page_break}"
"invoquer rapidement.{page_break}"
"Je suis impatient, alors\n"
"je préfère les combats\n"
"rapides.{end_wait}"

msgctxt "MsgSometimesYourClass"
msgid "05710"
msgstr ""
"L'utilisation de Djinn\n"
"peut changer ta classe.{page_break}"
"Tu devrais faire attention,\n"
"car tu pourrais te retrouver\n"
"dans un sacré pétrin.{end_wait}"

msgctxt "message"
msgid "05711"
msgstr ""
"Tous les guerriers sont\n"
"impressionnants, alors\n"
"je stresse un peu{page_break}"
"avant les combats.{end_wait}"

msgctxt "message"
msgid "05712"
msgstr ""
"Si j'entrais dans l'arène,\n"
"je serais sûr d'en sortir\n"
"blessé. Ce serait idiot.{end_wait}"

msgctxt "MsgYouHaveA"
msgid "05713"
msgstr "You have a song request?{end_wait}"

msgctxt "MsgComeBackWhen"
msgid "05714"
msgstr ""
"Come back when you're\n"
"ready to rock!{end_wait}"

