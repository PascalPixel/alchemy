msgctxt "message"
msgid "03196"
msgstr "Nimm mich mit dir!{end_now}"

msgctxt "MsgWorldMapMeanieDontCare"
msgid "03197"
msgstr ""
"Du bist gemein!{page_break}"
"Ist mir doch egal, was\n"
"du sagst! Ich komm\n"
"trotzdem mit!{end_wait}"

