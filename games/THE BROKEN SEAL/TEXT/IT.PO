msgctxt "message"
msgid "03663"
msgstr "{actor_name:1}, che vuoi?{line_break}Sto cercando di salvare{line_break}le mie cose!{end_wait}"

msgctxt "message"
msgid "03664"
msgstr "Come dici? È meglio che{line_break}lasci tutto qui?"

msgctxt "message"
msgid "03665"
