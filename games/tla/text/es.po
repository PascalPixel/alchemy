"del agua.{end_wait}"

msgctxt "message"
msgid "05893"
msgstr ""
"No se ve el fondo.\n"
"Está muy profundo.{end_wait}"

msgctxt "message"
msgid "05894"
msgstr ""
"Tras un examen más minucioso,\n"
"parece que el pozo está seco.{end_wait}"

msgctxt "message"
