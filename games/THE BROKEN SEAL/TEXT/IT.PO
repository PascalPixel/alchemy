msgctxt "message"
msgid "07546"
msgstr "Allora... si parte?{end_wait}"

msgctxt "message"
msgid "07547"
msgstr "Sì.{pause_20_skippable} Sono iniziate le{line_break}operazioni di partenza.{end_wait}"

msgctxt "message"
msgid "07548"
msgstr "Beh... Forse siamo{line_break}stati un po'{line_break}troppo precipitosi.{end_wait}"

msgctxt "message"
msgid "07549"
msgstr "Bene,{pause_20_skippable} quando siete{line_break}pronti, fate partire la nave.{end_wait}"

