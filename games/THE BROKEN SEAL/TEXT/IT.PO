msgctxt "message"
msgid "07512"
msgstr "Ma quelli sono dei criminali...{line_break}Non si può far partire la{line_break}nave usando la forza!{end_wait}"

msgctxt "message"
msgid "07513"
msgstr "Beh, non m'importa in che{line_break}modo: l'importante è{line_break}partire!{end_wait}"

msgctxt "message"
msgid "07514"
msgstr "Credo che quei ragazzi{line_break}sappiamo lottare:{line_break}credo che ce la faranno.{end_wait}"

msgctxt "message"
msgid "07515"
msgstr "Appena riceveremo gli ordini,{line_break}potremo partire.{end_wait}"

msgctxt "message"
msgid "07516"
msgstr "Questo tamburo serve a far{line_break}remare tutti a tempo.{end_wait}"

msgctxt "message"
msgid "07517"
msgstr "Remare è un lavoro da uomini!{end_wait}"

msgctxt "message"
msgid "07518"
msgstr "Siamo noi che facciamo{line_break}muovere la nave.{end_wait}"

msgctxt "message"
msgid "07519"
msgstr "Non appena si mollano gli{line_break}ormeggi, entriamo in{line_break}gioco noi.{end_wait}"

msgctxt "message"
msgid "07520"
msgstr "Un lavoro faticoso come{line_break}questo si può fare{line_break}soltanto da giovani.{end_wait}"

msgctxt "message"
msgid "07521"
msgstr "Chissà quando{line_break}partiremo...{end_wait}"

msgctxt "message"
msgid "07522"
msgstr "Non vedo l'ora di arrivare{line_break}a Tolbi per sgranchirmi un{line_break}po' le gambe.{end_wait}"

msgctxt "message"
msgid "07523"
msgstr "Ho sentito dire che in mezzo{line_break}al Karagol c'è un'isola,{line_break}ma non l'ho mai vista.{end_wait}"

msgctxt "message"
msgid "07524"
msgstr "Dal mare sembra che la{line_break}Strada della Seta sia{line_break}sommersa dall'acqua.{end_wait}"

msgctxt "message"
msgid "07525"
msgstr "Ora ne ho abbastanza!{line_break}Voglio salpare!{end_wait}"

msgctxt "message"
msgid "07526"
msgstr "Mi piace sentire che i{line_break}rematori si muovono al ritmo{line_break}del mio tamburo.{end_wait}"

msgctxt "message"
msgid "07527"
msgstr "Quaggiù sono tutti{line_break}molto competitivi.{end_wait}"

msgctxt "message"
msgid "07528"
