#, alchemy-end-wait
msgctxt "MsgGaroh14"
msgid "06576"
msgstr "{actor_name:5}, wait..."

#, alchemy-end-wait
msgctxt "message"
msgid "06577"
msgstr ""
"Where could that\n"
