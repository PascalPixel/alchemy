"ihm suchen. Was soll ich tun?"

#, alchemy-end-wait
msgctxt "MsgKalayThatsWeCantWaitAny"
msgid "06804"
msgstr ""
"Jetzt reicht's!{pause_20_skippable} Wir können\n"
