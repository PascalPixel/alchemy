msgctxt "message"
msgid "08915"
msgstr "Sono stati forti abbastanza{line_break}da sconfiggere Saturos e{line_break}Adexia. Sanno cavarsela.{end_wait}"

msgctxt "message"
msgid "08916"
msgstr "Dovremmo continuare,{line_break}proprio come avrebbero fatto{line_break}Saturos e Adexia, OK, {actor_name:6}?{end_wait}"

