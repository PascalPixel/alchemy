#, alchemy-end-now
msgctxt "message"
msgid "06578"
msgstr ""
"Do you think we lost\n"
"him somewhere?"

#, alchemy-end-wait
msgctxt "message"
msgid "06579"
msgstr "That would be a shame..."

#, alchemy-end-wait
msgctxt "message"
msgid "06580"
msgstr ""
"I hope we didn't...\n"
