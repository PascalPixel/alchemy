#, alchemy-end-wait
msgctxt "message"
msgid "10313"
msgstr ""
"Est-ce vraiment un\n"
"miracle?"

#, alchemy-end-wait
msgctxt "message"
msgid "10314"
msgstr ""
"Tu penses que c'était\n"
"juste de la chance?"

#, alchemy-end-wait
msgctxt "message"
msgid "10315"
msgstr ""
"Disons que c'était une\n"
"coïncidence, voilà tout."

#, alchemy-end-wait
msgctxt "message"
msgid "10316"
msgstr ""
"Rien n'est coïncidence\n"
"avec cet enfant."

#, alchemy-end-wait
msgctxt "message"
msgid "10317"
msgstr ""
"Alors, tu crois...\n"
