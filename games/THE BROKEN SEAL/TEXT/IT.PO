msgctxt "message"
msgid "05626"
msgstr "Diamine! Non abbiamo neppure{line_break}salvato {actor_name:6}...{end_wait}"

msgctxt "message"
msgid "05627"
msgstr "Non merito il titolo{line_break}di guaritore...{end_wait}"

msgctxt "message"
msgid "05628"
msgstr "Non abbiamo potuto{line_break}impedire che{line_break}accendessero il faro.{end_wait}"

msgctxt "message"
msgid "05629"
msgstr "Ho fallito... Non ho{line_break}compiuto il mio dovere...{end_wait}"

msgctxt "message"
msgid "05630"
msgstr "Non è vero!{line_break}Potremo ancora batterli!{line_break}Giusto, {actor_name:1}?{end_now}"

msgctxt "message"
msgid "05631"
msgstr "Va bene, {actor_name:1}!{page_break}Dobbiamo soltanto{line_break}impedire che accendano{line_break}tutti quanti i fari!{end_wait}"

msgctxt "message"
msgid "05632"
msgstr "Ehi, come sei{line_break}pessimista!{page_break}Finché i fari non sono{line_break}tutti accesi, saremo{line_break}al sicuro!{end_wait}"

msgctxt "message"
msgid "05633"
msgstr "Hanno acceso il Faro{line_break}di Mercurio, ma la{page_break}prossima volta li{line_break}fermeremo.{end_wait}"

msgctxt "message"
msgid "05634"
msgstr "Giusto. Al prossimo{line_break}faro salveremo{line_break}{actor_name:6}.{end_wait}"

msgctxt "message"
msgid "05635"
msgstr "Certo! Alex non può{line_break}farla franca così...{end_wait}"

msgctxt "message"
msgid "05636"
msgstr "Dai, andiamogli{line_break}dietro!{end_wait}"

msgctxt "message"
msgid "05637"
msgstr "Che ti succede?{line_break}Dobbiamo sbrigarci!{end_wait}"

msgctxt "message"
msgid "05638"
msgstr "\"Dobbiamo\"?{line_break}{actor_name:4}, intendi{line_break}venire con noi?{end_wait}"

msgctxt "message"
msgid "05639"
msgstr "Ma ad Imil hanno bisogno{line_break}di te, {actor_name:4}.{end_wait}"

msgctxt "message"
msgid "05640"
msgstr "Non è un problema.{end_wait}"

msgctxt "message"
msgid "05641"
msgstr "\"La fonte resterà colma{line_break}finché la luce colmerà{line_break}il faro.\"{page_break}È un antico detto...{line_break}Ora la fonte si sta{line_break}riempiendo d'acqua curativa.{end_wait}"

msgctxt "message"
msgid "05642"
msgstr "Un po' mi dispiace andarmene,{line_break}ma finché dalla fonte{line_break}continuerà a sgorgare{page_break}l'Acqua magica, Imil{line_break}non avrà nulla{line_break}da temere.{end_wait}"

msgctxt "message"
msgid "05643"
msgstr "Se vogliamo seguirli,{line_break}dobbiamo sbrigarci.{end_wait}"

msgctxt "message"
msgid "05644"
msgstr "Narra la leggenda: l'acqua{line_break}sgorgherà di nuovo dalla{line_break}fonte quando il faro sarà{page_break}di nuovo illuminato. Ora{line_break}la leggenda s'è avverata!{end_wait}"

msgctxt "message"
msgid "05645"
msgstr "È tornata l'acqua nella{line_break}nostra fonte! Pare curi{line_break}ogni essere vivente!{end_wait}"

msgctxt "message"
msgid "05646"
msgstr "Ho bevuto l'acqua curativa{line_break}e ora sto benissimo!{page_break}Dovrò riempire qualche{line_break}bottiglia, così me ne{line_break}porto un po' a casa.{end_wait}"

msgctxt "message"
msgid "05647"
msgstr "Finché ci sarà la fonte,{line_break}non dovremo temere{line_break}alcuna epidemia.{end_wait}"

msgctxt "message"
msgid "05648"
msgstr "Come avrà fatto la fonte{line_break}a sapere che il faro è{line_break}stato acceso?{end_wait}"

msgctxt "message"
msgid "05649"
msgstr "Tutti gli esseri viventi...{line_break}Ma allora funzionerà anche{line_break}con le piante e gli animali.{end_wait}"

msgctxt "message"
msgid "05650"
msgstr "Sapevo che avrebbe funzionato,{line_break}ma non mi aspettavo un{line_break}effetto così straordinario! Mi{page_break}sento dieci anni più giovane!{end_wait}"

msgctxt "message"
msgid "05651"
msgstr "Non ho mai creduto a{line_break}quelle storie, ma{line_break}questa è la prova!{end_wait}"

msgctxt "message"
msgid "05652"
msgstr "Colui che onora il{line_break}cuore della dea dovrà{line_break}stare al centro di tutto,{page_break}come un cigno al centro{line_break}di uno laghetto{line_break}increspato.{end_wait}"

msgctxt "message"
msgid "05653"
msgstr "Colui che onora la dea{line_break}degli arcobaleni sarà{page_break}portato in cielo su ali{line_break}di liquida grazia.{end_wait}"

msgctxt "message"
msgid "05654"
msgstr "La porta è sbarrata.{end_wait}"

msgctxt "message"
msgid "05655"
msgstr "L'acqua sgorga copiosa{line_break}dalla fonte.{end_wait}"

msgctxt "message"
msgid "05656"
msgstr "La fonte sembra secca.{end_wait}"

msgctxt "message"
msgid "05657"
msgstr "Vi sono strane{line_break}forze... Non si può{line_break}proseguire.{end_wait}"

msgctxt "message"
msgid "05658"
msgstr "{argument_actor_name:1} riceve{line_break}{argument_item_name:2}.{end_wait}"

msgctxt "message"
msgid "05659"
msgstr "Per favore, non nascondetemi{line_break}nulla! Voglio sapere{line_break}tutta la verità!{end_now}"

msgctxt "message"
msgid "05660"
msgstr "Il Faro di Mercurio{line_break}è illuminato.{page_break}{actor_name:4} ci lascerà{line_break}presto, vero?{end_wait}"

msgctxt "message"
msgid "05661"
msgstr "Imil non avrà problemi.{line_break}L'Acqua magica può{line_break}sconfiggere ogni malattia.{end_wait}"

msgctxt "message"
msgid "05662"
msgstr "Uno,{pause_20_skippable} due,{pause_20_skippable} tre,{pause_20_skippable} quattro...{end_wait}"

msgctxt "message"
msgid "05663"
msgstr "Mi stavo allenando con{line_break}impegno per poter{line_break}affrontare ogni malattia...{page_break}Ma ora nella fonte del{line_break}faro c'è di nuovo acqua?{end_now}"

msgctxt "message"
msgid "05664"
msgstr "E allora, a che è servito{line_break}tanto allenamento?{end_wait}"

msgctxt "message"
msgid "05665"
msgstr "Non è possibile! Sono tutti{line_break}in perfetta salute!{end_wait}"

msgctxt "message"
msgid "05666"
msgstr "{actor_name:4} era ad Imil per{line_break}il faro. Ora che è stato{page_break}illuminato, credo proprio{line_break}che se n'andrà.{end_wait}"

msgctxt "message"
msgid "05667"
msgstr "Non ti preoccupare,{line_break}{actor_name:4}. Proteggeremo{line_break}noi il villaggio!{end_wait}"

msgctxt "message"
msgid "05668"
msgstr "Ora che ho abbassato la{line_break}guardia ho già i sudori{line_break}freddi.{page_break}Dovrei bere un po'{line_break}dell'acqua di{line_break}quella fonte.{end_wait}"

msgctxt "message"
msgid "05669"
msgstr "Grazie all'acqua della fonte{line_break}il nonno è in gran forma!{end_wait}"

msgctxt "message"
msgid "05670"
msgstr "Davvero ho detto che{line_break}pensavo di morire per{line_break}quella malattia?{end_now}"

msgctxt "message"
msgid "05671"
msgstr "Ah ah ah! Allora vuol{line_break}dire che stavo{line_break}proprio male!{page_break}Vivrò almeno altri{line_break}trent'anni!{pause_20_skippable} ...Ora{line_break}torno al lavoro!{end_wait}"

msgctxt "message"
msgid "05672"
msgstr "È vero! Sono il{line_break}vecchio più forte{line_break}di Imil!{end_wait}"

msgctxt "message"
msgid "05673"
msgstr "Ora il nonno sta{line_break}meglio, grazie all'acqua{line_break}di quella fonte.{end_wait}"

msgctxt "message"
msgid "05674"
msgstr "Ora {actor_name:4} può{line_break}lasciare il villaggio{line_break}senza preoccupazioni.{end_wait}"

msgctxt "message"
msgid "05675"
msgstr "È bello che la fonte possa{line_break}farci guarire, ma {actor_name:4}{line_break}era... speciale.{end_wait}"

msgctxt "message"
msgid "05676"
msgstr "Quella luce blu che{line_break}emanava dalle mani...{line_break}Sarà stata un angelo?{end_wait}"

msgctxt "message"
msgid "05677"
msgstr "Devo recuperare il{line_break}lavoro perduto!{line_break}È tempo d'affari!{end_wait}"

msgctxt "message"
msgid "05678"
msgstr "I clienti non sono certo{line_break}molti, ma non posso perderne{line_break}neppure uno!{end_wait}"

msgctxt "message"
msgid "05679"
msgstr "È un peccato aver tenuto{line_break}chiuso il negozio{line_break}per un raffreddore.{end_wait}"

msgctxt "message"
msgid "05680"
msgstr "Sono tornati i clienti!{line_break}Credevo davvero di averli{line_break}persi tutti!{end_wait}"

msgctxt "message"
msgid "05681"
msgstr "Grazie alla fontana,{line_break}sono di nuovo in forma!{line_break}Posso tornare al lavoro!{end_wait}"

msgctxt "message"
msgid "05682"
msgstr "Che bello! La mia mammina{line_break}sta di nuovo bene!{end_wait}"

msgctxt "message"
msgid "05683"
msgstr "{actor_name:4} diceva che il{line_break}faro non doveva essere{line_break}acceso.{page_break}Ma l'accensione è stata{line_break}la salvezza di Imil!{end_wait}"

msgctxt "message"
msgid "05684"
msgstr "Mio padre è ancora a Kolima.{line_break}Spero che torni{line_break}presto!{end_wait}"

msgctxt "message"
msgid "05685"
msgstr "È quasi ora che tu{line_break}parta, vero?{end_now}"

msgctxt "message"
msgid "05686"
msgstr "La leggenda era vera:{line_break}l'acqua è iniziata a sgorgare{line_break}appena s'è accesa la lanterna.{page_break}E adesso, Imil non dovrà{line_break}più temere alcuna{line_break}malattia!{end_wait}"

msgctxt "message"
msgid "05687"
msgstr "Ehi! Stasera vi farò{line_break}una cena da re!{end_wait}"

msgctxt "message"
msgid "05688"
msgstr "Grazie al cielo, la città{line_break}è tornata alla normalità.{end_wait}"

msgctxt "message"
msgid "05689"
msgstr "È un bene che il faro si sia{line_break}acceso e l'acqua sgorghi{line_break}di nuovo dalla fonte.{page_break}Ma è un peccato che {actor_name:4}{line_break}se ne stia andando...{end_wait}"

msgctxt "message"
msgid "05690"
msgstr "{actor_name:4} se ne{line_break}andrà con voi...{page_break}Avrei voluto che{line_break}restasse più a lungo...{end_wait}"

msgctxt "message"
msgid "05691"
msgstr "Sono giunti nel villaggio{line_break}e ora l'acqua sgorga{line_break}di nuovo dalla fonte.{page_break}Deve averli mandati{line_break}il cielo!{end_wait}"

msgctxt "message"
msgid "05692"
msgstr "Non ho mai detto a {actor_name:4}{line_break}che mi piaceva...{page_break}Ma in fondo, è{line_break}meglio così.{end_wait}"

msgctxt "message"
msgid "05693"
msgstr "{actor_name:4}...{end_wait}"

msgctxt "message"
msgid "05694"
msgstr "Pensavamo che non saresti{line_break}più tornata...{end_wait}"

msgctxt "message"
msgid "05695"
msgstr "O meglio, che non{line_break}sareste più tornati...{end_wait}"

msgctxt "message"
msgid "05696"
msgstr "{actor_name:4}, c'è un problema!{line_break}Qualcuno ha acceso il Faro{line_break}di Mercurio!{end_wait}"

msgctxt "message"
msgid "05697"
msgstr "{actor_name:4}, già lo sapevi?{end_wait}"

msgctxt "message"
msgid "05698"
msgstr "Che succede?{pause_20_skippable}{line_break}Ti vedo strana{line_break}oggi, {actor_name:4}...{end_wait}"

msgctxt "message"
msgid "05699"
msgstr "Io...{pause_20_skippable}{line_break}Devo proprio dirtelo?{end_wait}"

msgctxt "message"
msgid "05700"
msgstr "Devi dirmi qualcosa?{line_break}Che cosa?{end_wait}"

msgctxt "message"
msgid "05701"
msgstr "Beh, {pause_20_skippable}I... Ecco...{end_wait}"

msgctxt "message"
msgid "05702"
msgstr "Io...{pause_20_skippable} Seguirò{line_break}{actor_name:1} nella sua avventura.{end_wait}"

msgctxt "message"
msgid "05703"
msgstr "Andarmene è molto{line_break}difficile per me, ma{pause_20_skippable}{line_break}è per il faro.{end_wait}"

msgctxt "message"
msgid "05704"
msgstr "Hai detto che se il faro fosse{line_break}stato acceso l'umanità sarebbe{line_break}stata in pericolo, vero?{end_wait}"

msgctxt "message"
msgid "05705"
msgstr "È per questo che sei{line_break}in partenza? Per{line_break}proteggere il mondo?{end_wait}"

msgctxt "message"
msgid "05706"
msgstr "Sì.{pause_20_skippable} È vero...{end_wait}"

msgctxt "message"
msgid "05707"
msgstr "Allora non possiamo{line_break}farci nulla...{end_wait}"

msgctxt "message"
msgid "05708"
msgstr "Beh, allora non{line_break}cercheremo di trattenerti.{page_break}Dopo tutto stai cercando{line_break}di proteggere la{line_break}Cerchia di Mercurio.{end_wait}"

msgctxt "message"
msgid "05709"
msgstr "Sì.{pause_20_skippable} È vero...{end_wait}"

msgctxt "message"
msgid "05710"
msgstr "Come membri della Cerchia{line_break}di Mercurio proteggeremo{line_break}da soli Imil.{page_break}Non ti preoccupare!{end_wait}"

msgctxt "message"
msgid "05711"
msgstr "Cercherò di diventare{line_break}un bravo guaritore{line_break}come te, {actor_name:4}!{end_wait}"

msgctxt "message"
msgid "05712"
msgstr "Va bene, lascio il villaggio{line_break}nelle vostre mani,{line_break}Megan, Justin...{end_wait}"

msgctxt "message"
msgid "05713"
msgstr "Possiamo partire senza{line_break}preoccupazioni, vero?{end_wait}"

msgctxt "message"
msgid "05714"
msgstr "Io sarò il guaritore, perché{line_break}so come si fa, va bene?{end_wait}"

msgctxt "message"
msgid "05715"
msgstr "{actor_name:4} sta partendo{line_break}insieme a voi, vero?{page_break}Ciò mi rattrista molto,{line_break}ma farò del mio meglio per{line_break}essere un buon guaritore.{end_wait}"

msgctxt "message"
msgid "05716"
msgstr "Io sarò una brava ragazza,{line_break}proprio come {actor_name:4}.{page_break}Un giorno, dovrete tornare{line_break}a vedere come sono cresciuta.{line_break}Dovete promettermelo!{end_wait}"

msgctxt "message"
msgid "05717"
msgstr "{actor_name:4} difenderà{line_break}l'onore della Cerchia{line_break}di Mercurio.{end_wait}"

msgctxt "message"
msgid "05718"
msgstr "Scusa, {actor_name:4}, ma{line_break}non sopporto di{line_break}vederti partire.{end_wait}"

msgctxt "message"
msgid "05719"
msgstr "Se potessi parlare direi{line_break}che siamo a Kolima, il{line_break}villaggio dei boscaioli!{end_wait}"

msgctxt "message"
msgid "05720"
msgstr "Com'è possibile che{line_break}qualcuno abbia trasformato una{line_break}bella ragazza in un albero?{page_break}Beh, almeno sono un{line_break}albero carino.{end_wait}"

msgctxt "message"
msgid "05721"
msgstr "È un sogno...{line_break}Dev'essere un sogno...{end_wait}"

msgctxt "message"
msgid "05722"
msgstr "È orribile...{line_break}Odio non potermi muovere!{end_wait}"

msgctxt "message"
msgid "05723"
msgstr "Ho vissuto abbastanza...{line_break}Non mi dispiace neppure{line_break}di essere un albero.{page_break}Mi dispiace soltanto per{line_break}tutti quei bambini{line_break}trasformati in alberi.{end_wait}"

msgctxt "message"
msgid "05724"
msgstr "È la maledizione dell'albero{line_break}sacro! Perché mai hanno{line_break}tentato di tagliare Tret?{end_wait}"

msgctxt "message"
msgid "05725"
msgstr "L'acqua ai miei piedi...{line_break}{pause_20_skippable}Huh?{pause_20_skippable} È{pause_20_skippable} deliziosa!{end_wait}"

msgctxt "message"
msgid "05726"
msgstr "Se non posso muovermi,{line_break}come fa la mia mamma a{line_break}mettermi a letto?{end_wait}"

msgctxt "message"
msgid "05727"
msgstr "Che hanno da guardare?{line_break}Sembrano incredibilmente{line_break}giovani...{page_break}Non ce la faranno mai{line_break}contro Tret.{end_wait}"

msgctxt "message"
msgid "05728"
msgstr "Ho sognato che un forte{line_break}guerriero con una folta barba{line_break}metteva fine alla maledizione.{page_break}Lo sogno spesso, a{line_break}dire la verità...{end_wait}"

msgctxt "message"
msgid "05729"
msgstr "Che accadrà al mio tesoro{line_break}se resto un albero{line_break}per sempre?{end_wait}"

msgctxt "message"
msgid "05730"
msgstr "Ben presto Kolima non{line_break}sarà che una foresta...{end_wait}"

msgctxt "message"
msgid "05731"
msgstr "Mi chiedo quale sia il{line_break}segreto del padre...{end_wait}"

msgctxt "message"
msgid "05732"
msgstr "Forse siamo diventati alberi{line_break}a causa di tutti quelli{line_break}che abbiamo tagliato.{page_break}Ma stavamo soltanto{line_break}facendo il nostro lavoro.{end_wait}"

msgctxt "message"
msgid "05733"
msgstr "Comunque mio padre non è{line_break}stato il solo ad aver provato{line_break}a tagliare l'albero sacro.{end_wait}"

msgctxt "message"
msgid "05734"
msgstr "L'albero sacro di Kolima{line_break}ha grandi poteri, proprio{line_break}come ha detto il padre.{end_wait}"

msgctxt "message"
msgid "05735"
msgstr "Un tempo fabbricavo le{line_break}armi dal legno. E adesso sono{line_break}io ad essere di legno...{page_break}È buffa{line_break}la vita...{end_wait}"

msgctxt "message"
msgid "05736"
msgstr "Ehi... Trasformandomi{line_break}qui dentro... non diventerò{line_break}mai un albero alto...{end_wait}"

msgctxt "message"
msgid "05737"
msgstr "No! Non voglio{line_break}restare un albero{line_break}per sempre!{end_wait}"

msgctxt "message"
msgid "05738"
msgstr "Forse, meditando{line_break}intensamente tornerò{line_break}ad essere un umano...{page_break}Mmmh{pause_20_skippable} Mmmh!!!{pause_20_skippable} MMMH!!!{end_wait}"

msgctxt "message"
msgid "05739"
msgstr "Chi ha causato tutto{line_break}questo? Qualcuno deve aver{line_break}provato a tagliare Tret!{end_wait}"

msgctxt "message"
msgid "05740"
msgstr "Come faccio a farmi pagare{line_break}per le stanze se sono{line_break}un albero!?{end_wait}"

msgctxt "message"
msgid "05741"
msgstr "La gente del villaggio{line_break}aveva ragione. Non avrei{line_break}mai dovuto provare a{page_break}tagliare quell'albero.{line_break}Non rivedrò mai più la{line_break}mia famiglia a Imil...{end_wait}"

msgctxt "message"
msgid "05742"
msgstr "Se soltanto avessi lasciato{line_break}la città un giorno prima...{line_break}Ma la stanza mi piaceva!{end_wait}"

msgctxt "message"
msgid "05743"
msgstr "Questa è Kolima, un{line_break}villaggio di boscaioli!{line_break}Lo voglio gridare a tutti!{page_break}Questa{pause_20_skippable} è{pause_20_skippable} Ko{pause_20_skippable}li{pause_20_skippable}ma!{end_wait}"

msgctxt "message"
msgid "05744"
msgstr "Dipendiamo così tanto{line_break}dai boschi, e ciononostante{line_break}abbiamo ferito l'albero sacro!{page_break}Forse ora possiamo lavorare{line_break}per riportare l'armonia{line_break}nella foresta.{end_wait}"

msgctxt "message"
msgid "05745"
msgstr "Sai, essere un albero{line_break}ti lascia molto{line_break}tempo per pensare.{end_wait}"

msgctxt "message"
msgid "05746"
msgstr "Mi trasformai in albero{line_break}quando caddero quelle{line_break}scintille dal cielo.{end_wait}"

msgctxt "message"
msgid "05747"
msgstr "È normale che la gente del{line_break}villaggio sia attratta{line_break}dai soldi di McCoy...{page_break}Una tale somma{line_break}tenterebbe chiunque.{end_wait}"

msgctxt "message"
msgid "05748"
msgstr "Ma a chi può venire in{line_break}mente di usare l'albero sacro{line_break}per costruirsi un palazzo?{end_wait}"

msgctxt "message"
msgid "05749"
msgstr "Non mi dispiaceva{line_break}essere un albero...{page_break}L'acqua aveva così{line_break}un buon sapore!{end_wait}"

msgctxt "message"
msgid "05750"
msgstr "Uaaah... Gli alberi sono{line_break}così... assonnati...{end_wait}"

msgctxt "message"
msgid "05751"
msgstr "Ad un certo punto ho creduto{line_break}che non l'avrei mai potuto{line_break}dire, ma devo dirlo!{page_break}Ho atteso una vita intera{line_break}che arrivasse questo momento!{end_wait}"

msgctxt "message"
msgid "05752"
msgstr "Gli alberi della foresta sono{line_break}vivi, proprio come noi...{end_wait}"

msgctxt "message"
msgid "05753"
msgstr "Forse, se fossi ancora{line_break}un albero potrei vivere{line_break}più a lungo.{end_wait}"

msgctxt "message"
msgid "05754"
msgstr "Se rivedo cadere quelle{line_break}scintille scappo sulle{line_break}colline.{end_wait}"

msgctxt "message"
msgid "05755"
msgstr "Ho sempre vissuto in{page_break}povertà... Ecco perché mi{line_break}infastidisce che McCoy pensi{line_break}di risolvere tutto coi soldi.{end_wait}"

msgctxt "message"
msgid "05756"
msgstr "Non per niente è{line_break}chiamato albero sacro...{page_break}Avremmo dovuto stare{line_break}più attenti...{end_wait}"

msgctxt "message"
msgid "05757"
msgstr "Se fossimo tutti alberi{line_break}non ci sarebbero più guerre:{pause_20_skippable}{line_break}chi potrebbe combatterle?{end_wait}"

msgctxt "message"
msgid "05758"
msgstr "Se sei un albero nessuno{line_break}ti può sgridare...{page_break}E nessuno ti manda a{line_break}letto presto!{end_wait}"

msgctxt "message"
msgid "05759"
msgstr "Ho sentito che dei viaggiatori{line_break}provenienti dalla Grotta di{line_break}Goma hanno salvato il villaggio.{page_break}Si dice che quei{line_break}viaggiatori siano enormi{line_break}e fortissimi...{page_break}Pare che abbiano sconfitto{line_break}Tret e tolto la maledizione...{end_wait}"

msgctxt "message"
msgid "05760"
msgstr "Dei grandi guerrieri con{line_break}folte barbe hanno liberato{line_break}Kolima dalla maledizione.{page_break}se li vedete, salutateli{line_break}da parte mia.{end_wait}"

msgctxt "message"
msgid "05761"
msgstr "Non ne sono certo, ma{line_break}credo che possiate{line_break}riconoscere i viaggiatori.{end_wait}"

msgctxt "message"
msgid "05762"
msgstr "Tutti i viaggiatori{line_break}sono grossi e hanno{line_break}enormi barbe.{end_wait}"

msgctxt "message"
msgid "05763"
msgstr "Avete salvato Kolima!{line_break}Grandi! Allora potrei{line_break}dirvi un segreto!{page_break}No, non ve lo dico...{line_break}Ho cambiato idea!{end_wait}"

msgctxt "message"
msgid "05764"
msgstr "Credo che mio marito{line_break}mi stia nascondendo{line_break}un segreto.{end_wait}"

msgctxt "message"
msgid "05765"
msgstr "Papà mi ha detto il segreto.{end_wait}"

msgctxt "message"
msgid "05766"
msgstr "È nascosto nel cuore della{line_break}foresta, ma non posso{line_break}certo dirglielo!{end_wait}"

msgctxt "message"
msgid "05767"
msgstr "Credo che abbia trovato{line_break}qualcosa di prezioso, ma{line_break}dove lo starà nascondendo?{end_wait}"

msgctxt "message"
msgid "05768"
msgstr "Ma sapere che si trova{line_break}fuori dal villaggio non{line_break}mi aiuta un granché...{end_wait}"

msgctxt "message"
msgid "05769"
msgstr "Non userò mai più un'ascia{line_break}in tutta la mia vita.{end_wait}"

msgctxt "message"
msgid "05770"
msgstr "Papà, torna ad essere{line_break}un boscaiolo, ti{line_break}prego!{end_wait}"

msgctxt "message"
msgid "05771"
msgstr "Papà! Se non lavori, noi{line_break}come mangiamo?{end_wait}"

msgctxt "message"
msgid "05772"
msgstr "Le persone si sono trasformate{line_break}in alberi a causa della mia{line_break}ascia: non la userò mai più!{end_wait}"

msgctxt "message"
msgid "05773"
msgstr "Conosco mio padre: si{line_break}rimetterà a lavorare{line_break}appena avrà fame!{end_wait}"

msgctxt "message"
msgid "05774"
msgstr "Come faccio a{line_break}crescere se non{line_break}mangio?{page_break}Se lui non mi nutre,{line_break}non gli obbedirò!{end_wait}"

msgctxt "message"
msgid "05775"
msgstr "Il Tempio di Fuchin è{line_break}dall'altra parte del fiume.{line_break}È molto famoso.{page_break}Se avete un po' di{line_break}tempo, fateci{line_break}un salto.{end_wait}"

msgctxt "message"
msgid "05776"
msgstr "Il Maestro del Tempio{line_break}di Fuchin, Nyunpa,{line_break}è davvero strano...{end_wait}"

msgctxt "message"
msgid "05777"
msgstr "Il grande ponte che{line_break}attraversa il fiume è{line_break}l'orgoglio di Kolima.{end_wait}"

msgctxt "message"
msgid "05778"
msgstr "È un peccato che abbiamo{line_break}dovuto tagliare tutti quegli{line_break}alberi per costruire il ponte.{end_wait}"

msgctxt "message"
msgid "05779"
msgstr "Quand'ero un albero ho{line_break}imparato ad apprezzare{line_break}la luce del sole.{end_wait}"

msgctxt "message"
msgid "05780"
msgstr "Era così bello sentire{line_break}le mie foglie accarezzate{line_break}dai raggi del sole...{end_wait}"

msgctxt "message"
msgid "05781"
msgstr "Ho sentito che la causa{line_break}dell'orribile incidente è{line_break}l'albero sacro.{page_break}Ma credi davvero che quella{line_break}sia l'unica causa?{end_now}"

msgctxt "message"
msgid "05782"
msgstr "Forse non l'avrai notato,{line_break}ma quando sono cadute quelle{line_break}gemme qualcosa è cambiato...{end_wait}"

msgctxt "message"
msgid "05783"
msgstr "È vero. Qualcosa è cambiato{line_break}con la caduta delle gemme.{end_wait}"

msgctxt "message"
msgid "05784"
msgstr "Se l'albero sacro è{line_break}la causa di tutto{line_break}ciò, allora ho sbagliato io...{page_break}Avrei dovuto impedire{line_break}che gli alberi{line_break}fossero tagliati.{end_wait}"

msgctxt "message"
msgid "05785"
msgstr "Dicono che McCoy abbia{line_break}bloccato la costruzione{line_break}del palazzo. Se non{page_break}c'è più lavoro, tutti i{line_break}boscaioli saranno costretti{line_break}ad andarsene.{end_wait}"

msgctxt "message"
msgid "05786"
msgstr "Ora che è stata interrotta la{line_break}costruzione, Kolima tornerà ad{line_break}essere un pacifico villaggio.{end_wait}"

msgctxt "message"
msgid "05787"
msgstr "Per anni ho fatto il{line_break}boscaiolo, ma non so{line_break}fare altro.{page_break}Me ne andrò a casa dalla{line_break}mia famiglia ad Imil.{end_wait}"

msgctxt "message"
msgid "05788"
msgstr "Sono solo un mercante...{line_break}Mi trovavo qui, così sono{line_break}stato trasformato in un albero.{page_break}Ora che sono tornato un{line_break}uomo, mi dirigerò a{line_break}sud del fiume.{end_wait}"

msgctxt "message"
msgid "05789"
msgstr "Nel villaggio c'era{line_break}davvero molto{line_break}lavoro...{page_break}Ma a che serve, se{line_break}poi sei trasformato{line_break}in un albero?!{end_wait}"

msgctxt "message"
msgid "05790"
msgstr "Un paese tranquillo...{line_break}ma anche povero!{page_break}Speravo che tutto quel{line_break}lavoro facesse di Kolima{line_break}un villaggio ricco.{end_wait}"

msgctxt "message"
msgid "05791"
msgstr "Sono un boscaiolo,{line_break}e questo{pause_20_skippable} mi basta.{end_wait}"

msgctxt "message"
msgid "05792"
msgstr "Se avessi potuto trattenere{line_break}alcune delle gemme che{line_break}cadevano dal cielo...{page_break}Devono valere{line_break}una fortuna!{end_wait}"

msgctxt "message"
msgid "05793"
msgstr "Sono stato un albero{line_break}per un po'...{line_break}Ci crederesti?{end_now}"

msgctxt "message"
msgid "05794"
msgstr "Ora capisco cosa significa{line_break}mettere radici in{line_break}qualche posto.{page_break}Ma non lo raccomanderei{line_break}a nessun altro...{end_wait}"

msgctxt "message"
msgid "05795"
msgstr "Beh, anch'io{line_break}stento a crederci.{end_wait}"

msgctxt "message"
msgid "05796"
msgstr "Benvenuti a Bilibin.{pause_20_skippable}{line_break}Quella storia della maledizione{line_break}sarà presto dimenticata!{end_wait}"

msgctxt "message"
msgid "05797"
msgstr "Se parli dei viaggiatori{line_break}di Imil, credo che abbiano{line_break}attraversato il fiume...{end_wait}"

msgctxt "message"
msgid "05798"
msgstr "Come, che fine ha fatto{line_break}quell'albero vicino{line_break}all'ingresso del villaggio?{page_break}Grazie al cielo,{line_break}è di nuovo una{line_break}persona!{end_wait}"

msgctxt "message"
msgid "05799"
msgstr "Era tanto che non vedevo{line_break}Lord McCoy, il capo{line_break}di Bilibin, camminare{page_break}per le strade{line_break}del villaggio...{page_break}Sarà felice, ora che{line_break}la maledizione è{line_break}stata vinta.{end_wait}"

msgctxt "message"
msgid "05800"
msgstr "Pare che il cancello della{line_break}palizzata che bloccava la{line_break}strada per Kolima sia riaperto.{end_wait}"

msgctxt "message"
msgid "05801"
msgstr "In tutta quella confusione{line_break}per la maledizione, quei{line_break}tre bambini sono scomparsi.{end_wait}"

msgctxt "message"
msgid "05802"
msgstr "La maledizione è stata{line_break}vinta grazie a tre{line_break}valorosi guerrieri.{page_break}Ma siete voi,{line_break}per caso?{end_now}"

msgctxt "message"
msgid "05803"
msgstr "Incredibile! Ci avete liberato{line_break}voi dalla maledizione!{end_wait}"

msgctxt "message"
msgid "05804"
msgstr "Lo immaginavo. Non{line_break}sembrate tanto{line_break}forti!{end_wait}"

msgctxt "message"
msgid "05805"
msgstr "Gli uomini di Lord McCoy{line_break}dicono di aver visto quelli{line_break}che hanno salvato il villaggio.{end_wait}"

msgctxt "message"
msgid "05806"
msgstr "Siete mai stati nel{line_break}villaggio di Imil,{line_break}su a nord?{end_now}"

msgctxt "message"
msgid "05807"
msgstr "Avete visto il grande{line_break}faro che è là?{line_break}Dev'essere stupendo!{end_wait}"

msgctxt "message"
msgid "05808"
msgstr "Se capitate da quelle parti,{line_break}vi consiglio di{line_break}visitarlo.{end_wait}"

msgctxt "message"
msgid "05809"
msgstr "Pare che l'eruzione dall'{line_break}altra parte delle montagne{line_break}si sia placata finalmente.{page_break}Ora funziona di nuovo{line_break}tutto perfettamente.{end_wait}"

msgctxt "message"
msgid "05810"
msgstr "Ora che è terminata la{line_break}maledizione, perché non{line_break}riprendiamo a costruire?{end_wait}"

msgctxt "message"
msgid "05811"
msgstr "È finita! Il signore ha{line_break}deciso di non costruire{line_break}il palazzo.{end_wait}"

msgctxt "message"
msgid "05812"
msgstr "Aaah! Il mio palazzo non{line_break}è stato finito! McCoy vuol{page_break}più bene a quell'{line_break}albero sacro{line_break}che a me!{end_wait}"

msgctxt "message"
msgid "05813"
msgstr "Non voglio ridiventare un{line_break}albero mai più!{line_break}È terribile...{end_wait}"

msgctxt "message"
msgid "05814"
msgstr "Non sono più molti i boscaioli{line_break}che vogliono tagliare{line_break}alberi a Kolima.{end_wait}"

msgctxt "message"
msgid "05815"
msgstr "Una delle due persone che{line_break}sono venute qui oggi{line_break}era ferita, probabilmente...{end_wait}"

msgctxt "message"
msgid "05816"
msgstr "Se mi avvicino, quel{line_break}ragazzo potrebbe{line_break}trasformarsi in un albero...{end_wait}"

msgctxt "message"
msgid "05817"
msgstr "Pare che Lord McCoy stia{line_break}avendo un bisticcio con la{line_break}moglie... Chi la spunterà?{end_wait}"

msgctxt "message"
msgid "05818"
msgstr "Sembra che chiunque{line_break}possa scavalcare quella{line_break}palizzata.{end_wait}"

msgctxt "message"
msgid "05819"
msgstr "\"La Cerchia dei Tre\"? Mah!{line_break}Staranno perdendo tempo{line_break}chissà dove...{end_wait}"

msgctxt "message"
msgid "05820"
msgstr "Lord McCoy vi darà{line_break}un'ottima ricompensa!{line_break}Chissà di che si tratta...{end_wait}"

msgctxt "message"
msgid "05821"
msgstr "Credo che stiano riferendo{line_break}a Lord McCoy le vostre{line_break}imprese!{end_wait}"

msgctxt "message"
msgid "05822"
msgstr "Vorrei condividere con{line_break}voi la gioia che provo{line_break}in questo momento!{end_wait}"

msgctxt "message"
msgid "05823"
msgstr "Finché sto bene, non{line_break}m'importa nulla di ciò{line_break}che accade agli altri.{end_wait}"

msgctxt "message"
msgid "05824"
msgstr "Se non avessimo provato{line_break}ad usare l'albero magico{line_break}per la costruzione, a{page_break}quest'ora avremmo{line_break}ancora un lavoro...{end_wait}"

msgctxt "message"
msgid "05825"
msgstr "C'eravamo quasi!{page_break}Costruire un palazzo{line_break}maledetto sarebbe stata{line_break}un'ottima esperienza!{end_wait}"

msgctxt "message"
msgid "05826"
msgstr "Ha detto di aver bloccato{line_break}la costruzione a causa{line_break}della maledizione...{page_break}Ma credo che stia solo{line_break}cercando di non mantenere{line_break}la sua promessa!{end_wait}"

msgctxt "message"
msgid "05827"
msgstr "Sapete se l'albero{line_break}sacro è sopravvissuto?{end_now}"

msgctxt "message"
msgid "05828"
msgstr "Ma certo! Ecco perché la{line_break}gente tramutata in albero{line_break}è tornata normale.{page_break}Sapevo che l'albero{line_break}sacro della Foresta di{line_break}Kolima era sopravvissuto!{end_wait}"

msgctxt "message"
msgid "05829"
msgstr "Ma allora, com'è che quelli che{line_break}erano stati trasformati in{line_break}alberi sono tornati normali?{page_break}Ma allora, è stata solo{line_break}la nostra immaginazione?{end_wait}"

msgctxt "message"
msgid "05830"
msgstr "Grazie al cielo, la{line_break}costruzione del palazzo è{line_break}stata interrotta.{page_break}Ma ciò non è piaciuto{line_break}a Lady McCoy.{end_wait}"

msgctxt "message"
msgid "05831"
msgstr "Ci vogliono parecchi{line_break}anni perché un albero{line_break}diventi sacro.{page_break}Nessuno potrebbe mai{line_break}pensare di abbattere un{line_break}albero così prezioso.{end_wait}"

msgctxt "message"
msgid "05832"
msgstr "A volte penso che mi{line_break}sarebbe piaciuto vedere{line_break}quel palazzo terminato.{end_wait}"

msgctxt "message"
msgid "05833"
msgstr "D'inverno, Altin mi{line_break}manca...{page_break}Ho lavorato nelle miniere{line_break}di quella città, e gli{line_break}inverni erano così miti...{end_wait}"

msgctxt "message"
msgid "05834"
msgstr "Mio padre dice che dall'{line_break}altra parte del fiume il clima{line_break}è mite tutto l'anno.{end_wait}"

msgctxt "message"
msgid "05835"
msgstr "Chissà se ci sono ancora{line_break}belle gemme nella{line_break}Miniera di Altin...{end_wait}"

msgctxt "message"
msgid "05836"
msgstr "Mio padre ha viaggiato{line_break}in tutto il mondo.{end_wait}"

msgctxt "message"
msgid "05837"
msgstr "La strada per Kolima è{line_break}stata riaperta. Finalmente{line_break}possiamo proseguire.{end_wait}"

msgctxt "message"
msgid "05838"
msgstr "Sai cos'è la seta?{end_now}"

msgctxt "message"
msgid "05839"
msgstr "È quel materiale che fanno{line_break}nel villaggio di Xian, dall'{line_break}altra parte del fiume.{page_break}La lunga strada che parte{line_break}da lì si chiama Strada{line_break}della Seta.{end_wait}"

msgctxt "message"
msgid "05840"
msgstr "Su foglie di gelso si{line_break}allevano i bachi.{page_break}Quando i bachi escono{line_break}dai loro bozzoli, formano{line_break}fili di seta.{page_break}Poi, i fili vengono{line_break}trasformati in tessuti{line_break}con cui si fanno i vestiti{page_break}della gente ricca come{line_break}Lady McCoy.{end_wait}"

msgctxt "message"
msgid "05841"
msgstr "Viaggiando, i giovani{line_break}guerrieri si rafforzano.{end_wait}"

msgctxt "message"
msgid "05842"
msgstr "Gli abiti di seta sono{line_break}morbidi e sgargianti.{end_wait}"

msgctxt "message"
msgid "05843"
msgstr "M'è parso di vedere delle{line_break}luci nel cielo verso Imil,{line_break}la notte scorsa.{page_break}Sarà stato quel{line_break}faro leggendario?{end_wait}"

msgctxt "message"
msgid "05844"
msgstr "Ha gli occhi rossi perché{line_break}è rimasto in piedi per{line_break}tutta la notte.{end_wait}"

msgctxt "message"
msgid "05845"
msgstr "Non c'è alcun dubbio!{line_break}È la luce del faro vicino{line_break}ad Imil.{end_wait}"

msgctxt "message"
msgid "05846"
msgstr "E allora?{line_break}In fondo, è solo{line_break}un faro!{end_wait}"

msgctxt "message"
msgid "05847"
msgstr "Le nostre armi sono le{line_break}migliori...{page_break}Ma anche la bottega{line_break}di Altin non è male,{line_break}di là dal fiume.{end_wait}"

msgctxt "message"
msgid "05848"
msgstr "Ad Altin hanno buone armi,{line_break}ma credo proprio che le{line_break}nostre siano migliori.{end_wait}"

msgctxt "message"
msgid "05849"
msgstr "Pensare all'oceano{line_break}mi riempie sempre di{line_break}speranze e desideri...{page_break}Se mai lo vedrete, pensate{line_break}un po' anche a me, che{line_break}lo sogno sempre.{end_wait}"

msgctxt "message"
msgid "05850"
msgstr "Vorrei navigare sull'{line_break}oceano! Forse dovrei{line_break}partire per un bel viaggio...{page_break}Ma purtroppo... non ne{line_break}ho il coraggio.{end_wait}"

msgctxt "message"
msgid "05851"
msgstr "Tutti i guerrieri mandati da{line_break}Lord McCoy si sono rivelati{line_break}inutili!{page_break}Tranne quelli che ci hanno{line_break}liberato dalla maledizione,{line_break}naturalmente.{end_wait}"

msgctxt "message"
msgid "05852"
msgstr "Dicono di essere{line_break}guerrieri...{page_break}Ma non si può contare{line_break}su di loro nel momento{line_break}del bisogno!{end_wait}"

msgctxt "message"
msgid "05853"
msgstr "La maledizione di Kolima è{line_break}stata spaventosa, eh?{end_now}"

msgctxt "message"
msgid "05854"
msgstr "Persino gli eroi come voi{line_break}hanno paura, a volte.{page_break}Pensa un po' come potevamo{line_break}esserne terrorizzati noi{line_break}comuni cittadini!{end_wait}"

msgctxt "message"
msgid "05855"
msgstr "Lo dici ora perché è{line_break}tutto finito.{page_break}Ma quando è successo,{line_break}eravamo tutti{line_break}terrorizzati.{end_wait}"

msgctxt "message"
msgid "05856"
msgstr "Ora che è finito tutto{line_break}avremo senz'altro{line_break}meno clienti.{page_break}Non ci hanno fatto un{line_break}grande favore, liberandoci{line_break}dalla maledizione...{end_wait}"

msgctxt "message"
msgid "05857"
msgstr "Due minestre! Tre stufati!{line_break}Un panino! Un dessert!{line_break}Dai, dai!{end_wait}"

msgctxt "message"
msgid "05858"
msgstr "Ehi, tu! Hai{line_break}finito?{end_wait}"

msgctxt "message"
msgid "05859"
msgstr "Quasi...{end_wait}"

msgctxt "message"
msgid "05860"
msgstr "Se volete mangiare,{line_break}parlate con la cameriera.{end_wait}"

msgctxt "message"
msgid "05861"
msgstr "Il capocuoco è davvero{line_break}cambiato!{line_break}È così attivo!{end_wait}"

msgctxt "message"
msgid "05862"
msgstr "Non riesco a stargli{line_break}dietro: ha troppa energia!{end_wait}"

msgctxt "message"
msgid "05863"
msgstr "Servi l'acqua a quei{line_break}signori... Poi prendi{line_break}l'argenteria.{end_wait}"

msgctxt "message"
msgid "05864"
msgstr "Se qualcuno rallenta, il{line_break}capocuoco lancia degli urli...{end_wait}"

msgctxt "message"
msgid "05865"
msgstr "È straordinario come il{line_break}capocuoco si stia{line_break}dando daffare!{end_wait}"

msgctxt "message"
msgid "05866"
msgstr "Qui gli affari{line_break}scarseggiano... Attraverserò{line_break}il fiume verso Xian.{page_break}Forse percorrerò la Strada{line_break}della Seta fino a Tolbi.{end_wait}"

msgctxt "message"
msgid "05867"
msgstr "Oggi le porzioni{line_break}sono enormi!{page_break}Se non le diminuiscono{line_break}andranno{line_break}in rovina!{end_wait}"

msgctxt "message"
msgid "05868"
msgstr "Che pasto da re!{line_break}Hanno un cibo{line_break}favoloso, vero?{end_now}"

msgctxt "message"
msgid "05869"
msgstr "So che avete fame...{line_break}Andatevi a cercare un{line_break}tavolo e ingozzatevi!{end_wait}"

msgctxt "message"
msgid "05870"
msgstr "Ma che ci sto a fare a{line_break}parlare con voi,{line_break}invece di mangiare!?{end_wait}"

msgctxt "message"
msgid "05871"
msgstr "Ooooh...{pause_20_skippable} Basta...{line_break}Vorrei mangiare ancora,{line_break}ma non mi ci sta più nulla...{end_wait}"

msgctxt "message"
msgid "05872"
msgstr "L'incidente è stato risolto{line_break}prima del previsto...{page_break}Forse dovrò andare a{line_break}cercarmi un lavoro{line_break}verso sud.{end_wait}"

msgctxt "message"
msgid "05873"
msgstr "Mi chiedo cosa fosse{line_break}quell'urlo sinistro che{line_break}proveniva da sud del fiume...{page_break}Mi ha fatto venire{line_break}i brividi!{end_wait}"

msgctxt "message"
msgid "05874"
msgstr "Ho fatto finta di avere paura{line_break}per potere entrare.{line_break}Ma stavo fingendo...{end_wait}"

msgctxt "message"
msgid "05875"
msgstr "Per i miei affari, sarebbe{line_break}stato meglio se la maledizione{line_break}fosse continuata ancora un po'.{end_wait}"

msgctxt "message"
msgid "05876"
msgstr "Andrò a Kolima quando non{line_break}avrò più clienti.{page_break}Ma nel frattempo penso{line_break}soltanto a cucinare{line_break}di tutto!{end_wait}"

msgctxt "message"
msgid "05877"
msgstr "Vediamo... minestra...{line_break}insalata... e... stavo{line_break}scordando il condimento.{end_wait}"

msgctxt "message"
msgid "05878"
msgstr "Fino a poco fa il capocuoco{line_break}era incredibilmente pigro...{line_break}Ora, invece, improvvisamente,{page_break}è talmente attivo che non{line_break}si riesce a stare al{line_break}suo passo.{end_wait}"

msgctxt "message"
msgid "05879"
msgstr "Un tempo ci mettevano così{line_break}tanto a servirti... Ora{line_break}fanno in un attimo!{end_wait}"

msgctxt "message"
msgid "05880"
msgstr "Da quando hanno bloccato la{line_break}costruzione non ho più{line_break}fatto affari.{page_break}Magari comprerò della seta a{line_break}Tolbi per venderla a Xian.{end_wait}"

msgctxt "message"
msgid "05881"
msgstr "Come vorrei mangiare così{line_break}tutti i giorni...{end_wait}"

msgctxt "message"
msgid "05882"
msgstr "È meglio mangiare finché{line_break}si può... Non credo che quel{line_break}cuoco resisterà a lungo...{end_wait}"

msgctxt "message"
msgid "05883"
msgstr "Il cibo è così buono,{line_break}e costa così poco!{end_wait}"

msgctxt "message"
msgid "05884"
msgstr "Se un bambino così ha potuto{line_break}liberarci dalla maledizione,{line_break}potevo farlo anch'io.{end_wait}"

msgctxt "message"
msgid "05885"
msgstr "Nel mondo stanno{line_break}accadendo cose{line_break}spaventose...{end_wait}"

msgctxt "message"
msgid "05886"
msgstr "La maledizione è finita,{line_break}ma non è ancora il momento{line_break}di abbassare la guardia.{page_break}Viaggiare fuori dalla{line_break}città è ancora{line_break}poco sicuro.{end_wait}"

msgctxt "message"
msgid "05887"
msgstr "Visto? I nostri desideri{line_break}ora sono realtà!{end_wait}"

msgctxt "message"
msgid "05888"
msgstr "Vi sono molti più{line_break}segnali di pericolo ora{line_break}rispetto al passato.{end_wait}"

msgctxt "message"
msgid "05889"
msgstr "Finché continueremo a{line_break}meditare, sarà preservata{line_break}la pace.{end_wait}"

msgctxt "message"
msgid "05890"
msgstr "Oh!{pause_20_skippable} Ma è...{end_wait}"

msgctxt "message"
msgid "05891"
msgstr "Oh! Signore!{end_wait}"

msgctxt "message"
msgid "05892"
msgstr "Ti abbiamo cercato{line_break}ovunque!{end_wait}"

msgctxt "message"
msgid "05893"
msgstr "La maledizione dell'albero{line_break}sacro... {pause_20_skippable}Ce ne avete{line_break}liberato voi, vero?{end_now}"

msgctxt "message"
msgid "05894"
msgstr "Non è vero! Ci sono testimoni{line_break}che vi hanno visto{line_break}nella foresta!{end_wait}"

msgctxt "message"
msgid "05895"
msgstr "Siete stati voi, vero?{end_now}"

msgctxt "message"
msgid "05896"
msgstr "Siete in arresto!{end_wait}"

msgctxt "message"
msgid "05897"
msgstr "Andate.{line_break}Lord McCoy v'aspetta.{end_wait}"

msgctxt "message"
msgid "05898"
msgstr "Mio signore, ti abbiamo{line_break}portato i guerrieri.{end_wait}"

msgctxt "message"
msgid "05899"
msgstr "Mio signore, abbiamo portato{line_break}i guerrieri, come hai ordinato.{end_wait}"

msgctxt "message"
msgid "05900"
msgstr "Ah, ma{pause_20_skippable} voi siete i{pause_20_skippable}{line_break}pazz... cioè, i coraggiosi che{line_break}avevo già incontrato!{end_wait}"

msgctxt "message"
msgid "05901"
msgstr "Ah così{pause_20_skippable} siete i{pause_20_skippable}{em_dash}I{line_break}pazz... cioè, i coraggiosi{line_break}che hanno salvato Kolima!{end_wait}"

msgctxt "message"
msgid "05902"
msgstr "Come avevate detto{line_break}di chiamarvi?{end_wait}"

msgctxt "message"
msgid "05903"
msgstr "Come vi{line_break}chiamate?{end_wait}"

msgctxt "message"
msgid "05904"
msgstr "Lui è {actor_name:1}, signore,{line_break}e io sono {actor_name:2}...{end_wait}"

msgctxt "message"
msgid "05905"
msgstr "Io sono {actor_name:3}.{end_wait}"

msgctxt "message"
msgid "05906"
msgstr "E io sono {actor_name:4}, del{line_break}villaggio di Imil.{end_wait}"

msgctxt "message"
msgid "05907"
msgstr "{actor_name:1} e i suoi compagni...{end_wait}"

msgctxt "message"
msgid "05908"
msgstr "La prima volta, avevo{line_break}rifiutato la vostra{line_break}offerta, vero?{end_now}"

msgctxt "message"
msgid "05909"
msgstr "All'epoca avevo sbagliato{line_break}i miei calcoli.{end_wait}"

msgctxt "message"
msgid "05910"
msgstr "Non lo starete forse dicendo{line_break}per assecondarmi?{end_wait}"

msgctxt "message"
msgid "05911"
msgstr "E nonostante le mie parole,{line_break}vi prodigaste per liberarci{line_break}dalla maledizione, vero?{end_now}"

msgctxt "message"
msgid "05912"
msgstr "Non siete forse voi ad{line_break}aver messo fine alla{line_break}maledizione dell'albero sacro?{end_now}"

msgctxt "message"
msgid "05913"
msgstr "Permettetemi di ringraziarvi.{end_wait}"

msgctxt "message"
msgid "05914"
msgstr "Non potete nascondermelo.{pause_20_skippable}{line_break}I miei uomini mi hanno già{line_break}riferito...{end_wait}"

msgctxt "message"
msgid "05915"
msgstr "Temevo che non voleste{line_break}fermarvi qui sulla{line_break}strada del ritorno.{end_wait}"

msgctxt "message"
msgid "05916"
msgstr "Lasciate che vi offra un{line_break}segno della mia{line_break}grande riconoscenza...{end_wait}"

msgctxt "message"
msgid "05917"
msgstr "Contavo troppo sul denaro,{pause_20_skippable}{line_break}dimenticando le necessità{line_break}dei miei sudditi.{end_wait}"

msgctxt "message"
msgid "05918"
msgstr "Ora voi mi avete ricordato{line_break}quali sono i miei doveri.{end_wait}"

msgctxt "message"
msgid "05919"
msgstr "Come signore di queste terre,{line_break}farò il mio dovere in{line_break}rappresentanza di tutti.{end_wait}"

msgctxt "message"
msgid "05920"
msgstr "{actor_name:1}, mi farebbe molto{line_break}piacere se accettaste un segno{line_break}della mia gratitudine.{end_wait}"

msgctxt "message"
msgid "05921"
msgstr "Potrei darvelo io stesso, ma{line_break}forse avreste maggior piacere{line_break}a sceglierlo voi stessi, vero?{end_now}"

msgctxt "message"
msgid "05922"
msgstr "Molto bene. Potete scegliere{line_break}qualcosa che vi aiuterà{line_break}nel vostro cammino.{end_wait}"

msgctxt "message"
msgid "05923"
msgstr "Non potete capire quanto{line_break}sia dispiaciuto per non{line_break}essermi fidato di voi.{page_break}Vi prego di accettare questo{line_break}segno di ringraziamento{line_break}per il vostro aiuto.{end_wait}"

msgctxt "message"
msgid "05924"
msgstr "Mostrerò la strada a{line_break}{actor_name:1} e ai suoi{line_break}amici, mio signore.{end_wait}"

msgctxt "message"
msgid "05925"
msgstr "Molte grazie a{line_break}te e ai tuoi{line_break}compagni!{end_wait}"

msgctxt "message"
msgid "05926"
msgstr "Tornate quando vorrete!{pause_20_skippable}{line_break}V'accoglierò sempre{line_break}a braccia aperte!{end_wait}"

msgctxt "message"
msgid "05927"
msgstr "Seguitemi, vi{line_break}condurrò nella{line_break}stanza del tesoro.{end_wait}"

msgctxt "message"
msgid "05928"
msgstr "Lord McCoy ha dato ordine che{line_break}{actor_name:1} e i suoi amici{line_break}fossero condotti qui.{page_break}Mostrategli la{line_break}loro ricompensa!{end_wait}"

msgctxt "message"
msgid "05929"
msgstr "Potrete prendere un solo{line_break}strumento tra queste{line_break}quattro ceste.{end_wait}"

msgctxt "message"
msgid "05930"
msgstr "Scegliete la vostra{line_break}ricompensa, prima!{end_wait}"

msgctxt "message"
msgid "05931"
msgstr "Sarete sempre i benvenuti nel{line_break}palazzo di Lord McCoy.{end_wait}"

msgctxt "message"
msgid "05932"
msgstr "Questi valorosi guerrieri{line_break}meritano di ricevere la{line_break}ricompensa del nostro signore.{end_wait}"

msgctxt "message"
msgid "05933"
msgstr "Potrete ricevere un solo{line_break}strumento, ma credo che siano{line_break}tutti piuttosto utili.{end_wait}"

msgctxt "message"
msgid "05934"
msgstr "Tuttavia... se non avrete{line_break}fortuna, vi potrà capitare uno{line_break}strumento che non vi serve.{end_wait}"

msgctxt "message"
msgid "05935"
msgstr "{protagonist_name} controlla{line_break}la cassa...{page_break}...ma è vuota.{end_wait}"

msgctxt "message"
msgid "05936"
msgstr "La cassa del tesoro{line_break}è chiusa a chiave.{end_wait}"

msgctxt "message"
msgid "05937"
msgstr "Mi avete insegnato che non{line_break}si può giudicare un uomo{line_break}soltanto dalle apparenze.{end_wait}"

msgctxt "message"
msgid "05938"
msgstr "Sei{pause_20_skippable} un buon guerriero.{end_wait}"

msgctxt "message"
msgid "05939"
msgstr "Credi che potrò diventare{line_break}anch'io un buon guerriero{line_break}come te?{end_now}"

msgctxt "message"
msgid "05940"
msgstr "Davvero?{pause_20_skippable} Allora cercherò{line_break}di fare del mio meglio!{end_wait}"

msgctxt "message"
msgid "05941"
msgstr "Come sei insensibile...{pause_20_skippable}{line_break}Potresti dirmi di sì anche{line_break}se credi il contrario.{end_wait}"

msgctxt "message"
msgid "05942"
msgstr "Io non sarei mai andato{line_break}a Kolima conoscendo il{line_break}pericolo che correvo.{page_break}Siete davvero guerrieri{line_break}coraggiosi.{end_wait}"

msgctxt "message"
msgid "05943"
msgstr "Ma non riesco a immaginare{line_break}come abbiate fatto a{line_break}superare la palizzata...{page_break}Non avevate{line_break}neppure la chiave...{end_wait}"

msgctxt "message"
msgid "05944"
msgstr "A volte abbiamo bisogno che{line_break}i bambini ci mettano davanti{line_break}alle nostre responsabilità.{end_wait}"

msgctxt "message"
msgid "05945"
msgstr "Sarò un valido guerriero,{line_break}come {actor_name:1} e i{line_break}suoi compagni.{end_wait}"

msgctxt "message"
msgid "05946"
msgstr "Non andare, {actor_name:1}!{line_break}Trasmettimi il tuo coraggio,{line_break}il tuo valore!{end_wait}"

msgctxt "message"
msgid "05947"
msgstr "La gente di Bilibin{line_break}non dimenticherà mai{line_break}il vostro coraggio.{end_wait}"

msgctxt "message"
msgid "05948"
msgstr "Ho sentito che avete avuto{line_break}una stupenda ricompensa.{page_break}Così avete visto quanto{line_break}McCoy può essere{line_break}gentile.{end_wait}"

msgctxt "message"
msgid "05949"
msgstr "Lady McCoy è inviperita{line_break}perché la costruzione del{line_break}palazzo è stata bloccata.{page_break}È meglio che le{line_break}stiate alla larga{line_break}per un po'.{end_wait}"

msgctxt "message"
msgid "05950"
msgstr "A sud della Grotta{line_break}di Goma... incombono{line_break}nubi minacciose.{page_break}Se andate da quelle{line_break}parti preparatevi{line_break}alla pioggia.{end_wait}"

msgctxt "message"
msgid "05951"
msgstr "La signora era molto adirata{line_break}quando ha lasciato la stanza.{pause_20_skippable}{line_break}Oh cielo...{end_wait}"

msgctxt "message"
msgid "05952"
msgstr "Provo molta pena per i{line_break}guerrieri assoldati{line_break}da Lord McCoy.{page_break}Se mai torneranno, Lord{line_break}McCoy li accoglierà con{line_break}tutti gli onori.{end_wait}"

msgctxt "message"
msgid "05953"
msgstr "Chissà che ricompensa{line_break}hanno ricevuto da{line_break}Lord McCoy...{end_wait}"

msgctxt "message"
msgid "05954"
msgstr "Ma perché non smette{line_break}di piangere?{page_break}Neanch'io ho mai{line_break}avuto un palazzo, ma non{line_break}per questo mi dispero.{end_wait}"

msgctxt "message"
msgid "05955"
msgstr "Li attenderebbe una bella{line_break}vita se restassero a Bilibin,{line_break}sotto la protezione di{page_break}Lord McCoy. Non so perché{line_break}vogliano continuare a{line_break}fare i guerrieri.{end_wait}"

msgctxt "message"
msgid "05956"
msgstr "Si capisce subito quando{line_break}è arrabbiata: sbatte{line_break}sempre la porta!{end_wait}"

msgctxt "message"
msgid "05957"
msgstr "Una volta tanto il signore{line_break}non si è lasciato comandare{line_break}a bacchetta da Lady McCoy!{page_break}Finalmente si sa far{line_break}valere...{end_wait}"

msgctxt "message"
msgid "05958"
msgstr "AAAAH!!!{end_wait}"

msgctxt "message"
msgid "05959"
msgstr "Ah!{pause_20_skippable} Per un secondo ho{line_break}creduto che ci fosse la{line_break}signora.{page_break}Che spavento!{end_wait}"

msgctxt "message"
msgid "05960"
msgstr "A volte un uomo deve{line_break}sapersi imporre.{line_break}E... che uomo!{end_wait}"

msgctxt "message"
msgid "05961"
msgstr "In questa camicia da notte{line_break}c'è un buco che diventa{line_break}sempre più grande.{page_break}L'avrà indossata{line_break}qualcuno?{end_wait}"

msgctxt "message"
msgid "05962"
msgstr "È davvero imprudente che{line_break}guerrieri così giovani{line_break}affrontino l'albero magico...{end_wait}"

msgctxt "message"
msgid "05963"
msgstr "Stavo osservando da qui.{line_break}Dopo quello che è successo,{line_break}siete andati a Kolima?{end_now}"

msgctxt "message"
msgid "05964"
msgstr "Non so come abbiate fatto{line_break}a togliere la maledizione,{line_break}ma siete davvero i migliori!{end_wait}"

msgctxt "message"
msgid "05965"
msgstr "Non dire bugie! Vi ho{line_break}visti mentre scavalcavate{line_break}la palizzata!{page_break}E poi vi ho visti tornare{line_break}attraverso la foresta,{line_break}di nuovo verde!{end_wait}"

msgctxt "message"
msgid "05966"
msgstr "È stato davvero{line_break}coraggioso andare{line_break}fino a Kolima.{end_wait}"

msgctxt "message"
msgid "05967"
msgstr "Un guerriero coraggioso non{line_break}ha certamente paura di essere{line_break}trasformato in un albero.{end_wait}"

msgctxt "message"
msgid "05968"
msgstr "La ricompensa che avete{line_break}ricevuto è un dono{line_break}davvero prezioso.{page_break}La fortuna bacia{line_break}i coraggiosi!{end_wait}"

msgctxt "message"
msgid "05969"
msgstr "Avete avuto una buona{line_break}ricompensa, ma siete stati{line_break}un po' sfortunati.{page_break}Ma non voglio che{line_break}ve la prendiate per{line_break}quello che dico.{end_wait}"

msgctxt "message"
msgid "05970"
msgstr "Dall'aspetto si direbbe{line_break}che è tutto apposto.{end_wait}"

msgctxt "message"
msgid "05971"
msgstr "Hanno attraversato il fiume{line_break}dopo averci spinto giù.{page_break}È terribile!{line_break}Ma chi ha potuto fare{line_break}una cosa simile?{end_wait}"

msgctxt "message"
msgid "05972"
msgstr "Se qualcuno non la riporta{line_break}a riva verrà inghiottita{line_break}dalla corrente!{end_wait}"

msgctxt "message"
msgid "05973"
msgstr "Aiuto! Qualcuno{line_break}mi aiuti!{end_wait}"

msgctxt "message"
msgid "05974"
msgstr "Grazie! Stavo per{line_break}essere travolta{line_break}dalla corrente!{end_wait}"

msgctxt "message"
msgid "05975"
msgstr "Ehi!{pause_20_skippable} Ma sei tu!{end_wait}"

msgctxt "message"
msgid "05976"
msgstr "Jill, sono loro quelli che{line_break}ti hanno salvato?{end_wait}"

msgctxt "message"
msgid "05977"
msgstr "Ti ricordi di me?{line_break}Ero un albero!{end_wait}"

msgctxt "message"
msgid "05978"
msgstr "Grazie, se non era per{line_break}te - e per voi - sarei{line_break}annegata nel fiume.{end_wait}"

msgctxt "message"
msgid "05979"
msgstr "Tieni,{pause_20_skippable} prendi questo.{pause_20_skippable}{line_break}È un piccolo segno{line_break}del mio apprezzamento.{end_wait}"

msgctxt "message"
msgid "05980"
msgstr "Jill dà {actor_name:1} un{line_break}dono speciale.{end_wait}"

msgctxt "message"
msgid "05981"
msgstr "Non dimenticherò mai{line_break}ciò che tu e i tuoi amici{line_break}avete fatto per me!{end_wait}"

msgctxt "message"
msgid "05982"
msgstr "È stata una gran fortuna{line_break}essere trasformati in alberi{line_break}proprio in quel momento.{page_break}Volevamo soltanto raccogliere{line_break}cachi... Chissà cosa{line_break}sarebbe successo...{end_wait}"

msgctxt "message"
msgid "05983"
msgstr "Quel posto sulla riva del{line_break}fiume mi piace moltissimo...{line_break}Mi dà un senso di pace...{end_wait}"

msgctxt "message"
msgid "05984"
msgstr "Tutte le volte che{line_break}mangerò cachi, penserò{line_break}a te e ai tuoi amici.{end_wait}"

msgctxt "message"
msgid "05985"
msgstr "Un tempo ci chiamavano{line_break}la banda dei tre.{page_break}Ora che lei non c'è più,{pause_20_skippable}{line_break}ci chiameranno la banda{line_break}dei due...{page_break}Povera ragazza...{end_wait}"

msgctxt "message"
msgid "05986"
msgstr "Se soltanto non avessimo{line_break}voluto raccogliere quei{line_break}cachi, ora sarebbe ancora...{page_break}Non avremmo dovuto{line_break}arrampicarci così...{end_wait}"

msgctxt "message"
msgid "05987"
msgstr "Ma di chi è stata{line_break}l'idea di{line_break}raccogliere cachi?{end_wait}"

msgctxt "message"
msgid "05988"
msgstr "Beh, non è stata mia{line_break}l'idea di{line_break}raccogliere cachi.{end_wait}"

msgctxt "message"
msgid "05989"
msgstr "Questi cachi sono{line_break}amari...{line_break}Come il ricordo...{end_wait}"

msgctxt "message"
msgid "05990"
msgstr "Con tutta quella fatica...{line_break}Se solo fossimo stati{line_break}un po' più rapidi...{end_wait}"

msgctxt "message"
msgid "05991"
msgstr "Che mondo crudele!{line_break}Tutto questo soltanto per{line_break}esserci arrampicati!{end_wait}"

msgctxt "message"
msgid "05992"
msgstr "Volete attraversare{line_break}il ponte?{end_wait}"

msgctxt "message"
msgid "05993"
msgstr "Ah...{pause_20_skippable}{pause_20_skippable} Bene!{line_break}Andate pure!{end_wait}"

msgctxt "message"
msgid "05994"
msgstr "Credevo che nessuno avrebbe{line_break}mai più attraversato{line_break}questo ponte.{page_break}Godetevi ogni attraversamento{line_break}come se fosse l'ultimo...{end_wait}"

msgctxt "message"
msgid "05995"
msgstr "Voi non potete capire, ma{line_break}è una gioia immensa{line_break}attraversare questo ponte.{end_wait}"

msgctxt "message"
msgid "05996"
msgstr "Come siete arrivati fin qui?{line_break}Il ponte è di nuovo aperto?{end_now}"

msgctxt "message"
msgid "05997"
msgstr "Davvero?!{pause_20_skippable} Allora posso{line_break}tornare a casa, a Kolima?{page_break}Pensavo che non avrei mai più{line_break}rimesso piede a casa, con la{line_break}maledizione e tutto il resto!{end_wait}"

msgctxt "message"
msgid "05998"
msgstr "Ah, allora siete passati{line_break}attraverso la foresta?{line_break}È un peccato...{end_wait}"

msgctxt "message"
msgid "05999"
msgstr "Inizio a credere che dovrò{line_break}restare per tutta la vita{line_break}al Tempio di Fuchin.{end_wait}"

msgctxt "message"
msgid "06000"
msgstr "Lo sapevate che un tempo la{line_break}foresta era una{line_break}grande prateria?{end_now}"

msgctxt "message"
msgid "06001"
msgstr "Improvvisamente la prateria{line_break}è diventata una foresta.{page_break}Ora Nyunpa è l'unica{line_break}persona che può{line_break}attraversarla...{page_break}Neppure lui sa come abbia{line_break}fatto una prateria a{line_break}diventare una foresta.{end_wait}"

msgctxt "message"
msgid "06002"
msgstr "Non mi credete, vero? Ma{line_break}è la pura verità.{page_break}Sono cadute quelle gemme{line_break}dal cielo, e il giorno{line_break}dopo, al posto{page_break}della prateria{line_break}era nata una{line_break}foresta.{end_wait}"

msgctxt "message"
msgid "06003"
msgstr "Om...{pause_20_skippable} Om...{line_break}Luci blu dal nord...{line_break}Terribile!!!{page_break}La pioggia di astri... e{line_break}improvvisamente, una foresta...{line_break}Tutti cattivi presagi...{end_wait}"

msgctxt "message"
msgid "06004"
msgstr "Gemme dal cielo, luci blu{line_break}dal nord... Tutti presagi{line_break}di un disastro incombente!{page_break}Corrispondono alle terribili{line_break}leggende conservate nei{line_break}nostri antichi rotoli.{end_wait}"

msgctxt "message"
msgid "06005"
msgstr "Nyunpa non mangia da giorni!{line_break}Diventerà così magro da{line_break}dissolversi nel nulla.{end_wait}"

msgctxt "message"
msgid "06006"
msgstr "Non credi che sia nobile da{line_break}parte sua provare a salvare il{line_break}mondo diventando un illuminato?{end_now}"

msgctxt "message"
msgid "06007"
msgstr "Ma non vorrei che{line_break}Nyunpa deperisse continuando{line_break}a non mangiare.{end_wait}"

msgctxt "message"
msgid "06008"
msgstr "Ti rendi conto di cosa{line_break}stai dicendo?{end_now}"

msgctxt "message"
msgid "06009"
msgstr "Beh,{pause_20_skippable} ognuno può{line_break}pensarla come{line_break}preferisce,{pause_20_skippable} ma...{page_break}...spero che tu possa{line_break}capire i nostri sentimenti.{end_wait}"

msgctxt "message"
msgid "06010"
msgstr "Digiunare per raggiungere{line_break}l'illuminazione, purificando{line_break}il corpo e lo spirito...{page_break}Liberandosi dai pensieri{line_break}terreni, ci si può concentrare{line_break}sull'energia della mente.{end_wait}"

msgctxt "message"
msgid "06011"
msgstr "Ho un po' paura ad andare{line_break}a casa da sola... Spero che mi{line_break}accompagni un monaco.{end_wait}"

msgctxt "message"
msgid "06012"
msgstr "Molti astri sono caduti{line_break}dal cielo, proprio come{line_break}è scritto nei rotoli...{page_break}È davvero un segno{line_break}della distruzione{line_break}del mondo?{end_wait}"

msgctxt "message"
msgid "06013"
msgstr "Cosa mi alleno a fare{line_break}se il mondo sta per{line_break}scomparire.{page_break}Forse è meglio{line_break}spassarsela!{end_wait}"

msgctxt "message"
msgid "06014"
msgstr "Il digiuno non fa per me...{line_break}Solo a pensarci mi{line_break}viene una tristezza!{end_wait}"

msgctxt "message"
msgid "06015"
msgstr "Mi allenerò per diventare{line_break}un buon monaco.{page_break}Così potrò salvare il{line_break}mondo, anche a costo della{line_break}mia stessa vita.{end_wait}"

msgctxt "message"
msgid "06016"
msgstr ".{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}{end_wait}"

msgctxt "message"
msgid "06017"
msgstr "Mmm... Chi è? Chi sta{line_break}parlando alla mia mente?{end_wait}"

msgctxt "message"
msgid "06018"
msgstr "Giovane maestro... Era tua{pause_20_skippable}{line_break}la voce che ho udito poco{line_break}fa nella mia mente?{end_now}"

msgctxt "message"
msgid "06019"
msgstr "Non mentire!{end_wait}"

msgctxt "message"
msgid "06020"
msgstr "Lo sapevo!{end_wait}"

msgctxt "message"
msgid "06021"
msgstr "Lo sapevo!{end_wait}"

msgctxt "message"
msgid "06022"
msgstr "Tu segui quella{pause_20_skippable}{line_break}gente, vero?{end_now}"

msgctxt "message"
msgid "06023"
msgstr "Stai mentendo...{line_break}So che li stai{line_break}seguendo!{end_wait}"

msgctxt "message"
msgid "06024"
msgstr "Lo sapevo!{end_wait}"

msgctxt "message"
msgid "06025"
msgstr "Ma devi attraversare{line_break}la selva infinita, la{line_break}Foresta di Mogall.{page_break}La foresta stessa è un{line_break}mistero, così come i{line_break}suoi sentieri...{page_break}Solo una persona{line_break}speciale può riuscire{line_break}ad attraversarla.{end_wait}"

msgctxt "message"
msgid "06026"
msgstr "Ma forse io potrei,{line_break}giovane maestro.{end_wait}"

msgctxt "message"
msgid "06027"
msgstr "Se saprai superare le prove{line_break}nella grotta della cascata,{line_break}te lo dirò.{end_wait}"

msgctxt "message"
msgid "06028"
msgstr "Vuoi sottoporti alla prova?{end_now}"

msgctxt "message"
msgid "06029"
msgstr "Allora non posso dirtelo.{line_break}Tornatene da dove{line_break}sei venuto.{end_wait}"

msgctxt "message"
msgid "06030"
msgstr "Devi superare le prove{line_break}della grotta prima{line_break}di poter attraversare{page_break}la Foresta di Mogall...{line_break}Vuoi sostenere la prova?{end_now}"

msgctxt "message"
msgid "06031"
msgstr "Non preoccuparti.{line_break}Ti daremo il permesso di{line_break}entrare nella grotta.{end_wait}"

msgctxt "message"
msgid "06032"
msgstr "Ora vai,{pause_20_skippable} {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "06033"
msgstr "Ricorda soltanto che{line_break}anche altri sanno leggere{line_break}nella mente oltre a voi.{end_wait}"

msgctxt "message"
msgid "06034"
msgstr "Parla con il monaco{line_break}vicino alle{line_break}cascate.{end_wait}"

msgctxt "message"
msgid "06035"
msgstr "Ti piace leggere nella{line_break}mente della gente,{line_break}vero?{end_now}"

msgctxt "message"
msgid "06036"
msgstr "Se si esagera, si può{line_break}finire con l'odiare{line_break}quell'abilità.{end_wait}"

msgctxt "message"
msgid "06037"
msgstr "Bene. Continua a leggere{line_break}nella mente della gente,{line_break}finché puoi farlo.{end_wait}"

msgctxt "message"
msgid "06038"
msgstr "Il maestro Nyunpa mi ha{line_break}detto della vostra prova.{line_break}Potete entrare.{end_wait}"

msgctxt "message"
msgid "06039"
msgstr "La prova delle Cascate di{line_break}Fuchin è difficile. Entrate{line_break}soltanto se siete pronti.{end_wait}"

msgctxt "message"
msgid "06040"
msgstr "Chissà se quei giovani{line_break}guerrieri resisteranno{line_break}alla prova della grotta?{end_wait}"

msgctxt "message"
msgid "06041"
msgstr "Giovane maestro, hai{line_break}superato la prova?{end_now}"

msgctxt "message"
msgid "06042"
msgstr "Hai davvero scoperto i{line_break}segreti del Tempio{line_break}di Fuchin!?{end_wait}"

msgctxt "message"
msgid "06043"
msgstr "Invece credo di sì...{end_wait}"

msgctxt "message"
msgid "06044"
msgstr "Il maestro Nyunpa vi{line_break}sta aspettando...{end_wait}"

msgctxt "message"
msgid "06045"
msgstr "Andate al tempio.{end_wait}"

msgctxt "message"
msgid "06046"
msgstr "Il maestro Nyunpa vi sta{line_break}aspettando...{line_break}Andate al tempio.{end_wait}"

msgctxt "message"
msgid "06047"
msgstr "I guerrieri sono riusciti{line_break}a scoprire i segreti del{line_break}Tempio di Fuchin.{end_wait}"

msgctxt "message"
msgid "06048"
msgstr "Benissimo, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "06049"
msgstr "Sono felice che tu e i tuoi{line_break}amici abbiate scoperto i{line_break}segreti del Tempio di Fuchin!{end_wait}"

msgctxt "message"
msgid "06050"
msgstr "Noi monaci chiamiamo{line_break}Ki il potere che avete{line_break}ottenuto.{end_wait}"

msgctxt "message"
msgid "06051"
msgstr "Sei{pause_20_skippable} confuso,{line_break}{actor_name:1}?{end_now}"

msgctxt "message"
msgid "06052"
msgstr "Nel mondo occidentale si{line_break}chiama \"forza\", ma è un{line_break}potere spirituale.{end_wait}"

msgctxt "message"
msgid "06053"
msgstr "Per essere così giovane{line_break}dimostri grande saggezza, ma{line_break}credo che dovrò spiegartelo.{end_wait}"

msgctxt "message"
msgid "06054"
msgstr "Nel mondo occidentale si{line_break}chiama \"forza\", ma è un{line_break}potere spirituale.{end_wait}"

msgctxt "message"
msgid "06055"
msgstr "Ora ve lo spiego, come{line_break}promesso. Vi servirà per{line_break}attraversare la foresta.{end_wait}"

msgctxt "message"
msgid "06056"
msgstr "Che cosa succede se{line_break}rimanete con poca energia{line_break}nella foresta?{end_wait}"

msgctxt "message"
msgid "06057"
msgstr "Sei curioso,{line_break}vero?{end_now}"

msgctxt "message"
msgid "06058"
msgstr "Guarda che posso leggerti{line_break}nella mente.{pause_20_skippable} Sei{line_break}curioso o no?{end_now}"

msgctxt "message"
msgid "06059"
msgstr "Improvvisamente, vi trovate{line_break}di fronte dei mostri che si{line_break}nascondevano nell'ombra.{page_break}A questo punto tentate{line_break}di sconfiggerli,{line_break}giusto?{end_now}"

msgctxt "message"
msgid "06060"
msgstr "Non bisogna pensare che{line_break}la lotta sia sempre{line_break}la migliore soluzione...{end_wait}"

msgctxt "message"
msgid "06061"
msgstr "Esatto!{line_break}Non ha senso cercare{line_break}sempre la lotta.{end_wait}"

msgctxt "message"
msgid "06062"
msgstr "Quei mostri sono dei codardi.{line_break}Se sanno che potete vederli,{line_break}scappano.{end_wait}"

msgctxt "message"
msgid "06063"
msgstr "Sono creature della{line_break}foresta, quindi non si{line_break}perderanno certamente.{end_wait}"

msgctxt "message"
msgid "06064"
msgstr "Basterà usare l'energia per{line_break}trovare i mostri,{pause_20_skippable} e poi{line_break}seguirli. Semplice, no?{end_wait}"

msgctxt "message"
msgid "06065"
msgstr "Ora che ho trasmesso{line_break}a qualcuno la{line_break}conoscenza del Ki...{page_break}...sono sollevato.{line_break}Addio, {actor_name:1}.{line_break}Abbi cura di te...{end_wait}"

msgctxt "message"
msgid "06066"
msgstr "Il maestro Nyunpa sembra{line_break}essere molto sollevato.{page_break}Dovete farcela,{line_break}giovani guerrieri!{end_wait}"

msgctxt "message"
msgid "06067"
msgstr "Non possiamo star qui seduti{line_break}pigramente: anche noi impariamo{line_break}i segreti del Tempio di Fuchin.{end_wait}"

msgctxt "message"
msgid "06068"
msgstr "Il Tempio di Fuchin è{line_break}un luogo piacevole.{line_break}Mi dà un senso di pace...{end_wait}"

msgctxt "message"
msgid "06069"
msgstr "Ehi, {actor_name:1}! Che ci{line_break}fai qui? Il maestro Nyunpa ha{line_break}avuto l'illuminazione!{page_break}Ora non ci risponde più{line_break}quando gli parliamo...{end_wait}"

msgctxt "message"
msgid "06070"
msgstr "Aaah, maestro Nyunpa...{line_break}È passato a miglior vita...{end_wait}"

msgctxt "message"
msgid "06071"
msgstr "Alla fine, il maestro Nyunpa{line_break}si è spento.{end_wait}"

msgctxt "message"
msgid "06072"
msgstr "Ora ha davvero superato{line_break}le preoccupazioni terrene.{line_break}Ci starà osservando?{end_now}"

msgctxt "message"
msgid "06073"
msgstr "Prima lo credevo anch'io.{line_break}Ma ora non ne ho{line_break}più la certezza.{end_wait}"

msgctxt "message"
msgid "06074"
msgstr "Sì...{pause_20_skippable} È davvero{line_break}triste.{page_break}Ora che Nyunpa se n'è{line_break}andato, Nyunpa ha perso{line_break}davvero qualcosa...{end_wait}"

msgctxt "message"
msgid "06075"
msgstr "Gemme che cadono dal cielo,{line_break}montagne che eruttano,{line_break}oceani infuriati...{page_break}Per me il Tempio di Fuchin è{line_break}ormai è l'unico porto di{line_break}pace in questo mondo feroce.{end_wait}"

msgctxt "message"
msgid "06076"
msgstr "Sapevo che Nyunpa stava{line_break}digiunando per salvare{line_break}il mondo...{page_break}...pur sapendo che ciò{line_break}l'avrebbe portato alla morte.{page_break}Ma è triste che{line_break}se ne sia andato...{end_wait}"

msgctxt "message"
msgid "06077"
msgstr "Il maestro Nyunpa ha raggiunto{line_break}l'illuminazione nella sua{line_break}vita... Straordinario...{end_wait}"

msgctxt "message"
msgid "06078"
msgstr "Il maestro Nyunpa è ormai{line_break}soltanto pelle e ossa...{line_break}Sembra una lisca di pesce!{end_wait}"

msgctxt "message"
msgid "06079"
msgstr "Non può lasciarci ora...{line_break}Ha ancora così{line_break}tanto da insegnarci!{end_wait}"

msgctxt "message"
msgid "06080"
msgstr "...............{end_wait}"

msgctxt "message"
msgid "06081"
msgstr "{actor_name:1}...{pause_20_skippable} Sei tu?{pause_20_skippable}{line_break}Io...{pause_20_skippable}conto su di te...{page_break}per portare la pace...{pause_20_skippable}{line_break}nel mondo...{end_wait}"

msgctxt "message"
msgid "06082"
msgstr "Non devi sforzarti{line_break}troppo.{pause_20_skippable} Sei curioso,{line_break}vero?{end_now}"

msgctxt "message"
msgid "06083"
msgstr "La fiamma del drago rischiara{line_break}le tenebre, indicando il{line_break}sentiero della verità.{end_wait}"

msgctxt "message"
msgid "06084"
msgstr "Il segreto del Ki sarà{line_break}rivelato ai discepoli{line_break}della verità.{end_wait}"

msgctxt "message"
msgid "06085"
msgstr "I raggi di luce{line_break}rivelano le ombre,{line_break}mostrando il cammino.{end_wait}"

msgctxt "message"
msgid "06086"
msgstr "È la statua di un drago{line_break}a cui manca un occhio.{page_break}Cos'ha nelle{line_break}cavità?{end_wait}"

msgctxt "message"
msgid "06087"
msgstr "È la statua di un drago con{line_break}gli occhi rossi, scintillanti.{end_wait}"

msgctxt "message"
msgid "06088"
msgstr "Nel cartello rotto si legge:{page_break}A nord: Tempio di Fuchin{line_break}A sud: Prateria di Mogall...{end_wait}"

msgctxt "message"
msgid "06089"
msgstr "Questa è Xian. I viaggiatori{line_break}sono benvenuti qui!{line_break}Riposatevi quanto volete.{end_wait}"

msgctxt "message"
msgid "06090"
msgstr "Giovani, valorosi{line_break}guerrieri!{page_break}Avete attraversato{line_break}la Foresta di Mogall?{end_now}"

msgctxt "message"
msgid "06091"
msgstr "Incredibile. Le vostre gesta{line_break}hanno tutto il mio rispetto.{end_wait}"

msgctxt "message"
msgid "06092"
msgstr "Siete passati da Altin?{line_break}No, non può essere.{page_break}La Strada della Seta è{line_break}bloccata, nessuno la{line_break}può attraversare.{end_wait}"

msgctxt "message"
msgid "06093"
msgstr "Xian è il villaggio del{line_break}kinu. Il kinu è la seta, con{line_break}cui si fanno i migliori abiti.{end_wait}"

msgctxt "message"
msgid "06094"
msgstr "Conoscete il maestro Feh?{end_now}"

msgctxt "message"
msgid "06095"
msgstr "Ci sono parecchi ladri in{line_break}giro, ma il maestro Feh{line_break}li tiene alla larga.{page_break}Xian è al sicuro, perché i{line_break}ladri hanno paura ad{line_break}avvicinarsi al maestro Feh.{end_wait}"

msgctxt "message"
msgid "06096"
msgstr "Feh è un maestro nelle arti{line_break}marziali. È fortissimo.{page_break}Il maestro Feh insegna le{line_break}arti marziali nella scuola{line_break}di Xian.{end_wait}"

msgctxt "message"
msgid "06097"
msgstr "A Xian sono molti a{line_break}praticare le arti marziali.{page_break}Tutti i guerrieri dovrebbero{line_break}apprendere le arti marziali.{end_wait}"

msgctxt "message"
msgid "06098"
msgstr "Guerrieri, andate a visitare{line_break}la scuola del maestro Feh.{line_break}Ne sarete sorpresi!{end_wait}"

msgctxt "message"
msgid "06099"
msgstr "I miei abiti non sono di seta,{line_break}perché la seta è troppo cara.{line_break}La usano soltanto i ricchi.{end_wait}"

msgctxt "message"
msgid "06100"
msgstr "Oooh-aaah...{line_break}Hahaaa!{end_wait}"

msgctxt "message"
msgid "06101"
msgstr "Heh heh heh...{end_wait}"

msgctxt "message"
msgid "06102"
msgstr "Sono forte nel kung fu.{page_break}Se andate alla scuola del{line_break}maestro Feh tutti i giorni{line_break}diventerete forti anche voi.{end_wait}"

msgctxt "message"
msgid "06103"
msgstr "Disastri dal cielo...{line_break}E troppi, troppi ladri...{page_break}Ma non c'è da preoccuparsi: a{line_break}Xian ci sono molti maestri di{line_break}kung fu, tra cui Feh.{end_wait}"

msgctxt "message"
msgid "06104"
msgstr "Questa è una coltivazione{line_break}di gelsi.{page_break}Nel periodo della raccolta{line_break}tutti gli abitanti di Xian{line_break}danno una mano.{end_wait}"

msgctxt "message"
msgid "06105"
msgstr "Venite dalla{line_break}scuola... Siete{line_break}forti guerrieri?{end_now}"

msgctxt "message"
msgid "06106"
msgstr "Mi fa piacere vedere{line_break}forti guerrieri. Vorrei{line_break}andare verso occidente.{end_wait}"

msgctxt "message"
msgid "06107"
msgstr "Siete guerrieri deboli?{line_break}È strano che dei guerrieri{line_break}si definiscano deboli.{end_wait}"

msgctxt "message"
msgid "06108"
msgstr "Ma che fate?! Mi avete fatto{line_break}rovesciare l'acqua!{end_wait}"

msgctxt "message"
msgid "06109"
msgstr "Ora mi tocca andarne a{line_break}prenderne altra... È{line_break}un lavoro faticoso!{end_wait}"

msgctxt "message"
msgid "06110"
msgstr "Non parlatemi, o potreste{line_break}farmi rovesciare l'acqua.{end_wait}"

msgctxt "message"
msgid "06111"
msgstr "Ma{pause_20_skippable} che{pause_20_skippable} succede?{line_break}L'albero s'è{line_break}messo a saltare!{end_wait}"

msgctxt "message"
msgid "06112"
msgstr "...Di nuovo...{pause_20_skippable}{line_break}Ho dormito troppo poco...{end_wait}"

msgctxt "message"
msgid "06113"
msgstr "Credo che quei ragazzini siano{line_break}qui per studiare il kung fu{line_break}alla scuola del maestro Feh.{end_wait}"

msgctxt "message"
msgid "06114"
msgstr "Sembrate forti, giovani{line_break}viaggiatori. Ma chi{line_break}è più forte...{page_break}Voi o il kung fu che{line_break}il maestro Feh insegna{line_break}nella sua scuola?{end_wait}"

msgctxt "message"
msgid "06115"
msgstr "Spero che sempre più{line_break}persone conoscano{line_break}la seta di Xian.{end_wait}"

msgctxt "message"
msgid "06116"
msgstr "Quelli davvero forti{line_break}non hanno bisogno{line_break}di armi.{page_break}Il maestro Feh{line_break}è il numero uno.{end_wait}"

msgctxt "message"
msgid "06117"
msgstr "La lotta con calci e pugni{line_break}può essere molto efficace.{page_break}Tutti dovrebbero{line_break}tenerlo presente.{end_wait}"

msgctxt "message"
msgid "06118"
msgstr "Allenarci alla scuola{line_break}del maestro Feh ci{line_break}rende molto forti.{end_wait}"

msgctxt "message"
msgid "06119"
msgstr "La seta è morbida e lucente.{line_break}È piacevole indossarla, mi fa{line_break}davvero impazzire.{end_wait}"

msgctxt "message"
msgid "06120"
msgstr "Spezzare gli alberi con la{line_break}mano{pause_20_skippable} è molto doloroso.{page_break}Ma il maestro Feh lo fa{line_break}senza alcun problema, perché{line_break}è un grande maestro.{end_wait}"

msgctxt "message"
msgid "06121"
msgstr "Appena Feh ha urlato \"IAH!\"{line_break}tutti i ladri sono fuggiti.{end_wait}"

msgctxt "message"
msgid "06122"
msgstr "I gelsi sono preziosi per{line_break}il villaggio: sono la{line_break}nostra fonte di ricchezza.{end_wait}"

msgctxt "message"
msgid "06123"
msgstr "È pericoloso andare da{line_break}soli verso occidente.{page_break}Devo trovare qualcuno che{line_break}mi accompagni.{end_wait}"

msgctxt "message"
msgid "06124"
msgstr "Devo portare acqua{line_break}tutto il giorno...{line_break}È faticosissimo!{end_wait}"

msgctxt "message"
msgid "06125"
msgstr "La raccolta dei frutti dei{line_break}gelsi è terminata: ora i{line_break}bachi potranno sfamarsi!{page_break}Così, i fili prodotti dai{line_break}bachi diventeranno seta,{page_break}che potremmo vendere{line_break}ai mercanti.{end_wait}"

msgctxt "message"
msgid "06126"
msgstr "È dura lavorare in{line_break}campagna... I guerrieri{line_break}non ne hanno idea...{end_wait}"

msgctxt "message"
msgid "06127"
msgstr "Presto il maestro Hammet{line_break}verrà a comprare{line_break}moltissima seta.{end_wait}"

msgctxt "message"
msgid "06128"
msgstr "Lavorare in campagna è{line_break}faticoso, soprattutto per{line_break}le spalle e per la schiena...{end_wait}"

msgctxt "message"
msgid "06129"
msgstr "Atrraverso la Strada della Seta,{line_break}la seta di Xian raggiunge{page_break}Tolbi, una grande città{line_break}che si trova a sudovest.{end_wait}"

msgctxt "message"
msgid "06130"
msgstr "La Strada della Seta{line_break}conduce a Tolbi, una{line_break}città molto grande.{end_wait}"

msgctxt "message"
msgid "06131"
msgstr "La Strada della Seta è{line_break}percorsa da molti mercanti.{end_wait}"

msgctxt "message"
msgid "06132"
msgstr "I mercanti raccontano che{line_break}Tolbi è un posto bellissimo,{line_break}magnifico...{end_wait}"

msgctxt "message"
msgid "06133"
msgstr "Seguite la Strada della Seta.{line_break}Quando raggiungete un bivio,{line_break}in montagna, andate a nord.{page_break}Così arriverete{line_break}ad Altin.{end_wait}"

msgctxt "message"
msgid "06134"
msgstr "Ad Altin c'è una miniera.{line_break}Vi sono molte gemme e{line_break}parecchio acciaio.{end_wait}"

msgctxt "message"
msgid "06135"
msgstr "Altin ha molti abitanti,{line_break}tutti un po' timidi.{end_wait}"

msgctxt "message"
msgid "06136"
msgstr "Lavorare in miniera è{line_break}faticoso. È particolarmente{line_break}difficile per le donne.{end_wait}"

msgctxt "message"
msgid "06137"
msgstr "Le arti marziali difendono{line_break}Xian, ma il kung fu da solo{line_break}non basta.{page_break}Per questo a Xian si{line_break}vendono molte{line_break}armi.{end_wait}"

msgctxt "message"
msgid "06138"
msgstr "C'è chi dice che lottare{line_break}con le armi sia da codardi.{line_break}Io non ci credo.{page_break}Ci sono molti tipi di{line_break}combattenti, e molti{line_break}modi di combattere.{end_wait}"

msgctxt "message"
msgid "06139"
msgstr "Chi pratica le arti marziali{line_break}non può indossare pesanti{line_break}armature, o perde velocità.{page_break}...Per i guerrieri è diverso.{line_break}Per loro le armature{line_break}sono un vantaggio.{end_wait}"

msgctxt "message"
msgid "06140"
msgstr "I guerrieri lottano{line_break}con le armi.{page_break}Nel kung fu, invece, si{line_break}lotta con l'astuzia.{end_wait}"

msgctxt "message"
msgid "06141"
msgstr "Le armature speciali di Xian{line_break}non fanno per i guerrieri.{page_break}È meglio comprare{line_break}un'armatura normale.{end_wait}"

msgctxt "message"
msgid "06142"
msgstr "Xian è un villaggio di{line_break}artigiani. Non comprano{line_break}strumenti, se li producono.{end_wait}"

msgctxt "message"
msgid "06143"
msgstr "I guerrieri dovrebbero{line_break}apprendere dalle{line_break}città che visitano.{page_break}Viaggiare soltanto{line_break}per lottare è{line_break}tristissimo.{end_wait}"

msgctxt "message"
msgid "06144"
msgstr "Di solito molti mercanti{line_break}giungono al villaggio, ma{line_break}non se ne sono ancora visti.{page_break}Questo è{line_break}piuttosto strano.{end_wait}"

msgctxt "message"
msgid "06145"
msgstr "Tutti quelli che vengono a{line_break}mangiare qui sono di Xian.{line_break}Che cosa sta succedendo?{end_wait}"

msgctxt "message"
msgid "06146"
msgstr "Se vai in un posto nuovo{line_break}impara le regole{line_break}di quel luogo.{page_break}È un antico{line_break}proverbio di Xian.{end_wait}"

msgctxt "message"
msgid "06147"
msgstr "Se arrivano i mercanti{line_break}i miei affari andranno{line_break}a gonfie vele.{page_break}Ma se i mecanti non{line_break}arrivano, le cose{line_break}si mettono male.{end_wait}"

msgctxt "message"
msgid "06148"
msgstr "Ci sono meno viaggiatori{line_break}in giro, e meno persone{line_break}si fermano a mangiare.{page_break}Ma che fine hanno fatto{line_break}tutti i viaggiatori?{end_wait}"

msgctxt "message"
msgid "06149"
msgstr "Sono giunto a Xian da{line_break}terre lontane per diffondere{line_break}la buona volontà.{end_wait}"

msgctxt "message"
msgid "06150"
msgstr "Stando a Xian per molto{line_break}tempo si inizia a{line_break}parlare stranamente.{page_break}Inizio a non capirci{line_break}più nulla...{end_wait}"

msgctxt "message"
msgid "06151"
msgstr "È la scuola del maestro{line_break}Feh...{line_break}Volete dare un'occhiata?{end_now}"

msgctxt "message"
msgid "06152"
msgstr "Dovete promettermi{line_break}di parlare sottovoce.{end_wait}"

msgctxt "message"
msgid "06153"
msgstr "I guerrieri dovrebbero{line_break}apprendere le arti marziali.{line_break}Possono essere utili.{end_wait}"

msgctxt "message"
msgid "06154"
msgstr "È importante sferrare{line_break}calci potenti.{line_break}Calcio, calcio, calcio!{page_break}È così che si fa.{end_wait}"

msgctxt "message"
msgid "06155"
msgstr "Mi alleno perché voglio{line_break}apprendere. È importante{line_break}sferrare pugni rapidi.{page_break}Il maestro Feh è{line_break}davvero molto bravo.{end_wait}"

msgctxt "message"
msgid "06156"
msgstr "I salti e l'agilità{line_break}sono molto importanti{line_break}nel kung fu.{end_wait}"

msgctxt "message"
msgid "06157"
msgstr "Tutti a Xian conoscono{line_break}le arti marziali.{page_break}Ma solo i migliori{line_break}frequentano la scuola{line_break}di arti marziali di Feh.{end_wait}"

msgctxt "message"
msgid "06158"
msgstr "Ascoltare soltanto non{line_break}rende forti.{line_break}Io apprendo osservando.{end_wait}"

msgctxt "message"
msgid "06159"
msgstr "Il maestro Feh è molto{line_break}occupato. Volete{line_break}vederlo comunque?{end_now}"

msgctxt "message"
msgid "06160"
msgstr "Vedi quella linea? Vai{line_break}lì e usa il Chi.{page_break}Se cade l'albero,{line_break}vi porterò dal{line_break}maestro Feh.{end_wait}"

msgctxt "message"
msgid "06161"
msgstr "Non volete vedere il{line_break}maestro Feh? Male,{line_break}molto male.{end_wait}"

msgctxt "message"
msgid "06162"
msgstr "Il maestro Feh è molto{line_break}occupato. Sta parlando{line_break}con la figlia, Feizhi.{page_break}Non potete entrare.{end_wait}"

msgctxt "message"
msgid "06163"
msgstr "I guerrieri lottano con{line_break}le armi... Il kung fu{line_break}non ha importanza per voi.{end_wait}"

msgctxt "message"
msgid "06164"
msgstr "I piedi mi fanno male per{line_break}l'allenamento con i calci.{line_break}Ma non voglio smettere!{end_wait}"

msgctxt "message"
msgid "06165"
msgstr "Un buon pugno!{line_break}È sorprendente, guerriero.{end_wait}"

msgctxt "message"
msgid "06166"
msgstr "Sei troppo lento per me.{line_break}Non mi colpirai mai con{line_break}la tua arma: provaci!{end_wait}"

msgctxt "message"
msgid "06167"
msgstr "Dei guerrieri sono venuti alla{line_break}scuola di Feh per apprendere il{line_break}kung fu... Ormai è famosissima!{end_wait}"

msgctxt "message"
msgid "06168"
msgstr "Un grande calcio, che parte{line_break}dall'anca. Quando colpisce{line_break}fa davvero male.{end_wait}"

msgctxt "message"
msgid "06169"
msgstr "Siete i guerrieri venuti{line_break}per studiare, vero?{page_break}Ma chiedere di essere{line_break}presentati a Feh è troppo.{end_wait}"

msgctxt "message"
msgid "06170"
msgstr "Il maestro Feh sta parlando{line_break}con Feizhi di qualcosa{line_break}di molto importante.{page_break}Non potete disturbarli.{end_wait}"

msgctxt "message"
msgid "06171"
msgstr "Che succede!? L'albero{line_break}è caduto da solo!{end_wait}"

msgctxt "message"
msgid "06172"
msgstr "Non puoi spingerlo{line_break}con le mani. Bisogna{line_break}attaccarlo con il Chi.{end_wait}"

msgctxt "message"
msgid "06173"
msgstr "Cosa hai fatto,{line_break}guerriero?{end_wait}"

msgctxt "message"
msgid "06174"
msgstr "Il guerriero ha usato il Chi!{line_break}L'ha usato dalla linea...{line_break}...e l'albero è caduto!{end_wait}"

msgctxt "message"
msgid "06175"
msgstr "Conosce il kung fu!{line_break}Voi conoscete il kung fu?{end_now}"

msgctxt "message"
msgid "06176"
msgstr "Il vostro Chi dev'essere{line_break}molto potente se si può{line_break}usare da distante.{page_break}Devo dirlo al maestro Feh!{end_wait}"

msgctxt "message"
msgid "06177"
msgstr "È incredibile che qualcuno{line_break}che non conosce il kung fu{line_break}possa usare il Chi.{end_wait}"

msgctxt "message"
msgid "06178"
msgstr "Che è successo!?{line_break}La porta s'è{line_break}aperta da sola!{end_wait}"

msgctxt "message"
msgid "06179"
msgstr "Feizhi! Aspetta!{end_wait}"

msgctxt "message"
msgid "06180"
msgstr "Sei preoccupata perché{line_break}Hsu è in ritardo?{end_wait}"

msgctxt "message"
msgid "06181"
msgstr "Si sarà soltanto un{line_break}po' attardato{line_break}tornando dal tempio!{end_wait}"

msgctxt "message"
msgid "06182"
msgstr "Sento che Hsu non{line_break}è al sicuro... {end_wait}"

msgctxt "message"
msgid "06183"
msgstr "Aaah, Feizhi...{line_break}Di nuovo il tuo potere?{end_wait}"

msgctxt "message"
msgid "06184"
msgstr "Da quando m'ha colpito quella{line_break}pioggia di gemme dal cielo,{line_break}avverto i pericoli.{end_wait}"

msgctxt "message"
msgid "06185"
msgstr "Sì, da quando hai ricevuto{line_break}il potere della profezia puoi{line_break}presagire il male...{page_break}Me l'hai già{line_break}detto.{end_wait}"

msgctxt "message"
msgid "06186"
msgstr "Non è vero, Feizhi.{line_break}Le tue visioni sono{line_break}soltanto coincidenze.{end_wait}"

msgctxt "message"
msgid "06187"
msgstr "Le mie visioni si sono{line_break}spesso avverate, no?{end_wait}"

msgctxt "message"
msgid "06188"
msgstr "Anche la visione sulla{line_break}Foresta di Mogall{line_break}s'è avverata...{end_wait}"

msgctxt "message"
msgid "06189"
msgstr "Sì, le tue predizioni si{line_break}sono avverate, Feizhi, è{line_break}stata una vera sorpresa!{end_wait}"

msgctxt "message"
msgid "06190"
msgstr "E l'inondazione di Altin...{line_break}Avevo predetto{line_break}anche quella, no?{end_wait}"

msgctxt "message"
msgid "06191"
msgstr "Tutte le predizioni di{line_break}Feizhi si sono avverate.{end_wait}"

msgctxt "message"
msgid "06192"
msgstr "Non credi, padre?{end_wait}"

msgctxt "message"
msgid "06193"
msgstr "Ho sentito tutto. Sono{line_break}sorpreso, ma credo comunque{line_break}che sia una coincidenza.{end_wait}"

msgctxt "message"
msgid "06194"
msgstr "Ancora non{line_break}ci credi?{end_wait}"

msgctxt "message"
msgid "06195"
msgstr "Hsu è semplicemente in{line_break}ritardo: non devi{line_break}preoccuparti troppo.{end_wait}"

msgctxt "message"
msgid "06196"
msgstr "Hai mandato qualcuno a{line_break}cercare Hsu, vero?{end_wait}"

msgctxt "message"
msgid "06197"
msgstr "Che uomo cocciuto.{end_wait}"

msgctxt "message"
msgid "06198"
msgstr "Ehi Feizhi!{line_break}Non dovresti parlare così a{line_break}chi è più anziano di te.{end_wait}"

msgctxt "message"
msgid "06199"
msgstr "E va bene... Vorrà dire{line_break}che ci andrò io, da sola!{end_wait}"

msgctxt "message"
msgid "06200"
msgstr "È troppo pericoloso.{end_wait}"

msgctxt "message"
msgid "06201"
msgstr "Maestro Feh!{line_break}Feizhi se n'è andata!{end_wait}"

msgctxt "message"
msgid "06202"
msgstr "Feizhi era arrabbiatissima.{line_break}Faceva paura!{end_wait}"

msgctxt "message"
msgid "06203"
msgstr "Hsu è in pericolo. Feizhi{line_break}vuole prestargli aiuto.{end_wait}"

msgctxt "message"
msgid "06204"
msgstr "Feizhi sa usare il kung fu.{line_break}Non correrà pericoli.{end_wait}"

msgctxt "message"
msgid "06205"
msgstr "Feizhi è sola, non{line_break}andrà lontano.{end_wait}"

msgctxt "message"
msgid "06206"
msgstr "Lasciala fare,{line_break}s'arrenderà{line_break}presto...{end_wait}"

msgctxt "message"
msgid "06207"
msgstr "Quell'albero... è caduto.{line_break}Com'è successo?{end_wait}"

msgctxt "message"
msgid "06208"
msgstr "È stato il guerriero,{line_break}usando il Chi.{end_wait}"

msgctxt "message"
msgid "06209"
msgstr "Guerriero, tu...{line_break}...sai usare il Chi?{end_now}"

msgctxt "message"
msgid "06210"
msgstr "Fallo ancora, guerriero.{line_break}Fammi vedere come usi il Chi.{end_wait}"

msgctxt "message"
msgid "06211"
msgstr "Guerriero, non dire{line_break}bugie... Ha usato il Chi.{line_break}Fallo ancora!{end_now}"

msgctxt "message"
msgid "06212"
msgstr "Fammi vedere come{line_break}usi il Chi, guerriero.{end_wait}"

msgctxt "message"
msgid "06213"
msgstr "Voglio vedere come{line_break}usi il Chi, guerriero.{end_wait}"

msgctxt "message"
msgid "06214"
msgstr "Guerriero, fammi vedere{line_break}come usi il Chi.{end_wait}"

msgctxt "message"
msgid "06215"
msgstr "Feizhi è andata via! È{line_break}pericoloso fuori dal{line_break}villaggio...{end_wait}"

msgctxt "message"
msgid "06216"
msgstr "Feizhi è più forte{line_break}di quanto sembri,{line_break}non avrà problemi.{end_wait}"

msgctxt "message"
msgid "06217"
msgstr "Guerriero, mostraci{line_break}ancora come usi il Chi.{end_wait}"

msgctxt "message"
msgid "06218"
msgstr "Non male davvero... Ma il{line_break}maestro Feh usa il Chi in{line_break}modo molto più potente.{end_wait}"

msgctxt "message"
msgid "06219"
msgstr "Guerriero, mostrami{line_break}come usi il Chi. Voglio{line_break}proprio vedere.{end_wait}"

msgctxt "message"
msgid "06220"
msgstr "Feizhi, lo so... So{line_break}come ti senti...{page_break}Ma bisognerebbe sempre{line_break}ascoltare il maestro Feh.{end_wait}"

msgctxt "message"
msgid "06221"
msgstr "I miei calci e pugni{line_break}sono molto potenti! Fanno{line_break}davvero male...{end_wait}"

msgctxt "message"
msgid "06222"
msgstr "Mostraci come usi il{line_break}Chi. Dai...{line_break}Vogliamo vedere...{end_wait}"

msgctxt "message"
msgid "06223"
msgstr "Ehi, questo guerriero sa{line_break}usare il Chi! Cosa dirà{page_break}il maestro Feh quando{line_break}lo vedrà?{end_wait}"

msgctxt "message"
msgid "06224"
msgstr "Guerriero, vuoi mostrarmi{line_break}come usi il Chi?{end_now}"

msgctxt "message"
msgid "06225"
msgstr "Allora fammi vedere.{end_wait}"

msgctxt "message"
msgid "06226"
msgstr "Ciò che sai fare è{line_break}una cosa eccezionale.{line_break}Non farti pregare...{end_wait}"

msgctxt "message"
msgid "06227"
msgstr "Feizhi è andata via.{line_break}È pericoloso fuori{line_break}dal villaggio...{end_wait}"

msgctxt "message"
msgid "06228"
msgstr "Feizhi è più forte{line_break}di quanto sembri,{line_break}non avrà problemi.{end_wait}"

msgctxt "message"
msgid "06229"
msgstr "Lo so che sai usare{line_break}il Chi, guerriero...{line_break}Lo so...{end_wait}"

msgctxt "message"
msgid "06230"
msgstr "Guerriero, il Chi è un{line_break}potere fortissimo.{page_break}Il maestro ci tiene molto{line_break}a vedere come sai usarlo.{end_wait}"

msgctxt "message"
msgid "06231"
msgstr "Voglio vedere come usa il{line_break}Chi un guerriero che{line_break}conosce le arti marziali.{page_break}Dai, fammi vedere,{line_break}guerriero!{end_wait}"

msgctxt "message"
msgid "06232"
msgstr "Feizhi, so come ti senti.{line_break}Ma non è saggio andare contro{line_break}il volere del maestro Feh.{end_wait}"

msgctxt "message"
msgid "06233"
msgstr "I miei calci e pugni{line_break}sono molto potenti! Fanno{line_break}davvero male...{end_wait}"

msgctxt "message"
msgid "06234"
msgstr "Guerriero, mostrami{line_break}come usi il Chi. Ora,{line_break}ora, fammi vedere...{end_wait}"

msgctxt "message"
msgid "06235"
msgstr "Guerriero, non devi{line_break}nascondere al maestro Feh la{line_break}tua abilità con il Chi.{end_wait}"

msgctxt "message"
msgid "06236"
msgstr "Guarda, l'albero è caduto.{end_wait}"

msgctxt "message"
msgid "06237"
msgstr "Hai visto, maestro?{line_break}Il guerriero ha usato il Chi!{end_wait}"

msgctxt "message"
msgid "06238"
msgstr "Maestro, che{line_break}succede?{end_wait}"

msgctxt "message"
msgid "06239"
msgstr "Ma non l'ha fatto dalla{line_break}linea, quindi non posso{line_break}esserne sicuro.{end_wait}"

msgctxt "message"
msgid "06240"
msgstr "Non va bene...{line_break}Devi farlo dalla linea,{line_break}altrimenti non va bene.{end_wait}"

msgctxt "message"
msgid "06241"
msgstr "Guerriero, usa il tuo{line_break}Chi dalla linea.{end_wait}"

msgctxt "message"
msgid "06242"
msgstr "Guerriero, ti prego!{line_break}Usa il tuo Chi{line_break}dalla linea.{end_wait}"

msgctxt "message"
msgid "06243"
msgstr "Guerriero, le regole{line_break}richiedono che usi il{line_break}Chi dalla linea!{page_break}Non puoi tirarti{line_break}indietro adesso.{end_wait}"

msgctxt "message"
msgid "06244"
msgstr "Ci sei andato vicino.{line_break}Guerriero, usa il Chi{line_break}dalla linea!{end_wait}"

msgctxt "message"
msgid "06245"
msgstr "Sì! L'albero è caduto!{end_wait}"

msgctxt "message"
msgid "06246"
msgstr "Hai visto, maestro? Il{line_break}guerriero ha usato il Chi!{end_wait}"

msgctxt "message"
msgid "06247"
msgstr "Il guerriero usa il Chi in{line_break}modo fantastico! Ne sei{line_break}sorpreso, maestro?{end_wait}"

msgctxt "message"
msgid "06248"
msgstr "Che problema c'è, maestro?{end_wait}"

msgctxt "message"
msgid "06249"
msgstr "Hmmmm... Il guerriero ha{line_break}fatto cadere l'albero,{line_break}è vero...{end_wait}"

msgctxt "message"
msgid "06250"
msgstr "C'è qualcosa che non va con{line_break}il Chi del guerriero?{end_wait}"

msgctxt "message"
msgid "06251"
msgstr "Il guerriero...{line_break}Non ha usato il Chi.{end_wait}"

msgctxt "message"
msgid "06252"
msgstr "Come? Non ha usato il Chi?{end_wait}"

msgctxt "message"
msgid "06253"
msgstr "Hmmm... È molto{line_break}simile, ma non{line_break}è il Chi.{end_wait}"

msgctxt "message"
msgid "06254"
msgstr "Guerriero... Sei stato{pause_20_skippable}{line_break}al Tempio di Fuchin?{end_now}"

msgctxt "message"
msgid "06255"
msgstr "Ah... Lo sapevo.{end_wait}"

msgctxt "message"
msgid "06256"
msgstr "Hmmm... Strano...{end_wait}"

msgctxt "message"
msgid "06257"
msgstr "Cosa c'entra il Chi con{line_break}il Tempio di Fuchin?{end_wait}"

msgctxt "message"
msgid "06258"
msgstr "Io ho appreso il Chi{pause_20_skippable}{line_break}dalla maestra Hama{line_break}del Tempio di Lama.{end_wait}"

msgctxt "message"
msgid "06259"
msgstr "Ma{pause_20_skippable} è lo stesso{line_break}Chi,{pause_20_skippable} no?{end_wait}"

msgctxt "message"
msgid "06260"
msgstr "Molto simile...{line_break}Ma non identico...{end_wait}"

msgctxt "message"
msgid "06261"
msgstr "Il Chi concentra in una{line_break}mano tutta l'energia{line_break}del corpo...{page_break}...per liberarla su un{line_break}oggetto distante.{end_wait}"

msgctxt "message"
msgid "06262"
msgstr "Tu, guerriero, hai usato{line_break}l'energia della tua mente.{line_break}Capisci ora?{end_now}"

msgctxt "message"
msgid "06263"
msgstr "Questo guerriero è molto{page_break}saggio. Ci vuole saggezza{line_break}per far spostare un oggetto{line_break}con la forza della volontà.{end_wait}"

msgctxt "message"
msgid "06264"
msgstr "Ricorda...{page_break}Per desiderare qualcosa{line_break}occorre concentrarsi{line_break}intensamente.{end_wait}"

msgctxt "message"
msgid "06265"
msgstr "Il Ki di Fuchin libera{line_break}l'energia mentale come il{line_break}Chi quella corporea.{end_wait}"

msgctxt "message"
msgid "06266"
msgstr "L'energia corporea ha dei{line_break}limiti, ma quella mentale{pause_20_skippable}{line_break}ne ha molto pochi.{end_wait}"

msgctxt "message"
msgid "06267"
msgstr "Coltiva il tuo Ki e{line_break}diventerai molto forte.{line_break}Fai del tuo meglio, guerriero.{end_wait}"

msgctxt "message"
msgid "06268"
msgstr "Continuate ad allenarvi!{line_break}Il Chi ha i suoi limiti, ma{line_break}tutti possono usarlo.{page_break}Allenatevi con costanza...{line_break}Così apprenderete il{line_break}potere del Chi.{end_wait}"

msgctxt "message"
msgid "06269"
msgstr "Sei grande, guerriero.{line_break}Meriti tutto il mio{line_break}rispetto.{end_wait}"

msgctxt "message"
msgid "06270"
msgstr "Tutti vogliono apprendere{line_break}il Chi del maestro Feh.{page_break}Studierò il kung fu per{line_break}apprendere il Chi.{end_wait}"

msgctxt "message"
msgid "06271"
msgstr "Concentra l'energia nelle{line_break}mani{pause_20_skippable} e liberala:{line_break}è il Chi.{page_break}È questo che insegna il{line_break}maestro Feh, ma non è{page_break}facile. Il maestro Hsu è{line_break}andato al Tempio di Lama, dove{line_break}apprende dal maestro Hama.{end_wait}"

msgctxt "message"
msgid "06272"
msgstr "Il Tempio di Lama è molto{line_break}ad ovest. Il maestro Hsu{page_break}è andato ad allenarsi là.{line_break}Tornerà indietro{line_break}fortissimo.{end_wait}"

msgctxt "message"
msgid "06273"
msgstr "Non credevo che fossi così{line_break}forte, guerriero. Scusami.{end_wait}"

msgctxt "message"
msgid "06274"
msgstr "Dov'è andata Feizhi?{line_break}Come sto in pensiero...{end_wait}"

msgctxt "message"
msgid "06275"
msgstr "Il maestro Hsu è in{line_break}ritardo. Capisco perché{line_break}Feizhi è preoccupata.{end_wait}"

msgctxt "message"
msgid "06276"
msgstr "Apprenderò il Chi e{line_break}diventerò più forte{line_break}del maestro Feh...{end_wait}"

msgctxt "message"
msgid "06277"
msgstr "Il tuo Chi è del Tempio{line_break}di Fuchin. In cosa è diverso{line_break}dal nostro Chi?{end_wait}"

msgctxt "message"
msgid "06278"
msgstr "Non m'importa di quale Chi{line_break}si tratti, se quello di{line_break}Fuchin o del kung fu...{page_break}Devo impararlo comunque!{end_wait}"

msgctxt "message"
msgid "06279"
msgstr "Il Chi della maestra Hama{line_break}può frantumare i massi.{page_break}Anche il maestro Hsu può{line_break}frantumare i massi con{line_break}il suo Chi?{end_wait}"

msgctxt "message"
msgid "06280"
msgstr "Segui la Strada della Seta.{line_break}Attraversato il canyon,{line_break}giungerai al Tempio di Lama.{end_wait}"

msgctxt "message"
msgid "06281"
msgstr "Guerriero, tu usi le{line_break}armi ed il Chi. Sei{line_break}molto pericoloso.{end_wait}"

msgctxt "message"
msgid "06282"
msgstr "Feizhi non è più alla{line_break}scuola di Feh...{line_break}Ciò è molto triste.{end_wait}"

msgctxt "message"
msgid "06283"
msgstr "Feizhi si preoccupa{line_break}solo per il maestro Hsu...{line_break}Inizio ad essere geloso!{end_wait}"

msgctxt "message"
msgid "06284"
msgstr "Imparare il Chi...{line_break}è molto pericoloso. Il{line_break}maestro Feh è eccezionale.{end_wait}"

msgctxt "message"
msgid "06285"
msgstr "Davvero un giovane{line_break}guerriero può fare questo?{line_break}Stento a crederlo...{end_wait}"

msgctxt "message"
msgid "06286"
msgstr "Sei un grande guerriero.{line_break}Continua ad allenarti{line_break}come hai sempre fatto.{end_wait}"

msgctxt "message"
msgid "06287"
msgstr "È chiuso a chiave.{end_wait}"

msgctxt "message"
msgid "06288"
msgstr "I guerrieri non possono...{line_break}Ehi, un momento.{pause_20_skippable} Ma questo{line_break}è un altro tipo di Chi.{end_wait}"

msgctxt "message"
msgid "06289"
msgstr "Non oltrepassare quella{line_break}linea, guerriero.{end_wait}"

msgctxt "message"
msgid "06290"
msgstr "Stai al di là della linea e{line_break}prova il Chi.{end_wait}"

msgctxt "message"
msgid "06291"
msgstr "Pensi che ti stia{line_break}seguendo, guerriero?{end_now}"

msgctxt "message"
msgid "06292"
msgstr "Ti sbagli, guerriero.{line_break}Voglio solo andare{line_break}verso ovest.{page_break}Vai ad ovest anche tu.{line_break}È per questo che stiamo{pause_20_skippable}{line_break}andando ad ovest insieme.{end_wait}"

msgctxt "message"
msgid "06293"
msgstr "Hai ragione, guerriero.{line_break}Sto andando a{pause_20_skippable}{line_break}ovest come te.{end_wait}"

msgctxt "message"
msgid "06294"
msgstr "Sei tenace, guerriero.{line_break}Voglio soltanto andare{line_break}verso ovest.{page_break}Quindi, andremo verso{pause_20_skippable}{line_break}ovest insieme.{end_wait}"

msgctxt "message"
msgid "06295"
msgstr "Ecco la Strada della Seta!{line_break}Ma è bloccata dai massi.{end_wait}"

msgctxt "message"
msgid "06296"
msgstr "La mia visione...{line_break}S'è avverata.{end_wait}"

msgctxt "message"
msgid "06297"
msgstr "Hsu, Hsu!{end_wait}"

msgctxt "message"
msgid "06298"
msgstr "È preoccupante...{line_break}Non riesco a sentire{line_break}la voce di Hsu!{end_wait}"

msgctxt "message"
msgid "06299"
msgstr "E ora che faccio?{line_break}Guerriero, devo{line_break}tornare a Xian?{end_now}"

msgctxt "message"
msgid "06300"
msgstr "Non posso tornare indietro.{line_break}Devo trovare Hsu.{end_wait}"

msgctxt "message"
msgid "06301"
msgstr "Hai ragione, guerriero.{line_break}Non posso tornare indietro.{line_break}Devo trovare Hsu.{end_wait}"

msgctxt "message"
msgid "06302"
msgstr "Hsu è in pericolo.{line_break}Lo sento... Devo{line_break}trovarlo!{end_wait}"

msgctxt "message"
msgid "06303"
msgstr "È a prima volta che{line_break}vieni ad Altin?{end_now}"

msgctxt "message"
msgid "06304"
msgstr "Guarda com'è{line_break}cambiata Altin!{page_break}Non resta che attendere{line_break}che le acque{line_break}si ritirino.{end_wait}"

msgctxt "message"
msgid "06305"
msgstr "Sembra una{line_break}città di{line_break}mare, eh?{end_now}"

msgctxt "message"
msgid "06306"
msgstr "E invece non lo è...{line_break}Pensa che un tempo ad Altin{line_break}non c'era neppure un pozzo.{page_break}Il villaggio è{line_break}stato inondato da{line_break}mostri sputa-acqua.{end_wait}"

msgctxt "message"
msgid "06307"
msgstr "Il giorno in cui le gemme{line_break}sono cadute dal cielo{pause_20_skippable},{line_break}sono apparsi dal{page_break}nulla quei mostri.{line_break}Sono stati la rovina{line_break}del villaggio!{end_wait}"

msgctxt "message"
msgid "06308"
msgstr "Come possono quelle creature{line_break}sputare tanta acqua?{end_wait}"

msgctxt "message"
msgid "06309"
msgstr "È orribile! La mia casa{line_break}è inondata dall'acqua{line_break}sputata dai mostri.{end_wait}"

msgctxt "message"
msgid "06310"
msgstr "Persino la miniera è{line_break}completamente sommersa.{line_break}Nessuno può entrarvi.{end_wait}"

msgctxt "message"
msgid "06311"
msgstr "Se solo potessimo distruggere{line_break}quei mostri, tutta l'acqua{line_break}si prosciugherebbe.{end_wait}"

msgctxt "message"
msgid "06312"
msgstr "Altin è sempre stata{line_break}povera d'acqua, e ora{line_break}ne è inondata.{page_break}Siamo passati dalla{line_break}padella nella{line_break}brace.{end_wait}"

msgctxt "message"
msgid "06313"
msgstr "L'acqua sputata dai{line_break}mostri è imbevibile!{line_break}È disgustosa...{page_break}Ma è possibile che nessuno{line_break}possa uccidere quelle bestie?{end_wait}"

msgctxt "message"
msgid "06314"
msgstr "Qui intorno le acque si{line_break}sono ritirate...{page_break}Chissà se è stata la{line_break}miniera ad assorbire{line_break}l'acqua...{end_wait}"

msgctxt "message"
msgid "06315"
msgstr "I mostri d'acqua erano{line_break}identici alle statue{line_break}protettrici di Altin...{page_break}È possibile che statue{line_break}protettrici si siano{line_break}trasformate in mostri?{end_wait}"

msgctxt "message"
msgid "06316"
msgstr "L'acqua ha buttato{line_break}tonnellate di rocce{line_break}fuori dalla miniera.{page_break}Magari ora troveremo gemme{line_break}e minerali che prima{line_break}erano nascosti.{end_wait}"

msgctxt "message"
msgid "06317"
msgstr "Siete giunti ad Altin in{line_break}un momento poco opportuno.{line_break}Che sfortuna, eh?{end_wait}"

msgctxt "message"
msgid "06318"
msgstr "Sembra quasi che{line_break}trasformino l'aria{line_break}stessa in acqua!{end_wait}"

msgctxt "message"
msgid "06319"
msgstr "Ho potuto salvare la mia{line_break}prima lettera d'amore,{line_break}ma tutto il resto?{end_wait}"

msgctxt "message"
msgid "06320"
msgstr "Neppure i minatori più{line_break}esperti possono fare nulla{line_break}contro quest'acqua.{end_wait}"

msgctxt "message"
msgid "06321"
msgstr "Se quelle bestie continuano{line_break}a sputare acqua...{page_break}...il villaggio sarà presto{line_break}sommerso interamente.{end_wait}"

msgctxt "message"
msgid "06322"
msgstr "L'acqua è bella ma{line_break}non quando ti inonda{line_break}la casa!{end_wait}"

msgctxt "message"
msgid "06323"
msgstr "I mostri hanno sputato{line_break}tutta quest'acqua...{line_break}L'odore è disgustoso...{end_wait}"

msgctxt "message"
msgid "06324"
msgstr "L'acqua si ritira se{line_break}i mostri scompaiono.{page_break}Forse i mostri{line_break}scompariranno{line_break}molto presto...{end_wait}"

msgctxt "message"
msgid "06325"
msgstr "Ora che ci penso, mi è parso{line_break}che la statua protrettrice{line_break}sputasse acqua.{end_wait}"

msgctxt "message"
msgid "06326"
msgstr "È meglio che continuare{line_break}a dissotterrare quelle{line_break}dannate reliquie.{end_wait}"

msgctxt "message"
msgid "06327"
msgstr "Oh no... La casa è{line_break}completamente bagnata...{end_wait}"

msgctxt "message"
msgid "06328"
msgstr "Se avessi davanti il mostro{line_break}che ha fatto tutto questo,{line_break}gli darei un bel pugno!{page_break}No, sto scherzando...{line_break}Sono contro ogni{line_break}forma di violenza.{end_wait}"

msgctxt "message"
msgid "06329"
msgstr "Ci vorrà parecchio lavoro{line_break}per rimettere in sesto{line_break}la casa.{end_wait}"

msgctxt "message"
msgid "06330"
msgstr "Non basta un colpo...{line_break}Pum! Pum! Pum! Ecco{line_break}un bel montante!{end_wait}"

msgctxt "message"
msgid "06331"
msgstr "State cercando di ritrovare{line_break}la strada del ritorno{line_break}attraverso le montagne?{end_now}"

msgctxt "message"
msgid "06332"
msgstr "In fondo alla miniera{line_break}dev'esserci un passaggio{line_break}che conduce ad est.{end_wait}"

msgctxt "message"
msgid "06333"
msgstr "Non so come abbiate fatto,{line_break}ma sono felice che abbiate{line_break}sconfitto quelle bestie.{end_wait}"

msgctxt "message"
msgid "06334"
msgstr "Non siate troppo cattivi{line_break}con quelle bestie.{end_wait}"

msgctxt "message"
msgid "06335"
msgstr "Temevo che il villaggio fosse{line_break}spacciato, ma la speranza{line_break}non m'ha mai abbandonato.{end_wait}"

msgctxt "message"
msgid "06336"
msgstr "Sono felice di aver{line_break}riavuto la mia casa.{end_wait}"

msgctxt "message"
msgid "06337"
msgstr "Non volevo abbandonare la{line_break}mia casa... Per questo{line_break}sono tornato!{end_wait}"

msgctxt "message"
msgid "06338"
msgstr "Ho sentito che qualcuno ha{line_break}sconfitto le bestie d'acqua.{line_break}Per questo sono tornata.{page_break}Casa, dolce{line_break}casa...{end_wait}"

msgctxt "message"
msgid "06339"
msgstr "Hai sconfitto tu{line_break}quei mostri, vero?{end_now}"

msgctxt "message"
msgid "06340"
msgstr "Eccoti un bel bacio,{line_break}come ringraziamento!{page_break}Ehi, sei diventato{line_break}tutto rosso!{end_wait}"

msgctxt "message"
msgid "06341"
msgstr "No? Beh, comunque sono{line_break}felice d'essere di nuovo{line_break}a casa! Eccoti un bacio!{page_break}Ehi, sei diventato{line_break}tutto rosso!{end_wait}"

msgctxt "message"
msgid "06342"
msgstr "Il fondo della miniera...{line_break}La fine del passaggio{line_break}più orientale...{page_break}Non m'arrenderò.{end_wait}"

msgctxt "message"
msgid "06343"
msgstr "Mio marito ha un fiuto{line_break}infallibile per{line_break}i tesori.{page_break}Ha intenzione di scavare{line_break}in quel punto da{line_break}lui individuato.{end_wait}"

msgctxt "message"
msgid "06344"
msgstr "Mamma e papà sanno{line_break}qualcosa riguardo al{line_break}fondo della miniera.{page_break}Spero che mi dicano{line_break}di cosa si tratta.{end_wait}"

msgctxt "message"
msgid "06345"
msgstr "Ti servono armi?{end_now}"

msgctxt "message"
msgid "06346"
msgstr "Quando l'acqua si sarà{line_break}ritirata, potrai avere{line_break}tutto ciò che desideri.{page_break}Ma cosa abbiamo fatto{line_break}per desiderare{line_break}tutto questo?{end_wait}"

msgctxt "message"
msgid "06347"
msgstr "Dici così perché non hai{line_break}visto le mie armi. Mi{line_break}piacerebbe mostrartele...{end_wait}"

msgctxt "message"
msgid "06348"
msgstr "Grazie al cielo l'acqua{line_break}s'è ritirata! Ora posso{line_break}riaprire il negozio!{end_wait}"

msgctxt "message"
msgid "06349"
msgstr "Ehi... Guarda che fine ha{line_break}fatto il mio negozio!{line_break}È un disastro!{end_wait}"

msgctxt "message"
msgid "06350"
msgstr "Solo un uomo d'affari sa cosa{line_break}si prova quando si può{line_break}tornare al lavoro.{end_wait}"

msgctxt "message"
msgid "06351"
msgstr "Il mio negozio è sommerso...{line_break}Non posso vendere le mie{line_break}armature...{end_wait}"

msgctxt "message"
msgid "06352"
msgstr "Che bello: posso{line_break}vendere di nuovo{line_break}le mie armature.{end_wait}"

msgctxt "message"
msgid "06353"
msgstr "Mentre parliamo, le armature{line_break}si stanno arrugginendo.{end_wait}"

msgctxt "message"
msgid "06354"
msgstr "Abbiamo asciugato e{line_break}lucidato tutte le{line_break}armature!{page_break}Ora non c'è più traccia{line_break}di ruggine.{end_wait}"

msgctxt "message"
msgid "06355"
msgstr "Oh, no! Come farò se{line_break}tutta la mia merce{line_break}è piena d'acqua!{end_wait}"

msgctxt "message"
msgid "06356"
msgstr "La mia merce non è affatto{line_break}danneggiata... Ora farò{line_break}affari d'oro!{end_wait}"

msgctxt "message"
msgid "06357"
msgstr "Se la mia merce è bagnata{line_break}dovrò asciugarla prima{line_break}di poterla vendere.{end_wait}"

msgctxt "message"
msgid "06358"
msgstr "Qualcosa s'è inumidito...{page_break}Ma la qualità è sempre{line_break}buona... Niente{line_break}s'è rovinato.{page_break}...Forse metterò un{line_break}cartello per spiegarlo.{end_wait}"

msgctxt "message"
msgid "06359"
msgstr "È tutto apposto, a parte{line_break}un po' d'umidità. Ma{line_break}possiamo ritenerci fortunati?{end_now}"

msgctxt "message"
msgid "06360"
msgstr "D'altronde, l'inondazione{line_break}ha colpito tante{line_break}brave persone!{end_wait}"

msgctxt "message"
msgid "06361"
msgstr "Non dobbiamo dimenticare{line_break}che molti hanno perso tutto{line_break}ciò che possedevano.{page_break}Se ci pensi è{line_break}tristissimo.{end_wait}"

msgctxt "message"
msgid "06362"
msgstr "Darei qualsiasi cosa perché{line_break}Altin tornasse alla sua{line_break}antica gloria.{page_break}Sei giovane, ma sei un{line_break}vero guerriero. Aiutaci,{line_break}ti prego.{end_wait}"

msgctxt "message"
msgid "06363"
msgstr "Vengo da Xian...{line_break}E so cucinare...{line_break}Mangiate!{end_wait}"

msgctxt "message"
msgid "06364"
msgstr "Nessuno potrà andare a casa{line_break}se l'acqua non si{line_break}ritirerà.{end_wait}"

msgctxt "message"
msgid "06365"
msgstr "Gl ospiti della camera 1{line_break}sono tornati a casa appena{line_break}l'acqua s'è ritirata.{end_wait}"

msgctxt "message"
msgid "06366"
msgstr "Anche quelli della camera 2{line_break}sono andati a casa appena{line_break}l'acqua s'è ritirata.{end_wait}"

msgctxt "message"
msgid "06367"
msgstr "Noi ce la caveremo, ma{line_break}temo che il villaggio{line_break}sia spacciato.{end_wait}"

msgctxt "message"
msgid "06368"
msgstr "So che non sembrano{line_break}fortissimi, ma essendo{line_break}guerrieri, forse possono{page_break}aiutarci.{end_wait}"

msgctxt "message"
msgid "06369"
msgstr "Cucino soltanto da{line_break}quando sono ad Altin,{line_break}ma me la cavo bene.{end_wait}"

msgctxt "message"
msgid "06370"
msgstr "Gran parte del villaggio{line_break}è sott'acqua...{page_break}Passerà molto tempo prima{line_break}che Altin ritrovi{line_break}l'antico splendore.{end_wait}"

msgctxt "message"
msgid "06371"
msgstr "Pare che l'acqua inizi{line_break}a ritirarsi, ma passerà{page_break}molto tempo prima che{line_break}Altin ritrovi{line_break}l'antico splendore.{end_wait}"

msgctxt "message"
msgid "06372"
msgstr "Non abbandonerò mai Altin,{line_break}per nessun motivo.{end_wait}"

msgctxt "message"
msgid "06373"
msgstr "La nostra casa sarà{line_break}senz'altro rovinata.{page_break}Vorrei poter andare a{line_break}vivere altrove...{end_wait}"

msgctxt "message"
msgid "06374"
msgstr "Lasciare Altin per Tolbi?{line_break}Sarebbe pazzesco.{end_wait}"

msgctxt "message"
msgid "06375"
msgstr "Ora ho finalmente una scusa{line_break}per spostarmi nella mia{line_break}città preferita: Tolbi!{end_wait}"

msgctxt "message"
msgid "06376"
msgstr "Non sono molti quelli che{line_break}attraversano la Strada della{line_break}Seta fino a Tolbi.{end_wait}"

msgctxt "message"
msgid "06377"
msgstr "Era da tempo{line_break}che non facevo{line_break}una pausa...{end_wait}"

msgctxt "message"
msgid "06378"
msgstr "Ovviamente non si può andare{line_break}ad ovest dei monti se non si{line_break}attraversa la Strada della Seta.{end_wait}"

msgctxt "message"
msgid "06379"
msgstr "Odio stare qui a fare{line_break}niente. Voglio andare{line_break}a casa!{end_wait}"

msgctxt "message"
msgid "06380"
msgstr "Tutto è successo dopo quella{line_break}terribile notte in cui caddero{line_break}le gemme dal cielo.{page_break}Fu allora che nella{line_break}miniera apparvero le{line_break}bestie che sputavano acqua!{end_wait}"

msgctxt "message"
msgid "06381"
msgstr "Vi prego, salvate Altin: la{line_break}situazione è disastrosa...{end_wait}"

msgctxt "message"
msgid "06382"
msgstr "Ce l'abbiamo fatta, {actor_name:1}!{line_break}Abbiamo battuto{line_break}le bestie d'acqua!{end_wait}"

msgctxt "message"
msgid "06383"
msgstr "Chissà perché le statue{line_break}protrettrici di Altin si sono{line_break}trasformate in mostri...{page_break}Non è strano?{end_now}"

msgctxt "message"
msgid "06384"
msgstr "Che sarà di quella strana{line_break}stanza lastricata in{line_break}fondo alla miniera?{end_wait}"

msgctxt "message"
msgid "06385"
msgstr "Beh, magari non{line_break}è nulla{line_break}di speciale.{page_break}Però è strano che il{line_break}fondo della miniera sia{line_break}fatto di pietre scolpite.{end_wait}"

msgctxt "message"
msgid "06386"
msgstr "Le statue protrettrici{line_break}furono scolpite{line_break}moltissimi anni fa.{end_wait}"

msgctxt "message"
msgid "06387"
msgstr "A cosa servono?{end_wait}"

msgctxt "message"
msgid "06388"
msgstr "C'è una cassa del{line_break}tesoro dietro alla{line_break}statua protettrice!{end_wait}"

msgctxt "message"
msgid "06389"
msgstr "Credo che tutto sia collegato{line_break}a quelle rovine, in fondo{line_break}alla miniera...{end_wait}"

msgctxt "message"
msgid "06390"
msgstr "Credo, di sì... {actor_name:1},{line_break}dobbiamo controllare quella{line_break}cassa prima di andarcene!{end_wait}"

msgctxt "message"
msgid "06391"
msgstr "Nelle mani degli Adepti,{line_break}la Gemma di levitazione{line_break}ha un enorme potere.{end_wait}"

msgctxt "message"
msgid "06392"
msgstr "{actor_name:1} ottiene{line_break}la Gemma di levitazione.{end_wait}"

msgctxt "message"
msgid "06393"
msgstr "Grazie per aver sconfitto{line_break}le statue d'acqua{line_break}nella miniera.{end_wait}"

msgctxt "message"
msgid "06394"
msgstr "Hai visto l'acqua spargersi{line_break}dappertutto quando hai{line_break}colpito quelle creature?{end_now}"

msgctxt "message"
msgid "06395"
msgstr "Capisco... Allora quei{line_break}mostri sono come enormi{line_break}serbatoi d'acqua...{end_wait}"

msgctxt "message"
msgid "06396"
msgstr "Davvero? Allora com'è{line_break}possibile che trasportassero{line_break}tutta quell'acqua?{end_wait}"

msgctxt "message"
msgid "06397"
msgstr "Quando riaprirà la miniera{line_break}potremo rimetterci{line_break}in sesto.{end_wait}"

msgctxt "message"
msgid "06398"
msgstr "Nella parte superiore della{line_break}montagna, la miniera è{line_break}di nuovo attiva.{page_break}Ma la gente ha ancora{line_break}paura ad inoltrarsi{line_break}in profondità.{end_wait}"

msgctxt "message"
msgid "06399"
msgstr "L'acqua è uscita dalla{line_break}miniera attraverso tutte le{line_break}crepe, come m'aspettavo.{page_break}Ma quella rimasta{line_break}non se ne andrà{line_break}per un bel po'.{end_wait}"

msgctxt "message"
msgid "06400"
msgstr "Grazie al cielo, ora{line_break}non c'è più acqua{line_break}nel villaggio.{end_wait}"

msgctxt "message"
msgid "06401"
msgstr "Siete voi che avete{line_break}battuto le{line_break}bestie d'acqua?{end_now}"

msgctxt "message"
msgid "06402"
msgstr "Ci fareste un grande favore{line_break}aiutandoci anche a{line_break}ricostruire il villaggio.{end_wait}"

msgctxt "message"
msgid "06403"
msgstr "Ho sentito che i nostri{line_break}salvatori erano giovani.{line_break}Mi piacerebbe incontrarli.{end_wait}"

msgctxt "message"
msgid "06404"
msgstr "Da quando i mostri se ne{line_break}sono andati il villaggio è{line_break}tornato alla normalità.{page_break}Ma è ancora tutto{line_break}sottosopra.{end_wait}"

msgctxt "message"
msgid "06405"
msgstr "Allora quelle creature{line_break}d'acqua erano davvero le{line_break}statue protettrici?{page_break}Che sorpresa!{end_wait}"

msgctxt "message"
msgid "06406"
msgstr "È vero che avete trovato{line_break}antiche rovine nell'area{line_break}più profonda della miniera?{end_now}"

msgctxt "message"
msgid "06407"
msgstr "Davvero? Ho sempre pensato{line_break}che la miniera custodisse{line_break}un segreto.{end_wait}"

msgctxt "message"
msgid "06408"
msgstr "Mah, davvero siete{line_break}andati laggiù?{page_break}Qualcuno dovrebbe{line_break}accertarsene.{end_wait}"

msgctxt "message"
msgid "06409"
msgstr "Dobbiamo tornare{line_break}al lavoro{line_break}in miniera.{end_wait}"

msgctxt "message"
msgid "06410"
msgstr "Temevo che sarebbe uscita{line_break}altra acqua dopo aver{line_break}ucciso i mostri.{end_wait}"

msgctxt "message"
msgid "06411"
msgstr "Spero che la miniera di{line_break}Altin torni prospera{line_break}come un tempo.{end_wait}"

msgctxt "message"
msgid "06412"
msgstr "L'acqua è penetrata{line_break}nella roccia della miniera.{page_break}Credo che sia un tipo{line_break}di pietra molto poroso.{end_wait}"

msgctxt "message"
msgid "06413"
msgstr "È umido nella grotta.{line_break}Le pareti sono così{line_break}vischiose!{end_wait}"

msgctxt "message"
msgid "06414"
msgstr "Quella strana stanza nella{line_break}miniera mi mette i brividi.{end_wait}"

msgctxt "message"
msgid "06415"
msgstr "Abbiamo lottato bene,{line_break}nonostante tutta l'acqua che{line_break}quelle bestie ci sputavano.{end_wait}"

msgctxt "message"
msgid "06416"
msgstr "La miniera è piena di buchi{line_break}e gole. Per questo l'acqua è{line_break}andata via facilmente.{end_wait}"

msgctxt "message"
msgid "06417"
msgstr "Quelle statue protettrici{line_break}m'hanno sempre fatto paura.{line_break}È meglio che non ci siano più.{end_wait}"

msgctxt "message"
msgid "06418"
msgstr "Trovavo spesso manufatti di{line_break}ogni tipo. Chissà se facevano{line_break}parte delle rovine.{end_wait}"

msgctxt "message"
msgid "06419"
msgstr "Ho sentito che la Strada{line_break}di Seta è chiusa...{page_break}O almeno, così ha detto{line_break}la ragazza di Xian.{end_wait}"

msgctxt "message"
msgid "06420"
msgstr "Una ragazza di Xian mi ha{line_break}chiesto di alcuni{line_break}giovani guerrieri.{page_break}È possibile che si{line_break}riferisse a voi?{end_now}"

msgctxt "message"
msgid "06421"
msgstr "Stava cercando{line_break}dappertutto.{end_wait}"

msgctxt "message"
msgid "06422"
msgstr "Beh, comunque mi auguro{line_break}che trovi chi sta{line_break}cercando.{end_wait}"

msgctxt "message"
msgid "06423"
msgstr "Se la Strada di Seta è{line_break}bloccata, è un bel problema{line_break}per i mercanti.{page_break}Ci sarà qualcuno in grado di{line_break}liberare la strada dai detriti?{end_wait}"

msgctxt "message"
msgid "06424"
msgstr "Mi chiedo cosa abbia a che{line_break}fare quella ragazza di{line_break}Xian con dei guerrieri...{end_wait}"

msgctxt "message"
msgid "06425"
msgstr "Le antiche rovine sono{line_break}sempre collegate{line_break}ai tesori...{page_break}Cosa intendete{line_break}fare?{end_wait}"

msgctxt "message"
msgid "06426"
msgstr "Se avessero lasciato almeno{line_break}un paio di mostri d'acqua...{end_wait}"

msgctxt "message"
msgid "06427"
msgstr "Pare che in fondo alla{line_break}miniera si possano trovare{line_break}ancora dei mostri.{page_break}Se non fosse per quelle{line_break}bestie, andrei a caccia{line_break}di tesori.{end_wait}"

msgctxt "message"
msgid "06428"
msgstr "Come si può essere felici{line_break}ora che quei simpatici mostri{line_break}non ci sono più?{end_wait}"

msgctxt "message"
msgid "06429"
msgstr "Davvero? Antiche rovine{line_break}in fondo alla miniera?{line_break}Ma non dirmi...{end_wait}"

msgctxt "message"
msgid "06430"
msgstr "Non credo che nelle rovine{line_break}in fondo alla miniera si{line_break}trovi un grande tesoro.{page_break}Perché non dimenticate{line_break}il tesoro e non riprendete{line_break}il viaggio?{end_wait}"

msgctxt "message"
msgid "06431"
msgstr "C'è qualcosa di strano{line_break}in mamma e papà...{line_break}Si comportano stranamente{page_break}da quando sono state trovate{line_break}quelle rovine nella miniera.{end_wait}"

msgctxt "message"
msgid "06432"
msgstr "Antiche rovine in fondo{line_break}alla miniera...{page_break}Dobbiamo andare subito{line_break}a cercare il tesoro.{end_wait}"

msgctxt "message"
msgid "06433"
msgstr "Non avevo idea che la miniera{line_break}custodisse delle rovine.{end_wait}"

msgctxt "message"
msgid "06434"
msgstr "Chissà se mamma e papà{line_break}sapevano di quel monumento{line_break}in fondo alla miniera.{end_wait}"

msgctxt "message"
msgid "06435"
msgstr "Se la Strada della Seta è{line_break}bloccata, dovrete trovare il{line_break}passaggio verso ovest{page_break}nella miniera.{end_wait}"

msgctxt "message"
msgid "06436"
msgstr "Ho sentito parlare di un{line_break}passaggio nella miniera che{line_break}conduce verso ovest, ma non{page_break}so chi l'abbia trovato.{end_wait}"

msgctxt "message"
msgid "06437"
msgstr "Allora? Ti piace il{line_break}nostro assortimento{line_break}di armature?{end_wait}"

msgctxt "message"
msgid "06438"
msgstr "Beh, se la merce ti{line_break}piace, perché non fai{line_break}un acquisto?{end_wait}"

msgctxt "message"
msgid "06439"
msgstr "La ragazza di Xian ha comprato{line_break}parecchio. Forse voleva{line_break}intraprendere un viaggio.{end_wait}"

msgctxt "message"
msgid "06440"
msgstr "La ragazza di Xian ha{line_break}comprato tutta la merce{line_break}riemersa dall'acqua.{end_wait}"

msgctxt "message"
msgid "06441"
msgstr "Ad ovest della miniera di{line_break}Altin vi è un piccolo tempio.{page_break}Chissà se sono stati{line_break}raggiunti dall'acqua{line_break}uscita dalla miniera...{end_wait}"

msgctxt "message"
msgid "06442"
msgstr "Ad ovest delle{line_break}montagne vi è un{line_break}deserto infinito.{page_break}Chi decide di andare{line_break}ad ovest dovrà{line_break}attrezzarsi bene.{end_wait}"

msgctxt "message"
msgid "06443"
msgstr "Ad ovest delle montagne{line_break}fa caldissimo!{line_break}Non ce la faccio più!{page_break}Mangiare cibo piccante{line_break}fa bene... Aiuta a resistere{line_break}al caldo.{end_wait}"

msgctxt "message"
msgid "06444"
msgstr "Nella miniera ci sono ancora{line_break}delle bestie, ma molto in{line_break}profondità, vero?{end_now}"

msgctxt "message"
msgid "06445"
msgstr "Bene. Allora potremo{line_break}lavorare nelle parti{line_break}meno profonde.{end_wait}"

msgctxt "message"
msgid "06446"
msgstr "Se sono anche nelle parti{line_break}meno profonde, non possiamo{line_break}lavorare in miniera.{end_wait}"

msgctxt "message"
msgid "06447"
msgstr "Credo che quel tempio sia{line_break}chiamato Tempio di Lama.{page_break}Si dice che là vivano{line_break}persone con{line_break}strani poteri.{end_wait}"

msgctxt "message"
msgid "06448"
msgstr "Finché la Strada della Seta{line_break}è bloccata non potrete{line_break}attraversare il deserto.{end_wait}"

msgctxt "message"
msgid "06449"
msgstr "Al momento nessuno può andare{line_break}ad ovest delle montagne.{end_wait}"

msgctxt "message"
msgid "06450"
msgstr "Ci vorrà parecchio tempo{line_break}prima che Altin{line_break}possa riprendersi.{end_wait}"

msgctxt "message"
msgid "06451"
msgstr "Abbiamo salvato Altin{line_break}dai mostri.{page_break}Di sicuro non è stata opera{line_break}del Fato.{end_wait}"

msgctxt "message"
msgid "06452"
msgstr "Temo che il Fato{line_break}m'abbia sentito...{end_wait}"

msgctxt "message"
msgid "06453"
msgstr "Attenzione alle rocce!{page_break}Non urtate le pareti, o{line_break}possono cadere delle rocce!{end_wait}"

msgctxt "message"
msgid "06454"
msgstr "Ehi!{pause_20_skippable} Abbiamo fatto tutta{line_break}questa strada per finire{line_break}in un vicolo cieco!{end_wait}"

msgctxt "message"
msgid "06455"
msgstr "Ho una brutta sensazione...{line_break}Corri,{line_break}{actor_name:1}! Ora!{end_wait}"

msgctxt "message"
msgid "06456"
msgstr "Colui che può vedere{line_break}l'invisibile vedrà{line_break}la verità...{page_break}Questo è scritto{line_break}sulla parete.{end_wait}"

msgctxt "message"
msgid "06457"
msgstr "Questo è il Tempio di Lama.{line_break}Benvenuti, viaggiatori.{page_break}Il Deserto di Lamakan, qui{line_break}avanti, è torrido.{line_break}Riposatevi un po'.{end_wait}"

msgctxt "message"
msgid "06458"
msgstr "giovani viaggiatori,{line_break}venite da est?{end_now}"

msgctxt "message"
msgid "06459"
msgstr "Dunque avete attraversato{line_break}il Deserto di Lamakan...{end_wait}"

msgctxt "message"
msgid "06460"
msgstr "Vi siete fermati a Xian{line_break}lungo la strada?{end_now}"

msgctxt "message"
msgid "06461"
msgstr "Il maestro Feh, di Xian, è{line_break}molto vicino al nostro{line_break}maestro Hama.{page_break}Spesso gli studenti del maestro{line_break}Feh proseguono qui i{line_break}loro allenamenti...{end_wait}"

msgctxt "message"
msgid "06462"
msgstr "Allora siete nel{line_break}posto giusto.{page_break}Il kung fu insegnato da Feh{line_break}è perfetto per i guerrieri{line_break}che vogliono migliorarsi.{end_wait}"

msgctxt "message"
msgid "06463"
msgstr "Sai cos'è{line_break}la meditazione?{end_now}"

msgctxt "message"
msgid "06464"
msgstr "Ti permette di trovare{line_break}la pace chiudendo{line_break}gli occhi...{page_break}...e separando{line_break}la mente dal{line_break}mondo circostante.{end_wait}"

msgctxt "message"
msgid "06465"
msgstr "È un allenamento che ti{line_break}fa liberare la mente da{line_break}ogni pensiero...{page_break}...provando a rimanere{line_break}calmo e immobile{line_break}come una pietra.{end_wait}"

msgctxt "message"
msgid "06466"
msgstr "Mi hai parlato...{line_break}Sento in te molta insicurezza{line_break}e preoccupazione.{end_wait}"

msgctxt "message"
msgid "06467"
msgstr "Sapevi che Hama è{line_break}la più grande{line_break}maestra del Chi?{end_now}"

msgctxt "message"
msgid "06468"
msgstr "Davvero? Allora devi aver{line_break}conosciuto il maestro{line_break}Feh di Xian, vero?{page_break}Ma il potere di Hama{line_break}non si limita a questo.{end_wait}"

msgctxt "message"
msgid "06469"
msgstr "Bene, oggi capirai che Hama{line_break}è davvero la più forte{line_break}con il Chi.{end_wait}"

msgctxt "message"
msgid "06470"
msgstr "Sono troppo preoccupati.{line_break}In quelle condizioni non si{line_break}può attraversare il deserto.{end_wait}"

msgctxt "message"
msgid "06471"
msgstr "Dicono che chi conosce il{line_break}kung fu possa superare{line_break}qualsiasi prova.{end_wait}"

msgctxt "message"
msgid "06472"
msgstr ".{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}{line_break}.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}{line_break}Ho{pause_20_skippable}{pause_20_skippable}{pause_20_skippable} fame...{end_wait}"

msgctxt "message"
msgid "06473"
msgstr "Sento pensieri non puri{line_break}nell'uomo vicino a me.{line_break}Non è abbastanza allenato.{end_wait}"

msgctxt "message"
msgid "06474"
msgstr "Il Chi è solo una piccola{line_break}parte del potere di Hama.{line_break}È una vera maestra.{end_wait}"

msgctxt "message"
msgid "06475"
msgstr "La maestra Hama sta{line_break}meditando. Vi prego di fare{line_break}assoluto silenzio.{end_wait}"

msgctxt "message"
msgid "06476"
msgstr "Bene, {actor_name:1}. Tu e i{line_break}tuoi compagni Adepti siete{line_break}finalmente arrivati.{end_wait}"

msgctxt "message"
msgid "06477"
msgstr "Finalmente arrivati?{line_break}Ci stava aspettando?{end_now}"

msgctxt "message"
msgid "06478"
msgstr "Ma come faceva a sapere{line_break}che saremmo arrivati?{end_wait}"

msgctxt "message"
msgid "06479"
msgstr "Beh, allora come sapeva{line_break}del nostro arrivo, {actor_name:1}?{end_wait}"

msgctxt "message"
msgid "06480"
msgstr "Avevo{pause_20_skippable} previsto{pause_20_skippable}{line_break}il vostro arrivo.{end_wait}"

msgctxt "message"
msgid "06481"
msgstr "Sapevi che saremmo{line_break}arrivati, quindi?{end_wait}"

msgctxt "message"
msgid "06482"
msgstr "È da molto che{line_break}vi sto aspettando.{page_break}Siete alla ricerca{line_break}degli Astri elementali.{end_wait}"

msgctxt "message"
msgid "06483"
msgstr "Anche tu conosci la storia{line_break}degli Astri elementali?{line_break}Ma...{pause_20_skippable} chi sei?{end_wait}"

msgctxt "message"
msgid "06484"
msgstr "Sono un Adepto di Giove,{line_break}proprio come {actor_name:3}.{end_wait}"

msgctxt "message"
msgid "06485"
msgstr "Io non sono un Adepto{line_break}di Giove? Cosa stai{line_break}dicendo?{end_wait}"

msgctxt "message"
msgid "06486"
msgstr "Lo sei, {actor_name:3}, anche se{line_break}ancora non lo sai.{end_wait}"

msgctxt "message"
msgid "06487"
msgstr "Come fai a dirlo?{end_wait}"

msgctxt "message"
msgid "06488"
msgstr "Tu non hai forse il potere{line_break}di leggere nella mente?{end_wait}"

msgctxt "message"
msgid "06489"
msgstr "Solo gli Adepti di Giove{line_break}hanno questa abilità.{end_wait}"

msgctxt "message"
msgid "06490"
msgstr "Hai predetto il nostro{line_break}arrivo... Usi anche{line_break}tu la{pause_20_skippable} Psinergia?{end_wait}"

msgctxt "message"
msgid "06491"
msgstr "Oh oh!{pause_20_skippable} Bella domanda,{line_break}signorina {actor_name:4}.{end_wait}"

msgctxt "message"
msgid "06492"
msgstr "Sì, l'abilità di conoscere{line_break}gli eventi appartiene agli{line_break}Adepti di Giove.{end_wait}"

msgctxt "message"
msgid "06493"
msgstr "Quindi, anche {actor_name:3} può{line_break}imparare a predire gli eventi?{end_wait}"

msgctxt "message"
msgid "06494"
msgstr "Lo sa già fare.{end_wait}"

msgctxt "message"
msgid "06495"
msgstr "Non credo proprio...{end_wait}"

msgctxt "message"
msgid "06496"
msgstr "È così.{pause_20_skippable} È solo che{line_break}ancora non sai di avere{line_break}quell'abilità.{end_wait}"

msgctxt "message"
msgid "06497"
msgstr "Il potere di Giove dev'essere{line_break}enorme se può aiutarti{line_break}a predire il futuro.{end_wait}"

msgctxt "message"
msgid "06498"
msgstr "Oh, ma {actor_name:3} può{line_break}apprendere un potere{line_break}ancora maggiore!{end_wait}"

msgctxt "message"
msgid "06499"
msgstr "Quale potere ancora maggiore?{end_wait}"

msgctxt "message"
msgid "06500"
msgstr "Rivelazione.{end_wait}"

msgctxt "message"
msgid "06501"
msgstr "Rivelazione?{end_wait}"

msgctxt "message"
msgid "06502"
msgstr "Sì, ho atteso a lungo di{line_break}poterti trasmettere il potere{line_break}della vera visione.{end_wait}"

msgctxt "message"
msgid "06503"
msgstr "Hai atteso qui, nel Tempio{line_break}di Lama, soltanto per insegnare{line_break}Rivelazione a {actor_name:3}?{end_wait}"

msgctxt "message"
msgid "06504"
msgstr "Rivelazione vi servirà{line_break}per raggiungere i{line_break}vostri obiettivi...{end_wait}"

msgctxt "message"
msgid "06505"
msgstr "Col tempo. gli Adepti{line_break}di Giove possono apprendere{line_break}da soli Rivelazione...{end_wait}"

msgctxt "message"
msgid "06506"
msgstr "Ma questo potere, da solo,{line_break}non basterà a trovare Saturos,{line_break}perché continua a procedere.{end_wait}"

msgctxt "message"
msgid "06507"
msgstr "Sono stati Saturos e i{line_break}suoi compagni a bloccare{line_break}la Strada della Seta.{end_wait}"

msgctxt "message"
msgid "06508"
msgstr "{actor_name:5} e gli altri,{line_break}vero?{pause_20_skippable}{line_break}Che codardi!{end_wait}"

msgctxt "message"
msgid "06509"
msgstr "{actor_name:5} è condannato{line_break}ad un destino terribile, che{line_break}non augurerei a nessuno.{end_wait}"

msgctxt "message"
msgid "06510"
msgstr "Un destino terribile?{line_break}Cosa intendi dire?{end_wait}"

msgctxt "message"
msgid "06511"
msgstr "Mi dispiace, non{line_break}posso dire di più{line_break}su questo.{end_wait}"

msgctxt "message"
msgid "06512"
msgstr "Ora dobbiamo concentrarci{line_break}sul potere di Rivelazione.{end_wait}"

msgctxt "message"
msgid "06513"
msgstr "Vi servirà Rivelazione per{line_break}attraversare il deserto{line_break}stregato di Lamakan.{end_wait}"

msgctxt "message"
msgid "06514"
msgstr "Un deserto stregato?{line_break}Ma è possibile?{end_now}"

msgctxt "message"
msgid "06515"
msgstr "Tu ci credi, {actor_name:1}?{line_break}Beh, io non me la bevo.{end_wait}"

msgctxt "message"
msgid "06516"
msgstr "È difficile crederci,{line_break}vero, {actor_name:1}?{line_break}La penso anch'io così.{end_wait}"

msgctxt "message"
msgid "06517"
msgstr "Perché ci serve Rivelazione{line_break}per attraversare il deserto?{end_wait}"

msgctxt "message"
msgid "06518"
msgstr "Con tutto quel caldo, non è{line_break}mai stato facile attaversare{line_break}il deserto di Lamakan.{end_wait}"

msgctxt "message"
msgid "06519"
msgstr "Ma ora che il male se n'è{line_break}impadronito, quel deserto è{line_break}diventato proibitivo.{end_wait}"

msgctxt "message"
msgid "06520"
msgstr "Entrare in quel deserto{line_break}è quasi come firmare la{line_break}propria condanna a morte.{end_wait}"

msgctxt "message"
msgid "06521"
msgstr "Ma, allora come ha fatto{line_break}Saturos ad attraversare{line_break}un posto simile?{end_wait}"

msgctxt "message"
msgid "06522"
msgstr "Saturos e Adexia sono{line_break}Adepti di Marte.{end_wait}"

msgctxt "message"
msgid "06523"
msgstr "È solo una supposizione...{page_break}Ma credo che riescano a far{line_break}abbassare la temperatura{line_break}mentre attraversano il deserto.{end_wait}"

msgctxt "message"
msgid "06524"
msgstr "Continuo a non capire...{line_break}Come potrà esserci utile{line_break}Rivelazione in un posto così?{end_wait}"

msgctxt "message"
msgid "06525"
msgstr "Con Rivelazione potrete{line_break}trovare le oasi, per{line_break}difendervi dal calore.{end_wait}"

msgctxt "message"
msgid "06526"
msgstr "E perché dovremmo usare{line_break}Rivelazione? Potremmo trovare{line_break}le oasi anche senza, no?{end_wait}"

msgctxt "message"
msgid "06527"
msgstr "Sai cos'è un{line_break}miraggio?{end_now}"

msgctxt "message"
msgid "06528"
msgstr "Il deserto è pieno di{line_break}miraggi, che impediscono{line_break}di vedere le cose chiaramente.{page_break}Senza Rivelazione non potrete{line_break}mai trovare le oasi.{end_wait}"

msgctxt "message"
msgid "06529"
msgstr "Il calore intenso crea{line_break}una coltre d'aria che{line_break}distorce gli oggetti.{page_break}I miraggi ingannerebbero{line_break}la vostra vista, impedendovi{line_break}di vedere le oasi.{end_wait}"

msgctxt "message"
msgid "06530"
msgstr "Allora è meglio che {actor_name:3}{line_break}apprenda Rivelazione,{line_break}non credi?{end_now}"

msgctxt "message"
msgid "06531"
msgstr "Sì... Non voglio{line_break}morire in un deserto{line_break}stregato...{end_wait}"

msgctxt "message"
msgid "06532"
msgstr "Andiamo, {actor_name:1}!{line_break}Se vogliamo raggiungere{line_break}{actor_name:5}, ci serve Rivelazione!{end_wait}"

msgctxt "message"
msgid "06533"
msgstr "{actor_name:3}, dovresti farti{line_break}insegnare dalla maestra{line_break}Hama l'uso di Rivelazione.{end_wait}"

msgctxt "message"
msgid "06534"
msgstr "Che succede,{line_break}Maestra Hama?{page_break}Puoi{pause_20_skippable} trasmettermi{line_break}Rivelazione,{pause_20_skippable} vero?{end_wait}"

msgctxt "message"
msgid "06535"
msgstr "Non so{pause_20_skippable} se potrà{line_break}funzionare.{end_wait}"

msgctxt "message"
msgid "06536"
msgstr "Per prepararmi ho{line_break}provato a trasmettere un{line_break}mio potere ad{page_break}un'allieva, ma{line_break}non si trattava{line_break}di Rivelazione.{end_wait}"

msgctxt "message"
msgid "06537"
msgstr "Non si trattava{line_break}di un'Adepta...{end_wait}"

msgctxt "message"
msgid "06538"
msgstr "Ma credevo che chiunque{line_break}potesse migliorare un'abilità{line_break}che già possiede...{end_wait}"

msgctxt "message"
msgid "06539"
msgstr "Tuttavia non ho visto in{line_break}lei alcun cambiamento.{end_wait}"

msgctxt "message"
msgid "06540"
msgstr "Un cambiamento c'è stato!{end_wait}"

msgctxt "message"
msgid "06541"
msgstr "Feizhi... Che ci{line_break}fai qui?{end_wait}"

msgctxt "message"
msgid "06542"
msgstr "L'ho sentito!{end_wait}"

msgctxt "message"
msgid "06543"
msgstr "Sentito? Cos'hai{line_break}sentito?{end_wait}"

msgctxt "message"
msgid "06544"
msgstr "Che Hsu è in pericolo!{end_wait}"

msgctxt "message"
msgid "06545"
msgstr "Hsu è andato via di qui{line_break}molto tempo fa.{end_wait}"

msgctxt "message"
msgid "06546"
msgstr "Lo so...{line_break}Ma Hsu non è{line_break}tornato a Xian.{end_wait}"

msgctxt "message"
msgid "06547"
msgstr "...I massi delle{line_break}montagne!{end_wait}"

msgctxt "message"
msgid "06548"
msgstr "L'ho sentito. Sono{line_break}passata dalla miniera,{line_break}per chiedere aiuto.{end_wait}"

msgctxt "message"
msgid "06549"
msgstr "Io non ho presagito nulla,{line_break}perché mi concentravo sull'{line_break}arrivo di {actor_name:1}...{end_wait}"

msgctxt "message"
msgid "06550"
msgstr "Ma{pause_20_skippable} perché il potere{line_break}ti ha raggiunto solo ora,{line_break}dopo tutto questo tempo?{end_wait}"

msgctxt "message"
msgid "06551"
msgstr "Le gemme cadute dal cielo...{line_break}Una mi colpì proprio{line_break}in testa.{end_wait}"

msgctxt "message"
msgid "06552"
msgstr "Le gemme...{end_wait}"

msgctxt "message"
msgid "06553"
msgstr "Le pietre psinergiche...{end_wait}"

msgctxt "message"
msgid "06554"
msgstr "Allora, dopo tutto,{line_break}può funzionare.{end_wait}"

msgctxt "message"
msgid "06555"
msgstr "E Hsu?{end_wait}"

msgctxt "message"
msgid "06556"
msgstr "Sbrighiamoci! Dobbiamo{line_break}aiutare Hsu!{end_wait}"

msgctxt "message"
msgid "06557"
msgstr "Maestra Hama, e noi?{line_break}E Rivelazione?{end_wait}"

msgctxt "message"
msgid "06558"
msgstr "Ah, dimenticavo...{end_wait}"

msgctxt "message"
msgid "06559"
msgstr "Credo di aver trasferito{line_break}il mio potere a Feizhi.{line_break}Funzionerà senz'altro.{end_wait}"

msgctxt "message"
msgid "06560"
msgstr "Dovrebbe funzionare:{line_break}usate Rivelazione per{line_break}superare il deserto.{end_wait}"

msgctxt "message"
msgid "06561"
msgstr "Ma la mia Rivelazione non è{line_break}ancora abbastanza forte...{line_break}Le oasi non appaiono.{end_wait}"

msgctxt "message"
msgid "06562"
msgstr "Il resto dipende da{line_break}{actor_name:3}...{end_wait}"

msgctxt "message"
msgid "06563"
msgstr "{actor_name:3}, mi fa piacere{line_break}vedere che sei diventato{line_break}un uomo così forte.{end_wait}"

msgctxt "message"
msgid "06564"
msgstr "{actor_name:3}, tu e la{line_break}maestra Hama...{line_break}...vi conoscete?{end_wait}"

msgctxt "message"
msgid "06565"
msgstr "No... Ma ha un aspetto{line_break}{pause_20_skippable} familiare...{end_wait}"

msgctxt "message"
msgid "06566"
msgstr "{actor_name:5} e gli altri{line_break}saranno molto più{line_break}avanti di noi...{end_now}"

msgctxt "message"
msgid "06567"
msgstr "Allora è meglio sbrigarsi:{line_break}dai, andiamo!{end_wait}"

msgctxt "message"
msgid "06568"
msgstr "Il deserto potrebbe averli{line_break}fatti rallentare, ma non{line_break}c'è un minuto da perdere!{end_wait}"

msgctxt "message"
msgid "06569"
msgstr "Non possiamo{line_break}andarcene così!{end_wait}"

msgctxt "message"
msgid "06570"
msgstr "Hama avrà bisogno{line_break}del nostro aiuto...{end_wait}"

msgctxt "message"
msgid "06571"
msgstr "Ha solo Feizhi a{line_break}darle sostegno.{line_break}L'aiutiamo anche noi?{end_now}"

msgctxt "message"
msgid "06572"
msgstr "Ho più preoccupazione per{line_break}{actor_name:5} e gli altri...{page_break}Ma non possiamo lasciare{line_break}Hsu così...{end_wait}"

msgctxt "message"
msgid "06573"
msgstr "Feizhi e la maestra Hama{line_break}mi stanno a cuore...{page_break}Ma capisco che tu{line_break}voglia raggiungere{line_break}{actor_name:5}.{end_wait}"

msgctxt "message"
msgid "06574"
msgstr "Noi siamo con te, {actor_name:1}:{line_break}sarai tu a decidere!{end_wait}"

msgctxt "message"
msgid "06575"
msgstr "Mi chiedo di cosa stesse{line_break}parlando la maestra Hama...{end_wait}"

msgctxt "message"
msgid "06576"
msgstr "Oh, mi dispiace...{line_break}Andiamo.{end_wait}"

msgctxt "message"
msgid "06577"
msgstr "Hsu, è tutto apposto?{end_wait}"

msgctxt "message"
msgid "06578"
msgstr "Sì, maestra Hama.{line_break}Ma non posso muovermi...{line_break}Il masso...{end_wait}"

msgctxt "message"
msgid "06579"
msgstr "Che bello, Feizhi!{line_break}Hsu sta bene.{end_wait}"

msgctxt "message"
msgid "06580"
msgstr "Sì, ti ringrazio. Ma come{line_break}facciamo a liberarlo?{end_wait}"

msgctxt "message"
msgid "06581"
msgstr "Io{pause_20_skippable} non ne{line_break}ho idea...{end_wait}"

msgctxt "message"
msgid "06582"
msgstr "Bene, {actor_name:1}! Adepti!{line_break}Siete venuti a dare una mano!{page_break}Hsu è in pericolo,{line_break}come vedete.{line_break}Cosa possiamo fare?{end_wait}"

msgctxt "message"
msgid "06583"
msgstr "Devi essere forte, Hsu!{line_break}Ti aiuteremo noi!{end_wait}"

msgctxt "message"
msgid "06584"
msgstr "Sono intrappolato tra{line_break}queste rocce.{page_break}Almeno non sono{line_break}stato schiacciato.{end_wait}"

msgctxt "message"
msgid "06585"
msgstr "Come facciamo a{line_break}spostare i massi?{end_wait}"

msgctxt "message"
msgid "06586"
msgstr "Hsu sembra{line_break}esausto.{line_break}Non è un bel segno!{end_wait}"

msgctxt "message"
msgid "06587"
msgstr "Vorrei urlare.{line_break}Ma Feizhi{line_break}non vuole...{end_wait}"

msgctxt "message"
msgid "06588"
msgstr "{actor_name:1}, hai{line_break}alzato il masso?{end_wait}"

msgctxt "message"
msgid "06589"
msgstr "Guarda, il masso!{line_break}S'è sollevato!{end_wait}"

msgctxt "message"
msgid "06590"
msgstr "Presto, Feizhi. Dobbiamo{line_break}liberare Hsu!{end_wait}"

msgctxt "message"
msgid "06591"
msgstr "Stai pronto, Hsu.{line_break}Sto per tirare.{line_break}Uno, due, tre!{end_wait}"

msgctxt "message"
msgid "06592"
msgstr "È a metà...{line_break}Ancora uno sforzo...{end_wait}"

msgctxt "message"
msgid "06593"
msgstr "Ce la fai a resistere{line_break}ancora un attimo, {actor_name:1}?{end_now}"

msgctxt "message"
msgid "06594"
msgstr "Grazie, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "06595"
msgstr "Non puoi mollare proprio ora!{line_break}Pensa a cosa accadrebbe!{end_wait}"

msgctxt "message"
msgid "06596"
msgstr "Sei pronto? Ora tiro!{line_break}Uno, due, tre!{end_wait}"

msgctxt "message"
msgid "06597"
msgstr "Ce l'abbiamo fatta! Maestra{line_break}Hama, Hsu è libero!{end_wait}"

msgctxt "message"
msgid "06598"
msgstr "Ce l'abbiamo fatta, Feizhi!{end_wait}"

msgctxt "message"
msgid "06599"
msgstr "Grazie, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "06600"
msgstr "Dobbiamo chiedere al{line_break}maestro Feh di curare le{line_break}ferite di Hsu.{end_wait}"

msgctxt "message"
msgid "06601"
msgstr "Gli chiederò anche di{line_break}levare di mezzo i massi.{end_wait}"

msgctxt "message"
msgid "06602"
msgstr "Ottima idea. Se la Strada{line_break}della Seta resta bloccata{line_break}ne soffriranno tutti.{end_wait}"

msgctxt "message"
msgid "06603"
msgstr "Adepti, grazie{line_break}ancora... Vi sarò{line_break}per sempre riconoscente.{end_wait}"

msgctxt "message"
msgid "06604"
msgstr "Non credevo che sareste{line_break}venuti ad aiutarci.{end_wait}"

msgctxt "message"
msgid "06605"
msgstr "No, Hama...{line_break}Siamo noi a doverti{line_break}ringraziare.{end_wait}"

msgctxt "message"
msgid "06606"
msgstr "Grazie per avermi insegnato{line_break}il potere di{line_break}Rivelazione...{page_break}Ma{pause_20_skippable} ciò che hai detto...{end_wait}"

msgctxt "message"
msgid "06607"
msgstr "Che cos'è, {actor_name:3}?{end_wait}"

msgctxt "message"
msgid "06608"
msgstr "In realtà sono io che{line_break}ho proposto di{line_break}aiutarti,{pause_20_skippable} giusto?{end_now}"

msgctxt "message"
msgid "06609"
msgstr "Come? Ma non eri tu quello{line_break}che voleva andare subito nel{line_break}deserto, {actor_name:2}!{end_wait}"

msgctxt "message"
msgid "06610"
msgstr "Io, {actor_name:4}? Io volevo{line_break}partire? Guarda che ti{pause_20_skippable}{line_break}stai confondendo!{end_wait}"

msgctxt "message"
msgid "06611"
msgstr "No, {actor_name:2}, davvero...{line_break}Tu volevi{line_break}partire!{end_wait}"

msgctxt "message"
msgid "06612"
msgstr "{actor_name:1}, {actor_name:4}...{line_break}Non fatemi fare la{line_break}figura dello stupido...{end_wait}"

msgctxt "message"
msgid "06613"
msgstr "No, {actor_name:2}.{line_break}Non ti preoccupare.{end_wait}"

msgctxt "message"
msgid "06614"
msgstr "Buon viaggio, amici.{end_wait}"

msgctxt "message"
msgid "06615"
msgstr "Spero di{line_break}vedervi presto.{end_wait}"

msgctxt "message"
msgid "06616"
msgstr "Non volevi chiedere a{line_break}Hama cosa intendeva{line_break}dire prima?{end_wait}"

msgctxt "message"
msgid "06617"
msgstr "Non sappiamo quando{line_break}rivedremo di nuovo{line_break}la maestra Hama.{end_wait}"

msgctxt "message"
msgid "06618"
msgstr "{actor_name:1}, non pensi{line_break}che dovremmo chiedere a{line_break}Hama cosa intendeva?{end_now}"

msgctxt "message"
msgid "06619"
msgstr "Se vuoi saperlo,{line_break}dovresti andare a{line_break}chiederglielo ora!{end_wait}"

msgctxt "message"
msgid "06620"
msgstr "Come? Allora dobbiamo{line_break}andarcene così?{end_wait}"

msgctxt "message"
msgid "06621"
msgstr "Grazie a tutti...{end_wait}"

msgctxt "message"
msgid "06622"
msgstr "ma ora è meglio{line_break}partire.{end_wait}"

msgctxt "message"
msgid "06623"
msgstr "Che vuoi dire?{end_wait}"

msgctxt "message"
msgid "06624"
msgstr "Dopo aver detto quelle{line_break}parole, Hama non mi ha più{line_break}guardato negli occhi.{end_wait}"

msgctxt "message"
msgid "06625"
msgstr "Beh, questo aumenta{line_break}la mia curiosità!{end_wait}"

msgctxt "message"
msgid "06626"
msgstr "Non ti preoccupare. Credo{line_break}che non lo direbbe neppure{line_break}a me se glielo chiedessi.{end_wait}"

msgctxt "message"
msgid "06627"
msgstr "È solo che...{end_wait}"

msgctxt "message"
msgid "06628"
msgstr "La maestra Hama me lo dirà{line_break}quando avremo compiuto{line_break}la nostra missione.{end_wait}"

msgctxt "message"
msgid "06629"
msgstr "Dovrò crederci...{end_wait}"

msgctxt "message"
msgid "06630"
msgstr "Il Deserto di Lamakan{line_break}è molto pericoloso.{line_break}Siate prudenti!{end_wait}"

msgctxt "message"
msgid "06631"
msgstr "Quel deserto stregato{line_break}è incredibilmente caldo.{line_break}Cercate delle oasi!{end_wait}"

msgctxt "message"
msgid "06632"
msgstr "Credo che con la meditazione{line_break}si possa apprendere il{line_break}potere della predizione.{end_wait}"

msgctxt "message"
msgid "06633"
msgstr "Sarò molto riconoscente a{line_break}chi trasformerà quel deserto{line_break}stregato in un posto normale.{end_wait}"

msgctxt "message"
msgid "06634"
msgstr "Se la vostra temperatura{line_break}andrà al massimo{page_break}riceverete un{line_break}terribile danno.{page_break}Andate più veloci che{line_break}potete, e quando avete{line_break}troppo caldo cercate un'oasi.{end_wait}"

msgctxt "message"
msgid "06635"
msgstr "Hama sta meditando:{line_break}si sta concentrando perché{line_break}vi vada tutto bene.{end_wait}"

msgctxt "message"
msgid "06636"
msgstr "Il futuro riserva molte{line_break}sorprese, ma non dovete{line_break}arrendervi mai!{end_wait}"

msgctxt "message"
msgid "06637"
msgstr "Non posso attraversare{line_break}il deserto. Mi fa{line_break}troppa paura!{end_wait}"

msgctxt "message"
msgid "06638"
msgstr "Quel deserto è così stregato{line_break}che anche la luce è distorta.{line_break}Perché mai?{end_wait}"

msgctxt "message"
msgid "06639"
msgstr "Che bello sarebbe se{line_break}potessi predire{line_break}il futuro.{end_wait}"

msgctxt "message"
msgid "06640"
msgstr "Se vi perdeste nel{line_break}deserto, Hama ne sarebbe{line_break}molto dispiaciuta.{end_wait}"

msgctxt "message"
msgid "06641"
msgstr "Rivelazione vi farà trovare{line_break}le oasi non attraverso gli{line_break}occhi, ma con la vostra mente.{end_wait}"

msgctxt "message"
msgid "06642"
msgstr "Non credo che Hama voglia{line_break}che {actor_name:3} se ne vada...{end_wait}"

msgctxt "message"
msgid "06643"
msgstr "Non riesco a vedere{line_break}chiaramente il tuo futuro...{page_break}Sarà perché non riesco{line_break}a non farmi coinvolgere{line_break}dal tuo destino...{end_wait}"

msgctxt "message"
msgid "06644"
msgstr "A nord: Miniera di Altin{line_break}A ovest: Tempio di Lama{end_wait}"

msgctxt "message"
msgid "06645"
msgstr "Aaah...{pause_20_skippable} Questo{line_break}deserto è più torrido{line_break}di quanto immagginassi...{end_wait}"

msgctxt "message"
msgid "06646"
msgstr "Camminare con questo{line_break}caldo mi toglie tutte{line_break}le energie.{end_wait}"

msgctxt "message"
msgid "06647"
msgstr "Sudo da pazzi...{pause_20_skippable}{line_break}Avrei dovuto portarmi dei{line_break}vestiti di ricambio...{end_wait}"

msgctxt "message"
msgid "06648"
msgstr "Che sete...{pause_20_skippable} Acqua!{pause_20_skippable}{line_break}Datemi dell'acqua!{end_wait}"

msgctxt "message"
msgid "06649"
msgstr "Con questo caldo sto{line_break}uscendo di testa...{end_wait}"

msgctxt "message"
msgid "06650"
msgstr "Ehi... Ho i vestiti{line_break}zuppi di sudore!{line_break}È orribile!{end_wait}"

msgctxt "message"
msgid "06651"
msgstr "Aaah!{pause_20_skippable} Non resisto!{pause_20_skippable}{line_break}Mi si scottano i piedi!{end_wait}"

msgctxt "message"
msgid "06652"
msgstr "Non ce la faccio{line_break}più! Dobbiamo trovare{line_break}un'oasi! Ora!{end_wait}"

msgctxt "message"
msgid "06653"
msgstr "Se non troviamo immediatamente{line_break}un'oasi, credo che mi{line_break}seccherò dal caldo!{end_wait}"

msgctxt "message"
msgid "06654"
msgstr "Viaggio per il mondo{line_break}per diffondere la{line_break}buona volontà.{end_wait}"

msgctxt "message"
msgid "06655"
msgstr "Già che sono qui, vorrei{line_break}apprendere i segreti del{line_break}Tempio di Fuchin, ma{page_break}prima devo sottopormi{line_break}ad un intenso programma{line_break}d'allenamento.{end_wait}"

msgctxt "message"
msgid "06656"
msgstr "Viaggio per il mondo{line_break}per diffondere la{line_break}buona volontà.{end_wait}"

msgctxt "message"
msgid "06657"
msgstr "Non so perché, ma con{line_break}questa gente ho la stessa{line_break}sensazione che ho provato{page_break}davanti alla maestra del{line_break}tempio, Hama.{page_break}Mi sento come se{line_break}qualcuno mi stesse{line_break}leggendo nella mente...{end_wait}"

msgctxt "message"
msgid "06658"
msgstr "Abbiamo spostato le rocce.{line_break}Così ora si può passare.{end_wait}"

msgctxt "message"
msgid "06659"
msgstr "Molta gente di Xian ha{line_break}aiutato a spostare le rocce.{line_break}Erano così pesanti!{end_wait}"

msgctxt "message"
msgid "06660"
msgstr "Abbiamo liberato la strada.{line_break}Ma cosa facciamo con{line_break}queste rocce? Spostiamo{page_break}anche queste?{end_wait}"

msgctxt "message"
msgid "06661"
msgstr "Per poco non mi facevo{line_break}male alla schiena. È che{line_break}sono fuori allenamento.{end_wait}"

msgctxt "message"
msgid "06662"
msgstr "Xian è un villaggio{line_break}pacifico, ma ultimamente{line_break}abbiamo avuto dei{page_break}problemi. Hsu, l'apprendista{line_break}del maestro Xian, è rimasto{line_break}intrappolato sotto una roccia.{end_wait}"

msgctxt "message"
msgid "06663"
msgstr "Sulla Strada della Seta{line_break}c'è stata una frana.{line_break}Siamo rimasti sconvolti.{end_wait}"

msgctxt "message"
msgid "06664"
msgstr "Ho aiutato a spostare{line_break}le rocce...{line_break}Ora ho un mal di schiena!{end_wait}"

msgctxt "message"
msgid "06665"
msgstr "Quelli che spostavano le{line_break}rocce mi hanno detto che il{line_break}Deserto di Lamakan è rosso.{page_break}Ma perché?{end_wait}"

msgctxt "message"
msgid "06666"
msgstr "Hsu è molto bravo nel{line_break}kung fu, ma quei massi{line_break}erano davvero pesanti.{page_break}Il Kung fu non può molto{line_break}contro i massi.{end_wait}"

msgctxt "message"
msgid "06667"
msgstr "Quelli di Xian amano talmente{line_break}il loro villaggio che non se{line_break}ne allontanano quasi mai.{page_break}Ma quando c'è stata la frana,{line_break}sono andati tutti alla Strada{line_break}della Seta per spostare i massi.{end_wait}"

msgctxt "message"
msgid "06668"
msgstr "Altin era inondata, ma dei{line_break}giovani guerrieri hanno messo{line_break}tutto a posto. L'ha detto Feizhi.{end_wait}"

msgctxt "message"
msgid "06669"
msgstr "Abbiamo spostato le rocce{line_break}dalla Strada della Seta.{line_break}Non è stato facile...{end_wait}"

msgctxt "message"
msgid "06670"
msgstr "Tutt'ad un tratto capitano{line_break}cose strane...{line_break}Come mai?{end_wait}"

msgctxt "message"
msgid "06671"
msgstr "Hsu è finito sotto un masso,{line_break}ma si è soltanto rotto{line_break}una gamba.{end_wait}"

msgctxt "message"
msgid "06672"
msgstr "Quelle rocce sembravano{line_break}molto solide. È strano che{line_break}siano cadute.{end_wait}"

msgctxt "message"
msgid "06673"
msgstr "Alcuni non aiutavano con{line_break}le rocce. Così ho pensato{line_break}di dare una mano...{page_break}Che sciocco!{end_wait}"

msgctxt "message"
msgid "06674"
msgstr "La sabbia di solito ha il{line_break}colore dei cammelli. La{line_break}sabbia rossa è strana...{end_wait}"

msgctxt "message"
msgid "06675"
msgstr "Hsu è un tipo ostinato.{line_break}Non si sposta neppure se{line_break}gli cadono dei massi addosso.{page_break}Ecco com'è andata!{end_wait}"

msgctxt "message"
msgid "06676"
msgstr "Stanno sempre a Xian.{line_break}Non sanno nulla di ciò{line_break}che accade nel mondo.{end_wait}"

msgctxt "message"
msgid "06677"
msgstr "Quel guerriero ha salvato il{line_break}villaggio di Altin, vero?{end_wait}"

msgctxt "message"
msgid "06678"
msgstr "Quelle rocce sono un{line_break}disastro per Xian.{page_break}Le carovane non passano,{line_break}così i mercanti di seta{line_break}non vengono a Xian!{end_wait}"

msgctxt "message"
msgid "06679"
msgstr "È stato bello vedere quelle{line_break}gemme cadere dal cielo, ma{line_break}anche piuttosto strano.{page_break}Avevo la sensazione che stesse{line_break}accadendo qualcosa di brutto.{end_wait}"

msgctxt "message"
msgid "06680"
msgstr "Ma dove sono i mercanti?{line_break}Non si vedono! Speriamo che{line_break}vengano a compare la seta!{end_wait}"

msgctxt "message"
msgid "06681"
msgstr "I mercanti portano soldi.{line_break}Speriamo che arrivino{line_break}presto!{page_break}Ci servono per comprare il{line_break}cibo per l'inverno.{end_wait}"

msgctxt "message"
msgid "06682"
msgstr "Ma perché Hammet non arriva?{line_break}Come facciamo senza di lui?!{end_wait}"

msgctxt "message"
msgid "06683"
msgstr "Quando i mercanti vengono a{line_break}vendere la seta, sembra un{page_break}festival! Speriamo{line_break}di vederli presto!{end_wait}"

msgctxt "message"
msgid "06684"
msgstr "C'è qualcosa di strano sulla{line_break}Strada della Seta? Anche nel{line_break}Deserto di Lamakan?{end_now}"

msgctxt "message"
msgid "06685"
msgstr "È orribile! La Strada della{line_break}Seta è inutilizzabile!{end_wait}"

msgctxt "message"
msgid "06686"
msgstr "Tutto a posto nel deserto?{line_break}Bene, mi fa piacere.{end_wait}"

msgctxt "message"
msgid "06687"
msgstr "Nessuno può attraversare{line_break}Lamakan. E ciò è{line_break}triste.{end_wait}"

msgctxt "message"
msgid "06688"
msgstr "Feizhi ha detto che il{line_break}deserto ora è stregato!{end_wait}"

msgctxt "message"
msgid "06689"
msgstr "Il deserto è sempre stato caldo.{line_break}Se ora lo è ancora di più...{line_break}Nessuno potrà sopravvivere!{end_wait}"

msgctxt "message"
msgid "06690"
msgstr "I mostri di Altin{line_break}sputano acqua?{end_now}"

msgctxt "message"
msgid "06691"
msgstr "I mostri hanno inondato{line_break}la città di Altin?{line_break}Che strano!{end_wait}"

msgctxt "message"
msgid "06692"
msgstr "Allora non è vero?{line_break}Ma perché Feizhi dovrebbe{line_break}mentire?{end_wait}"

msgctxt "message"
msgid "06693"
msgstr "La Miniera di Altin{line_break}piena d'acqua? Avrei{line_break}voluto vederla...{end_wait}"

msgctxt "message"
msgid "06694"
msgstr "Il villaggio è inondato{line_break}a causa dei mostri?{page_break}Non ci capisco niente...{end_wait}"

msgctxt "message"
msgid "06695"
msgstr "Mostri acquatici...{line_break}È tremendo per Altin!{page_break}Ma a Xian c'è il mestro Feh.{line_break}Li distruggerà!{end_wait}"

msgctxt "message"
msgid "06696"
msgstr "L'incidente di Hsu ci ha{line_break}fatto capire una cosa...{page_break}Neppure il kung fu serve a{line_break}qualcosa contro i massi.{end_wait}"

msgctxt "message"
msgid "06697"
msgstr "Hsu è stato travolto da{line_break}enormi massi. Ma grazie{line_break}al kung fu, se l'è cavata{page_break}con ferite non gravi.{end_wait}"

msgctxt "message"
msgid "06698"
msgstr "Il kung fu rende{line_break}rapidi, giusto?{page_break}Ciononostante, Hsu s'è fatto{line_break}sorprendere da quei massi.{end_wait}"

msgctxt "message"
msgid "06699"
msgstr "Dovremo vendere armature{line_break}anche ai maestri{line_break}di kung fu.{end_wait}"

msgctxt "message"
msgid "06700"
msgstr "Guerriero, vuoi{line_break}attraversare il deserto?{end_now}"

msgctxt "message"
msgid "06701"
msgstr "Dovrai spendere molte{line_break}energie... È meglio che{line_break}compri molte provviste!{end_wait}"

msgctxt "message"
msgid "06702"
msgstr "Sei un guerriero saggio.{line_break}I saggi si sanno sempre{line_break}tenere lontani dal pericolo.{end_wait}"

msgctxt "message"
msgid "06703"
msgstr "Il caldo fa perdere energie.{line_break}La mia merce ti servirà a{line_break}recuperare le forze.{end_wait}"

msgctxt "message"
msgid "06704"
msgstr "In questi giorni i{line_break}clienti sono pochi...{page_break}La Strada della Seta è{line_break}bloccata, così i clienti non{line_break}possono entrare in città.{end_wait}"

msgctxt "message"
msgid "06705"
msgstr "Se nel Deserto di Lamakan fa{line_break}così caldo è un problema per{line_break}Xian. Se non vendono la seta,{page_break}gli abitanti non potranno{line_break}superare l'inverno.{end_wait}"

msgctxt "message"
msgid "06706"
msgstr "Del buon cibo piccante è{line_break}l'ideale per attraversare{line_break}il Deserto di Lamakan.{page_break}Il cibo piccante fa{line_break}venire appetito.{end_wait}"

msgctxt "message"
msgid "06707"
msgstr "Se la strada è bloccata dai{line_break}massi, i mercanti non{line_break}vengono.{end_wait}"

msgctxt "message"
msgid "06708"
msgstr "Nel Deserto di Lamakan fa{line_break}troppo caldo, i mercanti{line_break}non possono passare...{page_break}E qui non si fanno affari...{end_wait}"

msgctxt "message"
msgid "06709"
msgstr "Mangia, guerriero. Ora{line_break}ti ci aggiungo un bel{line_break}po' di peperoncino.{end_wait}"

msgctxt "message"
msgid "06710"
msgstr "La Prateria di Mogall ora{line_break}è una foresta, e Lamakan{line_break}un deserto stregato.{page_break}D'ora in avanti possiamo{line_break}andare ovunque.{end_wait}"

msgctxt "message"
msgid "06711"
msgstr "Se non posso andare né ad{line_break}est né ad a ovest, rimarrò{line_break}a Xian per tutta la vita.{end_wait}"

msgctxt "message"
msgid "06712"
msgstr "Questa è la scuola di{line_break}kung fu del maestro Xian.{page_break}Le arti marziali mantengono{line_break}la pace a Xian.{end_wait}"

msgctxt "message"
msgid "06713"
msgstr "Come è possibile che Hsu,{line_break}che pratica il kung fu, sia{line_break}stato sopraffatto dai massi?{page_break}Qui occorre allenarsi meglio!{end_wait}"

msgctxt "message"
msgid "06714"
msgstr "Dei mostri d'acqua hanno{line_break}inondato Altin. Li hai{line_break}battuti tu, guerriero?{end_now}"

msgctxt "message"
msgid "06715"
msgstr "Sei più forte di quanto{line_break}sembri.{page_break}Meriti tutto il mio{line_break}rispetto!{end_wait}"

msgctxt "message"
msgid "06716"
msgstr "Oh... Ma tu non sei{line_break}il forte guerriero{line_break}di cui parlava Feizhi?{end_wait}"

msgctxt "message"
msgid "06717"
msgstr "Hsu non si è allenato{line_break}abbastanza nei salti.{page_break}Ecco perché non è riuscito{line_break}a schivare i massi...{end_wait}"

msgctxt "message"
msgid "06718"
msgstr "Feizhi aveva predetto che{line_break}Hsu correva un pericolo...{line_break}La profezia s'è avverata!{page_break}Grazie alla profezia, Hsu{line_break}s'è salvato, e ora è tornato.{line_break}È piuttosto strano...{end_wait}"

msgctxt "message"
msgid "06719"
msgstr "Hsu sta riposando. Feizhi si{line_break}sta prendendo cura di lui.{line_break}Saranno lieti di vederti!{end_wait}"

msgctxt "message"
msgid "06720"
msgstr "A Xian è tornata la pace,{line_break}ma sia ad est che ad ovest{line_break}si corrono molti pericoli.{end_wait}"

msgctxt "message"
msgid "06721"
msgstr "Per quanto ti possa esercitare{line_break}con i calci, i tuoi piedi{page_break}non saranno mai più forti{line_break}di una roccia.{end_wait}"

msgctxt "message"
msgid "06722"
msgstr "I mostri sono grossissimi.{line_break}Se ne colpisci uno, ti{line_break}fai male alla mano.{page_break}Forse dovremmo usare{line_break}delle armi?{end_wait}"

msgctxt "message"
msgid "06723"
msgstr "Ogni volta che cade una{line_break}roccia, salta! È tutto{line_break}qui il segreto!{end_wait}"

msgctxt "message"
msgid "06724"
msgstr "Ma dove ha imparato Feizhi{line_break}a presagire il pericolo?{line_break}Anch'io vorrei saperlo fare...{end_wait}"

msgctxt "message"
msgid "06725"
msgstr "Il maestro Feh è molto{line_break}preoccupato per{line_break}quei due.{end_wait}"

msgctxt "message"
msgid "06726"
msgstr "Benvenuto, guerriero!{end_wait}"

msgctxt "message"
msgid "06727"
msgstr "Grazie a te e ad Hama,{line_break}Hsu è sano e salvo!{page_break}Ve ne sono molto{line_break}riconoscente.{end_wait}"

msgctxt "message"
msgid "06728"
msgstr "Tornando dal Tempio di{line_break}Lama, sono stato ferito{line_break}dalle rocce che cadevano.{page_break}Peccato, il mio allenamento{line_break}non m'è stato d'aiuto!{end_wait}"

msgctxt "message"
msgid "06729"
msgstr "La predizione di Feizhi{line_break}s'è avverata.{page_break}Ora so che può veramente{line_break}presagire il futuro!{end_wait}"

msgctxt "message"
msgid "06730"
msgstr "La maestra Hama ha grandi{line_break}poteri. Li hai anche tu,{page_break}giovane guerriero.{line_break}Siete entrambi eccezionali!{end_wait}"

msgctxt "message"
msgid "06731"
msgstr "Sapevo che qualcuno mi{line_break}avrebbe liberato.{line_break}Grazie, grazie a tutti!{end_wait}"

msgctxt "message"
msgid "06732"
msgstr "Ma allora Feizhi può{line_break}davvero predire il{line_break}futuro! È sorprendente!{end_wait}"

msgctxt "message"
msgid "06733"
msgstr "Hsu è rimasto intrappolato{line_break}tra le rocce, ma sta{line_break}bene.{page_break}Dobbiamo ringraziare{line_break}Hama di questo!{end_wait}"

msgctxt "message"
msgid "06734"
msgstr "Tornando dal Tempio di{line_break}Lama, sono stato ferito{line_break}dalle rocce che cadevano.{page_break}Peccato, il mio allenamento{line_break}non m'è stato d'aiuto!{end_wait}"

msgctxt "message"
msgid "06735"
msgstr "La predizione di Feizhi{line_break}s'è avverata.{page_break}Ora so che può veramente{line_break}presagire il futuro!{end_wait}"

msgctxt "message"
msgid "06736"
msgstr "Hama ha grandi poteri, e{line_break}io ho ricevuto una parte{line_break}della sua forza. È{page_break}una grande felicità!{end_wait}"

msgctxt "message"
msgid "06737"
msgstr "Sapevo che qualcuno mi{line_break}avrebbe liberato.{line_break}Grazie, grazie a tutti!{end_wait}"

msgctxt "message"
msgid "06738"
msgstr "Ma allora Feizhi può{line_break}davvero predire il{line_break}futuro! È sorprendente!{end_wait}"

msgctxt "message"
msgid "06739"
msgstr "Questa è Kalay! Siano benvenuti{line_break}tutti coloro che ne vogliono{line_break}preservare la pace.{end_wait}"

msgctxt "message"
msgid "06740"
msgstr "Noi soldati difendiamo a{line_break}costo della vita la{line_break}pace a Kalay.{end_wait}"

msgctxt "message"
msgid "06741"
msgstr "Lord Hammet, il fondatore{line_break}di Kalay, è un grande{line_break}mercante.{end_wait}"

msgctxt "message"
msgid "06742"
msgstr "Lord Hammet è ancora{line_break}in viaggio per affari{line_break}con la sua carovana.{page_break}Non so quando{line_break}tornerà...{end_wait}"

msgctxt "message"
msgid "06743"
msgstr "Il ponte a nord era stato{line_break}distrutto dalla lava. Per{page_break}fortuna ora è stato{line_break}riparato.{end_wait}"

msgctxt "message"
msgid "06744"
msgstr "Ho sentito dire che nel{line_break}Deserto di Lamakan ci{line_break}sono problemi.{end_wait}"

msgctxt "message"
msgid "06745"
msgstr "Kalay è all'incrocio tra{line_break}due strade. Ad est si va verso{line_break}Xian, ad ovest verso Tolbi.{page_break}È un luogo perfetto per{line_break}gli affari!{end_wait}"

msgctxt "message"
msgid "06746"
msgstr "Gli ospiti della locanda{line_break}sono in viaggio per andare{line_break}a vedere il Colossum.{page_break}È un bello strapazzo andare{line_break}a Tolbi soltanto per{line_break}il festival.{end_wait}"

msgctxt "message"
msgid "06747"
msgstr "Dicono che il Colossum{line_break}sia incredibile. Come vorrei{line_break}vedere un festival così!{end_wait}"

msgctxt "message"
msgid "06748"
msgstr "A nord, ha eruttato{line_break}un enorme{line_break}vulcano.{page_break}Credo che si{line_break}chiami Monte Aleph.{end_wait}"

msgctxt "message"
msgid "06749"
msgstr "Lord Hammet ha il pallino{line_break}del commercio: ecco perché{line_break}Kalay è così florida.{end_wait}"

msgctxt "message"
msgid "06750"
msgstr "Ora sto a Kalay, perché{line_break}Tolbi non mi piaceva...{line_break}Vuoi sapere il motivo?{end_now}"

msgctxt "message"
msgid "06751"
msgstr "Ho paura di Babi,{line_break}il capo di Tolbi.{page_break}Dicono che comandi a{line_break}Tolbi da più di{line_break}cent'anni.{end_wait}"

msgctxt "message"
msgid "06752"
msgstr "Kalay è molto più{line_break}bella di Tolbi.{line_break}Non torno indietro!{end_wait}"

msgctxt "message"
msgid "06753"
msgstr "Gira voce che{line_break}Lord Hammet sia{line_break}stato rapito{page_break}dai ladri... Ma sua{line_break}moglie, Layana,{line_break}ne parla poco.{end_wait}"

msgctxt "message"
msgid "06754"
msgstr "Pare che dopo l'eruzione Lord{line_break}Hammet abbia lasciato Vault per{line_break}proseguire verso nord.{page_break}Non si sa dove sia, o che{line_break}fine abbia fatto{line_break}la sua carovana.{end_wait}"

msgctxt "message"
msgid "06755"
msgstr "Questo giovane guerriero{line_break}ha uno sguardo onesto{line_break}e modi gentili.{page_break}Un uomo così non può{line_break}essere malvagio.{end_wait}"

msgctxt "message"
msgid "06756"
msgstr "Il nostro lavoro è di decidere{line_break}se permettere ad uno straniero{line_break}di entrare a Kalay.{end_wait}"

msgctxt "message"
msgid "06757"
msgstr "Questa città è nata dall'{line_break}amore di Lord Hammet per la{line_break}pace e la libertà.{end_wait}"

msgctxt "message"
msgid "06758"
msgstr "Nonostante le apparenze,{line_break}a volte Lord Hammet può{line_break}essere molto imprudente.{page_break}Questo mi preoccupa un po'.{end_wait}"

msgctxt "message"
msgid "06759"
msgstr "I soldati di Lord Hammet sono{line_break}andati a Vault dopo la{line_break}ricostruzione del ponte.{page_break}Da allora il palazzo è{line_break}così silenzioso...{end_wait}"

msgctxt "message"
msgid "06760"
msgstr "Ultimamente stanno{line_break}capitando cose strane{line_break}un po' ovunque...{page_break}Ma che sta succedendo{line_break}in questo mondo?{end_wait}"

msgctxt "message"
msgid "06761"
msgstr "Hammet ha costruito Kalay{line_break}qui perché è un buon{line_break}posto per il commercio.{page_break}Lord Hammet è davvero{line_break}un uomo in gamba.{end_wait}"

msgctxt "message"
msgid "06762"
msgstr "Mi piacerebbe molto andare{line_break}a vedere il Colossum.{page_break}Se avessi risparmiato{line_break}un po' di soldi, ora{line_break}ci andrei anch'io.{end_wait}"

msgctxt "message"
msgid "06763"
msgstr "Magari quando sarò più{line_break}grande potrò persino andare{line_break}a lottare al Colossum!{end_wait}"

msgctxt "message"
msgid "06764"
msgstr "Durante l'eruzione del{line_break}vulcano dal cielo scendevano{line_break}strane rocce e gemme.{end_wait}"

msgctxt "message"
msgid "06765"
msgstr "Lord Hammet è un uomo{line_break}onesto, per il quale la{line_break}fiducia è molto importante.{page_break}Probabilmente per questo{line_break}motivo è così rispettato.{end_wait}"

msgctxt "message"
msgid "06766"
msgstr "La differenza tra Kalay e{line_break}Tolbi sta in chi le{line_break}governa.{page_break}Lord Hammet comanda con la{line_break}fiducia, Lord Babi{line_break}con la forza.{end_wait}"

msgctxt "message"
msgid "06767"
msgstr "Non sapevo che Lunpa{line_break}fosse immediatamente a nord{page_break}di Vault. È buffo che una città{line_break}di mercanti sia così vicina a{line_break}una città di ladri.{end_wait}"

msgctxt "message"
msgid "06768"
msgstr "Si sentono dire tante{line_break}cose... Non si sa più{line_break}a cosa credere!{end_wait}"

msgctxt "message"
msgid "06769"
msgstr "Chi pratica la buona{line_break}volontà potrà vivere in{line_break}pace a Kalay.{end_wait}"

msgctxt "message"
msgid "06770"
msgstr "Sono venuto per diffondere{line_break}la buona volontà...{page_break}Ma pare che qui l'unica{line_break}fonte di buona volontà{line_break}di cui hanno bisogno{page_break}sia Lord Hammet...{end_wait}"

msgctxt "message"
msgid "06771"
msgstr "OK!{pause_20_skippable} Mi sentite{line_break}tutti? Fermiamoci{line_break}qui.{end_wait}"

msgctxt "message"
msgid "06772"
msgstr "Perché ci fermiamo in{line_break}un posto simile?{end_wait}"

msgctxt "message"
msgid "06773"
msgstr "Sì!{pause_20_skippable} Dobbiamo sbrigarci,{line_break}o saremo in ritardo{line_break}per il Colossum!{end_wait}"

msgctxt "message"
msgid "06774"
msgstr "In ritardo per il Colossum?{line_break}Non possiamo!{end_wait}"

msgctxt "message"
msgid "06775"
msgstr "Non ce la faremo mai!{end_wait}"

msgctxt "message"
msgid "06776"
msgstr "Abbiamo pagato fior di{line_break}quattrini per il Colossum!{line_break}Non possiamo arrivare tardi!{end_wait}"

msgctxt "message"
msgid "06777"
msgstr "Andrà tutto bene,{line_break}state tranquilli!{end_wait}"

msgctxt "message"
msgid "06778"
msgstr "Stiamo soltanto{line_break}controllando che non{line_break}manchi nessuno!{end_wait}"

msgctxt "message"
msgid "06779"
msgstr "Dovremmo esserci tutti...{end_wait}"

msgctxt "message"
msgid "06780"
msgstr "Ma se manca qualcuno{line_break}saremo noi a mancare{line_break}l'appuntamento.{end_wait}"

msgctxt "message"
msgid "06781"
msgstr "Se manca qualcuno, pazienza!{line_break}Basta sbrigarsi!{end_wait}"

msgctxt "message"
msgid "06782"
msgstr "Oh cielo...{end_wait}"

msgctxt "message"
msgid "06783"
msgstr "Bene, iniziate a{line_break}contare, dai!{end_wait}"

msgctxt "message"
msgid "06784"
msgstr "Nooo... Ne manca{line_break}uno... Dove diavolo{line_break}si sarà cacciato?{end_wait}"

msgctxt "message"
msgid "06785"
msgstr "Ma che succede?{line_break}Perché non partono{line_break}verso Tolbi?{end_wait}"

msgctxt "message"
msgid "06786"
msgstr "Ehi, qui ci sono molte{line_break}persone che vogliono vedere{line_break}il Colossum!{end_wait}"

msgctxt "message"
msgid "06787"
msgstr "Ehi? Che succede? Perché{line_break}le guide stanno andando{line_break}avanti e indietro?{end_wait}"

msgctxt "message"
msgid "06788"
msgstr "Dobbiamo decidere se{line_break}dopo essere andati a Tolbi{line_break}proseguiremo per il Colossum.{end_wait}"

msgctxt "message"
msgid "06789"
msgstr "Ho sentito dire che sulla{line_break}strada per Tolbi c'è stata{line_break}una frana.{page_break}Abbiamo pagato fior di{line_break}quattrini per poter{line_break}vedere il Colossum!{end_wait}"

msgctxt "message"
msgid "06790"
msgstr "Su! Perché non andiamo,{line_break}una buona volta?{end_wait}"

msgctxt "message"
msgid "06791"
msgstr "Proprio mentre partiamo ci{line_break}vengono a dire che dobbiamo{line_break}salire su una nave?{page_break}Non sopporto le navi...{pause_20_skippable}{line_break}Se l'avessi saputo non{line_break}sarei mai venuto!{end_wait}"

msgctxt "message"
msgid "06792"
msgstr "È una vergogna che un uomo{line_break}come te non possa salire{line_break}su una barca, Ouranos.{end_wait}"

msgctxt "message"
msgid "06793"
msgstr "È assurdo. Continuo a contare{line_break}e ricontare, ma manca{line_break}sempre qualcuno.{end_wait}"

msgctxt "message"
msgid "06794"
msgstr "Ho contato tutti alla{line_break}locanda... Dove possiamo{line_break}averlo perso?{end_wait}"

msgctxt "message"
msgid "06795"
msgstr "Ma chi manca? Avanti,{line_break}è tanto che aspettiamo!{end_wait}"

msgctxt "message"
msgid "06796"
msgstr "Quest'anno sono{line_break}in tanti ad andare{line_break}a Tolbi.{end_wait}"

msgctxt "message"
msgid "06797"
msgstr "Ma lasciamo qui{line_break}quello che manca{line_break}e partiamo, no!?{end_wait}"

msgctxt "message"
msgid "06798"
msgstr "Sono così tanti ad andare a{line_break}Tolbi, che molti non troveranno{line_break}posto dentro al Colossum.{end_wait}"

msgctxt "message"
msgid "06799"
msgstr "Ho un po' d'angoscia per{line_break}tutte le cose strane che{line_break}accadono in giro!{end_wait}"

msgctxt "message"
msgid "06800"
msgstr "È imbarazzante!{line_break}Tutta questa attesa, dopo{line_break}aver annunciato la partenza!{end_wait}"

msgctxt "message"
msgid "06801"
msgstr "Mi imbarazza dirlo ma...{line_break}non so nuotare!{page_break}Se la nave affonda,{line_break}che faccio...{end_wait}"

msgctxt "message"
msgid "06802"
msgstr "Per questo ti dico{line_break}sempre che voglio{line_break}insegnarti a nuotare...{end_wait}"

msgctxt "message"
msgid "06803"
msgstr "Forse dovrei vedere se è{line_break}ancora nella locanda. Che{line_break}devo fare?{end_wait}"

msgctxt "message"
msgid "06804"
msgstr "Basta... {pause_20_skippable}Non possiamo{line_break}perdere un minuto di più!{end_wait}"

msgctxt "message"
msgid "06805"
msgstr "Non possiamo? Cosa{line_break}intendi dire?{end_wait}"

msgctxt "message"
msgid "06806"
msgstr "Non eravamo tutti d'accordo{line_break}che non si può aspettare{line_break}chi è in ritardo?{end_wait}"

msgctxt "message"
msgid "06807"
msgstr "L'hanno capito tutti.{end_wait}"

msgctxt "message"
msgid "06808"
msgstr "E allora dov'è il problema?{pause_20_skippable}{line_break}Perderemo la nave se{line_break}aspettiamo ancora!{end_wait}"

msgctxt "message"
msgid "06809"
msgstr "Perdere la nave?{pause_20_skippable}{line_break}Non voglio neanche pensarci!{end_wait}"

msgctxt "message"
msgid "06810"
msgstr "Con tutti i soldi che{line_break}abbiamo pagato...{page_break}Non possiamo non{line_break}arrivare prima che{line_break}inizi il festival!{end_wait}"

msgctxt "message"
msgid "06811"
msgstr "Non c'è niente da{line_break}fare...{pause_20_skippable}{pause_20_skippable} Andiamo!{end_wait}"

msgctxt "message"
msgid "06812"
msgstr "Sì, andiamo!{end_wait}"

msgctxt "message"
msgid "06813"
msgstr "OK...{pause_20_skippable} Seguitemi{line_break}e restate in fila!{end_wait}"

msgctxt "message"
msgid "06814"
msgstr "Uhmmm... {pause_20_skippable}Dove si sono{line_break}cacciati gli altri?{end_wait}"

msgctxt "message"
msgid "06815"
msgstr "No! Non posso credere che{line_break}mi abbiano lasciato qui!{end_wait}"

msgctxt "message"
msgid "06816"
msgstr "Oh, no! Dovrò{line_break}sbrigarmi!{end_wait}"

msgctxt "message"
msgid "06817"
msgstr "È terribile: i ladri{line_break}nobili di Lunpa sono{line_break}diventati cattivi!{page_break}Pare che sia colpa{line_break}del nipote di Lunpa.{end_wait}"

msgctxt "message"
msgid "06818"
msgstr "Lunpa era un ladro buono.{line_break}Anche suo figlio, Donpa,{line_break}era un ladro di tutto rispetto.{page_break}Era un ladro giusto. Ma il{line_break}nipote di Lunpa, Dodonpa,{line_break}è tutta un'altra storia.{page_break}Non ci pensa certamente due{line_break}volte prima di compiere{line_break}le sue malvagità...{end_wait}"

msgctxt "message"
msgid "06819"
msgstr "Un tempo, la regione a{line_break}nord di Vault era{page_break}sicura. Ora è diventata{line_break}pericolosissima.{end_wait}"

msgctxt "message"
msgid "06820"
msgstr "Lunpa s'è guadagnata{line_break}una pessima reputazione.{end_wait}"

msgctxt "message"
msgid "06821"
msgstr "Pare che a nord si{line_break}concentri l'attenzione{line_break}di molti in questi giorni.{page_break}Come mai?{end_wait}"

msgctxt "message"
msgid "06822"
msgstr "Un mercante di Vault ci stava{line_break}raccontando parecchie cose che{line_break}stanno capitando a nord...{page_break}Poi sono arrivati i soldati{line_break}per portarlo al palazzo{line_break}di Lord Hammet.{end_wait}"

msgctxt "message"
msgid "06823"
msgstr "Tre anni fa a Monte Aleph{line_break}ci sono stati i ladri...{line_break}Che storia, eh?{page_break}Da quel momento, il nord{line_break}non è più considerato{line_break}un luogo tanto sicuro.{end_wait}"

msgctxt "message"
msgid "06824"
msgstr "Pare che ci siano anche altri{line_break}luoghi pericolosi a nord.{page_break}Forse la nostra città{line_break}è l'unico posto{line_break}ancora sicuro.{end_wait}"

msgctxt "message"
msgid "06825"
msgstr "Nessuno può andare a Vault,{line_break}sebbene il ponte sia{line_break}stato ricostruito.{page_break}Ma non credo che sia a{line_break}causa dell'eruzione{line_break}del Monte Aleph.{end_wait}"

msgctxt "message"
msgid "06826"
msgstr "Non voglio che mio{line_break}figlio corra pericoli!{page_break}Sono perfettamente d'accordo{line_break}con gli ordini di Lady Layana.{end_wait}"

msgctxt "message"
msgid "06827"
msgstr "Ormai sono una persona adulta.{line_break}Non sopporto che mio padre{line_break}mi dia sempre ordini...{end_wait}"

msgctxt "message"
msgid "06828"
msgstr "So che ci tiene, ma non{line_break}posso permettere che mio{line_break}figlio vada a nord.{end_wait}"

msgctxt "message"
msgid "06829"
msgstr "Soprattutto, un buon mercante{line_break}deve saper riconoscere la{line_break}qualità.{page_break}Se sa far questo,{line_break}sarà sicuramente un{line_break}mercante di successo.{end_wait}"

msgctxt "message"
msgid "06830"
msgstr "Mio figlio ha preso da{line_break}Lord Hammet la passione{line_break}per il commercio.{end_wait}"

msgctxt "message"
msgid "06831"
msgstr "La cosa più importante è non{line_break}tradire mai la fiducia{line_break}del cliente.{page_break}Gli insegnamenti di{line_break}Lord Hammet sono oro{line_break}per me.{page_break}Mi faranno fare un{line_break}mucchio di soldi!{end_wait}"

msgctxt "message"
msgid "06832"
msgstr "Quando si tratta di soldi,{line_break}mio figlio è abbastanza{line_break}spilorcio, persino con me!{page_break}Mi sembra di vivere con un{line_break}mercante... Beh, a dire il{line_break}vero, è proprio un mercante!{end_wait}"

msgctxt "message"
msgid "06833"
msgstr "Lord Hammet vende fuori{line_break}tutte le sue armi{line_break}migliori.{page_break}Queste non sono male, ma{line_break}neppure la migliore{line_break}produzione di Kalay.{end_wait}"

msgctxt "message"
msgid "06834"
msgstr "Se ci lasciasse armi{line_break}migliori, potremmo fare{line_break}senz'altro più soldi.{end_wait}"

msgctxt "message"
msgid "06835"
msgstr "Hai trovato ciò che ti{line_break}serviva nel Negozio{line_break}di Armi?{end_now}"

msgctxt "message"
msgid "06836"
msgstr "Allora ti piaceranno anche{line_break}le nostre armature.{end_wait}"

msgctxt "message"
msgid "06837"
msgstr "Ah...{pause_20_skippable} Tu cerchi{line_break}la migliore attrezzatura...{page_break}Ma le armi e le armature di{line_break}Kalay non hanno eguali.{end_wait}"

msgctxt "message"
msgid "06838"
msgstr "Magari le armi e le armature{line_break}di Tolbi sono più forti, ma{line_break}le nostre hanno un'anima.{end_wait}"

msgctxt "message"
msgid "06839"
msgstr "Quando Lord Hammet ha creato{line_break}la città, Lady Layana ne{line_break}ha condiviso le fatiche.{page_break}La dedizione di questa donna{line_break}ha reso fiorente la città.{end_wait}"

msgctxt "message"
msgid "06840"
msgstr "Un'altra cosa che ha reso{line_break}florida questa città sono{line_break}i suoi acquedotti.{end_wait}"

msgctxt "message"
msgid "06841"
msgstr "Anche tu vai a{line_break}Tolbi?{end_now}"

msgctxt "message"
msgid "06842"
msgstr "Allora partecipi anche{line_break}tu alla gita al{line_break}Colossum...{page_break}Il festival annuale{line_break}del Colossum inizia{line_break}fra poco.{end_wait}"

msgctxt "message"
msgid "06843"
msgstr "I mercanti ne inventano{line_break}sempre una nuova.{line_break}Una gita al Colossum... Mah!{page_break}Sono al ristorante. Credo{line_break}che debbano mettersi{line_break}in marcia, ormai.{end_wait}"

msgctxt "message"
msgid "06844"
msgstr "Vanno tutti a Tolbi per{line_break}vedere il festival{line_break}del Colossum.{page_break}Kalay sembrerà così vuota...{end_wait}"

msgctxt "message"
msgid "06845"
msgstr "Partecipo ad una gita{line_break}a Tolbi.{page_break}Non posso credere che{line_break}il Colossum stia per{line_break}iniziare!{end_wait}"

msgctxt "message"
msgid "06846"
msgstr "I gladiatori del Colossum{line_break}sono uomini forti,{line_break}muscolosi!{end_wait}"

msgctxt "message"
msgid "06847"
msgstr "Se partecipi alla gita,{line_break}sbrigati a mangiare!{pause_20_skippable}{line_break}Stiamo per partire!{end_wait}"

msgctxt "message"
msgid "06848"
msgstr "Una volta all'anno,{line_break}vogliono tutti{line_break}andare a Tolbi.{page_break}Ma a Tolbi non c'è solo{line_break}il Colossum: ci sono anche le{line_break}cascate di Tolbi, per esempio.{end_wait}"

msgctxt "message"
msgid "06849"
msgstr "Lord Hammet capiterà{line_break}certamente a Tolbi.{page_break}Il Colossum gli piace molto.{end_wait}"

msgctxt "message"
msgid "06850"
msgstr "Se fossi solo un po' più{line_break}giovane potrei competere{line_break}nel Colossum.{page_break}Che peccato!{end_wait}"

msgctxt "message"
msgid "06851"
msgstr "Pare che molte di{line_break}queste persone siano{line_break}dirette a Tolbi.{end_wait}"

msgctxt "message"
msgid "06852"
msgstr "Non andate al Colossum{line_break}voi, giovani{line_break}guerrieri?{page_break}Tutti i guerrieri sognano{line_break}di diventare famosi{line_break}al Colossum!{end_wait}"

msgctxt "message"
msgid "06853"
msgstr "Sai qualcosa del continente{line_break}a sud di Tolbi?{end_now}"

msgctxt "message"
msgid "06854"
msgstr "Il tipo della camera accanto{line_break}è vestito come uno del{line_break}Gondowan.{end_wait}"

msgctxt "message"
msgid "06855"
msgstr "Si chiama Gondowan quel{line_break}continente. È{line_break}enorme.{page_break}Dicono che sia il secondo{line_break}continente più grande{line_break}dopo Angara.{page_break}Pare che faccia molto{line_break}caldo nel Gondowan.{end_wait}"

msgctxt "message"
msgid "06856"
msgstr "Devo prepararmi!{line_break}La gita al Colossum sta{line_break}per iniziare!{page_break}Stiamo andando a{line_break}Tolbi per vedere{line_break}il Colossum.{page_break}Magari potremo anche vedere{line_break}il continente meridionale.{end_wait}"

msgctxt "message"
msgid "06857"
msgstr "Siamo fuggiti da Gondowan,{line_break}a sud.{page_break}Vivevamo a Lalivero, un{line_break}bellissimo villaggio prima che{line_break}arrivassero quelli di Tolbi.{end_wait}"

msgctxt "message"
msgid "06858"
msgstr "Il mio villaggio,{line_break}Lalivero, il più{line_break}grande del Gondowan.{page_break}Anche Kalay è piuttosto{line_break}grande, ma un po'{line_break}troppo rumorosa.{end_wait}"

msgctxt "message"
msgid "06859"
msgstr "Se entri al Colossum,{line_break}non credere di poter{line_break}vincere...{page_break}Anche perché quest'anno{line_break}partecipiamo anche noi due!{end_wait}"

msgctxt "message"
msgid "06860"
msgstr "Siamo fortissimi! Arrivare{line_break}in finale sarà un gioco{line_break}da ragazzi!{page_break}Così, io e Ouranos{line_break}ci scontreremo nella{line_break}finale!{end_wait}"

msgctxt "message"
msgid "06861"
msgstr "È un grande mercante: è{line_break}riuscito a sfruttare questi{line_break}viaggi per fare affari.{page_break}Ha una marea di clienti!{end_wait}"

msgctxt "message"
msgid "06862"
msgstr "Ogni anno vanno tutti a{line_break}Tolbi per il Colossum.{line_break}È un appuntamento fisso...{end_wait}"

msgctxt "message"
msgid "06863"
msgstr "Le gite organizzate sono il{line_break}miglior modo per viaggiare.{line_break}È tutto già previsto!{end_wait}"

msgctxt "message"
msgid "06864"
msgstr "Chissà quale guerriero{line_break}vincerà al Colossum!{line_break}Voglio proprio vedere!{end_wait}"

msgctxt "message"
msgid "06865"
msgstr "Gli affari sono affari,{line_break}ma molti dei turisti{line_break}sono proprio{page_break}delle palle{line_break}al piede.{end_wait}"

msgctxt "message"
msgid "06866"
msgstr "Preparare questa gita{line_break}è stato davvero faticoso.{page_break}Non vedo l'ora di{line_break}essere a Tolbi per{line_break}riposarmi un po'...{end_wait}"

msgctxt "message"
msgid "06867"
msgstr "La notte scorsa non ho chiuso{line_break}occhio per l'agitazione.{line_break}Ma non devo perdere la calma!{page_break}Non devo far capire che{line_break}è la prima volta che{line_break}vado al Colossum...{end_wait}"

msgctxt "message"
msgid "06868"
msgstr "Quando vedo le lotte del{line_break}Colossum, mi ribolle il{line_break}sangue nelle vene!{end_wait}"

msgctxt "message"
msgid "06869"
msgstr "Il Colossum è... banale!{line_break}Cosa ci trovreranno di{line_break}tanto speciale...{end_wait}"

msgctxt "message"
msgid "06870"
msgstr "Voglio iscrivermi al{line_break}Colossum appena{line_break}arrivo a Tolbi.{page_break}Ma credo che tanti altri{line_break}avranno la mia stessa idea...{end_wait}"

msgctxt "message"
msgid "06871"
msgstr "Gli abitanti del continente{line_break}a sud di Angara hanno una{line_break}pelle molto abbronzata.{end_wait}"

msgctxt "message"
msgid "06872"
msgstr "Che emozione! È la{line_break}prima volta che{line_break}vedo Tolbi.{page_break}Dai, partiamo! Non vedo{line_break}l'ora di arrivare!{end_wait}"

msgctxt "message"
msgid "06873"
msgstr "Non è stato facile fuggire,{line_break}ma ne è valsa la pena: ora{line_break}potrò esmprimermi liberamente!{page_break}La libertà è{line_break}meravigliosa!{end_wait}"

msgctxt "message"
msgid "06874"
msgstr "Credo che a Tolbi{line_break}stia per iniziare{line_break}il Colossum...{page_break}Tutta questa concitazione{line_break}per un festival mi{line_break}sembra ridicola...{end_wait}"

msgctxt "message"
msgid "06875"
msgstr "Io ho la forza, Sean la{line_break}rapidità! Insieme non{line_break}abbiamo rivali!{end_wait}"

msgctxt "message"
msgid "06876"
msgstr "Siamo i guerrieri più{line_break}forti! Non perderemo{line_break}mai e poi mai.{end_wait}"

msgctxt "message"
msgid "06877"
msgstr "I partecipanti della gita{line_break}al Colossum sono partiti... Nella{line_break}locanda c'è un silenzio...{end_wait}"

msgctxt "message"
msgid "06878"
msgstr "Se n'è andato anche il{line_break}cuoco, quindi ci{line_break}tocca chiudere.{page_break}Pazienza... D'altronde{line_break}i clienti sono tutti al{line_break}Colossum...{end_wait}"

msgctxt "message"
msgid "06879"
msgstr "Come?!{pause_20_skippable} Il gruppo è{line_break}partito, e lui è{line_break}ancora qui!{end_wait}"

msgctxt "message"
msgid "06880"
msgstr "Siamo fuggiti qui dalle{line_break}terre del sud, ma questa{line_break}città è così strana...{page_break}Stanno tutti andando a un{line_break}festival chissà dove...{line_break}È incredibile!{end_wait}"

msgctxt "message"
msgid "06881"
msgstr "Siamo fuggiti dal{line_break}nordest del{line_break}continente del sud.{page_break}Non mi dispiace che se ne{line_break}siano andati tutti...{line_break}Anzi, è un sollievo!{end_wait}"

msgctxt "message"
msgid "06882"
msgstr "Si è lavorato poco... Avrei{line_break}fatto meglio a partecipare{line_break}alla gita al Colossum.{end_wait}"

msgctxt "message"
msgid "06883"
msgstr "Non avrei mai lasciato{line_break}andare mio marito al{line_break}Colossum...{page_break}Quello, se è solo, non{line_break}sai mai cosa ti{line_break}combina!{end_wait}"

msgctxt "message"
msgid "06884"
msgstr "Ora che se ne sono andati tutti{line_break}non riesco a rilassarmi...{line_break}E se tornassi indietro?{end_wait}"

msgctxt "message"
msgid "06885"
msgstr "Il Colossum è davvero{line_break}così grande come{line_break}dicono?{page_break}Ma...{pause_20_skippable} Che senso ha fuggire{line_break}da Lalivero per andare a Tolbi?{end_wait}"

msgctxt "message"
msgid "06886"
msgstr "Fuggendo da Lalivero, a{line_break}Gondowan, fino qui ad Angara{line_break}avevo una paura!{page_break}Ora inizio davvero ad{line_break}assaporare la libertà!{end_wait}"

msgctxt "message"
msgid "06887"
msgstr "Questo è il palazzo di Lord{line_break}Hammet.{pause_20_skippable} Il signore non c'è.{line_break}Devo pregarvi di andarvene.{end_wait}"

msgctxt "message"
msgid "06888"
msgstr "Appena Lord Hammet sarà{line_break}tornato saremo felici di{line_break}accogliere ospiti...{end_wait}"

msgctxt "message"
msgid "06889"
msgstr "Lascia fare a me...{end_wait}"

msgctxt "message"
msgid "06890"
msgstr "Sono io... {pause_20_skippable} Posso{line_break}vedere Lady Layana?{end_wait}"

msgctxt "message"
msgid "06891"
msgstr "Non mi riconoscete?{pause_20_skippable}{line_break}Sono {actor_name:3}, il servitore{line_break}di Lord Hammet!{end_wait}"

msgctxt "message"
msgid "06892"
msgstr "{actor_name:3}...{pause_20_skippable}?{end_wait}"

msgctxt "message"
msgid "06893"
msgstr "Sei così abbronzato che non{line_break}ti riconoscevo!{line_break}Ma sei davvero tu, {actor_name:3}!{end_wait}"

msgctxt "message"
msgid "06894"
msgstr "Ah, {actor_name:3}!{pause_20_skippable} Sei{line_break}cresciuto parecchio!{end_wait}"

msgctxt "message"
msgid "06895"
msgstr "Sono davvero{line_break}così cambiato?{end_now}"

msgctxt "message"
msgid "06896"
msgstr "Davvero?{pause_20_skippable} Stento a crederci...{line_break}A me non sembra che sia{line_break}trascorso tanto tempo...{end_wait}"

msgctxt "message"
msgid "06897"
msgstr "In fondo, tu non puoi saperlo.{line_break}Mi hai conosciuto soltanto dopo{line_break}che sono stato lasciato a Vault.{end_wait}"

msgctxt "message"
msgid "06898"
msgstr "Beh, che importa...{line_break}L'importante è che tu non sia{line_break}nelle mani dei ladri!{end_wait}"

msgctxt "message"
msgid "06899"
msgstr "Puoi dirci se anche{line_break}Lord Hammet sarà{line_break}presto liberato?{end_wait}"

msgctxt "message"
msgid "06900"
msgstr "Liberato?{line_break}Lord Hammet è{line_break}prigioniero?{end_wait}"

msgctxt "message"
msgid "06901"
msgstr ".{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}Non lo sai?{line_break}Allora dobbiamo{line_break}raccontarti tutto.{page_break}Ma è una questione privata.{line_break}Puoi chiedere ai tuoi{line_break}amici di allontanarsi?{end_now}"

msgctxt "message"
msgid "06902"
msgstr "No, {actor_name:1}! Non ci{line_break}sono segreti{line_break}tra di noi!{end_wait}"

msgctxt "message"
msgid "06903"
msgstr "Io e i miei compagni abbiamo{line_break}superato insieme così{line_break}tante difficoltà!{end_wait}"

msgctxt "message"
msgid "06904"
msgstr "Allora va bene...{line_break}Ma perché non eri{line_break}con Lord Hammet?{end_wait}"

msgctxt "message"
msgid "06905"
msgstr "Sono rimasto a Vault per{line_break}cercare il suo bastone rubato.{end_wait}"

msgctxt "message"
msgid "06906"
msgstr "Rubato? Qualcuno gli ha{line_break}rubato il bastone?{end_wait}"

msgctxt "message"
msgid "06907"
msgstr "Sì, il Bastone sciamanico.{pause_20_skippable}{line_break}Ma sono riuscito a{line_break}recuperarlo...{end_wait}"

msgctxt "message"
msgid "06908"
msgstr "Allora Lord Hammet è{line_break}ancora tenuto prigioniero{line_break}a Lunpa...{end_wait}"

msgctxt "message"
msgid "06909"
msgstr "Devo riferirlo subito{line_break}a Lady Layana!{end_wait}"

msgctxt "message"
msgid "06910"
msgstr "{actor_name:3}, vieni con me{line_break}da Lady Layana... Le{line_break}racconterai tutto tu.{end_wait}"

msgctxt "message"
msgid "06911"
msgstr "{actor_name:1}, hai visto{line_break}Lord Hammet allontanarsi{line_break}verso nord, vero?{end_now}"

msgctxt "message"
msgid "06912"
msgstr "Infatti, è{line_break}andato verso{line_break}Lunpa.{end_wait}"

msgctxt "message"
msgid "06913"
msgstr "No, intendo dire, il{line_break}giorno in cui Lord Hammet{line_break}andò a Lunpa...{end_wait}"

msgctxt "message"
msgid "06914"
msgstr "Lady Layana sarà sicuramente{line_break}felice di conoscere{line_break}tutta la storia.{page_break}Vieni con me e{line_break}raccontale{line_break}tutto.{end_wait}"

msgctxt "message"
msgid "06915"
msgstr "Quando ho saputo del tuo{line_break}arrivo, {actor_name:3}, per{line_break}un attimo ho sperato...{page_break}...che Lord Hammet{line_break}fosse con te.{end_wait}"

msgctxt "message"
msgid "06916"
msgstr "Noi pensavamo che{line_break}Lord Hammet fosse{line_break}stato liberato a Lunpa.{end_wait}"

msgctxt "message"
msgid "06917"
msgstr "Abbiamo mandato il riscatto{line_break}che ci avevano chiesto, quindi{line_break}dovrebbe tornare, giusto?{end_wait}"

msgctxt "message"
msgid "06918"
msgstr "Cosa sta succedendo a Lunpa{line_break}in questi giorni?{end_wait}"

msgctxt "message"
msgid "06919"
msgstr "Prima Lunpa è passata dalle{line_break}mani del suo fondatore, Lunpa,{line_break}il ladro nobile, in quelle{page_break}del figlio Donpa... Poi{line_break}il potere è passato al{line_break}nipote di Lunpa...{end_wait}"

msgctxt "message"
msgid "06920"
msgstr "Dodonpa è un uomo{line_break}davvero crudele.{page_break}Suo padre, Donpa, è{line_break}disperato per come stanno{line_break}andando le cose a Lunpa...{end_wait}"

msgctxt "message"
msgid "06921"
msgstr "Quando avete mandato il{line_break}denaro del riscatto?{end_wait}"

msgctxt "message"
msgid "06922"
msgstr "Vediamo...{pause_20_skippable} Prima c'è{line_break}stata l'eruzione...{end_wait}"

msgctxt "message"
msgid "06923"
msgstr "Subito dopo è arrivata{line_break}la richiesta{line_break}del riscatto.{end_wait}"

msgctxt "message"
msgid "06924"
msgstr "Abbiamo subito{line_break}mandato il denaro.{line_break}Lo ricordo bene.{end_wait}"

msgctxt "message"
msgid "06925"
msgstr "È passato parecchio{line_break}tempo dall'eruzione...{end_wait}"

msgctxt "message"
msgid "06926"
msgstr "È possibile che non abbiano{line_break}alcuna intenzione di lasciare{line_break}andare Lord Hammet?{end_now}"

msgctxt "message"
msgid "06927"
msgstr "Lo credi anche tu,{line_break}{actor_name:1}?{end_wait}"

msgctxt "message"
msgid "06928"
msgstr "Neanch'io vorrei{line_break}crederci,{pause_20_skippable} ma c'è{line_break}qualcosa di strano...{end_wait}"

msgctxt "message"
msgid "06929"
msgstr "Vuoi dire che Dodonpa non{line_break}lascerà andare Hammet!?{end_wait}"

msgctxt "message"
msgid "06930"
msgstr "{actor_name:3} ha ragione.{page_break}Se avessero voluto{line_break}liberarlo, a quest'ora{line_break}l'avrebbero già fatto.{end_wait}"

msgctxt "message"
msgid "06931"
msgstr "Mi spiace dirlo, Lady{line_break}Layana, ma temo che{line_break}{actor_name:3} abbia ragione.{end_wait}"

msgctxt "message"
msgid "06932"
msgstr "Cosa possiamo fare?{pause_20_skippable}{line_break}Come facciamo a{line_break}liberare Hammet?{end_wait}"

msgctxt "message"
msgid "06933"
msgstr "E se... {pause_20_skippable}Se gli succedesse{line_break}qualcosa, sarebbe orribile!{end_wait}"

msgctxt "message"
msgid "06934"
msgstr "Ci pensiamo noi!{end_wait}"

msgctxt "message"
msgid "06935"
msgstr "Mia signora, questo è{line_break}un compito per{line_break}l'esercito di Kalay!{end_wait}"

msgctxt "message"
msgid "06936"
msgstr "Sì, Lady Layana!{pause_20_skippable}{line_break}Lascia fare a noi!{end_wait}"

msgctxt "message"
msgid "06937"
msgstr "Ordina l'attacco e{line_break}noi obbediremo!{end_wait}"

msgctxt "message"
msgid "06938"
msgstr "Non posso farlo...{pause_20_skippable}{line_break}Non è una decisione da{line_break}prendere su due piedi...{end_wait}"

msgctxt "message"
msgid "06939"
msgstr "Come possiamo essere sicuri{line_break}che non accadrà nulla a Hammet{line_break}se attacchiamo Lunpa?!{end_wait}"

msgctxt "message"
msgid "06940"
msgstr "Non posso farlo.{pause_20_skippable} Non{line_break}posso mettere a rischio la{line_break}vita di Hammet...{end_wait}"

msgctxt "message"
msgid "06941"
msgstr "Non possiamo essere{line_break}d'aiuto in nessun modo?{end_now}"

msgctxt "message"
msgid "06942"
msgstr "Oh!{pause_20_skippable} Finalmente sei{line_break}d'accordo con{line_break}me, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "06943"
msgstr "Perché? Anche tu sai{line_break}che la vita di Hammet{line_break}è in pericolo!{end_wait}"

msgctxt "message"
msgid "06944"
msgstr "Di che state parlando{line_break}voi due?{end_wait}"

msgctxt "message"
msgid "06945"
msgstr "{actor_name:2} pensa che noi{line_break}potremmo essere d'aiuto.{end_wait}"

msgctxt "message"
msgid "06946"
msgstr "È troppo pericoloso...{pause_20_skippable}{line_break}Se fate un errore, anche la{line_break}vostra vita sarà in pericolo.{end_wait}"

msgctxt "message"
msgid "06947"
msgstr "E poi, avete già le{line_break}vostre missioni da{line_break}compiere, no?{end_now}"

msgctxt "message"
msgid "06948"
msgstr "Come pensavo...{line_break}È per questo che {actor_name:3}{line_break}è rimasto con voi, invece{page_break}di tornare direttamente{line_break}a casa dopo aver lasciato{line_break}Vault.{end_wait}"

msgctxt "message"
msgid "06949"
msgstr "Non ci credo...{line_break}{actor_name:3} non sarebbe{line_break}rimasto così a lungo con{page_break}voi se non aveste una{line_break}missione da compiere...{end_wait}"

msgctxt "message"
msgid "06950"
msgstr "Ma cosa accadrà{line_break}a Lord Hammet?{end_wait}"

msgctxt "message"
msgid "06951"
msgstr "Hammet è un ostaggio{line_break}prezioso per loro...{pause_20_skippable}{line_break}Non lo uccideranno.{end_wait}"

msgctxt "message"
msgid "06952"
msgstr "Dobbiamo attendere che arrivi{line_break}un altro messaggio da Lunpa.{end_wait}"

msgctxt "message"
msgid "06953"
msgstr "Lady Layana,{pause_20_skippable} Non posso{line_break}andare via così...{end_wait}"

msgctxt "message"
msgid "06954"
msgstr "Andrà tutto bene, {actor_name:3}.{pause_20_skippable}{line_break}Hammet non vorrebbe che{line_break}vi lasciaste distrarre da...{end_wait}"

msgctxt "message"
msgid "06955"
msgstr "Chiedo scusa... Ho{line_break}parlato troppo...{end_wait}"

msgctxt "message"
msgid "06956"
msgstr "Quindi Hammet sa della{line_break}nostra missione,{line_break}vero?{end_wait}"

msgctxt "message"
msgid "06957"
msgstr "Non posso continuare a{line_break}tenermi questo segreto...{end_wait}"

msgctxt "message"
msgid "06958"
msgstr "E va bene,{pause_20_skippable} ve lo{line_break}dirò.{pause_20_skippable}.{pause_20_skippable}.{page_break}Ha fatto un giuramento ad{line_break}un Adepto di Giove.{end_wait}"

msgctxt "message"
msgid "06959"
msgstr "Un Adepto di Giove!?{end_wait}"

msgctxt "message"
msgid "06960"
msgstr "Avete sentito parlare di un{line_break}villaggio chiamato Vale?{end_now}"

msgctxt "message"
msgid "06961"
msgstr "{text_effect:2} Voi siete{reset_text_style} di Vale?{line_break}Davvero? Ma allora la{line_break}profezia era vera!{end_wait}"

msgctxt "message"
msgid "06962"
msgstr "Ehi, come fai a{line_break}conoscere Vale!? È la{line_break}nostra città natale!{end_wait}"

msgctxt "message"
msgid "06963"
msgstr "Siete di Vale?{line_break}Davvero? Ma allora la{line_break}profezia era vera.{end_wait}"

msgctxt "message"
msgid "06964"
msgstr "Che profezia?{end_wait}"

msgctxt "message"
msgid "06965"
msgstr "Tre anni dopo l'orribile{line_break}tempesta sul Monte Aleph...{end_wait}"

msgctxt "message"
msgid "06966"
msgstr "{actor_name:3} dovrà partire{line_break}per un'avventura con dei{line_break}guerrieri di Vale...{page_break}Era questa la profezia.{end_wait}"

msgctxt "message"
msgid "06967"
msgstr "Non sapevo nulla di{line_break}una simile profezia.{end_wait}"

msgctxt "message"
msgid "06968"
msgstr "Accadde molti anni prima che{line_break}Hammet fondasse Kalay...{page_break}Si trovava in viaggio.{end_wait}"

msgctxt "message"
msgid "06969"
msgstr "All'epoca, Hammet pensava{line_break}che alla sua carriera di{line_break}mercante servisse una spinta.{end_wait}"

msgctxt "message"
msgid "06970"
msgstr "Così, era partito per una{line_break}rischiosa avventura alla{line_break}ricerca di nuovi commerci...{end_wait}"

msgctxt "message"
msgid "06971"
msgstr "Si trovava in pericolo di vita{line_break}nell'angolo sudoccidentale{line_break}del mondo... Allora{page_break}alcuni Adepti gli{line_break}salvarono{line_break}la vita.{end_wait}"

msgctxt "message"
msgid "06972"
msgstr "Aveva perso conoscenza.{line_break}Quando si risvegliò si{line_break}ritrovò nel loro villaggio.{end_wait}"

msgctxt "message"
msgid "06973"
msgstr "Un momento... Io provengo{line_break}da quel villaggio?{end_wait}"

msgctxt "message"
msgid "06974"
msgstr "Sì.{pause_20_skippable} L'Adepto gli diede il{line_break}Bastone sciamanico e{pause_20_skippable} te...{line_break}insieme ad alcuni dobloni.{end_wait}"

msgctxt "message"
msgid "06975"
msgstr "Dobloni...{pause_20_skippable}{pause_20_skippable} Erano{line_break}{pause_20_skippable}dobloni d'oro?{end_wait}"

msgctxt "message"
msgid "06976"
msgstr "Sì...{pause_20_skippable} Dunque...{line_break}Tu ti chiami...{end_wait}"

msgctxt "message"
msgid "06977"
msgstr "Io sono {actor_name:4}, Lady Layana.{end_wait}"

msgctxt "message"
msgid "06978"
msgstr "Un mucchio d'oro, {actor_name:4}!{pause_20_skippable}{line_break}Insieme ricevette anche dei{line_break}consigli per i suoi commerci.{end_wait}"

msgctxt "message"
msgid "06979"
msgstr "Dei consigli? Ad Hammet?{line_break}Il più grande commerciante{line_break}di tutti i tempi?{end_wait}"

msgctxt "message"
msgid "06980"
msgstr "Sì, {actor_name:2}{pause_20_skippable}. Hammet{line_break}deve ringraziare gli Adepti{line_break}per il suo successo.{end_wait}"

msgctxt "message"
msgid "06981"
msgstr "Ehi... Non ho mai sentito{line_break}nulla del genere...{end_wait}"

msgctxt "message"
msgid "06982"
msgstr "Gli consigliarono di comprare{line_break}della seta a Xian e di{line_break}rivenderla a Tolbi.{end_wait}"

msgctxt "message"
msgid "06983"
msgstr "Quel commercio gli andò{line_break}così bene che gli parve{line_break}d'aver realizzato un sogno.{end_wait}"

msgctxt "message"
msgid "06984"
msgstr "È allora che Hammet divenne{line_break}il grande mercante che{line_break}è ancora oggi.{end_wait}"

msgctxt "message"
msgid "06985"
msgstr "Promise qualcosa agli Adepti{line_break}in cambio di quei piaceri?{end_wait}"

msgctxt "message"
msgid "06986"
msgstr "Beh, sì, {actor_name:3}...{pause_20_skippable}{line_break}È qualcosa che vi servirà{line_break}per il vostro viaggio.{end_wait}"

msgctxt "message"
msgid "06987"
msgstr "Qualcosa che ci servirà{line_break}per il viaggio...{end_wait}"

msgctxt "message"
msgid "06988"
msgstr "Uno degli Adepti chiese{line_break}a Hammet di usare il Bastone{line_break}sciamanico per ottenerlo.{end_wait}"

msgctxt "message"
msgid "06989"
msgstr "Cercò l'oggetto{line_break}ovunque...{page_break}Ma senza{line_break}trovarlo.{end_wait}"

msgctxt "message"
msgid "06990"
msgstr "Poi , tre anni fa, ci fu una{line_break}tempesta che colpì soltanto{line_break}il Monte Aleph...{end_wait}"

msgctxt "message"
msgid "06991"
msgstr "Hammet era preoccupato{pause_20_skippable}{pause_20_skippable} che{line_break}il tempo{pause_20_skippable} stesse scadendo...{end_wait}"

msgctxt "message"
msgid "06992"
msgstr "Ma poi riuscì{line_break}a trovare{line_break}un indizio.{end_wait}"

msgctxt "message"
msgid "06993"
msgstr "È per questo, {actor_name:3}, che{line_break}ha portato anche te nell'ultimo{line_break}viaggio verso nord.{end_wait}"

msgctxt "message"
msgid "06994"
msgstr "Non lo sapevo...{pause_20_skippable} È per{line_break}questo che mi aveva lasciato il{line_break}Bastone sciamanico.{pause_20_skippable}{pause_20_skippable} Ma allora...{end_wait}"

msgctxt "message"
msgid "06995"
msgstr "No, {actor_name:3}...{pause_20_skippable} Non devi{line_break}pensare che sia colpa tua...{end_wait}"

msgctxt "message"
msgid "06996"
msgstr "Il bastone fu rubato a{line_break}a causa della mia{line_break}negligenza. Quindi, è colpa{page_break}mia se Lord Hammet{line_break}si trova in prigione{line_break}a Lunpa...{end_wait}"

msgctxt "message"
msgid "06997"
msgstr "Devi continuare il viaggio{line_break}e concludere la tua{line_break}missione.{page_break}Ora non serve che tu ti{line_break}senta colpevole.{end_wait}"

msgctxt "message"
msgid "06998"
msgstr "Ma che accadrà{line_break}a Hammet?{end_wait}"

msgctxt "message"
msgid "06999"
msgstr "Ci penserò io.{end_wait}"

msgctxt "message"
msgid "07000"
msgstr "E non dimenticare i{line_break}soldati di Kalay!{end_wait}"

msgctxt "message"
msgid "07001"
msgstr "Continua il tuo viaggio{line_break}e non ti preoccupare{line_break}per Hammet!{end_wait}"

msgctxt "message"
msgid "07002"
msgstr "Scusate se non posso{line_break}dire di più sul{line_break}Bastone sciamanico...{end_wait}"

msgctxt "message"
msgid "07003"
msgstr "No,{pause_20_skippable} non scusarti...{end_wait}"

msgctxt "message"
msgid "07004"
msgstr "Il Bastone sciamanico ci aiuterà{line_break}a trovare ciò che ci serve{line_break}per la nostra missione, giusto?{end_wait}"

msgctxt "message"
msgid "07005"
msgstr "Lo cercherai?{end_now}"

msgctxt "message"
msgid "07006"
msgstr "Se {actor_name:1} ti dà{line_break}la sua parola, non{line_break}devi preoccuparti!{end_wait}"

msgctxt "message"
msgid "07007"
msgstr "Che ti succede,{line_break}{actor_name:1}? Hai dimenticato{line_break}perché siamo qui?{end_wait}"

msgctxt "message"
msgid "07008"
msgstr "Se ne abbiamo bisogno per{line_break}la missione, prima o poi{line_break}dovremo ben trovarlo!{end_wait}"

msgctxt "message"
msgid "07009"
msgstr "Bene, allora...{pause_20_skippable} Siate{line_break}prudenti.{end_wait}"

msgctxt "message"
msgid "07010"
msgstr "Che ognuno ritorni{line_break}al proprio posto!{end_wait}"

msgctxt "message"
msgid "07011"
msgstr "Dodonpa è molto astuto...{line_break}Potrebbe avere spie{line_break}ovunque a Kalay.{page_break}Non possiamo correre il rischio{line_break}di mandare soldati, per ora.{end_wait}"

msgctxt "message"
msgid "07012"
msgstr "La popolazione non sa nulla{line_break}di ciò che è successo a{line_break}Lord Hammet, vero?{end_wait}"

msgctxt "message"
msgid "07013"
msgstr "Lord Hammet verrà liberato{line_break}presto, vero?{end_now}"

msgctxt "message"
msgid "07014"
msgstr "Lo spero davvero. Altrimenti{line_break}Layana morirà di{line_break}crepacuore...{end_wait}"

msgctxt "message"
msgid "07015"
msgstr "A volte sarebbe meglio{line_break}una pietosa bugia...{end_wait}"

msgctxt "message"
msgid "07016"
msgstr "Davanti alla gente,{line_break}Layana cerca di{line_break}farsi coraggio.{page_break}È dura vederla in{line_break}queste condizioni.{end_wait}"

msgctxt "message"
msgid "07017"
msgstr "Le leggi di Angara{line_break}proteggono i{line_break}mercanti.{page_break}Dodonpa è davvero malvagio{line_break}per violare quelle leggi!{end_wait}"

msgctxt "message"
msgid "07018"
msgstr "E così il commercio di seta{line_break}inaugurato da Hammet{line_break}è finito?{end_now}"

msgctxt "message"
msgid "07019"
msgstr "Non puoi dire questo!{line_break}Lady Layana sarebbe{line_break}distrutta da queste parole!{end_wait}"

msgctxt "message"
msgid "07020"
msgstr "È vero. Non avrei dovuto{line_break}dire una cosa simile.{line_break}Ora sto malissimo...{end_wait}"

msgctxt "message"
msgid "07021"
msgstr "Sarà la decisione giusta,{line_break}Hammet?{line_break}O sto facendo un errore?{end_wait}"

msgctxt "message"
msgid "07022"
msgstr "Credo proprio che il{line_break}villaggio cadrebbe nel panico{line_break}se sapesse di Hammet.{page_break}Non dobbiamo farci{line_break}sfuggire una parola...{end_wait}"

msgctxt "message"
msgid "07023"
msgstr "Sono tutti preoccupati per{line_break}Lord Hammet, ma nessuno{line_break}lo dice apertamente.{page_break}Se non fosse liberato, sarebbe{line_break}la fine per Kalay...{end_wait}"

msgctxt "message"
msgid "07024"
msgstr "La notte scorsa Lady Layana{line_break}stava di nuovo piangendo.{page_break}Vorrei davvero poter{line_break}fare qualcosa per lei.{end_wait}"

msgctxt "message"
msgid "07025"
msgstr "E pensare che...{line_break}Stavo per partire insieme{line_break}a Hammet!{end_wait}"

msgctxt "message"
msgid "07026"
msgstr "Lord Hammet è una leggenda{line_break}tra i mercanti. Kalay non può{line_break}sopravvivere senza di lui.{end_wait}"

msgctxt "message"
msgid "07027"
msgstr "{actor_name:1}{pause_20_skippable}, sei entrato{line_break}di nascosto a Lunpa? Ma{line_break}è pericolosissimo!{end_wait}"

msgctxt "message"
msgid "07028"
msgstr "Ma{pause_20_skippable} Mi fa piacere{line_break}sapere che Hammet{line_break}sta bene.{end_wait}"

msgctxt "message"
msgid "07029"
msgstr "Grazie, {actor_name:1}...{pause_20_skippable}{line_break}Ma non andare più{line_break}a Lunpa!{end_wait}"

msgctxt "message"
msgid "07030"
msgstr "Porta a termine la missione,{line_break}ti prego!{end_wait}"

msgctxt "message"
msgid "07031"
msgstr "Dodonpa vuole usare Hammet{line_break}per estorcere a Kalay{line_break}fino all'ultimo centesimo!{page_break}Finché non recuperiamo{line_break}Hammet, siamo costretti{line_break}ad accontentarlo.{end_wait}"

msgctxt "message"
msgid "07032"
msgstr "Non mi importa dei soldi{line_break}l'importante è che Hammet{line_break}torni a casa sano e salvo...{end_wait}"

msgctxt "message"
msgid "07033"
msgstr "I soldati di Kalay{line_break}si occuperanno del{line_break}problema qui.{page_break}Voi dovete proseguire{line_break}nella vostra missione,{line_break}come ha detto Lady Layana.{end_wait}"

msgctxt "message"
msgid "07034"
msgstr "Ci occuperemo noi di{line_break}questo rapimento,{line_break}non preoccupatevi.{page_break}Voi continuate la {line_break}vostra missione.{end_wait}"

msgctxt "message"
msgid "07035"
msgstr "Ho paura per Hammet, ma{line_break}Lady Layana insiste che è{line_break}meglio non fare nulla.{page_break}Posso solo sperare che non{line_break}gli sia successo nulla...{end_wait}"

msgctxt "message"
msgid "07036"
msgstr "I guerrieri di Kalay{line_break}salveranno Lord Hammet{line_break}a tutti i costi.{end_wait}"

msgctxt "message"
msgid "07037"
msgstr "I turisti che erano nella{line_break}locanda andavano{line_break}a vedere il Colossum.{page_break}Tutte queste storie {line_break}per un festival a Tolbi!{line_break}Non capisco proprio...{end_wait}"

msgctxt "message"
msgid "07038"
msgstr "Che c'è?{line_break}Volete entrare a Lunpa?{end_now}"

msgctxt "message"
msgid "07039"
msgstr "Beh, non potete!{line_break}Tornatevene da dove{line_break}siete venuti!{end_wait}"

msgctxt "message"
msgid "07040"
msgstr "Siete venuti fin qui per{line_break}nulla? Non ha molto{line_break}senso...{page_break}Beh, Lunpa non è il posto{line_break}adatto per gente come voi!{line_break}Tornatevene indietro!{end_wait}"

msgctxt "message"
msgid "07041"
msgstr "Non siete di Kalay,{pause_20_skippable}{line_break}vero?{end_now}"

msgctxt "message"
msgid "07042"
msgstr "Anche l'altro gruppo{line_break}ha detto la stessa cosa,{line_break}e non ci siamo fidati.{page_break}Andatevene prima di{line_break}farvi male!{end_wait}"

msgctxt "message"
msgid "07043"
msgstr "Non siete qui per{line_break}salvare Hammet,{pause_20_skippable} vero?{end_now}"

msgctxt "message"
msgid "07044"
msgstr "Ve lo restituiremo{line_break}presto... Portate solo{line_break}un po' di pazienza...{page_break}Dodonpa ci ha ordinato di{line_break}dire così.{end_wait}"

msgctxt "message"
msgid "07045"
msgstr "Avanti! Chi verrebbe a{line_break}Lunpa se non per{line_break}salvare Hammet?{page_break}Non fatemi arrabbiare,{line_break}per favore non{line_break}fatemi arrabbiare!!!{end_wait}"

msgctxt "message"
msgid "07046"
msgstr "Mi chiedo se quei ragazzi{line_break}cercheranno di entrare dalla{line_break}grotta ad ovest della città...{page_break}Beh, il cancello è troppo{line_break}pesante per loro, quindi non{line_break}dobbiamo preoccuparci!{end_wait}"

msgctxt "message"
msgid "07047"
msgstr "Anche se entrassero nella{line_break}grotta non potrebbero{line_break}comunque entrare in città.{page_break}Il cancello della grotta{line_break}si può aprire soltanto dalla{line_break}parte opposta.{end_wait}"

msgctxt "message"
msgid "07048"
msgstr "Sei stato a Lunpa{line_break}per molto tempo?{end_now}"

msgctxt "message"
msgid "07049"
msgstr "Beh... La tua faccia non{line_break}mi è familiare... Forse{line_break}perché sei un po' anonimo...{end_wait}"

msgctxt "message"
msgid "07050"
msgstr "Ah, quindi sei un{line_break}nuovo uomo della{line_break}banda di Dodonpa!{end_wait}"

msgctxt "message"
msgid "07051"
msgstr "Da quando la carovana è{line_break}giunta al villaggio non{line_break}abiamo più libertà.{page_break}Nessuno può entrare o uscire{line_break}dal villaggio...{line_break}È davvero tremendo...{end_wait}"

msgctxt "message"
msgid "07052"
msgstr "È vero che Dodonpa ha{line_break}rapito Hammet per{line_break}estorcergli un riscatto?{end_now}"

msgctxt "message"
msgid "07053"
msgstr "Allora gli uomini di{line_break}Dodonpa dicevano{line_break}la verità.{end_wait}"

msgctxt "message"
msgid "07054"
msgstr "Infatti... Neppure Dodonpa{line_break}farebbe una cosa{line_break}così orribile.{end_wait}"

msgctxt "message"
msgid "07055"
msgstr "Donpa è troppo vecchio{line_break}per governare, così tutti{line_break}obbediscono a Dodonpa.{end_wait}"

msgctxt "message"
msgid "07056"
msgstr "Lunpa, il ladro nobile, e{line_break}Donpa, suo figlio. Loro sì{line_break}che erano grandi capi!{end_wait}"

msgctxt "message"
msgid "07057"
msgstr "Donpa non ha idea di ciò{line_break}che Dodonpa sta facendo.{page_break}Il villaggio cambierebbe se{line_break}Donpa sapesse cosa sta{line_break}combinando Dodonpa...{end_wait}"

msgctxt "message"
msgid "07058"
msgstr "Volete vedere Donpa?{end_now}"

msgctxt "message"
msgid "07059"
msgstr "Donpa è nella fortezza.{line_break}Se volete vederlo,{line_break}dovete andare là.{page_break}Ma nella fortezza vi sono{line_break}parecchie guardie.{end_wait}"

msgctxt "message"
msgid "07060"
msgstr "Pensavo di no...{line_break}Non si può vedere{line_break}Donpa ora.{end_wait}"

msgctxt "message"
msgid "07061"
msgstr "Il cuoco della locanda va{line_break}spesso a consegnare il{line_break}cibo nella fortezza.{page_break}Dice che nella fortezza{line_break}vi sono moltissime{line_break}guardie.{end_wait}"

msgctxt "message"
msgid "07062"
msgstr "Non avvicinatevi.{end_wait}"

msgctxt "message"
msgid "07063"
msgstr "Come può Dodonpa essere{line_break}così cattivo?{page_break}Stento a credere che sia{line_break}il figlio di Donpa.{end_wait}"

msgctxt "message"
msgid "07064"
msgstr "Neppure un topolino potrebbe{line_break}intrufolarsi nella fortezza{line_break}mentre sono di guardia!{end_wait}"

msgctxt "message"
msgid "07065"
msgstr "Con tutte quelle guardie,{line_break}non credo che sia facile{line_break}entrare a Lunpa!{end_wait}"

msgctxt "message"
msgid "07066"
msgstr "È davvero strano che Hammet{line_break}sia venuto qui per{line_break}farsi catturare.{end_wait}"

msgctxt "message"
msgid "07067"
msgstr "Dopo aver ricevuto il{line_break}riscatto devono liberare{line_break}gli ostaggi, comunque sia.{page_break}Ma la carovana dei mercanti{line_break}non è ancora ripartita.{line_break}Che sta succedendo?!{end_wait}"

msgctxt "message"
msgid "07068"
msgstr "Lunpa morì quando Donpa era{line_break}ancora giovane. Così Donpa{line_break}diventò grande da solo...{page_break}Dicono che sia per questo che{line_break}viziò Dodonpa così tanto...{line_break}Davvero un grave errore!{end_wait}"

msgctxt "message"
msgid "07069"
msgstr "Come può Dodonpa{line_break}vivere in questo{line_break}modo?{page_break}Dovrebbe dare a noi{line_break}poveri i soldi{line_break}che ottiene.{end_wait}"

msgctxt "message"
msgid "07070"
msgstr "Dodonpa tiene suo padre{line_break}Donpa nascosto nella fortezza,{line_break}in modo che non possa{page_break}scoprire le{line_break}malefatte{line_break}del figlio.{end_wait}"

msgctxt "message"
msgid "07071"
msgstr "La fortezza è sorvegliata{line_break}tutto il giorno.{page_break}Nessuno può andare{line_break}a trovare{line_break}Donpa.{end_wait}"

msgctxt "message"
msgid "07072"
msgstr "Il cuoco mi ha detto che la{line_break}fortezza è così spaventosa che{line_break}ha sempre paura a tornarci.{end_wait}"

msgctxt "message"
msgid "07073"
msgstr "Dodonpa è un genio!{line_break}È stato furbo a non{line_break}liberare Hammet...{page_break}Così, può continuare{line_break}ad estorcere soldi{line_break}a Kalay.{end_wait}"

msgctxt "message"
msgid "07074"
msgstr "Neppure un'ombra può{line_break}passare di qui!{end_wait}"

msgctxt "message"
msgid "07075"
msgstr "Il mio povero nonno ha{line_break}viaggiato per tutto{line_break}il continente con Lunpa.{page_break}Sarebbe tristissimo se{line_break}sapesse cosa sta{line_break}combinando Dodonpa.{end_wait}"

msgctxt "message"
msgid "07076"
msgstr "Vivremo anche a Lunpa,{line_break}ma non lavoreremo mai{line_break}per Dodonpa.{end_wait}"

msgctxt "message"
msgid "07077"
msgstr "Un tempo Lunpa era un buon{line_break}posto: ora non più.{end_wait}"

msgctxt "message"
msgid "07078"
msgstr "Continuano a spingerci a{line_break}lavorare per Dodonpa!{line_break}Che nervoso!{end_wait}"

msgctxt "message"
msgid "07079"
msgstr "La fortezza fu fatta{line_break}costruire da Donpa.{page_break}È così ben concepita che{line_break}non potrebbe intrufolarvisi{line_break}neppure una formica.{end_wait}"

msgctxt "message"
msgid "07080"
msgstr "Il cuoco della locanda è{line_break}l'unico in città che può{line_break}entrare nella fortezza.{end_wait}"

msgctxt "message"
msgid "07081"
msgstr "La fortezza è costruita{line_break}in modo che le guardie{line_break}possano vedere tutto.{end_wait}"

msgctxt "message"
msgid "07082"
msgstr "Dopo che la{line_break}carovana fu{line_break}catturata...{page_break}Fecero richiesta{line_break}di un cuoco dentro{line_break}alla fortezza.{end_wait}"

msgctxt "message"
msgid "07083"
msgstr "Lunpa morì durante{line_break}una grande inondazione,{line_break}molti anni fa.{page_break}Andò a sud{pause_20_skippable}...{line_break}...e dopo l'inondazione{line_break}nessuno lo rivide più.{end_wait}"

msgctxt "message"
msgid "07084"
msgstr "Lunpa morì vittima di una{line_break}grande inondazione, mentre{line_break}viaggiava con un certo Babi.{end_wait}"

msgctxt "message"
msgid "07085"
msgstr "L'inondazione fece{line_break}molte vittime in{line_break}tutto il continente.{end_wait}"

msgctxt "message"
msgid "07086"
msgstr "Ma che nome{line_break}è Babi?{end_wait}"

msgctxt "message"
msgid "07087"
msgstr "Il villaggio è chiuso,{line_break}quindi non possiamo{line_break}vendere né acquistare.{page_break}A Dodonpa non importa nulla{line_break}dei miei affari.{end_wait}"

msgctxt "message"
msgid "07088"
msgstr "Appena riapre il villaggio{line_break}potrò vendervi tutte le{line_break}armature che desiderate.{end_wait}"

msgctxt "message"
msgid "07089"
msgstr "Hanno i magazzini{line_break}pieni, per questo{line_break}resistono. Ma mi{page_break}dispiace per tutti{line_break}gli affari che{line_break}stanno perdendo.{end_wait}"

msgctxt "message"
msgid "07090"
msgstr "Vuoi dormire{line_break}qui?{end_now}"

msgctxt "message"
msgid "07091"
msgstr "Stai scherzando!{line_break}Ma vai a dormire{line_break}a casa tua!{end_wait}"

msgctxt "message"
msgid "07092"
msgstr "Ah, lo sapevo... {line_break}Non ci sono viaggiatori{line_break}in città...{end_wait}"

msgctxt "message"
msgid "07093"
msgstr "Per Dodonpa è stata una{line_break}gran fortuna{line_break}catturare Hammet,{page_break}ma non gliene importa{line_break}nulla della sorte{line_break}dei cittadini di Lunpa.{end_wait}"

msgctxt "message"
msgid "07094"
msgstr "A che serve pulire{line_break}il locale e aspettare{line_break}i clienti?{page_break}Tanto non viene nessuno.{end_wait}"

msgctxt "message"
msgid "07095"
msgstr "Vuoi sapere come ho{line_break}consegnato il cibo{line_break}nella fortezza?{end_now}"

msgctxt "message"
msgid "07096"
msgstr "Bendato, mi hanno fatto{line_break}percorrere una strada fredda.{line_break}Ho camminato per un po'...{page_break}Sentivo l'eco dei passi,{line_break}quindi credo che fosse un{line_break}passaggio sotterraneo.{end_wait}"

msgctxt "message"
msgid "07097"
msgstr "Quando sono tornato al{line_break}villaggio ero così{line_break}felice!{page_break}A chi ho consegnato{line_break}il cibo? Credo che si{line_break}chiamasse Hammet.{end_wait}"

msgctxt "message"
msgid "07098"
msgstr "Devo continuare a resistere.{line_break}Non chiuderò la locanda finché{line_break}il villaggio non sarà libero!{end_wait}"

msgctxt "message"
msgid "07099"
msgstr "A Dodonpa importa{line_break}solo di sé stesso.{line_break}È fatto così...{end_wait}"

msgctxt "message"
msgid "07100"
msgstr "Andando avanti così{line_break}mi licenzieranno in{line_break}pochissimo tempo...{end_wait}"

msgctxt "message"
msgid "07101"
msgstr "Mi spiace per quel{line_break}pover'uomo che tengono{line_break}lassù nella prigione...{end_wait}"

msgctxt "message"
msgid "07102"
msgstr "Il ladro Dodonpa è un{line_break}uomo terribile.{page_break}Ma non possiamo farne una{line_break}colpa alla gente di Lunpa.{line_break}Anzi, loro sono vittime.{end_wait}"

msgctxt "message"
msgid "07103"
msgstr "Non possiamo lasciare Lunpa.{line_break}Gli uomini di Dodonpa{line_break}fanno la guardia.{end_wait}"

msgctxt "message"
msgid "07104"
msgstr "Se le cose non cambiano,{line_break}presto dovrò chiudere{line_break}il negozio...{end_wait}"

msgctxt "message"
msgid "07105"
msgstr "Avrei dovuto comprare{line_break}più merce quando{line_break}potevo...{end_wait}"

msgctxt "message"
msgid "07106"
msgstr "Avevo comprato parecchia{line_break}merce, ma sono già{line_break}quasi rimasta a secco...{end_wait}"

msgctxt "message"
msgid "07107"
msgstr "Questa è Lunpa. Senza{line_break}l'autorizzazione di Dodonpa{line_break}non si può entrare.{end_wait}"

msgctxt "message"
msgid "07108"
msgstr "Se qualche straniero creasse{line_break}problemi al villaggio,{page_break}Dodonpa ce ne riterrebbe{line_break}responsabili.{end_wait}"

msgctxt "message"
msgid "07109"
msgstr "Ehi,{pause_20_skippable} ma tu sei{line_break}{actor_name:1}! Sei tornato{line_break}a casa, eh?{end_wait}"

msgctxt "message"
msgid "07110"
msgstr "Questa è Vale!{pause_20_skippable}{line_break}Beh, penso che tu lo sappia{line_break}già, vero, {actor_name:1}?{end_wait}"

msgctxt "message"
msgid "07111"
msgstr "Oh, {actor_name:1}!{line_break}Sei tornato prima{line_break}del previsto!{end_wait}"

msgctxt "message"
msgid "07112"
msgstr "Vedo che ti sei fatto{line_break}degli amici durante i tuoi{line_break}viaggi, {actor_name:1}.{page_break}Mi fa piacere.{end_wait}"

msgctxt "message"
msgid "07113"
msgstr "Dopo l'eruzione del Monte{line_break}Aleph, l'acqua del fiume{line_break}diventò così calda...{page_break}Tutti pensavano che fossero{line_break}le sorgenti calde della{line_break}montagna, ma poi il{page_break}fiume diventò di nuovo{line_break}freddo.{end_wait}"

msgctxt "message"
msgid "07114"
msgstr "Hai avuto esperienze{line_break}interessanti nel viaggio,{line_break}{actor_name:1}?{end_now}"

msgctxt "message"
msgid "07115"
msgstr "No? Davvero? Leggo nei{line_break}tuoi occhi che non stai{line_break}dicendo la verità...{end_wait}"

msgctxt "message"
msgid "07116"
msgstr "Oh, davvero? Chissà come{line_break}ti sarai divertito!{page_break}Nel prossimo viaggio mi{line_break}porti con te?{end_now}"

msgctxt "message"
msgid "07117"
msgstr "Ah, davvero?{page_break}Stavo scherzando!{line_break}Non essere{line_break}troppo gentile!{end_wait}"

msgctxt "message"
msgid "07118"
msgstr "Lo sapevo... Sapevo che{line_break}avresti detto di no...{end_wait}"

msgctxt "message"
msgid "07119"
msgstr "Ehi! {actor_name:1}!{line_break}Com'è andata?{end_wait}"

msgctxt "message"
msgid "07120"
msgstr "Bentornato, {actor_name:1}!{line_break}È bello riaverti{line_break}a casa!{end_wait}"

msgctxt "message"
msgid "07121"
msgstr "Vedo che ti sei fatto molti{line_break}amici nella tua avventura.{page_break}Come vorrei essere{line_break}come te, {actor_name:1}.{end_wait}"

msgctxt "message"
msgid "07122"
msgstr "L'eruzione ha scombinato{line_break}l'altro lato del{line_break}Monte Aleph.{end_wait}"

msgctxt "message"
msgid "07123"
msgstr "L'eruzione ha aperto una{line_break}crepa sul lato nordovest{line_break}del Monte Aleph.{end_wait}"

msgctxt "message"
msgid "07124"
msgstr "Che sorpresa, {actor_name:1}!{line_break}Sei tornato prima{line_break}del previsto!{end_wait}"

msgctxt "message"
msgid "07125"
msgstr "{actor_name:1} è cresciuto{line_break}così tanto in breve tempo...{line_break}Ha un aspetto favoloso...{end_wait}"

msgctxt "message"
msgid "07126"
msgstr "Interessanti i nuovi{line_break}amici di {actor_name:1}!{page_break}Chissà se sono Adepti{line_break}come noi?{end_wait}"

msgctxt "message"
msgid "07127"
msgstr "Pensa che potenza hanno{line_break}le eruzioni, se possono{line_break}riscaldare un fiume!{end_wait}"

msgctxt "message"
msgid "07128"
msgstr "Ho l'impressione che il Monte{line_break}Aleph non sia l'unico posto{line_break}dove capitano cose strane.{page_break}Dev'essere difficile{line_break}attraversare{line_break}il continente.{end_wait}"

msgctxt "message"
msgid "07129"
msgstr "Ehi! Quando sei tornato{line_break}a Vale, {actor_name:1}?{end_wait}"

msgctxt "message"
msgid "07130"
msgstr "Chissà se possiamo di nuovo{line_break}giocare con {actor_name:1} e i{line_break}suoi compagni, come un tempo.{end_wait}"

msgctxt "message"
msgid "07131"
msgstr "Anch'io voglio partire{line_break}per un viaggio e farmi{line_break}nuovi amici!{end_wait}"

msgctxt "message"
msgid "07132"
msgstr "L'altro lato del Monte Aleph{line_break}è stato tutto bruciato da{line_break}una colata di lava.{end_wait}"

msgctxt "message"
msgid "07133"
msgstr "La crepa sul lato nordovest{line_break}del Monte Aleph si fa sempre{line_break}più ampia.{page_break}Di questo passo, l'intero{line_break}continente si dividerà in due!{end_wait}"

msgctxt "message"
msgid "07134"
msgstr "Il sentiero per il Tempio{line_break}di Sol è ancora chiuso.{page_break}Verrà aperto quando{line_break}finirà del tutto l'attività{line_break}del vulcano.{end_wait}"

msgctxt "message"
msgid "07135"
msgstr "{actor_name:1}, anche i tuoi{line_break}nuovi amici sono Adepti,{line_break}per caso?{end_now}"

msgctxt "message"
msgid "07136"
msgstr "Quindi, non sono solo quelli{line_break}di Vale a possedere{line_break}la Psinergia!{end_wait}"

msgctxt "message"
msgid "07137"
msgstr "......"

msgctxt "message"
msgid "07138"
msgstr "......"

msgctxt "message"
msgid "07139"
msgstr "I tuoi amici sembrano{line_break}contrariati dalle tue{line_break}parole, {actor_name:1}...{page_break}Ciò significa...{line_break}...che {text_effect:2}sono{reset_text_style} Adepti!{end_wait}"

msgctxt "message"
msgid "07140"
msgstr "Com'è che Adepti{line_break}diversi hanno{line_break}poteri diversi?{page_break}Forse è perché alcuni{line_break}meditano di più, come{line_break}il Gran Guaritore?{end_wait}"

msgctxt "message"
msgid "07141"
msgstr "Sarà difficile raggiungere il{line_break}Tempio di Sol finché il{line_break}Monte Aleph non si placa.{end_wait}"

msgctxt "message"
msgid "07142"
msgstr "Vedo che tra i compagni{line_break}di viaggio di {actor_name:1}{line_break}c'è una bella ragazza.{page_break}Chissà cosa{line_break}ne penserà{line_break}{actor_name:6}.{end_wait}"

msgctxt "message"
msgid "07143"
msgstr "Non è giusto... Voglio{line_break}aumentare la mia Psinergia,{line_break}ma senza fare fatica!{end_wait}"

msgctxt "message"
msgid "07144"
msgstr "Oh, {pause_20_skippable}sei tu, {actor_name:1}.{line_break}Sei ritornato?{end_now}"

msgctxt "message"
msgid "07145"
msgstr "Ora scatenerai un{line_break}putiferio a Vale...{page_break}Ma mi fa enorme piacere!{line_break}E  tua madre Dora sarà{line_break}ancora più felice!{end_wait}"

msgctxt "message"
msgid "07146"
msgstr "Ah, sei solo di passaggio?{line_break}Questo mi dispiace...{end_wait}"

msgctxt "message"
msgid "07147"
msgstr "Mi avevano detto del tuo{line_break}ritorno... Allora è{line_break}vero!{page_break}Ora dovrai raccontarci{line_break}di tutte le tue{line_break}avventure!{end_wait}"

msgctxt "message"
msgid "07148"
msgstr "{actor_name:1}! Quando{line_break}sei tornato? Quando{line_break}partisti, pensavo che{page_break}non ti avrei rivisto{line_break}mai più.{page_break}Mi fa piacere{line_break}vederti!{end_wait}"

msgctxt "message"
msgid "07149"
msgstr "Oh!{pause_20_skippable} Quanto ci metto{line_break}a diventare grande!{line_break}Ma {actor_name:1} è già tornato!{page_break}Ah...{line_break}Sei solo di passaggio...{line_break}Ma che sorpresa!{end_wait}"

msgctxt "message"
msgid "07150"
msgstr "Benvenuto a casa, {actor_name:1}!{line_break}Ehi...{pause_20_skippable} ...{line_break}Che succede?{page_break}Com'è che te ne vai{line_break}in giro con una ragazza{line_break}che non è {actor_name:6}?{end_wait}"

msgctxt "message"
msgid "07151"
msgstr "Ultimamente si sono visti{line_break}parecchi mostri, e andare{line_break}fuori dal villaggio è{page_break}diventato molto pericoloso.{line_break}Per questo si vendono{line_break}molte armi.{page_break}Se soltanto riuscissero{line_break}a costruirle un{line_break}po' meglio...{end_wait}"

msgctxt "message"
msgid "07152"
msgstr "Mi piacerebbe imparare{line_break}a costruire{line_break}buone armi...{end_wait}"

msgctxt "message"
msgid "07153"
msgstr "Gli avevo dato un regalo{line_break}d'addio, pensando che non{line_break}l'avrei più rivisto...{page_break}Ma non avrei dovuto...{page_break}E non sarebbe dovuto{line_break}tornare con {actor_name:6}?{end_wait}"

msgctxt "message"
msgid "07154"
msgstr "Ho promesso che sarei diventato{line_break}un buon fabbro prima del{line_break}ritorno di {actor_name:1}.{page_break}Una promessa è una promessa,{line_break}e va mantenuta.{end_wait}"

msgctxt "message"
msgid "07155"
msgstr "Quella ragazza così timida{line_break}che è con {actor_name:1}{pause_20_skippable}{line_break}sembra proprio carina.{end_wait}"

msgctxt "message"
msgid "07156"
msgstr "Cosa è successo a {actor_name:6}?{line_break}Non l'avete ancora{line_break}trovata?{end_wait}"

msgctxt "message"
msgid "07157"
msgstr "{actor_name:1}!{page_break}Sei così cresciuto{line_break}che stentavo a{line_break}riconoscerti!{end_wait}"

msgctxt "message"
msgid "07158"
msgstr "Ah, sei tu, {actor_name:1}.{line_break}Sei tornato, eh?{end_wait}"

msgctxt "message"
msgid "07159"
msgstr "Sei tornato a Vale{line_break}per restarci?{end_now}"

msgctxt "message"
msgid "07160"
msgstr "Ah, capisco, non vuoi{line_break}abituarti troppo all'idea{line_break}di essere a casa...{page_break}In questo caso, sei{line_break}benvenuto...{end_wait}"

msgctxt "message"
msgid "07161"
msgstr "Beh, lo credo! Ora{line_break}che sei qui,{line_break}corri a casa!{end_wait}"

msgctxt "message"
msgid "07162"
msgstr "Hai percorso{line_break}l'angolo orientale{line_break}del continente?{page_break}Devi essere{line_break}esausto!{end_wait}"

msgctxt "message"
msgid "07163"
msgstr "Sei contento di{line_break}vedere che il villaggio{line_break}non è cambiato?{end_wait}"

msgctxt "message"
msgid "07164"
msgstr "{actor_name:1} sa che{line_break}Dora è stata colpita{line_break}da una malattia?{end_wait}"

msgctxt "message"
msgid "07165"
msgstr "Chissà se {actor_name:1} è qui{line_break}perché Dora l'ha{line_break}fatto andare via...{page_break}Nessuno sa della sua{line_break}malattia, oltre{line_break}al sindaco...{end_wait}"

msgctxt "message"
msgid "07166"
msgstr "Chissà se {actor_name:1}{line_break}continuerà il suo viaggio.{line_break}Dev'essere molto difficile.{end_wait}"

msgctxt "message"
msgid "07167"
msgstr "Vale sarà sempre{line_break}uguale: torna a casa{line_break}quando lo desideri.{end_wait}"

msgctxt "message"
msgid "07168"
msgstr "Ehi...{end_wait}"

msgctxt "message"
msgid "07169"
msgstr "Cosa?{end_wait}"

msgctxt "message"
msgid "07170"
msgstr "Non è meglio che{line_break}cerchiamo {actor_name:2}?{end_wait}"

msgctxt "message"
msgid "07171"
msgstr "Perché?{end_wait}"

msgctxt "message"
msgid "07172"
msgstr "{actor_name:1} non sa ancora{line_break}nulla di Dora...{pause_20_skippable} vero?{line_break}Bisognerebbe dirglielo.{end_wait}"

msgctxt "message"
msgid "07173"
msgstr "Ti manca {actor_name:2}, vero?{line_break}Stai cercando una scusa per{line_break}andarlo a trovare.{end_wait}"

msgctxt "message"
msgid "07174"
msgstr "Perché? Io... non...{end_wait}"

msgctxt "message"
msgid "07175"
msgstr "{text_effect:4}Guh...{pause_20_skippable}{pause_20_skippable} Gah...{pause_20_skippable} Ugh...{end_wait}"

msgctxt "message"
msgid "07176"
msgstr "Nonna! Che ti{line_break}succede? Stai{line_break}soffocando?{end_wait}"

msgctxt "message"
msgid "07177"
msgstr "È... {actor_name:2}!{end_wait}"

msgctxt "message"
msgid "07178"
msgstr "Sì, credo che {actor_name:2}{line_break}manchi anche a lei.{end_wait}"

msgctxt "message"
msgid "07179"
msgstr "No, è veramente {actor_name:2}!{line_break}Guarda!{end_wait}"

msgctxt "message"
msgid "07180"
msgstr "{actor_name:2}!{end_now}"

msgctxt "message"
msgid "07181"
msgstr "Oh, {actor_name:2}...!{end_now}"

msgctxt "message"
msgid "07182"
msgstr "Mamma, papà...{pause_20_skippable} sono a casa...{end_wait}"

msgctxt "message"
msgid "07183"
msgstr "Come,{pause_20_skippable} {actor_name:2}?{end_wait}"

msgctxt "message"
msgid "07184"
msgstr "Oh, {actor_name:2}...!{end_wait}"

msgctxt "message"
msgid "07185"
msgstr "Nonno,{line_break}sono a casa...{end_wait}"

msgctxt "message"
msgid "07186"
msgstr "Sì, sì...{pause_20_skippable} Hai compiuto{line_break}la tua missione{line_break}per il Saggio?{end_now}"

msgctxt "message"
msgid "07187"
msgstr "Ah, vuoi dire che sta{line_break}andando tutto bene? Allora{line_break}presto ripartirai...{end_wait}"

msgctxt "message"
msgid "07188"
msgstr "Non ancora? Mi fa comunque{line_break}piacere che tu sia qui, anche{line_break}se per poco...{end_wait}"

msgctxt "message"
msgid "07189"
msgstr "Ripartirai{line_break}presto, vero?{end_wait}"

msgctxt "message"
msgid "07190"
msgstr "Sono comunque felice di{line_break}sapere che te la passi bene!{end_wait}"

msgctxt "message"
msgid "07191"
msgstr "Bene.{end_wait}"

msgctxt "message"
msgid "07192"
msgstr "Voglio presentarti i{line_break}miei nuovi amici.{end_wait}"

msgctxt "message"
msgid "07193"
msgstr "Ecco...{pause_20_skippable} Io sono {actor_name:3}.{line_break}Piacere.{end_wait}"

msgctxt "message"
msgid "07194"
msgstr "Io sono {actor_name:4}, di Imil.{line_break}Piacere di conoscerti.{end_wait}"

msgctxt "message"
msgid "07195"
msgstr "Ciao, piacere. Prendetevi{line_break}cura di {actor_name:2}{line_break}mi raccomando.{end_wait}"

msgctxt "message"
msgid "07196"
msgstr "Beh{pause_20_skippable}, basta convenevoli.{line_break}Ora riposatevi e{line_break}passatevela bene...{end_wait}"

msgctxt "message"
msgid "07197"
msgstr "{actor_name:4} è così{line_break}carina.{page_break}Chissà se a {actor_name:2}{line_break}piace di più {actor_name:4} o{line_break}{actor_name:6}...{end_wait}"

msgctxt "message"
msgid "07198"
msgstr "{actor_name:3} sembra un{line_break}tipo intelligente...{page_break}Vorrei essere un po' come{line_break}{actor_name:3}, sai, {actor_name:2}?{end_wait}"

msgctxt "message"
msgid "07199"
msgstr "Ci hai sentito parlare{line_break}di Dora, poco fa?{end_now}"

msgctxt "message"
msgid "07200"
msgstr "Dora dice di non{line_break}preoccuparsi, è solo{line_break}un po' di febbre.{page_break}Non allarmarti troppo,{line_break}{actor_name:1}.{end_wait}"

msgctxt "message"
msgid "07201"
msgstr "Non hai sentito? Ma{line_break}sembri preoccupato.{page_break}Ci prenderemo cura noi{line_break}di tua madre, non{line_break}preoccuparti.{end_wait}"

msgctxt "message"
msgid "07202"
msgstr "Spero che non vi siate{line_break}ammalati durante{line_break}i vostri viaggi...{page_break}{actor_name:2} fa{line_break}sempre indigestione... E fa{line_break}preoccupare la mamma...{end_wait}"

msgctxt "message"
msgid "07203"
msgstr "Che bello essere giovani{line_break}e fare i galanti con{line_break}le belle ragazze!{end_wait}"

msgctxt "message"
msgid "07204"
msgstr "I suoi nuovi amici sono{line_break}così educati...{line_break}Mi fa piacere.{end_wait}"

msgctxt "message"
msgid "07205"
msgstr "Non avremmo dovuto parlare{line_break}di Dora senza accorgerci che{line_break}{actor_name:1} era lì.{page_break}Vorrei potergli dire{line_break}la verità.{end_wait}"

msgctxt "message"
msgid "07206"
msgstr "{actor_name:2} sembra essere{line_break}cresciuto durante la sua{line_break}difficile avventura.{end_wait}"

msgctxt "message"
msgid "07207"
msgstr "Ah!{end_wait}"

msgctxt "message"
msgid "07208"
msgstr "Ne è passato del tempo...{end_wait}"

msgctxt "message"
msgid "07209"
msgstr "Sei tornato?{end_wait}"

msgctxt "message"
msgid "07210"
msgstr "Sei già stato a casa{line_break}da papà?{end_now}"

msgctxt "message"
msgid "07211"
msgstr "Davvero?{pause_20_skippable} Dev'essere{line_break}stato felice di vederti.{page_break}Era così preoccupato{line_break}per te!{end_wait}"

msgctxt "message"
msgid "07212"
msgstr "Devi andare a trovarlo...{pause_20_skippable}{line_break}Era così preoccupato{line_break}per te!{end_wait}"

msgctxt "message"
msgid "07213"
msgstr "...{pause_20_skippable}Come me.{end_wait}"

msgctxt "message"
msgid "07214"
msgstr "Sorellina...{end_wait}"

msgctxt "message"
msgid "07215"
msgstr "Non mi fraintendere{pause_20_skippable} Io...{line_break}temevo soltanto che ti{line_break}mettessi nei guai,{page_break}perché non sei{line_break}tanto sveglio...{end_wait}"

msgctxt "message"
msgid "07216"
msgstr "Ah, dovevo immaginarlo...{line_break}Grazie, sorellina.{end_wait}"

msgctxt "message"
msgid "07217"
msgstr "Allora, {pause_20_skippable}{pause_20_skippable}hai{line_break}compiuto la missione? O...{end_wait}"

msgctxt "message"
msgid "07218"
msgstr "Non ancora...{end_wait}"

msgctxt "message"
msgid "07219"
msgstr "Ma allora{pause_20_skippable}{line_break}parti di nuovo?{end_wait}"

msgctxt "message"
msgid "07220"
msgstr "Quando ripartirai,{line_break}cerca sempre di non{line_break}esagerare.{end_wait}"

msgctxt "message"
msgid "07221"
msgstr "Ehi, come t'è andata?{end_wait}"

msgctxt "message"
msgid "07222"
msgstr "Ehi,{pause_20_skippable} {actor_name:2}!{line_break}{actor_name:1}!{end_wait}"

msgctxt "message"
msgid "07223"
msgstr "Cos'è successo!?{line_break}Siete già qui!?{end_wait}"

msgctxt "message"
msgid "07224"
msgstr "Come già qui?{line_break}Ti sembra il modo{line_break}di salutarci?{end_wait}"

msgctxt "message"
msgid "07225"
msgstr "Ma... dicevano che{line_break}saresti mai più{line_break}tornato!{end_wait}"

msgctxt "message"
msgid "07226"
msgstr "Ma ho l'impressione che tu{line_break}sia qui soltanto per una{line_break}visita.{end_wait}"

msgctxt "message"
msgid "07227"
msgstr "Davvero?{pause_20_skippable} Sembra{line_break}proprio così?{end_wait}"

msgctxt "message"
msgid "07228"
msgstr "Ah... Tu e i tuoi amici,{line_break}sembra che stiate per{line_break}partire.{end_wait}"

msgctxt "message"
msgid "07229"
msgstr "Sei più furbo di{line_break}quanto credessi.{end_wait}"

msgctxt "message"
msgid "07230"
msgstr "Dovrò riprendermi durante{line_break}la tua assenza, vero?{line_break}Altrimenti...{end_wait}"

msgctxt "message"
msgid "07231"
msgstr "Finché sei qui, la famiglia{line_break}starà benissimo!{line_break}Ho ragione?{end_now}"

msgctxt "message"
msgid "07232"
msgstr "Quando non ci sarò più ti{line_break}occuperai tu della famiglia.{line_break}Va bene?{end_wait}"

msgctxt "message"
msgid "07233"
msgstr "Ehi! Non mi sei di{line_break}grande aiuto!{end_wait}"

msgctxt "message"
msgid "07234"
msgstr "QUALUNQUE{pause_20_skippable} COSA{pause_20_skippable} FAI{pause_20_skippable},{line_break}certamente aiuterai la{line_break}famiglia...{page_break}Io conto su di te, hai{line_break}capito?{end_wait}"

msgctxt "message"
msgid "07235"
msgstr "Cerca di non{line_break}strafare,{pause_20_skippable}{pause_20_skippable} hai capito?{end_wait}"

msgctxt "message"
msgid "07236"
msgstr "Soltanto a guardarti,{line_break}si capisce che hai{line_break}fatto molte esperienze.{page_break}Ora hai un aspetto{line_break}molto più maturo.{end_wait}"

msgctxt "message"
msgid "07237"
msgstr "Farò del mio meglio{line_break}per dimostrare che sono{line_break}abbastanza forte per{page_break}proteggere Vale e la mia{line_break}famiglia.{end_wait}"

msgctxt "message"
msgid "07238"
msgstr "Vedo che v'impegnate molto,{line_break}ma ho un po' di preoccupazione.{line_break}Siete certi di stare bene?{end_wait}"

msgctxt "message"
msgid "07239"
msgstr "Se fossi un po' più grande,{line_break}potrei venire con voi...{line_break}Non è giusto...{end_wait}"

msgctxt "message"
msgid "07240"
msgstr "{text_effect:4}Eccì{pause_20_skippable}{pause_20_skippable}! {reset_text_style}Chi è?{pause_20_skippable}{line_break}Il locandiere?{pause_20_skippable}{pause_20_skippable}{line_break}È già ora di pranzo?{end_wait}"

msgctxt "message"
msgid "07241"
msgstr "No? {text_effect:4}Eccì...{reset_text_style}{pause_20_skippable}{pause_20_skippable}{line_break}Ma allora chi{end_wait}"

msgctxt "message"
msgid "07242"
msgstr "{actor_name:1}...{end_wait}"

msgctxt "message"
msgid "07243"
msgstr "Sei tornato?{line_break}Hai compiuto{line_break}la missione!?{end_wait}"

msgctxt "message"
msgid "07244"
msgstr "Ah, non ancora?{end_wait}"

msgctxt "message"
msgid "07245"
msgstr "Hai scordato la tua{line_break}promessa, {actor_name:1}?{end_wait}"

msgctxt "message"
msgid "07246"
msgstr "Avevi promesso che non{line_break}saresti tornato prima di aver{line_break}compiuto la missione, giusto?{end_now}"

msgctxt "message"
msgid "07247"
msgstr "Sei venuto meno alla{line_break}promessa perché eri{line_break}preoccupato per me?{end_wait}"

msgctxt "message"
msgid "07248"
msgstr "La preoccupazione per me{line_break}era più importante della{line_break}promessa?{end_wait}"

msgctxt "message"
msgid "07249"
msgstr "Ti hanno detto che sono{line_break}malata? {text_effect:4}Eccì{reset_text_style}!{end_now}"

msgctxt "message"
msgid "07250"
msgstr "Allora sei venuto qui{line_break}perché eri preoccupato,{line_break}dopo aver saputo di me.{end_wait}"

msgctxt "message"
msgid "07251"
msgstr "Allora vuoi dirmi che è{line_break}stata una sorpresa per te{line_break}vedermi a letto?{end_wait}"

msgctxt "message"
msgid "07252"
msgstr "Non puoi venir meno alla{line_break}tua promessa soltanto{line_break}perché sei preoccupato.{page_break}{text_effect:4}Eccì...{reset_text_style}{end_wait}"

msgctxt "message"
msgid "07253"
msgstr "Io... {text_effect:4}Eccì...{reset_text_style}{pause_20_skippable}{line_break}Ho soltanto un{line_break}raffreddore.{end_wait}"

msgctxt "message"
msgid "07254"
msgstr "Ma sto già meglio.{pause_20_skippable}{pause_20_skippable}{line_break}{text_effect:4}Eccì...{reset_text_style}{pause_20_skippable} Guarda!{end_wait}"

msgctxt "message"
msgid "07255"
msgstr "Vedi?{pause_20_skippable} Sto benissimo!{end_wait}"

msgctxt "message"
msgid "07256"
msgstr "Non preoccuaparti per me.{line_break}Vai e fai del tuo meglio per{line_break}compiere la missione.{pause_20_skippable}{pause_20_skippable} OK?{end_wait}"

msgctxt "message"
msgid "07257"
msgstr "Non preoccuparti per me.{line_break}Vai e fai del tuo meglio{line_break}per compiere la missione.{page_break}{text_effect:4}Eccì... eccì...{reset_text_style}{end_wait}"

msgctxt "message"
msgid "07258"
msgstr "Mi dispiace se ti sono parsa{line_break}troppo dura, {actor_name:1}...{page_break}Ma sono felice di vederti.{line_break}Non vedo l'ora di vederti{line_break}tornare vincitore...{end_wait}"

msgctxt "message"
msgid "07259"
msgstr "{text_effect:4}Aaah...{pause_20_skippable} Oooh...{pause_20_skippable}{pause_20_skippable}{line_break}Kyle...{pause_20_skippable} Non andare...{end_wait}"

msgctxt "message"
msgid "07260"
msgstr "Credo che Dora{line_break}stia sognando.{end_wait}"

msgctxt "message"
msgid "07261"
msgstr "Kyle, attenzione!{pause_20_skippable}{pause_20_skippable}{line_break}Il masso!!!{pause_20_skippable}{line_break}Il masso...{end_wait}"

msgctxt "message"
msgid "07262"
msgstr "Allora non avete ancora{line_break}salvato {actor_name:6}...{end_wait}"

msgctxt "message"
msgid "07263"
msgstr "Io guarisco velocemente.{page_break}Dora, invece,{line_break}è praticamente{line_break}sempre ammalata.{end_wait}"

msgctxt "message"
msgid "07264"
msgstr "C'è in giro un raffeddore,{line_break}non vorrei prendermelo.{end_wait}"

msgctxt "message"
msgid "07265"
msgstr "Chissà se potrò rivedere{line_break}{actor_name:5} e {actor_name:6}{line_break}prima di morire?{end_wait}"

msgctxt "message"
msgid "07266"
msgstr "Dora dice che è soltanto un{line_break}raffreddore, ma è sempre{line_break}stata così da quando{page_break}{actor_name:1} se n'è andato...{line_break}...sembra che non{line_break}guarisca più...{end_wait}"

msgctxt "message"
msgid "07267"
msgstr "È vero che in inverno ci{line_break}sono sempre epidemie{line_break}di raffreddore...{page_break}Però...{end_wait}"

msgctxt "message"
msgid "07268"
msgstr "Cos'è l'\"Alchimia\",{line_break}che Kraden studiava{line_break}in continuazione?{page_break}Penso che fosse{line_break}qualcosa di{line_break}pericoloso...{end_wait}"

msgctxt "message"
msgid "07269"
msgstr "Ogni tanto si avvertono{line_break}ancora terremoti...{page_break}Ogni volta mi viene{line_break}la pelle d'oca...{end_wait}"

msgctxt "message"
msgid "07270"
msgstr "Anche se L'Alchimia non{line_break}avesse nulla a che fare con{line_break}quanto è accaduto...{page_break}Penso comunque che sia{line_break}meglio che Kraden stia{line_break}lontano dal villaggio.{end_wait}"

msgctxt "message"
msgid "07271"
msgstr "Ad ogni scossa di terremoto{line_break}ho sempre paura che ci sia{line_break}un'altra eruzione.{end_wait}"

msgctxt "message"
msgid "07272"
msgstr "Pare che la montagna{line_break}stia sputando Pietre{line_break}psinergiche dappertutto.{page_break}Quelli che sono andati oltre{line_break}il cancello dicono di{line_break}averne viste alcune{page_break}ai bordi della strada.{end_wait}"

msgctxt "message"
msgid "07273"
msgstr "Se le Pietre psinergiche{line_break}della montagna continuano{line_break}a essere gettate in giro...{page_break}Di questo passo, il Monte{line_break}Aleph resterà senza{line_break}Pietre psinergiche.{end_wait}"

msgctxt "message"
msgid "07274"
msgstr "Il lato nordoccidentale del{line_break}Monte Aleph è stato bruciato{line_break}da una colata di lava.{end_wait}"

msgctxt "message"
msgid "07275"
msgstr "Quella lava... era come{line_break}se la terra stesse vomitando{line_break}le sue stesse viscere.{end_wait}"

msgctxt "message"
msgid "07276"
msgstr "I Gran Guaritori hanno{line_break}troppa paura per andare{line_break}al Tempio di Sol.{page_break}Ma è un timore infondato.{line_break}La Psinergia li{line_break}proteggerebbe.{end_wait}"

msgctxt "message"
msgid "07277"
msgstr "I guaritori dovrebbero restare{line_break}nel Mt. Aleph per proteggerlo.{line_break}Perché non vi ritornano?{end_wait}"

msgctxt "message"
msgid "07278"
msgstr "Non faccio altro che{line_break}chiedermi cosa ci sia{line_break}oltre il recinto.{end_wait}"

msgctxt "message"
msgid "07279"
msgstr "Oh, {pause_20_skippable}è {actor_name:1}, vero?{line_break}È tornata {pause_20_skippable}{actor_name:6}{pause_20_skippable}?{page_break}{actor_name:1}, fammi una promessa...{line_break}{pause_20_skippable}Promettimi che la prossima{line_break}volta tornerai con {actor_name:6}.{end_wait}"

msgctxt "message"
msgid "07280"
msgstr "{actor_name:1}, fammi una promessa...{line_break}{pause_20_skippable}Promettimi che la prossima{line_break}volta tornerai con {actor_name:6}.{end_wait}"

msgctxt "message"
msgid "07281"
msgstr "Ma non hai portato{line_break}{actor_name:6} con te?{end_wait}"

msgctxt "message"
msgid "07282"
msgstr "Ricorderò sempre quando io e{line_break}{actor_name:5} giocavamo{line_break}insieme...*Sniff*{end_wait}"

msgctxt "message"
msgid "07283"
msgstr "{actor_name:5} proteggerà{line_break}{actor_name:6}...{line_break}Questo è certo!{end_wait}"

msgctxt "message"
msgid "07284"
msgstr "Stavo provando a prendere{line_break}quel pesce, e tu l'hai ucciso.{line_break}Ma perché l'hai fatto?{end_wait}"

msgctxt "message"
msgid "07285"
msgstr "Ah, c'erano pesci{line_break}mostruosi{line_break}nel fiume?{end_wait}"

msgctxt "message"
msgid "07286"
msgstr "Ehi!{pause_20_skippable} Che fine ha{line_break}fatto quella Pietra{line_break}psinergica? Non c'è più.{end_wait}"

msgctxt "message"
msgid "07287"
msgstr "È rimasto soltanto un{line_break}grosso buco nel tetto.{page_break}Ma il ricordo dell'eruzione{line_break}rimarrà per sempre, anche{line_break}se il buco verrà riparato.{end_wait}"

msgctxt "message"
msgid "07288"
msgstr "Hai molti ricordi in{line_break}questo rifugio,{line_break}vero?{end_now}"

msgctxt "message"
msgid "07289"
msgstr "Lo sapevo... Facevi{line_break}spesso visita a Kraden,{line_break}{actor_name:1}.{end_wait}"

msgctxt "message"
msgid "07290"
msgstr "Capisco, ora non{line_break}hai tempo per{line_break}i ricordi...{end_wait}"

msgctxt "message"
msgid "07291"
msgstr "L'eruzione del Monte Aleph è{line_break}stata così potente da{line_break}incrinare tutto il continente!{end_wait}"

msgctxt "message"
msgid "07292"
msgstr "Aghh!{pause_20_skippable} Un'altra scossa!{end_wait}"

msgctxt "message"
msgid "07293"
msgstr "Va avanti così da parecchio{line_break}tempo, la notte non riesco{line_break}neppure a dormire!{end_wait}"

msgctxt "message"
msgid "07294"
msgstr "Dicono che il pericolo sia{line_break}passato, anche se continuano{line_break}le scosse ti terremoto...{end_wait}"

msgctxt "message"
msgid "07295"
msgstr "Chissà perché non abbiamo{line_break}più visto nessun viaggiatore da{line_break}quando c'è stata l'eruzione...{page_break}Tu lo sai il perché,{line_break}{actor_name:1}?{end_now}"

msgctxt "message"
msgid "07296"
msgstr "Ah, il ponte a sud è{line_break}stato distrutto?{line_break}Ah, questo spiega tutto.{end_wait}"

msgctxt "message"
msgid "07297"
msgstr "Non lo sai neanche tu?{line_break}Di certo non abbiamo bandito{line_break}i turisti dopo l'eruzione.{end_wait}"

msgctxt "message"
msgid "07298"
msgstr "Ho l'impressione che la{line_break}mia avventura avrà inizio{line_break}oltre questo recinto.{end_wait}"

msgctxt "message"
msgid "07299"
msgstr "In questo fiume ci{line_break}sono davvero pesci{line_break}mostruosi.{end_wait}"

msgctxt "message"
msgid "07300"
msgstr "Nessun pesce normale{line_break}saprebbe saltare{line_break}in questo modo!{page_break}Così può saltare solo{line_break}un PESCE MOSTRUOSO!{end_wait}"

msgctxt "message"
msgid "07301"
msgstr "Mi piacerebbe poter{line_break}mostrare a tutti{line_break}quel pesce...{page_break}Così potrei dimostrare{line_break}a tutti che ho{line_break}ragione!{end_wait}"

msgctxt "message"
msgid "07302"
msgstr "Credi che non fosse solo{line_break}mostruoso, bensì un mostro{line_break}vero e proprio?{page_break}Ma è incredibile!{end_wait}"

msgctxt "message"
msgid "07303"
msgstr "L'eruzione è stata un{line_break}colpo troppo forte{line_break}per la gente di Vale.{end_wait}"

msgctxt "message"
msgid "07304"
msgstr "Chissà perché quando vengo{line_break}qui mi prende un senso{line_break}di solitudine...{page_break}Con Kraden non eravamo{line_break}neppure troppo legati...{end_wait}"

msgctxt "message"
msgid "07305"
msgstr "I terremoti non sono{line_break}causati dalle eruzioni.{page_break}Credo che dipendano piuttosto{line_break}dal fatto che il continente si{line_break}sta separando in due.{end_wait}"

msgctxt "message"
msgid "07306"
msgstr "Aaah... Non sopporto{line_break}questi terremoti!{line_break}Ma quando finiscono!!!{end_wait}"

msgctxt "message"
msgid "07307"
msgstr "Il fumo del Monte Aleph{line_break}non è più tanto denso.{line_break}Ora va molto meglio.{end_wait}"

msgctxt "message"
msgid "07308"
msgstr "È triste che non ci{line_break}sia nessun viaggiatore...{end_wait}"

msgctxt "message"
msgid "07309"
msgstr "Ehi, voi siete i guerrieri che{line_break}hanno catturato quei ladri{line_break}tempo fa, vero?{page_break}Bentornati a Vault!{end_wait}"

msgctxt "message"
msgid "07310"
msgstr "Forse lo sapete già , ma{line_break}il ponte per Kalay è stato{line_break}riparato.{end_wait}"

msgctxt "message"
msgid "07311"
msgstr "Chissà cos'è successo a{line_break}Hammet quando è andato{line_break}a Lunpa...{end_wait}"

msgctxt "message"
msgid "07312"
msgstr "S'è sentito parlare di{line_break}ladri di Lunpa fuori{line_break}controllo, ma non vi{page_break}abbiamo mai fatto{line_break}molta attenzione.{page_break}Chissà perché{line_break}ultimamente sono{line_break}così calmi...{end_wait}"

msgctxt "message"
msgid "07313"
msgstr "Ah sei tu... Stavo proprio{line_break}parlando di voi con{line_break}il sindaco.{page_break}Dicevo che siete proprio{line_break}forti, e che con voi non c'è{line_break}nulla da temere dai ladri.{page_break}Con voi non possono{line_break}farla franca!{end_wait}"

msgctxt "message"
msgid "07314"
msgstr "Se il vulcano non riprende{line_break}ad eruttare e il ponte non{line_break}si rompe di nuovo, non{page_break}avremo alcun{line_break}problema.{end_wait}"

msgctxt "message"
msgid "07315"
msgstr "Ehi, è quel giovane{line_break}guerriero!{end_wait}"

msgctxt "message"
msgid "07316"
msgstr "Sì, insieme a {actor_name:3}.{end_wait}"

msgctxt "message"
msgid "07317"
msgstr "Sono così felice che siate{line_break}tornati a Vault!{end_wait}"

msgctxt "message"
msgid "07318"
msgstr "Magari gli anziani di Vault{line_break}avessero il vostro coraggio!{end_wait}"

msgctxt "message"
msgid "07319"
msgstr "Avete controllato{line_break}la prigione?{end_now}"

msgctxt "message"
msgid "07320"
msgstr "Come avranno fatto quei{line_break}criminali ad evadere?{page_break}Le sbarre sono{line_break}molto forti.{end_wait}"

msgctxt "message"
msgid "07321"
msgstr "I ladri sono evasi dal carcere{line_break}e hanno tagliato la corda.{page_break}È un vero peccato, con tutta{line_break}la fatica che avete fatto{line_break}per catturarli...{end_wait}"

msgctxt "message"
msgid "07322"
msgstr "I ladri sono fuggiti, ma non{line_break}mi preoccupo.{page_break}Fa tutto parte del{line_break}volere divino.{end_wait}"

msgctxt "message"
msgid "07323"
msgstr "Bau bau bau!{end_wait}"

msgctxt "message"
msgid "07324"
msgstr "Non posso credere che{line_break}siano qui, che tempismo!{end_wait}"

msgctxt "message"
msgid "07325"
msgstr "Quei tipi di Kalay{line_break}venuti per riparare{line_break}il ponte sembravano{page_break}preoccupati{line_break}per qualcosa...{end_wait}"

msgctxt "message"
msgid "07326"
msgstr "Sì, alcuni guerrieri di{line_break}Kalay sono venuti a Vault{line_break}chiedendo di Hammet.{page_break}Ma Hammet è stato{line_break}davvero catturato?{end_wait}"

msgctxt "message"
msgid "07327"
msgstr "Da quando Dodonpa è al{line_break}potere, i ladri di Lunpa sono{line_break}diventati dei comuni ladri.{page_break}Se quei tipi sono così{line_break}calmi, un motivo{line_break}ci dev'essere.{end_wait}"

msgctxt "message"
msgid "07328"
msgstr "Quei ladracci sono fuggiti{line_break}e non sappiamo{line_break}dove siano...{page_break}Odiavano quei ragazzini che{line_break}li avevano catturati.{line_break}Non vorrei che...{end_wait}"

msgctxt "message"
msgid "07329"
msgstr "Sarebbe stato bello{line_break}risolvere tutto prima{line_break}dell'inverno.{end_wait}"

msgctxt "message"
msgid "07330"
msgstr "Guardarvi mi infonde{line_break}coraggio.{page_break}Spero che un giorno{line_break}mi raccontiate dei{line_break}vostri viaggi.{end_wait}"

msgctxt "message"
msgid "07331"
msgstr "Gli adulti sono sempre{line_break}così preoccupati quando{line_break}accade qualcosa.{page_break}Non li{line_break}sopporto più...{end_wait}"

msgctxt "message"
msgid "07332"
msgstr "Non è così facile{line_break}procurarsi la chiave{line_break}di quella cella.{page_break}Sono stati capaci di{line_break}trovarla, quindi sapevano{line_break}il segreto della serratura...{page_break}Devono essere{line_break}formidabili!{end_wait}"

msgctxt "message"
msgid "07333"
msgstr "Continuo a chiedermelo...{line_break}Quella statua è stata rubata a{line_break}causa del mio comportamento?{end_wait}"

msgctxt "message"
msgid "07334"
msgstr "Se mi porti qualche{line_break}osso ti dirò{line_break}un segreto.{end_wait}"

msgctxt "message"
msgid "07335"
msgstr "Ooooooh!{end_wait}"

msgctxt "message"
msgid "07336"
msgstr "Bau bau bau!{end_wait}"

msgctxt "message"
msgid "07337"
msgstr "Come facevi a sapere che{line_break}cercavo uno di questi?{end_wait}"

msgctxt "message"
msgid "07338"
msgstr "{text_effect:4}Aaah! {reset_text_style}{pause_20_skippable}{line_break}Un gatto ha mangiato la mia{line_break}preziosa pietra!{page_break}Non so come sia potuto{line_break}succedere, ma è vero.{end_wait}"

msgctxt "message"
msgid "07339"
msgstr "Credo di aver visto un gatto{line_break}salire sul tavolo e{line_break}mangiarsi la gemma...{page_break}Così, il mio tesoro è nella{line_break}sua pancia, ora!{end_wait}"

msgctxt "message"
msgid "07340"
msgstr "Se sapevo che avrebbe{line_break}fatto quella fine,{line_break}l'avrei venduto.{end_wait}"

msgctxt "message"
msgid "07341"
msgstr "Mio marito dice che il mio{line_break}gatto s'è mangiato il suo{line_break}tesoro, ma non è vero.{end_wait}"

msgctxt "message"
msgid "07342"
msgstr "I prigionieri dicevano di{line_break}voler evadere prima che{line_break}iniziasse il Colossum.{page_break}Il Colossum... Non è quel{line_break}grande festival a Tolbi?{end_wait}"

msgctxt "message"
msgid "07343"
msgstr "Gli scagnozzi di Dodonpa non{line_break}ci hanno mai attaccato...{page_break}Magari quei ladruncoli{line_break}non erano neppure{line_break}di Lunpa.{end_wait}"

msgctxt "message"
msgid "07344"
msgstr "Perché i ladri evasi{line_break}erano così interessati{line_break}al Colossum?{end_wait}"

msgctxt "message"
msgid "07345"
msgstr "Papà non s'è mai preoccupato,{line_break}perché non abbiamo mai avuto{line_break}attacchi da Dodonpa.{end_wait}"

msgctxt "message"
msgid "07346"
msgstr "A Tolbi sta per iniziare{line_break}il Colossum, vero?{page_break}Prima di morire, vorrei{line_break}andarci ancora una volta.{end_wait}"

msgctxt "message"
msgid "07347"
msgstr "Al Colossum ho visto{line_break}combattere guerrieri{line_break}così potenti...{page_break}Non potevo smettere{line_break}di ammirarli.{end_wait}"

msgctxt "message"
msgid "07348"
msgstr "Tutte le volte che siamo{line_break}stati a Tolbi per il Colossum,{page_break}mia moglie s'è sempre incantata{line_break}ad ammirare i gladiatori...{page_break}Per questo non{line_break}la porto più{line_break}con me.{end_wait}"

msgctxt "message"
msgid "07349"
msgstr "Negli ultimi tempi mio{line_break}marito parla solo{line_break}del Colossum.{page_break}Chissà se mi ci{line_break}porta quest'anno...{end_wait}"

msgctxt "message"
msgid "07350"
msgstr "Oh, {actor_name:1}!{line_break}Bentornato{line_break}a Vault!{end_wait}"

msgctxt "message"
msgid "07351"
msgstr "Da quando siete andati via{line_break}ne sono successe di{line_break}tutti i colori...{end_wait}"

msgctxt "message"
msgid "07352"
msgstr "Quei ladri che avevate{line_break}catturato sono evasi.{end_wait}"

msgctxt "message"
msgid "07353"
msgstr "Avevamo paura che fossero{line_break}venuti a cercarvi.{line_break}Li avete visti, per caso?{end_now}"

msgctxt "message"
msgid "07354"
msgstr "Beh, potreste trovarveli di{line_break}fronte in qualsiasi momento:{line_break}tenete gli occhi aperti!{end_wait}"

msgctxt "message"
msgid "07355"
msgstr "Va bene...{line_break}Ma fate attenzione... Chissà{line_break}cosa potrebbero fare...{end_wait}"

msgctxt "message"
msgid "07356"
msgstr "Quei tipi volevano vendicarsi{line_break}di voi, quindi state{line_break}molto attenti.{end_wait}"

msgctxt "message"
msgid "07357"
msgstr "L'urna di famiglia del{line_break}sindaco è in mostra. Potete{line_break}andarla a vedere...{end_wait}"

msgctxt "message"
msgid "07358"
msgstr "Quei ladri!{line_break}Avete fatto tutta quella{line_break}fatica a catturarli{page_break}e adesso sono{line_break}fuggiti.{end_wait}"

msgctxt "message"
msgid "07359"
msgstr "Ho sentito parlare di un{line_break}festival che sta per iniziare{line_break}in una lontana città.{page_break}Mi piacerebbe andare a{line_break}vedere di che festival{line_break}si tratta.{end_wait}"

msgctxt "message"
msgid "07360"
msgstr "Finché ci siete voi qui,{line_break}quei ladri non potranno{line_break}farci alcun male.{end_wait}"

msgctxt "message"
msgid "07361"
msgstr "Andatela a vedere subito,{line_break}perché presto la riporranno{line_break}in un posto sicuro.{end_wait}"

msgctxt "message"
msgid "07362"
msgstr "Ci dispiace molto di{line_break}aver fatto scappare{line_break}quei ladri.{end_wait}"

msgctxt "message"
msgid "07363"
msgstr "Mi piacciono i festival!{line_break}Credo proprio che il{line_break}Colossum sia incredibile.{end_wait}"

msgctxt "message"
msgid "07364"
msgstr "Sul lato opposto del Monte{line_break}Aleph s'è formato un{line_break}fiume di fuoco. Sta accadendo{page_break}qualcosa di brutto.{end_wait}"

msgctxt "message"
msgid "07365"
msgstr "Pensa che tragedia{line_break}se fosse{line_break}successo qui!{end_wait}"

msgctxt "message"
msgid "07366"
msgstr "Pare che il vulcano del{line_break}Monte Aleph abbia tagliato il{line_break}continente in due parti!{page_break}L'eruzione del è stata{line_break}talmente potente da spezzare{line_break}in due un continente.{end_wait}"

msgctxt "message"
msgid "07367"
msgstr "Ma è un bene che si sia{line_break}aperta quell'enorme{line_break}crepa.{page_break}Altrimenti la lava{line_break}sarebbe giunta{line_break}fin qui!{end_wait}"

msgctxt "message"
msgid "07368"
msgstr "Ultimamente abbiamo{line_break}avuto pochi clienti.{page_break}Credo che oggi{line_break}chiuderò prima.{end_wait}"

msgctxt "message"
msgid "07369"
msgstr "Perché dovrei tenere il{line_break}negozio aperto se non{line_break}ci sono clienti?{end_wait}"

msgctxt "message"
msgid "07370"
msgstr "Pare che ci siano stati{line_break}parecchi terremoti sul{line_break}Monte Aleph ultimamente.{end_wait}"

msgctxt "message"
msgid "07371"
msgstr "Ho lucidato la statua{line_break}d'oro che ci avete{line_break}restituito.{page_break}Ora è così splendente che{line_break}non la riconoscereste!{end_wait}"

msgctxt "message"
msgid "07372"
msgstr "Spero che i terremoti non{line_break}preannuncino qualcosa{line_break}di peggio...{end_wait}"

msgctxt "message"
msgid "07373"
msgstr "Quella statua d'oro ora{line_break}è pulitissima.{line_break}Ciò mi rende felice.{end_wait}"

msgctxt "message"
msgid "07374"
msgstr "Niente da fare, niente{line_break}da fare! Che brutta situazione!{page_break}Con il vulcano e tutto quello{line_break}che è successo, nessuno{line_break}viene al villaggio.{end_wait}"

msgctxt "message"
msgid "07375"
msgstr "D'inverno non arrivano{line_break}molti viaggiatori.{page_break}La primavera{line_break}sembra così{line_break}lontana...{end_wait}"

msgctxt "message"
msgid "07376"
msgstr "Ho ancora parecchi ossi{line_break}avanzati dalla cena.{line_break}Ne vuoi un po'?{end_now}"

msgctxt "message"
msgid "07377"
msgstr "Sì? Bene!{line_break}Prendine quanti{line_break}ne vuoi.{end_wait}"

msgctxt "message"
msgid "07378"
msgstr "Beh, hai ragione.{line_break}Per crescere, un ragazzino{line_break}non può vivere solo di ossi.{end_wait}"

msgctxt "message"
msgid "07379"
msgstr "Hai visto? Il tetto è stato{line_break}finalmente riparato.{end_wait}"

msgctxt "message"
msgid "07380"
msgstr "Nessuno vuol venire a passare{line_break}la notte qui? Accettiamo{line_break}anche i ladri!{end_wait}"

msgctxt "message"
msgid "07381"
msgstr "Dopo aver fatto questo{line_break}lavoro per un po'{line_break}s'inizia a capire...{page_break}Gli affari vanno male per un{line_break}po', ma poi si riprendono.{end_wait}"

msgctxt "message"
msgid "07382"
msgstr "Gli piacciono proprio gli ossi.{line_break}Hmmm... Non vorrei che avesse{line_break}carenza di calcio.{end_wait}"

msgctxt "message"
msgid "07383"
msgstr "Con questa, ho fatto{line_break}tutte le riparazioni.{line_break}E adesso?{end_wait}"

msgctxt "message"
msgid "07384"
msgstr "Mi hanno messo qui perché{line_break}ho picchiato qualcuno. È{line_break}stato un colpo di testa...{end_wait}"

msgctxt "message"
msgid "07385"
msgstr "Devo imparare a controllare{line_break}il mio temperamento.{end_wait}"

msgctxt "message"
msgid "07386"
msgstr "Volete{pause_20_skippable} andare{line_break}a Tolbi?{end_now}"

msgctxt "message"
msgid "07387"
msgstr "Non potete proseguire{line_break}sulla Strada della Seta.{page_break}Se andate a Tolbi,{line_break}dovrete passare per{line_break}il Mare di Karagol.{end_wait}"

msgctxt "message"
msgid "07388"
msgstr "Capisco. {pause_20_skippable}Beh, allora{line_break}perché non vi fate un{line_break}bel giro in nave?{end_wait}"

msgctxt "message"
msgid "07389"
msgstr "È un bel guaio: la{line_break}Strada della Seta è{line_break}chiusa, e il biglietto{page_break}della nave è{line_break}troppo caro.{end_wait}"

msgctxt "message"
msgid "07390"
msgstr "La Strada della Seta è{line_break}chiusa poco più{line_break}avanti.{page_break}Tutti quelli che provano{line_break}a proseguire ritornano{line_break}presto indietro.{end_wait}"

msgctxt "message"
msgid "07391"
msgstr "Prendete{line_break}la nave?{end_now}"

msgctxt "message"
msgid "07392"
msgstr "Quando attraccate a Tolbi,{line_break}potete riferire per favore{line_break}un messaggio a mia figlia?{page_break}Sua mamma le manda a dire che{line_break}non può andarla a trovare{line_break}perché i biglietti sono cari.{end_wait}"

msgctxt "message"
msgid "07393"
msgstr "Ah, è così? {pause_20_skippable}Beh,{line_break}chiederò a{line_break}qualcun altro.{end_wait}"

msgctxt "message"
msgid "07394"
msgstr "Ora che la Strada della Seta{line_break}è chiusa, devono andare{line_break}tutti in nave.{page_break}Il capitano si fa un{line_break}mucchio di soldi.{end_wait}"

msgctxt "message"
msgid "07395"
msgstr "Non posso credere che i{line_break}biglietti siano così cari.{page_break}Dopo tutta questa strada,{line_break}scopriamo che la Strada della{line_break}Seta è chiusa.{page_break}Beh, ormai è troppo tardi{line_break}per tornare indietro.{end_wait}"

msgctxt "message"
msgid "07396"
msgstr "Ah, è perfetto! Il Colossum{line_break}sta per iniziare e la Strada{line_break}della Seta è chiusa!{page_break}Mia figlia ha lasciato Tolbi{line_break}per incontrarci al molo.{line_break}Che tristezza...{end_wait}"

msgctxt "message"
msgid "07397"
msgstr "Abbiamo aspettato per un{line_break}anno questo evento, e guarda{line_break}cosa va a succedere!{end_wait}"

msgctxt "message"
msgid "07398"
msgstr "Volete i biglietti{line_break}per la nave?{end_now}"

msgctxt "message"
msgid "07399"
msgstr "Se volete prendere{line_break}la nave vi serve{line_break}il biglietto.{end_wait}"

msgctxt "message"
msgid "07400"
msgstr "Vediamo... Siete in quattro,{line_break}quindi in tutto fanno{line_break}{argument_signed_number} monete. Va bene?{end_now}"

msgctxt "message"
msgid "07401"
msgstr "Non{pause_20_skippable} prendete la nave?{line_break}Se non salite a bordo non{line_break}potete andare a Tolbi.{end_wait}"

msgctxt "message"
msgid "07402"
msgstr "Oh oh...{pause_20_skippable} Non avete{line_break}abbastanza soldi... Non posso{line_break}vendervi il biglietto.{end_wait}"

msgctxt "message"
msgid "07403"
msgstr "Oh oh...{pause_20_skippable} Avete troppi{line_break}strumenti... Non posso{line_break}vendervi il biglietto.{page_break}Organizzate i vostri{line_break}strumenti e poi tornate{line_break}da me.{end_wait}"

msgctxt "message"
msgid "07404"
msgstr "Bene, ecco i vostri{line_break}biglietti.{end_wait}"

msgctxt "message"
msgid "07405"
msgstr "Consegnate il biglietto{line_break}salendo sulla nave.{end_wait}"

msgctxt "message"
msgid "07406"
msgstr "È strano... L'altra{pause_20_skippable}{line_break}nave non è{line_break}ancora qui!{end_wait}"

msgctxt "message"
msgid "07407"
msgstr "Dopo aver superato il{line_break}Karagol raggiungeremo Tolbi.{line_break}Che emozione.{end_wait}"

msgctxt "message"
msgid "07408"
msgstr "Mi sento quasi in colpa di{line_break}dover far pagare così tanto{line_break}per i biglietti.{end_wait}"

msgctxt "message"
msgid "07409"
msgstr "Se avete già il biglietto{line_break}affrettatevi a salire{line_break}a bordo.{end_wait}"

msgctxt "message"
msgid "07410"
msgstr "La nave non partirà prima{line_break}che arrivi l'altra.{line_break}È così che funziona.{page_break}Dubito che salperemo prima{line_break}che l'altra sia{line_break}arrivata qui.{end_wait}"

msgctxt "message"
msgid "07411"
msgstr "Dobbiamo sbrigarci! Il{line_break}festival non aspetta noi...{page_break}Non sarà che mio marito ha{line_break}deciso di non portarmici{line_break}quest'anno?{end_wait}"

msgctxt "message"
msgid "07412"
msgstr "Oggi dovrebbero esserci{line_break}molti turisti sulla nave.{line_break}Il controllo dei biglietti{page_break}inizierà quando saranno{line_break}arrivati i partecipanti{line_break}della gita.{end_wait}"

msgctxt "message"
msgid "07413"
msgstr "Finché non arriva il gruppo{line_break}di turisti, si può salire{line_break}liberamente sulla nave.{end_wait}"

msgctxt "message"
msgid "07414"
msgstr "Con tutti questi passeggeri,{line_break}oggi il capitano è{line_break}di buon umore.{end_wait}"

msgctxt "message"
msgid "07415"
msgstr "Il capitano è di buon umore,{line_break}perciò ha reso possibile a{line_break}tutti visitare la nave.{page_break}È magnifico!{end_wait}"

msgctxt "message"
msgid "07416"
msgstr "Biglietti, prego!{line_break}Mostratemi i biglietti.{end_wait}"

msgctxt "message"
msgid "07417"
msgstr "Senza il biglietto non{line_break}si può salire a bordo.{page_break}Dovete andare ad{line_break}acquistarlo.{end_wait}"

msgctxt "message"
msgid "07418"
msgstr "Grazie.{line_break}Salite a bordo, salperemo{line_break}fra poco.{end_wait}"

msgctxt "message"
msgid "07419"
msgstr "Dopo aver consegnato il{line_break}biglietto potete{line_break}salire a bordo.{end_wait}"

msgctxt "message"
msgid "07420"
msgstr "Stiamo per salpare:{line_break}attendete{line_break}a bordo.{end_wait}"

msgctxt "message"
msgid "07421"
msgstr "Se avete i biglietti,{line_break}consegnateglieli e{line_break}salite a bordo.{end_wait}"

msgctxt "message"
msgid "07422"
msgstr "Non sappiamo quando{line_break}salperemo.{line_break}Chiedete al capitano.{end_wait}"

msgctxt "message"
msgid "07423"
msgstr "La Strada della Seta è{line_break}bloccata, quindi la nave{line_break}oggi è piena.{end_wait}"

msgctxt "message"
msgid "07424"
msgstr "L'altra nave non è ancora{line_break}arrivata, quindi non possiamo{line_break}ancora salpare.{end_wait}"

msgctxt "message"
msgid "07425"
msgstr "Salite a bordo e attendete{line_break}la partenza.{end_wait}"

msgctxt "message"
msgid "07426"
msgstr "Volete scendere{line_break}a terra?{end_now}"

msgctxt "message"
msgid "07427"
msgstr "Passate pure.{end_wait}"

msgctxt "message"
msgid "07428"
msgstr "Salperemo presto,{line_break}quindi salite{line_break}sulla nave.{end_wait}"

msgctxt "message"
msgid "07429"
msgstr "Quando avete finito,{line_break}vi prego di{line_break}imbarcarvi.{end_wait}"

msgctxt "message"
msgid "07430"
msgstr "Con tutti questi{line_break}passeggeri... non so se{line_break}potremo imbarcarci.{page_break}Ho qualche{line_break}dubbio...{end_wait}"

msgctxt "message"
msgid "07431"
msgstr "La nave partita da Tolbi{line_break}a quest'ora dovrebbe{line_break}già essere arrivata...{page_break}Che sia successo{line_break}qualcosa mentre{line_break}attraversava il Karagol.{end_wait}"

msgctxt "message"
msgid "07432"
msgstr "Mi chiedo cosa possa{line_break}essere successo.{end_wait}"

msgctxt "message"
msgid "07433"
msgstr "Vuoi ancora attraversare{line_break}questo mare{line_break}pericoloso?{end_wait}"

msgctxt "message"
msgid "07434"
msgstr "Sarebbe un peccato{line_break}perdere tutti questi{line_break}passeggeri...{end_wait}"

msgctxt "message"
msgid "07435"
msgstr "Kaja, cosa dicono{line_break}i rematori?{end_wait}"

msgctxt "message"
msgid "07436"
msgstr "Non hanno paura... Non{line_break}ci sono problemi con loro.{page_break}È solo che...{end_wait}"

msgctxt "message"
msgid "07437"
msgstr "\"È solo che\" cosa?{end_wait}"

msgctxt "message"
msgid "07438"
msgstr "È solo che se appare un{line_break}gruppo di... quelli mentre{line_break}attraversiamo il mare, non{page_break}so se potrò affrontarli{line_break}da solo.{end_wait}"

msgctxt "message"
msgid "07439"
msgstr "Dovrai farlo, Kaja. Tu sei{line_break}l'unico che posso{line_break}far lottare.{end_wait}"

msgctxt "message"
msgid "07440"
msgstr "Come sai,{pause_20_skippable} i rematori{line_break}non potranno combattere:{line_break}saranno occupati a remare.{end_wait}"

msgctxt "message"
msgid "07441"
msgstr "OK... Lo farò...{end_wait}"

msgctxt "message"
msgid "07442"
msgstr "Non abbiamo tempo per{line_break}assoldare dei mercenari...{line_break}È troppo tardi ora.{end_wait}"

msgctxt "message"
msgid "07443"
msgstr "Ma non possiamo far salpare{line_break}la nave senza arruolare{line_break}altri guerrieri.{end_wait}"

msgctxt "message"
msgid "07444"
msgstr "Mi domando se non ci siano{line_break}altri guerrieri affidabili{line_break}qui in giro.{end_wait}"

msgctxt "message"
msgid "07445"
msgstr "È un'occasione per guadagnare{line_break}qualcosa... Sarebbe un peccato{line_break}farcela sfuggire.{end_wait}"

msgctxt "message"
msgid "07446"
msgstr "Far partire una nave in{line_break}queste condizioni.. È come{line_break}una condanna a morte.{end_wait}"

msgctxt "message"
msgid "07447"
msgstr "Se non salpiamo ora, sarebbe{line_break}come ammettere che hai{line_break}paura, Kaja...{page_break}E ciò non accadrà.{line_break}Non permetterò che accada.{end_wait}"

msgctxt "message"
msgid "07448"
msgstr "Te l'ho detto che{line_break}stavamo partendo.{page_break}Sta arrivando{line_break}l'altra nave!{end_wait}"

msgctxt "message"
msgid "07449"
msgstr "Se non partiamo subito{line_break}il Colossum inizierà{line_break}senza di noi!{page_break}Te la senti di accettare{line_break}la responsabilità di{line_break}arrivare tardi al Colossum?{end_wait}"

msgctxt "message"
msgid "07450"
msgstr "Mi chiedo cosa stia{line_break}accadendo: abbiamo atteso{line_break}troppo a lungo!{end_wait}"

msgctxt "message"
msgid "07451"
msgstr "Mi chiedo se sono solo{line_break}io ad aver deciso di andare{line_break}a Tolbi per il Colossum...{end_wait}"

msgctxt "message"
msgid "07452"
msgstr "Il Karagol è come un{line_break}enorme lago circondato{line_break}dalla terra.{page_break}Quindi non ci sono onde,{line_break}ma l'acqua è salata, come{line_break}in un vero e proprio mare.{end_wait}"

msgctxt "message"
msgid "07453"
msgstr "\"Quando partiamo?{line_break}Quando partiamo?\" Il ragazzo{line_break}è così impaziente...{end_wait}"

msgctxt "message"
msgid "07454"
msgstr "È così{line_break}frustrante...{page_break}Perché qualcuno non mi{line_break}dice cosa sta accadendo?{end_wait}"

msgctxt "message"
msgid "07455"
msgstr "In nave si fa prima che a{line_break}piedi; non c'è bisogno{line_break}di correre.{end_wait}"

msgctxt "message"
msgid "07456"
msgstr "Quasi tutti quelli diretti{line_break}al Colossum sono partiti{line_break}molto tempo fa.{end_wait}"

msgctxt "message"
msgid "07457"
msgstr "Oggi il Mare di Karagol è{line_break}pieno di nebbia; mi{line_break}preoccupa un po'...{end_wait}"

msgctxt "message"
msgid "07458"
msgstr "Non c'è altro da fare...{line_break}Salpiamo!{end_wait}"

msgctxt "message"
msgid "07459"
msgstr "Ma che dici?{line_break}Se salpiamo{page_break}ora, non arriveremo{line_break}mai più a Tolbi.{end_wait}"

msgctxt "message"
msgid "07460"
msgstr "Non correremo rischi...{line_break}Abbiamo un amuleto{line_break}portafortuna!{end_wait}"

msgctxt "message"
msgid "07461"
msgstr "Un amuleto...{pause_20_skippable} Capisco...{line_break}Intendi quel piccolo{line_break}ciondolo a forma d'ancora?{end_wait}"

msgctxt "message"
msgid "07462"
msgstr "Quella piccola ancora ci ha{line_break}sempre protetti da{line_break}ogni pericolo.{end_wait}"

msgctxt "message"
msgid "07463"
msgstr "Capitano, non scherzare!{line_break}Questa è stupida{line_break}superstizione!{end_wait}"

msgctxt "message"
msgid "07464"
msgstr "Andrà tutto bene, vedrai.{line_break}Anche se non troveremo{line_break}mercenari che ci difendano,{page_break}quel piccolo ciondolo{line_break}ci proteggerà.{end_wait}"

msgctxt "message"
msgid "07465"
msgstr "E va bene, andiamo!{line_break}Prepariamoci a salpare!{end_wait}"

msgctxt "message"
msgid "07466"
msgstr "È grandioso...{pause_20_skippable}{line_break}Stiamo per salpare!{end_wait}"

msgctxt "message"
msgid "07467"
msgstr "(Non ne sarei{line_break}troppo convinto.){end_wait}"

msgctxt "message"
msgid "07468"
msgstr "Siamo in partenza, ci{line_break}scusiamo per il{line_break}ritardo.{page_break}Rilassatevi e godetevi{line_break}il viaggio. Salperemo{line_break}fra pochissimo.{end_wait}"

msgctxt "message"
msgid "07469"
msgstr "Se fosse una nave come si{line_break}deve, saremmo già partiti.{page_break}Adesso chissà quando{line_break}arriveremo a Tolbi...{end_wait}"

msgctxt "message"
msgid "07470"
msgstr "Finché abbiamo il nostro{line_break}piccolo ciondolo ad ancora{line_break}non c'è nulla da temere.{page_break}Ci stiamo ancora preparando{line_break}alla partenza?{end_wait}"

msgctxt "message"
msgid "07471"
msgstr "Ci sono dei mostri{line_break}là fuori... Se non saremo{line_break}preparati, ci distruggeranno!{page_break}Diamine!{line_break}Se solo avessimo{line_break}qualche forte guerriero...{end_wait}"

msgctxt "message"
msgid "07472"
msgstr "Più rimaniamo{line_break}qui e più siamo{line_break}preoccupati...{page_break}Chissà se riusciremo{line_break}a partecipare{line_break}al Colossum.{end_wait}"

msgctxt "message"
msgid "07473"
msgstr "A quanto pare, non possiamo{line_break}prendere la Strada della{line_break}Seta come previsto.{page_break}Quindi noi siamo gli unici{line_break}passeggeri che hanno potuto{line_break}pagare il prezzo del biglietto.{end_wait}"

msgctxt "message"
msgid "07474"
msgstr "Al piano di sotto ci sono{line_break}parecchi uomini{line_break}muscolosi.{page_break}Sono i rematori, vero,{line_break}quelli che fanno muovere{line_break}la barca?{end_wait}"

msgctxt "message"
msgid "07475"
msgstr "State andando a Tolbi{line_break}per il Colossum,{line_break}vero?{page_break}Dopo aver visto il Colossum,{line_break}tutti gli altri festival{line_break}vi sembreranno ridicoli.{end_wait}"

msgctxt "message"
msgid "07476"
msgstr "Temo che per{line_break}quest'anno il Colossum{line_break}potrò scordarmelo...{end_wait}"

msgctxt "message"
msgid "07477"
msgstr "Si stanno soltanto{line_break}approfittando di noi{page_break}vendendo i biglietti a{line_break}così caro prezzo.{end_wait}"

msgctxt "message"
msgid "07478"
msgstr "Muscoli straripanti{line_break}ovunque...{line_break}Che spettacolo!{page_break}Al Colossum ce ne saranno{line_break}molti altri così{line_break}palestrati, vero?{end_wait}"

msgctxt "message"
msgid "07479"
msgstr "Abbiamo lasciato la vecchia{line_break}a casa... Ora potremo{line_break}divertirci al Colossum.{end_wait}"

msgctxt "message"
msgid "07480"
msgstr "Se non salpiamo{line_break}immediatamente scendo{line_break}dalla nave!{end_wait}"

msgctxt "message"
msgid "07481"
msgstr "Sì, ma...{pause_20_skippable} partiremo{line_break}prestissimo, abbiate un po'{line_break}di pazienza.{end_wait}"

msgctxt "message"
msgid "07482"
msgstr "Che vuol dire \"prestissimo\"?{end_wait}"

msgctxt "message"
msgid "07483"
msgstr "Voglio sapere cosa vuol{line_break}dire \"prestissimo\"!{end_wait}"

msgctxt "message"
msgid "07484"
msgstr "Vuoi sapere quando.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}{line_break}Beh...{end_wait}"

msgctxt "message"
msgid "07485"
msgstr "Vogliamo andare{line_break}al Colossum.{end_wait}"

msgctxt "message"
msgid "07486"
msgstr "Sai, il mio amico{line_break}Ouranos ha paura{line_break}di viaggiare in nave.{end_wait}"

msgctxt "message"
msgid "07487"
msgstr "Ouranos? Ma è enorme!{end_wait}"

msgctxt "message"
msgid "07488"
msgstr "Non ho paura...{line_break}Soltanto, non mi{line_break}piace l'acqua...{end_wait}"

msgctxt "message"
msgid "07489"
msgstr "Preferirei essere morso{line_break}da ragni velenosi piuttosto{line_break}che andare per mare.{end_wait}"

msgctxt "message"
msgid "07490"
