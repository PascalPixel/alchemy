"Daos prisa...{end_wait}"

msgctxt "message"
msgid "09870"
msgstr ""
"¡Hasta los soldados insisten,\n"
"{actor_name:1}! ¡Vámonos!{end_wait}"

msgctxt "MsgLaliveroUhhnnWeWereTakenBySurprise"
msgid "09871"
msgstr ""
"{text_effect:4}Mmmmm...{reset_text_style} Nos han\n"
