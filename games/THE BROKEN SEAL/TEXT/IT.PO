msgctxt "message"
msgid "07770"
msgstr "{text_effect:4}Nooooo!{pause_20_skippable}{reset_text_style} Non vorrai{line_break}mica chiedermi di remare, vero?{end_now}"

msgctxt "message"
msgid "07771"
