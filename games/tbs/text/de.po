"Aber es geht mir besser. {pause_20_skippable}{pause_20_skippable}\n"
"{text_effect:4}Hust...{reset_text_style}{pause_20_skippable} Sieh doch!"

#, alchemy-end-wait
msgctxt "message"
msgid "07255"
msgstr "Siehst du?{pause_20_skippable} Es geht mir gut!"

#, alchemy-end-wait
msgctxt "message"
msgid "07256"
msgstr ""
"Mach dir wegen mir keine\n"
"Sorgen. Geh nur! Gib dein\n"
"Bestes,{page_break}"
