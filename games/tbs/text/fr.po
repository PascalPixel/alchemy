#, alchemy-end-wait
msgctxt "message"
msgid "10278"
msgstr ""
"Après tout cela, tu n'as\n"
"pas le courage de tout\n"
"dire à {actor_name:6}?"

#, alchemy-end-wait
msgctxt "message"
msgid "10279"
msgstr ""
"Si tu ne lui racontes pas\n"
