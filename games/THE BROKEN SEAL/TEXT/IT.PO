msgctxt "message"
msgid "07750"
msgstr "{text_effect:4}Non m'importa di cosa{line_break}accadrà, voglio solo{line_break}smettere di remare.{end_wait}"

msgctxt "message"
msgid "07751"
msgstr "I mostri marini sono{line_break}orribilmente feroci!{end_wait}"

msgctxt "message"
msgid "07752"
msgstr "Se fossi un guerriero,{line_break}non mi farei battere da{line_break}un mostro così!{end_wait}"

msgctxt "message"
msgid "07753"
msgstr "Chissà se questo guerriero{line_break}sarà così determinato da{line_break}sconfiggere un mostro.{end_wait}"

msgctxt "message"
msgid "07754"
