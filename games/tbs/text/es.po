"contar conmigo!{end_wait}"

msgctxt "message"
msgid "10570"
msgstr ""
"Pues hemos ganado...\n"
"¿Te he servido de algo?{end_wait}"

msgctxt "message"
msgid "10571"
msgstr ""
"Por un segundo, pensé que\n"
"habíamos perdido. ¡Pero ganamos!{page_break}"
"¡Mis ruegos fueron\n"
"escuchados!{end_wait}"

msgctxt "message"
msgid "10572"
msgstr "?"

msgctxt "message"
msgid "10573"
msgstr "¡Ganamos!{end_wait}"

msgctxt "MsgLobbyWonWithoutWell"
msgid "10574"
msgstr ""
"¿Qué? ¿Habéis\n"
