msgctxt "message"
msgid "03685"
msgstr "Dai, ragazzi!{pause_20_skippable} Correte!{line_break}Ci siete quasi!{end_wait}"

msgctxt "message"
msgid "03686"
msgstr "Dai, {actor_name:1}! Il{line_break}macigno sta per cadere!{end_wait}"

msgctxt "message"
msgid "03687"
msgstr "La frana... il recinto{line_break}distrutto... mostri{line_break}dappertutto...{end_wait}"

msgctxt "message"
msgid "03688"
msgstr "Sono{pause_20_skippable} ferito...{line_break}Credi che sia spacciato?{end_now}"

msgctxt "message"
msgid "03689"
msgstr "Come pensavo...{pause_20_skippable}{line_break}È finita per me.{line_break}Salvatevi almeno voi...{end_wait}"

msgctxt "message"
msgid "03690"
msgstr "È orribile.{line_break}Non mi resta che attendere{line_break}che i mostri...{end_wait}"

msgctxt "message"
msgid "03691"
