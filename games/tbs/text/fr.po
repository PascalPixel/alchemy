#, alchemy-end-wait
msgctxt "MsgLunpaSomeonePunishDodonpa"
msgid "09274"
msgstr ""
"Si quelqu'un voulait bien\n"
"punir Dodonpa, je suis\n"
"sûre que Donpa offrirait{page_break}"
