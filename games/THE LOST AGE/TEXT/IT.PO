msgctxt "message"
msgid "06869"
msgstr "Andate a sudest in{line_break}Osenia, e incontrerete{line_break}Mikasalla.{page_break}È un piccolo villaggio, però.{line_break}Probabilmente non ci sarà{line_break}niente di interessante.{end_wait}"

msgctxt "message"
msgid "06870"
msgstr "Se attraversate l'Osenia{line_break}verso Alhafra, incontrerete{line_break}il Deserto dello Yampi.{page_break}Meglio che evitiate il{line_break}deserto e seguite la costa{line_break}fino ad Alhafra.{end_wait}"

msgctxt "message"
msgid "06871"
