#, alchemy-end-wait
msgctxt "message"
msgid "10281"
msgstr "Qu'est-ce qu'il y a, {actor_name:2}?"

#, alchemy-end-wait
msgctxt "message"
msgid "10282"
msgstr ""
"Je me demandais...{pause_20_skippable}{pause_20_skippable}\n"
"Comment sommes-nous\n"
"sensés descendre?"

#, alchemy-end-wait
msgctxt "message"
msgid "10283"
msgstr ""
"Tu marques un point.{pause_20_skippable}\n"
