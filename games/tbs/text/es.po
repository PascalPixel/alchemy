"¡Increíble!{end_wait}"

msgctxt "MsgLaliveroNoTrespassingDangerBeyondThisPoint"
msgid "10409"
msgstr ""
"Prohibido el\n"
"paso. Peligro.{end_wait}"

msgctxt "MsgLaliveroIAmAllHealedNowBut"
msgid "10410"
msgstr ""
"Ya estoy curado del todo,\n"
