#, alchemy-end-wait
msgctxt "message"
msgid "10320"
msgstr ""
"Une mystique...\n"
"Qu'est-ce que c'est?"

#, alchemy-end-wait
msgctxt "message"
msgid "10321"
msgstr "Et bien..."

#, alchemy-end-wait
msgctxt "message"
msgid "10322"
msgstr ""
"C'est quelqu'un qui a\n"
"le même genre de pouvoirs\n"
"qu'eux."

#, alchemy-end-wait
msgctxt "message"
msgid "10323"
msgstr ""
"{actor_name:1}, tes amis et toi\n"
