"estuvieran conectadas con\n"
"el Faro de Venus.{end_wait}"

msgctxt "MsgLaliveroInteriorsWillTheyContinueOnOrQuit"
msgid "10436"
msgstr ""
"¿Van a continuar o van a\n"
