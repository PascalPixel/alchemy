msgctxt "message"
msgid "08804"
msgstr "Qu'y a-t-il,{line_break}{actor_name:1}?{end_wait}"

msgctxt "message"
msgid "08805"
msgstr "Quoi? Tu as combattu{line_break}dans les finales?{end_wait}"

msgctxt "message"
msgid "08806"
