msgctxt "message"
msgid "10614"
msgstr "Tutti i guerrieri sono{line_break}molto forti... Prima di{line_break}iniziare ho una tensione!{end_wait}"

msgctxt "message"
msgid "10615"
msgstr "Se partecipassi mi{line_break}potrei fare male,{line_break}e sarebbe stupido...{end_wait}"

msgctxt "message"
msgid "10616"
msgstr "È una minestra con{page_break}l'uovo. Le uova fresche{line_break}la rendono saporita.{end_wait}"

msgctxt "message"
msgid "10617"
msgstr "Un'omelette!{page_break}Nelle omelette di Bilibin{line_break}ci sono funghi selvatici{line_break}della zona.{end_wait}"

msgctxt "message"
msgid "10618"
msgstr "C'è un libro intitolato{line_break}\"Tutto sugli strumenti\".{page_break}Secondo questo libro, nel{line_break}mondo ci sono molti{line_break}strumenti sconosciuti.{end_wait}"

msgctxt "message"
msgid "10619"
msgstr "È un piatto di semolino.{page_break}La miglior cosa se{line_break}si è ammalati!{end_wait}"

msgctxt "message"
msgid "10620"
msgstr "È uno stufato piccante.{page_break}Riscalda il corpo {text_effect:2}e{reset_text_style}{line_break}l'anima.{end_wait}"

msgctxt "message"
msgid "10621"
msgstr "Stanno friggendo qualcosa.{page_break}Il cavolo sembra{line_break}stranamente appetitoso.{end_wait}"

msgctxt "message"
msgid "10622"
msgstr "È il piatto speciale di Xian,{line_break}il miglior cibo del mondo!{page_break}Sembra così appetitoso{line_break}che la sua bontà non è{line_break}neppure immaginabile.{end_wait}"

msgctxt "message"
msgid "10623"
msgstr "Sono ravioli al vapore.{page_break}Sono fumanti!{end_wait}"

msgctxt "message"
msgid "10624"
msgstr "{actor_name:1} e i suoi compagni{line_break}sono esterrefatti!{page_break}Non hanno mai visto{line_break}simili ingredienti!{end_wait}"

msgctxt "message"
msgid "10625"
msgstr "Sta facendo una zuppa{line_break}di fagioli. Dev'essere{page_break}buona con il riso...{end_wait}"

msgctxt "message"
msgid "10626"
msgstr "Ci sono molte{line_break}bacchette...{page_break}...ma neppure{line_break}un cucchiaio.{end_wait}"

msgctxt "message"
msgid "10627"
msgstr "Ci sono erbe{line_break}medicinali...{page_break}Molto{line_break}profumate...{end_wait}"

msgctxt "message"
msgid "10628"
msgstr "C'è un kimono.{page_break}Dev'essere usato come{line_break}camicia da notte dagli{line_break}ospiti della locanda.{end_wait}"

msgctxt "message"
msgid "10629"
msgstr "È un libro contabile...{page_break}Ci sono colonne{line_break}di cifre.{line_break}Piuttosto noioso...{end_wait}"

msgctxt "message"
msgid "10630"
msgstr "Le pentole e le padelle{line_break}sono arrugginite...{end_wait}"

msgctxt "message"
msgid "10631"
msgstr "Sta cuocendo un{line_break}arrosto.{page_break}Persino le spezie{line_break}sembrano appetitose!{end_wait}"

msgctxt "message"
msgid "10632"
msgstr "Sta facendo gamberetti{line_break}in salsa di chili.{page_break}Quei gamberetti sembrano{line_break}deliziosi...{line_break}Che acquolina...{end_wait}"

msgctxt "message"
msgid "10633"
msgstr "C'è un libro intitolato{line_break}\"Altin: il paese{line_break}delle miniere.\"{page_break}Il libro dice che le miniere{line_break}di Altin sono famose per{line_break}le loro fantastiche gemme.{end_wait}"

msgctxt "message"
msgid "10634"
msgstr "Sta scaldando del pane.{page_break}Che buon profumo!{end_wait}"

msgctxt "message"
msgid "10635"
msgstr "Sta preparando il curry.{page_break}Il buon profumo fa venire{line_break}l'acquolina in bocca.{end_wait}"

msgctxt "message"
msgid "10636"
msgstr "Sta cuocendo melanzane{line_break}con il formaggio.{page_break}È proprio da provare...{line_break}Melanzane col formaggio...{line_break}Che strano abbinamento!{end_wait}"

msgctxt "message"
msgid "10637"
msgstr "È un'insalata di Kalay{line_break}con yogurt e cetrioli.{page_break}Chissà che{line_break}gusto ha!{end_wait}"

msgctxt "message"
msgid "10638"
msgstr "Sono sottaceti con l'aglio.{page_break}I sottaceti sono famosi{line_break}a Kalay, ma nessuno{line_break}sa perché...{end_wait}"

msgctxt "message"
msgid "10639"
msgstr "Sta facendo la pizza{line_break}di Tolbi, famosa in{page_break}tutto il mondo...{line_break}Ehi, sta bruciando{line_break}qualcosa!{end_wait}"

msgctxt "message"
msgid "10640"
msgstr "Sta facendo la{line_break}pasta.{page_break}Ma la sta facendo{line_break}cuocere troppo...{end_wait}"

msgctxt "message"
msgid "10641"
msgstr "Sono gli spaghetti allo{page_break}scoglio di Tolbi, con olio{line_break}d'oliva e basilico!{end_wait}"

msgctxt "message"
msgid "10642"
msgstr "Sembra un'armatura pesante...{page_break}Forse appartiene ad{line_break}uno dei guerrieri{line_break}del Colossum.{end_wait}"

msgctxt "message"
msgid "10643"
msgstr "Qui non c'è niente.{line_break}L'interno è{line_break}completamente vuoto.{page_break}In giro ci sono molti{line_break}dadi non più usati.{end_wait}"

msgctxt "message"
msgid "10644"
msgstr "È una bandana{page_break}C'è scritto... \"Non{line_break}arrenderti mai!\"{end_wait}"

msgctxt "message"
msgid "10645"
msgstr "C'è un libro intitolato{line_break}\"Il cuore dei guerrieri{line_break}del Colossum\".{page_break}\"Dai il massimo! Non{line_break}giocare alla Scommessa{line_break}fortunata!\" È scritto così.{end_wait}"

msgctxt "message"
msgid "10646"
msgstr "C'è un quaderno con i{line_break}risultati del gioco{line_break}dei dadi...{page_break}Il proprietario del{line_break}quaderno deve aver perso{line_break}parecchi soldi ai dadi.{end_wait}"

msgctxt "message"
msgid "10647"
msgstr "C'è un libro intitolato{line_break}\"Come diventare un macho{line_break}in dodici lezioni\".{page_break}Ai guerrieri piace molto{line_break}il sollevamento pesi.{end_wait}"

msgctxt "message"
msgid "10648"
msgstr "Ehi, è il diario di{page_break}Babi! C'è scritto...{line_break}\"Questo Colossum potrebbe{line_break}essere l'ultimo per me...\"{end_wait}"

msgctxt "message"
msgid "10649"
msgstr "C'è un libro intitolato{line_break}\"Enciclopedia delle{line_break}Antiche Rovine\".{end_wait}"

msgctxt "message"
msgid "10650"
msgstr "C'è un quaderno{line_break}intitolato \"Esperimenti{line_break}d'Alchimia.\"{page_break}\"L'esperimento è di{line_break}nuovo fallito. Devo fare{line_break}parecchie domande a Kraden...\"{end_wait}"

msgctxt "message"
msgid "10651"
msgstr "C'è un quaderno intitolato{line_break}\"Studio delle rovine di{line_break}Venere\"{page_break}\"In qest'area sono sepolte{line_break}moltissime civiltà{line_break}antiche...\"{end_wait}"

msgctxt "message"
msgid "10652"
msgstr "Sta facendo uno{line_break}\"stufato del ladro\"...{page_break}Ha un profumo{line_break}molto tipico.{end_wait}"

msgctxt "message"
msgid "10653"
msgstr "Sta facendo dei{line_break}\"biscottini alla ladresca\".{page_break}Hanno la forma del viso{line_break}di... Dodonpa?!{end_wait}"

msgctxt "message"
msgid "10654"
msgstr "Sta facendo una{line_break}zuppa di mulukhiya.{page_break}Ha un buon sapore{line_break}e fa bene.{end_wait}"

msgctxt "message"
msgid "10655"
msgstr "È una bistecca di{page_break}cactus... Chissà se{line_break}ha un buon sapore...{end_wait}"

msgctxt "message"
msgid "10656"
msgstr "Sta facendo una{line_break}zuppa di funghi.{page_break}A Lalivero ci mettono{line_break}tutti i tipi di fagioli{line_break}e erbe locali.{end_wait}"

msgctxt "message"
msgid "10657"
msgstr "È un'insalata di Lalivero{line_break}con patate e cactus.{page_break}Sembra buona, ma forse{line_break}è un po' spinosa...{line_break}Sì, decisamente spinosa...{end_wait}"

msgctxt "message"
msgid "10658"
msgstr "La pentola è piena di{line_break}uno spezzatino fatto{line_break}con molti ingredienti.{page_break}Sicuramente dà{line_break}energia!{end_wait}"

msgctxt "message"
msgid "10659"
msgstr "Sta friggendo dei pesci{line_break}del fiume. La frittura{page_break}è molto morbida, si{line_break}potrebbero mangiare{line_break}anche le lische!{end_wait}"

msgctxt "message"
msgid "10660"
msgstr "È riso tipico{line_break}della zona.{page_break}È così leggero che{line_break}va bene con{line_break}qualsiasi cibo!{end_wait}"

msgctxt "message"
msgid "10661"
msgstr "Sta facendo il{line_break}pollo arrosto.{page_break}Dal profumo... sembra{line_break}che ci abbia messo{line_break}parecchio aglio.{end_wait}"

msgctxt "message"
msgid "10662"
msgstr "Ci sono due libri intitolati{line_break}\"Viaggio nel continente{line_break}settentrionale dell'Angara\"{page_break}e \"Tutto sul continente{line_break}meridionale del{line_break}Gondowan.\"{page_break}Ora {actor_name:1} sa che{line_break}il Monte Aleph si trova sul{line_break}lato occidentale dell'Angara.{end_wait}"

msgctxt "message"
msgid "10663"
msgstr "C'è un libro intitolato{line_break}\"Le leggi di Vale,\" che{line_break}descrive le usanze di Vale.{page_break}\"Per lasciare il villaggio{line_break}ci vuole un permesso.{page_break}Non mostrare mai la{line_break}Psinergia ai forestieri...\"{end_wait}"

msgctxt "message"
msgid "10664"
msgstr "C'è un libro intitolato{line_break}\"Il grande potere{line_break}della natura.\"{page_break}\"Il suo potere, che supera{line_break}l'umana comprensione, si{line_break}può vedere nelle eruzioni{page_break}o nelle grandi inondazioni...\"{end_wait}"

msgctxt "message"
msgid "10665"
msgstr "C'è un libro intitolato{line_break}\"La Pietra psinergica\".{page_break}\"Toccando una Pietra{line_break}psinergica si recupera{line_break}tutta la Psinergia...\"{end_wait}"

msgctxt "message"
msgid "10666"
msgstr "C'è un quaderno che{line_break}appartiene alla zia{line_break}di {actor_name:6}...{page_break}Ci sono dei disegni fatti{line_break}dalla zia e dalla mamma{line_break}di {actor_name:6} da piccole.{end_wait}"

msgctxt "message"
msgid "10667"
msgstr "C'è un libro intitolato{line_break}\"Per un grande villaggio\".{end_wait}"

msgctxt "message"
msgid "10668"
msgstr "C'è un libro intitolato{line_break}\"Lo studio dell'Alchimia\".{page_break}\"Per capire l'Alchimia{line_break}bisogna comprendere i{line_break}Poteri elementali...\"{page_break}È l'ultima frase{line_break}del libro...{end_wait}"

msgctxt "message"
msgid "10669"
msgstr "C'è un libro intitolato{line_break}\"Alla ricerca dell'antica{line_break}Lemuria\".{end_wait}"

msgctxt "message"
msgid "10670"
msgstr "C'è un libro intitolato{line_break}\"La Fontana di{line_break}Tolbi\".{page_break}\"Alla fontana di Tolbi potete{line_break}provare la vostra fortuna...\"{end_wait}"

msgctxt "message"
msgid "10671"
msgstr "C'è un libro intitolato{line_break}\"Enciclopedia alchemica\".{page_break}\"Tutte le cose si compongono{line_break}di quattro elementi: fuoco,{line_break}acqua, aria, vento...\"{end_wait}"

msgctxt "message"
msgid "10672"
msgstr "C'è un libro intitolato{line_break}\"La leggenda del Monte Aleph\".{page_break}Dice che il nome del monte{line_break}si riferisce all'origine{line_break}di tutte le cose...{end_wait}"

msgctxt "message"
msgid "10673"
msgstr "C'è un libro intitolato{line_break}\"Essere un Adepto\".{page_break}\"Non usare la tua{line_break}Psinergia per fare del male!\"{end_wait}"

msgctxt "message"
msgid "10674"
msgstr "C'è un libro intitolato{line_break}\"Il galateo dei{line_break}viaggiatori\".{page_break}\"È buona norma andare{line_break}sempre a presentarsi al{line_break}sindaco della città\".{end_wait}"

msgctxt "message"
msgid "10675"
msgstr "C'è un libro intitolato{line_break}\"La storia di Vault, Vol 1\".{page_break}Il libro dice che il nome{line_break}proviene da \"stipato{line_break}in un piccolo posto\".{end_wait}"

msgctxt "message"
msgid "10676"
msgstr "C'è un libro intitolato{line_break}\"Le gemme dell'Angara\".{page_break}Non dice nulla della{line_break}roccia che si trova{line_break}sul tavolo.{end_wait}"

msgctxt "message"
msgid "10677"
msgstr "C'è un libro intitolato{line_break}\"Le gemme dell'Angara\".{end_wait}"

msgctxt "message"
msgid "10678"
msgstr "C'è un libro intitolato{line_break}\"L'albero sacro della{line_break}Foresta di Kolima\".{page_break}\"Tret e Laurel sono gli{line_break}spiriti degli alberi sacri{line_break}che proteggono la foresta\".{end_wait}"

msgctxt "message"
msgid "10679"
msgstr "C'è un libro intitolato{line_break}\"Dizionario degli alberi{line_break}e dei fiori\".{page_break}Il libro descrive tutte{line_break}le specie di alberi e{line_break}fiori dell'Angara.{end_wait}"

msgctxt "message"
msgid "10680"
msgstr "C'è un libro intitolato{line_break}\"L'arte del boscaiolo\".{page_break}\"Prima di tagliare un albero{line_break}bisogna conoscere la natura{line_break}e il proprio corpo\".{end_wait}"

msgctxt "message"
msgid "10681"
msgstr "Una vestaglia di seta{line_break}da donna.{page_break}{actor_name:1}! Non è per te!{end_wait}"

msgctxt "message"
msgid "10682"
msgstr "C'è un foglio di carta{line_break}intitolato \"I doni per la mia{page_break}dolce metà\". Sono i regali che{line_break}Lord McCoy ha comprato per{line_break}la moglie. La lista è lunga!{end_wait}"

msgctxt "message"
msgid "10683"
msgstr "C'è un turbante.{page_break}È il simbolo dei{line_break}soldati di Kalay.{end_wait}"

msgctxt "message"
msgid "10684"
msgstr "C'è un libro intitolato{line_break}\"Tu e il commercio\".{page_break}\"La stima reciproca è{line_break}alla base di un{line_break}buon affare\".{end_wait}"

msgctxt "message"
msgid "10685"
msgstr "C'è un libro intitolato{line_break}\"L'ospitalità\".{page_break}\"L'attenzione ai{line_break}dettagli sta alla base{line_break}dell'ospitalità...\"{end_wait}"

msgctxt "message"
msgid "10686"
msgstr "Si sente il rumore dell'{line_break}acqua laggiù in fondo.{end_wait}"

msgctxt "message"
msgid "10687"
msgstr "Non si vede il fondo{line_break}del pozzo. Dev'essere{line_break}profondissimo.{end_wait}"

msgctxt "message"
msgid "10688"
msgstr "Guardando meglio,{line_break}pare che il pozzo{line_break}sia asciutto.{end_wait}"

msgctxt "message"
msgid "10689"
msgstr "È un pozzo pulito,{line_break}molto ben tenuto.{end_wait}"

msgctxt "message"
msgid "10690"
msgstr "È pieno d'acqua{line_break}limpida e fresca.{end_wait}"

msgctxt "message"
msgid "10691"
msgstr "Dal fondo si sentono{line_break}le rane gracidare.{end_wait}"

