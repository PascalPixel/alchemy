#, alchemy-end-wait
msgctxt "message"
msgid "04614"
msgstr ""
"J'ai eu si peur que\n"
"je n'en ai pas dormi\n"
"pendant des jours!"

#, alchemy-end-wait
msgctxt "message"
msgid "04615"
msgstr ""
"Tu es courageux, toi!\n"
"Tu n'es même pas effrayé\n"
"par une éruption!"

#, alchemy-end-wait
msgctxt "MsgVaultMasterHammetAWealthyLandownerAnd"
msgid "04616"
msgstr ""
"Maître Hammet, un riche\n"
