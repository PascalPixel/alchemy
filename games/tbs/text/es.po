"mi vida...{end_wait}"

msgctxt "MsgLaliveroTheExplosionInTheVenusRuins"
msgid "10404"
msgstr ""
"La explosión de las ruinas\n"
"de Venus hizo que el Faro\n"
"de Babi se resquebrajara.{page_break}"
