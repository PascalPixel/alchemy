msgid "08384"
msgstr "Alors, {actor_name:1}?{line_break}Vous avez compris{line_break}les règles des finales?{end_now}"

msgctxt "message"
msgid "08385"
msgstr "Vous remarquerez que{line_break}chaque section a son{line_break}propre surveillant.{end_wait}"

