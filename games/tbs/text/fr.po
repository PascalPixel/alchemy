"monstre?"

#, alchemy-end-wait
msgctxt "message"
msgid "09317"
msgstr ""
"Il a voulu faire\n"
"un mauvais tour!"

#, alchemy-end-wait
msgctxt "message"
msgid "09318"
msgstr ""
"Quand Dodonpa a vu\n"
