# Alchemy's source layout (S3), as pret's: four spaces, no tabs.
BasedOnStyle: LLVM
DisableFormat: false
UseTab: Never
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 100
BreakBeforeBraces: Allman
SpaceBeforeParens: ControlStatements
IndentCaseLabels: false
IndentPPDirectives: None
SortIncludes: Never
IncludeBlocks: Preserve
ReflowComments: false
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AlignAfterOpenBracket: DontAlign
AlignConsecutiveDeclarations: Consecutive
AlignEscapedNewlines: Left
PointerAlignment: Right
BreakBeforeBinaryOperators: NonAssignment
# Braced initializer lists keep a space inside each brace, { 1, 2 }, as C
# tables are written here, rather than C++11's {1, 2}.
Cpp11BracedListStyle: false
# The integer types the games define, so that a cast such as (u32)&x is read
# as a cast and not as a bitwise and.
TypeNames: [s8, u8, s16, u16, s32, u32, s64, u64]
