msgctxt "message"
msgid "08781"
msgstr "Le faire entrer dans les{line_break}finales est une insulte{line_break}pour tous ceux qui ont{page_break}passé les éliminatoires!{end_wait}"

msgctxt "message"
msgid "08782"
