msgctxt "message"
msgid "03552"
msgstr "Per la riparazione{line_break}dovrai pagarmi{page_break}{argument_signed_number} monet{control:13}{end_wait}.{line_break}Che ne dici?{end_now}"

msgctxt "message"
msgid "03553"
msgstr "Il prezzo non ti va{line_break}bene? Non eseguirò{line_break}la riparazione!{page_break}"

msgctxt "message"
msgid "03554"
msgstr "Bene, allora farò{line_break}la riparazione!{page_break}"

msgctxt "message"
msgid "03555"
msgstr "Bene, la riparazione{line_break}è terminata.{page_break}"

msgctxt "message"
msgid "03556"
msgstr "Hai bisogno di{line_break}altre riparazioni?{end_now}"

msgctxt "message"
msgid "03557"
msgstr "Eccoti un dono per aver{line_break}fatto acquisti da noi:{line_break}{argument_item_name:1}!{page_break}"

msgctxt "message"
msgid "03558"
msgstr "A chi devo dare{line_break}lo strumento?{end_now}"

msgctxt "message"
msgid "03559"
msgstr "Non vuoi lo strumento?{page_break}"

msgctxt "message"
msgid "03560"
msgstr "Benvenuto nella mia{page_break}locanda! Costa {argument_signed_number}{line_break}monet{control:13}{end_wait}: va bene?{end_now}"

msgctxt "message"
msgid "03561"
msgstr "Bene! Chi viaggia{line_break}deve riposare bene!{end_wait}"

msgctxt "message"
msgid "03562"
msgstr "Non hai abbastanza{line_break}monete.{end_wait}"

msgctxt "message"
msgid "03563"
msgstr "Torna a trovarci!{end_wait}"

msgctxt "message"
msgid "03564"
msgstr "Hai fatto un buon{line_break}riposo? Torna a trovarci!{end_wait}"

msgctxt "message"
msgid "03565"
msgstr ".{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}{end_wait}"

msgctxt "message"
msgid "03566"
msgstr ".{pause_20_skippable}.{pause_20_skippable}{pause_20_skippable}.{pause_20_skippable}{pause_20_skippable}{pause_20_skippable}.{end_wait}"

msgctxt "message"
msgid "03567"
msgstr "...{end_wait}"

msgctxt "message"
msgid "03568"
msgstr "Ehi, dico a te! Vieni{line_break}a farti una puntata{line_break}ai dadi?{page_break}Per giocare servono{line_break}{argument_signed_number} monet{control:13}{end_wait}!{end_now}"

msgctxt "message"
msgid "03569"
msgstr "OK! Prendi i{line_break}dadi!{end_wait}"

msgctxt "message"
msgid "03570"
msgstr "No? Come vuoi.{line_break}Avanti il prossimo!{end_wait}"

msgctxt "message"
msgid "03571"
msgstr "Se non sai le regole,{line_break}puoi leggere il cartello.{end_wait}"

msgctxt "message"
msgid "03572"
msgstr "Ehi, ma le monete non{line_break}ti bastano! Per giocare{line_break}devi pagare!{end_wait}"

msgctxt "message"
msgid "03573"
msgstr "Hai vinto {argument_signed_number} monet{control:13}{end_wait}!{line_break}Che fortuna!{end_wait}"

msgctxt "message"
msgid "03574"
msgstr "Hai perso {argument_signed_number} monet{control:13}{end_wait}.{line_break}Riprova!{end_wait}"

msgctxt "message"
msgid "03575"
msgstr "Dado fortunato{page_break}Tira il dado sul tavolo{line_break}e cerca di ottenere{line_break}numeri uguali.{page_break}Il premio dipende dai{line_break}numeri indicati dai dadi e{line_break}dal punto in cui cadono.{page_break}Maggiori sono i numeri{line_break}uguali che ottieni, più{line_break}aumenta la vincita.{end_wait}"

msgctxt "message"
msgid "03576"
msgstr "Dado fortunato{page_break}Se il numero indicato da un{line_break}dado corrisponde al numero{line_break}di un altro dado o sul tavolo,{page_break}ottieni una coppia, e{line_break}vinci esattamente la{line_break}posta che hai puntato.{page_break}Con una doppia coppia vinci{line_break}due volte la posta. Con un{line_break}tris, triplichi la posta.{page_break}Quattro numeri uguali è{line_break}\"perfetto\", e ottieni{line_break}cinque volte la posta.{page_break}Inoltre, se fai un \"perfetto\"{line_break}facendo cadere i dadi sul{line_break}\"Bonus Perfetto\", puoi{page_break}ottenere un bonus{line_break}ancora più{line_break}straordinario!{end_wait}"

msgctxt "message"
msgid "03577"
msgstr "Hai vinto {argument_signed_number} monet{control:13}{end_wait}!{line_break}Non c'è male!{end_wait}"

msgctxt "message"
msgid "03578"
msgstr "Hai perso {argument_signed_number} monet{control:13}{end_wait}.{line_break}Andrà meglio la prossima volta.{end_wait}"

msgctxt "message"
msgid "03579"
msgstr "È la prima volta{line_break}che giochi al{line_break}Dado fortunato?{end_now}"

msgctxt "message"
msgid "03580"
msgstr "Quando inizi a giocare,{line_break}non vorresti più smettere.{page_break}Non conosco un altro{line_break}gioco così divertente!{end_wait}"

msgctxt "message"
msgid "03581"
msgstr "Il Dado fortunato è{line_break}famosissimo a Tolbi. Ci{line_break}si gioca tutto l'anno.{end_wait}"

msgctxt "message"
msgid "03582"
msgstr "Ehi, hai già una{line_break}somma a tre cifre!{end_wait}"

msgctxt "message"
msgid "03583"
msgstr "Vorrei continuare a{line_break}giocare al Dado fortunato,{line_break}ma ho già speso troppo!{end_wait}"

msgctxt "message"
msgid "03584"
msgstr "Vincere o perdere è solo{line_break}una questione di fortuna.{line_break}Non c'è inganno!{end_wait}"

msgctxt "message"
msgid "03585"
msgstr "Le regole del Dado{line_break}fortunato sono semplici.{page_break}Puoi imparare anche{line_break}mentre giochi.{end_wait}"

msgctxt "message"
msgid "03586"
msgstr "Spesso è chi non ha{line_break}mai giocato che vince{line_break}di più.{page_break}È la fortuna del{line_break}principiante!{end_wait}"

msgctxt "message"
msgid "03587"
msgstr "Riflettere non serve{line_break}in questo gioco.{line_break}Quando penso a come{page_break}tirare i dadi, perdo.{line_break}Forse è proprio perché{line_break}penso troppo!{end_wait}"

msgctxt "message"
msgid "03588"
msgstr "Per oggi, la mia{line_break}fortuna è terminata.{line_break}È meglio che smetta.{end_wait}"

msgctxt "message"
msgid "03589"
msgstr "Vieni a tentare la{line_break}sorte con le ruote{line_break}della fortuna!{end_wait}"

msgctxt "message"
msgid "03590"
msgstr "Per giocare ti servono{line_break}i biglietti di gioco.{end_wait}"

msgctxt "message"
msgid "03591"
msgstr "Tu hai {argument_signed_number}{line_break}bigliett{control:13}{page_break} di{line_break}gioco, {protagonist_name}.{page_break}Vuoi usare i tuoi{line_break}biglietti?{end_now}"

msgctxt "message"
msgid "03592"
msgstr "Le regole sono{line_break}scritte sul cartello,{line_break}se vuoi leggerle!{end_wait}"

msgctxt "message"
msgid "03593"
msgstr "Non puoi portare altri{line_break}strumenti. Vuoi{line_break}giocare lo stesso?{end_now}"

msgctxt "message"
msgid "03594"
