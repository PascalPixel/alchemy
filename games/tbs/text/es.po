msgctxt "MsgLobbyWantParticipatePlease"
msgid "10512"
msgstr ""
"¡Si quieres participar,\n"
"por favor, colócate\n"
"sobre el círculo!{end_wait}"

msgctxt "MsgFieldWelcomeToBattleArenaWherePeople"
msgid "10513"
msgstr ""
"¡Bienvenido al recinto de\n"
"batalla, donde se reúnen\n"
"los que quieren luchar!{page_break}"
"¡Comprueba tus habilidades\n"
"en una Batalla Link o en una\n"
"Batalla contra monstruo!{page_break}"
"¡Habla con la chica del\n"
"mostrador si quieres\n"
"luchar!{end_wait}"

