msgid "05373"
msgstr "She's toasting some bread.{page_break}It smells great.{end_wait}"

msgctxt "message"
msgid "05374"
msgstr "He's making curry.{page_break}Its spicy scent{line_break}makes the mouth water.{end_wait}"

msgctxt "message"
msgid "05375"
msgstr "He's making roasted{line_break}eggplant with cheese.{page_break}I'd like to try it{line_break}once... Eggplants and{line_break}cheese.{page_break}What a combination!{end_wait}"

msgctxt "message"
msgid "05376"
msgstr "It's a Kalay salad{line_break}with cucumber and yogurt.{page_break}I can't imagine what{line_break}it tastes like!{end_wait}"

msgctxt "message"
msgid "05377"
msgstr "It's pickles with garlic.{page_break}The pickle is popular{line_break}in Kalay, but no{line_break}one knows why...{end_wait}"

msgctxt "message"
msgid "05378"
msgstr "She's making the world-{line_break}renowned Tolbi pizza.{page_break}The scent of cheese...{line_break}Oh, no! Something is{line_break}burning!{end_wait}"

