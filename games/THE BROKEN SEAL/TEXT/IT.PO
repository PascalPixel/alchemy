msgctxt "message"
msgid "07737"
msgstr "Che paura! Quei mostri{line_break}marini sono{line_break}terrificanti.{pause_20_skippable} {text_effect:4}Mamma!{end_wait}"

msgctxt "message"
msgid "07738"
msgstr "Battere i mostri marini è{line_break}un lavoro da guerrieri. Non{line_break}voglio saperne nulla!{end_wait}"

msgctxt "message"
msgid "07739"
msgstr "Quei mostri sono così forti{line_break}che se fossero colpiti da un{line_break}remo non se n'accorgerebbero.{end_wait}"

msgctxt "message"
msgid "07740"
msgstr "Non m'importa chi è{line_break}catturato dal mostro...{line_break}Basta che non sia io!{end_wait}"

msgctxt "message"
msgid "07741"
