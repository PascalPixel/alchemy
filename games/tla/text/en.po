#, alchemy-end-now
msgctxt "MsgMadraGoingToOsenia"
msgid "06410"
msgstr "You goin' to Osenia?"

#, alchemy-end-wait
msgctxt "message"
msgid "06411"
msgstr ""
"You'll have to head back to\n"
