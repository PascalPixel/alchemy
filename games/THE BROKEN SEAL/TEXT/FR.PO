msgctxt "message"
msgid "08783"
msgstr "Babi ne l'aurait pas{line_break}fait entrer dans les{line_break}finales juste pour{page_break}rembourser une dette!{end_wait}"

msgctxt "message"
msgid "08784"
msgstr "Je suppose que Babi{line_break}estime que {actor_name:1}{line_break}doit faire le poids.{end_wait}"

msgctxt "message"
msgid "08785"
msgstr "Nous vous attendions{line_break}{actor_name:1}.{end_wait}"

msgctxt "message"
msgid "08786"
