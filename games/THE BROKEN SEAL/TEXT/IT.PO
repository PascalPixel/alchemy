msgctxt "message"
msgid "07755"
msgstr "Sono così fuori di testa{line_break}che non capisco neppure{line_break}quanta paura ho.{end_wait}"

msgctxt "message"
msgid "07756"
msgstr "Quei mostri marini{line_break}sembrano orribilmente forti!{page_break}Preferirei remare{line_break}piuttosto che{line_break}doverli sfidare!{end_wait}"

msgctxt "message"
msgid "07757"
msgstr "Vi prego! Fatemi{line_break}uscire da questa{line_break}situazione!{end_wait}"

msgctxt "message"
msgid "07758"
msgstr "Ma perché i mostri marini{line_break}sono apparsi quando ero{line_break}a bordo io?{end_wait}"

msgctxt "message"
msgid "07759"
