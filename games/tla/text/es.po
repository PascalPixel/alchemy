msgctxt "message"
msgid "05896"
msgstr ""
"Está lleno de agua\n"
"limpia y fresca.{end_wait}"

msgctxt "message"
msgid "05897"
msgstr ""
"Se oye el croar de\n"
"las ranas.{end_wait}"

msgctxt "message"
msgid "05898"
msgstr ""
"Kraden... ¿Cuánto tiempo\n"
"vamos a estar a la deriva\n"
"en esta isla?{end_wait}"

msgctxt "message"
msgid "05899"
msgstr ""
"No lo sé...\n"
"Esperaba que me\n"
"lo dijeras tú.{end_wait}"

msgctxt "message"
msgid "05900"
msgstr ""
"Vaya... En momentos\n"
"así no sirves para nada.{end_wait}"

msgctxt "message"
msgid "05901"
msgstr "Eh, tengo hambre...{end_wait}"

msgctxt "message"
msgid "05902"
msgstr ""
"¿Cómo puedes\n"
"pensar en comida?{end_wait}"

msgctxt "message"
msgid "05903"
msgstr ""
"¿Qué le habrá\n"
"sucedido a mi\n"
"hermano...?{end_wait}"

msgctxt "message"
msgid "05904"
msgstr ""
"No estoy seguro,{pause_20_skippable} pero\n"
"parece que encendieron\n"
"el Faro de Venus.{end_wait}"

msgctxt "message"
msgid "05905"
msgstr ""
"Eso ya lo sé. Por eso\n"
"acabamos aquí, ¿o no?{end_wait}"

msgctxt "message"
msgid "05906"
msgstr ""
"Estás un poco quisquillosa\n"
"hoy, ¿no, {actor_name:6}?{end_wait}"

msgctxt "message"
msgid "05907"
msgstr ""
"Bueno,{pause_20_skippable} me imagino\n"
"que estarás preocupada\n"
"por {actor_name:5}.{end_wait}"

msgctxt "message"
msgid "05908"
msgstr ""
"{actor_name:1} y sus amigos\n"
"han debido de estar\n"
"cerca.{end_wait}"

msgctxt "message"
msgid "05909"
msgstr "Supongo que sí...{end_wait}"

msgctxt "message"
msgid "05910"
msgstr ""
"Los echo de menos...\n"
"{actor_name:1}...\n"
"{actor_name:5}...{end_wait}"

msgctxt "message"
msgid "05911"
msgstr ""
"Hay algo que desearía\n"
"mostraros.{end_wait}"

msgctxt "message"
msgid "05912"
msgstr "Venid por aquí.{end_wait}"

msgctxt "message"
msgid "05913"
msgstr "{actor_name:5}... {actor_name:7}...{end_now}"

msgctxt "message"
msgid "05914"
msgstr "¡{actor_name:5}! ¡{actor_name:7}!{end_now}"

msgctxt "message"
msgid "05915"
msgstr "Están... {pause_20_skippable}están vivos.{end_wait}"

msgctxt "message"
msgid "05916"
msgstr "¡Están vivos!{end_wait}"

msgctxt "message"
msgid "05917"
msgstr ""
"Pero, ¿qué ha\n"
"pasado, Álex?{end_wait}"

msgctxt "message"
msgid "05918"
msgstr ""
"{text_effect:4}{actor_name:1}, you are the final\n"
"warrior, and this shall not\n"
"be forgotten.{page_break}"
"{text_effect:6}I'll be here, so when you get\n"
"done checking things out, just\n"
"give me a call.{page_break}"
"{text_effect:2}All right?{end_wait}"

