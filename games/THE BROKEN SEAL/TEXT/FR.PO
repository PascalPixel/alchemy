msgctxt "message"
msgid "08777"
msgstr "Hé! Vous êtes {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "08778"
msgstr "Vous blaguez, là...{line_break}Ce {actor_name:1}? Celui{line_break}choisi par Babi?{end_wait}"

msgctxt "message"
msgid "08779"
msgstr "Ouais{pause_20_skippable}, il n'y a pas{line_break}de doute possible...{line_break}C'est {actor_name:1}, c'est sûr.{end_wait}"

msgctxt "message"
msgid "08780"
