msgid "10584"
msgstr ""
"Lo sabía. ¡Habéis\n"
"perdido porque yo\n"
"no he participado!{end_wait}"

msgctxt "message"
msgid "10585"
msgstr ""
"Me alegra no haber\n"
"participado en la\n"
"lucha.{end_wait}"

msgctxt "message"
msgid "10586"
msgstr ""
"Mis ruegos no fueron\n"
"escuchados...{end_wait}"

msgctxt "message"
msgid "10587"
msgstr "?"

msgctxt "message"
msgid "10588"
msgstr "Oh, no. Perdimos...{end_wait}"

msgctxt "MsgLobbyLooksLikeFirst"
msgid "10589"
msgstr ""
"Parece que es tu\n"
"primera vez aquí.{page_break}"
"Te enseñaré lo que es\n"
"luchar en una batalla.{end_wait}"

msgctxt "message"
msgid "10590"
msgstr ""
"Has ganado {argument_signed_number} Batalla{control:13}\n"
"Link. ¡Sigue así!{end_wait}"

msgctxt "MsgLobbyLooksLikeFirstTime"
msgid "10591"
msgstr ""
"Parece que es tu\n"
"primera vez aquí.{page_break}"
"Puedes preguntarme\n"
"sobre los resultados\n"
"de tu batalla, ¿vale?{end_wait}"

msgctxt "message"
msgid "10592"
msgstr ""
"Has ganado {argument_signed_number} Batalla{control:13}\n"
"Link.{page_break}"
"Mira el marcador de\n"
"la pared para ver los\n"
"récords actuales.{end_wait}"

msgctxt "MsgLobbyThreeAlliesFight"
msgid "10593"
msgstr ""
"En las finales de la\n"
"Batalla Link pueden\n"
"participar hasta tres.{page_break}"
"Los resultados varían\n"
"enormemente dependiendo de\n"
"a quién asignas qué Djinn.{end_wait}"

msgctxt "message"
msgid "10594"
msgstr ""
"Fue una batalla\n"
"excelente...\n"
"¡Qué emocionante!{end_wait}"

msgctxt "message"
msgid "10595"
msgstr ""
"Qué pena. A veces necesitas\n"
"tener suerte para ganar.\n"
"No te preocupes.{end_wait}"

msgctxt "MsgLobbyBattleArenaOld"
msgid "10596"
msgstr ""
"¿Es éste el recinto\n"
"de batalla del que\n"
"hablaba el anciano?{page_break}"
"Creí que lo había soñado...\n"
"aunque... ¿no será que\n"
"estamos en su sueño?{end_wait}"

msgctxt "message"
msgid "10597"
msgstr ""
"Guau... Chicos.\n"
"Sois más fuertes de\n"
"lo que aparentáis.{end_wait}"

msgctxt "message"
msgid "10598"
msgstr ""
"Chicos, ¿qué ha pasado?\n"
"Debéis seguir intentándolo.{end_wait}"

msgctxt "MsgLobbyTravelingWarrior"
msgid "10599"
msgstr ""
"Soy un guerrero viajero.\n"
"Vine aquí para hacerme\n"
"más fuerte...{page_break}"
"Escucha lo que te digo:\n"
"no subestimes a los\n"
"monstruos de aquí.{end_wait}"

msgctxt "message"
msgid "10600"
msgstr ""
"No eres tan malo. Pero\n"
"que no te ciegue el\n"
"placer de la victoria.{page_break}"
"Sigue entrenándote.{end_wait}"

msgctxt "message"
msgid "10601"
msgstr ""
"Tienes que seguir entrenándote.{page_break}"
"Pon todo tu empeño cuando\n"
"estés luchando.{end_wait}"

msgctxt "MsgLobbyTellTotalWins"
msgid "10602"
msgstr ""
"Te diré tus estadísticas\n"
"cuando acabes las finales\n"
"de la Batalla Link.{end_wait}"

msgctxt "MsgLobbyTellConsecutiveWins"
msgid "10603"
msgstr ""
"Te diré las victorias\n"
"consecutivas cuando\n"
"acabes las finales.{end_wait}"

msgctxt "MsgLobbyWonNumberConsecutive"
msgid "10604"
msgstr ""
