msgctxt "message"
msgid "07620"
msgstr "Non ancora...{end_wait}"

msgctxt "message"
msgid "07621"
msgstr "Non ancora?{line_break}Che problema c'è?{end_wait}"

msgctxt "message"
msgid "07622"
msgstr "Il Mare di Karagol è{line_break}pieno di mostri...{end_wait}"

msgctxt "message"
msgid "07623"
msgstr "Ma allora non...{end_wait}"

msgctxt "message"
msgid "07624"
msgstr "Beh, è proprio come ha detto{line_break}Sean. A questo punto dobbiamo{line_break}proteggere il ponte.{end_wait}"

msgctxt "message"
msgid "07625"
msgstr "Ci serve qualcuno che{line_break}protegga i rematori.{end_wait}"

msgctxt "message"
msgid "07626"
msgstr "Sean, si direbbe che tu{line_break}abbia già in mente{line_break}qualcuno...{end_wait}"

msgctxt "message"
msgid "07627"
msgstr "Beh, sì.{end_wait}"

msgctxt "message"
msgid "07628"
