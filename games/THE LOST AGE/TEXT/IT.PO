msgctxt "message"
msgid "07009"
msgstr "Davvero? Dovete essere passati{line_break}per la caverna...{page_break}Ora non potrete usare{line_break}quella via, sapete... Il viaggio{line_break}di ritorno sarà più lungo.{end_wait}"

msgctxt "message"
msgid "07010"
