msgctxt "message"
msgid "09884"
msgstr "Non è facile tagliare queste{line_break}pietre e posarle sulle{line_break}rovine.{page_break}Dicono di andare più{line_break}veloci... Allora se le possono{line_break}costruire da soli!{end_wait}"

msgctxt "message"
msgid "09885"
msgstr "Se soltanto non{line_break}avessero {actor_name:7}...{page_break}Ma anche se non avessero avuto{line_break}lei in ostaggio, non li avremmo{line_break}potuti battere comunque.{end_wait}"

msgctxt "message"
msgid "09886"
msgstr "Hanno usato il fuoco!{line_break}Non è corretto!{end_wait}"

msgctxt "message"
msgid "09887"
msgstr "Che disdetta! Non abbiamo{line_break}potuto fermare {actor_name:7}{line_break}e gli altri...{end_wait}"

msgctxt "message"
msgid "09888"
msgstr "Cosa vorranno fare a{line_break}{actor_name:7} alle rovine...{page_break}No... Non voglio{line_break}neppure{line_break}pensarci...{end_wait}"

msgctxt "message"
msgid "09889"
msgstr "Non avremmo mai dovuto{line_break}lasciare che Tolbi ci portasse{line_break}via {actor_name:7}.{end_wait}"

msgctxt "message"
msgid "09890"
msgstr "Faran non è ancora{line_break}tornato... Cosa{line_break}starà succedendo?{end_wait}"

msgctxt "message"
msgid "09891"
msgstr "Ci sono stati parecchi{line_break}cattivi presagi.{page_break}Il presagio ci fu quando{line_break}{actor_name:7} fu portata{line_break}via da Lalivero...{end_wait}"

msgctxt "message"
msgid "09892"
msgstr "Le pietre che abbiamo{line_break}posato per il faro{line_break}non cadranno, vero?{end_wait}"

msgctxt "message"
msgid "09893"
msgstr "Ho provato a mettermi davanti{line_break}a lei per salvarla...{page_break}Tremavo come{line_break}una foglia...{line_break}Non ho potuto fermarli...{end_wait}"

msgctxt "message"
msgid "09894"
msgstr "Presto avranno una{line_break}bella lezione.{page_break}Impareranno perché {actor_name:7}{line_break}è chiamata la bambina{line_break}sacra di Lalivero!{end_wait}"

msgctxt "message"
msgid "09895"
msgstr "C'è stata una grande{line_break}battaglia e qualcuno è{line_break}stato preso in ostaggio.{page_break}È una tragedia, ma se significa{line_break}un giorno senza lavorare, non{line_break}tutto il male vien per nuocere.{end_wait}"

msgctxt "message"
msgid "09896"
msgstr "Se Faran li ha seguiti,{line_break}allora è una cosa seria!{page_break}Se le cose non cambiano,{line_break}non riusciremo mai a{line_break}costruire il faro.{end_wait}"

msgctxt "message"
msgid "09897"
msgstr "Perché vogliono costruire{line_break}questo faro in fretta{line_break}e furia?{page_break}Forse vogliono controllare{line_break}i mari per poter dominare{line_break}paesi più lontani...{end_wait}"

msgctxt "message"
msgid "09898"
msgstr "Ora che ci penso, nella{line_break}cava abbiamo trovato{line_break}una strana grotta.{end_wait}"

msgctxt "message"
msgid "09899"
msgstr "Certo che ho visto il{line_break}potere di {actor_name:7}...{line_break}È incredibile!{page_break}Com'è possibile che qualcuno{line_break}che ha simili poteri sia{line_break}preso in ostaggio?{end_wait}"

msgctxt "message"
msgid "09900"
msgstr "Qualcuno non crede che{line_break}{actor_name:7} abbia{line_break}straordinari poteri...{page_break}Ma dubitare dei poteri di{line_break}{actor_name:7} è assurdo!{end_wait}"

msgctxt "message"
msgid "09901"
msgstr "Non sarà che Faran si{line_break}è preso gioco di noi?{page_break}Se {actor_name:7} avesse dei{line_break}poteri magici, come avrebbero{line_break}potuto prenderla in ostaggio?{end_wait}"

msgctxt "message"
msgid "09902"
msgstr "Se {actor_name:7} non può usare{line_break}i suoi poteri in una simile{line_break}situazione, a che le servono!{end_wait}"

msgctxt "message"
msgid "09903"
msgstr "{actor_name:7} è giunta alle{line_break}rovine in volo, come una{line_break}stella cadente.{page_break}Ha creato una grande{line_break}voragine al centro{line_break}delle rovine.{end_wait}"

msgctxt "message"
msgid "09904"
msgstr "Neppure {actor_name:7} poteva{line_break}opporsi a{line_break}quei sei...{end_wait}"

msgctxt "message"
msgid "09905"
msgstr "Dicono che da Tolbi{line_break}stia arrivando un{line_break}certo Iodem.{page_break}Chissà se vorrà{line_break}farci lavorare{line_break}ancora di più...{end_wait}"

msgctxt "message"
msgid "09906"
msgstr "Nessuno mi ha chiamato,{line_break}quindi mi faccio un pisolino!{end_wait}"

msgctxt "message"
msgid "09907"
msgstr "{actor_name:7} ha detto che{line_break}la grotta delle rovine{line_break}porta a sudest.{page_break}Ma non è possibile{line_break}che conduca fino al{line_break}Faro di Venere...{end_wait}"

msgctxt "message"
msgid "09908"
msgstr "Le rovine su cui stanno{line_break}costruendo il faro sono{line_break}piene di grotte.{page_break}Se poteste attraversare le{line_break}grotte, risolvereste il{line_break}mistero delle rovine.{end_wait}"

msgctxt "message"
msgid "09909"
msgstr "Abbiamo ricevuto {actor_name:7}{line_break}dal cielo e l'abbiamo{line_break}allevata con amore...{page_break}Faran riuscirà{line_break}sicuramente a salvarla.{end_wait}"

msgctxt "message"
msgid "09910"
msgstr "So solo che mio padre{line_break}salverà la mia sorella{line_break}maggiore, {actor_name:7}.{end_wait}"

msgctxt "message"
msgid "09911"
msgstr "Sua moglie sembra{line_break}calmissima.{page_break}Ma in cuor suo dev'essere{line_break}preoccupata per {actor_name:7}.{end_wait}"

msgctxt "message"
msgid "09912"
msgstr "{actor_name:7}, se il tuo{line_break}potere è reale, fuggi,{line_break}ti prego!{page_break}Altrimenti tutti penseremo{line_break}che i tuoi poteri non{line_break}siano autentici...{end_wait}"

msgctxt "message"
msgid "09913"
msgstr "{actor_name:7} è la salvatrice{line_break}di Lalivero, non c'è{line_break}alcun dubbio.{page_break}Non conosco nessuno che{line_break}abbia gli stessi{line_break}poteri di {actor_name:7}.{end_wait}"

msgctxt "message"
msgid "09914"
msgstr "Una mitica salvatrice{line_break}venuta dal cielo...{page_break}Siamo stati sciocchi a credere{line_break}che fosse {actor_name:7}{line_break}la salvatrice...{end_wait}"

msgctxt "message"
msgid "09915"
msgstr "Voglio credere in{line_break}{actor_name:7}...{page_break}Ti prego, {actor_name:7}, usa{line_break}i tuoi poteri per{line_break}fuggire!{end_wait}"

msgctxt "message"
msgid "09916"
msgstr "È caduta dal cielo{line_break}ma non si è fatta{line_break}neppure un graffio!{page_break}Non potranno fare{line_break}del male a {actor_name:7}!{end_wait}"

msgctxt "message"
msgid "09917"
msgstr "Se capita qualcosa a{line_break}{actor_name:7}, che ne{line_break}sarà di Lalivero?{end_wait}"

msgctxt "message"
msgid "09918"
msgstr "Quando sarà qui, Iodem{line_break}dovrà dare qualche{line_break}spiegazione.{page_break}Forse dovrei andarmene{line_break}da Lalivero...{end_wait}"

msgctxt "message"
msgid "09919"
msgstr "Era da parecchio che non{line_break}mi facevo un bel riposino{line_break}in pieno giorno!{end_wait}"

msgctxt "message"
msgid "09920"
msgstr "Come avrà fatto {actor_name:7}{line_break}a sapere delle grotte{line_break}alle rovine?{page_break}Le sue visioni... non posso{line_break}credere che siano vere!{end_wait}"

msgctxt "message"
msgid "09921"
msgstr "Quelle grotte sono{line_break}troppo pericolose{line_break}per me.{page_break}Se fossi un guerriero...{line_break}...Potrei andare a cercare{line_break}il tesoro delle grotte!{end_wait}"

msgctxt "message"
msgid "09922"
msgstr "Anche il solo pensiero{line_break}che sia capitato qualcosa a{line_break}{actor_name:7} mi terrorizza!{page_break}Se potessi mi offrirei io{line_break}al suo posto.{end_wait}"

msgctxt "message"
msgid "09923"
msgstr "Vorrei soltanto che{line_break}qualcuno mi aiutasse a{line_break}salvare mia sorella, {actor_name:7}.{end_wait}"

msgctxt "message"
msgid "09924"
msgstr "Quei due hanno cresciuto{line_break}{actor_name:7} come se fosse{line_break}la loro figlia.{page_break}Il rapimento di {actor_name:7}{line_break}ha rattristato{line_break}tutti noi!{end_wait}"

msgctxt "message"
msgid "09925"
msgstr "Hanno preso {actor_name:7}{line_break}in ostaggio e Faran{line_break}li ha seguiti?{end_now}"

msgctxt "message"
msgid "09926"
msgstr "Di cosa si staranno occupando{line_break}gli altri abitanti di Lalivero?{page_break}Se non dovessi rimanere{line_break}in negozio correrei a{line_break}salvare {actor_name:7}!{end_wait}"

msgctxt "message"
msgid "09927"
msgstr "Ma che domande sono? A{line_break}Lalivero non si sta parlando{line_break}d'altro, chiaramente!{end_wait}"

msgctxt "message"
msgid "09928"
msgstr "Quelli di Lalivero sono{line_break}persone timorose, non ci si{line_break}può fare affidamento.{end_wait}"

msgctxt "message"
msgid "09929"
msgstr "Sei un guerriero, vero?{line_break}Devi salvare {actor_name:7}!{page_break}Se la salvi ti farò{line_break}uno sconto sulla{line_break}merce.{end_wait}"

msgctxt "message"
msgid "09930"
msgstr "Non posso salvare {actor_name:7}!{line_break}Se avessi un po' più di{line_break}coraggio... forse...{end_wait}"

msgctxt "message"
msgid "09931"
msgstr "Credo che quelli che hanno{line_break}preso {actor_name:7} in ostaggio{line_break}fossero dell'Angara.{page_break}Lo sanno tutti che quel{line_break}continente è pieno di{line_break}incivili e delinquenti.{end_wait}"

msgctxt "message"
msgid "09932"
msgstr "Se accadesse qualcosa{line_break}a {actor_name:7}...{page_break}Non vorrò mai più fare{line_break}affari con la gente{line_break}dell'Angara!{end_wait}"

msgctxt "message"
msgid "09933"
msgstr "Chi vuole riposare qui è{line_break}il benvenuto, perché{line_break}mi porta soldi.{page_break}Ma se sei un guerriero...{line_break}...Faresti meglio ad andare{line_break}a salvare {actor_name:7}.{end_wait}"

msgctxt "message"
msgid "09934"
msgstr "Oh, scusami...{end_wait}"

msgctxt "message"
msgid "09935"
msgstr "Sono così in pensiero{line_break}per {actor_name:7} che non{line_break}riesco a concentrarmi.{end_wait}"

msgctxt "message"
msgid "09936"
msgstr "Ma per quanto mi{line_break}preoccupi, non posso{line_break}fare nulla...{end_wait}"

msgctxt "message"
msgid "09937"
msgstr "...E ora al lavoro,{line_break}al lavoro!{end_wait}"

msgctxt "message"
msgid "09938"
msgstr "Lavorando tengo la{line_break}mente occupata.{end_wait}"

msgctxt "message"
msgid "09939"
msgstr "Siamo dominati da Tolbi...{line_break}È questa la causa di ciò che{line_break}è successo a {actor_name:7}.{page_break}È Babi il responsabile{line_break}di tutto questo!{end_wait}"

msgctxt "message"
msgid "09940"
msgstr "Ma perché è successo{line_break}proprio a {actor_name:7}? Oh, se{line_break}fosse solo un brutto sogno!{end_wait}"

msgctxt "message"
msgid "09941"
msgstr "Pulire la casa...{line_break}...cambiare le lenzuola...{line_break}Ho fatto tutto?{page_break}Sono fuori di me...{line_break}A volte non so più{line_break}nemmeno cosa sto facendo...{end_wait}"

msgctxt "message"
msgid "09942"
msgstr "Quando questo incidente sarà{line_break}risolto, spero che i soldati{line_break}di Tolbi lascino la città...{end_wait}"

msgctxt "message"
msgid "09943"
msgstr "Non potete impedirmi{line_break}di lavorare!{end_wait}"

msgctxt "message"
msgid "09944"
msgstr "Babi non sta costruendo{line_break}un faro... ma una{line_break}torre...{page_break}Forse vuole elevarsi{line_break}al livello{line_break}degli dei.{end_wait}"

msgctxt "message"
msgid "09945"
msgstr "Scommetto che la torre{line_break}di Babi cadrà presto.{page_break}D'altra parte, l'orgoglio{line_break}porta sempre alla rovina...{end_wait}"

msgctxt "message"
msgid "09946"
msgstr "I beni più preziosi di{line_break}Babi sono conservati qui.{page_break}Non può entrare nessuno!{end_wait}"

msgctxt "message"
msgid "09947"
msgstr "Chissà quali sono questi{line_break}preziosissimi{line_break}beni di Babi...{page_break}Ma in{line_break}fondo,{line_break}che m'importa?{end_wait}"

msgctxt "message"
msgid "09948"
msgstr "Erano{pause_20_skippable} tremendi!{line_break}Non potevamo{line_break}assolutamente competere.{end_wait}"

msgctxt "message"
msgid "09949"
msgstr "Solo due di quei sei{line_break}ci hanno attaccato...{page_break}...ma è bastato{line_break}per distruggerci{line_break}completamente!{end_wait}"

msgctxt "message"
msgid "09950"
msgstr "Ci hanno spazzato via{line_break}dalla loro strada e hanno{line_break}proseguito per il faro.{end_wait}"

msgctxt "message"
msgid "09951"
msgstr "Hanno dato fuoco a{line_break}tutto! Per questo il{line_break}terreno è bruciato.{page_break}Ma usare il fuoco come{line_break}arma è scorretto!{end_wait}"

msgctxt "message"
msgid "09952"
msgstr "Li abbiamo attaccati{line_break}noi, ma ci hanno{line_break}distrutto.{page_break}È stato assurdo credere{line_break}di poter competere{line_break}con quella gente...{end_wait}"

msgctxt "message"
msgid "09953"
msgstr "Gli altri quattro non{line_break}sembravano assolutamente{line_break}intenzionati a combattere.{end_wait}"

msgctxt "message"
msgid "09954"
msgstr "Cosa avranno in{line_break}mente di fare al{line_break}Faro di Babi?{end_wait}"

msgctxt "message"
msgid "09955"
msgstr "Nessuno di loro{line_break}aveva delle torce.{page_break}Era come se quel{line_break}fuoco apparisse{line_break}dal nulla!{end_wait}"

msgctxt "message"
msgid "09956"
msgstr "Sei sicuro che siano{line_break}passati da quella porta?{end_wait}"

msgctxt "message"
msgid "09957"
msgstr "Sì, hanno aperto la porta{line_break}di pietra e sono entrati!{end_wait}"

msgctxt "message"
msgid "09958"
msgstr "Si può aprire la porta?{end_wait}"

msgctxt "message"
msgid "09959"
msgstr "Niente da fare.{line_break}Non c'è verso...{end_wait}"

msgctxt "message"
msgid "09960"
msgstr "Hai visto?{line_break}Te l'ho detto! La{line_break}porta non si apre!{end_wait}"

msgctxt "message"
msgid "09961"
msgstr "Se si potesse aprire,{line_break}saremmo già entrati da tempo{line_break}per studiare le rovine.{end_wait}"

msgctxt "message"
msgid "09962"
msgstr "Ma sono senz'altro{line_break}passati da quella porta!{end_wait}"

msgctxt "message"
msgid "09963"
msgstr "E io ti dico che nessuno{line_break}è mai riuscito ad{line_break}aprirla...{end_wait}"

msgctxt "message"
msgid "09964"
msgstr "Oh! Iodem...{end_wait}"

msgctxt "message"
msgid "09965"
msgstr "Faran!{end_wait}"

msgctxt "message"
msgid "09966"
msgstr "Mi dispiace{pause_20_skippable} così tanto{line_break}per {actor_name:7}...{end_wait}"

msgctxt "message"
msgid "09967"
msgstr "Com'è potuta accadere{line_break}una cosa simile?{end_wait}"

msgctxt "message"
msgid "09968"
msgstr "{actor_name:5} e gli{line_break}altri hanno attraversato{line_break}questa porta?{end_wait}"

msgctxt "message"
msgid "09969"
msgstr "Sì, una porta che{line_break}nessuna persona normale{line_break}potrebbe mai aprire...{end_wait}"

msgctxt "message"
msgid "09970"
msgstr "Se l'hanno fatto, significa{line_break}che loro possono farlo, no?{end_now}"

msgctxt "message"
msgid "09971"
msgstr "Andrete a cercarli?{end_wait}"

msgctxt "message"
msgid "09972"
msgstr "Nessun altro{line_break}può farlo.{end_wait}"

msgctxt "message"
msgid "09973"
msgstr "Iodem, loro{line_break}chi sono?{end_wait}"

msgctxt "message"
msgid "09974"
msgstr "Provengono dall'estremo{line_break}nord.{page_break}Hanno inseguito fin qui{line_break}quelli che hanno{line_break}rapito {actor_name:7}.{end_wait}"

msgctxt "message"
msgid "09975"
msgstr "Hanno inseguito quel{line_break}gruppo spaventoso?{end_wait}"

msgctxt "message"
msgid "09976"
msgstr "Sì, sono davvero{line_break}spaventosi.{end_wait}"

msgctxt "message"
msgid "09977"
msgstr "Hanno un potere enorme,{line_break}e le loro intenzioni{line_break}sono pericolosissime.{end_wait}"

msgctxt "message"
msgid "09978"
msgstr "Noi siamo gli unici{line_break}che possono fermarli.{end_wait}"

msgctxt "message"
msgid "09979"
msgstr "Pensi che possiamo{line_break}fermarli?{end_now}"

msgctxt "message"
msgid "09980"
msgstr "Sembri molto sicuro di{line_break}te, ma cosa hai intenzione{line_break}di fare?{end_wait}"

msgctxt "message"
msgid "09981"
msgstr "Beh, almeno non con{line_break}questo atteggiamento!{end_wait}"

msgctxt "message"
msgid "09982"
msgstr "Non ti ho mai sentito{line_break}parlare in modo così{line_break}duro, Faran.{end_wait}"

msgctxt "message"
msgid "09983"
msgstr "Cosa ti aspettavi...{line_break}In mezzo a tali{line_break}pericoli, come puoi{page_break}chiedermi di lasciare il{line_break}destino di {actor_name:7} in mano{line_break}ad un gruppo di bambini?{end_wait}"

msgctxt "message"
msgid "09984"
msgstr "Se vuoi che mi fidi di{line_break}loro, devi darmi un motivo{line_break}per cui dovrei farlo!{end_wait}"

msgctxt "message"
msgid "09985"
msgstr "Prima di tutto dovrete{line_break}dimostrargli i{line_break}vostri poteri.{end_wait}"

msgctxt "message"
msgid "09986"
msgstr "Siete in grado di percorrere{line_break}la loro stessa strada?{end_now}"

msgctxt "message"
msgid "09987"
msgstr "Le parole non bastano...{line_break}Dovete dimostrarci{line_break}di poterlo fare.{end_wait}"

msgctxt "message"
msgid "09988"
msgstr "Beh, comunque non avete{line_break}scelta... Dovete provare!{end_wait}"

msgctxt "message"
msgid "09989"
msgstr "Iodem vi chiede soltanto{line_break}di farvi da parte{line_break}e osservare.{end_wait}"

msgctxt "message"
msgid "09990"
msgstr "Ora mostratemi ciò{line_break}che sapete fare.{end_wait}"

msgctxt "message"
msgid "09991"
msgstr "Conto su di te,{line_break}{actor_name:1}! Dimostra di essere{line_break}degno di aprire quella porta!{end_wait}"

msgctxt "message"
msgid "09992"
msgstr "Quando li ho visti{line_break}avevano già attraversato{line_break}la porta.{page_break}Dovete credermi, è la{line_break}verità!{end_wait}"

msgctxt "message"
msgid "09993"
msgstr "Mi dispiace, ma neppure {actor_name:7}{line_break}è mai riuscita ad{line_break}attraversare la porta.{page_break}Non c'è modo{line_break}di farla aprire.{end_wait}"

msgctxt "message"
msgid "09994"
msgstr "Tutto questo è successo perché{line_break}{actor_name:7} è stata{line_break}condotta a Tolbi.{page_break}Se succederà qualcosa a{line_break}{actor_name:7}, la gente di Lalivero{line_break}non resterà a guardare!{end_wait}"

msgctxt "message"
msgid "09995"
msgstr "Se saprai aprire la porta{line_break}darò ancora una volta{line_break}fiducia a Iodem...{end_wait}"

msgctxt "message"
msgid "09996"
msgstr "Non voglio dubitare delle{line_break}tue capacità, {actor_name:1}, ma{line_break}tutto questo mi preoccupa...{page_break}E se la porta non si{line_break}dovesse aprire?{end_wait}"

msgctxt "message"
msgid "09997"
msgstr "Nessuno crede che la porta{line_break}si possa aprire, e anch'io{line_break}sto iniziando a dubitarne.{page_break}In effetti non li{line_break}ho visti passare da{line_break}quella porta...{end_wait}"

msgctxt "message"
msgid "09998"
msgstr "Ma che aspettano? Se{line_break}hanno intenzione di{line_break}aprire la porta,{page_break}farebbero meglio{line_break}a sbrigarsi!{end_wait}"

msgctxt "message"
msgid "09999"
msgstr "Stiamo perdendo{line_break}un'enormità di tempo!{page_break}Se non troviamo subito{line_break}{actor_name:7}, la sua vita{line_break}potrebbe essere in pericolo...{end_wait}"

msgctxt "message"
msgid "10000"
msgstr "Spero che possano aprire la{line_break}porta, ma non ci credo{line_break}finché non vedo.{end_wait}"

msgctxt "message"
msgid "10001"
msgstr "La porta!{end_wait}"

msgctxt "message"
msgid "10002"
msgstr "Non ci posso credere!{line_break}La porta s'è aperta!{end_wait}"

msgctxt "message"
msgid "10003"
msgstr "Incredibile! Si può{line_break}davvero aprire!{end_wait}"

msgctxt "message"
msgid "10004"
msgstr "Ma come avete fatto ad{line_break}aprire la porta?{end_wait}"

msgctxt "message"
msgid "10005"
msgstr "Non so come{line_break}spiegarlo...{end_wait}"

msgctxt "message"
msgid "10006"
msgstr "Ce l'abbiamo fatta perché{pause_20_skippable}{pause_20_skippable}{line_break}siamo noi!{end_wait}"

msgctxt "message"
msgid "10007"
msgstr "Sarebbe troppo lungo{line_break}spiegarlo...{end_wait}"

msgctxt "message"
msgid "10008"
msgstr "Comunque non c'è{line_break}tempo per le{line_break}spiegazioni.{end_wait}"

msgctxt "message"
msgid "10009"
msgstr "È giusto... Dobbiamo{line_break}salvare {actor_name:7}!{end_wait}"

msgctxt "message"
msgid "10010"
msgstr "Andiamo, Faran. Dobbiamo{line_break}salvare {actor_name:7}!{end_wait}"

msgctxt "message"
msgid "10011"
msgstr "Ehi, la porta si chiude!{end_wait}"

msgctxt "message"
msgid "10012"
msgstr "Perché s'è chiusa?{end_wait}"

msgctxt "message"
msgid "10013"
msgstr "Non lo so...{line_break}Perché si dovrebbe{line_break}chiudere?{end_wait}"

msgctxt "message"
msgid "10014"
msgstr "Si è chiusa per impedire{line_break}l'ingresso a persone che{line_break}non conoscono la Psinergia!{end_wait}"

msgctxt "message"
msgid "10015"
msgstr "Sarebbe pericoloso se{line_break}entrassero persone che non{line_break}conoscono la Psinergia.{end_wait}"

msgctxt "message"
msgid "10016"
