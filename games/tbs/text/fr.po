"Où vas-tu, {actor_name:1}?\n"
"Tu as oublié qu'Iodem nous\n"
"a demandé de l'attendre?"

#, alchemy-end-wait
msgctxt "message"
msgid "10353"
msgstr ""
"Va falloir travailler\n"
