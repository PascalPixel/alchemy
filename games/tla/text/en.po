#, alchemy-end-wait
msgctxt "message"
msgid "06572"
msgstr "Aow-aow-oooo!!!"

#, alchemy-end-wait
msgctxt "message"
msgid "06573"
msgstr "Look! It's that werewolf!"

#, alchemy-end-wait
msgctxt "message"
msgid "06574"
msgstr "He was right there!"

#, alchemy-end-wait
msgctxt "message"
msgid "06575"
msgstr ""
"Let's go find him,\n"
