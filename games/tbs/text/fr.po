#, alchemy-end-wait
msgctxt "message"
msgid "09247"
msgstr ""
"Si nous laissons ces\n"
"gamins s'enfuir, on aura\n"
"de gros ennuis."

#, alchemy-end-wait
msgctxt "message"
msgid "09248"
msgstr ""
"Vous n'irez pas plus\n"
"loin! Pas sans quelques\n"
"bleus, en tout cas!"

#, alchemy-end-wait
msgctxt "MsgLunpaGuysTougherThought"
msgid "09249"
msgstr ""
"Vous êtes plus forts\n"
