msgctxt "MsgTolbiBuddyWannaTry"
msgid "03598"
msgstr ""
"Hey, buddy, wanna\n"
"try yer luck at the\n"
"dice?{page_break}"
"It's {argument_signed_number} coin{plural_suffix}\n"
"to play.{end_now}"

msgctxt "message"
msgid "03599"
msgstr ""
"OK! Then take the\n"
"dice.{end_wait}"

msgctxt "message"
msgid "03600"
msgstr ""
"No? Oh, well.\n"
"Who's next?{end_wait}"

msgctxt "MsgTolbiSpringReadTheSignIfYaDont"
msgid "03601"
msgstr ""
"Read the sign if ya\n"
"don't know the rules.{end_wait}"

msgctxt "MsgTolbiYaDontEnough"
msgid "03602"
msgstr ""
"Hey! Ya don't have\n"
"enough coins! Ya gotta\n"
"pay to play.{end_wait}"

msgctxt "MsgTolbiYaWonNumber"
msgid "03603"
msgstr ""
"Ya won {argument_signed_number} coin{plural_suffix}!\n"
"Talk about lucky!{end_wait}"

msgctxt "MsgTolbiYaLostNumber"
msgid "03604"
msgstr ""
"Ya lost {argument_signed_number} coin{plural_suffix}.\n"
"Better luck next time.{end_wait}"

msgctxt "MsgTolbiSpringLuckyDiceThrowTheDiceOn"
msgid "03605"
msgstr ""
"Lucky Dice{page_break}"
"Throw the dice on the\n"
"table and try to get\n"
"the same numbers.{page_break}"
"Prizes are based on\n"
"the numbers rolled and\n"
"where each die lands.{page_break}"
"The more numbers\n"
"that match, the more you\n"
"win.{end_wait}"

msgctxt "MsgTolbiSpringLuckyDiceIfTwoNumbersMatch"
msgid "03606"
msgstr ""
"Lucky Dice{page_break}"
"If two numbers match on\n"
"either the dice or\n"
"the table...{page_break}"
"it's called a pair,\n"
"and you don't win or\n"
"lose anything.{page_break}"
"Two pair doubles your\n"
"money. Triple matches\n"
"triple your money.{page_break}"
"Four of a kind is\n"
"perfect, and you win\n"
"five times your bet.{page_break}"
"Plus, if your dice come\n"
"up perfect on the\n"
"Perfect Bonus spot{page_break}"
"on the table,\n"
"you win an even\n"
"bigger bonus!{end_wait}"

msgctxt "message"
msgid "03607"
msgstr ""
"Ya won {argument_signed_number} coin{plural_suffix}!\n"
"Talk about lucky!{end_wait}"

msgctxt "message"
msgid "03608"
msgstr ""
"Ya lost {argument_signed_number} coin{plural_suffix}.\n"
"Better luck next time.{end_wait}"

msgctxt "MsgTolbiYerFirstTime"
msgid "03609"
msgstr ""
"Is this yer first\n"
"time to play\n"
"Lucky Dice?{end_now}"

msgctxt "message"
msgid "03610"
msgstr ""
"Once ya start playing,\n"
"ya won't want to stop.{page_break}"
"There's no other game\n"
"in all the lands that's\n"
"this much fun.{end_wait}"

msgctxt "message"
msgid "03611"
msgstr ""
"Lucky Dice is all the\n"
"rage in Tolbi. You can\n"
"play it year-round.{end_wait}"

msgctxt "MsgTolbiSpringWhoaGettingTripleDigitsIsReal"
msgid "03612"
msgstr ""
"Whoa! Getting triple\n"
"digits is real tough!{end_wait}"

msgctxt "MsgTolbiSpringIDontWantToStopPlaying"
msgid "03613"
msgstr ""
"I don't want to stop\n"
"playing Lucky Dice, but\n"
"I can't spend anymore!{end_wait}"

msgctxt "MsgTolbiSpringWinningOrLosingIsPureLuck"
msgid "03614"
msgstr ""
"Winning or losing\n"
"is pure luck. I ain't\n"
"cheatin' nobody.{end_wait}"

msgctxt "MsgTolbiSpringTheRulesForLuckyDiceAint"
msgid "03615"
msgstr ""
"The rules for Lucky Dice\n"
"ain't all that hard.{page_break}"
"Ya can even learn\n"
"'em while ya play.{end_wait}"

msgctxt "MsgTolbiSpringSometimesPeopleWhoHaveNeverPlayed"
msgid "03616"
msgstr ""
"Sometimes, people who\n"
"have never played\n"
"Lucky Dice win the most.{page_break}"
"They call that\n"
"beginner's luck.{end_wait}"

msgctxt "MsgTolbiSpringThinkingWontHelpYouWinThis"
msgid "03617"
msgstr ""
"Thinking won't help\n"
"you win this game.\n"
"When I try to think{page_break}"
"about how to throw the\n"
"dice, I lose. Maybe\n"
"I think too much.{end_wait}"

msgctxt "MsgTolbiSpringMyLuckHasRunOutFor"
msgid "03618"
msgstr ""
"My luck has run out\n"
"for today. I better\n"
"quit playing.{end_wait}"

msgctxt "MsgTolbiStepRightTry"
msgid "03619"
msgstr ""
"Step right up\n"
"and try your hand at\n"
"lucky wheels!{end_wait}"

msgctxt "message"
msgid "03620"
msgstr ""
"You gotta have game\n"
"tickets to play.{end_wait}"

msgctxt "message"
msgid "03621"
msgstr ""
"You have {argument_signed_number}\n"
"game ticket{plural_suffix},\n"
"{protagonist_name}.{page_break}"
"Would you like to\n"
"use these tickets?{end_now}"

msgctxt "message"
msgid "03622"
msgstr ""
"The rules are listed\n"
"on the sign. Take a\n"
"look, take a look.{end_wait}"

msgctxt "message"
msgid "03623"
msgstr ""
"You can't carry any more\n"
"items. Are you sure\n"
"you want to play?{end_now}"

msgctxt "message"
msgid "03624"
msgstr ""
"If you win anything,\n"
"you might not be able\n"
"to take it with you.{page_break}"
"Is that okay?{end_now}"

msgctxt "MsgTolbiGetRidItems"
msgid "03625"
msgstr ""
"Then get rid of some\n"
"items and come\n"
"again.{end_wait}"

msgctxt "MsgTolbiStepRightEnjoy"
msgid "03626"
msgstr ""
"Step right up and enjoy\n"
"yourself.{end_wait}"

msgctxt "message"
msgid "03627"
msgstr ""
"Choose how many\n"
"tickets you'll use.{end_wait}"

msgctxt "message"
msgid "03628"
msgstr "Are you ready to quit?{end_now}"

msgctxt "message"
msgid "03629"
msgstr ""
"Now, we'll start\n"
"round {argument_signed_number}.{end_wait}"

msgctxt "MsgTolbiCongratulations"
msgid "03630"
msgstr "Congratulations!{end_wait}"

msgctxt "MsgTolbiWonItemGo"
msgid "03631"
msgstr ""
"You won {argument_item_name:2}!\n"
"Here you go.{end_wait}"

msgctxt "MsgTolbiWonItemGo2"
msgid "03632"
msgstr ""
"And you won\n"
"{argument_item_name:2}!\n"
"Here you go.{end_wait}"

msgctxt "MsgTolbiComeAgain"
msgid "03633"
msgstr "Come again!{end_wait}"

msgctxt "MsgTolbiBadComeBack"
msgid "03634"
msgstr ""
"Too bad...\n"
"Come back after you\n"
"get some tickets.{end_wait}"

msgctxt "MsgTolbiBadLikeUse"
msgid "03635"
msgstr ""
"Too bad...{page_break}"
"Would you like to use\n"
"your tickets to\n"
"keep playing?{end_now}"

msgctxt "MsgTolbiLuckyWheelsRulesPullLever"
msgid "03636"
msgstr ""
"Lucky Wheels Rules{page_break}"
"Pull the lever and\n"
"try to line up matching\n"
"icons to win big.{page_break}"
"You have only 5 chances\n"
"to pull the lever.{page_break}"
"Press the star to keep\n"
"a wheel from spinning\n"
"and match other wheels.{page_break}"
"You get 1 line for\n"
"1 game ticket,\n"
"3 lines for 2 tickets,{page_break}"
"5 lines for 3 tickets,\n"
"and 7 lines for 4 tickets.{page_break}"
"Use all your\n"
"tickets on\n"
"Lucky Wheels!{end_wait}"

msgctxt "MsgTolbiLuckyWheelsPrizesPrizesDetermined"
msgid "03637"
msgstr ""
"Lucky Wheels Prizes{page_break}"
"Prizes are determined\n"
"by which icons you match.{page_break}"
"Shirts win undershirts,\n"
"Rings win rings,\n"
"Boots win boots,{page_break}"
"Stars and Hearts win\n"
"items, and Moons can win\n"
"you anything.{end_wait}"

msgctxt "MsgTolbiFaceAwayTolbi"
msgid "03638"
msgstr ""
"Face away from Tolbi\n"
"Spring and toss a\n"
"coin into it.{page_break}"
"If you get lucky,\n"
"something good will\n"
"happen.{end_wait}"

msgctxt "MsgTolbiTossLuckyMedal"
msgid "03639"
msgstr ""
"If you toss a Lucky\n"
"Medal and you get\n"
"really lucky,{page_break}"
"you'll get a better\n"
"prize than you\n"
"would with a coin.{end_wait}"

msgctxt "MsgTolbiSpringTolbiSpringHasMysteriousPowersStand"
msgid "03640"
msgstr ""
"Tolbi Spring has\n"
"mysterious powers.{page_break}"
"Stand with your back to\n"
"the spring, and throw\n"
"a coin at the target!{end_wait}"

msgctxt "MsgTolbiLuckyMedal"
msgid "03641"
msgstr ""
"Do you have\n"
"a Lucky Medal?{end_now}"

msgctxt "message"
msgid "03642"
msgstr ""
"Oh, you do?\n"
"How.{pause_20_skippable}.{pause_20_skippable}.lucky!{page_break}"
"That means you'll be\n"
"extra lucky if you toss\n"
"it in the fountain!{end_wait}"

msgctxt "message"
msgid "03643"
msgstr ""
"Hmm... If I were going\n"
"to try my luck, I'd want\n"
"to use a Lucky Medal.{end_wait}"

msgctxt "MsgTolbiSpringTooBadIOnlyHaveOne"
msgid "03644"
msgstr ""
"Too bad I only\n"
"have one Lucky Medal.{page_break}"
"I don't want to risk losing\n"
"it if I miss, since it's\n"
"my only one...{end_wait}"

msgctxt "MsgTolbiWantTestLuck"
msgid "03645"
msgstr ""
"Hmm? Do you want\n"
"to test your luck\n"
"at Tolbi Spring?{end_now}"

msgctxt "message"
msgid "03646"
msgstr ""
"Oh, you don't?\n"
"Well, I'm just going to\n"
"keep trying for a while.{end_wait}"

msgctxt "message"
msgid "03647"
msgstr ""
"Really? Well then, I'll give\n"
"you the chance to go\n"
"first.{end_wait}"

msgctxt "MsgTolbiAhIGuessIJustDont"
msgid "03648"
msgstr ""
"Ah... I guess I just don't\n"
"have very much luck.\n"
"How about you?{end_wait}"

msgctxt "MsgTolbiIKeepLosingCoinsButI"
msgid "03649"
msgstr ""
"I keep losing coins,\n"
"but I just can't stop!\n"
"What's wrong with me?{end_wait}"

msgctxt "message"
msgid "03650"
msgstr ""
"Would you like to\n"
"challenge Tolbi Spring?{end_now}"

msgctxt "MsgTolbiThrow"
msgid "03651"
msgstr "What will you throw?{end_now}"

msgctxt "message"
msgid "03652"
msgstr "You don't have any coins!{end_wait}"

msgctxt "message"
msgid "03653"
msgstr "You have no Lucky Medals!{end_wait}"

msgctxt "MsgTolbiWonNumberCoin"
msgid "03654"
msgstr ""
"You won\n"
"{argument_signed_number} coin{plural_suffix}!{end_wait}"

msgctxt "message"
msgid "03655"
msgstr ""
"You can't carry more items.\n"
"Do you still want to play?{end_now}"

msgctxt "message"
msgid "03656"
msgstr "{protagonist_name} gave up!{end_wait}"

msgctxt "MsgTolbiCoins"
msgid "03657"
msgstr "Coins"

msgctxt "MsgTolbiLuckyMedals"
msgid "03658"
msgstr "Lucky Medals"

msgctxt "MsgTolbiCounterMarker"
msgid "03659"
msgstr "="

msgctxt "MsgTolbiToss"
msgid "03660"
msgstr "{button_icon:1} Toss"

msgctxt "message"
msgid "03661"
msgstr "{button_icon:2} Quit"

msgctxt "MsgTolbiSpringIGetNervousWhenIToss"
msgid "03662"
msgstr ""
"I get nervous when I toss\n"
"coins backward. I wish\n"
"I could face forward...{end_wait}"

msgctxt "MsgTolbiSpringWhyWontAnyoneGiveMeA"
msgid "03663"
msgstr ""
"Why won't anyone\n"
"give me a Lucky Medal?{end_wait}"

msgctxt "MsgTolbiSpringThisIsALuckyMedalSo"
msgid "03664"
msgstr ""
"This is a Lucky Medal,\n"
"so it should be OK\n"
"if I miss by a bit.{page_break}"
"I need all the\n"
"good luck I can get.{end_wait}"

msgctxt "MsgTolbiSpringHmmIWonderIfTheseKids"
msgid "03665"
msgstr ""
"Hmm... I wonder if\n"
"these kids will take\n"
"all the best items...{end_wait}"

msgctxt "MsgValeWake"
msgid "03666"
msgstr "{actor_name:1}, wake up!{end_wait}"

msgctxt "message"
msgid "03667"
msgstr "Please, dear, wake up!{end_wait}"

msgctxt "message"
msgid "03668"
msgstr ""
"The Mt. Aleph Boulder\n"
"is going to fall!{end_wait}"

msgctxt "MsgValeComeOnHurry"
msgid "03669"
msgstr ""
"Come on, {actor_name:1}.\n"
"We have to go{em_dash}now!{end_wait}"

msgctxt "message"
msgid "03670"
msgstr ""
"{actor_name:1}! You forgot\n"
"something!{end_wait}"

msgctxt "message"
msgid "03671"
msgstr ""
"It's pouring outside!\n"
"Don't go out without\n"
"your tunic!{end_wait}"

msgctxt "message"
msgid "03672"
msgstr ""
"Have you got\n"
"everything you need?{end_now}"

msgctxt "message"
msgid "03673"
msgstr ""
"I'm sorry, but we\n"
"don't have time... You'll\n"
"have to leave it behind.{end_wait}"

msgctxt "message"
msgid "03674"
msgstr ""
"Good for you, {actor_name:1}.\n"
"A lost possession can be\n"
"replaced; a lost life can't.{end_wait}"

msgctxt "MsgValeDoraHurryBoulder"
msgid "03675"
msgstr ""
"{actor_name:1}, Dora, hurry!\n"
"The Boulder could\n"
"fall at any second!{end_wait}"

msgctxt "MsgValeKyleAbleStop"
msgid "03676"
msgstr ""
"Kyle... Will they be able\n"
"to stop the Boulder?{end_wait}"

msgctxt "message"
msgid "03677"
msgstr ""
"I don't think so...\n"
"Not for long, anyway...{end_wait}"

msgctxt "message"
msgid "03678"
msgstr ""
"You two go on ahead and\n"
"take refuge in the plaza.{end_wait}"

msgctxt "message"
msgid "03679"
msgstr "Aren't you coming?{end_wait}"

msgctxt "message"
msgid "03680"
msgstr ""
"I need to help evacuate\n"
"the other villagers.{end_wait}"

msgctxt "message"
msgid "03681"
msgstr "Let me help you, Kyle!{end_wait}"

msgctxt "message"
msgid "03682"
msgstr ""
"It's too dangerous, Dora.\n"
"Please, just take good\n"
"care of {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "03683"
msgstr ""
"{actor_name:1} is old enough to get\n"
"to the plaza on his own.{end_wait}"

msgctxt "message"
msgid "03684"
msgstr ""
"You can find your\n"
"way, can't you,\n"
"{actor_name:1}?{end_now}"

msgctxt "MsgValeBigBoyWhy"
msgid "03685"
msgstr ""
"You're a big boy\n"
"now, {actor_name:1}. Why don't you go\n"
"on your own?{end_now}"

msgctxt "MsgValeKnowWayGo"
msgid "03686"
msgstr ""
"You know the way{em_dash}just\n"
"go south to get to\n"
"the plaza. Be careful!{end_wait}"

msgctxt "MsgValeHuh"
msgid "03687"
msgstr "Huh? {actor_name:1}?{end_wait}"

msgctxt "message"
msgid "03688"
msgstr "Did you come to get me?{end_now}"

msgctxt "message"
msgid "03689"
msgstr ""
"Oh... {pause_20_skippable}Sorry to shove you\n"
"like that.{end_wait}"

msgctxt "message"
msgid "03690"
msgstr ""
"This isn't the time for\n"
"games! Foolish boy!{end_wait}"

msgctxt "message"
msgid "03691"
msgstr ""
"Well...{pause_20_skippable}we'd better get\n"
"to the plaza before\n"
"the Boulder hits.{end_wait}"

msgctxt "MsgValeUghHrnghhh"
msgid "03692"
msgstr "{text_effect:4}Ugh... {pause_20_skippable}Hrnghhh... {end_wait}"

msgctxt "message"
msgid "03693"
msgstr ""
"{actor_name:1}, what do you want?\n"
"I'm trying to\n"
"save my things!{end_wait}"

msgctxt "MsgValeWantDumpStuff"
msgid "03694"
msgstr ""
"What, you want me to\n"
"just dump my stuff?"

msgctxt "message"
msgid "03695"
msgstr ""
"I guess dragging a heavy\n"
"chest around like this\n"
"isn't very safe...{end_wait}"

msgctxt "MsgValeKnowRightOk"
msgid "03696"
msgstr ""
"You know, you're right.\n"
"OK!{pause_20_skippable} Let's get out of\n"
"here!{end_wait}"

msgctxt "MsgValeDontLeaveMeHere"
msgid "03697"
msgstr ""
"You're not just going to\n"
"leave me here, are you,\n"
"{actor_name:1}?{end_now}"

msgctxt "message"
msgid "03698"
msgstr ""
"I guess dragging a heavy\n"
"chest like this around\n"
"isn't very safe...{end_wait}"

msgctxt "message"
msgid "03699"
msgstr ""
"You know, you're right.\n"
"OK!{pause_20_skippable} Let's get out of\n"
"here!{end_wait}"

msgctxt "MsgValeHey"
msgid "03700"
msgstr "Hey! {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "03701"
msgstr "*Hah* {pause_20_skippable}*Hah*{end_wait}"

msgctxt "message"
msgid "03702"
msgstr "Are you trapped, too?{end_now}"

msgctxt "message"
msgid "03703"
msgstr ""
"Hmph!{pause_20_skippable} It's not like you to\n"
"be caught unprepared,\n"
"{actor_name:1}.{end_wait}"

msgctxt "message"
msgid "03704"
msgstr ""
"Oh, you got held up\n"
"seeing off the elders who\n"
"went to help the others!{end_wait}"

msgctxt "message"
msgid "03705"
msgstr ""
"You came just in time...\n"
"We can go together.{end_wait}"

msgctxt "message"
msgid "03706"
msgstr ""
"Everyone's gathering down\n"
"south, in the town plaza.{end_wait}"

msgctxt "MsgValeNorthLeadsToMtAleph"
msgid "03707"
msgstr ""
"We shouldn't go north...\n"
"that'll take us toward\n"
"Mt. Aleph.{end_wait}"

msgctxt "message"
msgid "03708"
msgstr ""
"The plaza is over that\n"
"way. We need to head\n"
"south.{end_wait}"

msgctxt "MsgValeCantGetAroundThisRock"
msgid "03709"
msgstr ""
"We can't get around\n"
"this rock!{end_wait}"

msgctxt "message"
msgid "03710"
msgstr ""
"We'll have to find\n"
"another way.{end_wait}"

msgctxt "MsgValeTheBoulderIsFalling"
msgid "03711"
msgstr ""
"{text_effect:4}Ahhh! The Boulder!\n"
"It's falling!{end_wait}"

msgctxt "message"
msgid "03712"
msgstr ""
"{text_effect:4}Ugh...{pause_20_skippable} "
"Ughnn...{pause_20_skippable}{pause_20_skippable}\n"
"It's too heavy!{pause_20_skippable}\n"
"We can't hold it for long!{end_wait}"

msgctxt "message"
msgid "03713"
msgstr ""
"If our Psynergy runs out,\n"
"Vale will be destroyed!{end_wait}"

msgctxt "message"
msgid "03714"
msgstr ""
"{text_effect:4}We have to hold on until\n"
"the villagers are safe!{end_wait}"

msgctxt "message"
msgid "03715"
msgstr ""
"Hurry, boys!{pause_20_skippable} Run!!!\n"
"It's just a little farther!{end_wait}"

msgctxt "message"
msgid "03716"
msgstr ""
"Come on, {actor_name:1}, run!\n"
"The Boulder is coming!{end_wait}"

msgctxt "MsgValeRockslideDestroyedFence"
msgid "03717"
msgstr ""
"Rockslide...destroyed\n"
"fence... Monsters\n"
"everywhere...{end_wait}"

msgctxt "message"
msgid "03718"
msgstr ""
"I'm{pause_20_skippable} hurt pretty badly...\n"
"Do you think I'll die?{end_now}"

msgctxt "message"
msgid "03719"
msgstr ""
"I knew it...{pause_20_skippable}\n"
"This is it for me.\n"
"Save yourselves...{end_wait}"

msgctxt "message"
msgid "03720"
msgstr ""
"This is awful.\n"
"I'm left here for\n"
"the monsters to...{end_wait}"

msgctxt "message"
msgid "03721"
msgstr ""
"Wait... That's strange...{pause_20_skippable}\n"
"I'm not hurt at all!{end_wait}"

msgctxt "message"
msgid "03722"
msgstr ""
"But I'm serious about the\n"
"monsters, so be careful\n"
"on your way to the plaza!{end_wait}"

msgctxt "MsgValeSaveYourselves"
msgid "03723"
msgstr ""
"This is it for me.\n"
"Save yourselves...{end_wait}"

msgctxt "MsgValeNoBrother"
msgid "03724"
msgstr "Oh no! My brother!{end_wait}"

msgctxt "message"
msgid "03725"
msgstr "Hang on, {actor_name:5}!{end_wait}"

msgctxt "message"
msgid "03726"
msgstr ""
"{actor_name:5} will be all\n"
"right. We'll find a\n"
"way to save him...{end_wait}"

msgctxt "message"
msgid "03727"
msgstr "{text_effect:4}Nooooo!{pause_20_skippable} {actor_name:5}!{end_wait}"

msgctxt "message"
msgid "03728"
msgstr ""
"The rope won't reach...\n"
"We should use Psynergy.\n"
"Do you have any left?{end_wait}"

msgctxt "message"
msgid "03729"
msgstr ""
"I've used all mine up.\n"
"What about you, Kyle?{end_wait}"

msgctxt "message"
msgid "03730"
msgstr ""
"I'm drained from helping\n"
"the other villagers...{end_wait}"

msgctxt "message"
msgid "03731"
msgstr "We have to get help.{end_wait}"

msgctxt "message"
msgid "03732"
msgstr ""
"Can {actor_name:5} hang on\n"
"long enough for us to\n"
"find help?{end_wait}"

msgctxt "message"
msgid "03733"
msgstr ""
"There's nothing else\n"
"we can do for him\n"
"here,{pause_20_skippable} is there?{end_wait}"

msgctxt "message"
msgid "03734"
msgstr ""
"Then go get help, but be\n"
"as quick as possible!{end_wait}"

msgctxt "message"
msgid "03735"
msgstr "{actor_name:6}, can you go too?{end_wait}"

msgctxt "message"
msgid "03736"
msgstr "You'll go find help, right?{end_wait}"

msgctxt "message"
msgid "03737"
msgstr ""
"Your brother's counting\n"
"on you, {actor_name:6}.{end_wait}"

msgctxt "message"
msgid "03738"
msgstr ""
"All right,\n"
"let's get going!{end_wait}"

msgctxt "MsgValeGoLookNorth"
msgid "03739"
msgstr ""
"I'll go look up north...\n"
"You head for the plaza,\n"
"all right?{end_wait}"

msgctxt "message"
msgid "03740"
msgstr ""
"Yes, ma'am. We're looking\n"
"for anyone with any\n"
"Psynergy left, right?{end_wait}"

msgctxt "message"
msgid "03741"
msgstr "{actor_name:1}!{end_wait}"

msgctxt "message"
msgid "03742"
msgstr "You saw what happened?{end_now}"

msgctxt "message"
msgid "03743"
msgstr ""
"I have to go get help\n"
"before {actor_name:5} drowns!{end_wait}"

msgctxt "message"
msgid "03744"
msgstr ""
"I'm looking for someone\n"
"who can help {actor_name:5}.\n"
"He's fallen into the river.{end_wait}"

msgctxt "MsgValeDontSupposeTwo"
msgid "03745"
msgstr ""
"I don't suppose...{pause_20_skippable}\n"
"Could the two of\n"
"you help me?{end_now}"

msgctxt "message"
msgid "03746"
msgstr ""
"{actor_name:6} has gone to the\n"
"plaza to get help.\n"
"Go join her.{end_wait}"

msgctxt "message"
msgid "03747"
msgstr ""
"You don't have to if you\n"
"don't want to...{pause_20_skippable} Just get\n"
"yourselves to the plaza.{end_wait}"

msgctxt "MsgValeOh"
msgid "03748"
msgstr "Oh, {actor_name:1}...{end_wait}"

msgctxt "MsgValeTwoDontEnough"
msgid "03749"
msgstr ""
"You two don't have enough\n"
"Psynergy to save {actor_name:5}.\n"
"Go find help.{end_wait}"

msgctxt "MsgValeHangOnFelixHelpIsOn"
msgid "03750"
msgstr ""
"Hang on, {actor_name:5}!\n"
"Help is on the way!{end_wait}"

msgctxt "MsgValeDontLetGoFelix"
msgid "03751"
msgstr "Don't let go, {actor_name:5}!{end_wait}"

msgctxt "MsgValeCanIUsePsynergy"
msgid "03752"
msgstr ""
"Huh?{pause_20_skippable} Are you...asking me\n"
"if I can use Psynergy,\n"
"{actor_name:1}?{end_now}"

msgctxt "message"
msgid "03753"
msgstr ""
"If I were ten years\n"
"younger, I'd have plenty\n"
"to offer, but I'm too old...{end_wait}"

msgctxt "message"
msgid "03754"
msgstr ""
"I thought not... You have\n"
"to be young and strong\n"
"to use Psynergy...{end_wait}"

msgctxt "MsgValeOldWomanCannotUsePsynergy"
msgid "03755"
msgstr ""
"You expect an old woman\n"
"like me to use Psynergy?{page_break}"
"Don't ask the impossible!{end_wait}"

msgctxt "MsgValeExhaustedFromFallingRocks"
msgid "03756"
msgstr ""
"{text_effect:4}Ohhh...{reset_text_style} I'm exhausted.{page_break}"
"I used up all my Psynergy\n"
"deflecting falling rocks...{end_wait}"

msgctxt "MsgValeFelixFellInRiver"
msgid "03757"
msgstr ""
"Oh!{pause_20_skippable} Little {actor_name:5} has\n"
"fallen into the river?{page_break}"
"That must be why {actor_name:6}\n"
"looked so upset.{end_wait}"

msgctxt "MsgValeIHaveSomePsynergyLeft"
msgid "03758"
msgstr ""
"I have some Psynergy\n"
"left.{end_wait}"

msgctxt "message"
msgid "03759"
msgstr ""
"See?{page_break}"
"Isn't that impressive!?{end_wait}"

msgctxt "MsgValeWentOffWay"
msgid "03760"
msgstr "{actor_name:6} went off that way!{end_wait}"

msgctxt "MsgValeSureHelp"
msgid "03761"
msgstr "Be sure to help {actor_name:5}.{end_wait}"

msgctxt "message"
msgid "03762"
msgstr ""
"Do you know what became\n"
"of the boulder that fell\n"
"from Mt. Aleph?{end_now}"

msgctxt "message"
msgid "03763"
msgstr ""
"What?{pause_20_skippable} It's falling toward\n"
"the village? The elders\n"
"are holding it back?!?{page_break}"
"They are the most\n"
"powerful Psynergy Adepts\n"
"in Vale.{end_wait}"

msgctxt "message"
msgid "03764"
msgstr ""
"They said the Boulder\n"
"would have to fall\n"
"sometime...{page_break}"
"I just knew a storm like\n"
"this would knock it loose!{end_wait}"

msgctxt "message"
msgid "03765"
msgstr ""
"{actor_name:6} asked me to help\n"
"{actor_name:5}.{page_break}"
"If I didn't have to use\n"
"Psynergy, I'd help in an\n"
"instant!{end_wait}"

msgctxt "MsgValeGoAidElders"
msgid "03766"
msgstr ""
"Go aid the elders! The\n"
"Boulder is too heavy for\n"
"them to hold much longer.{end_wait}"

msgctxt "message"
msgid "03767"
msgstr ""
"We can't let the Mt.\n"
"Aleph Boulder destroy\n"
"our village.{end_wait}"

msgctxt "message"
msgid "03768"
msgstr ""
"Let's go help the\n"
"elders.{end_wait}"

msgctxt "message"
msgid "03769"
msgstr "We're counting on you.{end_wait}"

msgctxt "message"
msgid "03770"
msgstr "Grandpa! {actor_name:6}!{end_wait}"

msgctxt "message"
msgid "03771"
msgstr ""
"{actor_name:2}, {actor_name:1}...\n"
"You came to help me?{end_wait}"

msgctxt "message"
msgid "03772"
msgstr ""
"{actor_name:6} told me about\n"
"{actor_name:5}. Is that\n"
"why you're here?{end_now}"

msgctxt "message"
msgid "03773"
msgstr ""
"Well, regardless,{pause_20_skippable} I\n"
"want you two to help\n"
"{actor_name:6}.{end_wait}"

msgctxt "message"
msgid "03774"
msgstr ""
"Good boys!\n"
"{actor_name:6} could\n"
"use a hand.{end_wait}"

msgctxt "message"
msgid "03775"
msgstr "Great!{pause_20_skippable} I'm all charged up!{end_wait}"

msgctxt "message"
msgid "03776"
msgstr ""
"How are you?{pause_20_skippable} Have you\n"
"recovered your Psynergy?{end_wait}"

msgctxt "message"
msgid "03777"
msgstr ""
"Enough to save {actor_name:5},\n"
"thanks to the Psynergy\n"
"Stone.{end_wait}"

msgctxt "message"
msgid "03778"
msgstr ""
"OK, {actor_name:6}, you heard\n"
"him. Now hurry back!{end_wait}"

msgctxt "message"
msgid "03779"
msgstr ""
"The path may be blocked\n"
"by fallen rocks. You two\n"
"can show them the way!{end_wait}"

msgctxt "message"
msgid "03780"
msgstr "...Thank you, {actor_name:1}.{end_wait}"

msgctxt "MsgValeRaceAgainstTime"
msgid "03781"
msgstr ""
"We're in a race against\n"
"time! You must hurry!{end_wait}"

msgctxt "MsgValeMomDadBack"
msgid "03782"
msgstr "Mom! Dad!{pause_20_skippable} We're back!{end_wait}"

msgctxt "message"
msgid "03783"
msgstr "Is that you, {actor_name:6}?{end_wait}"

msgctxt "message"
msgid "03784"
msgstr "Yes, ma'am...{end_wait}"

msgctxt "message"
msgid "03785"
msgstr ""
"I couldn't find anyone\n"
"who could help...{page_break}"
"How did you do?{end_wait}"

msgctxt "message"
msgid "03786"
msgstr "You're just in time.{end_wait}"

msgctxt "message"
msgid "03787"
msgstr ""
"Then my brother is\n"
"still...{end_wait}"

msgctxt "message"
msgid "03788"
msgstr ""
"{actor_name:5} is all right.{pause_20_skippable}\n"
"He's hanging in there.{end_wait}"

msgctxt "message"
msgid "03789"
msgstr ""
"Come down here, so\n"
"we can save {actor_name:5}!{end_wait}"

msgctxt "MsgValeNoItCantBeKyleIt"
msgid "03790"
msgstr ""
"No...{pause_20_skippable} It can't be. Kyle...\n"
"It must be a dream...{end_wait}"

msgctxt "MsgValeMomDadFelixPleaseDontLeave"
msgid "03791"
msgstr ""
"Mom, Dad...{pause_20_skippable} "
"{actor_name:5}...{pause_20_skippable}{pause_20_skippable}\n"
"Please...{pause_20_skippable} Don't leave me\n"
"all alone...{end_wait}"

msgctxt "MsgValeBoulderNeedGet"
msgid "03792"
msgstr ""
"{actor_name:1}... The Boulder...{pause_20_skippable}{pause_20_skippable}\n"
"We need to get help,\n"
"or everyone will drown...{end_wait}"

msgctxt "MsgValeIllGo"
msgid "03793"
msgstr ""
"{text_effect:4}Oh,{pause_20_skippable} ohhh...{pause_20_skippable} I...\n"
"I'll go!{end_wait}"

msgctxt "MsgValeICantMoveGetHelp"
msgid "03794"
msgstr ""
"{text_effect:4}It's no use.{pause_20_skippable} I can't "
"move...{pause_20_skippable}{pause_20_skippable}\n"
"{actor_name:1}, please get help!{end_wait}"

msgctxt "MsgValeIsaac"
msgid "03795"
msgstr "{actor_name:1}...{end_wait}"

msgctxt "message"
msgid "03796"
msgstr ""
"I can't let him\n"
"go alone...{end_wait}"

msgctxt "message"
msgid "03797"
msgstr ""
"It's times like these\n"
"that we men have to\n"
"stand together!{end_wait}"

msgctxt "MsgValeOnlyTwoSurvived"
msgid "03798"
msgstr ""
"Only the two of us\n"
"survived...{end_wait}"

msgctxt "message"
msgid "03799"
msgstr ""
"How could we have\n"
"anticipated Sol Sanctum\n"
"would unleash such fury?{end_wait}"

msgctxt "message"
msgid "03800"
msgstr ""
"It's a miracle that even\n"
"the two of us were\n"
"spared...{end_wait}"

msgctxt "message"
msgid "03801"
msgstr ""
"That switch...{pause_20_skippable}\n"
"It must have\n"
"been a trap...{end_wait}"

msgctxt "message"
msgid "03802"
msgstr ""
"But to think it could\n"
"conjure up a storm\n"
"this powerful!{end_wait}"

msgctxt "message"
msgid "03803"
msgstr ""
"...Another demonstration\n"
"of the awesome powers\n"
"of Alchemy.{end_wait}"

msgctxt "message"
msgid "03804"
msgstr ""
"Regardless, we must not\n"
"fail the next time we\n"
"challenge Sol Sanctum.{end_wait}"

msgctxt "message"
msgid "03805"
msgstr ""
"Next time,{pause_20_skippable} we shall\n"
"certainly...{end_wait}"

msgctxt "message"
msgid "03806"
msgstr "{actor_name:1}! Wait!{end_wait}"

msgctxt "message"
msgid "03807"
msgstr ""
"You were eavesdropping\n"
"on us just now...\n"
"weren't you?{end_now}"

msgctxt "message"
msgid "03808"
msgstr "{actor_name:1}...{end_wait}"

msgctxt "message"
msgid "03809"
msgstr ""
"{actor_name:1}{pause_20_skippable}, they look\n"
"scary...{page_break}"
"Are you sure you should\n"
"be talking to them?{end_wait}"

msgctxt "message"
msgid "03810"
msgstr ""
"You must forget\n"
"everything you heard.{end_wait}"

msgctxt "message"
msgid "03811"
msgstr ""
"Don't worry...\n"
"We'll help you forget!{end_wait}"

msgctxt "MsgValeDoorWontOpen"
msgid "03812"
msgstr ""
"The door won't open.{page_break}"
"The force of the impact\n"
"must have knocked it off\n"
"its hinges.{end_wait}"

msgctxt "MsgValeThinkForgetThings"
msgid "03813"
msgstr ""
"You think I should\n"
"forget these things and\n"
"save my own life?{end_wait}"

msgctxt "MsgValeRockHitsLose"
msgid "03814"
msgstr ""
"Hmm... If a rock hits me\n"
"now, I'll lose both my\n"
"chest and my life.{end_wait}"

msgctxt "MsgValeRightDitchStuff"
msgid "03815"
msgstr ""
"You're right{em_dash}I should\n"
"just ditch my stuff.\n"
"Let's get out of here.{end_wait}"

msgctxt "MsgValeRepairCaption"
msgid "03816"
msgstr "Three years later...{end_wait}"

msgctxt "message"
msgid "03817"
msgstr ""
"{actor_name:1}! Haven't you\n"
"finished mending the roof\n"
"yet?{end_wait}"

msgctxt "message"
msgid "03818"
msgstr ""
"You're almost done?\n"
"OK! Keep at it!{end_wait}"

msgctxt "message"
msgid "03819"
msgstr "Hyaa!{end_wait}"

msgctxt "message"
msgid "03820"
msgstr ""
"Hee hee...\n"
"Still training, {actor_name:2}?{end_wait}"

msgctxt "message"
msgid "03821"
msgstr "Hyaaaa!{end_wait}"

msgctxt "message"
msgid "03822"
msgstr ""
"You sure do put your\n"
"heart into it, {actor_name:2}!{end_wait}"

msgctxt "message"
msgid "03823"
msgstr "Oh, I'm just finishing up.{end_wait}"

msgctxt "message"
msgid "03824"
msgstr ""
"That's good. It's time to\n"
"go, and I was about\n"
"to leave you behind.{end_wait}"

msgctxt "message"
msgid "03825"
msgstr ""
"Say,{pause_20_skippable} what exactly\n"
"happened to you two?{end_wait}"

msgctxt "message"
msgid "03826"
msgstr ""
"The accident three years\n"
"ago...{pause_20_skippable} Is that why you've\n"
"been studying Psynergy?{end_wait}"

msgctxt "message"
msgid "03827"
msgstr ""
"I appreciate your concern,\n"
"but...my family's never\n"
"coming back,{page_break}"
"{pause_20_skippable}and neither is {actor_name:1}{possessive_suffix}\n"
"father...{end_wait}"

msgctxt "message"
msgid "03828"
msgstr ""
"I just want to forget\n"
"that day.{pause_20_skippable} I wish\n"
"everyone would...{end_wait}"

msgctxt "message"
msgid "03829"
msgstr ""
"That awful day... We went\n"
"to get help, but they\n"
"found us unconscious...{end_now}"

msgctxt "message"
msgid "03830"
msgstr ""
"Well, let's get {actor_name:1}\n"
"and go to Kraden's...{end_now}"

msgctxt "message"
msgid "03831"
msgstr "What, {actor_name:2}?{end_wait}"

msgctxt "message"
msgid "03832"
msgstr ""
"Huh?{pause_20_skippable} You were about to\n"
"say something, weren't\n"
"you?{end_wait}"

msgctxt "message"
msgid "03833"
msgstr "Don't be weird, {actor_name:2}!{end_wait}"

msgctxt "message"
msgid "03834"
msgstr "Whatever...{end_wait}"

msgctxt "message"
msgid "03835"
msgstr "{actor_name:6},{pause_20_skippable} are you mad at me?{end_wait}"

msgctxt "message"
msgid "03836"
msgstr ""
"I don't want to\n"
"talk about it.{end_wait}"

msgctxt "message"
msgid "03837"
msgstr "Come on!!!{end_wait}"

msgctxt "message"
msgid "03838"
msgstr "Huh?{end_wait}"

msgctxt "message"
msgid "03839"
msgstr "{actor_name:1}'s waiting for us.{end_wait}"

msgctxt "message"
msgid "03840"
msgstr "But, {actor_name:6}...!{end_wait}"

msgctxt "message"
msgid "03841"
msgstr ""
"I'll leave you behind\n"
"if you're too slow.{end_wait}"

msgctxt "message"
msgid "03842"
msgstr "{actor_name:6}...{end_wait}"

msgctxt "MsgValeGoodJob"
msgid "03843"
msgstr "Good job, {actor_name:1}.{end_wait}"

msgctxt "message"
msgid "03844"
msgstr "You patched it nicely.{end_wait}"

msgctxt "message"
msgid "03845"
msgstr "All right. You're all done.{end_wait}"

msgctxt "message"
msgid "03846"
msgstr ""
"You're very reliable,\n"
"{actor_name:1}...just like your\n"
"father was.{end_wait}"

msgctxt "message"
msgid "03847"
msgstr ""
"What is it, {actor_name:1}? Do\n"
"you still think about\n"
"the accident?{end_now}"

msgctxt "message"
msgid "03848"
msgstr "I don't believe you...{end_wait}"

msgctxt "message"
msgid "03849"
msgstr "I thought so... {actor_name:1}...{end_wait}"

msgctxt "MsgValeWorkingYourselvesBone"
msgid "03850"
msgstr ""
"You and {actor_name:2} have been\n"
"working yourselves to the\n"
"bone studying Psynergy.{end_wait}"

msgctxt "message"
msgid "03851"
msgstr ""
"Do you think things would\n"
"be any different if you'd\n"
"had stronger abilities?{end_now}"

msgctxt "message"
msgid "03852"
msgstr "That's what I thought.{end_wait}"

msgctxt "message"
msgid "03853"
msgstr "Hmmm...{pause_20_skippable} I wonder...{end_wait}"

msgctxt "MsgValeDevastatedWhenKyle"
msgid "03854"
msgstr ""
"I was devastated when\n"
"Kyle died...{end_wait}"

msgctxt "message"
msgid "03855"
msgstr "I felt all alone...{end_wait}"

msgctxt "message"
msgid "03856"
msgstr ""
"It's taken some time, but{pause_20_skippable}\n"
"I'm better now.{end_wait}"

msgctxt "message"
msgid "03857"
msgstr "I still have you,{pause_20_skippable} {actor_name:1}.{end_wait}"

msgctxt "message"
msgid "03858"
msgstr ""
"You're almost seventeen.\n"
"You're so much like Kyle\n"
"was when he was young.{end_wait}"

msgctxt "message"
msgid "03859"
msgstr ""
"I'm looking forward to\n"
"seeing where life takes\n"
"you.{end_wait}"

msgctxt "message"
msgid "03860"
msgstr "MA'{pause_20_skippable}AAAAM!!!{end_wait}"

msgctxt "message"
msgid "03861"
msgstr "Hello, {actor_name:6}.{end_wait}"

msgctxt "message"
msgid "03862"
msgstr "Good morning.{end_wait}"

msgctxt "message"
msgid "03863"
msgstr "Yes, yes... Good morning.{end_wait}"

msgctxt "message"
msgid "03864"
msgstr ""
"Well, if it isn't {actor_name:2},\n"
"too!{end_wait}"

msgctxt "message"
msgid "03865"
msgstr ""
"Where do you all plan\n"
"to go today?{end_wait}"

msgctxt "message"
msgid "03866"
msgstr ""
"We're going to Mt.\n"
"Aleph with Kraden.{end_wait}"

msgctxt "message"
msgid "03867"
msgstr ""
"Mountain climbing\n"
"with Kraden, eh?{end_wait}"

msgctxt "message"
msgid "03868"
msgstr "Kids and their games...{end_wait}"

msgctxt "message"
msgid "03869"
msgstr ""
"No!{pause_20_skippable} It's part of our\n"
"studies...{end_wait}"

msgctxt "message"
msgid "03870"
msgstr "Ah, yes... Alchemy.{end_wait}"

msgctxt "message"
msgid "03871"
msgstr ""
"Alchemy is the foundation\n"
"of all Psynergy...{end_wait}"

msgctxt "message"
msgid "03872"
msgstr ""
"And you all know Mt.\n"
"Aleph is the greatest\n"
"source of Alchemy.{end_wait}"

msgctxt "message"
msgid "03873"
msgstr ""
"They say Kraden is the\n"
"best teacher around.{end_wait}"

msgctxt "message"
msgid "03874"
msgstr ""
"Alchemy... I wonder what\n"
"use it all is?{end_wait}"

msgctxt "message"
msgid "03875"
msgstr ""
"Your mother would rather\n"
"see you grow up to be\n"
"a happy, ordinary man.{end_wait}"

msgctxt "message"
msgid "03876"
msgstr ""
"But I suppose you\n"
"still want to go...{end_now}"

msgctxt "message"
msgid "03877"
msgstr ""
"Well, if that won't\n"
"persuade you, I guess\n"
"nothing will!{end_wait}"

msgctxt "message"
msgid "03878"
msgstr ""
"It's nice of you to humor\n"
"me, but I know you\n"
"don't mean it.{end_wait}"

msgctxt "MsgValeAsStubbornAsYourFather"
msgid "03879"
msgstr ""
"You're just as stubborn\n"
"as your father!{end_wait}"

msgctxt "message"
msgid "03880"
msgstr "Ahhh!{page_break}"

msgctxt "message"
msgid "03881"
msgstr "Be careful, ma'am!"

msgctxt "message"
msgid "03882"
msgstr "{actor_name:2}, don't!{end_wait}"

msgctxt "message"
msgid "03883"
msgstr "Oh! That was exciting!{end_wait}"

msgctxt "message"
msgid "03884"
msgstr ""
"I'm sorry I scared you\n"
"like that.{end_wait}"

msgctxt "message"
msgid "03885"
msgstr "Well!{end_wait}"

msgctxt "message"
msgid "03886"
msgstr ""
"I...{pause_20_skippable} I'm sorry, ma'am.\n"
"I'll get out of your way\n"
"right away!{end_wait}"

msgctxt "message"
msgid "03887"
msgstr "Wait! Not there!{end_wait}"

msgctxt "message"
msgid "03888"
msgstr "Huh?{pause_20_skippable} What's wrong with{em_dash}{end_wait}"

msgctxt "message"
msgid "03889"
msgstr "Oh, never mind...{end_wait}"

msgctxt "message"
msgid "03890"
msgstr ""
"But you'd better\n"
"get going...{end_wait}"

msgctxt "message"
msgid "03891"
msgstr ""
"This old house will fall\n"
"apart if you stay much\n"
"longer.{end_wait}"

msgctxt "message"
msgid "03892"
msgstr ""
"I'll get this fixed up.\n"
"You don't have to\n"
"hang around here.{end_wait}"

msgctxt "message"
msgid "03893"
msgstr "Thank you, ma'am.{end_wait}"

msgctxt "message"
msgid "03894"
msgstr "Please, call me Dora.{end_wait}"

msgctxt "message"
msgid "03895"
msgstr ""
"We'll get going\n"
"right away!{end_wait}"

msgctxt "message"
msgid "03896"
msgstr ""
"Wait, {actor_name:2}...{pause_20_skippable}{pause_20_skippable}\n"
"Just{pause_20_skippable} watch your step.{end_wait}"

msgctxt "MsgValeKradenIsWaitingForUs"
msgid "03897"
msgstr ""
"Kraden is waiting for us.\n"
"We should go to his\n"
"house.{end_wait}"

msgctxt "MsgValeQuietDay"
msgid "03898"
msgstr ""
"Well, if it isn't {actor_name:1}.\n"
"It's just another quiet\n"
"day in Vale.{end_wait}"

msgctxt "MsgValeKradenHadVisitors"
msgid "03899"
msgstr ""
"Kraden had visitors\n"
"when I dropped by his\n"
"place this morning.{page_break}"
"I wonder what became of\n"
"them...{end_wait}"

msgctxt "MsgValeMeditateOnMtAlephDaily"
msgid "03900"
msgstr ""
"{protagonist_name}! Have you\n"
"remembered to meditate\n"
"on Mt. Aleph daily?{end_now}"

msgctxt "message"
msgid "03901"
msgstr ""
"That's very good of you!\n"
"Meditating helps keep the\n"
"peace in the village.{page_break}"
"If everyone were like you,\n"
"things would have gone\n"
"better three years ago!{end_wait}"

msgctxt "message"
msgid "03902"
msgstr ""
"For shame, {protagonist_name}!\n"
"Mt. Aleph keeps\n"
"watch over Vale.{page_break}"
"Meditate each and\n"
"every day to help\n"
"keep us safe.{end_wait}"

msgctxt "MsgValeADifficultTimeThreeYears"
msgid "03903"
msgstr ""
"You had a very difficult\n"
"time three years ago,\n"
"didn't you?{end_now}"

msgctxt "message"
msgid "03904"
msgstr ""
"You lost your father...\n"
"{actor_name:6} lost her whole\n"
"family...{pause_20_skippable} It was awful.{page_break}"
"At least {actor_name:6}{possessive_suffix}\n"
"grandparents have been\n"
"able to care for her...{end_wait}"

msgctxt "message"
msgid "03905"
msgstr ""
"You're a strong lad,\n"
"{actor_name:1}, so you were able\n"
"to deal with it all...{page_break}"
"But I just couldn't bear\n"
"seeing {actor_name:6} like\n"
"that.{end_wait}"

msgctxt "MsgValeChosenPeople"
msgid "03906"
msgstr ""
"The Valeans are a\n"
"chosen people.{page_break}"
"Our powers of Psynergy\n"
"are proof of that.{end_wait}"

msgctxt "MsgValeProudOfAdeptGrandfather"
msgid "03907"
msgstr ""
"Long ago, my grandfather\n"
"was a powerful Adept...\n"
"I'm so proud of him.{end_wait}"

msgctxt "MsgValeDidTheTravelersMeetThe"
msgid "03908"
msgstr ""
"Did the travelers that\n"
"stopped by today go\n"
"to meet the mayor?{end_now}"

msgctxt "message"
msgid "03909"
msgstr ""
"I told them where\n"
"Kraden lives, and they\n"
"didn't even thank me.{page_break}"
"But I suppose they must\n"
"have some manners...{end_wait}"

msgctxt "message"
msgid "03910"
msgstr ""
"It's very polite to\n"
"visit the mayor when\n"
"coming to a new town.{page_break}"
"It's just shameful\n"
"not to do that.{end_wait}"

msgctxt "MsgValePracticePsynergy"
msgid "03911"
msgstr ""
"With Psynergy,\n"
"the more you practice,\n"
"the more you learn.{end_wait}"

msgctxt "MsgValeShownNewAbility"
msgid "03912"
msgstr ""
"Hey, {protagonist_name}, have\n"
"I shown you my new\n"
"ability?{end_now}"

msgctxt "message"
msgid "03913"
msgstr ""
"It takes hard work to\n"
"reach this level of\n"
"mastery, {protagonist_name}.{end_wait}"

msgctxt "message"
msgid "03914"
msgstr ""
"Really? Well, here's\n"
"a little sample for you!{end_wait}"

msgctxt "MsgValeBeholdPowerPsynergy"
msgid "03915"
msgstr ""
"Behold, the power of\n"
"Psynergy!{pause_20_skippable} Hahh!{pause_20_skippable}\n"
"Impressive, isn't it?{end_wait}"

msgctxt "MsgValeWalkToRecoverPsynergy"
msgid "03916"
msgstr ""
"If your Psynergy runs\n"
"low, just walk around.\n"
"You'll recover it slowly.{end_wait}"

msgctxt "MsgValeRrruffRrrruff"
msgid "03917"
msgstr "Rrruff! Rrrruff!{end_wait}"

msgctxt "message"
msgid "03918"
msgstr "Woof! Woof!{end_wait}"

msgctxt "MsgValePuppiesPlayingOver"
msgid "03919"
msgstr ""
"There are some puppies\n"
"playing over there.{page_break}"
"We should let them be.{end_wait}"

msgctxt "message"
msgid "03920"
msgstr ""
"Those who can wield\n"
"Psynergy are called\n"
"Adepts.{page_break}"
"Adepts are the servants\n"
"of good.\n"
"Never forget that!{end_wait}"

msgctxt "message"
msgid "03921"
msgstr ""
"Our Psynergy was given\n"
"to us by the divine power\n"
"of Mt. Aleph.{page_break}"
"It's because of Psynergy\n"
"that our wishes can\n"
"be granted.{end_wait}"

msgctxt "message"
msgid "03922"
msgstr ""
"Psynergy should be used\n"
"to create peace...{pause_20_skippable} It must\n"
"not be used for evil!{end_wait}"

msgctxt "MsgValeGoodWeaponsDrawOutStrength"
msgid "03923"
msgstr ""
"Good weapons aren't just\n"
"sharp. They also draw out\n"
"the strength of the user.{page_break}"
"...So said my father. Do\n"
"you know what he meant,\n"
"{protagonist_name}? I do...{end_wait}"

msgctxt "MsgValeGoodArmorDrawsOutStrength"
msgid "03924"
msgstr ""
"Good armor isn't just\n"
"sturdy. It also draws out\n"
"the strength of the user.{page_break}"
"...That's what they\n"
"say, but I don't know\n"
"what it means...{end_wait}"

msgctxt "MsgValeAWiseManFleesWhen"
msgid "03925"
msgstr ""
"A wise man knows to\n"
"flee from battle\n"
"when he's injured.{end_wait}"

msgctxt "MsgValeMyFatherAlsoDiedInThat"
msgid "03926"
msgstr ""
"My father also died in\n"
"that storm three years\n"
"ago.{page_break}"
"I'm going to hone my\n"
"skills...{pause_20_skippable} That way, I'll be\n"
"ready for anything.{end_wait}"

msgctxt "MsgValeMySonIsStillYoungSo"
msgid "03927"
msgstr ""
"My son is still young,\n"
"so I don't make him\n"
"work too long.{page_break}"
"But he takes after his\n"
"father, so I'm sure he'll\n"
"grow to be a fine man.{end_wait}"

msgctxt "MsgValeTheThreeTravelersSeemOdd"
msgid "03928"
msgstr ""
"Those three travelers\n"
"staying here may not\n"
"be thieves,{page_break}"
"but there's something\n"
"strange about them.{end_wait}"

msgctxt "MsgValeOneOfTheMenFromThat"
msgid "03929"
msgstr ""
"One of the men from that\n"
"group staying here wore\n"
"a mask over his face.{page_break}"
"I guess he was trying\n"
"to cover up some scars\n"
"or something...{end_wait}"

msgctxt "MsgValeTwoOfThoseThreeGuestsStaying"
msgid "03930"
msgstr ""
"Two of those three\n"
"guests staying with us\n"
"have gone out.{end_wait}"

msgctxt "MsgValeHeyBoy"
msgid "03931"
msgstr "Hey...{pause_20_skippable} Boy...{end_wait}"

msgctxt "message"
msgid "03932"
msgstr ""
"Do you have business\n"
"with me?{end_now}"

msgctxt "message"
msgid "03933"
msgstr ""
"That's too bad, because\n"
"I have no business\n"
"with you. Be off!{end_wait}"

msgctxt "message"
msgid "03934"
msgstr ""
"Then I suggest you stop\n"
"wasting my time.{end_wait}"

msgctxt "MsgValeAtTheVeryLeastVisitorsShould"
msgid "03935"
msgstr ""
"At the very least,\n"
"visitors should introduce\n"
"themselves to the mayor.{page_break}"
"There seems to be an\n"
"appalling group in town\n"
"that won't even do that...{page_break}"
"What's the world\n"
"coming to?{end_wait}"

msgctxt "MsgValeIHearKradenHasGuestsAgain"
msgid "03936"
msgstr ""
"I hear Kraden has guests\n"
"again. He's pretty\n"
"popular for a sage.{end_wait}"

msgctxt "MsgValeGaretHasGrownQuiteStrongIn"
msgid "03937"
msgstr ""
"{actor_name:2} has grown\n"
"quite strong in the\n"
"past three years.{page_break}"
"Please watch over him.{end_wait}"

msgctxt "MsgValeYouAndGaretAreOlderNow"
msgid "03938"
msgstr ""
"You and {actor_name:2} are older\n"
"now, and you can't waste\n"
"your time fooling around.{end_wait}"

msgctxt "MsgValeYouMakeMeSoMad"
msgid "03939"
msgstr ""
"{actor_name:2}, you make me\n"
"so mad sometimes!{end_wait}"

msgctxt "message"
msgid "03940"
msgstr ""
"Your training stone\n"
"crushed my flowers!{end_wait}"

msgctxt "message"
msgid "03941"
msgstr ""
"You're in for it tonight...\n"
"{pause_20_skippable}Just {pause_20_skippable}wait {pause_20_skippable}and "
"{pause_20_skippable}see!{end_wait}"

msgctxt "MsgValeIllGetYouForMy"
msgid "03942"
msgstr ""
"I'll get you for my\n"
"flowers! {pause_20_skippable}Just see\n"
"what "
"happens.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}tonigh"
"t!{end_wait}"

msgctxt "MsgValeYoureInTroubleNowGaretYour"
msgid "03943"
msgstr ""
"You're in trouble now,\n"
"{actor_name:2}...{page_break}"
"Your sister's really mad!{end_wait}"

msgctxt "MsgValeIToldGaretItWas"
msgid "03944"
msgstr ""
"I told that clumsy {actor_name:2}\n"
"it would be all right...{page_break}"
"But what am I going to\n"
"do about this hole?{end_wait}"

msgctxt "MsgValeItWontRainForSome"
msgid "03945"
msgstr ""
"It looks like it won't\n"
"rain for some time...{page_break}"
"so I guess I'll just have\n"
"you fix it later, {actor_name:1}.{end_wait}"

msgctxt "MsgValeMyGranddaughterJennaIsFinallyHappy"
msgid "03946"
msgstr ""
"My granddaughter, {actor_name:6},\n"
"is finally happy again...{page_break}"
"I have you and {actor_name:2}\n"
"to thank for that, {actor_name:1}.{end_wait}"

msgctxt "MsgValeIHopeYouTwoWontBe"
msgid "03947"
msgstr ""
"I hope you two won't be\n"
"taking {actor_name:6} outside the\n"
"village with you.{end_wait}"

msgctxt "MsgValeJennaIsTheSpittingImageOf"
msgid "03948"
msgstr ""
"{actor_name:6} is the spitting\n"
"image of her mother,\n"
"whom we lost that day...{page_break}"
"I just want {actor_name:6} to be\n"
"happy.{end_wait}"

msgctxt "MsgValeKradenCameToStudyMt"
msgid "03949"
msgstr ""
"So Kraden came to\n"
"Vale to study\n"
"Mt. Aleph, right?{end_now}"

msgctxt "message"
msgid "03950"
msgstr ""
"He said he was studying\n"
"Mt. Aleph and Alchemy\n"
"and the like...{page_break}"
"Mt. Aleph... Alchemy...\n"
"Are they related\n"
"somehow?{end_wait}"

msgctxt "message"
msgid "03951"
msgstr ""
"But I thought...\n"
"Well, whatever.{page_break}"
"If he furthers the\n"
"wisdom of the sages, it\n"
"will be quite a feat.{end_wait}"

msgctxt "MsgValeIfThereAreVisitorsInTown"
msgid "03952"
msgstr ""
"If there are visitors\n"
"in town, we can't use\n"
"our Psynergy.{page_break}"
"The ancient laws say the\n"
"secret of Psynergy can\n"
"never be revealed.{end_wait}"

msgctxt "MsgValeDoYouEverDreamOfSeeing"
msgid "03953"
msgstr ""
"Do you ever dream of\n"
"seeing the world outside\n"
"the village?{page_break}"
"Someday, I'm definitely\n"
"gonna leave Vale!{end_wait}"

msgctxt "MsgValeFewPeopleOutsideOfValePossess"
msgid "03954"
msgstr ""
"Few people outside of\n"
"Vale possess the power\n"
"of Psynergy.{page_break}"
"That's why we need\n"
"permission to leave the\n"
"village...{page_break}"
"{pause_20_skippable}...To protect the secret\n"
"of Psynergy.{end_wait}"

msgctxt "MsgValeLetsScareKradensVisitors"
msgid "03955"
msgstr ""
"I hear old man Kraden's\n"
"got some visitors.{page_break}"
"{pause_20_skippable}Let's go use our Psynergy\n"
"to scare 'em!{end_now}"

msgctxt "message"
msgid "03956"
msgstr ""
"You're more of a\n"
"prankster than I thought,\n"
"{actor_name:1}. I like that.{end_wait}"

msgctxt "message"
msgid "03957"
msgstr ""
"What? You're too serious,\n"
"{actor_name:1}...{page_break}"
"{pause_20_skippable}Only someone who has\n"
"Psynergy would figure\n"
"it out...{end_wait}"

msgctxt "MsgValeHearAwfulGrowls"
msgid "03958"
msgstr ""
"Do you hear those awful\n"
"growls coming from the\n"
"other side of this fence?"

msgctxt "message"
msgid "03959"
msgstr ""
"You do, don't you?\n"
"{text_effect:4}I... I'm scared...{end_wait}"

msgctxt "message"
msgid "03960"
msgstr ""
"Really? You mean I'm the\n"
"only one that hears them?{end_wait}"

msgctxt "MsgValeThisPlaceLooksJustLikeIt"
msgid "03961"
msgstr ""
"This place looks just like\n"
"it did three years ago...\n"
"after the storm...{end_wait}"

msgctxt "MsgValeIsaacWatchOutDontGetToo"
msgid "03962"
msgstr ""
"{actor_name:1}, watch out!\n"
"Don't get too close to\n"
"the river!{end_wait}"

msgctxt "MsgValeFoodStoredForWinter"
msgid "03963"
msgstr ""
"Since food is stored in\n"
"this hut, it isn't scary at\n"
"all{em_dash}not even in winter.{page_break}"
"If only things had been\n"
"different three years\n"
"ago...{end_wait}"

msgctxt "MsgValeDoYouNeedToGo"
msgid "03964"
msgstr ""
"Do you need to go\n"
"past here?{end_now}"

msgctxt "message"
msgid "03965"
msgstr ""
"You must be going to\n"
"Kraden's cottage...{end_wait}"

msgctxt "MsgValeDontGoBeyondKradensCottage"
msgid "03966"
msgstr ""
"You mustn't go beyond\n"
"Kraden's cottage.{page_break}"
"There are monsters\n"
"everywhere out there.{end_wait}"

msgctxt "MsgValeMtAlephLooksBeautifulTodayIts"
msgid "03967"
msgstr ""
"Mt. Aleph looks\n"
"beautiful today.\n"
"It's so peaceful.{end_wait}"

msgctxt "MsgValeValeStaysPristineBecauseOfMt"
msgid "03968"
msgstr ""
"Vale stays pristine\n"
"because of Mt. Aleph's\n"
"purity.{page_break}"
"Taint that purity, and you\n"
"risk terrible\n"
"retribution.{end_wait}"

msgctxt "MsgValeYourGrandpaIsTheMayor"
msgid "03969"
msgstr ""
"I'm jealous of you,\n"
"{actor_name:2}, because your\n"
"grandpa's the mayor.{page_break}"
"Do you feel the same,\n"
"{actor_name:1}?{end_now}"

msgctxt "message"
msgid "03970"
msgstr ""
"Yeah... When travelers\n"
"come, you get to hear all\n"
"about the outside world.{end_wait}"

msgctxt "message"
msgid "03971"
msgstr ""
"Hmph... I can't believe\n"
"you're not jealous,\n"
"{actor_name:1}.{page_break}"
"I sure wish I could\n"
"hear the stories of\n"
"travelers.{end_wait}"

msgctxt "MsgValeValeMustRemainHiddenPsynergysSecrets"
msgid "03972"
msgstr ""
"Vale must remain hidden.\n"
"Psynergy's secrets mustn't\n"
"fall into the wrong hands.{page_break}"
"It's one of the laws\n"
"of our village,{pause_20_skippable} handed\n"
"down from long ago.{end_wait}"

msgctxt "MsgValeTheyKnowLittleOfThe"
msgid "03973"
msgstr ""
"They seem to know\n"
"little of Sol Sanctum's\n"
"mysteries.{end_wait}"

msgctxt "message"
msgid "03974"
msgstr ""
"The elders of Vale must\n"
"not permit anyone to\n"
"enter it, not even Kraden.{end_wait}"

msgctxt "message"
msgid "03975"
msgstr ""
"Kraden...{pause_20_skippable}\n"
"Can we use him?{end_wait}"

msgctxt "message"
msgid "03976"
msgstr ""
"Hmm...{pause_20_skippable} His knowledge is\n"
"no meager thing.\n"
"...We can use him.{end_wait}"

msgctxt "message"
msgid "03977"
msgstr ""
"But he's more stubborn\n"
"than we expected...{end_wait}"

msgctxt "message"
msgid "03978"
msgstr ""
"And cunning, too...\n"
"Cunning beyond measure.{end_wait}"

msgctxt "message"
msgid "03979"
msgstr ""
"If he won't go willingly,\n"
"then we can always...{end_wait}"

msgctxt "message"
msgid "03980"
msgstr ""
"You there!\n"
"What are you doing?{end_wait}"

msgctxt "message"
msgid "03981"
msgstr "What are we doing?{end_wait}"

msgctxt "message"
msgid "03982"
msgstr ""
"Were you eavesdropping\n"
"on our conversation?{end_now}"

msgctxt "message"
msgid "03983"
msgstr ""
"Oh ho!{pause_20_skippable} Well...\n"
"{pause_20_skippable}I can't permit you\n"
"to continue your spying.{end_wait}"

msgctxt "message"
msgid "03984"
msgstr ""
"Hmph!{pause_20_skippable} I guess that I should\n"
"take you at your word...{end_wait}"

msgctxt "MsgValeYoureTheOnesSneakingAround"
msgid "03985"
msgstr ""
"Hey, you're the ones who\n"
"were sneaking around!{end_wait}"

msgctxt "message"
msgid "03986"
msgstr ""
"Sneaking...{pause_20_skippable}\n"
"Who are you,\n"
"to accuse me!{end_wait}"

msgctxt "message"
msgid "03987"
msgstr ""
"So Kraden's engagement\n"
"was with you...{end_wait}"

msgctxt "message"
msgid "03988"
msgstr ""
"Yeah, we're off to\n"
"meet him right now.{end_wait}"

msgctxt "message"
msgid "03989"
msgstr ""
"And this appointment is\n"
"important enough to\n"
"drive us away?{end_now}"

msgctxt "message"
msgid "03990"
msgstr ""
"Pfeh! If your errand\n"
"is more important than\n"
"our own, then...{end_wait}"

msgctxt "message"
msgid "03991"
msgstr ""
"Nevertheless, Kraden sent\n"
"us away. He awaits you.{end_wait}"

msgctxt "MsgValeSaturosGo"
msgid "03992"
msgstr "Go...{end_wait}"

msgctxt "message"
msgid "03993"
msgstr "You're letting us go?{end_wait}"

msgctxt "message"
msgid "03994"
msgstr "Are you sure, Saturos?{end_wait}"

msgctxt "message"
msgid "03995"
msgstr ""
"Menardi, we have no\n"
"reason to delay these\n"
"children any further.{end_wait}"

msgctxt "message"
msgid "03996"
msgstr "Let's...{pause_20_skippable} Let's go, {actor_name:1}.{end_wait}"

msgctxt "MsgValeDoNotKeepKradenWaiting"
msgid "03997"
msgstr ""
"Go, children. You mustn't\n"
"keep Kraden waiting.{end_wait}"

msgctxt "MsgValeLeaveBeforeWeChangeMinds"
msgid "03998"
msgstr ""
"You'd better leave, before\n"
"we change our minds.{end_wait}"

msgctxt "MsgValeWho"
msgid "03999"
msgstr "Just who were they?{end_wait}"

msgctxt "message"
msgid "04000"
msgstr ""
"They already know\n"
"too much about{pause_20_skippable}\n"
"Sol Sanctum...{end_wait}"

msgctxt "message"
msgid "04001"
msgstr ""
"...things that even\n"
"the elders of Vale\n"
"don't know.{end_wait}"

msgctxt "message"
msgid "04002"
msgstr ""
"And what were they\n"
"saying about the\n"
"elements?{end_wait}"

msgctxt "message"
msgid "04003"
msgstr ""
"The elements of Alchemy:\n"
"earth, {pause_20_skippable}water, {pause_20_skippable}fire, "
"{pause_20_skippable}\n"
"and wind...{page_break}"
"They plan to set\n"
"them into motion?{end_wait}"

msgctxt "message"
msgid "04004"
msgstr ""
"And the four Elemental\n"
"Stars are the key?{end_wait}"

msgctxt "message"
msgid "04005"
msgstr ""
"These are things even I,{pause_20_skippable}\n"
"a trained Alchemy sage,\n"
"do not know.{end_wait}"

msgctxt "MsgValeKradenOhIsaac"
msgid "04006"
msgstr "Oh! {protagonist_name}...{end_wait}"

msgctxt "message"
msgid "04007"
msgstr ""
"You look like something's\n"
"bothering you.{end_wait}"

msgctxt "message"
msgid "04008"
msgstr "Me?{pause_20_skippable} Ah, well...{end_wait}"

msgctxt "message"
msgid "04009"
msgstr ""
"It's those two, isn't it?\n"
"Saturos and Menardi\n"
"were their names, right?{end_wait}"

msgctxt "message"
msgid "04010"
msgstr ""
"Are they still out there?\n"
"They're very persistent...{end_wait}"

msgctxt "message"
msgid "04011"
msgstr ""
"Did they want something\n"
"from you, Kraden?{end_wait}"

msgctxt "message"
msgid "04012"
msgstr ""
"That seems to be the\n"
"case...{end_wait}"

msgctxt "message"
msgid "04013"
msgstr "Seems to be?{end_wait}"

msgctxt "message"
msgid "04014"
msgstr ""
"Mt. Aleph and\n"
"Sol Sanctum...{page_break}"
"They spoke as if\n"
"they'd seen them with\n"
"their own eyes...{end_wait}"

msgctxt "message"
msgid "04015"
msgstr "Isn't that strange?"

msgctxt "MsgValeYouCannotEnterMtAleph"
msgid "04016"
msgstr ""
"Yes.{pause_20_skippable} You can't enter\n"
"Mt. Aleph without\n"
"a very good reason.{end_wait}"

msgctxt "MsgValeKradenIWaitedYearsFor"
msgid "04017"
msgstr ""
"Why, I had to wait many\n"
"years before I was\n"
"allowed into the sanctum.{page_break}"
"Of course it's\n"
"strange.{end_wait}"

msgctxt "MsgValeJennaTheyMightBeThieves"
msgid "04018"
msgstr ""
"And if they entered\n"
"secretly, then they might\n"
"be{pause_20_skippable} thieves!{end_wait}"

msgctxt "message"
msgid "04019"
msgstr ""
"We have to go tell the\n"
"high elders and the\n"
"villagers!{end_wait}"

msgctxt "message"
msgid "04020"
msgstr "Wait, everyone!{end_wait}"

msgctxt "message"
msgid "04021"
msgstr ""
"I still don't know how\n"
"accurate the things\n"
"they said were...{end_wait}"

msgctxt "message"
msgid "04022"
msgstr ""
"We can do nothing\n"
"until we confirm what\n"
"they told me.{end_wait}"

msgctxt "message"
msgid "04023"
msgstr "Then what should we do?{end_wait}"

msgctxt "message"
msgid "04024"
msgstr "Well, we go confirm it.{end_wait}"

msgctxt "message"
msgid "04025"
msgstr ""
"...{pause_20_skippable}Do you mean we\n"
"should go into Sol\n"
"Sanctum ourselves?{end_wait}"

msgctxt "message"
msgid "04026"
msgstr "Isn't that impossible?{end_wait}"

msgctxt "message"
msgid "04027"
msgstr "Why would it be?{end_wait}"

msgctxt "message"
msgid "04028"
msgstr ""
"Just because\n"
"climbing Mt. Aleph\n"
"is forbidden?{end_now}"

msgctxt "MsgValeKradenWeOnlyCheckThe"
msgid "04029"
msgstr ""
"We're just going to\n"
"see whether they've\n"
"been to the mountain.{page_break}"
"{pause_20_skippable}Surely, that would\n"
"be acceptable!{end_wait}"

msgctxt "MsgValeKradenWeOnlyCheckMt"
msgid "04030"
msgstr ""
"That's right. {pause_20_skippable}We're just\n"
"going to see if they've\n"
"been to Mt. Aleph.{end_wait}"

msgctxt "MsgValeFineIfTheyDontSee"
msgid "04031"
msgstr ""
"We'll be fine if they\n"
"don't see us, right?{end_now}"

msgctxt "message"
msgid "04032"
msgstr ""
"Right. We won't be doing\n"
"anything bad up there.{end_wait}"

msgctxt "message"
msgid "04033"
msgstr ""
"Sure, you say no, but\n"
"you know you want to!{end_wait}"

msgctxt "MsgValeJennaOurSecret"
msgid "04034"
msgstr ""
"This will just be\n"
"our{pause_20_skippable} secret, OK?{end_now}"

msgctxt "message"
msgid "04035"
msgstr ""
"No, {actor_name:1}!{pause_20_skippable}\n"
"You can't even\n"
"tell your mother!{end_wait}"

msgctxt "message"
msgid "04036"
msgstr "Then it's decided!{end_wait}"

msgctxt "message"
msgid "04037"
msgstr ""
"We'll make you the leader,\n"
"OK, {protagonist_name}?{end_now}"

msgctxt "MsgValeGaretYouCanHandleThe"
msgid "04038"
msgstr ""
"There are some dangerous\n"
"places between Mt.\n"
"Aleph and Sol Sanctum,{page_break}"
"but you can handle it,\n"
"right, {protagonist_name}?{end_wait}"

msgctxt "message"
msgid "04039"
msgstr ""
"You're more cautious than\n"
"{actor_name:2} is, {protagonist_name},\n"
"so you'll be fine!{end_wait}"

msgctxt "message"
msgid "04040"
msgstr ""
"You don't have to be so\n"
"blunt...{end_wait}"

msgctxt "MsgValeGaretIllTakeOverIf"
msgid "04041"
msgstr ""
"There are some dangerous\n"
"places between Mt.\n"
"Aleph and Sol Sanctum,{page_break}"
"so I'll take over if\n"
"you get nervous.{end_wait}"

msgctxt "message"
msgid "04042"
msgstr ""
"If {actor_name:2} is our leader,\n"
"we'll be the ones who\n"
"are nervous.{page_break}"
"Don't you agree, Kraden?{end_wait}"

msgctxt "message"
msgid "04043"
msgstr ""
"You don't have\n"
"to be mean...{end_wait}"

msgctxt "MsgValeKradenOurBestBet"
msgid "04044"
msgstr "This is our best bet.{end_wait}"

msgctxt "message"
msgid "04045"
msgstr "All right!{pause_20_skippable} Let's go!{end_wait}"

msgctxt "MsgValeNotSneakingUpMtAleph"
msgid "04046"
msgstr ""
"You're not planning on\n"
"sneaking up to Mt. Aleph,\n"
"are you?{end_now}"

msgctxt "message"
msgid "04047"
msgstr ""
"Mt. Aleph is a sacred\n"
"peak. No one can climb\n"
"it without permission.{end_wait}"

msgctxt "message"
msgid "04048"
msgstr ""
"Well, I'll overlook\n"
"it this time...{page_break}"
"But I've got my eye\n"
"on you, {actor_name:1}.{end_wait}"

msgctxt "MsgValeMtAlephIsASacredPeak"
msgid "04049"
msgstr ""
"Mt. Aleph is a sacred\n"
"peak. It is forbidden\n"
"to climb it!{end_wait}"

msgctxt "message"
msgid "04050"
msgstr ""
"Beyond here the path is\n"
"overrun by monsters,\n"
"so proceed with caution.{end_wait}"

msgctxt "MsgSolSanctumKradenFirstTimeAtSol"
msgid "04051"
msgstr ""
"This is the entrance to\n"
"Sol Sanctum. This is your\n"
"first time here, right?{end_now}"

msgctxt "message"
msgid "04052"
msgstr ""
"It's an important relic\n"
"of our past. Take\n"
"a good look at it.{end_wait}"

msgctxt "message"
msgid "04053"
msgstr ""
"I doubt that... Few ever\n"
"get the chance to see\n"
"this sanctum firsthand.{end_wait}"

msgctxt "MsgSolSanctumWrongKraden"
msgid "04054"
msgstr "What's wrong, Kraden?{end_wait}"

msgctxt "message"
msgid "04055"
msgstr ""
"Hmm...{page_break}"
"Those two said there was\n"
"a hidden passage leading\n"
"deeper into the sanctum.{end_wait}"

msgctxt "message"
msgid "04056"
msgstr ""
"I've come here many\n"
"times, and I've always\n"
"thought it looked...strange.{end_wait}"

msgctxt "message"
msgid "04057"
msgstr ""
"I had always imagined\n"
"Sol Sanctum would look\n"
"different, somehow.{end_wait}"

msgctxt "message"
msgid "04058"
msgstr "What do you mean?{end_wait}"

msgctxt "message"
msgid "04059"
msgstr ""
"Sol Sanctum was built\n"
"in honor of the sun.{page_break}"
"There ought to be\n"
"something here to\n"
"reflect that.{end_wait}"

msgctxt "message"
msgid "04060"
msgstr ""
"I was always puzzled\n"
"why there wasn't.{end_wait}"

msgctxt "message"
msgid "04061"
msgstr ""
"If there is a hidden\n"
"passage, then maybe it\n"
"leads to...{end_wait}"

msgctxt "message"
msgid "04062"
msgstr ""
"Well!{pause_20_skippable} Let's see if we\n"
"can find it!{end_wait}"

msgctxt "message"
msgid "04063"
msgstr ""
"I think he's serious!\n"
"Should we help him,\n"
"{actor_name:1}?{end_now}"

msgctxt "MsgSolSanctumDangerousSplitStay"
msgid "04064"
msgstr ""
"But it's too dangerous\n"
"for us to split up.\n"
"We should stay together.{end_wait}"

msgctxt "MsgSolSanctumCantSeriouslyWant"
msgid "04065"
msgstr ""
"You can't seriously want\n"
"to turn back after we've\n"
"come this far.{end_wait}"

msgctxt "message"
msgid "04066"
msgstr ""
"Let's help Kraden.\n"
"We should stick together,\n"
"after all.{end_wait}"

msgctxt "MsgSolSanctumFound"
msgid "04067"
msgstr "This is it! We've found it!{end_wait}"

msgctxt "message"
msgid "04068"
msgstr ""
"Clearly, this is the mark\n"
"of the sun...the heart\n"
"of Sol Sanctum.{end_wait}"

msgctxt "message"
msgid "04069"
msgstr ""
"It's just as I'd imagined...{pause_20_skippable}\n"
"which means those two\n"
"were telling the truth!{end_wait}"

msgctxt "message"
msgid "04070"
msgstr ""
"But if what they said was\n"
"true, then that means they\n"
"must have been...{end_wait}"

msgctxt "message"
msgid "04071"
msgstr ""
"They were thieves!\n"
"They came to rob the\n"
"sanctum!{end_wait}"

msgctxt "message"
msgid "04072"
msgstr ""
"Let's hurry back to the\n"
"village and tell everybody!{end_wait}"

msgctxt "message"
msgid "04073"
msgstr ""
"Kraden?\n"
"What's the matter?{end_wait}"

msgctxt "message"
msgid "04074"
msgstr "We're so close...{end_wait}"

msgctxt "message"
msgid "04075"
msgstr "Close? Close to what?{end_wait}"

msgctxt "message"
msgid "04076"
msgstr ""
"We've come all the way to\n"
"the heart of Sol Sanctum.{page_break}"
"To turn our backs on\n"
"it and leave...{end_wait}"

msgctxt "message"
msgid "04077"
msgstr ""
"There's something wrong\n"
"with that?{end_wait}"

msgctxt "message"
msgid "04078"
msgstr ""
"Sol Sanctum holds the\n"
"origins of Alchemy.\n"
"It would be a waste to...{end_wait}"

msgctxt "message"
msgid "04079"
msgstr ""
"What do you think? Shall\n"
"we go a little farther?{end_now}"

msgctxt "MsgSolSanctumThank"
msgid "04080"
msgstr "Thank you!{end_wait}"

msgctxt "MsgSolSanctumGoBackVillage"
msgid "04081"
msgstr ""
"Then you can all go\n"
"back to the village\n"
"without me.{end_wait}"

msgctxt "MsgSolSanctumPutWayDont"
msgid "04082"
msgstr ""
"If you put it that way, we\n"
"don't have much choice.{end_wait}"

msgctxt "message"
msgid "04083"
msgstr ""
"I'm with Kraden.\n"
"I want to look inside...{end_wait}"

msgctxt "message"
msgid "04084"
msgstr ""
"Really?{pause_20_skippable} We'll just go\n"
"a little bit further!{end_wait}"

msgctxt "message"
msgid "04085"
msgstr ""
"Good! It's decided.\n"
"Let's move ahead!{end_wait}"

msgctxt "MsgSolSanctumWhRoom"
msgid "04086"
msgstr "Wh{pause_20_skippable}-What is this room?{end_wait}"

msgctxt "message"
msgid "04087"
msgstr ""
"There's a moon in the\n"
"center... A picture of\n"
"Luna.{end_wait}"

msgctxt "message"
msgid "04088"
msgstr ""
"This must symbolize\n"
"night...{end_wait}"

msgctxt "message"
msgid "04089"
msgstr ""
"These rooms must be\n"
"connected somehow, don't\n"
"you think?{end_now}"

msgctxt "MsgSolSanctumLunaSolRooms"
msgid "04090"
msgstr ""
"Luna and "
"Sol.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}\n"
"These rooms must hide\n"
"some secret.{page_break}"
"What could it be?{end_wait}"

msgctxt "MsgSolSanctumRoomLunaOne"
msgid "04091"
msgstr ""
"But a room for Luna and\n"
"one for Sol? It can't\n"
"be mere coincidence.{end_wait}"

msgctxt "MsgSolSanctumMeanLookFarther"
msgid "04092"
msgstr ""
"What does it all mean?\n"
"{actor_name:1}, would you look\n"
"farther up the passage?{end_now}"

msgctxt "MsgSolSanctumKradenLetMeKnowWhat"
msgid "04093"
msgstr ""
"Let me know what\n"
"you find.{end_wait}"

msgctxt "message"
msgid "04094"
msgstr "Then just wait there.{end_wait}"

msgctxt "MsgSolSanctumKradenJustWaitOverThere"
msgid "04095"
msgstr "Just wait over there.{end_wait}"

msgctxt "MsgSolSanctumWayLeadsOutSanctum"
msgid "04096"
msgstr ""
"That way leads out\n"
"of the sanctum. It\n"
"should be in these rooms.{end_wait}"

msgctxt "MsgSolSanctumWhatsHappening"
msgid "04097"
msgstr ""
"{text_effect:4}Wha{pause_20_skippable}-What's...\n"
"What's happening?{end_wait}"

msgctxt "message"
msgid "04098"
msgstr ""
"{actor_name:1} must have\n"
"found something!{end_wait}"

msgctxt "message"
msgid "04099"
msgstr ""
"{actor_name:1}! Stop!!!\n"
"You're about to make\n"
"a big mistake!{end_wait}"

msgctxt "MsgSolSanctumWait"
msgid "04100"
msgstr "Wait, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "04101"
msgstr "What's wrong, Kraden?{end_wait}"

msgctxt "message"
msgid "04102"
msgstr ""
"This is a most interesting\n"
"mechanism you've\n"
"found, {actor_name:1}.{end_wait}"

msgctxt "message"
msgid "04103"
msgstr ""
"But{pause_20_skippable} this is clearly...\n"
"some kind of trap.{end_wait}"

msgctxt "message"
msgid "04104"
msgstr "This is...a trap?{end_wait}"

msgctxt "message"
msgid "04105"
msgstr ""
"Go look in the Luna room,\n"
"and you'll understand.{end_wait}"

msgctxt "message"
msgid "04106"
msgstr ""
"You've done well. Finding\n"
"this means you're looking\n"
"in the right place.{end_wait}"

msgctxt "message"
msgid "04107"
msgstr ""
"But if you just move one\n"
"statue, you'll be caught\n"
"in the sanctum's trap.{end_wait}"

msgctxt "message"
msgid "04108"
msgstr ""
"But{pause_20_skippable} why would anyone\n"
"put a trap here, anyway?{end_wait}"

msgctxt "message"
msgid "04109"
msgstr ""
"I don't know who did it...\n"
"but they've hidden\n"
"something very important.{end_wait}"

msgctxt "message"
msgid "04110"
msgstr ""
"Perhaps...{pause_20_skippable}they've hidden\n"
"the key to Alchemy itself.{end_wait}"

msgctxt "message"
msgid "04111"
msgstr "Should I tell you more?{end_now}"

msgctxt "MsgSolSanctumHonestlyDoubtUnderstand"
msgid "04112"
msgstr ""
"Hmm... Honestly, I doubt\n"
"you could understand it\n"
"if I explained now.{end_wait}"

msgctxt "MsgSolSanctumHmphWellTold"
msgid "04113"
msgstr ""
"Hmph.{pause_20_skippable} Well, even if I told\n"
"you now, you probably\n"
"wouldn't understand.{end_wait}"

msgctxt "MsgSolSanctumTryFindSolution"
msgid "04114"
msgstr ""
"We must try to find\n"
"a solution to this mystery.{end_wait}"

msgctxt "message"
msgid "04115"
msgstr "Sheesh... Another mystery?{end_wait}"

msgctxt "message"
msgid "04116"
msgstr ""
"I'll keep checking the\n"
"Luna room. You continue\n"
"exploring the sanctum.{end_wait}"

msgctxt "message"
msgid "04117"
msgstr "My intuition tells me...{end_wait}"

msgctxt "message"
msgid "04118"
msgstr ""
"that light must be the key\n"
"to this secret.{pause_20_skippable}\n"
"...We should test it.{end_wait}"

msgctxt "message"
msgid "04119"
msgstr ""
"{actor_name:1}{pause_20_skippable}, let's see if\n"
"we can't figure this\n"
"out ourselves.{end_wait}"

msgctxt "MsgSolSanctumWhatsHappeningAtTheTrap"
msgid "04120"
msgstr ""
"{text_effect:4}Wha{pause_20_skippable}-What's...\n"
"What's happening?{end_wait}"

msgctxt "message"
msgid "04121"
msgstr ""
"{actor_name:1}{pause_20_skippable} must have\n"
"found something!{end_wait}"

msgctxt "MsgSolSanctumKradenYouFoundIt"
msgid "04122"
msgstr "You found it, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "04123"
msgstr "Kraden!{end_wait}"

msgctxt "message"
msgid "04124"
msgstr "Excellent work, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "04125"
msgstr ""
"Where did that\n"
"hole come from?{end_wait}"

msgctxt "message"
msgid "04126"
msgstr ""
"When {actor_name:1} moved those\n"
"statues, two beams of\n"
"light shot out from them,{page_break}"
"and then this hole\n"
"appeared in the floor.{end_wait}"

msgctxt "message"
msgid "04127"
msgstr ""
"And {actor_name:1} dropped\n"
"the statue into it\n"
"after that.{end_wait}"

msgctxt "message"
msgid "04128"
msgstr ""
"Hmm...{pause_20_skippable} Good\n"
"work, everyone!{end_wait}"

msgctxt "message"
msgid "04129"
msgstr ""
"So the statue puzzle\n"
"was the trap...{end_wait}"

msgctxt "message"
msgid "04130"
msgstr ""
"and that other statue\n"
"was here to...\n"
"disarm the trap.{end_wait}"

msgctxt "message"
msgid "04131"
msgstr ""
"And now that you've\n"
"disarmed it, we\n"
"should be all right.{end_wait}"

msgctxt "message"
msgid "04132"
msgstr ""
"I'll observe from the Luna\n"
"room, where it's safe.\n"
"You handle the rest!{end_wait}"

msgctxt "MsgSolSanctumYouFoundIt"
msgid "04133"
msgstr "You found it, {actor_name:1}.{end_wait}"

msgctxt "message"
msgid "04134"
msgstr ""
"Keep doing that until\n"
"the light bathes all the\n"
"remaining quarters.{end_wait}"

msgctxt "MsgSolSanctumThePictureOfLunaChanged"
msgid "04135"
msgstr ""
"Look, {actor_name:1}!{pause_20_skippable} The picture of\n"
"Luna changed to Sol!{end_wait}"

msgctxt "message"
msgid "04136"
msgstr ""
"But other than that,\n"
"nothing looks different...{end_wait}"

msgctxt "message"
msgid "04137"
msgstr ""
"That's strange...{pause_20_skippable}\n"
"They went to the trouble\n"
"of putting a trap here...{page_break}"
"And this is all that\n"
"happens?{end_wait}"

msgctxt "message"
msgid "04138"
msgstr ""
"Somewhere, something\n"
"else must have changed.\n"
"We must find it.{end_wait}"

msgctxt "MsgSolSanctumLookSymbolFloor"
msgid "04139"
msgstr ""
"Look!{pause_20_skippable} The symbol on the\n"
"floor! It changed\n"
"from Sol to Luna!{end_wait}"

msgctxt "message"
msgid "04140"
msgstr ""
"Surely...{pause_20_skippable}there must be\n"
"something in this room.{end_wait}"

msgctxt "message"
msgid "04141"
msgstr ""
"If we go this way, we'll\n"
"leave the sanctum.{end_wait}"

msgctxt "MsgSolSanctumHa"
msgid "04142"
msgstr "Ah ha! This has to be it.{end_wait}"

msgctxt "message"
msgid "04143"
msgstr "Let's go, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "04144"
msgstr ""
"Wait for me, {actor_name:1}...\n"
"I'm on my way!{end_wait}"

msgctxt "MsgSolSanctumMinotaurReliefOneEye"
msgid "04145"
msgstr ""
"It's a relief\n"
"of a minotaur.{page_break}"
"The right eye is sparkling,\n"
"but there's a hole where\n"
"the left eye should be.{end_wait}"

msgctxt "MsgSolSanctumSetSmallGem"
msgid "04146"
msgstr ""
"{protagonist_name} set the small\n"
"gem into the empty socket.{end_wait}"

msgctxt "message"
msgid "04147"
msgstr ""
"You hear the sound of\n"
"shifting stone.{end_wait}"

msgctxt "MsgSolSanctumMinotaurReliefBothEyes"
msgid "04148"
msgstr ""
"It's the minotaur relief,\n"
"with both eyes sparkling\n"
"brightly.{end_wait}"

msgctxt "MsgSanctumWieldersPsynergyCalledAdeptsAdepts"
msgid "04149"
msgstr ""
"Wielders of Psynergy\n"
"are called Adepts.{page_break}"
"Adepts are messengers\n"
"of good...\n"
"Never forget that.{end_wait}"

msgctxt "MsgSanctumOurPsynergyWasGivenToUs"
msgid "04150"
msgstr ""
"Our Psynergy was given\n"
"to us by the sacred\n"
"power of Mt. Aleph.{page_break}"
"Psynergy is what grants\n"
"the wishes of the\n"
"chosen people.{end_wait}"

msgctxt "MsgSanctumPsynergyIsAPowerThatShould"
msgid "04151"
msgstr ""
"Psynergy is a power that\n"
"should only be used for\n"
"good... Never for evil!{end_wait}"

msgctxt "MsgSolSanctumSomethingClicked"
msgid "04152"
msgstr "Something clicked!{end_wait}"

msgctxt "message"
msgid "04153"
msgstr ""
"It looks like we've\n"
"found the hidden passage.{page_break}"
"Things will be more\n"
"dangerous from here on,\n"
"so watch your step.{end_wait}"

msgctxt "MsgSolSanctumMoreStatuesOutOfReach"
msgid "04154"
msgstr ""
"More statues...{pause_20_skippable} Hmm...{pause_20_skippable}\n"
"It doesn't look like we\n"
"can reach them from here.{end_wait}"

msgctxt "message"
msgid "04155"
msgstr ""
"Perhaps Psynergy\n"
"is the key...{page_break}"
"{protagonist_name}{pause_20_skippable}, try to use\n"
"your Psynergy!{end_wait}"

msgctxt "MsgSolSanctumKradenWhereAreWe"
msgid "04156"
msgstr "Wha{pause_20_skippable}-Where are we?{end_wait}"

msgctxt "message"
msgid "04157"
msgstr ""
"Is that.{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}the "
"ocean?{end_wait}"

msgctxt "message"
msgid "04158"
msgstr ""
"No, it couldn't be...\n"
"The ocean has waves.{end_wait}"

msgctxt "message"
msgid "04159"
msgstr ""
"The ocean...\n"
"What's that?{end_wait}"

msgctxt "message"
msgid "04160"
msgstr ""
"The ocean is a thing\n"
"of endless water at\n"
"the end of the world.{end_wait}"

msgctxt "message"
msgid "04161"
msgstr ""
"You would not\n"
"understand... Someday, I'll\n"
"show it to you myself.{end_wait}"

msgctxt "message"
msgid "04162"
msgstr "The Elemental Stars...{end_wait}"

msgctxt "message"
msgid "04163"
msgstr ""
"They really exist...\n"
"The Elemental Stars exist!{end_wait}"

msgctxt "message"
msgid "04164"
msgstr ""
"You taught us about\n"
"those... Elements are the\n"
"foundation of all matter.{end_wait}"

msgctxt "message"
msgid "04165"
msgstr ""
"Stones, wood, even us...\n"
"All things are made\n"
"from those four elements.{page_break}"
"Did I get it right, {actor_name:1}?{end_now}"

msgctxt "message"
msgid "04166"
msgstr "Exactly...{end_wait}"

msgctxt "message"
msgid "04167"
msgstr ""
"No, {protagonist_name}...\n"
"{actor_name:2} is quite correct.{end_wait}"

msgctxt "MsgSolSanctumKradenTheElementsAreThe"
msgid "04168"
msgstr ""
"As I have told you many\n"
"times, the elements are\n"
"the source of all matter.{end_wait}"

msgctxt "message"
msgid "04169"
msgstr ""
"Earth, {pause_20_skippable}water, {pause_20_skippable}fire, "
"{pause_20_skippable}\n"
"and wind{pause_20_skippable}{em_dash}these are\n"
"the four elements.{end_wait}"

msgctxt "message"
msgid "04170"
msgstr ""
"Legend holds that\n"
"the four Elemental\n"
"Stars contain{page_break}"
"the purified essence\n"
"of each element.{end_wait}"

msgctxt "message"
msgid "04171"
msgstr ""
"And now, those legendary\n"
"stones are before us!{end_wait}"

msgctxt "message"
msgid "04172"
msgstr ""
"The Venus Star...\n"
"The elemental stone\n"
"of earth!{end_wait}"

msgctxt "message"
msgid "04173"
msgstr ""
"Mercury Star, possessing\n"
"the power of water's\n"
"many forms!{end_wait}"

msgctxt "message"
msgid "04174"
msgstr ""
"There is the Mars Star,\n"
"glowing red with the fire\n"
"contained within!{end_wait}"

msgctxt "message"
msgid "04175"
msgstr ""
"And Jupiter Star, bound\n"
"with the wind's fury!!!{end_wait}"

msgctxt "message"
msgid "04176"
msgstr ""
"Kraden...{pause_20_skippable} Why are you\n"
"getting so excited?{end_wait}"

msgctxt "message"
msgid "04177"
msgstr ""
"How can you be so\n"
"calm in the face of\n"
"such wonders!?{end_wait}"

msgctxt "message"
msgid "04178"
msgstr ""
"You're looking at the very\n"
"source of all Alchemy!{end_wait}"

msgctxt "message"
msgid "04179"
msgstr ""
"...Haven't I told you\n"
"all this before?{end_now}"

msgctxt "message"
msgid "04180"
msgstr ""
"What? I must have\n"
"fallen asleep, then,{page_break}"
"because I don't have\n"
"a clue what he's\n"
"talking about!{end_wait}"

msgctxt "message"
msgid "04181"
msgstr ""
"Then this must be a lot\n"
"for you to take in.{end_wait}"

msgctxt "MsgSolSanctumKradenTheWisdomStone"
msgid "04182"
msgstr ""
"The Wisdom Stone...\n"
"the Stone of\n"
"Sages.{end_wait}"

msgctxt "message"
msgid "04183"
msgstr ""
"This stone dominates\n"
"everything...{page_break}"
"It can transmute crude\n"
"matter into gold, even\n"
"thwart death itself!{end_wait}"

msgctxt "message"
msgid "04184"
msgstr ""
"You understand now,\n"
"don't you?{end_now}"

msgctxt "message"
msgid "04185"
msgstr ""
"The study of Alchemy\n"
"began with the search\n"
"for this very stone.{end_wait}"

msgctxt "message"
msgid "04186"
msgstr ""
"You still do not\n"
"understand?{page_break}"
"Alchemy exists{pause_20_skippable} because\n"
"of the Elemental Stars.{end_wait}"

msgctxt "MsgSolSanctumTheStarsHaveEnormousPower"
msgid "04187"
msgstr ""
"I don't really get how it\n"
"works, but{pause_20_skippable}{pause_20_skippable} they have\n"
"enormous power,{pause_20_skippable} right?{end_wait}"

msgctxt "message"
msgid "04188"
msgstr ""
"Beyond enormous...\n"
"With a single gem, one\n"
"could conquer the world!{end_wait}"

msgctxt "message"
msgid "04189"
msgstr ""
"Now, perhaps, you begin\n"
"to understand.{end_wait}"

msgctxt "message"
msgid "04190"
msgstr ""
"Don't scare us like that,\n"
"Kraden.{pause_20_skippable} I totally thought\n"
"you were serious.{page_break}"
"Heh...\n"
"Conquering the world...{end_wait}"

msgctxt "message"
msgid "04191"
msgstr ""
"Who can say what\n"
"the truth is?{end_wait}"

msgctxt "message"
msgid "04192"
msgstr ""
"That's why I've been\n"
"searching for the\n"
"Elemental Stars.{page_break}"
"I seek to learn\n"
"the truth about\n"
"these stones.{end_wait}"

msgctxt "message"
msgid "04193"
msgstr "Now they lie before me...{end_wait}"

msgctxt "message"
msgid "04194"
msgstr "{text_effect:4}Whoa...{reset_text_style}{end_wait}"

msgctxt "message"
msgid "04195"
msgstr ""
"Be careful, Kraden!\n"
"It looks slippery.{end_wait}"

msgctxt "message"
msgid "04196"
msgstr ""
"But I must examine\n"
"the Elemental Stars...{end_wait}"

msgctxt "message"
msgid "04197"
msgstr "Make the boys do it!{end_wait}"

msgctxt "message"
msgid "04198"
msgstr ""
"Oh, I couldn't "
"ask{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}.\n"
"Would you mind?{end_wait}"

msgctxt "message"
msgid "04199"
msgstr ""
"He'd be glad to get\n"
"the stones for you,\n"
"right, {protagonist_name}?{end_now}"

msgctxt "MsgSolSanctumJennaWontYouPlease"
msgid "04200"
msgstr ""
"Don't make me ask you again!{pause_20_skippable}\n"
"Won't you please do it?{end_now}"

msgctxt "MsgSolSanctumJennaThankYou"
msgid "04201"
msgstr "Thank you!{end_wait}"

msgctxt "message"
msgid "04202"
msgstr ""
"You'll need this,\n"
"{protagonist_name}.{end_wait}"

msgctxt "message"
msgid "04203"
msgstr ""
"{argument_actor_name:1} got the\n"
"Mythril Bags.{end_wait}"

msgctxt "message"
msgid "04204"
msgstr ""
"You can't carry any more.\n"
"Organize your items.{end_wait}"

msgctxt "MsgSolSanctumTheBagsAreFromKradens"
msgid "04205"
msgstr ""
"You brought those from\n"
"your cottage, right,\n"
"Kraden?{end_wait}"

msgctxt "message"
msgid "04206"
msgstr "What are those bags?{end_wait}"

msgctxt "message"
msgid "04207"
msgstr ""
"They're made of woven\n"
"threads of Mythril.{end_wait}"

msgctxt "message"
msgid "04208"
msgstr ""
"I prepared them for\n"
"just such an occasion.{end_wait}"

msgctxt "message"
msgid "04209"
msgstr ""
"Now, go fetch the\n"
"Elemental Stars and put\n"
"them in those bags.{end_wait}"

msgctxt "MsgSolSanctumNoStarsOutThere"
msgid "04210"
msgstr ""
"There aren't any Elemental\n"
"Stars out there!{end_wait}"

msgctxt "message"
msgid "04211"
msgstr ""
"{actor_name:1} put the\n"
"Venus Star in a\n"
"Mythril Bag.{end_wait}"

msgctxt "message"
msgid "04212"
msgstr ""
"Good, good!\n"
"Now, go fetch the others!{end_wait}"

msgctxt "MsgSolSanctumVenusStarBagged"
msgid "04213"
msgstr ""
"{argument_actor_name:1} put the\n"
"Venus Star in a\n"
"Mythril Bag.{end_wait}"

msgctxt "MsgSolSanctumPutMercuryStar"
msgid "04214"
msgstr ""
"{argument_actor_name:1} put the\n"
"Mercury Star in a\n"
"Mythril Bag.{end_wait}"

msgctxt "MsgSolSanctumJupiterStarBagged"
msgid "04215"
msgstr ""
"{argument_actor_name:1} put the\n"
"Jupiter Star in a\n"
"Mythril Bag.{end_wait}"

msgctxt "MsgSolSanctumMarsStarBagged"
msgid "04216"
msgstr ""
"{argument_actor_name:1} put the\n"
"Mars Star in a\n"
"Mythril Bag.{end_wait}"

msgctxt "MsgSolSanctumKradenBringTheStarsHere"
msgid "04217"
msgstr ""
"Now, put the Elemental\n"
"Stars in those bags and\n"
"bring them here.{end_wait}"

msgctxt "MsgSolSanctumJennaBeCareful"
msgid "04218"
msgstr "Be careful, both of you.{end_wait}"

msgctxt "MsgSolSanctumKradenFetchTheOthers"
msgid "04219"
msgstr ""
"Good, good.\n"
"Now go fetch the others!{end_wait}"

msgctxt "MsgSolSanctumJennaKradenIsGiddy"
msgid "04220"
msgstr ""
"Kraden, you're as\n"
"giddy as a schoolgirl.{end_wait}"

msgctxt "MsgSolSanctumLooksLikeTheyveSpottedUs"
msgid "04221"
msgstr ""
"It looks like they've\n"
"spotted us.{end_wait}"

msgctxt "message"
msgid "04222"
msgstr ""
"I thought we'd be\n"
"safe until they'd gotten\n"
"all the Elemental Stars.{end_wait}"

msgctxt "message"
msgid "04223"
msgstr ""
"You! You mean to steal\n"
"the Elemental Stars!{end_wait}"

msgctxt "message"
msgid "04224"
msgstr ""
"Master Kraden...{pause_20_skippable} Are you\n"
"calling us thieves?{end_wait}"

msgctxt "message"
msgid "04225"
msgstr ""
"As I recall, aren't\n"
"you the one who stole\n"
"our information?{end_wait}"

msgctxt "message"
msgid "04226"
msgstr ""
"What will you do with\n"
"us once you've got\n"
"the Elemental Stars?{end_wait}"

msgctxt "message"
msgid "04227"
msgstr ""
"I'm sure they'll do\n"
"us in once they no\n"
"longer need us!{end_wait}"

msgctxt "message"
msgid "04228"
msgstr ""
"Relax...\n"
"You will not be hurt.{end_wait}"

msgctxt "message"
msgid "04229"
msgstr ""
"That was our{pause_20_skippable}\n"
"agreement, was it not?{end_wait}"

msgctxt "message"
msgid "04230"
msgstr ""
"That all depends on how\n"
"well they cooperate.{end_wait}"

msgctxt "message"
msgid "04231"
msgstr ""
"They'll be safe, as long\n"
"as they hand over\n"
"the Elemental Stars.{end_wait}"

msgctxt "message"
msgid "04232"
msgstr "Isn't that enough?{end_wait}"

msgctxt "message"
msgid "04233"
msgstr ""
"You heard us...\n"
"If you wish to save\n"
"your friends,{page_break}"
"then give us the\n"
"Elemental Stars!{end_wait}"

msgctxt "message"
msgid "04234"
msgstr "Do you accept our terms?{end_now}"

msgctxt "message"
msgid "04235"
msgstr ""
"No, {actor_name:1}! You\n"
"must not give them\n"
"the Elemental Stars!{end_wait}"

msgctxt "message"
msgid "04236"
msgstr ""
"Very good, {actor_name:1}!{pause_20_skippable}\n"
"You must not give them\n"
"the Elemental Stars!{end_wait}"

msgctxt "MsgSolSanctumWhyDenyDont"
msgid "04237"
msgstr ""
"Why would you deny us?\n"
"Don't you want your\n"
"friends to be safe?{end_wait}"

msgctxt "message"
msgid "04238"
msgstr ""
"What guarantee do we\n"
"have once we've given\n"
"you the Elemental Stars?{end_wait}"

msgctxt "message"
msgid "04239"
msgstr ""
"Guarantee...{pause_20_skippable}\n"
"Ah. I have one.{end_wait}"

msgctxt "message"
msgid "04240"
msgstr ""
"You will have to remove\n"
"your mask.{end_wait}"

msgctxt "message"
msgid "04241"
msgstr "Th-{pause_20_skippable}That means...{end_wait}"

msgctxt "message"
msgid "04242"
msgstr ""
"Ah, of course. A fine\n"
"idea... He will be\n"
"our guarantee.{end_wait}"

msgctxt "message"
msgid "04243"
msgstr ""
"Under the circumstances,\n"
"we have little choice.{page_break}"
"{actor_name:5}! Remove your mask!{end_wait}"

msgctxt "message"
msgid "04244"
msgstr ""
"What?{pause_20_skippable} What did he say,\n"
"{actor_name:1}?{end_wait}"

msgctxt "message"
msgid "04245"
msgstr ""
"He called that guy {actor_name:5}...{pause_20_skippable}\n"
"That's what he said,\n"
"isn't it?{end_now}"

msgctxt "message"
msgid "04246"
msgstr ""
"You heard it too?{pause_20_skippable}\n"
"{actor_name:5}?{pause_20_skippable} It can't be...{end_wait}"

msgctxt "message"
msgid "04247"
msgstr ""
"But that's what I\n"
"heard. {pause_20_skippable}{actor_name:5}?\n"
"It can't be...{end_wait}"

msgctxt "message"
msgid "04248"
msgstr ""
"That day...{pause_20_skippable} The Boulder...\n"
"We saw him die,\n"
"didn't we?{end_now}"

msgctxt "message"
msgid "04249"
msgstr ""
"You remember it, too,\n"
"{actor_name:1}?{pause_20_skippable}{page_break}"
"Then...what kind of\n"
"guarantee are they\n"
"giving us?{end_wait}"

msgctxt "message"
msgid "04250"
msgstr ""
"We searched for weeks,\n"
"but we still couldn't\n"
"find him.{end_wait}"

msgctxt "MsgSolSanctumMenardiDontYouWantThem"
msgid "04251"
msgstr ""
"What's wrong, {actor_name:5}...{pause_20_skippable}\n"
"Don't you want them\n"
"to feel safe?{end_wait}"

msgctxt "message"
msgid "04252"
msgstr ""
"{actor_name:5}... Wasn't that the\n"
"name of your brother?{end_wait}"

msgctxt "message"
msgid "04253"
msgstr ""
"But that accident...{pause_20_skippable}\n"
"My brother, he...{end_wait}"

msgctxt "message"
msgid "04254"
msgstr "I'll do it.{end_wait}"

msgctxt "message"
msgid "04255"
msgstr ""
"I'll{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}.take off "
"my mask.{end_wait}"

msgctxt "message"
msgid "04256"
msgstr ""
"{text_effect:4}I{pause_20_skippable}-It's not "
"possible...{reset_text_style}{end_wait}"

msgctxt "message"
msgid "04257"
msgstr "Is he...{end_wait}"

msgctxt "message"
msgid "04258"
msgstr ""
"I know I've caused you\n"
"much grief, {actor_name:6}.{end_wait}"

msgctxt "message"
msgid "04259"
msgstr ""
"It was a miracle that\n"
"I survived that day...{end_wait}"

msgctxt "message"
msgid "04260"
msgstr ""
"We are the ones\n"
"who saved him.{end_wait}"

msgctxt "message"
msgid "04261"
msgstr ""
"We saw him floating\n"
"unconscious in the\n"
"river as we passed.{end_wait}"

msgctxt "message"
msgid "04262"
msgstr ""
"I've been with them ever\n"
"since... I've experienced\n"
"a lot.{end_wait}"

msgctxt "message"
msgid "04263"
msgstr "But why?{end_wait}"

msgctxt "message"
msgid "04264"
msgstr ""
"Why did you leave\n"
"me all alone...{end_wait}"

msgctxt "message"
msgid "04265"
msgstr "{actor_name:6}...{end_wait}"

msgctxt "message"
msgid "04266"
msgstr ""
"My own brother...\n"
"I thought you were dead!{end_wait}"

msgctxt "message"
msgid "04267"
msgstr ""
"Save this teary reunion\n"
"for later.{end_wait}"

msgctxt "message"
msgid "04268"
msgstr ""
"That's right.{pause_20_skippable}\n"
"The Elemental Stars\n"
"come first.{end_wait}"

msgctxt "message"
msgid "04269"
msgstr ""
"Is this acceptable?{page_break}"
"{actor_name:5} would never\n"
"allow us to harm you...\n"
"or his sister.{end_wait}"

msgctxt "message"
msgid "04270"
msgstr ""
"{actor_name:5} will be our\n"
"guarantee. Now, give us\n"
"the Elemental Stars!{end_wait}"

msgctxt "message"
msgid "04271"
msgstr ""
"We don't have any choice.\n"
"Should we give them\n"
"the Elemental Stars?{end_now}"

msgctxt "MsgSolSanctumGuessTakeElemental"
msgid "04272"
msgstr ""
"I guess I should take\n"
"the Elemental Stars\n"
"to them.{end_wait}"

msgctxt "message"
msgid "04273"
msgstr ""
"{actor_name:1} handed over\n"
"the Elemental Stars.{end_wait}"

msgctxt "MsgSolSanctumDontHandOver"
msgid "04274"
msgstr ""
"If you don't hand\n"
"them over, they won't\n"
"let {actor_name:6} go!{end_wait}"

msgctxt "message"
msgid "04275"
msgstr ""
"{actor_name:2} took the\n"
"Elemental Stars.{end_wait}"

msgctxt "MsgSolSanctumRightTake"
msgid "04276"
msgstr ""
"All right, I'll take\n"
"them.{end_wait}"

msgctxt "MsgSolSanctumWontLetGo"
msgid "04277"
msgstr ""
"They won't let {actor_name:6}\n"
"go if we don't\n"
"hand them over!{end_wait}"

msgctxt "MsgSolSanctumPermitRelieveElemental"
msgid "04278"
msgstr ""
"Will you permit me to\n"
"relieve you of those\n"
"Elemental Stars?{end_wait}"

msgctxt "message"
msgid "04279"
msgstr ""
"Oh, Alex...\n"
"You're late!{end_wait}"

msgctxt "message"
msgid "04280"
msgstr ""
"Alex is another of\n"
"our companions. Hand\n"
"the stones to him.{end_wait}"

msgctxt "message"
msgid "04281"
msgstr ""
"Oh, great. After we did\n"
"all that work...{end_wait}"

msgctxt "message"
msgid "04282"
msgstr ""
"{actor_name:2} gave him\n"
"the Elemental Stars.{end_wait}"

msgctxt "message"
msgid "04283"
msgstr ""
"I'm afraid I must\n"
"apologize in advance...{end_wait}"

msgctxt "message"
msgid "04284"
msgstr ""
"For you will be bringing\n"
"us the remaining Elemental\n"
"Star, as well.{end_wait}"

msgctxt "message"
msgid "04285"
msgstr "Wait a second!{end_wait}"

msgctxt "message"
msgid "04286"
msgstr ""
"You want us to grab the\n"
"other one for you, too?{end_wait}"

msgctxt "message"
msgid "04287"
msgstr ""
"Oh,{pause_20_skippable} did you not\n"
"understand me?{end_wait}"

msgctxt "message"
msgid "04288"
msgstr ""
"You said you'd set {actor_name:6}\n"
"free once we gave you\n"
"the Elemental Stars.{page_break}"
"You promised...{end_wait}"

msgctxt "message"
msgid "04289"
msgstr ""
"No, my friend...\n"
"We want you to bring us\n"
"ALL the Elemental Stars!{end_wait}"

msgctxt "message"
msgid "04290"
msgstr ""
"Stop grumbling and bring\n"
"us the last Star!{end_now}"

msgctxt "MsgSolSanctumDontWantAnything"
msgid "04291"
msgstr ""
"You don't want anything\n"
"to happen to your\n"
"friends, do you?{end_now}"

msgctxt "MsgSolSanctumThankCooperation"
msgid "04292"
msgstr ""
"Thank you for your\n"
"cooperation.{end_wait}"

msgctxt "message"
msgid "04293"
msgstr ""
"We'll be waiting for\n"
"the rest.{end_wait}"

msgctxt "MsgSolSanctumDoubtHowFeel"
msgid "04294"
msgstr ""
"I doubt that's how you\n"
"really feel. I'll ask you\n"
"once again.{page_break}"
"You don't want anything\n"
"to happen to your\n"
"friends, do you?{end_now}"

msgctxt "MsgSolSanctumMenardiBringTheFinalGem"
msgid "04295"
msgstr ""
"What are you doing?\n"
"Bring us the final gem!{end_wait}"

msgctxt "MsgSolSanctumFelixSilence"
msgid "04296"
msgstr "...{end_wait}"

msgctxt "MsgSolSanctumJennaMyBrotherIsAlive"
msgid "04297"
msgstr ""
"My brother is alive...\n"
"but...why didn't he tell me\n"
"sooner?{end_wait}"

msgctxt "MsgSolSanctumSaturosBringTheFinalStar"
msgid "04298"
msgstr ""
"If you want to save them,\n"
"you'll bring us the\n"
"final Elemental Star.{end_wait}"

msgctxt "MsgSolSanctumKradenIAmResponsible"
msgid "04299"
msgstr ""
"I am sorry, everyone...\n"
"I am responsible for\n"
"all of this.{end_wait}"

msgctxt "MsgSolSanctumAlexOnlyOneLeft"
msgid "04300"
msgstr ""
"There is only one left.\n"
"You're almost done.{end_wait}"

msgctxt "MsgSolSanctumJennaWhatHappened"
msgid "04301"
msgstr ""
"What's the matter?{pause_20_skippable}\n"
"What happened?{end_wait}"

msgctxt "message"
msgid "04302"
msgstr ""
"No!{pause_20_skippable}{pause_20_skippable}{pause_20_skippable} Not "
"again!{end_wait}"

msgctxt "message"
msgid "04303"
msgstr "The water's gone!{end_wait}"

msgctxt "message"
msgid "04304"
msgstr ""
"Without the energy of\n"
"the Elemental Stars, the\n"
"chamber is collapsing!{end_wait}"

msgctxt "message"
msgid "04305"
msgstr ""
"Is this the \"terrible\n"
"retribution\" the villagers\n"
"spoke of?{page_break}"
"No, this must be more\n"
"of Alchemy's power!{end_wait}"

msgctxt "message"
msgid "04306"
msgstr ""
"Whew!{pause_20_skippable} It's "
"over...{pause_20_skippable}{pause_20_skippable}\n"
"But what was it?{end_wait}"

msgctxt "message"
msgid "04307"
msgstr "What is that?!?{end_wait}"

msgctxt "message"
msgid "04308"
msgstr "No!{end_wait}"

msgctxt "message"
msgid "04309"
msgstr ""
"That rock...{pause_20_skippable} It's "
"floating...{pause_20_skippable}{pause_20_skippable}\n"
"Do you know what\n"
"it is, {actor_name:1}?{end_now}"

msgctxt "MsgSolSanctumIKnowItsARock"
msgid "04310"
msgstr ""
"Yeah, I know it's\n"
"a rock, stupid!{end_wait}"

msgctxt "MsgSolSanctumSomeoneIsLiftingIt"
msgid "04311"
msgstr ""
"Me neither. It looks\n"
"like someone is using\n"
"Psynergy to lift it...{end_wait}"

msgctxt "MsgSolSanctumKradenCouldThatBeThe"
msgid "04312"
msgstr ""
"Could that "
"be{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}.\n"
"the Wise One?!?{end_wait}"

msgctxt "message"
msgid "04313"
msgstr ""
"Such power...\n"
"Incredible!{end_wait}"

msgctxt "message"
msgid "04314"
msgstr "!!!{end_wait}"

msgctxt "message"
msgid "04315"
msgstr "Wow...{end_wait}"

msgctxt "message"
msgid "04316"
msgstr ""
"It must be the guardian\n"
"of the Elemental Stars!{end_wait}"

msgctxt "message"
msgid "04317"
msgstr ""
"This doesn't look good...{pause_20_skippable}\n"
"Maybe we should just\n"
"escape while we can.{end_wait}"

msgctxt "message"
msgid "04318"
msgstr ""
"But we need the Mars\n"
"Star. We can't leave\n"
"it behind!{end_wait}"

msgctxt "message"
msgid "04319"
msgstr ""
"I agree with {actor_name:5}.\n"
"We're no match for\n"
"the guardian.{end_wait}"

msgctxt "message"
msgid "04320"
msgstr ""
"The Mars Star will have\n"
"to wait for another day.{end_wait}"

msgctxt "message"
msgid "04321"
msgstr ""
"What about {actor_name:1} and\n"
"{actor_name:2}? You can't just\n"
"leave them here!{end_wait}"

msgctxt "message"
msgid "04322"
msgstr ""
"Forget about them.\n"
"They won't make it\n"
"out alive.{end_wait}"

msgctxt "message"
msgid "04323"
msgstr ""
"But, Saturos, there's still\n"
"a chance they might\n"
"survive.{end_wait}"

msgctxt "message"
msgid "04324"
msgstr ""
"Anything is possible...\n"
"So what do you suggest\n"
"we do?{end_wait}"

msgctxt "message"
msgid "04325"
msgstr ""
"We take this \"{actor_name:6}\" with\n"
"us... If they survive, they\n"
"will want her back.{page_break}"
"And if they want her\n"
"back, they will bring us\n"
"the Star.{end_wait}"

msgctxt "message"
msgid "04326"
msgstr ""
"Regardless, Kraden must\n"
"come with us.{pause_20_skippable} He is\n"
"connected to all of this.{end_wait}"

msgctxt "message"
msgid "04327"
msgstr ""
"Alex{pause_20_skippable}... \n"
"Are you breaking\n"
"our promise?{end_wait}"

msgctxt "message"
msgid "04328"
msgstr ""
"Conditions have changed\n"
"since we made that\n"
"promise.{end_wait}"

msgctxt "message"
msgid "04329"
msgstr ""
"{actor_name:6}'s not any part of\n"
"this. I won't let you\n"
"hurt her!{end_wait}"

msgctxt "message"
msgid "04330"
msgstr ""
"Do what you will with me.\n"
"Just let {actor_name:6} go!{end_wait}"

msgctxt "message"
msgid "04331"
msgstr ""
"Your bravery speaks well\n"
"of you, old man, but you\n"
"cannot help {actor_name:6} now.{end_wait}"

msgctxt "message"
msgid "04332"
msgstr ""
"If we leave {actor_name:6}, she\n"
"will surely die. Is that\n"
"what you want, {actor_name:5}?{end_wait}"

msgctxt "message"
msgid "04333"
msgstr ""
"Perhaps we ought to\n"
"continue this elsewhere,\n"
"{actor_name:5}.{end_wait}"

msgctxt "message"
msgid "04334"
msgstr "{actor_name:5}...{end_wait}"

msgctxt "message"
msgid "04335"
msgstr "Please...can we go now?{end_wait}"

msgctxt "message"
msgid "04336"
msgstr "Let's make haste!{end_wait}"

msgctxt "message"
msgid "04337"
msgstr "Hey, don't push my sister!{end_wait}"

msgctxt "message"
msgid "04338"
msgstr ""
"Who do you think you're\n"
"talking to?{pause_20_skippable} You owe\n"
"us your life!{end_wait}"

msgctxt "message"
msgid "04339"
msgstr "Menardi!{end_wait}"

msgctxt "message"
msgid "04340"
msgstr ""
"Master Kraden, you\n"
"will be joining us,\n"
"of course!{end_wait}"

msgctxt "message"
msgid "04341"
msgstr ""
"{actor_name:1}{pause_20_skippable}, {actor_name:2}!{pause_20_skippable}\n"
"Don't{pause_20_skippable}{pause_20_skippable}{pause_20_skippable} "
"die!{end_wait}"

msgctxt "message"
msgid "04342"
msgstr "The Mars Star...{end_wait}"

msgctxt "message"
msgid "04343"
msgstr ""
"It's a pity that we have\n"
"to leave it, but perhaps\n"
"we'll be seeing it soon...{end_wait}"

msgctxt "MsgSolSanctumWellTurnedBadly"
msgid "04344"
msgstr ""
"Well, this turned out\n"
"badly, wouldn't you say?{end_now}"

msgctxt "message"
msgid "04345"
msgstr ""
"It's a miracle we\n"
"survived.{end_wait}"

msgctxt "message"
msgid "04346"
msgstr ""
"How can you be so calm\n"
"at a time like this?{end_wait}"

msgctxt "MsgSolSanctumFriendsGone"
msgid "04347"
msgstr "{actor_name:6} and Kraden are gone!{end_wait}"

msgctxt "message"
msgid "04348"
msgstr ""
"You don't think they'll\n"
"hurt {actor_name:6} and\n"
"Kraden, do you?{end_now}"

msgctxt "MsgSolSanctumThanksALot"
msgid "04349"
msgstr ""
"Thanks a lot...\n"
"But seriously, {actor_name:6} and\n"
"Kraden should be fine.{page_break}"
"{actor_name:5} is with them...{end_wait}"

msgctxt "MsgSolSanctumTheyllBeSafe"
msgid "04350"
msgstr ""
"Yeah{pause_20_skippable}, they'll be safe.\n"
"{actor_name:5} is there...{end_wait}"

msgctxt "MsgSolSanctumThisIsTerrible"
msgid "04351"
msgstr ""
"This really is\n"
"terrible...{end_wait}"

msgctxt "message"
msgid "04352"
msgstr ""
"We've got a long way\n"
"to go if we're gonna\n"
"make it out of here.{end_wait}"

msgctxt "message"
msgid "04353"
msgstr "We're{pause_20_skippable} in big trouble...{end_now}"

msgctxt "message"
msgid "04354"
msgstr "Let's get out of here...{end_wait}"

msgctxt "MsgSolSanctumQuitActingTough"
msgid "04355"
msgstr ""
"Quit acting so tough!\n"
"Let's get out of here!{end_wait}"

msgctxt "MsgSolSanctumOverHere"
msgid "04356"
msgstr ""
"Hey, {actor_name:1}...{pause_20_skippable}\n"
"{actor_name:1}, I'm over here.{pause_20_skippable}\n"
"Come on, we've gotta go.{end_wait}"

msgctxt "message"
msgid "04357"
msgstr ""
"Why are you standing\n"
"there?{end_wait}"

msgctxt "message"
msgid "04358"
msgstr ""
"This place has\n"
"become dangerous...{end_wait}"

msgctxt "message"
msgid "04359"
msgstr "You're the dangerous one!{end_wait}"

msgctxt "message"
msgid "04360"
msgstr ""
"The volcano will soon\n"
"erupt...{pause_20_skippable} I cannot\n"
"hold it long.{end_wait}"

msgctxt "message"
msgid "04361"
msgstr "You must leave this place.{end_wait}"

msgctxt "message"
msgid "04362"
msgstr ""
"The Elemental Djinn...{pause_20_skippable}\n"
"They have returned...{end_wait}"

msgctxt "message"
msgid "04363"
msgstr ""
"Take out{pause_20_skippable} the\n"
"Elemental Star...{end_now}"

msgctxt "MsgSolSanctumCannotResist"
msgid "04364"
msgstr "{actor_name:1} cannot resist.{end_wait}"

msgctxt "MsgSolSanctumReturnStarToBag"
msgid "04365"
msgstr "Return it to its bag.{end_wait}"

msgctxt "message"
msgid "04366"
msgstr ""
"The Elemental Stars are...{pause_20_skippable}{pause_20_skippable}\n"
"moving away from here...{end_wait}"

msgctxt "message"
msgid "04367"
msgstr ""
"Without the power of\n"
"the Elemental Stars\n"
"to contain it,{page_break}"
"the magma flows freely\n"
"once again, and this\n"
"chamber is collapsing.{end_wait}"

msgctxt "message"
msgid "04368"
msgstr ""
"There will be no chamber\n"
"for the Elemental Stars\n"
"to return to...{end_wait}"

msgctxt "message"
msgid "04369"
msgstr ""
"The world will be\n"
"exposed to the threat\n"
"of Alchemy.{end_wait}"

msgctxt "message"
msgid "04370"
msgstr "Alchemy? A threat?{end_wait}"

msgctxt "message"
msgid "04371"
msgstr ""
"It can be a dangerous\n"
"power if it is\n"
"misused...{end_wait}"

msgctxt "message"
msgid "04372"
msgstr ""
"If the Elemental Stars\n"
"ignite the flames of\n"
"the four lighthouses,{page_break}"
"that power will\n"
"be released.{end_wait}"

msgctxt "message"
msgid "04373"
msgstr ""
"As long as the four\n"
"lighthouses remain\n"
"unlit...{end_wait}"

msgctxt "message"
msgid "04374"
msgstr ""
"The volcano...\n"
"It's erupting...\n"
"Flee, now!{end_wait}"

msgctxt "message"
msgid "04375"
msgstr "But how...{end_wait}"

msgctxt "message"
msgid "04376"
msgstr ""
"Ah.{pause_20_skippable} I see.\n"
"I will help you...{end_wait}"

msgctxt "MsgSolSanctumFloatingEyeThing"
msgid "04377"
msgstr ""
"Did that floating eye{pause_20_skippable}\n"
"thing save us?{end_now}"

msgctxt "message"
msgid "04378"
msgstr ""
"Yeah, right!\n"
"Let's get out of here...{end_wait}"

msgctxt "MsgSolSanctumGotFourMythrilBags"
msgid "04379"
msgstr ""
"{protagonist_name} got four\n"
"Mythril Bags.{end_wait}"

msgctxt "MsgSolSanctumTooManyItems"
msgid "04380"
msgstr ""
"You have too many\n"
"items. Will you drop\n"
"something?{end_wait}"

msgctxt "MsgValeItIsVeryDangerousToGo"
msgid "04381"
msgstr ""
"It is very dangerous\n"
"to go beyond here\n"
"when Mt. Aleph is active!{page_break}"
"Leave immediately!{end_wait}"

msgctxt "MsgValeIAmAllAloneInThis"
msgid "04382"
msgstr ""
"I am all alone in this\n"
"dangerous place.{page_break}"
"How can the Great\n"
"Healer treat me like\n"
"this...?{end_wait}"

msgctxt "MsgValeCheckedThePsynergyStone"
msgid "04383"
msgstr ""
"{protagonist_name} checked the\n"
"Psynergy Stone.{end_wait}"

msgctxt "MsgValeSChestValuables"
msgid "04384"
msgstr ""
"It's {actor_name:2}'s chest\n"
"of valuables.{end_wait}"

msgctxt "MsgValeRockCannotBeMoved"
msgid "04385"
msgstr ""
"It's a huge rock that\n"
"{protagonist_name}'s strength\n"
"can't even budge.{end_wait}"

msgctxt "MsgValeMtAlephWasInactive"
msgid "04386"
msgstr ""
"I thought Mt. Aleph\n"
"was{pause_20_skippable} inactive...{end_wait}"

msgctxt "message"
msgid "04387"
msgstr ""
"Oooh, my grandson!\n"
"Will {actor_name:2} be safe\n"
"in this eruption?!?{end_wait}"

msgctxt "message"
msgid "04388"
msgstr ""
"Grandpa, we don't even\n"
"know if he's up there!{end_wait}"

msgctxt "message"
msgid "04389"
msgstr ""
"But, Sis,{pause_20_skippable} someone saw\n"
"him and his friends\n"
"climbing Mt. Aleph.{end_wait}"

msgctxt "message"
msgid "04390"
msgstr ""
"They were hanging around\n"
"here while I was on\n"
"guard duty.{end_wait}"

msgctxt "message"
msgid "04391"
msgstr ""
"{actor_name:1} and {actor_name:2} went to\n"
"Mr. Kraden's house.{end_wait}"

msgctxt "message"
msgid "04392"
msgstr ""
"Didn't they{pause_20_skippable} say they\n"
"were studying Alchemy?{end_wait}"

msgctxt "message"
msgid "04393"
msgstr ""
"Yes, they did...{pause_20_skippable}but...{pause_20_skippable}\n"
"what does that have\n"
"to do with the eruption?{end_wait}"

msgctxt "message"
msgid "04394"
msgstr ""
"Uh-oh.{pause_20_skippable} It's Grandpa\n"
"and the others.{end_wait}"

msgctxt "message"
msgid "04395"
msgstr ""
"What should we do,\n"
"{actor_name:1}? Should we go\n"
"back up?{end_now}"

msgctxt "message"
msgid "04396"
msgstr "{actor_name:2}!{end_wait}"

msgctxt "message"
msgid "04397"
msgstr "{actor_name:1}!{end_wait}"

msgctxt "message"
msgid "04398"
msgstr "You're safe!{end_wait}"

msgctxt "message"
msgid "04399"
msgstr ""
"Come over here,\n"
"both of you!{end_wait}"

msgctxt "message"
msgid "04400"
msgstr "Where have you been?{end_wait}"

msgctxt "message"
msgid "04401"
msgstr "What happened?{end_wait}"

msgctxt "message"
msgid "04402"
msgstr ""
"Weren't {actor_name:6} and\n"
"Kraden with you?{end_now}"

msgctxt "message"
msgid "04403"
msgstr ""
"They were taken away?\n"
"By whom?{end_wait}"

msgctxt "message"
msgid "04404"
msgstr ""
"What do you mean,\n"
"they were taken away?{end_wait}"

msgctxt "message"
msgid "04405"
msgstr ""
"This is all very\n"
"complicated.{end_wait}"

msgctxt "message"
msgid "04406"
msgstr ""
"We'll need you to tell\n"
"us exactly what happened\n"
"on the mountain.{end_wait}"

msgctxt "message"
msgid "04407"
msgstr ""
"Come into the sanctum,\n"
"both of you.{end_wait}"

msgctxt "MsgSanctumWeHadIdeaTrueSanctum"
msgid "04408"
msgstr ""
"We had no idea...\n"
"The true sanctum...{end_wait}"

msgctxt "message"
msgid "04409"
msgstr ""
"And {actor_name:6} and Kraden...\n"
"They're prisoners?{end_now}"

msgctxt "message"
msgid "04410"
msgstr ""
"They've been taken against\n"
"their will... How awful!{end_wait}"

msgctxt "message"
msgid "04411"
msgstr ""
"Well...we can only hope\n"
"they're all right.{end_wait}"

msgctxt "message"
msgid "04412"
msgstr ""
"Do you think they\n"
"can be saved?{end_now}"

msgctxt "message"
msgid "04413"
msgstr ""
"{actor_name:6}'s brother, {actor_name:5},\n"
"will protect them,\n"
"won't he?{end_wait}"

msgctxt "message"
msgid "04414"
msgstr ""
"Then our hopes must\n"
"lie with {actor_name:5}.\n{end_wait}"

msgctxt "message"
msgid "04415"
msgstr ""
"What is it, Great Healer?\n"
"You have been very quiet.{end_wait}"

msgctxt "message"
msgid "04416"
msgstr ""
"It's like you're a\n"
"thousand miles away.{end_wait}"

msgctxt "message"
msgid "04417"
msgstr ""
"That hovering stone,\n"
"the one that appeared\n"
"before {actor_name:1}...{end_wait}"

msgctxt "message"
msgid "04418"
msgstr "What about it?{end_wait}"

msgctxt "message"
msgid "04419"
msgstr ""
"I have seen it before{pause_20_skippable}\n"
"in my dreams.{end_wait}"

msgctxt "message"
msgid "04420"
msgstr ""
"In my mind's eye, it\n"
"appeared again just now\n"
"and spoke to me.{end_wait}"

msgctxt "message"
msgid "04421"
msgstr "You saw it just now?{end_wait}"

msgctxt "message"
msgid "04422"
msgstr ""
"It must be the Wise One,\n"
"guardian of the Elemental\n"
"Stars.{end_wait}"

msgctxt "message"
msgid "04423"
msgstr ""
"It told me what happened\n"
"to you in Sol Sanctum.{end_wait}"

msgctxt "message"
msgid "04424"
msgstr ""
"So, what does the Wise\n"
"One say about the\n"
"eruption?{end_wait}"

msgctxt "message"
msgid "04425"
msgstr ""
"Will the volcano\n"
"destroy Vale?{end_wait}"

msgctxt "message"
msgid "04426"
msgstr ""
"It is impossible to stop\n"
"the eruption now.{end_wait}"

msgctxt "message"
msgid "04427"
msgstr "Will Vale be...{end_wait}"

msgctxt "message"
msgid "04428"
msgstr ""
"Vale will be safe.\n"
"The Wise One will prevent\n"
"the lava from reaching us.{end_wait}"

msgctxt "message"
msgid "04429"
msgstr ""
"What's the matter,\n"
"Great Healer?{end_wait}"

msgctxt "message"
msgid "04430"
msgstr ""
"...The village will be\n"
"destroyed, won't it?{end_wait}"

msgctxt "message"
msgid "04431"
msgstr ""
"Something even more\n"
"dreadful than Vale's\n"
"destruction looms ahead.{end_wait}"

msgctxt "message"
msgid "04432"
msgstr ""
"What could be worse than\n"
"the destruction of Vale?{end_wait}"

msgctxt "message"
msgid "04433"
msgstr "A terrible power.{end_wait}"

msgctxt "message"
msgid "04434"
msgstr ""
"The Elemental Star gems\n"
"house incredible\n"
"power.{end_wait}"

msgctxt "message"
msgid "04435"
msgstr ""
"...And Vale has been\n"
"guarding those gems?{end_wait}"

msgctxt "message"
msgid "04436"
msgstr ""
"The elemental lighthouses\n"
"will loose that power\n"
"upon the world.{end_wait}"

msgctxt "message"
msgid "04437"
msgstr ""
"Once the power of the\n"
"gems has been released,\n"
"the whole world will...{end_wait}"

msgctxt "message"
msgid "04438"
msgstr ""
"The Wise One wants\n"
"us to get the gems\n"
"back, doesn't he?{end_wait}"

msgctxt "message"
msgid "04439"
msgstr ""
"This world is ours,\n"
"to save or to destroy.{page_break}"
"Our inaction may\n"
"bring about its\n"
"destruction.{end_wait}"

msgctxt "message"
msgid "04440"
msgstr "What a pity...{end_wait}"

msgctxt "message"
msgid "04441"
msgstr ""
"We cannot hope for\n"
"salvation. We must save\n"
"ourselves...{end_wait}"

msgctxt "message"
msgid "04442"
msgstr "Then what can we do?{end_wait}"

msgctxt "message"
msgid "04443"
msgstr ""
"Acquiring the Elemental\n"
"Stars is{pause_20_skippable} their fate alone.{end_wait}"

msgctxt "message"
msgid "04444"
msgstr ""
"Are you suggesting\n"
"we place the fate\n"
"of the world...{page_break}"
"in the hands of\n"
"{actor_name:1} and {actor_name:2}?{end_wait}"

msgctxt "message"
msgid "04445"
msgstr ""
"{actor_name:2} is only a child.\n"
"You can't expect him to\n"
"bear such a burden...{end_wait}"

msgctxt "message"
msgid "04446"
msgstr "The Wise One has spoken.{end_wait}"

msgctxt "message"
msgid "04447"
msgstr ""
"Each of you shares\n"
"responsibility for this.{end_wait}"

msgctxt "message"
msgid "04448"
msgstr ""
"Now, each of you must\n"
"make your own decision!{end_wait}"

msgctxt "message"
msgid "04449"
msgstr ""
"I don't know what to do.\n"
"{actor_name:1}, you decide.{end_wait}"

msgctxt "MsgSanctumIsaacWillAcceptResponsibilityFor"
msgid "04450"
msgstr ""
"{actor_name:1}, will you accept\n"
"responsibility for the\n"
"fate of the land?{end_now}"

msgctxt "message"
msgid "04451"
msgstr ""
"I can't blame you...\n"
"I couldn't do it\n"
"if I were in your shoes.{end_wait}"

msgctxt "MsgSanctumAreYouSure"
msgid "04452"
msgstr "Are you sure?{end_now}"

msgctxt "message"
msgid "04453"
msgstr ""
"Would you like to think\n"
"it over?{end_now}"

msgctxt "message"
msgid "04454"
msgstr ""
"{actor_name:1}, will you take\n"
"the fate of the world\n"
"in your hands?{end_now}"

msgctxt "MsgSanctumIDontBlameYouICouldnt"
msgid "04455"
msgstr ""
"I don't blame you...\n"
"I couldn't do it if\n"
"I were in your shoes.{end_wait}"

msgctxt "MsgSanctumItIsATerribleBurdenTo"
msgid "04456"
msgstr ""
"It is a terrible burden,\n"
"to be responsible for\n"
"the fate of the world.{end_wait}"

msgctxt "MsgSanctumMotherWouldNeverDoubtYourCourage"
msgid "04457"
msgstr ""
"Mother would never\n"
"doubt your courage\n"
"just because you declined.{end_wait}"

msgctxt "MsgSanctumWasItRightToRefuseWhen"
msgid "04458"
msgstr ""
"Was it right to refuse\n"
"when the world is in\n"
"such jeopardy?{end_wait}"

msgctxt "MsgSanctumItsClearThatTheGreatHealer"
msgid "04459"
msgstr ""
"It's clear that the Great\n"
"Healer really wants you\n"
"to say yes.{end_wait}"

msgctxt "MsgSanctumOnceStepOutsideVillageCannot"
msgid "04460"
msgstr ""
"Once you step outside the\n"
"village, you cannot take\n"
"back your decision.{page_break}"
"Think about that before\n"
"you leave the Sanctum,\n"
"{actor_name:1}.{end_wait}"

msgctxt "MsgSanctumWorldBeganDrifting"
msgid "04461"
msgstr ""
"And so the world began\n"
"drifting toward its\n"
"fated destruction...{end_wait}"

msgctxt "MsgSanctumGreatHealer"
msgid "04462"
msgstr "From the Great Healer{end_wait}"

msgctxt "message"
msgid "04463"
msgstr "To the File Screen{end_wait}"

msgctxt "message"
msgid "04464"
msgstr "Restart the game{end_wait}"

msgctxt "MsgSanctumAcceptIsaacCantMean"
msgid "04465"
msgstr ""
"You accept? Oh, {actor_name:1}...\n"
"{pause_20_skippable}You can't mean it...{end_wait}"

msgctxt "message"
msgid "04466"
msgstr ""
"You chose to leave your\n"
"decision to {actor_name:1}.{page_break}"
"There shall be no\n"
"further discussion.{end_wait}"

msgctxt "message"
msgid "04467"
msgstr ""
"O, Wise One, these two\n"
"have accepted your quest.{page_break}"
"Give us your next\n"
"command!{end_wait}"

msgctxt "message"
msgid "04468"
msgstr ""
"You two are quite brave\n"
"to take on this quest.{end_wait}"

msgctxt "message"
msgid "04469"
msgstr ""
"I shall be watching you.\n"
"Choose your destiny\n"
"wisely, young ones.{end_wait}"

msgctxt "message"
msgid "04470"
msgstr "That was the Wise One...{end_wait}"

msgctxt "message"
msgid "04471"
msgstr ""
"What did the\n"
"Wise One say?{end_wait}"

msgctxt "message"
msgid "04472"
msgstr ""
"{actor_name:5} must{pause_20_skippable}{pause_20_skippable} unlock\n"
"the power.{end_wait}"

msgctxt "message"
msgid "04473"
msgstr ""
"Find the lighthouses...{page_break}"
"You'll have the\n"
"guidance of the Elemental\n"
"Star...{end_wait}"

msgctxt "message"
msgid "04474"
msgstr "Um...{pause_20_skippable} Then what?{end_wait}"

msgctxt "message"
msgid "04475"
msgstr ""
"What should they\n"
"do there?{end_wait}"

msgctxt "message"
msgid "04476"
msgstr ""
"Surely, that cannot be all\n"
"the advice you can offer\n"
"them, Great Healer...{end_wait}"

msgctxt "message"
msgid "04477"
msgstr ""
"Seek the elementals...\n"
"The Djinn...{end_wait}"

msgctxt "message"
msgid "04478"
msgstr "They will prove useful.{end_wait}"

msgctxt "message"
msgid "04479"
msgstr "Isn't there anything else?{end_wait}"

msgctxt "message"
msgid "04480"
msgstr "That is all.{end_wait}"

msgctxt "message"
msgid "04481"
msgstr ""
"That's it!?\n"
"Isn't there anything\n"
"else you can tell them?{end_wait}"

msgctxt "message"
msgid "04482"
msgstr "That is all, Mayor.{end_wait}"

msgctxt "message"
msgid "04483"
msgstr ""
"I leave it up to you, \n"
"{actor_name:1}...{pause_20_skippable}{actor_name:2}.{end_wait}"

msgctxt "message"
msgid "04484"
msgstr ""
"H{pause_20_skippable}-Hey, isn't it almost...\n"
"time to meditate?{end_wait}"

msgctxt "message"
msgid "04485"
msgstr ""
"Oh{pause_20_skippable} yeah!\n"
"Meditation!\n"
"Let's go!{end_wait}"

msgctxt "message"
msgid "04486"
msgstr ""
"Well, what good are\n"
"those guys!?{page_break}"
"Sending children off with\n"
"no help or direction...{end_wait}"

msgctxt "message"
msgid "04487"
msgstr "I agree, but...{end_wait}"

msgctxt "message"
msgid "04488"
msgstr ""
"They didn't give us\n"
"any other choice.{end_wait}"

msgctxt "message"
msgid "04489"
msgstr ""
"Then,{pause_20_skippable}{pause_20_skippable} when should\n"
"they go?{end_wait}"

msgctxt "message"
msgid "04490"
msgstr ""
"It doesn't sound like\n"
"we can afford to wait.{end_wait}"

msgctxt "message"
msgid "04491"
msgstr "Tomorrow, then?{end_wait}"

msgctxt "message"
msgid "04492"
msgstr "Tomorrow?{pause_20_skippable}{pause_20_skippable} Yes.{end_wait}"

msgctxt "MsgValeTremorsSettled"
msgid "04493"
msgstr ""
"Hey, you're {actor_name:1},\n"
"right?{page_break}"
"The tremors on Mt. Aleph\n"
"have settled down a bit.\n"
"Thank goodness.{end_wait}"

msgctxt "MsgValeRoadToVault"
msgid "04494"
msgstr ""
"If you don't know where\n"
"to go, why don't you try\n"
"Vault?{page_break}"
"If you head east a little\n"
"and then head south,\n"
"you should find it.{end_wait}"

msgctxt "MsgValeRoadToGomaRange"
msgid "04495"
msgstr ""
"If you follow the road\n"
"east and then head north,\n"
"you'll hit the Goma Range.{end_wait}"

msgctxt "MsgValePsynergyStonePowder"
msgid "04496"
msgstr ""
"The air is sparkling\n"
"because of the eruption\n"
"of Mt. Aleph.{page_break}"
"Do you think the falling\n"
"powder is crushed\n"
"Psynergy Stones?{end_wait}"

msgctxt "MsgValeYouSawTheWiseOne"
msgid "04497"
msgstr ""
"You saw the Wise One?\n"
"The same Wise One from\n"
"the healers' tales?{end_now}"

msgctxt "message"
msgid "04498"
msgstr ""
"That is a blessing...{pause_20_skippable}\n"
"A blessing, indeed.{end_wait}"

msgctxt "message"
msgid "04499"
msgstr ""
"It was the Wise One who\n"
"saved the town when\n"
"Mt. Aleph erupted.{end_wait}"

msgctxt "MsgValeLunpaFoundedNorthernTown"
msgid "04500"
msgstr ""
"Long ago, Lunpa, the\n"
"righteous thief, founded\n"
"a town in the north.{end_wait}"

msgctxt "MsgValeDoraHasBeenCrying"
msgid "04501"
msgstr ""
"{actor_name:1}, your mother,\n"
"Dora, has been crying\n"
"ever since you two left.{end_wait}"

msgctxt "MsgValeStonesScatteredByEruption"
msgid "04502"
msgstr ""
"If your Psynergy runs\n"
"low, touch a Psynergy\n"
"Stone to replenish it.{page_break}"
"Unfortunately, the\n"
"eruption blasted all the\n"
"Stones helter-skelter.{end_wait}"

msgctxt "MsgValeArentWorriedCrossing"
msgid "04503"
msgstr ""
"Aren't you worried about\n"
"crossing the land\n"
"with just the two of you?{end_now}"

msgctxt "message"
msgid "04504"
msgstr ""
"Aren't you worried about\n"
"crossing the land\n"
"with just three of you?{end_now}"

msgctxt "message"
msgid "04505"
msgstr ""
"Aren't you worried about\n"
"crossing the land\n"
"with just four of you?{end_now}"

msgctxt "message"
msgid "04506"
msgstr ""
"Don't wander too deep\n"
"into unknown lands.{page_break}"
"It's not brave to fight\n"
"against hopeless odds.{end_wait}"

msgctxt "message"
msgid "04507"
msgstr ""
"There is a difference\n"
"between being courageous\n"
"and being reckless.{page_break}"
"True courage requires\n"
"caution.{pause_20_skippable} Sometimes, it\n"
"may seem cowardly.{end_wait}"

msgctxt "MsgValeReplenishPsynergyBeforeDungeon"
msgid "04508"
msgstr ""
"Replenish your Psynergy\n"
"before entering a\n"
"dungeon.{page_break}"
"Sharp warriors know\n"
"to do that.{end_wait}"

msgctxt "MsgSanctumMyControlOverPsynergyHas"
msgid "04509"
msgstr ""
"My control over Psynergy\n"
"has grown since\n"
"yesterday evening...{page_break}"
"It must be because\n"
"I met the Wise One.{end_wait}"

msgctxt "MsgSanctumThePowerOfMtAlephStems"
msgid "04510"
msgstr ""
"The power of Mt. Aleph\n"
"stems from the Psynergy\n"
"Stones.{page_break}"
"If the eruption cast\n"
"the Psynergy Stones\n"
"across the land...{page_break}"
"then perhaps new Adepts\n"
"will...{end_wait}"

msgctxt "MsgSanctumDoFeelAnyChangeIn"
msgid "04511"
msgstr ""
"Do you feel any change\n"
"in your Psynergy?"

msgctxt "message"
msgid "04512"
msgstr ""
"Oh, I wish the Wise\n"
"One would come to me\n"
"and give me power.{end_wait}"

msgctxt "message"
msgid "04513"
msgstr ""
"The Great Healer said\n"
"my Psynergy powers grew\n"
"when I met the Wise One.{end_wait}"

msgctxt "MsgValeValeFeelsEmpty"
msgid "04514"
msgstr ""
"Vale has felt so empty\n"
"and quiet since you\n"
"two left.{end_wait}"

msgctxt "MsgValeImNotSadJustGo"
msgid "04515"
msgstr ""
"Sniff! I...{pause_20_skippable} I'm not\n"
"sad at all...\n"
"Go. {pause_20_skippable}Just go!{end_wait}"

msgctxt "MsgValeThisIsMyFarewellGift"
msgid "04516"
msgstr "This is my farewell gift.{end_wait}"

msgctxt "message"
msgid "04517"
msgstr ""
"{actor_name:1} took\n"
"the Herb.{end_wait}"

msgctxt "MsgValeYouMustSaveJenna"
msgid "04518"
msgstr ""
"You must save {actor_name:6}!{pause_20_skippable}\n"
"You must, {actor_name:1}!{end_wait}"

msgctxt "MsgValeComeBackAsAStrongWarrior"
msgid "04519"
msgstr ""
"Come back as a strong\n"
"warrior, {actor_name:1}.{page_break}"
"By then, I'll surely be\n"
"a fine smith.{end_wait}"

msgctxt "MsgValeIWantedJennaToBeMy"
msgid "04520"
msgstr ""
"I wanted {actor_name:6} to be\n"
"my daughter-in-law...{pause_20_skippable}{page_break}"
"Now she's gone.\n"
"This is terrible...{end_wait}"

msgctxt "MsgValeTheVisitorsCausedTheEruption"
msgid "04521"
msgstr ""
"Those visitors caused\n"
"the eruption and\n"
"kidnapped {actor_name:6}.{page_break}"
"I knew there was\n"
"something strange about\n"
"them.{end_wait}"

msgctxt "MsgValeTheMaskedManWasFelix"
msgid "04522"
msgstr ""
"That masked man...\n"
"He was {actor_name:5}, right?{end_now}"

msgctxt "message"
msgid "04523"
msgstr ""
"It's hard to believe,\n"
"but...what if {actor_name:6}\n"
"was involved in all this?{end_wait}"

msgctxt "message"
msgid "04524"
msgstr ""
"What?{pause_20_skippable} But didn't {actor_name:6}\n"
"see his face?{end_now}"

msgctxt "message"
msgid "04525"
msgstr ""
"If he is her brother,\n"
"maybe we shouldn't trust\n"
"{actor_name:6} too much.{end_wait}"

msgctxt "message"
msgid "04526"
msgstr ""
"What? But that's not\n"
"what you told the elders.{end_wait}"

msgctxt "MsgValeWereASmallHotelAndWe"
msgid "04527"
msgstr ""
"We're a small hotel, and\n"
"we get few guests...{page_break}"
"But we still keep this\n"
"place clean, just in case!{end_wait}"

msgctxt "MsgValeIsaacPleaseTakeCareOfMy"
msgid "04528"
msgstr ""
"{actor_name:1}, please take care\n"
"of my grandson, {actor_name:2}.{end_wait}"

msgctxt "MsgValeReceivingAQuestDirectlyFromThe"
msgid "04529"
msgstr ""
"Receiving a quest directly\n"
"from the Wise One must\n"
"be quite an honor.{end_wait}"

msgctxt "MsgValeImProudOfYouGaretMy"
msgid "04530"
msgstr ""
"I'm proud of you, {actor_name:2}.\n"
"My own son...on such\n"
"an important quest!{end_wait}"

msgctxt "MsgValeAsMothersDoraAndIWill"
msgid "04531"
msgstr ""
"As mothers{pause_20_skippable}, Dora and I\n"
"will always worry about\n"
"you.{page_break}"
"It doesn't matter how old\n"
"you get{em_dash}you will always\n"
"be our babies.{end_wait}"

msgctxt "MsgValeYouGuysAreSoLuckyGaret"
msgid "04532"
msgstr ""
"You guys are so lucky,\n"
"{actor_name:2}.{page_break}"
"I wish I could\n"
"go with you.{end_wait}"

msgctxt "MsgValePleaseTakeCareOfMyBrother"
msgid "04533"
msgstr ""
"Please take care of my\n"
"brother{pause_20_skippable}, {actor_name:1}.{end_wait}"

msgctxt "MsgValeYouCantBeIsaac"
msgid "04534"
msgstr ""
"Who are you?{pause_20_skippable}{pause_20_skippable} You can't\n"
"be... You're not\n"
"{actor_name:1}, are you? {end_now}"

msgctxt "message"
msgid "04535"
msgstr ""
"{actor_name:1}...\n"
"That's a lie!{end_wait}"

msgctxt "message"
msgid "04536"
msgstr ""
"He promised{pause_20_skippable} not to\n"
"return until he fulfills\n"
"his mission.{page_break}"
"My {actor_name:1} would\n"
"keep his promise.{pause_20_skippable}\n"
"...Go away.{end_wait}"

msgctxt "message"
msgid "04537"
msgstr ""
"I don't know who you are.{pause_20_skippable}\n"
"I'm sorry{pause_20_skippable}, but I don't\n"
"want to see anyone today.{end_wait}"

msgctxt "MsgValeIHeardThatJennaBrotherFelix"
msgid "04538"
msgstr ""
"I heard that {actor_name:6}{possessive_suffix}\n"
"brother {actor_name:5} is alive...{page_break}"
"But why is he caught up\n"
"with that bunch that\n"
"raided Sol Sanctum?{end_wait}"

msgctxt "MsgValePleaseReturnMyPreciousGranddaughterJenna"
msgid "04539"
msgstr ""
"Please return my precious\n"
"granddaughter, {actor_name:6},\n"
"to me. {pause_20_skippable}I will be waiting.{end_wait}"

msgctxt "MsgValeAfterJennaWasTakenGrandmotherGrew"
msgid "04540"
msgstr ""
"After {actor_name:6} was\n"
"taken, Grandmother\n"
"grew sick with despair...{end_wait}"

msgctxt "MsgValeItsBecauseKradenWasStudyingAlchemy"
msgid "04541"
msgstr ""
"It's because Kraden was\n"
"studying Alchemy...{page_break}"
"That's why the\n"
"mountain erupted, isn't it?{end_wait}"

msgctxt "MsgValeTheCulpritsHadStrangePowers"
msgid "04542"
msgstr ""
"They say the people who\n"
"caused this whole mess\n"
"had strange powers.{page_break}"
"...{pause_20_skippable}Is that true?{end_now}"

msgctxt "message"
msgid "04543"
msgstr ""
"If they were using\n"
"Psynergy...{page_break}"
"That means there are\n"
"towns other than Vale\n"
"with Psynergy.{end_wait}"

msgctxt "message"
msgid "04544"
msgstr ""
"If that's the case,\n"
"then I don't need to\n"
"worry.{page_break}"
"It means Psynergy really\n"
"is a special power,\n"
"found only in Vale...{end_wait}"

msgctxt "MsgValeImSoJealousOfYouBeing"
msgid "04545"
msgstr ""
"I'm so jealous of you!\n"
"Being able to leave town...\n"
"Tch!{end_wait}"

msgctxt "MsgValeOnceYouLeaveTownTakeCare"
msgid "04546"
msgstr ""
"Once you leave town, take\n"
"care not to use Psynergy\n"
"in front of others.{end_wait}"

msgctxt "MsgValeIHadNoIdeaThatSuch"
msgid "04547"
msgstr ""
"I had no idea that such\n"
"a secret hid within\n"
"Sol Sanctum.{page_break}"
"If only we'd known, we\n"
"could have stopped\n"
"this whole thing.{end_wait}"

msgctxt "MsgValeIllClimbTheFenceSomeday"
msgid "04548"
msgstr ""
"Once I'm as old as you,\n"
"{actor_name:1}, I'm going to\n"
"climb that fence...{page_break}"
"and journey to the lands\n"
"beyond!{end_wait}"

msgctxt "MsgValeSighNoLongerWillISee"
msgid "04549"
msgstr ""
"Sigh... No longer will I\n"
"see {actor_name:6} standing\n"
"there looking lonely.{end_wait}"

msgctxt "MsgValeIDontBlameFelixIfOnly"
msgid "04550"
msgstr ""
"I don't blame {actor_name:5}.{page_break}"
"If only we'd been\n"
"able to save him on\n"
"that fateful day.{end_wait}"

msgctxt "MsgValeTheStoneFellOnThe"
msgid "04551"
msgstr ""
"Look, {actor_name:1}.{pause_20_skippable} That large\n"
"Psynergy Stone fell right\n"
"on top of the hut.{end_wait}"

msgctxt "message"
msgid "04552"
msgstr ""
"It scares me that\n"
"something so big could\n"
"just fall out of the sky.{end_wait}"

msgctxt "MsgValeKradenHasntComeBack"
msgid "04553"
msgstr ""
"I guess Kraden still\n"
"hasn't come back.{end_wait}"

msgctxt "MsgValeValeIsSavedThanksToThe"
msgid "04554"
msgstr ""
"Vale is saved thanks\n"
"to the Wise One!{end_wait}"

msgctxt "MsgValeEverSinceTheTremorsStartedMt"
msgid "04555"
msgstr ""
"Ever since the tremors\n"
"started, Mt. Aleph has\n"
"been impossible to climb.{end_wait}"

msgctxt "MsgValeTheGroundStillShakes"
msgid "04556"
msgstr ""
"The ground still shakes\n"
"sometimes, but everyone\n"
"says the danger is gone.{end_wait}"

msgctxt "MsgValeTheMayorWasTooKindTo"
msgid "04557"
msgstr ""
"The mayor was too kind\n"
"to those strangers...{page_break}"
"None of this would have\n"
"happened if he'd kicked\n"
"those travelers out.{end_wait}"

msgctxt "MsgValeWorriedAboutAnotherEruption"
msgid "04558"
msgstr ""
"The eruptions subsided,\n"
"but it may erupt again.\n"
"I'm still worried.{end_wait}"

msgctxt "MsgValeVaultUndergroundPath"
msgid "04559"
msgstr ""
"Vault? Isn't that the\n"
"town with the\n"
"underground path?{end_wait}"

msgctxt "MsgValeGomaWinterCold"
msgid "04560"
msgstr ""
"Once winter comes, the\n"
"lands beyond the Goma\n"
"Range get very cold.{page_break}"
"I'm glad I don't have\n"
"to go there at this\n"
"time of year.{end_wait}"

msgctxt "MsgValeStonesPowerAleph"
msgid "04561"
msgstr ""
"If these sparkles truly\n"
"are all that remain of the\n"
"Psynergy Stones...{page_break}"
"then Mt. Aleph must\n"
"indeed be in trouble.{page_break}"
"I've heard the Psynergy\n"
"Stones are the source of\n"
"all of Mt. Aleph's power.{end_wait}"

msgctxt "MsgValeProofOfWiseOne"
msgid "04562"
msgstr ""
"I believed with all my\n"
"heart that the Wise One\n"
"really existed...{page_break}"
"I'm so grateful that we\n"
"finally have some proof!{end_wait}"

msgctxt "MsgValeLunpaThievesChanged"
msgid "04563"
msgstr ""
"Even the righteous thieves\n"
"seem to have changed\n"
"over the generations.{page_break}"
"Nowadays, the thieves of\n"
"Lunpa are said to even\n"
"attack travelers.{end_wait}"

msgctxt "MsgValeDoraMustBeLonely"
msgid "04564"
msgstr ""
"No matter how hard she\n"
"tries to hide her feelings,{page_break}"
"{protagonist_name}{possessive_suffix} mother\n"
"must be lonely...{end_wait}"

msgctxt "MsgValeLuckyToFindPsynergyStones"
msgid "04565"
msgstr ""
"You'll be very lucky if\n"
"you find any Psynergy\n"
"Stones in your travels.{end_wait}"

msgctxt "MsgValeComeBackAlive"
msgid "04566"
msgstr ""
"I'm worried about you,\n"
"{protagonist_name}. You guys\n"
"are like brothers to me.{page_break}"
"Promise me you won't do\n"
"anything foolish. And\n"
"come back alive!{end_wait}"

msgctxt "MsgValeRecoverPsynergyByWalking"
msgid "04567"
msgstr ""
"I wouldn't worry if\n"
"my Psynergy ran low in\n"
"a dungeon, because{page_break}"
"I know that I can\n"
"recover Psynergy by just\n"
"walking around.{end_wait}"

msgctxt "MsgSanctumThePowerOfMyPsynergyHas"
msgid "04568"
msgstr ""
"The power of my\n"
"Psynergy has dramatically\n"
"increased, but I don't{page_break}"
"know why. I'd really\n"
"like to try this Psynergy\n"
"out on something.{end_wait}"

msgctxt "MsgSanctumTheAngaranContinentWillCertainlySee"
msgid "04569"
msgstr ""
"The Angaran continent will\n"
"certainly see trouble from\n"
"these Psynergy Stones...{page_break}"
"It makes leaving Vale\n"
"all the more dangerous.{end_wait}"

msgctxt "MsgSanctumMyPsynergyHasntChangedAtAll"
msgid "04570"
msgstr ""
"My Psynergy...{pause_20_skippable}hasn't\n"
"changed at all. It's\n"
"not fair.{end_wait}"

msgctxt "MsgValeIsaacYoureGoingOnADifficult"
msgid "04571"
msgstr ""
"{protagonist_name}, you're going\n"
"on a difficult journey, so\n"
"be sure to do your best.{end_wait}"

msgctxt "MsgValeIfYouFaceAnyHardshipIn"
msgid "04572"
msgstr ""
"If you face any hardship\n"
"in your quest, do not\n"
"hesitate to come home.{end_wait}"

msgctxt "MsgValeSoIfThatWasFelixWho"
msgid "04573"
msgstr ""
"So if that was {actor_name:5}\n"
"who kidnapped {actor_name:6}...{page_break}"
"Then why do you have\n"
"to go save her?{end_wait}"

msgctxt "MsgValeIWillThinkOfJennaAs"
msgid "04574"
msgstr ""
"I will think of {actor_name:6}\n"
"as I do my work...{page_break}"
"We're all counting on\n"
"you, {protagonist_name}!{end_wait}"

msgctxt "MsgValeNowThatJennaIsGoneWe"
msgid "04575"
msgstr ""
"Now that {actor_name:6} is\n"
"gone, we need another\n"
"girl to replace her.{end_wait}"

msgctxt "MsgValeWhoCouldHaveKnownThatMasked"
msgid "04576"
msgstr ""
"Who could have known\n"
"that masked man was\n"
"{actor_name:5}!?{page_break}"
"I guess he hid his face\n"
"from us because\n"
"he was ashamed.{end_wait}"

msgctxt "MsgValeIWonderIfFelixChangedMuch"
msgid "04577"
msgstr ""
"I wonder if {actor_name:5}\n"
"changed much. He was\n"
"such a good boy...{page_break}"
"Do you suppose {actor_name:6}\n"
"could change like that?{end_wait}"

msgctxt "MsgValeFelixAndHisGangMustHave"
msgid "04578"
msgstr ""
"{actor_name:5} and his gang\n"
"must have left in a hurry.{page_break}"
"I found his wallet when\n"
"I was cleaning the room...{end_wait}"

msgctxt "MsgValeItsHardLettingMyPreciousGaret"
msgid "04579"
msgstr ""
"It's hard letting my\n"
"precious {actor_name:2} go...{page_break}"
"But no! I have to be\n"
"strong for everyone!{end_wait}"

msgctxt "MsgValeTheWiseOneChoseGaretHimself"
msgid "04580"
msgstr ""
"The Wise One chose {actor_name:2}\n"
"himself, and I am so\n"
"proud of my boy.{end_wait}"

msgctxt "MsgValeOnceGaretLeavesIWontBe"
msgid "04581"
msgstr ""
"Once {actor_name:2} leaves,\n"
"I won't be able to\n"
"rest until he returns.{page_break}"
"It's a good thing we\n"
"have two children.{end_wait}"

msgctxt "MsgValeIAmConcernedForGaretBut"
msgid "04582"
msgstr ""
"I am concerned for\n"
"{actor_name:2}, but he is my\n"
"son, so I am sure he will{page_break}"
"be all right. I can't wait\n"
"until he returns to\n"
"Vale as a strong man.{end_wait}"

msgctxt "MsgValeGeeIWishICouldSee"
msgid "04583"
msgstr ""
"Gee, I wish I could\n"
"see new lands, too.{end_wait}"

msgctxt "MsgValeMyBrothersStrengthIsHisBest"
msgid "04584"
msgstr ""
"My brother's strength is\n"
"his best asset, so he'll\n"
"be a big help to you!{end_wait}"

msgctxt "MsgValeFelixInheritedHisFathersSkillWith"
msgid "04585"
msgstr ""
"{actor_name:5} inherited his\n"
"father's skill with\n"
"Psynergy.{page_break}"
"Open your eyes, {actor_name:5},\n"
"and use that Psynergy\n"
"for good, not evil.{end_wait}"

msgctxt "MsgValeJennaAnytimeYouFaceDangerJust"
msgid "04586"
msgstr ""
"{actor_name:6}, anytime you face\n"
"danger, just use your\n"
"Psynergy to overcome it.{page_break}"
"The fire Psynergy you\n"
"inherited from your\n"
"mother will help you.{end_wait}"

msgctxt "MsgValeWhyWouldFelixTakeHisSister"
msgid "04587"
msgstr ""
"Why would {actor_name:5}\n"
"take his sister,\n"
"{actor_name:6}, away?{end_wait}"

msgctxt "MsgValeWeAlmostLostTheTownOver"
msgid "04588"
msgstr ""
"We almost lost the town\n"
"over something as silly\n"
"as the study of Alchemy.{end_wait}"

msgctxt "MsgValeIdLikeToBelieveThatOnly"
msgid "04589"
msgstr ""
"I'd like to believe that\n"
"only the people of Vale\n"
"can use Psynergy.{end_wait}"

msgctxt "MsgValeIfOnlyIdGoneToSol"
msgid "04590"
msgstr ""
"If only I'd gone to Sol\n"
"Sanctum with {protagonist_name}\n"
"and the others...{page_break}"
"It should have been me\n"
"going on this quest.{end_wait}"

msgctxt "MsgValeValesLawsStateThatYouCannot"
msgid "04591"
msgstr ""
"Vale's laws state that you\n"
"cannot use Psynergy in\n"
"front of outsiders.{page_break}"
"But you know that, don't\n"
"you, {protagonist_name}?{end_wait}"

msgctxt "MsgValeIWishIWereTheOne"
msgid "04592"
msgstr ""
"I wish I were the one\n"
"who solved the mystery\n"
"of Sol Sanctum.{end_wait}"

msgctxt "MsgValeCuriousBeyondFence"
msgid "04593"
msgstr ""
"Why is it that no one\n"
"else is curious about what\n"
"lies beyond this fence?{end_wait}"

msgctxt "MsgValeImGladThatFelixIsAlive"
msgid "04594"
msgstr ""
"I'm glad that {actor_name:5}\n"
"is alive. I was so worried\n"
"about {actor_name:6}.{end_wait}"

msgctxt "MsgValeFelixWasAGoodPersonI"
msgid "04595"
msgstr ""
"{actor_name:5} was a good\n"
"person. I still believe\n"
"in him.{end_wait}"

msgctxt "MsgValeStonesReplenishPsynergy"
msgid "04596"
msgstr ""
"Even if your Psynergy\n"
"runs low, you'll be fine as\n"
"long as you can find{page_break}"
"Psynergy Stones. They\n"
"immediately replenish your\n"
"Psynergy.{end_wait}"

msgctxt "MsgValePoorKradenWasTakenToSome"
msgid "04597"
msgstr ""
"Poor Kraden was taken\n"
"to some faraway place.{page_break}"
"I liked that\n"
"old coot...{end_wait}"

msgctxt "MsgValeValeWasSavedBecausePeopleLike"
msgid "04598"
msgstr ""
"Vale was saved because\n"
"people like this old\n"
"woman worked hard...{page_break}"
"to protect those who\n"
"couldn't protect\n"
"themselves.{end_wait}"

msgctxt "MsgValeICantBelieveAnyoneWouldClimb"
msgid "04599"
msgstr ""
"I can't believe anyone\n"
"would climb the mountain\n"
"after such an eruption!{end_wait}"

msgctxt "MsgValeIJustDontFeelSafeKnowing"
msgid "04600"
msgstr ""
"I just don't feel safe,\n"
"knowing Mt. Aleph could\n"
"still erupt!{end_wait}"

msgctxt "MsgValeThePeopleOfValeWillNever"
msgid "04601"
msgstr ""
"The people of Vale will\n"
"never trust travelers\n"
"again.{page_break}"
"Of course, I never\n"
"trusted them in the\n"
"first place.{end_wait}"

msgctxt "MsgValeWhysEveryoneHanging"
msgid "04602"
msgstr ""
"Why's everyone hanging\n"
"around the town gate?{end_wait}"

msgctxt "message"
msgid "04603"
msgstr "What,{pause_20_skippable} didn't you hear?{end_wait}"

msgctxt "message"
msgid "04604"
msgstr ""
"{actor_name:1} and {actor_name:2}\n"
"are leaving Vale on a\n"
"journey.{end_wait}"

msgctxt "message"
msgid "04605"
msgstr "I wish I could go!{end_wait}"

msgctxt "message"
msgid "04606"
msgstr ""
"I heard it's going\n"
"to be really\n"
"dangerous!{end_wait}"

msgctxt "message"
msgid "04607"
msgstr ""
"Oh, yeah? So everyone's\n"
"down there to say\n"
"good-bye?{end_wait}"

msgctxt "message"
msgid "04608"
msgstr "Hey, what's the matter?{end_wait}"

msgctxt "message"
msgid "04609"
msgstr ""
"Weird.\n"
"{actor_name:1}'s mother isn't\n"
"there to see him off!{end_wait}"

msgctxt "message"
msgid "04610"
msgstr ""
"You're right. She's not\n"
"there.{end_wait}"

msgctxt "message"
msgid "04611"
msgstr ""
"Hey,{pause_20_skippable} should we go\n"
"say good-bye, too?{end_wait}"

msgctxt "message"
msgid "04612"
msgstr "Sure! Let's go!{end_wait}"

msgctxt "message"
msgid "04613"
msgstr ""
"We are counting on you,{pause_20_skippable}{pause_20_skippable}\n"
"{actor_name:1}.{pause_20_skippable} Oh, and you, too,\n"
"{actor_name:2}.{end_wait}"

msgctxt "message"
msgid "04614"
msgstr ""
"Don't drink the water\n"
"if it smells funny.{page_break}"
"And...take this with\n"
"you, too.{end_wait}"

msgctxt "message"
msgid "04615"
msgstr ""
"I know not to drink\n"
"stagnant water, Sis!{end_wait}"

msgctxt "message"
msgid "04616"
msgstr ""
"Don't listen to him,\n"
"{actor_name:1}!{page_break}"
"He's a pig!\n"
"He'll eat anything\n"
"that's not tied down!{end_wait}"

msgctxt "message"
msgid "04617"
msgstr ""
"Hmm...{pause_20_skippable} Dora is very\n"
"late...{end_wait}"

msgctxt "message"
msgid "04618"
msgstr "Oh!{pause_20_skippable} That's right!{end_wait}"

msgctxt "message"
msgid "04619"
msgstr ""
"Aunty Dora asked me{pause_20_skippable}\n"
"to give this to you,\n"
"{actor_name:1}.{end_wait}"

msgctxt "message"
msgid "04620"
msgstr ""
"I guess we're all set\n"
"to go, huh, {actor_name:1}?{end_wait}"

msgctxt "message"
msgid "04621"
msgstr "Think again, {actor_name:2}!{end_wait}"

msgctxt "message"
msgid "04622"
msgstr ""
"It must be very difficult\n"
"for Dora...{end_wait}"

msgctxt "message"
msgid "04623"
msgstr ""
"As {actor_name:2}'s mother,\n"
"I know how Dora must\n"
"be feeling.{end_wait}"

msgctxt "message"
msgid "04624"
msgstr ""
"But I still have {actor_name:2}'s\n"
"father, while Dora has\n"
"only {actor_name:1}.{end_wait}"

msgctxt "message"
msgid "04625"
msgstr ""
"She doesn't want you\n"
"to go, {actor_name:1},{page_break}"
"but she knows you have\n"
"to, and it hurts to\n"
"see you leave.{end_wait}"

msgctxt "message"
msgid "04626"
msgstr ""
"They can't keep standing\n"
"around here like this, or\n"
"they'll never leave.{end_wait}"

msgctxt "message"
msgid "04627"
msgstr "So,{pause_20_skippable} one final farewell!{end_wait}"

msgctxt "MsgValeFarewell"
msgid "04628"
msgstr "{text_effect:2}Farewell!{reset_text_style}{end_wait}"

msgctxt "MsgWorldMapWeCantStayAnotherMinute"
msgid "04629"
msgstr ""
"We can't stay another\n"
"minute in a dangerous\n"
"place like this.{page_break}"
"We return to\n"
"Kalay immediately!{end_wait}"

msgctxt "message"
msgid "04630"
msgstr ""
"Master Hammet! This is\n"
"terrible! The bridge has\n"
"been destroyed...{page_break}"
"We cannot continue\n"
"southward!{end_wait}"

msgctxt "message"
msgid "04631"
msgstr "What...? The bridge?{end_wait}"

msgctxt "message"
msgid "04632"
msgstr ""
"This is awful...\n"
"How are we going to\n"
"get to Kalay now?{end_wait}"

msgctxt "message"
msgid "04633"
msgstr ""
"...Master Hammet, I'm\n"
"worried about leaving\n"
"{actor_name:3} behind...{end_wait}"

msgctxt "message"
msgid "04634"
msgstr ""
"As fond as I am of {actor_name:3},{pause_20_skippable}\n"
"it is his fault my rod\n"
"was stolen...{end_wait}"

msgctxt "message"
msgid "04635"
msgstr ""
"And his strange powers\n"
"will aid him in search\n"
"of the rod.{end_wait}"

msgctxt "message"
msgid "04636"
msgstr "{actor_name:3} has strange powers?{end_wait}"

msgctxt "message"
msgid "04637"
msgstr ""
"We must leave this\n"
"treacherous place\n"
"immediately!{end_wait}"

msgctxt "message"
msgid "04638"
msgstr ""
"But to where?{pause_20_skippable}{pause_20_skippable}\n"
"Where can we go?{end_wait}"

msgctxt "message"
msgid "04639"
msgstr ""
"We have no choice.\n"
"We're heading north.{end_wait}"

msgctxt "message"
msgid "04640"
msgstr ""
"We'll wind up in Lunpa\n"
"if we go north...{end_wait}"

msgctxt "message"
msgid "04641"
msgstr ""
"Well, it's better than\n"
"being smashed by falling\n"
"rocks here, isn't it?{end_wait}"

msgctxt "MsgVaultWelcomeToVaultTheTownAt"
msgid "04642"
msgstr ""
"Welcome to Vault,\n"
"the town at the\n"
"heart of Angara.{end_wait}"

msgctxt "MsgVaultWasntEruptionMtAlephIncredible"
msgid "04643"
msgstr ""
"Wasn't the eruption of\n"
"Mt. Aleph incredible?{end_now}"

msgctxt "message"
msgid "04644"
msgstr ""
"I was so stricken with\n"
"terror that I couldn't\n"
"sleep for days!{end_wait}"

msgctxt "message"
msgid "04645"
msgstr ""
"Aren't you courageous!\n"
"Not even an erupting\n"
"volcano scares you!{end_wait}"

msgctxt "MsgVaultMasterHammetAWealthyLandownerAnd"
msgid "04646"
msgstr ""
"Master Hammet, a\n"
"wealthy landowner and\n"
"merchant from Kalay,{page_break}"
"had his precious rod\n"
"stolen from him. He\n"
"was quite upset.{end_wait}"

msgctxt "MsgVaultGuessFolksGot"
msgid "04647"
msgstr ""
"I guess some folks got\n"
"robbed during the chaos\n"
"of the volcanic eruption.{end_wait}"

msgctxt "MsgVaultMasterHammetsServantCantReturnTo"
msgid "04648"
msgstr ""
"Master Hammet's servant\n"
"can't return to Kalay\n"
"until he recovers the rod.{end_wait}"

msgctxt "MsgVaultThoseTravelersLeftInBig"
msgid "04649"
msgstr ""
"Those travelers left\n"
"in a big hurry.{page_break}"
"They looked like they\n"
"were on the run. Did you\n"
"see them coming in?{end_now}"

msgctxt "message"
msgid "04650"
msgstr ""
"No, not Master Hammet...\n"
"It was a group of two\n"
"women and four men.{page_break}"
"They were quite strange.{page_break}"
"The young girl and the old\n"
"man didn't look too\n"
"happy to be there.{end_wait}"

msgctxt "message"
msgid "04651"
msgstr ""
"Oh, maybe they left\n"
"earlier than I\n"
"thought.{end_wait}"

msgctxt "MsgVaultPoorGuyLeft"
msgid "04652"
msgstr ""
"That poor guy, {actor_name:3}.{page_break}"
"They left him at the\n"
"mayor's to look for the\n"
"stolen rod.{end_wait}"

msgctxt "MsgVaultMasterHammetsCaravan"
msgid "04653"
msgstr ""
"Master Hammet's caravan\n"
"left town as soon as\n"
"the eruption stopped...{page_break}"
"I guess that volcano\n"
"really shook him up!{end_wait}"

msgctxt "MsgVaultNobodysStealingAnything"
msgid "04654"
msgstr ""
"Nobody's stealing\n"
"anything on my watch!{page_break}"
"We know the thieves must\n"
"be from out of town.{page_break}"
"They must be!\n"
"No one living here\n"
"would break the law!{end_wait}"

msgctxt "MsgVaultAccusingUsStealingHammetsTreasured"
msgid "04655"
msgstr ""
"Are you accusing us\n"
"of stealing Hammet's\n"
"treasured Shaman's Rod?{end_now}"

msgctxt "message"
msgid "04656"
msgstr ""
"Hey, just because we're\n"
"new in town doesn't mean\n"
"we're a bunch of thieves!{page_break}"
"Besides, you can't\n"
"prove anything!{end_wait}"

msgctxt "message"
msgid "04657"
msgstr ""
"Ha! Sure! I knew you\n"
"were too smart to listen\n"
"to rumors.{page_break}"
"But it wasn't us. Heck,\n"
"we don't even know\n"
"what was stolen!{end_wait}"

msgctxt "MsgVaultOffOnAdventure"
msgid "04658"
msgstr ""
"Hmm, off on an adventure,\n"
"are you?{end_now}"

msgctxt "message"
msgid "04659"
msgstr ""
"It's impressive to see\n"
"youngsters like you going\n"
"on a dangerous journey.{end_wait}"

msgctxt "message"
msgid "04660"
msgstr ""
"Oh, well. Stop in and see\n"
"our Sanctum while\n"
"you're here.{end_wait}"

msgctxt "MsgVaultRuffRrruff"
msgid "04661"
msgstr "Ruff! Rrruff!!{end_wait}"

msgctxt "MsgVaultISupposeTheseChildrenCantGo"
msgid "04662"
msgstr ""
"I suppose these{pause_20_skippable} children\n"
"can't go anywhere since\n"
"Mt. Aleph erupted?{end_wait}"

msgctxt "MsgVaultMtAlephsEruptionWasBeyondDescription"
msgid "04663"
msgstr ""
"Mt. Aleph's eruption was\n"
"beyond description.{page_break}"
"It was so frightening...\n"
"We're lucky we survived.{end_wait}"

msgctxt "MsgVaultWhyDoesAWealthyManLike"
msgid "04664"
msgstr ""
"Why does a wealthy man\n"
"like Hammet make such a\n"
"fuss over losing one rod?{page_break}"
"He has more than enough\n"
"money. He could just buy\n"
"a replacement.{end_wait}"

msgctxt "MsgVaultManShouldStealFromAnother"
msgid "04665"
msgstr ""
"No man should steal from\n"
"another during the\n"
"panic of an eruption.{page_break}"
"It's unforgivable!{end_wait}"

msgctxt "MsgVaultPoorIvanButTheRodMay"
msgid "04666"
msgstr ""
"Poor {actor_name:3}...{pause_20_skippable} But the\n"
"rod may never turn up.{page_break}"
"In that case, he can stay\n"
"here forever.{end_wait}"

msgctxt "MsgVaultGroupTravelersWasStrangeBunch"
msgid "04667"
msgstr ""
"That group of travelers{pause_20_skippable}\n"
"was a strange bunch,\n"
"weren't they?{page_break}"
"They seemed to be heading\n"
"to the northeastern parts\n"
"of the Goma Range...{end_wait}"

msgctxt "MsgVaultBetWasThoseThreeCreeps"
msgid "04668"
msgstr ""
"I bet it was those three\n"
"creeps at the inn\n"
"who stole the rod.{end_wait}"

msgctxt "MsgVaultSupposeDoesntMatterHowRich"
msgid "04669"
msgstr ""
"I suppose it doesn't\n"
"matter how rich you\n"
"are...{page_break}"
"if it can't save you from\n"
"an erupting volcano.{end_wait}"

msgctxt "MsgVaultEveryoneKnowsThoseThreeAt"
msgid "04670"
msgstr ""
"Everyone knows those\n"
"three at the inn\n"
"stole the rod.{page_break}"
"Tch! It's just so...\n"
"so frustrating!!!{end_wait}"

msgctxt "MsgVaultHmphItLooksLikeTheyreOnto"
msgid "04671"
msgstr ""
"Hmph! It looks like\n"
"they're onto us.{page_break}"
"We'd better leave town\n"
"as soon as possible.{end_wait}"

msgctxt "MsgVaultIWasJustAboutToLeave"
msgid "04672"
msgstr ""
"I was just about to leave\n"
"this town behind me when\n"
"the volcano erupted.{end_wait}"

msgctxt "MsgVaultStealingInMidstVolcanicEruption"
msgid "04673"
msgstr ""
"Stealing in the midst of\n"
"a volcanic eruption...{page_break}"
"Humans value money\n"
"more than they value\n"
"their own lives.{end_wait}"

msgctxt "MsgVaultThisRockWasBlownHereAll"
msgid "04674"
msgstr ""
"This rock was blown\n"
"here all the way\n"
"from the volcano!{page_break}"
"It looks odd, doesn't it?\n"
"It sparkles so much,\n"
"it looks like a gem.{end_wait}"

msgctxt "MsgVaultIfOnlyTheseRocksWere"
msgid "04675"
msgstr ""
"If only these rocks were\n"
"gems. We'd be wealthy!{end_wait}"

msgctxt "MsgVaultTheOtherSparklingRocksAllCrumbled"
msgid "04676"
msgstr ""
"The other sparkling\n"
"rocks all crumbled\n"
"to bits...{page_break}"
"But this one I found\n"
"on the roof is perfect.\n"
"I must be lucky!{end_wait}"

msgctxt "MsgVaultOkMisterLetMeSee"
msgid "04677"
msgstr ""
"OK, mister...\n"
"Let me see that rock!{end_wait}"

msgctxt "MsgVaultMyNeighborCreepsMeOutHe"
msgid "04678"
msgstr ""
"My neighbor creeps me\n"
"out. He always has that\n"
"smug smirk on his face.{end_wait}"

msgctxt "MsgVaultMisterFunSeeStrangeNew"
msgid "04679"
msgstr ""
"Hey, mister!\n"
"Is it fun to see\n"
"strange new places?{end_now}"

msgctxt "message"
msgid "04680"
msgstr ""
"When I grow up, I wanna\n"
"be an adventurer and\n"
"sleep in a tent...{end_wait}"

msgctxt "message"
msgid "04681"
msgstr ""
"Oh... If it's not fun,\n"
"then why bother?{end_wait}"

msgctxt "MsgVaultHeyMaybeMyNeighborIsThe"
msgid "04682"
msgstr ""
"Hey... Maybe my neighbor\n"
"is the thief... Yeah...{end_wait}"

msgctxt "MsgVaultWonderOutsideWorldLike"
msgid "04683"
msgstr ""
"I wonder{pause_20_skippable} what the\n"
"outside world is like...{end_wait}"

msgctxt "MsgVaultJustMeOrAmMissing"
msgid "04684"
msgstr ""
"Is it just me, or am\n"
"I missing something?{end_wait}"

msgctxt "MsgVaultEverSinceTheEruptionGrandpaKeeps"
msgid "04685"
msgstr ""
"Ever since the eruption,\n"
"Grandpa keeps wondering\n"
"if anything was stolen.{page_break}"
"He doesn't realize\n"
"we don't even have\n"
"anything worth stealing!{end_wait}"

msgctxt "MsgVaultCouldTheyThievesGoodDont"
msgid "04686"
msgstr ""
"Could they be thieves?\n"
"This is no good!{page_break}"
"I don't know who I\n"
"can trust anymore!{end_wait}"

msgctxt "MsgVaultYouNeverBoughtMeAnythingWorth"
msgid "04687"
msgstr ""
"You never bought me\n"
"anything worth stealing!{end_wait}"

msgctxt "MsgVaultCouldSomeonePleaseHelpIvan"
msgid "04688"
msgstr ""
"Could someone please\n"
"help {actor_name:3}?{end_wait}"

msgctxt "MsgVaultMyHusbandTheMayorCantBelieve"
msgid "04689"
msgstr ""
"My husband, the mayor,\n"
"can't believe anyone from\n"
"Vault could be the thief.{page_break}"
"But unless we find who\n"
"stole the rod, {actor_name:3} can't\n"
"return home to Kalay.{end_wait}"

msgctxt "MsgVaultICouldHelpIvanIfI"
msgid "04690"
msgstr ""
"I could help {actor_name:3} if\n"
"I were just a little\n"
"older.{end_wait}"

msgctxt "MsgVaultIvanHasGreatPowersWouldnt"
msgid "04691"
msgstr ""
"{actor_name:3} has great powers.\n"
"Wouldn't you like to\n"
"know what they are?{end_now}"

msgctxt "message"
msgid "04692"
msgstr ""
"No way! It's our\n"
"secret!{end_wait}"

msgctxt "message"
msgid "04693"
msgstr ""
"Don't say it if you\n"
"don't mean it, 'cause {actor_name:3}\n"
"can tell in an instant.{end_wait}"

msgctxt "MsgVaultDoPossessStrangePowers"
msgid "04694"
msgstr ""
"Yes. I... I do\n"
"possess strange powers.{end_wait}"

msgctxt "message"
msgid "04695"
msgstr ""
"You have them, too,\n"
"don't you?{end_wait}"

msgctxt "message"
msgid "04696"
msgstr ""
"What? My power{pause_20_skippable}... It's\n"
"called Psynergy?\n"
"I had no idea!{end_wait}"

msgctxt "message"
msgid "04697"
msgstr ""
"We have so much in\n"
"common... I feel I can\n"
"trust you with this.{end_wait}"

msgctxt "message"
msgid "04698"
msgstr ""
"I am quite troubled{em_dash}\n"
"Master Hammet's rod\n"
"was stolen.{end_wait}"

msgctxt "message"
msgid "04699"
msgstr ""
"Would you please help\n"
"me get my master's\n"
"rod back?{end_now}"

msgctxt "message"
msgid "04700"
msgstr ""
"I see. I suppose it's a\n"
"lot to ask of a total\n"
"stranger...{end_wait}"

msgctxt "MsgVaultWouldReallyWouldHelpMe"
msgid "04701"
msgstr ""
"Would you really?\n"
"Would you help me find\n"
"the rod?{end_now}"

msgctxt "message"
msgid "04702"
msgstr ""
"I'm sorry. I shouldn't\n"
"impose on your kindness.{end_wait}"

msgctxt "MsgVaultThankHelpBelieve"
msgid "04703"
msgstr ""
"Thank you. With your help,\n"
"I believe we can recover\n"
"the rod.{end_wait}"

msgctxt "message"
msgid "04704"
msgstr "Your names are...{end_wait}"

msgctxt "message"
msgid "04705"
msgstr ""
"{actor_name:1} and {actor_name:2}.\n"
"I am {actor_name:3}. Pleased\n"
"to meet you.{end_wait}"

msgctxt "message"
msgid "04706"
msgstr ""
"My ability to read\n"
"people's minds frightens\n"
"you, doesn't it?{end_wait}"

msgctxt "message"
msgid "04707"
msgstr ""
"Am I really...{pause_20_skippable}\n"
"Is my Mind Read so\n"
"frightening?{end_now}"

msgctxt "message"
msgid "04708"
msgstr ""
"{actor_name:3} and {actor_name:1}\n"
"clasped their hands\n"
"together.{end_wait}"

msgctxt "message"
msgid "04709"
msgstr ""
"{text_effect:4}Ahh! My mind...\n"
"Stop reading my\n"
"mind, {actor_name:3}!!!{end_wait}"

msgctxt "message"
msgid "04710"
msgstr ""
"So, {actor_name:1}...\n"
"Could you read {actor_name:2}'s\n"
"mind?{end_wait}"

msgctxt "message"
msgid "04711"
msgstr "Just as I thought.{end_wait}"

msgctxt "message"
msgid "04712"
msgstr ""
"What? You read\n"
"my mind, too,\n"
"{actor_name:1}?{end_wait}"

msgctxt "message"
msgid "04713"
msgstr ""
"I guessed that I could\n"
"help you read minds if\n"
"we shared our Psynergy.{end_wait}"

msgctxt "message"
msgid "04714"
msgstr ""
"Hey, that's not fair!\n"
"Why do you get\n"
"to read my mind?{end_wait}"

msgctxt "message"
msgid "04715"
msgstr ""
"You're right... It's not\n"
"fair to read one-way.{end_wait}"

msgctxt "message"
msgid "04716"
msgstr ""
"{actor_name:3} and {actor_name:2}\n"
"clasped their hands\n"
"together.{end_wait}"

msgctxt "message"
msgid "04717"
msgstr ""
"Whoa! I did it!\n"
"I read your mind,\n"
"{actor_name:1}!{end_wait}"

msgctxt "message"
msgid "04718"
msgstr ""
"Let's use Mind Read\n"
"to find the thieves!{end_wait}"

msgctxt "message"
msgid "04719"
msgstr ""
"Wait a second...\n"
"Won't people know that\n"
"we're using Mind Read?{end_wait}"

msgctxt "message"
msgid "04720"
msgstr ""
"Oh, I see... You two can\n"
"tell when I am using\n"
"Psynergy?{end_wait}"

msgctxt "message"
msgid "04721"
msgstr ""
"{actor_name:1}, both you and\n"
"{actor_name:2} are Adepts...{page_break}"
"Maybe that's why you\n"
"can tell when I'm\n"
"reading your minds.{end_wait}"

msgctxt "message"
msgid "04722"
msgstr ""
"Ordinary people can't\n"
"see anything. There's\n"
"nothing to worry about.{end_wait}"

msgctxt "message"
msgid "04723"
msgstr ""
"Don't worry...\n"
"I will not read your\n"
"minds again.{end_wait}"

msgctxt "message"
msgid "04724"
msgstr ""
"{actor_name:3} joined your\n"
"party!{end_wait}"

msgctxt "message"
msgid "04725"
msgstr ""
"Let me read the minds\n"
"of the townspeople to\n"
"find the rod.{end_wait}"

msgctxt "MsgVaultYoureGoingHelpIvan"
msgid "04726"
msgstr ""
"Oh? You're going to\n"
"help {actor_name:3}?{end_wait}"

msgctxt "message"
msgid "04727"
msgstr "Thank you.{end_wait}"

msgctxt "MsgVaultPleaseLookAfterIvan"
msgid "04728"
msgstr "Please look after {actor_name:3}.{end_wait}"

msgctxt "MsgVaultReallyYoureGoingToHelpIvan"
msgid "04729"
msgstr ""
"Really? You're going to\n"
"help {actor_name:3} in his\n"
"search for the rod?{page_break}"
"I'm so relieved\n"
"to hear that.{end_wait}"

msgctxt "MsgVaultYoureHelpingIvanYouDontLook"
msgid "04730"
msgstr ""
"You're helping {actor_name:3}?{page_break}"
"You don't look very\n"
"reliable, but at least\n"
"he won't be alone.{end_wait}"

msgctxt "MsgVaultSinceYoureHelpingIvanIllTell"
msgid "04731"
msgstr ""
"Since you're helping\n"
"{actor_name:3}, I'll tell you a\n"
"secret...{page_break}"
"{actor_name:3} has the power\n"
"to talk with animals!\n"
"...Isn't that neat?{end_wait}"

msgctxt "MsgVaultTicklesBeingTickledByBoy"
msgid "04732"
msgstr ""
"Hey! That tickles...\n"
"Being tickled by a\n"
"boy isn't so fun.{end_wait}"

msgctxt "MsgVaultMaybeTheyllFindOurStolenFamily"
msgid "04733"
msgstr ""
"Maybe they'll find our\n"
"stolen family heirloom\n"
"while they're looking.{page_break}"
"I miss that old urn.{end_wait}"

msgctxt "MsgVaultTheseGuysLookReliableIGuess"
msgid "04734"
msgstr ""
"These guys look reliable{pause_20_skippable},\n"
"I guess. {actor_name:3}'s pretty\n"
"lucky!{end_wait}"

msgctxt "MsgVaultIWonderWhatSortOfThing"
msgid "04735"
msgstr ""
"I wonder what sort of\n"
"thing an animal would say.\n"
"I wish I had that power!{end_wait}"

msgctxt "MsgVaultMasterHammetIsntOnlyOne"
msgid "04736"
msgstr ""
"Master Hammet isn't the\n"
"only one who had\n"
"things stolen.{page_break}"
"We lost a lot of\n"
"expensive goods.{end_wait}"

msgctxt "MsgVaultAllOurBestWeaponsWereStolen"
msgid "04737"
msgstr ""
"All our best weapons\n"
"were stolen...{page_break}"
"I'm sorry I've only\n"
"got these cheap weapons\n"
"to sell right now.{end_wait}"

msgctxt "MsgVaultThievesDidntHitOurHouse"
msgid "04738"
msgstr ""
"The thieves didn't hit our\n"
"house during the eruption,\n"
"but I'm still angry.{page_break}"
"Once we find those\n"
"thieves, we're going\n"
"to make them pay.{end_wait}"

msgctxt "MsgVaultIWonderIfTheyLeftUs"
msgid "04739"
msgstr ""
"I wonder if they left us\n"
"alone because we don't\n"
"carry any valuable armor?{end_wait}"

msgctxt "MsgVaultDidJustArriveInTown"
msgid "04740"
msgstr ""
"Did you just arrive\n"
"in town today?{end_now}"

msgctxt "message"
msgid "04741"
msgstr ""
"Then I suppose you're\n"
"not the thieves.{end_wait}"

msgctxt "message"
msgid "04742"
msgstr ""
"Hmm...{pause_20_skippable} Something's fishy...{pause_20_skippable}\n"
"You{pause_20_skippable} thieves...{end_wait}"

msgctxt "MsgVaultHahhWereSureToSeeA"
msgid "04743"
msgstr ""
"Hahh... We're sure to see\n"
"a drop in business\n"
"after this eruption.{end_wait}"

msgctxt "MsgSanctumWeWillHelpAnytimeAs"
msgid "04744"
msgstr ""
"We will help you anytime,\n"
"as long as you are\n"
"pure of heart.{end_wait}"

msgctxt "MsgSanctumHealerMustWorriedAboutNever"
msgid "04745"
msgstr ""
"The healer must be\n"
"worried about...{page_break}"
"Oh, never mind.\n"
"It's not your\n"
"problem.{end_wait}"

msgctxt "message"
msgid "04746"
msgstr ""
"If you can ease your\n"
"anxieties like that,\n"
"then go right ahead...{end_wait}"

msgctxt "MsgSanctumWonderIfEverSeeOur"
msgid "04747"
msgstr ""
"I wonder if we'll ever\n"
"see our stolen gold\n"
"statue again...{end_wait}"

msgctxt "MsgVaultTheGuestsUpstairsWerentInTheir"
msgid "04748"
msgstr ""
"The guests upstairs\n"
"weren't in their room\n"
"during the eruption.{page_break}"
"We searched the room\n"
"afterwards, but we\n"
"couldn't find anything.{end_wait}"

msgctxt "MsgVaultEveryoneThinksOurGuestsThieves"
msgid "04749"
msgstr ""
"Everyone thinks our\n"
"guests are the thieves,{page_break}"
"but I think it's unfair\n"
"to accuse them without\n"
"any evidence.{page_break}"
"Sure, they look suspicious,\n"
"but they've been quite\n"
"polite. And they paid cash!{end_wait}"

msgctxt "MsgVaultThoseThreeStrangersSureHave"
msgid "04750"
msgstr ""
"Those three strangers\n"
"sure have fooled the\n"
"innkeeper and his wife.{page_break}"
"They're the type of people\n"
"who think they can\n"
"get away with anything.{end_wait}"

msgctxt "MsgVaultAFieryRockBurntAHole"
msgid "04751"
msgstr ""
"A fiery rock burnt a\n"
"hole through the roof.{page_break}"
"Sheesh! It's always me\n"
"who has to take care\n"
"of these things!{end_wait}"

msgctxt "MsgVaultThatKidIvanHeCreepsMe"
msgid "04752"
msgstr ""
"That kid {actor_name:3}...\n"
"He creeps me out...{page_break}"
"He just came and\n"
"grabbed my arm...{page_break}"
"I shook him off because\n"
"he made me uncomfortable.{end_wait}"

msgctxt "MsgVaultWeHaventDoneAnythingYoureA"
msgid "04753"
msgstr ""
"We haven't done\n"
"anything. You're a\n"
"terrible person if you{page_break}"
"start accusing people\n"
"for no good reason.{end_wait}"

msgctxt "MsgVaultItWouldBeAwfulIfOur"
msgid "04754"
msgstr ""
"It would be awful if\n"
"our guests turned out\n"
"to be the thieves!{end_wait}"

msgctxt "MsgVaultThatVolcanoCostUsALot"
msgid "04755"
msgstr ""
"That volcano cost us a\n"
"lot of business, and\n"
"now this robbery!{page_break}"
"Those three are paying\n"
"us a lot of money.{page_break}"
"I'll stick up for\n"
"them if there's\n"
"any trouble.{end_wait}"

msgctxt "MsgVaultMasterHisWifeBlindedBy"
msgid "04756"
msgstr ""
"The master and his wife\n"
"are blinded by money.{page_break}"
"They'll be in trouble if\n"
"they don't help search\n"
"for the thieves.{end_wait}"

msgctxt "MsgVaultFixTheRoofWhyPayFor"
msgid "04757"
msgstr ""
"Fix the roof...?{page_break}"
"Why pay for a carpenter\n"
"when I can just hammer\n"
"it a bit myself?{end_wait}"

msgctxt "MsgVaultWant"
msgid "04758"
msgstr "What do you want?{end_wait}"

msgctxt "message"
msgid "04759"
msgstr ""
"It looks like that\n"
"weird kid is with them!{end_wait}"

msgctxt "message"
msgid "04760"
msgstr ""
"I can't stand him.\n"
"Don't let him near\n"
"me!{end_wait}"

msgctxt "MsgVaultTheyreActingSuspiciousSomethingsNot"
msgid "04761"
msgstr ""
"They're acting\n"
"suspicious. Something's\n"
"not right...{end_wait}"

msgctxt "message"
msgid "04762"
msgstr ""
"But you can't use Mind\n"
"Read if they keep running\n"
"away, can you?{end_now}"

msgctxt "message"
msgid "04763"
msgstr ""
"Isn't there any way I\n"
"can catch them?{end_wait}"

msgctxt "message"
msgid "04764"
msgstr ""
"There should be a way\n"
"to read them, but how?{end_wait}"

msgctxt "message"
msgid "04765"
msgstr ""
"Maybe the three of us\n"
"can surround one of them.{end_wait}"

msgctxt "message"
msgid "04766"
msgstr ""
"Don't worry! This is\n"
"going to work!{end_wait}"

msgctxt "MsgVaultIsaacTakeLead"
msgid "04767"
msgstr ""
"{actor_name:1}, you take\n"
"the lead.{end_wait}"

msgctxt "MsgVaultTheyreBack"
msgid "04768"
msgstr "Hey, they're back!{end_wait}"

msgctxt "message"
msgid "04769"
msgstr ""
"Uh-oh! They're comin' for\n"
"us one-on-one!{end_wait}"

msgctxt "message"
msgid "04770"
msgstr ""
"Do whatever it takes...\n"
"Just keep away from\n"
"them, like before!{end_wait}"

msgctxt "MsgVaultTheresNowhereRun"
msgid "04771"
msgstr "There's nowhere to run!{end_wait}"

msgctxt "MsgVaultImSurrounded"
msgid "04772"
msgstr "Uh-oh! I'm surrounded!{end_wait}"

msgctxt "MsgVaultNowIvan"
msgid "04773"
msgstr "Now, {actor_name:3}!{end_wait}"

msgctxt "message"
msgid "04774"
msgstr "A-All right!{end_wait}"

msgctxt "message"
msgid "04775"
msgstr ""
"Wha-What is this?\n"
"What is he doing?!{end_wait}"

msgctxt "message"
msgid "04776"
msgstr ""
"He shut his eyes...\n"
"What's he doin'?{end_wait}"

msgctxt "message"
msgid "04777"
msgstr "Are you done, {actor_name:3}?{end_wait}"

msgctxt "message"
msgid "04778"
msgstr ""
"You creepy freaks...\n"
"You'll never come near\n"
"me again!{end_wait}"

msgctxt "message"
msgid "04779"
msgstr "Scram! Get outta here!{end_wait}"

msgctxt "MsgVaultOwStop"
msgid "04780"
msgstr "Ow! Stop it!{end_wait}"

msgctxt "MsgVaultNoLeaveAlone"
msgid "04781"
msgstr "No! Leave me alone!{end_wait}"

msgctxt "MsgVaultLearn"
msgid "04782"
msgstr ""
"What did you\n"
"learn, {actor_name:3}?{end_wait}"

msgctxt "message"
msgid "04783"
msgstr ""
"It's them, all right.\n"
"I think they took a\n"
"lot of other things, too.{end_wait}"

msgctxt "message"
msgid "04784"
msgstr ""
"It looks like they're\n"
"hiding it all somewhere\n"
"in this inn...{end_wait}"

msgctxt "message"
msgid "04785"
msgstr ""
"But they won't let\n"
"me near them again.{end_wait}"

msgctxt "message"
msgid "04786"
msgstr ""
"Then, I guess we have\n"
"no other choice{em_dash}we have\n"
"to search the inn...{end_now}"

msgctxt "message"
msgid "04787"
msgstr ""
"It's a lot to cover,\n"
"but we're the only ones\n"
"who can do it, right?{end_now}"

msgctxt "message"
msgid "04788"
msgstr ""
"Please, {actor_name:1}...\n"
"I beg you...{end_now}"

msgctxt "message"
msgid "04789"
msgstr "It cannot be done...?{end_wait}"

msgctxt "message"
msgid "04790"
msgstr "Don't worry, {actor_name:3}.{end_wait}"

msgctxt "message"
msgid "04791"
msgstr ""
"He's just saying no\n"
"because he doesn't feel\n"
"confident...{end_wait}"

msgctxt "message"
msgid "04792"
msgstr ""
"But when it really comes\n"
"down to it, he'll help.\n"
"It's just the way he is.{end_wait}"

msgctxt "message"
msgid "04793"
msgstr ""
"I trust your sense of\n"
"duty!{end_wait}"

msgctxt "message"
msgid "04794"
msgstr ""
"Well, if that's the case,\n"
"then let's go, {actor_name:3}.{end_wait}"

msgctxt "MsgVaultWeDontHaveTimeFor"
msgid "04795"
msgstr ""
"We don't have time for\n"
"that, {actor_name:1}!{end_wait}"

msgctxt "MsgVaultLeave"
msgid "04796"
msgstr "Leave it to us!{end_wait}"

msgctxt "message"
msgid "04797"
msgstr ""
"{actor_name:1} always comes\n"
"through!{end_wait}"

msgctxt "message"
msgid "04798"
msgstr ""
"I trust your\n"
"sense of duty!{end_wait}"

msgctxt "message"
msgid "04799"
msgstr ""
"Well, it's decided.\n"
"Let's go, {actor_name:3}.{end_wait}"

msgctxt "MsgVaultFixingRoofCant"
msgid "04800"
msgstr ""
"He should be fixing the\n"
"roof now, but I can't find\n"
"him anywhere...{page_break}"
"He's probably in back,\n"
"slacking off again.{end_wait}"

msgctxt "MsgVaultSneakWastingTime"
msgid "04801"
msgstr ""
"That sneak...\n"
"He's just wasting time\n"
"instead of fixing the roof!{end_wait}"

msgctxt "message"
msgid "04802"
msgstr ""
"Wow! {actor_name:1}'s Psynergy\n"
"can move things, huh?\n"
"That's incredible...{end_wait}"

msgctxt "MsgVaultUhnnUhnn"
msgid "04803"
msgstr "Uhnn... Uhnn...{end_wait}"

msgctxt "MsgVaultAhhHelpMe"
msgid "04804"
msgstr "Ahh! Help me...{end_wait}"

msgctxt "MsgVaultVaultCutFree"
msgid "04805"
msgstr ""
"{protagonist_name} cut him free\n"
"from the ropes.{end_wait}"

msgctxt "message"
msgid "04806"
msgstr ""
"I came into this loft\n"
"while I was fixing the\n"
"roof...{end_wait}"

msgctxt "message"
msgid "04807"
msgstr ""
"But I found I couldn't\n"
"get all the way to\n"
"the back of the loft...{page_break}"
"So I was looking into it\n"
"when{pause_20_skippable} WHAM!{end_wait}"

msgctxt "message"
msgid "04808"
msgstr ""
"Someone whacked me in\n"
"the head from behind!{page_break}"
"When I came to, I was all\n"
"tied up.{end_wait}"

msgctxt "message"
msgid "04809"
msgstr ""
"Strange... I don't\n"
"remember all these crates\n"
"being up here before!{end_wait}"

msgctxt "message"
msgid "04810"
msgstr ""
"Maybe all that stolen\n"
"stuff is in these crates...{end_wait}"

msgctxt "message"
msgid "04811"
msgstr ""
"Looks like we've been\n"
"found out!{end_wait}"

msgctxt "message"
msgid "04812"
msgstr ""
"You're pretty persistent\n"
"for one of Hammet's\n"
"whelps, kid!{end_wait}"

msgctxt "message"
msgid "04813"
msgstr ""
"Why are you working\n"
"so hard for Hammet?\n"
"What's it to you?{end_wait}"

msgctxt "message"
msgid "04814"
msgstr ""
"Anyway, Hammet's already\n"
"been caught by a worse\n"
"bunch of thieves than us!{end_wait}"

msgctxt "message"
msgid "04815"
msgstr ""
"I hear Hammet fled\n"
"to Lunpa after the\n"
"eruption.{end_wait}"

msgctxt "message"
msgid "04816"
msgstr "Did you say Lunpa!?{end_wait}"

msgctxt "message"
msgid "04817"
msgstr ""
"A man with Master\n"
"Hammet's money shouldn't\n"
"go anywhere NEAR Lunpa!{end_wait}"

msgctxt "message"
msgid "04818"
msgstr ""
"What kind of place\n"
"is Lunpa?{end_wait}"

msgctxt "message"
msgid "04819"
msgstr ""
"The town was named after\n"
"its founder, Lunpa,\n"
"the noble thief...{end_wait}"

msgctxt "message"
msgid "04820"
msgstr ""
"That family of thieves\n"
"remained noble even when\n"
"his son, Donpa, took over.{end_wait}"

msgctxt "message"
msgid "04821"
msgstr ""
"But Donpa's son,\n"
"Dodonpa, is\n"
"an evil thief.{end_wait}"

msgctxt "message"
msgid "04822"
msgstr ""
"The man has no morals.\n"
"I've heard he's truly\n"
"vicious.{end_wait}"

msgctxt "message"
msgid "04823"
msgstr ""
"See, we're not so\n"
"bad. How about it?\n"
"Will you let us go?{end_now}"

msgctxt "message"
msgid "04824"
msgstr ""
"Seriously? If we return\n"
"all the stolen goods and\n"
"repent, you'll let us go?{end_wait}"

msgctxt "message"
msgid "04825"
msgstr ""
"You must be joking!\n"
"We stole this stuff fair\n"
"and square!{end_wait}"

msgctxt "message"
msgid "04826"
msgstr ""
"We'll just have to\n"
"keep you quiet!{end_wait}"

msgctxt "message"
msgid "04827"
msgstr ""
"And there's only one\n"
"way to do that!\n"
"Get 'em!!!{end_wait}"

msgctxt "MsgVaultVaultThievesCaught"
msgid "04828"
msgstr ""
"What? You mean, even\n"
"if we return everything\n"
"we stole and apologize,{page_break}"
"it's still a crime?{end_wait}"

msgctxt "MsgVaultTheseKidsNothingWorryAbout"
msgid "04829"
msgstr ""
"These kids are nothing\n"
"to worry about.{end_wait}"

msgctxt "message"
msgid "04830"
msgstr "{text_effect:4}Uhnn... Ohh...{end_wait}"

msgctxt "message"
msgid "04831"
msgstr ""
"You'll stay here as\n"
"our hostages!{end_wait}"

msgctxt "message"
msgid "04832"
msgstr ""
"Keep your mouth shut\n"
"if you want to help\n"
"him!{end_wait}"

msgctxt "MsgVaultWontGoAway"
msgid "04833"
msgstr ""
"They won't go away,\n"
"will they? They're back!{end_wait}"

msgctxt "message"
msgid "04834"
msgstr ""
"We'll just have to\n"
"punish them again!{end_wait}"

msgctxt "message"
msgid "04835"
msgstr ""
"We'll make you sorry\n"
"you were ever born!\n"
"Get em!!{end_wait}"

msgctxt "MsgVaultTheyTheyGotUs"
msgid "04836"
msgstr "They...{pause_20_skippable} They got us...{end_wait}"

msgctxt "message"
msgid "04837"
msgstr ""
"Actually, for a second\n"
"there, I thought we\n"
"were goners...{end_wait}"

msgctxt "message"
msgid "04838"
msgstr "Wow! We won!{end_wait}"

msgctxt "message"
msgid "04839"
msgstr ""
"I...\n"
"I'll get the mayor!{end_wait}"

msgctxt "message"
msgid "04840"
msgstr ""
"After all the trouble\n"
"we went to, stealing\n"
"all this stuff...{end_wait}"

msgctxt "message"
msgid "04841"
msgstr ""
"Haven't you heard?\n"
"Stealing from others is\n"
"wrong!{end_wait}"

msgctxt "message"
msgid "04842"
msgstr ""
"Sheesh! I told you...\n"
"I told you we should\n"
"have skipped town...{end_wait}"

msgctxt "message"
msgid "04843"
msgstr "Evil never prevails!{end_wait}"

msgctxt "message"
msgid "04844"
msgstr ""
"If you'll give me\n"
"Master Hammet's rod, I'll\n"
"head to Lunpa now.{end_wait}"

msgctxt "message"
msgid "04845"
msgstr ""
"What will you two be\n"
"doing, {actor_name:1}?{end_wait}"

msgctxt "message"
msgid "04846"
msgstr ""
"I suppose we have to\n"
"go after {actor_name:5} and\n"
"the others...{end_wait}"

msgctxt "message"
msgid "04847"
msgstr ""
"He's reading our minds\n"
"again! Shouldn't we\n"
"stop him?{end_now}"

msgctxt "message"
msgid "04848"
msgstr ""
"It's too late, {actor_name:1}.\n"
"He's already done.{end_wait}"

msgctxt "message"
msgid "04849"
msgstr "If you say so, {actor_name:1}...{end_wait}"

msgctxt "MsgVaultSeeThatsHappened"
msgid "04850"
msgstr ""
"I see...\n"
"So that's what happened...{end_wait}"

msgctxt "message"
msgid "04851"
msgstr ""
"These are the thieves,\n"
"Mayor...{end_wait}"

msgctxt "message"
msgid "04852"
msgstr ""
"What you did was horrid.\n"
"Stealing? In the middle of\n"
"a disaster!?!{end_wait}"

msgctxt "message"
msgid "04853"
msgstr ""
"Hey, you're the ones who\n"
"left all your doors open!{page_break}"
"You were practically\n"
"begging us to{em_dash}OUCH!{end_wait}"

msgctxt "message"
msgid "04854"
msgstr ""
"Sorry... I couldn't\n"
"help myself...{end_wait}"

msgctxt "message"
msgid "04855"
msgstr ""
"What should we do\n"
"with them?{end_wait}"

msgctxt "message"
msgid "04856"
msgstr ""
"We're going to lock\n"
"them up for a long,\n"
"long time.{end_wait}"

msgctxt "message"
msgid "04857"
msgstr "Hey, wake up!{end_wait}"

msgctxt "message"
msgid "04858"
msgstr "Let's go{em_dash}get up! Get up!{end_wait}"

msgctxt "message"
msgid "04859"
msgstr ""
"Hey, can you help me\n"
"tie them up?{end_wait}"

msgctxt "MsgVaultYouIsaacRightWontForget"
msgid "04860"
msgstr ""
"Hey, you! {actor_name:1}, right?\n"
"I won't forget this!{end_wait}"

msgctxt "message"
msgid "04861"
msgstr "Take them away!{end_wait}"

msgctxt "message"
msgid "04862"
msgstr ""
"Thank you for catching\n"
"the thieves! You have\n"
"our sincerest gratitude.{end_wait}"

msgctxt "message"
msgid "04863"
msgstr ""
"Really, you were\n"
"a big help!{end_wait}"

msgctxt "message"
msgid "04864"
msgstr ""
"Let's take a look\n"
"at what they stole.{end_wait}"

msgctxt "message"
msgid "04865"
msgstr ""
"Found the mayor's\n"
"precious urn.{end_wait}"

msgctxt "message"
msgid "04866"
msgstr ""
"Mayor... Isn't that\n"
"your family's urn?{end_wait}"

msgctxt "message"
msgid "04867"
msgstr ""
"My precious urn\n"
"has been returned.{end_wait}"

msgctxt "message"
msgid "04868"
msgstr "Found a gold statue.{end_wait}"

msgctxt "message"
msgid "04869"
msgstr ""
"Hey, that belongs in the...\n"
"They stole from our\n"
"Sanctum? Those monsters!{end_wait}"

msgctxt "message"
msgid "04870"
msgstr ""
"The town's treasures...\n"
"They're back at last.{end_wait}"

msgctxt "message"
msgid "04871"
msgstr ""
"Mayor, we found another\n"
"chest over here, you see?{end_wait}"

msgctxt "message"
msgid "04872"
msgstr ""
"{actor_name:3}, isn't this what\n"
"you were looking for?{end_wait}"

msgctxt "message"
msgid "04873"
msgstr ""
"Now, you can return to\n"
"Master Hammet!{end_wait}"

msgctxt "message"
msgid "04874"
msgstr ""
"That's right! I heard that\n"
"Master Hammet was seen\n"
"heading toward Lunpa!{end_wait}"

msgctxt "message"
msgid "04875"
msgstr ""
"Oh no... Dodonpa\n"
"wouldn't miss an\n"
"opportunity like that...{end_wait}"

msgctxt "message"
msgid "04876"
msgstr ""
"I'm certain that\n"
"your master has\n"
"been{pause_20_skippable} kidnapped.{end_wait}"

msgctxt "message"
msgid "04877"
msgstr ""
"How can I rescue\n"
"Master Hammet?{end_wait}"

msgctxt "message"
msgid "04878"
msgstr ""
"No one can enter once\n"
"the gates are closed.{end_wait}"

msgctxt "message"
msgid "04879"
msgstr ""
"What will happen\n"
"to Master Hammet?{end_wait}"

msgctxt "message"
msgid "04880"
msgstr ""
"Calm down, {actor_name:3}. Master\n"
"Hammet is probably\n"
"still alive and unharmed.{end_wait}"

msgctxt "message"
msgid "04881"
msgstr ""
"Dodonpa knows that he\n"
"can use Hammet to extort\n"
"a ransom from Kalay.{end_wait}"

msgctxt "message"
msgid "04882"
msgstr ""
"We can't do much until\n"
"Dodonpa makes his move,{page_break}"
"but at least we know\n"
"Hammet's safe...for now.{end_wait}"

msgctxt "message"
msgid "04883"
msgstr ""
"Your name is {actor_name:1},\n"
"right?{end_wait}"

msgctxt "message"
msgid "04884"
msgstr "And you are...{end_wait}"

msgctxt "message"
msgid "04885"
msgstr "It's {actor_name:2}.{end_wait}"

msgctxt "message"
msgid "04886"
msgstr ""
"Thank you both.\n"
"You have my deepest\n"
"gratitude.{end_wait}"

msgctxt "message"
msgid "04887"
msgstr "Well. Let's go then.{end_wait}"

msgctxt "message"
msgid "04888"
msgstr ""
"Before you leave town,\n"
"please come see me.\n"
"I have something for you.{end_wait}"

msgctxt "message"
msgid "04889"
msgstr ""
"What a mess...\n"
"We finally get the rod\n"
"back, and now this.{end_wait}"

msgctxt "message"
msgid "04890"
msgstr ""
"I wish I could cheer\n"
"you up... You look\n"
"so depressed...{end_wait}"

msgctxt "message"
msgid "04891"
msgstr ""
"I just want to rescue\n"
"Master Hammet...\n"
"That's all...{end_wait}"

msgctxt "message"
msgid "04892"
msgstr ""
"But I couldn't ask you\n"
"two to help me.{end_wait}"

msgctxt "message"
msgid "04893"
msgstr ""
"You have a very...\n"
"important mission,\n"
"right?{end_wait}"

msgctxt "message"
msgid "04894"
msgstr ""
"That's right. I saw it\n"
"in your minds.{end_wait}"

msgctxt "message"
msgid "04895"
msgstr ""
"I had no idea that\n"
"the volcano's eruption\n"
"held such a secret!{end_wait}"

msgctxt "message"
msgid "04896"
msgstr ""
"Yes, we have to find\n"
"{actor_name:5} and his gang,\n"
"or we'll all be in trouble.{end_wait}"

msgctxt "message"
msgid "04897"
msgstr ""
"Then, I suppose this\n"
"is good-bye, then.{end_now}"

msgctxt "message"
msgid "04898"
msgstr ""
"{actor_name:1} said he\n"
"would help you, {actor_name:3}...{end_wait}"

msgctxt "message"
msgid "04899"
msgstr ""
"No, you've already done\n"
"so much for me. I couldn't\n"
"impose on you any further.{end_wait}"

msgctxt "MsgVaultIvanGotShamansRod"
msgid "04900"
msgstr ""
"{actor_name:3} got the\n"
"Shaman's Rod.{end_wait}"

msgctxt "message"
msgid "04901"
msgstr ""
"I shall never forget\n"
"this town's hospitality...\n"
"I wish you all the best.{end_wait}"

msgctxt "message"
msgid "04902"
msgstr ""
"Well, I guess we'd\n"
"better get moving, too.{end_wait}"

msgctxt "MsgVaultLeavingImStillWorriedAbout"
msgid "04903"
msgstr ""
"Are you leaving?\n"
"I'm still worried\n"
"about the rod,{page_break}"
"so I'll just wait here\n"
"until you two return.{end_wait}"

msgctxt "MsgVaultWelcomeBackTwo"
msgid "04904"
msgstr ""
"Welcome back, you two!\n"
"Let's go find the rod!{end_wait}"

msgctxt "message"
msgid "04905"
msgstr ""
"What? It's still a crime,\n"
"even if we return\n"
"everything...{page_break}"
"AND we're really,\n"
"really sorry?{end_wait}"

msgctxt "MsgVaultWaitDontWantTakeYour"
msgid "04906"
msgstr ""
"Oh, wait, I don't want to\n"
"take your Djinni.{page_break}"
"I'll just leave it\n"
"with {actor_name:1}.\n"
"Hurry back!{end_wait}"

msgctxt "MsgVaultDidYouSeeSomethingStrangeOver"
msgid "04907"
msgstr ""
"Did you see something\n"
"strange over there?\n"
"I fought it, but it fled.{page_break}"
"When I returned, I saw\n"
"it again... I wonder\n"
"if it likes this place.{end_wait}"

msgctxt "MsgVaultHmmmItMustBeHidingSomewhere"
msgid "04908"
msgstr ""
"Hmmm...\n"
"It must be hiding\n"
"somewhere again...{end_wait}"

msgctxt "MsgVaultItJustWhackedMeInThe"
msgid "04909"
msgstr ""
"It just whacked me\n"
"in the head and\n"
"then ran away...{page_break}"
"Next time I see it,\n"
"I'll be the one doing\n"
"the whacking.{end_wait}"

msgctxt "MsgVaultIKnowitsKindItllBeBack"
msgid "04910"
msgstr ""
"I knowits kind...\n"
"It'll be back,\n"
"sooner or later.{end_wait}"

msgctxt "MsgGomaGotWowThatsPrettyImpressive"
msgid "04911"
msgstr ""
"You got it?\n"
"Wow, that's pretty\n"
"impressive!{page_break}"
"Keep your eyes peeled\n"
"for others like it.{end_wait}"

msgctxt "MsgVaultYoureHittingRoadAgain"
msgid "04912"
msgstr ""
"So, you're hitting\n"
"the road again?{end_now}"

msgctxt "message"
msgid "04913"
msgstr ""
"Well, you'll always be\n"
"welcome here in Vault!{end_wait}"

msgctxt "message"
msgid "04914"
msgstr ""
"Ha! You say that now,\n"
"but you'll leave anyway,\n"
"right?{end_wait}"

msgctxt "MsgVaultSmokeIsStillRisingFromMt"
msgid "04915"
msgstr ""
"Smoke is still rising from\n"
"Mt. Aleph... I think\n"
"it might erupt again.{end_wait}"

msgctxt "MsgVaultMasterHammetTheWealthyMerchantI"
msgid "04916"
msgstr ""
"Master Hammet, the\n"
"wealthy merchant... I hear\n"
"he never reached Kalay.{end_wait}"

msgctxt "MsgVaultGreatCaughtThieves"
msgid "04917"
msgstr ""
"It's great that you\n"
"caught those thieves!{end_wait}"

msgctxt "MsgVaultTalkingAboutHammetsServantIvan"
msgid "04918"
msgstr ""
"Are you talking about\n"
"Hammet's servant, {actor_name:3}?\n"
"He went out to Lunpa.{end_wait}"

msgctxt "message"
msgid "04919"
msgstr ""
"I see, {actor_name:3}... I guess\n"
"it was impossible to\n"
"rescue Master Hammet.{end_wait}"

msgctxt "MsgVaultEruptionDevastatedRoads"
msgid "04920"
msgstr ""
"The eruption devastated\n"
"roads throughout Angara...{page_break}"
"When the southern bridge\n"
"is repaired, you can\n"
"head toward Kalay...{end_wait}"

msgctxt "MsgVaultDidntGoLunpa"
msgid "04921"
msgstr ""
"{actor_name:3} didn't go to\n"
"Lunpa all alone,\n"
"did he?{end_wait}"

msgctxt "message"
msgid "04922"
msgstr ""
"Heh heh... I shouldn't have\n"
"worried about {actor_name:3}...{page_break}"
"When did he join up\n"
"with you, {actor_name:1}?{end_wait}"

msgctxt "MsgVaultEveryoneGratefulCaptured"
msgid "04923"
msgstr ""
"Everyone is very\n"
"grateful that you\n"
"captured the thieves!{end_wait}"

msgctxt "MsgVaultThoseMenCapturedTheyreIn"
msgid "04924"
msgstr ""
"Those men you captured...\n"
"They're in jail now?{end_now}"

msgctxt "message"
msgid "04925"
msgstr ""
"It's been a long time\n"
"since we had to use\n"
"our prison.{end_wait}"

msgctxt "message"
msgid "04926"
msgstr ""
"They're just upset, saying\n"
"all kinds of nasty things.\n"
"It's sad, really...{page_break}"
"Maybe you should go\n"
"see them.{end_wait}"

msgctxt "MsgVaultOnesWhoCapturedThieves"
msgid "04927"
msgstr ""
"Are you the ones who\n"
"captured the thieves?{end_now}"

msgctxt "message"
msgid "04928"
msgstr ""
"I just wish more young\n"
"people had your sense\n"
"of honor.{end_wait}"

msgctxt "message"
msgid "04929"
msgstr ""
"So brave, and\n"
"yet so humble!{page_break}"
"I wish all young people\n"
"would learn from your\n"
"humility.{end_wait}"

msgctxt "MsgVaultRuffRrruff2"
msgid "04930"
msgstr "Ruff!{pause_20_skippable} Rrruff!!{end_wait}"

msgctxt "MsgVaultYouveMadeOurTownPeacefulAt"
msgid "04931"
msgstr ""
"You've made our town\n"
"peaceful at last...{page_break}"
"I wish you could stay\n"
"here forever.{end_wait}"

msgctxt "MsgVaultNowMtAlephHasCalmedDown"
msgid "04932"
msgstr ""
"Now Mt. Aleph has calmed\n"
"down a little, I'm going to\n"
"climb up into the crater!{end_wait}"

msgctxt "MsgVaultOfAllThePlacesWhyWould"
msgid "04933"
msgstr ""
"Of all the places...\n"
"Why would Master Hammet\n"
"go to a town like Lunpa?{page_break}"
"I can't understand\n"
"how rich people think...{end_wait}"

msgctxt "MsgVaultHowPunishPrisoners"
msgid "04934"
msgstr ""
"How should we\n"
"punish our prisoners?{page_break}"
"Public humiliation?\n"
"Or perhaps a beating!{end_wait}"

msgctxt "MsgVaultNobodyGetsIntoLunpaExceptFor"
msgid "04935"
msgstr ""
"Nobody gets into Lunpa\n"
"except for thieves\n"
"and their victims.{page_break}"
"You should just give\n"
"up on rescuing Hammet.{end_wait}"

msgctxt "MsgVaultWithRoadOutOnlyWay"
msgid "04936"
msgstr ""
"With the road out, the\n"
"only way out is through\n"
"the cave in Goma Range.{end_wait}"

msgctxt "MsgVaultWhereDidIvanGoBy"
msgid "04937"
msgstr ""
"Where did {actor_name:3} go\n"
"all by himself?\n"
"I'm so worried...{end_wait}"

msgctxt "message"
msgid "04938"
msgstr ""
"But when did they\n"
"join {actor_name:3}?{end_wait}"

msgctxt "MsgVaultMustStrongerThanLookHave"
msgid "04939"
msgstr ""
"You must be stronger\n"
"than you look to have\n"
"captured those thieves.{end_wait}"

msgctxt "MsgVaultFeelMuchBetter"
msgid "04940"
msgstr ""
"I feel much better\n"
"now that those thieves\n"
"are behind bars!{end_wait}"

msgctxt "MsgVaultThereIsAlwaysAFightWhen"
msgid "04941"
msgstr ""
"There is always a fight\n"
"when capturing thieves.{page_break}"
"I don't really care\n"
"for danger like that...{end_wait}"

msgctxt "MsgVaultIfBringMeBoneIll"
msgid "04942"
msgstr ""
"If you bring me a\n"
"bone, I'll tell you\n"
"something useful.{end_wait}"

msgctxt "message"
msgid "04943"
msgstr "Awwww!!{end_wait}"

msgctxt "message"
msgid "04944"
msgstr "Ruff ruff ruff!!!{end_wait}"

msgctxt "message"
msgid "04945"
msgstr ""
"How did you know I\n"
"wanted one of these?{end_wait}"

msgctxt "MsgVaultICanSleepWellNowThat"
msgid "04946"
msgstr ""
"I can sleep well,\n"
"now that the thieves\n"
"have been locked up.{page_break}"
"I kept worrying that\n"
"they would take my gem.{end_wait}"

msgctxt "MsgVaultThankGoodnessThoseThievesWere"
msgid "04947"
msgstr ""
"Thank goodness those\n"
"thieves were captured\n"
"before they stole our gem.{end_wait}"

msgctxt "MsgVaultEverybodysAfterMyRockTheyWant"
msgid "04948"
msgstr ""
"Everybody's after my\n"
"rock! They want it\n"
"for themselves!{page_break}"
"I can't let my guard\n"
"down for a second!{end_wait}"

msgctxt "MsgVaultIfRockWorthlessMaybeThats"
msgid "04949"
msgstr ""
"What if that rock is\n"
"worthless? Maybe that's\n"
"why they didn't steal it.{end_wait}"

msgctxt "MsgVaultDidThoseThievesComeFrom"
msgid "04950"
msgstr ""
"Did those thieves\n"
"come from Lunpa?{end_now}"

msgctxt "message"
msgid "04951"
msgstr ""
"The town's master is\n"
"Dodonpa, the grandson\n"
"of Lunpa himself!{page_break}"
"He's an awful man, and\n"
"capturing his thieves\n"
"can only mean trouble.{end_wait}"

msgctxt "message"
msgid "04952"
msgstr ""
"The Lunpans were noble\n"
"thieves under the rule\n"
"of Lunpa's son, Donpa.{page_break}"
"It's all Dodonpa's fault\n"
"that they turned\n"
"bad!{end_wait}"

msgctxt "MsgVaultMyFatherWorriedAboutThose"
msgid "04953"
msgstr ""
"My father is so\n"
"worried about those\n"
"prisoners from Lunpa.{page_break}"
"You'll protect us if\n"
"Dodonpa and his men\n"
"come to attack us, right?{end_wait}"

msgctxt "MsgVaultTheReasonLunpaTurnedBadIs"
msgid "04954"
msgstr ""
"The reason Lunpa turned\n"
"bad is because Donpa\n"
"spoiled his son, Dodonpa.{end_wait}"

msgctxt "MsgVaultFatherLooksSadWorryingLike"
msgid "04955"
msgstr ""
"Father looks so sad,\n"
"worrying like that.{end_wait}"

msgctxt "MsgVaultThievesHidStolenTreasureIn"
msgid "04956"
msgstr ""
"The thieves hid the\n"
"stolen treasure in\n"
"the hotel's loft...{page_break}"
"and they hid other stolen\n"
"goods in the cemetery.{end_wait}"

msgctxt "MsgVaultJustAsIThoughtNothingWas"
msgid "04957"
msgstr ""
"Just as I thought,\n"
"nothing was stolen\n"
"from our house.{end_wait}"

msgctxt "MsgVaultGuessNothingInOurHouse"
msgid "04958"
msgstr ""
"I guess nothing in our\n"
"house was valuable\n"
"enough to steal.{page_break}"
"I have mixed feelings\n"
"about that...{end_wait}"

msgctxt "MsgVaultIWishIHadSomethingWorth"
msgid "04959"
msgstr ""
"I wish I had something\n"
"worth stealing!{end_wait}"

msgctxt "MsgVaultYouWereSuchGreatHelp"
msgid "04960"
msgstr ""
"You were such\n"
"a great help, {actor_name:1}.{end_wait}"

msgctxt "message"
msgid "04961"
msgstr ""
"Allow us to show\n"
"you our gratitude,\n"
"like we promised.{end_wait}"

msgctxt "message"
msgid "04962"
msgstr "Received {argument_item_name:2}.{end_wait}"

msgctxt "message"
msgid "04963"
msgstr ""
"Oh no, {actor_name:1} and\n"
"his friends have\n"
"too many items!{page_break}"
"Please come back\n"
"when you organize\n"
"your things.{end_wait}"

msgctxt "MsgVaultHeadingOutBeyondGomaRange"
msgid "04964"
msgstr ""
"Are you heading out\n"
"beyond Goma Range,\n"
"by any chance?{end_now}"

msgctxt "message"
msgid "04965"
msgstr ""
"Look for a cave in the\n"
"mountains of the Goma\n"
"Range, northeast of us.{page_break}"
"Once you've passed it,\n"
"you'll reach Bilibin.{end_wait}"

msgctxt "message"
msgid "04966"
msgstr ""
"Hmm... There's no other\n"
"way to get out of here\n"
"right now.{end_wait}"

msgctxt "MsgVaultYoureThePersonWhoGotOur"
msgid "04967"
msgstr ""
"You're the person\n"
"who got our urn back,\n"
"aren't you?{page_break}"
"Thank you so much.{end_wait}"

msgctxt "MsgVaultHeardDefeatedThoseThieves"
msgid "04968"
msgstr ""
"I heard you defeated\n"
"those thieves!{end_now}"

msgctxt "message"
msgid "04969"
msgstr ""
"I suppose you really can't\n"
"judge people by their\n"
"looks...{end_wait}"

msgctxt "message"
msgid "04970"
msgstr ""
"Really? My father said\n"
"you were the ones who\n"
"captured the thieves...{end_wait}"

msgctxt "MsgVaultIvanLearnedALotByTalking"
msgid "04971"
msgstr ""
"{actor_name:3} learned a\n"
"lot by talking\n"
"with animals...{end_wait}"

msgctxt "MsgVaultCaveInGomaRangeDangerous"
msgid "04972"
msgstr ""
"The cave in the Goma\n"
"Range is a dangerous\n"
"place, but you'll be okay.{end_wait}"

msgctxt "MsgVaultImSoRelievedNowThatWe"
msgid "04973"
msgstr ""
"I'm so relieved now that\n"
"we have our family urn\n"
"back, safe and sound.{end_wait}"

msgctxt "MsgVaultWhenIGrowUpIWant"
msgid "04974"
msgstr ""
"When I grow up,\n"
"I want to be just as\n"
"strong as you!{end_wait}"

msgctxt "MsgVaultIWishIHadWingsLike"
msgid "04975"
msgstr ""
"...I wish I had\n"
"wings like a bird...{page_break}"
"I want to be free...\n"
"to fly to the furthest\n"
"reaches of the sky.{end_wait}"

msgctxt "MsgVaultWeFoundOurStolenWeapons"
msgid "04976"
msgstr ""
"We found our stolen\n"
"weapons in the cemetery,\n"
"but they were all rusted.{page_break}"
"We have to sharpen\n"
"them before we can\n"
"sell them to anyone.{end_wait}"

msgctxt "MsgVaultMyWeaponsWereFoundInThe"
msgid "04977"
msgstr ""
"My weapons were found in\n"
"the cemetery. Hey, what's\n"
"that supposed to mean?{page_break}"
"Is someone trying to\n"
"tell us our weapons\n"
"are too old?{end_wait}"

msgctxt "MsgVaultIfYoureGonnaHeadInto"
msgid "04978"
msgstr ""
"If you're gonna head into\n"
"the cave in Goma Range,\n"
"you should be prepared.{end_wait}"

msgctxt "MsgVaultItMustBeSnowingUpIn"
msgid "04979"
msgstr ""
"It must be snowing up\n"
"in Imil, north of\n"
"the Goma Range.{end_wait}"

msgctxt "MsgVaultWithBridgeOutWillQuite"
msgid "04980"
msgstr ""
"With the bridge out, it\n"
"will be quite a while 'til\n"
"we can go to Kalay again.{end_wait}"

msgctxt "MsgVaultWhyAreThesePeopleSoAnxious"
msgid "04981"
msgstr ""
"Why are these people\n"
"so anxious to leave?{end_wait}"

msgctxt "MsgSanctumWasHandFateReturnedGold"
msgid "04982"
msgstr ""
"It was the hand of fate\n"
"that returned the gold\n"
"statue to our Sanctum.{end_wait}"

msgctxt "MsgSanctumWhenStrayFromYourWorldly"
msgid "04983"
msgstr ""
"When you stray from your\n"
"worldly path, fate will\n"
"guide you on your course.{end_wait}"

msgctxt "MsgSanctumGoOnIfThatEasesThe"
msgid "04984"
msgstr ""
"Go on...\n"
"if that eases the\n"
"anxiety in your mind...{end_wait}"

msgctxt "MsgSanctumChildHasAwakenedOurTeachings"
msgid "04985"
msgstr ""
"This child has awakened\n"
"to our teachings!\n"
"Guide him well.{end_wait}"

msgctxt "MsgVaultImShockedThoseGuestsOfOurs"
msgid "04986"
msgstr ""
"I'm shocked! Those guests\n"
"of ours turned out to be\n"
"thieves!?{end_wait}"

msgctxt "MsgVaultTheyHidThoseStolenGoods"
msgid "04987"
msgstr ""
"They hid all those stolen\n"
"goods in our loft?{page_break}"
"Well, at least we nabbed\n"
"the thieves and the\n"
"town's peaceful again.{end_wait}"

msgctxt "MsgVaultHaveLotLeftoverBonesFrom"
msgid "04988"
msgstr ""
"I have a lot of leftover\n"
"bones from dinner.\n"
"Here, do you want some?{end_now}"

msgctxt "message"
msgid "04989"
msgstr ""
"Really?\n"
"Take as many\n"
"as you want.{end_wait}"

msgctxt "message"
msgid "04990"
msgstr ""
"Well, I don't blame you.\n"
"A growing boy can't live\n"
"on bones alone.{end_wait}"

msgctxt "MsgVaultThankForOtherDayLeaving"
msgid "04991"
msgstr ""
"Thank you for the other\n"
"day. Are you leaving\n"
"town already?{page_break}"
"I'll be praying for\n"
"your safety.{end_wait}"

msgctxt "MsgVaultWhoCouldHaveKnownTheyWere"
msgid "04992"
msgstr ""
"Who could have\n"
"known they were\n"
"thieves?{page_break}"
"Well, at least we got\n"
"some business. That's\n"
"not too bad, right?{end_wait}"

msgctxt "MsgVaultOfCourseIAlwaysSuspectedThey"
msgid "04993"
msgstr ""
"Of course, I always\n"
"suspected they were\n"
"up to no good.{end_wait}"

msgctxt "MsgVaultGeeAlwaysGetHungryWhen"
msgid "04994"
msgstr ""
"Gee...\n"
"I always get so hungry\n"
"when I'm cooking...{page_break}"
"It wouldn't kill me\n"
"to taste just a little\n"
"bit, would it?{end_wait}"

msgctxt "MsgVaultSniffAhTheSmellOfCooking"
msgid "04995"
msgstr ""
"Sniff... Ah... The smell\n"
"of cooking meat...{page_break}"
"No one will notice if I\n"
"take a little bite!{end_wait}"

msgctxt "MsgVaultWowHaveManyThingsArent"
msgid "04996"
msgstr ""
"Wow, you have so many\n"
"things. Aren't you\n"
"a greedy lad!{end_wait}"

msgctxt "MsgVaultWantMoreBones"
msgid "04997"
msgstr ""
"What? You want more\n"
"bones?{end_now}"

msgctxt "message"
msgid "04998"
msgstr ""
"Go ahead...\n"
"Take as many as\n"
"you want.{end_wait}"

msgctxt "message"
msgid "04999"
msgstr ""
"I don't blame you.{page_break}"
"Only a dog would be\n"
"happy eating nothing\n"
"but bones.{end_wait}"

msgctxt "MsgVaultLeftThiefRegretsEscape"
msgid "05000"
msgstr ""
"If only we had escaped\n"
"to the cave northeast\n"
"of Goma Range.{end_wait}"

msgctxt "MsgVaultRightThiefRegretsStaying"
msgid "05001"
msgstr ""
"Blast! I knew we should\n"
"have skipped town sooner.{end_wait}"

msgctxt "MsgVaultThiefLeaderSilencesThieves"
msgid "05002"
msgstr "Shut yer yaps!{end_wait}"

msgctxt "message"
msgid "05003"
msgstr ""
"They got us this time,\n"
"but next time...\n"
"Oh, they'll pay for this!{end_wait}"

msgctxt "MsgVaultLeftThiefThoughts"
msgid "05004"
msgstr ""
"Sigh...\n"
"Will I ever\n"
"run free again?{end_wait}"

msgctxt "MsgVaultRightThiefThoughts"
msgid "05005"
msgstr ""
"I wonder if this is\n"
"because we stole\n"
"Hammet's Shaman's Rod.{end_wait}"

msgctxt "MsgVaultThiefLeaderThoughts"
msgid "05006"
msgstr ""
"I'll be out of this\n"
"jail before you know it.\n"
"You'll see!{end_wait}"

msgctxt "MsgGomaNoUsePsynergy"
msgid "05007"
msgstr ""
"It's no use. Our Psynergy\n"
"isn't strong enough\n"
"to free that stump.{end_wait}"

msgctxt "message"
msgid "05008"
msgstr ""
"You want to move\n"
"the stump, right?{end_wait}"

msgctxt "message"
msgid "05009"
msgstr ""
"It looks like it's\n"
"trapped in the ivy.{end_wait}"

msgctxt "message"
msgid "05010"
msgstr ""
"Isn't there anything\n"
"we can do?{end_wait}"

msgctxt "message"
msgid "05011"
msgstr "I know!{end_wait}"

msgctxt "message"
msgid "05012"
msgstr ""
"I have a great idea.\n"
"Leave it to me!{end_wait}"

msgctxt "message"
msgid "05013"
msgstr "All right, {actor_name:3}!{end_wait}"

msgctxt "message"
msgid "05014"
msgstr "I did it!{end_wait}"

msgctxt "message"
msgid "05015"
msgstr ""
"...Thanks for the help.{pause_20_skippable}\n"
"But why are you here,\n"
"{actor_name:3}?{end_wait}"

msgctxt "message"
msgid "05016"
msgstr ""
"I couldn't get\n"
"into Lunpa...{end_wait}"

msgctxt "message"
msgid "05017"
msgstr ""
"Don't get me wrong!{pause_20_skippable}\n"
"I didn't come here\n"
"to ask for your help.{end_wait}"

msgctxt "message"
msgid "05018"
msgstr ""
"Your quest has been\n"
"on my mind ever\n"
"since I left Vault.{end_wait}"

msgctxt "message"
msgid "05019"
msgstr ""
"Remember? I read\n"
"everything that\n"
"happened in your minds.{end_wait}"

msgctxt "message"
msgid "05020"
msgstr ""
"I couldn't just leave,\n"
"not with all these\n"
"terrible things happening.{end_wait}"

msgctxt "message"
msgid "05021"
msgstr ""
"If I can't rescue Master\n"
"Hammet, then I want\n"
"to help you...{end_wait}"

msgctxt "message"
msgid "05022"
msgstr ""
"Please, allow me to\n"
"join your quest.{end_wait}"

msgctxt "message"
msgid "05023"
msgstr ""
"Are you trying to get\n"
"to Bilibin through\n"
"this cave?{end_wait}"

msgctxt "message"
msgid "05024"
msgstr "Then let's go!{end_wait}"

msgctxt "message"
msgid "05025"
msgstr ""
"Mother, look!!\n"
"A boulder blocking\n"
"the road!!{end_wait}"

msgctxt "message"
msgid "05026"
msgstr "You moved that boulder!{end_wait}"

msgctxt "message"
msgid "05027"
msgstr ""
"We can go now, Mother,\n"
"can't we?{end_wait}"

msgctxt "message"
msgid "05028"
msgstr ""
"How did you get\n"
"locked up in here?{end_wait}"

msgctxt "message"
msgid "05029"
msgstr ""
"We came here to\n"
"escape the eruption\n"
"of Mt. Aleph.{end_wait}"

msgctxt "message"
msgid "05030"
msgstr ""
"When we got here, that\n"
"boulder fell in a landslide,{page_break}"
"and we couldn't go\n"
"any further.{end_wait}"

msgctxt "message"
msgid "05031"
msgstr ""
"Then some strange men\n"
"blocked the other end\n"
"with a barricade.{end_wait}"

msgctxt "message"
msgid "05032"
msgstr ""
"How did you move the\n"
"boulder without touching\n"
"it?{end_wait}"

msgctxt "message"
msgid "05033"
msgstr ""
"I hope we don't get\n"
"trapped by another\n"
"boulder!{end_wait}"

msgctxt "message"
msgid "05034"
msgstr ""
"Tell me the truth, now.\n"
"Did Alchemy caused that\n"
"eruption on Mt. Aleph?{end_wait}"

msgctxt "MsgVaultCarefulSearchWillRevealPassage"
msgid "05035"
msgstr ""
"A careful search will\n"
"{pause_20_skippable}reveal{pause_20_skippable} a passage leading\n"
"underground nearby.{page_break}"
"You might just find\n"
"some treasure inside!{end_wait}"

msgctxt "message"
msgid "05036"
msgstr ""
"Bilibin lies\n"
"to the east.{end_wait}"

msgctxt "message"
msgid "05037"
msgstr ""
"Far to the north, you'll\n"
"find Imil.{end_wait}"

msgctxt "MsgBilibinItsTreeButAlmostLooks"
msgid "05038"
msgstr ""
"It's a tree, but\n"
"it almost looks like...\n"
"a man?{end_wait}"

msgctxt "message"
msgid "05039"
msgstr ""
"It looks like\n"
"a living person.{end_wait}"

msgctxt "MsgBilibinHelpMeSomebody"
msgid "05040"
msgstr "Help me... Somebody...{end_wait}"

msgctxt "MsgBilibinWelcomeToBilibinPleaseJustIgnore"
msgid "05041"
msgstr ""
"Welcome to Bilibin!\n"
"Please, just ignore that\n"
"strange tree out front!{page_break}"
"Many brave warriors have\n"
"been sent to Kolima.\n"
"Travelers needn't worry!{end_wait}"

msgctxt "MsgBilibinIHearALargeGroupCrossed"
msgid "05042"
msgstr ""
"I hear a large group\n"
"crossed over Goma Range,\n"
"heading toward Imil.{end_wait}"

msgctxt "MsgBilibinDidSeeTreeAtEntrance"
msgid "05043"
msgstr ""
"Did you see the tree\n"
"at the entrance?{end_now}"

msgctxt "message"
msgid "05044"
msgstr ""
"That tree was once a\n"
"man... He came to our\n"
"village under a curse.{page_break}"
"His last words were that\n"
"he had offended the\n"
"sacred tree...{end_wait}"

msgctxt "message"
msgid "05045"
msgstr ""
"I can't believe you missed\n"
"the tree... You should\n"
"look around some more.{end_wait}"

msgctxt "MsgBilibinLordMccoyHasBeenQuiteFrightened"
msgid "05046"
msgstr ""
"Lord McCoy has been\n"
"quite frightened\n"
"since the incident.{end_wait}"

msgctxt "MsgBilibinHaveTriedHeadingSoutheastFrom"
msgid "05047"
msgstr ""
"Have you tried heading\n"
"southeast from here?{end_now}"

msgctxt "message"
msgid "05048"
msgstr ""
"That barricade was built\n"
"because there's been\n"
"trouble in Kolima.{end_wait}"

msgctxt "message"
msgid "05049"
msgstr ""
"The road is blocked, so\n"
"you might as well\n"
"not even bother.{page_break}"
"I heard they put a\n"
"massive barricade up...{end_wait}"

msgctxt "MsgBilibinTheRoadToKolimaIsBlocked"
msgid "05050"
msgstr ""
"The road to Kolima\n"
"is blocked now, as per\n"
"Lord McCoy's orders.{end_wait}"

msgctxt "MsgBilibinEverSinceThatManTurnedInto"
msgid "05051"
msgstr ""
"Ever since that man\n"
"turned into a tree,\n"
"everyone has been{page_break}"
"too scared to go near\n"
"the town's entrance.{end_wait}"

msgctxt "MsgBilibinIsItTrueThatAMountain"
msgid "05052"
msgstr ""
"Is it true that a\n"
"mountain exploded on\n"
"the other side of Goma?{page_break}"
"The sky was a brilliant\n"
"red that day.\n"
"It was a beautiful sight.{end_wait}"

msgctxt "MsgBilibinTheresATowerAtTheTip"
msgid "05053"
msgstr ""
"There's a tower at the\n"
"tip of Imil that people\n"
"say was built by the gods!{page_break}"
"Everyone there calls\n"
"it the lighthouse.{end_wait}"

msgctxt "MsgBilibinSomethingChangedInTheEruptionNow"
msgid "05054"
msgstr ""
"Something{pause_20_skippable} changed\n"
"in the eruption.{page_break}"
"Now, all sorts of strange\n"
"creatures lurk in every\n"
"forest and mountain!{end_wait}"

msgctxt "MsgBilibinTheLumberIOrderedFromKolima"
msgid "05055"
msgstr ""
"The lumber I ordered\n"
"from Kolima disappeared\n"
"after the{pause_20_skippable} incident.{end_wait}"

msgctxt "MsgBilibinHaveYouSeenBarricadeWe"
msgid "05056"
msgstr ""
"Have you seen the\n"
"barricade we built on\n"
"the road to Kolima?{end_now}"

msgctxt "message"
msgid "05057"
msgstr ""
"It's pretty shabby,\n"
"because it was built\n"
"on short notice...{page_break}"
"I had no idea it was\n"
"meant to block the\n"
"road to Kolima.{end_wait}"

msgctxt "message"
msgid "05058"
msgstr ""
"It's off to the east,\n"
"if you want to see it.{page_break}"
"It was a rush job, so\n"
"I had to take some\n"
"shortcuts.{end_wait}"

msgctxt "MsgBilibinTellingMeImResponsibleFor"
msgid "05059"
msgstr ""
"Are you telling me that\n"
"I'm responsible for this?{end_now}"

msgctxt "message"
msgid "05060"
msgstr ""
"Sure, I had them cut the\n"
"tree down so I could\n"
"build my palace!{page_break}"
"But if anyone is a victim,\n"
"it's me! I've been waiting\n"
"for my palace for months!{end_wait}"

msgctxt "message"
msgid "05061"
msgstr ""
"That curse of the tree\n"
"spirit is a foolish\n"
"old superstition!{page_break}"
"I just want to live\n"
"in a big palace!{end_wait}"

msgctxt "MsgBilibinYouGuysAreSoUnluckyArriving"
msgid "05062"
msgstr ""
"You guys are so unlucky,\n"
"arriving in Bilibin at\n"
"such a scary time.{end_wait}"

msgctxt "MsgBilibinYouMustBeMadItsAlmost"
msgid "05063"
msgstr ""
"You must be mad!\n"
"It's almost winter, and\n"
"you're going to Imil?{end_wait}"

msgctxt "MsgBilibinWeEndedUpLikeThisBecause"
msgid "05064"
msgstr ""
"We ended up like this\n"
"because of Lady McCoy's\n"
"foolishness.{page_break}"
"If only she hadn't wanted\n"
"to live like a queen...{end_wait}"

msgctxt "MsgBilibinEveryoneGetsWorriedWhenTownLeaders"
msgid "05065"
msgstr ""
"Everyone gets worried\n"
"when town leaders get\n"
"scared.{page_break}"
"I wonder if we can still\n"
"rely on Lord McCoy.{end_wait}"

msgctxt "MsgBilibinWhereDidTheseKidsComeFrom"
msgid "05066"
msgstr ""
"Where did these\n"
"kids come from?{end_wait}"

msgctxt "MsgBilibinNoOneWouldDareGoAfter"
msgid "05067"
msgstr ""
"No one would dare go\n"
"after what happened\n"
"last time.{end_wait}"

msgctxt "MsgBilibinHeBeggedForHelpAsHe"
msgid "05068"
msgstr ""
"He begged for help as he\n"
"turned into a tree, but\n"
"no one would help him.{page_break}"
"Is that how all\n"
"grown-ups are?{end_wait}"

msgctxt "MsgBilibinIWantToSeeThatPretty"
msgid "05069"
msgstr ""
"I want to see\n"
"that pretty sky again...{end_wait}"

msgctxt "MsgBilibinOnlyGreatAdeptsCanEnterThe"
msgid "05070"
msgstr ""
"Only great Adepts\n"
"can enter the\n"
"Lighthouse of Imil.{end_wait}"

msgctxt "MsgBilibinThatExplosionMustHaveBeenA"
msgid "05071"
msgstr ""
"That explosion must have\n"
"been a sign of some\n"
"big disaster.{page_break}"
"I'm scared!{end_wait}"

msgctxt "MsgBilibinIfThingsLikeThisAreGoing"
msgid "05072"
msgstr ""
"If things like this are\n"
"going to keep happening,{page_break}"
"maybe we should stop\n"
"building that palace.{end_wait}"

msgctxt "MsgBilibinIAmGladIDidntKnow"
msgid "05073"
msgstr ""
"I am glad I didn't\n"
"know Kolima was involved\n"
"in that incident...{page_break}"
"If I had, I wouldn't\n"
"have done it,\n"
"no matter what.{end_wait}"

msgctxt "MsgBilibinIfAllThisTroubleWasCaused"
msgid "05074"
msgstr ""
"If all this trouble\n"
"was caused by the\n"
"sacred tree,{page_break}"
"then all we have\n"
"to do is cut the\n"
"tree down!{end_wait}"

msgctxt "MsgBilibinThatTreeAtTheEntranceIs"
msgid "05075"
msgstr ""
"That tree at the entrance\n"
"is really a man cursed\n"
"by the sacred tree!{page_break}"
"It's all because McCoy,\n"
"the lord of this town, cut\n"
"down all those trees.{end_wait}"

msgctxt "MsgBilibinMccoyHadTheTreesCutDown"
msgid "05076"
msgstr ""
"McCoy had the trees cut\n"
"down so he could build\n"
"his wife a grand palace.{end_wait}"

msgctxt "MsgBilibinThisIsAllLordMccoysFault"
msgid "05077"
msgstr ""
"This is all Lord\n"
"McCoy's fault, but we\n"
"can't say anything...{page_break}"
"He is our leader,\n"
"after all.{end_wait}"

msgctxt "MsgBilibinAhLadyMccoyIWouldJust"
msgid "05078"
msgstr ""
"Ah, Lady McCoy...\n"
"I would just\n"
"love to be her.{page_break}"
"Will I ever live\n"
"in a lovely palace?{end_wait}"

msgctxt "MsgBilibinTheSnowIsAlreadyPilingUp"
msgid "05079"
msgstr ""
"The snow is already piling\n"
"up in Imil, and\n"
"the weather is freezing.{page_break}"
"If I were you, I'd\n"
"wait until spring\n"
"to go there.{end_wait}"

msgctxt "MsgBilibinWeRarelySeeAnySnowAround"
msgid "05080"
msgstr ""
"We rarely see any snow\n"
"around Bilibin.{end_wait}"

msgctxt "MsgBilibinWhenSpringComesWantGo"
msgid "05081"
msgstr ""
"When spring comes, I want\n"
"to go see that\n"
"angelic {actor_name:4} again.{end_wait}"

msgctxt "MsgBilibinItMustBeDifficultToLive"
msgid "05082"
msgstr ""
"It must be difficult\n"
"to live in a snowy town.{page_break}"
"I think I'll just\n"
"stay here.{end_wait}"

msgctxt "MsgBilibinHowArePeopleDoingInKolima"
msgid "05083"
msgstr ""
"How are people doing\n"
"in Kolima?\n"
"I've been worried...{end_wait}"

msgctxt "MsgBilibinIKnowThatGuyWhoTurned"
msgid "05084"
msgstr ""
"I know that guy who\n"
"turned into the tree...\n"
"I remember his clothes.{end_wait}"

msgctxt "MsgBilibinICantImagineThatEveryoneIn"
msgid "05085"
msgstr ""
"I can't imagine that\n"
"everyone in Kolima turned\n"
"into a tree, but...{end_wait}"

msgctxt "MsgBilibinHeSeemedSoHappyAndThen"
msgid "05086"
msgstr ""
"He seemed so happy, and\n"
"then he turned into\n"
"a tree!{page_break}"
"What if that happened\n"
"to me?{end_wait}"

msgctxt "MsgBilibinLongAgoTheLighthouseNearImil"
msgid "05087"
msgstr ""
"Long ago, the lighthouse\n"
"near Imil held the\n"
"Water of Hermes,{page_break}"
"a magical liquid that\n"
"could heal all injuries.{end_wait}"

msgctxt "MsgBilibinButEvenTheLegendaryWaterOf"
msgid "05088"
msgstr ""
"But even the legendary\n"
"Water of Hermes cannot\n"
"turn back time.{page_break}"
"If only there were a\n"
"potion that could\n"
"restore youth.{end_wait}"

msgctxt "MsgBilibinCouldTheWaterOfHermesSave"
msgid "05089"
msgstr ""
"Could the Water of\n"
"Hermes save a man who\n"
"had turned into a tree?{end_wait}"

msgctxt "MsgBilibinTheWaterOfHermesVanishedLong"
msgid "05090"
msgstr ""
"The Water of Hermes\n"
"vanished long ago.{page_break}"
"After all, nothing lasts\n"
"forever.{end_wait}"

msgctxt "MsgBilibinThereWasAbleHealerIn"
msgid "05091"
msgstr ""
"There was an able healer\n"
"in a village called Vale,\n"
"but he is gone now.{end_wait}"

msgctxt "MsgBilibinTheWorldWillNeverSeeSuch"
msgid "05092"
msgstr ""
"The world will never see\n"
"such a great healer again.{end_wait}"

msgctxt "MsgBilibinHaveEverHeardOcean"
msgid "05093"
msgstr ""
"Have you ever heard\n"
"of the 'ocean'?{end_now}"

msgctxt "message"
msgid "05094"
msgstr ""
"If you travel over the\n"
"ocean to far, far away,\n"
"you'll find another world.{page_break}"
"They say the world of\n"
"misty darkness begins\n"
"there.{end_wait}"

msgctxt "message"
msgid "05095"
msgstr ""
"The ocean is immense...\n"
"You would want to sing if\n"
"you ever saw the ocean.{end_wait}"

msgctxt "MsgBilibinIWishICouldSeeAnother"
msgid "05096"
msgstr ""
"I wish I could see another\n"
"world! If I were a\n"
"little younger...{end_wait}"

msgctxt "MsgBilibinMustUsedTypesDangerBeing"
msgid "05097"
msgstr ""
"You must be used to\n"
"all types of danger,\n"
"being travelers and all.{page_break}"
"Lord McCoy could use\n"
"someone like you.{end_wait}"

msgctxt "MsgBilibinOnlySomeoneReallyBraveWouldGo"
msgid "05098"
msgstr ""
"Only someone really\n"
"brave would go\n"
"somewhere so scary.{end_wait}"

msgctxt "MsgBilibinCurseOnKolimaScaryDevelopment"
msgid "05099"
msgstr ""
"A curse on Kolima?\n"
"What a scary development!{end_wait}"

msgctxt "MsgBilibinYouCantReachKolimaNoMatter"
msgid "05100"
msgstr ""
"You can't reach Kolima,\n"
"no matter how you try.{end_wait}"

msgctxt "MsgBilibinImReallyWorriedAboutKolima"
msgid "05101"
msgstr ""
"I'm really worried\n"
"about Kolima. I was\n"
"born there, you know?{page_break}"
"I can't even focus\n"
"on my cooking.{end_wait}"

msgctxt "MsgBilibinHeyMisterHeadChefAreYou"
msgid "05102"
msgstr ""
"Hey, Mister Head Chef!\n"
"Are you going to cook\n"
"or not?{page_break}"
"Customers are waiting!{end_wait}"

msgctxt "MsgBilibinStartCookingAlready"
msgid "05103"
msgstr ""
"Start cooking\n"
"already!{end_wait}"

msgctxt "MsgBilibinGrrr"
msgid "05104"
msgstr "Grrr...{end_wait}"

msgctxt "message"
msgid "05105"
msgstr ""
"Did you hear a sound?\n"
"You heard it, right?{end_now}"

msgctxt "message"
msgid "05106"
msgstr ""
"I can't hear anything\n"
"over the growling\n"
"of my stomach!{page_break}"
"I'm dizzy with hunger.{end_wait}"

msgctxt "message"
msgid "05107"
msgstr ""
"{text_effect:4}Oooh...{reset_text_style} It's been so long\n"
"since I ordered...\n"
"My stomach's rumbling.{page_break}"
"Where's my dinner!?{end_wait}"

msgctxt "MsgBilibinWeCameHereBecauseLordMccoy"
msgid "05108"
msgstr ""
"We came here because\n"
"Lord McCoy was building\n"
"his wife a palace.{page_break}"
"I wonder if they stopped\n"
"because of the curse?{end_wait}"

msgctxt "MsgBilibinIThinkThatBigTreeDeep"
msgid "05109"
msgstr ""
"I think that big tree\n"
"deep in the forest\n"
"looks suspicious!{end_wait}"

msgctxt "MsgBilibinDoBelieveTreeSpiritCan"
msgid "05110"
msgstr ""
"Do you believe a tree\n"
"spirit can curse a man?{end_now}"

msgctxt "message"
msgid "05111"
msgstr ""
"It's hard not to believe\n"
"after you've seen\n"
"that tree out front!{end_wait}"

msgctxt "message"
msgid "05112"
msgstr ""
"Really? Then go see\n"
"Lord McCoy and listen\n"
"to his story!{end_wait}"

msgctxt "MsgBilibinICantWaitToSeeTodays"
msgid "05113"
msgstr ""
"I can't wait to see\n"
"today's special!\n"
"Yippee!{end_wait}"

msgctxt "MsgBilibinIWentToLordMccoyLooking"
msgid "05114"
msgstr ""
"I went to Lord McCoy\n"
"looking for work...{page_break}"
"I'm too scared to\n"
"accept the job\n"
"alone, though...{end_wait}"

msgctxt "MsgBilibinIveHeardSongsThatTellOf"
msgid "05115"
msgstr ""
"I've heard songs that\n"
"tell of ancient trees\n"
"developing strange powers.{page_break}"
"Maybe that power is\n"
"what caused{pause_20_skippable} the "
"{text_effect:4}curse{reset_text_style}.{end_wait}"

msgctxt "MsgBilibinIDontBelieveInCursesFrom"
msgid "05116"
msgstr ""
"I don't believe in curses\n"
"from ancient trees.{end_wait}"

msgctxt "MsgBilibinAnyTravelersHeadingEastAreStuck"
msgid "05117"
msgstr ""
"Any travelers heading\n"
"east are stuck here until\n"
"the road opens up.{page_break}"
"Until then, I'm gonna\n"
"make lots of money!{end_wait}"

msgctxt "MsgBilibinFatherMotherIHopeTheyreAll"
msgid "05118"
msgstr ""
"Father, Mother...\n"
"I hope they're all right.{page_break}"
"I wish I could go\n"
"home and see them\n"
"right away.{end_wait}"

msgctxt "MsgBilibinShouldIJustForgetThatIm"
msgid "05119"
msgstr ""
"Should I just forget\n"
"that I'm a newcomer\n"
"and just start cooking?{end_wait}"

msgctxt "MsgBilibinIveHadAllTheCustomerComplaints"
msgid "05120"
msgstr ""
"I've had all the customer\n"
"complaints I want!{end_wait}"

msgctxt "MsgBilibinArghhhThatsItIJustWant"
msgid "05121"
msgstr ""
"Arghhh! That's it...\n"
"I just want to scream\n"
"with hunger!{page_break}"
"But I still have to\n"
"smile... Boy, it's tough\n"
"being a businessman.{end_wait}"

msgctxt "MsgBilibinICameToBilibinHopingTo"
msgid "05122"
msgstr ""
"I came to Bilibin hoping\n"
"to sell furniture.\n"
"Instead, all I get is...{page_break}"
"a palace nobody's building\n"
"and a restaurant that\n"
"won't serve me my food.{end_wait}"

msgctxt "MsgBilibinISeeWhyTheyCallThat"
msgid "05123"
msgstr ""
"I see why they call that\n"
"big tree in Kolima\n"
"Forest the sacred tree.{end_wait}"

msgctxt "MsgBilibinIDontCareWhoDoesIt"
msgid "05124"
msgstr ""
"I don't care who does it.\n"
"Just undo that\n"
"curse, now!{end_wait}"

msgctxt "MsgBilibinYippeeIsItReadyYetMy"
msgid "05125"
msgstr ""
"Yippee! Is it ready yet?\n"
"My mouth is watering\n"
"just thinking about it.{end_wait}"

msgctxt "MsgBilibinImGettingALittleScaredHearing"
msgid "05126"
msgstr ""
"I'm getting a little scared\n"
"hearing all these stories\n"
"from the villagers.{end_wait}"

msgctxt "MsgBilibinItHasBeenSaidThatA"
msgid "05127"
msgstr ""
"It has been said that\n"
"a fairy named Tret\n"
"lives inside the holy tree.{end_wait}"

msgctxt "MsgSanctumAmStartingFeelOnlyBeginning"
msgid "05128"
msgstr ""
"I am starting to feel\n"
"that this is only\n"
"a beginning.{end_wait}"

msgctxt "MsgSanctumPleaseGiveMeStrengthAtTimes"
msgid "05129"
msgstr ""
"Please, give me strength\n"
"at times like these...{end_wait}"

msgctxt "MsgSanctumWillITurnIntoATree"
msgid "05130"
msgstr ""
"Will I turn into a\n"
"tree someday, too?\n"
"How terrible...{end_wait}"

msgctxt "MsgSanctumSomeoneWillSaveUsJustKeep"
msgid "05131"
msgstr ""
"Someone will save us!\n"
"Just keep the faith!{end_wait}"

msgctxt "MsgBilibinLordMccoyIsSoUpsetAbout"
msgid "05132"
msgstr ""
"Lord McCoy is so upset\n"
"about this curse that\n"
"he can't even eat.{end_wait}"

msgctxt "MsgBilibinLordOnlyMeet"
msgid "05133"
msgstr ""
"The lord will only\n"
"meet with brave\n"
"and mighty warriors.{page_break}"
"You don't seem the type.\n"
"Think you're up to it?{end_now}"

msgctxt "message"
msgid "05134"
msgstr ""
"Your honesty is good...{page_break}"
"But I can't send such\n"
"inexperienced children\n"
"to see my lord.{end_wait}"

msgctxt "message"
msgid "05135"
msgstr ""
"Hmmm, I see...\n"
"You seem pretty\n"
"confident...{end_wait}"

msgctxt "message"
msgid "05136"
msgstr ""
"What do you say? They\n"
"look a little young to get\n"
"involved in this ugly mess.{end_wait}"

msgctxt "message"
msgid "05137"
msgstr ""
"Nobody else seems up to\n"
"the challenge, though.\n"
"What do we have to lose?{end_wait}"

msgctxt "message"
msgid "05138"
msgstr ""
"All right. I shall\n"
"let you pass.\n"
"Follow me!{end_wait}"

msgctxt "MsgBilibinLordMccoyDifficult"
msgid "05139"
msgstr ""
"Lord McCoy is a very\n"
"difficult man. Be careful\n"
"how you act around him.{end_wait}"

msgctxt "MsgBilibinWhere"
msgid "05140"
msgstr "Where were you?{end_wait}"

msgctxt "message"
msgid "05141"
msgstr ""
"Lord McCoy is angry\n"
"because he couldn't find\n"
"you.{end_wait}"

msgctxt "MsgBilibinMasterQuiteCranky"
msgid "05142"
msgstr ""
"The master can be\n"
"quite cranky.\n"
"Hurry along, now!{end_wait}"

msgctxt "MsgBilibinNoOneBelievedTheyWouldTurn"
msgid "05143"
msgstr ""
"No one believed they\n"
"would turn into trees,\n"
"and yet they all did!{end_wait}"

msgctxt "MsgBilibinIsThereNoOneWhoCan"
msgid "05144"
msgstr ""
"Is there no one who\n"
"can aid us now?{end_wait}"

msgctxt "MsgBilibinLordMccoyWouldNeverHireAnyone"
msgid "05145"
msgstr ""
"Lord McCoy would never\n"
"hire anyone so puny\n"
"as these kids...{end_wait}"

msgctxt "message"
msgid "05146"
msgstr ""
"You are the only ones\n"
"I can count on!\n"
"Please help us.{end_wait}"

msgctxt "message"
msgid "05147"
msgstr ""
"Really?\n"
"I can't believe he\n"
"really asked you.{end_wait}"

msgctxt "message"
msgid "05148"
msgstr ""
"Don't blame me if\n"
"you get turned into\n"
"a tree.{end_wait}"

msgctxt "message"
msgid "05149"
msgstr ""
"I am beginning to feel\n"
"rather sorry for\n"
"you now.{end_wait}"

msgctxt "MsgBilibinIfYouWantToSeeLord"
msgid "05150"
msgstr ""
"If you want to see\n"
"Lord McCoy, follow\n"
"the red carpet.{end_wait}"

msgctxt "MsgBilibinMakeSureYouDontOffendLord"
msgid "05151"
msgstr ""
"Make sure you don't\n"
"offend Lord McCoy!{end_wait}"

msgctxt "MsgBilibinYouWillingGoKolimaForest"
msgid "05152"
msgstr ""
"Oh, are you willing\n"
"to go to Kolima Forest?{end_now}"

msgctxt "message"
msgid "05153"
msgstr ""
"I forget how many\n"
"people Lord McCoy has\n"
"hired to end the curse.{page_break}"
"And yet{pause_20_skippable} not a single\n"
"warrior has returned...{end_wait}"

msgctxt "message"
msgid "05154"
msgstr ""
"You don't look too strong,\n"
"but that may be for\n"
"the best.{end_wait}"

msgctxt "MsgBilibinIAlwaysBelievedThatTheOld"
msgid "05155"
msgstr ""
"I always believed that the\n"
"old tree in Kolima Forest\n"
"should be protected!{end_wait}"

msgctxt "MsgBilibinThisIsLadyMccoysRoomSo"
msgid "05156"
msgstr ""
"This is Lady McCoy's\n"
"room, so don't\n"
"touch anything.{end_wait}"

msgctxt "MsgBilibinHowManyTimesDoIHave"
msgid "05157"
msgstr ""
"How many times do I\n"
"have to tell them? Why\n"
"won't they leave me alone?{end_wait}"

msgctxt "MsgBilibinTheyShouldNeverHaveLetSuch"
msgid "05158"
msgstr ""
"They should never have\n"
"let such young children\n"
"into the palace!{page_break}"
"I'll be the one to get\n"
"yelled at if they break\n"
"an urn or something!{end_wait}"

msgctxt "MsgBilibinSendingTheseChildrenToKolimaForest"
msgid "05159"
msgstr ""
"Sending these children\n"
"to Kolima Forest?{page_break}"
"Do they want more\n"
"people to suffer the\n"
"curse?{end_wait}"

msgctxt "MsgBilibinIShouldntHaveSaidAnythingWhen"
msgid "05160"
msgstr ""
"I shouldn't have said\n"
"anything when they were\n"
"planning the new palace.{page_break}"
"I think I might have\n"
"caused them to cut\n"
"down the holy tree...{end_wait}"

msgctxt "MsgBilibinOfAllTheNerveComingInto"
msgid "05161"
msgstr ""
"Of all the nerve!\n"
"Coming into the\n"
"palace unescorted!?{end_wait}"

msgctxt "MsgBilibinMiladyWasRenownedFarAndWide"
msgid "05162"
msgstr ""
"Milady was renowned far\n"
"and wide for her beauty!{page_break}"
"That's why milord is so\n"
"anxious to please her,\n"
"regardless of cost.{end_wait}"

msgctxt "MsgBilibinOhSomedayIWantToSleep"
msgid "05163"
msgstr ""
"Oh, someday, I want to\n"
"sleep in a silk\n"
"nightgown like this.{end_wait}"

msgctxt "MsgBilibinWillIEverFindSomeoneTo"
msgid "05164"
msgstr ""
"Will I ever find someone\n"
"to make my dreams come\n"
"true, like milady did?{end_wait}"

msgctxt "MsgBilibinOhNoThisNightgownHasA"
msgid "05165"
msgstr ""
"Oh, no! This nightgown\n"
"has a hole...\n"
"Milady will be furious!{end_wait}"

msgctxt "MsgBilibinYouCanSeeKolimaPrettyWell"
msgid "05166"
msgstr ""
"You can see Kolima pretty\n"
"well from here.{page_break}"
"On sunny days, Lord\n"
"McCoy comes here to\n"
"admire the view.{end_wait}"

msgctxt "MsgBilibinHmmItSeemsTheCurseOf"
msgid "05167"
msgstr ""
"Hmm. It seems the curse\n"
"of the tree has not yet\n"
"come to Bilibin.{end_wait}"

msgctxt "MsgBilibinLordMccoyHasntComeHereFor"
msgid "05168"
msgstr ""
"Lord McCoy hasn't come\n"
"here for some time...{page_break}"
"It's because of the\n"
"curse, no doubt.{end_wait}"

msgctxt "MsgBilibinKolimaForestUsedToBeSo"
msgid "05169"
msgstr ""
"Kolima Forest used to be\n"
"so green. Once the holy\n"
"tree was cut down,{page_break}"
"everything began to\n"
"turn brown.\n"
"Is Kolima Forest dying...?{end_wait}"

msgctxt "MsgBilibinDoThinkTheseBilibinsGreat"
msgid "05170"
msgstr ""
"What do you think?\n"
"These are Bilibin's great\n"
"treasures.{page_break}"
"Whoever ends the curse\n"
"can claim these as his\n"
"own.{end_wait}"

msgctxt "message"
msgid "05171"
msgstr ""
"Pick any one of\n"
"the four treasures.{end_wait}"

msgctxt "MsgBilibinWeReallyGivingOurTreasure"
msgid "05172"
msgstr ""
"Are we really\n"
"giving our treasure\n"
"to these wimps?{end_wait}"

msgctxt "message"
msgid "05173"
msgstr ""
"You will get the rest\n"
"when you succeed.{end_wait}"

msgctxt "MsgBilibinGoodTreasureIfGetTurned"
msgid "05174"
msgstr ""
"What good is treasure\n"
"if you get turned\n"
"into a tree?{end_wait}"

msgctxt "MsgBilibinMatter"
msgid "05175"
msgstr "What's the matter, then?{end_wait}"

msgctxt "message"
msgid "05176"
msgstr ""
"Sir!{pause_20_skippable} Some new warriors\n"
"have just arrived\n"
"in the palace!{end_wait}"

msgctxt "message"
msgid "05177"
msgstr "New warriors, yeh say?{end_wait}"

msgctxt "message"
msgid "05178"
msgstr ""
"We've sent many a man\n"
"intae Kolima Forest, but\n"
"not a one has returned.{end_wait}"

msgctxt "message"
msgid "05179"
msgstr ""
"These{pause_20_skippable} warriors...\n"
"Did yeh get a good\n"
"look at 'em?{end_wait}"

msgctxt "message"
msgid "05180"
msgstr "Come closer, laddy.{end_wait}"

msgctxt "message"
msgid "05181"
msgstr ""
"Hey...{pause_20_skippable} Are these the\n"
"ones yeh were talking\n"
"about?{end_wait}"

msgctxt "message"
msgid "05182"
msgstr "They're but children!{end_wait}"

msgctxt "message"
msgid "05183"
msgstr ""
"And yeh expect me tae\n"
"believe yeh can save\n"
"Kolima?{end_now}"

msgctxt "MsgBilibinTooYoungForTheJob"
msgid "05184"
msgstr ""
"Bah! Yeh're too young.\n"
"Yeh cannae handle\n"
"the job.{end_wait}"

msgctxt "message"
msgid "05185"
msgstr "Yeh can leave now...{end_wait}"

msgctxt "MsgBilibinYehveChangeHeart"
msgid "05186"
msgstr ""
"What is it?{pause_20_skippable} Yeh've had\n"
"a change of heart? Yeh\n"
"want tae help Kolima?{end_now}"

msgctxt "MsgBilibinHmmmWellGrant"
msgid "05187"
msgstr ""
"Hmmm.{pause_20_skippable} Well, I'll grant\n"
"yeh're a brave lot.{end_wait}"

msgctxt "message"
msgid "05188"
msgstr ""
"Here. This key'll get\n"
"yeh past the barricades\n"
"tae the east...{end_wait}"

msgctxt "message"
msgid "05189"
msgstr ""
"Even with the key, such\n"
"wee lads as yerselves'll\n"
"never reach Kolima.{end_wait}"

msgctxt "message"
msgid "05190"
msgstr ""
"He's making fun of us!\n"
"Calling us children!{pause_20_skippable}{page_break}"
"That's just irritating,\n"
"don't you think, {actor_name:1}?{end_now}"

msgctxt "MsgBilibinSeriousDoesntBother"
msgid "05191"
msgstr ""
"Are you serious, {actor_name:1}?\n"
"It doesn't bother you?{end_now}"

msgctxt "MsgBilibinWellDontLet"
msgid "05192"
msgstr ""
"Well, don't let him\n"
"get to you.{page_break}"
"We'll just have to prove\n"
"we can handle this job,\n"
"whatever it is!{end_wait}"

msgctxt "message"
msgid "05193"
msgstr ""
"So, yeh've decided\n"
"to accept our little\n"
"job?{end_wait}"

msgctxt "message"
msgid "05194"
msgstr ""
"Hey, {actor_name:3}! You...\n"
"You don't look too\n"
"enthusiastic.{end_wait}"

msgctxt "message"
msgid "05195"
msgstr ""
"That curse can turn a\n"
"man into a tree!{pause_20_skippable}{page_break}"
"You think we\n"
"stand a chance?{end_wait}"

msgctxt "message"
msgid "05196"
msgstr ""
"What?{pause_20_skippable}\n"
"Yeah, of course we do!{end_wait}"

msgctxt "message"
msgid "05197"
msgstr ""
"You know we do,\n"
"right, {actor_name:1}?{end_now}"

msgctxt "MsgBilibinComeSaidYoud"
msgid "05198"
msgstr ""
"Come on, {actor_name:1}!\n"
"You said you'd do it!{pause_20_skippable}\n"
"We're still going, right?{end_now}"

msgctxt "MsgBilibinWellSGoing"
msgid "05199"
msgstr ""
"Well, if {actor_name:1}'s going,\n"
"I guess I'm in, too.{end_wait}"

msgctxt "message"
msgid "05200"
msgstr ""
"At least we all agree\n"
"on something!{end_wait}"

msgctxt "message"
msgid "05201"
msgstr ""
"What troubles you,\n"
"Milord?{pause_20_skippable}\n"
"They seem willing enough...{end_wait}"

msgctxt "message"
msgid "05202"
msgstr ""
"They call themselves\n"
"warriors...but they're\n"
"naught but wee children!{end_wait}"

msgctxt "message"
msgid "05203"
msgstr ""
"Aye, these are desperate\n"
"times, but I cannae send\n"
"such wee lads tae their doom!{end_wait}"

msgctxt "message"
msgid "05204"
msgstr ""
"Then what will happen\n"
"to Kolima Forest?{end_wait}"

msgctxt "message"
msgid "05205"
msgstr ""
"We cannae give up hope\n"
"on our other champions!{end_wait}"

msgctxt "message"
msgid "05206"
msgstr "But... But what about us?{end_wait}"

msgctxt "message"
msgid "05207"
msgstr ""
"We cannae send yeh\n"
"intae certain doom.{end_wait}"

msgctxt "message"
msgid "05208"
msgstr ""
"What if we said\n"
"that we were going\n"
"east anyway?{end_wait}"

msgctxt "message"
msgid "05209"
msgstr ""
"Yeh can go once things\n"
"have settled down.{end_wait}"

msgctxt "message"
msgid "05210"
msgstr ""
"But that means...\n"
"you're not going to\n"
"let us go?{end_wait}"

msgctxt "message"
msgid "05211"
msgstr ""
"Ach, it's fer yer\n"
"own good, lad.{end_wait}"

msgctxt "message"
msgid "05212"
msgstr ""
"I dinnae want tae talk\n"
"about it anymore.\n"
"Captain?{end_wait}"

msgctxt "message"
msgid "05213"
msgstr ""
"I'm sorry,{pause_20_skippable}\n"
"but you should leave now.{end_wait}"

msgctxt "MsgBilibinNameSorryRejected"
msgid "05214"
msgstr ""
"Your name was...{actor_name:1}?\n"
"I'm sorry you were\n"
"rejected.{end_wait}"

msgctxt "message"
msgid "05215"
msgstr ""
"I never, ever, expected\n"
"anything like this to\n"
"happen to Bilibin.{end_wait}"

msgctxt "message"
msgid "05216"
msgstr ""
"Will you promise me\n"
"you won't go to Kolima?{end_now}"

msgctxt "message"
msgid "05217"
msgstr "That's good.{end_wait}"

msgctxt "message"
msgid "05218"
msgstr ""
"You are persistent,\n"
"aren't you?{end_wait}"

msgctxt "message"
msgid "05219"
msgstr ""
"That barricade...{pause_20_skippable}\n"
"You{pause_20_skippable} may not need a key.{end_wait}"

msgctxt "message"
msgid "05220"
msgstr ""
"Oops...{pause_20_skippable} I shouldn't have\n"
"said anything.{end_wait}"

msgctxt "message"
msgid "05221"
msgstr "Well, I'm going to go now.{end_wait}"

msgctxt "MsgBilibinSorryLadsButKolimasFutureIs"
msgid "05222"
msgstr ""
"Sorry, lads, but Kolima's\n"
"future is best left to\n"
"more experienced men.{end_wait}"

msgctxt "MsgBilibinHeyIfYouCantDoThe"
msgid "05223"
msgstr ""
"Hey!\n"
"If you can't do the job,\n"
"you don't get the reward!{end_wait}"

msgctxt "MsgBilibinICantTellYouAnythingElse"
msgid "05224"
msgstr ""
"I can't tell you\n"
"anything else.{page_break}"
"So don't even ask!{end_wait}"

msgctxt "MsgBilibinWhatAShameHuhIGuess"
msgid "05225"
msgstr ""
"What a shame, huh?\n"
"I guess you need to\n"
"be a little older.{end_wait}"

msgctxt "MsgBilibinThereIsNothingMoreToTalk"
msgid "05226"
msgstr ""
"There is nothing more\n"
"to talk about!{page_break}"
"Tell them to go.\n"
"I don't care how\n"
"often they return!{end_wait}"

msgctxt "MsgBilibinItsAToughThingBeingSo"
msgid "05227"
msgstr ""
"It's a tough thing,\n"
"being so young.{page_break}"
"They dinnae ken\n"
"what it means to be\n"
"afraid.{end_wait}"

msgctxt "MsgBilibinThatBarricadeIsPrettyShabbyIt"
msgid "05228"
msgstr ""
"That barricade is pretty\n"
"shabby... It was\n"
"rushed, you see?{page_break}"
"The hinges on the\n"
"barricade are quite noisy.\n"
"They might break easily.{end_wait}"

msgctxt "MsgBilibinIDidntThinkTheydLetYou"
msgid "05229"
msgstr ""
"I didn't think they'd\n"
"let you go...\n"
"You're too young!{end_wait}"

msgctxt "MsgBilibinMccoysHiddenWarehouseDoNot"
msgid "05230"
msgstr ""
"McCoy's Hidden Warehouse\n"
"     Do Not Enter!{end_wait}"

msgctxt "MsgBilibinEvenFrozenImilMustFeel"
msgid "05231"
msgstr ""
"Even frozen Imil must\n"
"feel warm with that\n"
"wonderful {actor_name:4} around!{end_wait}"

msgctxt "MsgBilibinThereTreeLooksLikePerson"
msgid "05232"
msgstr ""
"There is a tree that\n"
"looks like a person.{end_wait}"

msgctxt "MsgBilibinTheyreSoHeavy"
msgid "05233"
msgstr "They're...{pause_20_skippable} so heavy...{end_wait}"

msgctxt "MsgBilibinAreaOffLimitsThoseWithout"
msgid "05234"
msgstr ""
"This area is off-limits to\n"
"all those without a permit.\n"
"     {em_dash}Lord McCoy{end_wait}"

msgctxt "MsgKolimaQuiet"
msgid "05235"
msgstr "It's so quiet...{end_wait}"

msgctxt "MsgKolimaMatterIvan"
msgid "05236"
msgstr "What is the matter, {actor_name:3}?{end_wait}"

msgctxt "message"
msgid "05237"
msgstr "This tree...was a person.{end_wait}"

msgctxt "message"
msgid "05238"
msgstr ""
"Everyone in Kolima has\n"
"been turned into a tree.{end_wait}"

msgctxt "message"
msgid "05239"
msgstr ""
"It's horrible! All these\n"
"trees with clothes are\n"
"really Kolima's villagers!{end_wait}"

msgctxt "message"
msgid "05240"
msgstr ""
"Why? Do you know\n"
"why this happened?{end_now}"

msgctxt "message"
msgid "05241"
msgstr ""
"I see...{pause_20_skippable} It was\n"
"because they hurt\n"
"the holy tree?{end_wait}"

msgctxt "message"
msgid "05242"
msgstr ""
"I see...\n"
"Who could have known?{end_wait}"

msgctxt "MsgKolimaWhatIsIt"
msgid "05243"
msgstr "What is it now, {actor_name:3}?{end_wait}"

msgctxt "MsgKolimaSparklyStuffOnGround"
msgid "05244"
msgstr ""
"That sparkly stuff\n"
"on the ground...\n"
"What is it?{end_wait}"

msgctxt "message"
msgid "05245"
msgstr "{text_effect:4}Aaah!{pause_20_skippable} What's happening!?{end_wait}"

msgctxt "message"
msgid "05246"
msgstr ""
"{text_effect:4}My mind!!!\n"
"Someone{pause_20_skippable} is attacking my{em_dash}{end_wait}"

msgctxt "message"
msgid "05247"
msgstr ""
"{text_effect:4}I...{pause_20_skippable} I can't...\n"
"I can't even stand up!{end_wait}"

msgctxt "message"
msgid "05248"
msgstr ""
"What is that?{pause_20_skippable}\n"
"Something's falling from\n"
"the sky!{end_wait}"

msgctxt "message"
msgid "05249"
msgstr ""
"It's sparkling!{pause_20_skippable}{pause_20_skippable}\n"
"Could this be{pause_20_skippable} what turned\n"
"those people into...{end_wait}"

msgctxt "message"
msgid "05250"
msgstr ""
"We've got to get\n"
"out of here!{end_wait}"

msgctxt "message"
msgid "05251"
msgstr "I can't!{pause_20_skippable} I can't move!!{end_wait}"

msgctxt "message"
msgid "05252"
msgstr ""
"Oh, no...{pause_20_skippable}\n"
"If it touches us,\n"
"we'll turn into trees!{end_wait}"

msgctxt "message"
msgid "05253"
msgstr ""
"{actor_name:1}... What just\n"
"happened to us?{page_break}"
"That barrier...\n"
"Did it save us?{end_now}"

msgctxt "message"
msgid "05254"
msgstr ""
"I think so, too, {actor_name:1}.{page_break}"
"I think I know what\n"
"those domes were...{end_wait}"

msgctxt "message"
msgid "05255"
msgstr ""
"No, I think {actor_name:2}\n"
"is right.{page_break}"
"I think I know what\n"
"those domes were...{end_wait}"

msgctxt "MsgKolimaKnowThoseFieldsWere"
msgid "05256"
msgstr ""
"You know what\n"
"those fields were?{end_wait}"

msgctxt "MsgKolimaWasOurPsynergy"
msgid "05257"
msgstr "It was our Psynergy.{end_wait}"

msgctxt "message"
msgid "05258"
msgstr "What are you, crazy?{end_wait}"

msgctxt "message"
msgid "05259"
msgstr ""
"I didn't use\n"
"any Psynergy!{end_wait}"

msgctxt "message"
msgid "05260"
msgstr ""
"Hey...{pause_20_skippable}{pause_20_skippable} I can "
"stand...{pause_20_skippable}\n"
"I can move again!{end_wait}"

msgctxt "message"
msgid "05261"
msgstr ""
"You're right.\n"
"I can stand, too...{end_wait}"

msgctxt "message"
msgid "05262"
msgstr ""
"{actor_name:3}, it's okay!\n"
"Go ahead!{pause_20_skippable} Stand up!{end_wait}"

msgctxt "message"
msgid "05263"
msgstr "Those barriers...{end_wait}"

msgctxt "message"
msgid "05264"
msgstr ""
"We thought that{pause_20_skippable} Psynergy\n"
"was only used when we\n"
"concentrate, right?{end_now}"

msgctxt "message"
msgid "05265"
msgstr "You're such a liar, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "05266"
msgstr ""
"When I was training, I'd\n"
"focus so hard, I thought\n"
"my head would burst.{end_wait}"

msgctxt "message"
msgid "05267"
msgstr ""
"Well, maybe it's just\n"
"easier for you, but\n"
"when I use Psynergy...{end_wait}"

msgctxt "message"
msgid "05268"
msgstr ""
"But what? The only way\n"
"you can use Psynergy is\n"
"by concentrating!{end_wait}"

msgctxt "message"
msgid "05269"
msgstr ""
"Anyway, I'm certain that\n"
"was Psynergy we\n"
"were projecting.{end_wait}"

msgctxt "message"
msgid "05270"
msgstr ""
"That must mean that\n"
"some Psynergy acts only\n"
"when it's needed.{end_wait}"

msgctxt "message"
msgid "05271"
msgstr ""
"You mean, like when\n"
"we're in danger?{end_wait}"

msgctxt "message"
msgid "05272"
msgstr ""
"I think it's like\n"
"when we strike critical\n"
"hits in battle.{page_break}"
"We can't control it,\n"
"but it's there when\n"
"we need it.{end_wait}"

msgctxt "message"
msgid "05273"
msgstr ""
"I can agree with what\n"
"{actor_name:2} is saying. It is\n"
"definitely possible...{end_wait}"

msgctxt "message"
msgid "05274"
msgstr ""
"Wouldn't it be something\n"
"if we could use this\n"
"power at any time, {actor_name:1}?{end_now}"

msgctxt "message"
msgid "05275"
msgstr ""
"Yeah! Let's start\n"
"trying to master\n"
"this power!{end_wait}"

msgctxt "message"
msgid "05276"
msgstr ""
"You...{pause_20_skippable}{pause_20_skippable}\n"
"You're not really into\n"
"this, are you?{end_wait}"

msgctxt "MsgKolimaWatchOutItsHappeningAgain"
msgid "05277"
msgstr ""
"Watch out!\n"
"It's happening again!{end_wait}"

msgctxt "message"
msgid "05278"
msgstr ""
"Hroom!{pause_20_skippable} Why?{pause_20_skippable}{pause_20_skippable} Why "
"don't\n"
"they turn into trees...?{end_wait}"

msgctxt "message"
msgid "05279"
msgstr "Who are they?{end_wait}"

msgctxt "message"
msgid "05280"
msgstr ""
"What people are these,\n"
"who are immune to\n"
"Tret's glamour?{end_wait}"

msgctxt "message"
msgid "05281"
msgstr ""
"Have they come to save\n"
"that village with\n"
"their strange powers?{end_wait}"

msgctxt "message"
msgid "05282"
msgstr ""
"It will not be enough{pause_20_skippable}\n"
"to save the people\n"
"of Kolima.{end_wait}"

msgctxt "message"
msgid "05283"
msgstr ""
"They have earned\n"
"their fate...{page_break}"
"Kolima took their axes\n"
"to me, and now I shall\n"
"take mine to them!{end_wait}"

msgctxt "message"
msgid "05284"
msgstr ""
"You children may not know\n"
"this...but we are{pause_20_skippable} dying.{end_wait}"

msgctxt "message"
msgid "05285"
msgstr ""
"And Kolima Forest will\n"
"wither and die when\n"
"we are gone.{end_wait}"

msgctxt "message"
msgid "05286"
msgstr ""
"We are not the only ones\n"
"who will die, Laurel.{page_break}"
"Once we are gone,\n"
"they, too, will go!{end_wait}"

msgctxt "message"
msgid "05287"
msgstr ""
"Tret was once a kindly\n"
"forest king.{end_wait}"

msgctxt "message"
msgid "05288"
msgstr ""
"But he is slowly dying,\n"
"and his heart has\n"
"torn in two...{end_wait}"

msgctxt "message"
msgid "05289"
msgstr ""
"His wrathful side turned\n"
"the people of Kolima\n"
"into trees.{end_wait}"

msgctxt "message"
msgid "05290"
msgstr ""
"The kind Tret\n"
"speaks no more.{end_wait}"

msgctxt "message"
msgid "05291"
msgstr ""
"Hroom!{pause_20_skippable} The kindly heart\n"
"invites destruction...{pause_20_skippable}{pause_20_skippable}\n"
"I need no kindness!{end_wait}"

msgctxt "message"
msgid "05292"
msgstr ""
"If you wish to save\n"
"those whom Tret turned\n"
"into trees,{page_break}"
"you must reawaken\n"
"his gentle side.{end_wait}"

msgctxt "message"
msgid "05293"
msgstr ""
"But...{pause_20_skippable}if you cannot\n"
"stop Tret from withering,\n"
"we all will...{end_wait}"

msgctxt "message"
msgid "05294"
msgstr ""
"Look for Tret deep\n"
"within the forest.{end_wait}"

msgctxt "message"
msgid "05295"
msgstr ""
"It's no use, Laurel.{pause_20_skippable}\n"
"Humans cannot be trusted!{page_break}"
"I shall die...{pause_20_skippable}and the\n"
"rest of the forest\n"
"will die with me!{end_wait}"

msgctxt "message"
msgid "05296"
msgstr ""
"{actor_name:1}...{pause_20_skippable}\n"
"Isn't there anything\n"
"we can do?{end_now}"

msgctxt "message"
msgid "05297"
msgstr ""
"What can we do?{pause_20_skippable}\n"
"Do you have any idea?{end_now}"

msgctxt "message"
msgid "05298"
msgstr ""
"It looks like {actor_name:1} has\n"
"something in mind.{end_wait}"

msgctxt "message"
msgid "05299"
msgstr ""
"We'll leave it up to\n"
"you, {actor_name:1}.\n"
"Let's go save everyone.{end_wait}"

msgctxt "MsgKolimaHesAsStumpedAsWe"
msgid "05300"
msgstr ""
"He's as stumped as we\n"
"are{pause_20_skippable}, but he says he'll\n"
"help...{end_wait}"

msgctxt "message"
msgid "05301"
msgstr ""
"I trust {actor_name:1}.{pause_20_skippable}\n"
"He'll come up with\n"
"an idea.{end_wait}"

msgctxt "MsgKolimaYoureIsaacThereIsntMuch"
msgid "05302"
msgstr ""
"You're right, {actor_name:1}...\n"
"There isn't much we can\n"
"do now.{end_wait}"

msgctxt "message"
msgid "05303"
msgstr ""
"So{pause_20_skippable} the people of Kolima\n"
"will just remain trees\n"
"until they wither and die?{end_now}"

msgctxt "message"
msgid "05304"
msgstr ""
"I'm disappointed in you,\n"
"{actor_name:1}...{pause_20_skippable} How can you\n"
"give up so easily?{end_wait}"

msgctxt "message"
msgid "05305"
msgstr ""
"That's right...\n"
"We can't just leave\n"
"them to rot!{end_wait}"

msgctxt "message"
msgid "05306"
msgstr ""
"But{pause_20_skippable} how can we bring\n"
"back the nice Tret and\n"
"save the village?{end_wait}"

msgctxt "message"
msgid "05307"
msgstr ""
"I guess I really don't\n"
"know what to do.{end_wait}"

msgctxt "message"
msgid "05308"
msgstr ""
"{actor_name:3}, you can't give\n"
"up!{pause_20_skippable} Please,{pause_20_skippable} convince him\n"
"to help!{end_wait}"

msgctxt "message"
msgid "05309"
msgstr ""
"Just promise me this\n"
"one thing...{end_wait}"

msgctxt "message"
msgid "05310"
msgstr ""
"Promise{pause_20_skippable} you will do\n"
"everything in your power\n"
"to save Kolima.{end_wait}"

msgctxt "MsgKolimaThatsReliefIsaacThoughtYoud"
msgid "05311"
msgstr ""
"That's a relief, {actor_name:1}.{pause_20_skippable}\n"
"I thought you'd given up\n"
"on Kolima altogether.{end_wait}"

msgctxt "message"
msgid "05312"
msgstr ""
"I was beginning to lose\n"
"faith in you, {actor_name:1}.{end_wait}"

msgctxt "message"
msgid "05313"
msgstr ""
"But what can we do?{pause_20_skippable}\n"
"How can we bring\n"
"back the good Tret{page_break}"
"and save Kolima?{end_wait}"

msgctxt "message"
msgid "05314"
msgstr ""
"I really don't have any\n"
"idea right now...{end_wait}"

msgctxt "message"
msgid "05315"
msgstr ""
"I'm not sure...\n"
"What should we do?{end_wait}"

msgctxt "message"
msgid "05316"
msgstr ""
"I don't know just yet...\n"
"But I'm sure we'll think\n"
"of something.{end_wait}"

msgctxt "message"
msgid "05317"
msgstr ""
"Well,{pause_20_skippable} let's get on\n"
"with it!{end_wait}"

msgctxt "message"
msgid "05318"
msgstr ""
"It's you...{pause_20_skippable} Soon, we will\n"
"all wither with Tret.{page_break}"
"You will not be\n"
"safe in the forest.\n"
"You must leave now.{end_wait}"

msgctxt "message"
msgid "05319"
msgstr ""
"Leave now...\n"
"before this forest\n"
"dies.{end_wait}"

msgctxt "MsgKolimaHealingWatersMercuryLighthouseMight"
msgid "05320"
msgstr ""
"The healing waters of\n"
"Mercury Lighthouse\n"
"might save Tret...{page_break}"
"But the fountain's\n"
"waters have long since\n"
"dried up...{end_wait}"

msgctxt "MsgKolimaSilence"
msgid "05321"
msgstr ""
".{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}{end_wait}"

msgctxt "message"
msgid "05322"
msgstr ""
"Hroooom! He will not\n"
"speak to you, child!{end_wait}"

msgctxt "message"
msgid "05323"
msgstr ""
"I control all in\n"
"Tret's realm!{end_wait}"

msgctxt "MsgKolimaControlTretsHeartShallNot"
msgid "05324"
msgstr ""
"I control Tret's heart!\n"
"I shall not let you\n"
"do anything to him!{end_wait}"

msgctxt "message"
msgid "05325"
msgstr ""
"Tret, the forest, and the\n"
"village of Kolima all\n"
"shall wither with me!{end_wait}"

msgctxt "MsgTretHmHrooom"
msgid "05326"
msgstr "Hm{pause_20_skippable} HROOOM!!!{end_wait}"

msgctxt "message"
msgid "05327"
msgstr ""
"You!\n"
"You hoped to find\n"
"my kindly self?{end_wait}"

msgctxt "message"
msgid "05328"
msgstr ""
"Fools!{pause_20_skippable}{page_break}"
"You should never have\n"
"come here, and now,\n"
"you shall never leave!{end_wait}"

msgctxt "message"
msgid "05329"
msgstr ""
"Your powers protected\n"
"you in the forest,{page_break}"
"but now you are in the\n"
"heart of my power!{end_wait}"

msgctxt "message"
msgid "05330"
msgstr ""
"Here, you will all become\n"
"trees, and you'll wither\n"
"with the rest of us!{end_wait}"

msgctxt "MsgTretMmmmm"
msgid "05331"
msgstr "Oh...{pause_20_skippable} Mmmmm...{end_wait}"

msgctxt "message"
msgid "05332"
msgstr ""
"What has happened\n"
"to me?{end_wait}"

msgctxt "message"
msgid "05333"
msgstr ""
"Was I...{pause_20_skippable} I see...{pause_20_skippable}\n"
"My heart was all\n"
"but lost in my rage.{end_wait}"

msgctxt "message"
msgid "05334"
msgstr ""
"And you{pause_20_skippable} defeated\n"
"the evil within me?{end_wait}"

msgctxt "message"
msgid "05335"
msgstr ""
"I thank you.{pause_20_skippable} I could not\n"
"leave this world with\n"
"so much evil in my heart.{end_wait}"

msgctxt "message"
msgid "05336"
msgstr ""
"I am free now to leave\n"
"the world without regret.{pause_20_skippable}\n"
"Good-bye, great warriors.{end_wait}"

msgctxt "message"
msgid "05337"
msgstr ""
"Hey! Wait a minute!\n"
"We can't let Tret\n"
"die like this!{end_wait}"

msgctxt "message"
msgid "05338"
msgstr ""
"That's right, {actor_name:1}.\n"
"We still need his help!!{end_wait}"

msgctxt "message"
msgid "05339"
msgstr ""
".{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}What?{end_wait}"

msgctxt "message"
msgid "05340"
msgstr ""
"Why have you not left\n"
"me to my dying?\n"
"Do you need something?{end_now}"

msgctxt "MsgTretDoingNowsNot"
msgid "05341"
msgstr ""
"What are you doing,\n"
"{actor_name:1}! Now's not the\n"
"time to fool around!{end_wait}"

msgctxt "message"
msgid "05342"
msgstr ""
"That's right, {actor_name:1}...{pause_20_skippable}{page_break}"
"We have to save\n"
"everyone in Kolima!{end_wait}"

msgctxt "MsgTretTurnedPeopleKolima"
msgid "05343"
msgstr ""
"I{pause_20_skippable} turned the people\n"
"of Kolima into trees?{end_wait}"

msgctxt "message"
msgid "05344"
msgstr ""
"Hroom! I must release\n"
"them before they die\n"
"with the forest!{end_wait}"

msgctxt "message"
msgid "05345"
msgstr ""
"I can't do it...{pause_20_skippable} My power\n"
"no longer reaches\n"
"Kolima...{end_wait}"

msgctxt "message"
msgid "05346"
msgstr ""
"People of Kolima...\n"
"Forgive me...{end_wait}"

msgctxt "message"
msgid "05347"
msgstr ""
"Tret's too weak! He\n"
"doesn't have the power to\n"
"save Kolima.{end_wait}"

msgctxt "message"
msgid "05348"
msgstr ""
"No! We have\n"
"to heal him!{page_break}"
"We can't let the\n"
"people of Kolima die\n"
"with the forest!{end_wait}"

msgctxt "message"
msgid "05349"
msgstr ""
"Every life in Kolima\n"
"depends on us!{end_wait}"

msgctxt "message"
msgid "05350"
msgstr ""
"We have to restore Tret\n"
"and save the people\n"
"of Kolima!{end_wait}"

msgctxt "message"
msgid "05351"
msgstr "Let's go, {actor_name:1}.{end_wait}"

msgctxt "message"
msgid "05352"
msgstr "Let's try the water!{end_wait}"

msgctxt "message"
msgid "05353"
msgstr ""
"Surely that will\n"
"revive Tret!{end_wait}"

msgctxt "message"
msgid "05354"
msgstr "Hurry, {actor_name:1}.{end_wait}"

msgctxt "MsgKolimaSilence2"
msgid "05355"
msgstr ""
".{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}{end_wait}"

msgctxt "MsgKolimaPeopleKolimaForgiveMe"
msgid "05356"
msgstr ""
"People of Kolima...\n"
"Forgive me...{end_wait}"

msgctxt "MsgKolimaWaterHermesSeepedIntoTret"
msgid "05357"
msgstr ""
"The Water of Hermes\n"
"seeped into Tret.{end_wait}"

msgctxt "MsgKolimaFeelGreatPowerSpreadingThrough"
msgid "05358"
msgstr ""
"I feel a great power\n"
"spreading through me...{end_wait}"

msgctxt "message"
msgid "05359"
msgstr ""
"Hroooom...{pause_20_skippable} Life flows\n"
"within me once again.{end_wait}"

msgctxt "message"
msgid "05360"
msgstr "Tret...{end_wait}"

msgctxt "message"
msgid "05361"
msgstr ""
"As you have recovered,\n"
"so has our forest...{end_wait}"

msgctxt "message"
msgid "05362"
msgstr ""
"I am sorry to have\n"
"worried you so, Laurel.{end_wait}"

msgctxt "message"
msgid "05363"
msgstr ""
"And you, young ones...\n"
"Didn't you have a\n"
"favor to ask of me?{end_now}"

msgctxt "message"
msgid "05364"
msgstr ""
"Yes, Tret...{pause_20_skippable} You must turn\n"
"the people of Kolima\n"
"into humans again.{end_wait}"

msgctxt "message"
msgid "05365"
msgstr ""
"Yes, that's right...\n"
"I must hurry.{end_wait}"

msgctxt "message"
msgid "05366"
msgstr ""
"{actor_name:1}! Did you forget?\n"
"We need to save\n"
"the people of Kolima!{end_wait}"

msgctxt "message"
msgid "05367"
msgstr ""
"Tret should be able to do\n"
"it, now that his energy\n"
"has returned.{end_wait}"

msgctxt "message"
msgid "05368"
msgstr ""
"Ask him to save\n"
"everyone he turned\n"
"into a tree!{end_wait}"

msgctxt "message"
msgid "05369"
msgstr ""
"Please, Tret... You have\n"
"to save those whom\n"
"you turned into trees.{end_wait}"

msgctxt "message"
msgid "05370"
msgstr ""
"That's right...\n"
"I must hurry.{end_wait}"

msgctxt "MsgKolimaShouldDoPeopleKolimaCursed"
msgid "05371"
msgstr ""
"That should do it.{pause_20_skippable}\n"
"The people of Kolima are\n"
"cursed no more.{end_wait}"

msgctxt "message"
msgid "05372"
msgstr ""
"Tret did not always\n"
"possess this horrible\n"
"power.{end_wait}"

msgctxt "message"
msgid "05373"
msgstr ""
"It only started when\n"
"those strange gemstones\n"
"fell from the sky.{end_wait}"

msgctxt "message"
msgid "05374"
msgstr ""
"Gems from the sky...\n"
"Do you think he means\n"
"the Psynergy Stones?{end_now}"

msgctxt "message"
msgid "05375"
msgstr ""
"You really think\n"
"Psynergy Stones caused\n"
"all of this trouble?{end_wait}"

msgctxt "message"
msgid "05376"
msgstr ""
"I know you don't want\n"
"to believe it, but\n"
"nothing else makes sense...{end_wait}"

msgctxt "MsgKolimaWasIndeedAngryPeopleHad"
msgid "05377"
msgstr ""
"I was indeed angry that\n"
"people had laid waste\n"
"to my forest...{page_break}"
"They had even taken\n"
"their axes to me!{end_wait}"

msgctxt "message"
msgid "05378"
msgstr ""
"Then those gems fell\n"
"into my branches...{end_wait}"

msgctxt "message"
msgid "05379"
msgstr ""
"Then all of a sudden...\n"
"my fury overwhelmed me,\n"
"and I was lost in anger!{end_wait}"

msgctxt "message"
msgid "05380"
msgstr ""
"The gem reached me\n"
"when I was filled\n"
"with sorrow...{end_wait}"

msgctxt "message"
msgid "05381"
msgstr ""
"Our actions spoke our\n"
"hearts' desires, but we\n"
"had no idea...{end_wait}"

msgctxt "message"
msgid "05382"
msgstr ""
"Those gems twisted my\n"
"anger into a force\n"
"beyond my control.{end_wait}"

msgctxt "message"
msgid "05383"
msgstr ""
"Have any of the saplings\n"
"been transformed by those\n"
"stones, Tret?{end_wait}"

msgctxt "message"
msgid "05384"
msgstr ""
"No... Only the elder trees\n"
"were affected by the\n"
"falling Psynergy Stones.{end_wait}"

msgctxt "message"
msgid "05385"
msgstr ""
"There are others that\n"
"this happened to?{end_wait}"

msgctxt "message"
msgid "05386"
msgstr ""
"So the same thing could\n"
"be happening elsewhere!{end_wait}"

msgctxt "message"
msgid "05387"
msgstr ""
"You must have fought\n"
"many monsters on your\n"
"way here.{end_wait}"

msgctxt "message"
msgid "05388"
msgstr ""
"Those monsters...\n"
"Maybe they were just\n"
"animals that were...{end_wait}"

msgctxt "message"
msgid "05389"
msgstr ""
"Once, they were pure\n"
"of heart... Hroom...{page_break}"
"Those gems have brought\n"
"a great evil to\n"
"the world...{end_wait}"

msgctxt "message"
msgid "05390"
msgstr ""
"Oh! Laurel, you were\n"
"given powers, too?{end_wait}"

msgctxt "message"
msgid "05391"
msgstr ""
"Different from my own,\n"
"but stemming from\n"
"the same source.{end_wait}"

msgctxt "message"
msgid "05392"
msgstr ""
"Laurel! What in the world\n"
"are you doing?{end_wait}"

msgctxt "message"
msgid "05393"
msgstr "Wait. You will soon see.{end_wait}"

msgctxt "message"
msgid "05394"
msgstr "What did you see, Laurel?{end_wait}"

msgctxt "message"
msgid "05395"
msgstr ""
"It's true{em_dash}even the\n"
"animals have become\n"
"monsters.{page_break}"
"And beyond the river...{end_wait}"

msgctxt "message"
msgid "05396"
msgstr ""
"The river that\n"
"feeds our forest?{end_wait}"

msgctxt "message"
msgid "05397"
msgstr ""
"Yes... An evil forest\n"
"has risen up to the\n"
"south of the river.{end_wait}"

msgctxt "message"
msgid "05398"
msgstr ""
"Will you be heading\n"
"south across the river?{end_now}"

msgctxt "message"
msgid "05399"
msgstr ""
"That area will only\n"
"grow more dangerous as\n"
"time passes...{page_break}"
"If you must go, you'd\n"
"better hurry.{end_wait}"

msgctxt "message"
msgid "05400"
msgstr ""
"That's good... It would\n"
"be foolish to risk\n"
"your lives further.{end_wait}"

msgctxt "MsgKolimaOweGreatDebtHaveSaved"
msgid "05401"
msgstr ""
"I owe you a great debt.\n"
"You have saved Kolima,\n"
"the forest, and me.{end_wait}"

msgctxt "message"
msgid "05402"
msgstr ""
"May your roots dig\n"
"deep and your branches\n"
"reach high.{end_wait}"

msgctxt "message"
msgid "05403"
msgstr ""
"Were you surprised,\n"
"{actor_name:1}? We trees have\n"
"grown quite powerful.{end_wait}"

msgctxt "MsgKolimaNowHaveSuchPowerAxe"
msgid "05404"
msgstr ""
"Now that I have such\n"
"power, no axe shall ever\n"
"touch me again.{page_break}"
"You may depart\n"
"with no worries.{end_wait}"

msgctxt "MsgKolimaForestKolimaAlive"
msgid "05405"
msgstr ""
"The forest of Kolima\n"
"is alive once again,\n"
"thanks to you...{page_break}"
"We shall protect the\n"
"forest from now on.{end_wait}"

msgctxt "MsgKolimaKnowCannotStopButPlease"
msgid "05406"
msgstr ""
"I know that I cannot stop\n"
"you, but please be\n"
"careful beyond the river.{end_wait}"

msgctxt "MsgKolimaMustHorribleBeyondRiverAm"
msgid "05407"
msgstr ""
"It must be horrible\n"
"beyond the river...{page_break}"
"I am so worried about\n"
"you and your friends,\n"
"{actor_name:1}.{end_wait}"

msgctxt "MsgKolimaWho"
msgid "05408"
msgstr "Who are you...?{end_wait}"

msgctxt "message"
msgid "05409"
msgstr ""
"Oh!{pause_20_skippable} You are the ones who\n"
"resisted Tret's glamour?{end_wait}"

msgctxt "message"
msgid "05410"
msgstr ""
"I sense a great warmth\n"
"within you...{end_wait}"

msgctxt "message"
msgid "05411"
msgstr ""
"If you came to rescue\n"
"Tret, you are already\n"
"too late. {end_wait}"

msgctxt "message"
msgid "05412"
msgstr ""
"Soon, Tret will die,\n"
"and we shall wither\n"
"away without him.{page_break}"
"Leave now, before this\n"
"forest is destroyed...{end_wait}"

msgctxt "MsgKolimaLeaveBeforeForest"
msgid "05413"
msgstr ""
"Leave now, before this\n"
"forest is destroyed...{end_wait}"

msgctxt "MsgKolimaDoNotTouchFloodgate"
msgid "05414"
msgstr ""
"\"Do not touch\n"
"Floodgate Switch!\"{end_wait}"

msgctxt "message"
msgid "05415"
msgstr ""
"The sign reads: \"You\n"
"can't read this sign\n"
"from the back!\"{end_wait}"

msgctxt "MsgFieldFlippedSwitch"
msgid "05416"
msgstr ""
"{protagonist_name} flipped\n"
"the switch.{end_wait}"

msgctxt "MsgImilBrrrrrChooImFreezingMia"
msgid "05417"
msgstr ""
"{text_effect:4}Brrrrr...\n"
"Ah-choo!!!{pause_20_skippable} I'm freezing!{page_break}"
"Is {actor_name:4} here yet?{end_wait}"

msgctxt "MsgImilHiNewInImil"
msgid "05418"
msgstr "Hi! Are you new in Imil?{end_now}"

msgctxt "message"
msgid "05419"
msgstr ""
"I should warn you,\n"
"there's a bad cold going\n"
"around right now.{page_break}"
"Try not to catch it.{end_wait}"

msgctxt "message"
msgid "05420"
msgstr ""
"You don't look familiar.\n"
"Are you sure you're\n"
"not...fibbing?{end_wait}"

msgctxt "MsgImilOneTwoThreeFour"
msgid "05421"
msgstr ""
"One,{pause_20_skippable} two,{pause_20_skippable} "
"three{pause_20_skippable}, four! {end_wait}"

msgctxt "message"
msgid "05422"
msgstr ""
"I tend to stay indoors\n"
"a lot when the weather\n"
"turns cold.{page_break}"
"It's not good for your\n"
"health, though, so I\n"
"try to work out.{end_wait}"

msgctxt "MsgImilMiaShouldHereByNow"
msgid "05423"
msgstr ""
"{text_effect:4}{actor_name:4} should be here\n"
"by now! Where is she?{end_wait}"

msgctxt "MsgImilWeveHadALotOfStrangers"
msgid "05424"
msgstr ""
"We've had a lot of\n"
"strangers lately.{page_break}"
"I wonder if they're going\n"
"to Mercury Lighthouse,\n"
"too...{end_wait}"

msgctxt "MsgImilPeopleGetSickBecauseTheyStay"
msgid "05425"
msgstr ""
"People get sick because\n"
"they stay indoors all day,\n"
"hiding from the cold.{page_break}"
"You have to keep in\n"
"shape if you don't want\n"
"to get sick!{end_wait}"

msgctxt "MsgImilTheresBeenAnEpidemicGoingAround"
msgid "05426"
msgstr ""
"There's been an\n"
"epidemic going\n"
"around Imil.{page_break}"
"You should leave right\n"
"away if you don't want\n"
"to catch it.{end_wait}"

msgctxt "MsgImilMiaRunningAroundTownCaring"
msgid "05427"
msgstr ""
"{actor_name:4} is running around\n"
"town, caring for the sick.{page_break}"
"I just don't want to\n"
"be any more trouble\n"
"to her.{end_wait}"

msgctxt "MsgMercuryOoohHelpMe"
msgid "05428"
msgstr "{text_effect:4}Oooh...{pause_20_skippable} Help me...{end_wait}"

msgctxt "message"
msgid "05429"
msgstr ""
"Grandpa!{pause_20_skippable} Grandpa!\n"
"Hold on!{end_wait}"

msgctxt "message"
msgid "05430"
msgstr "Oh, no!{pause_20_skippable} This is terrible!{end_wait}"

msgctxt "message"
msgid "05431"
msgstr ""
"Get {actor_name:4}...{pause_20_skippable}\n"
"Please, get {actor_name:4}!{end_wait}"

msgctxt "MsgImilItHurts"
msgid "05432"
msgstr "{text_effect:4}It hurts...{end_wait}"

msgctxt "MsgImilGetMiaHurry"
msgid "05433"
msgstr "Get {actor_name:4}... Hurry!{end_wait}"

msgctxt "MsgImilOoohIDontFeelSoGood"
msgid "05434"
msgstr ""
"{text_effect:4}Oooh...{pause_20_skippable}{pause_20_skippable} I don't feel "
"so\n"
"good{pause_20_skippable}... Am I going to die?{end_wait}"

msgctxt "MsgImilHesAlwaysExaggeratingThingsBut"
msgid "05435"
msgstr ""
"He's always exaggerating\n"
"things, but I don't think\n"
"he's exaggerating now.{end_wait}"

msgctxt "MsgImilCoughTheEpidemicHasHitAlmost"
msgid "05436"
msgstr ""
"{text_effect:4}Cough...{pause_20_skippable}{reset_text_style}\n"
"The epidemic has hit\n"
"almost everyone in Imil.{page_break}"
"I'm sick, too. {text_effect:4}Cough!{reset_text_style}{page_break}"
"What would happen to us\n"
"if we didn't have {actor_name:4}?\n"
"{text_effect:4}Cough{reset_text_style}!{end_wait}"

msgctxt "MsgImilHerPalmsShineWithABlue"
msgid "05437"
msgstr ""
"Her palms shine with\n"
"a blue light...\n"
"Could she be{pause_20_skippable} an angel?{end_wait}"

msgctxt "MsgMercuryStoreClosedUntilWell"
msgid "05438"
msgstr ""
"Our store is closed\n"
"until we get well...{end_wait}"

msgctxt "MsgImilDoWantWeapons"
msgid "05439"
msgstr "Do you want weapons?{end_now}"

msgctxt "message"
msgid "05440"
msgstr ""
"I can't sell weapons\n"
"until I am cured. "
"{text_effect:4}Ohh...{pause_20_skippable}{reset_text_style}\n"
"I'm getting chills... {text_effect:4}Cough!{reset_text_style}{end_wait}"

msgctxt "message"
msgid "05441"
msgstr ""
"It's the travelers from\n"
"down south who brought\n"
"disease to our village...{page_break}"
"{reset_text_style}Are you from down south,\n"
"too? If you have no\n"
"business here,{page_break}"
"then begone... {text_effect:4}Cough!{reset_text_style}{end_wait}"

msgctxt "MsgImilWhoAreThesePeopleTheyMust"
msgid "05442"
msgstr ""
"Who are these people?\n"
"They must be strong folk\n"
"to come to Imil in winter.{end_wait}"

msgctxt "MsgMercuryTooSickBusiness"
msgid "05443"
msgstr ""
"Sorry, but I'm too sick\n"
"to do business today.\n"
"Try again tomorrow...{end_wait}"

msgctxt "MsgImilWereClosedSorryIGetA"
msgid "05444"
msgstr ""
"We're closed!!!\n"
"Sorry... I get a little\n"
"cranky when I'm sick. {page_break}"
"I'll open up the shop\n"
"when I get better.{end_wait}"

msgctxt "MsgImilWhyDoTheyAlwaysComeWhen"
msgid "05445"
msgstr ""
"Why do they always\n"
"come when I'm sick?{end_wait}"

msgctxt "MsgMercuryMomsSickGetWhatever"
msgid "05446"
msgstr ""
"Mom's sick, but I can\n"
"get you whatever you\n"
"need...{end_wait}"

msgctxt "MsgMercuryDadLumberjack"
msgid "05447"
msgstr ""
"My dad is a lumberjack.\n"
"He's down south working\n"
"in Kolima.{end_wait}"

msgctxt "MsgImilIfYouWantToBuyAnything"
msgid "05448"
msgstr ""
"If you want to buy\n"
"anything, please talk to\n"
"my daughter.{end_wait}"

msgctxt "MsgImilIWonderIfTheyAreHeaded"
msgid "05449"
msgstr ""
"I wonder if they are\n"
"headed to Mercury\n"
"Lighthouse, too.{page_break}"
"They'll never make\n"
"it without {actor_name:4}.{end_wait}"

msgctxt "MsgImilIfOnlyWeHadSomeOf"
msgid "05450"
msgstr ""
"If only we had some of\n"
"that mythical springwater.\n"
"That'd fix us right up!{end_wait}"

msgctxt "MsgImilWhyHaveTwoGroupsTravelers"
msgid "05451"
msgstr ""
"Why have two groups of\n"
"travelers come through\n"
"such heavy snows to Imil?{page_break}"
"The first group has\n"
"already gone off\n"
"somewhere.{end_wait}"

msgctxt "MsgImilWereTheOnlyInnThatStays"
msgid "05452"
msgstr ""
"We're the only inn that\n"
"stays open in winter,\n"
"since guests are so few.{page_break}"
"We'll wait on you hand\n"
"and foot, so please\n"
"stay a while!{end_wait}"

msgctxt "MsgImilDoWantSeeRestaurantMenu"
msgid "05453"
msgstr ""
"Do you want to see\n"
"the restaurant menu?{end_now}"

msgctxt "message"
msgid "05454"
msgstr ""
"Here you go.{pause_20_skippable} We're a\n"
"small town, mind you, so\n"
"the selection isn't great.{end_wait}"

msgctxt "message"
msgid "05455"
msgstr ""
"Tonight's dinner is stew\n"
"and rye bread. Sounds\n"
"like quite a feast,{pause_20_skippable} huh?{end_wait}"

msgctxt "MsgImilSoManyCustomersItJustGoes"
msgid "05456"
msgstr ""
"So many customers!\n"
"It just goes to show you,{page_break}"
"good things happen\n"
"if you work hard!{end_wait}"

msgctxt "MsgImilWintersAreToughHereSoIm"
msgid "05457"
msgstr ""
"Winters are tough here,\n"
"so I'm glad to have\n"
"guests to talk to.{page_break}"
"I'm going to give\n"
"them the best service\n"
"I can!{end_wait}"

msgctxt "MsgImilWeDontGetToEatMany"
msgid "05458"
msgstr ""
"We don't get to eat\n"
"many fancy meals in\n"
"the winter.{page_break}"
"A tasty stew would\n"
"be a real treat!{end_wait}"

msgctxt "MsgImilMayOnlyStudentButCan"
msgid "05459"
msgstr ""
"I may only be a student,\n"
"but I can act as your\n"
"healer.{end_wait}"

msgctxt "MsgImilLookingForMia"
msgid "05460"
msgstr "Are you looking for {actor_name:4}?{end_now}"

msgctxt "message"
msgid "05461"
msgstr ""
"{actor_name:4} just left.{page_break}"
"An epidemic is sweeping\n"
"the village, so {actor_name:4} is\n"
"very busy.{end_wait}"

msgctxt "message"
msgid "05462"
msgstr ""
"{actor_name:4} is a very kind\n"
"healer.{page_break}"
"I am just her apprentice.\n"
"I'm learning the arts\n"
"of healing from her.{end_wait}"

msgctxt "MsgImilHaveVisitedOldCoupleWho"
msgid "05463"
msgstr ""
"Have you visited the\n"
"old couple who live near\n"
"the entrance of town?{end_now}"

msgctxt "message"
msgid "05464"
msgstr ""
"Oh. {pause_20_skippable} That's too bad.\n"
"That's where {actor_name:4}\n"
"was headed.{page_break}"
"You probably just missed\n"
"her if you didn't see her\n"
"along the way.{end_wait}"

msgctxt "message"
msgid "05465"
msgstr ""
"{actor_name:4} went to their house.\n"
"You might have seen her\n"
"if you stopped there...{end_wait}"

msgctxt "MsgImilTheseFolkOkayTheyDont"
msgid "05466"
msgstr ""
"These folk are okay!\n"
"They don't seem like\n"
"bad people.{end_wait}"

msgctxt "MsgImilMiaWasSayingSheHas"
msgid "05467"
msgstr ""
"{actor_name:4} was saying she has\n"
"a bad feeling about\n"
"something.{page_break}"
"Could she have meant\n"
"these people?{end_wait}"

msgctxt "MsgImilHowFeeling"
msgid "05468"
msgstr "How are you feeling?{end_wait}"

msgctxt "message"
msgid "05469"
msgstr "{text_effect:4} Cough...{pause_20_skippable} Cough...{end_wait}"

msgctxt "message"
msgid "05470"
msgstr ""
"He's been coughing for\n"
"quite a while,\n"
"now...{end_wait}"

msgctxt "message"
msgid "05471"
msgstr "You'll feel better soon.{end_wait}"

msgctxt "message"
msgid "05472"
msgstr ""
"{text_effect:4}Cough{pause_20_skippable} "
"cough...{pause_20_skippable}{pause_20_skippable}\n"
"Cough{pause_20_skippable}{pause_20_skippable}... "
"{pause_20_skippable}{pause_20_skippable}\n"
"Cough... "
"{pause_20_skippable}{pause_20_skippable}{pause_20_skippable}Cough...{end_wait}"

msgctxt "message"
msgid "05473"
msgstr "How do you feel now?{end_wait}"

msgctxt "message"
msgid "05474"
msgstr "Much{pause_20_skippable} better...{end_wait}"

msgctxt "message"
msgid "05475"
msgstr ""
"No, Grandpa.{pause_20_skippable} You mustn't\n"
"push yourself too hard!{end_wait}"

msgctxt "message"
msgid "05476"
msgstr ""
"Thank you, {actor_name:4}...{page_break}"
"I can't imagine how\n"
"this village would ever\n"
"manage without you...{page_break}"
"{text_effect:4}Cough{reset_text_style}...{end_wait}"

msgctxt "message"
msgid "05477"
msgstr ""
"Don't mention it...\n"
"You should rest\n"
"in bed, too, ma'am.{end_wait}"

msgctxt "message"
msgid "05478"
msgstr "Who are you?{end_wait}"

msgctxt "message"
msgid "05479"
msgstr "Can I help you?{end_wait}"

msgctxt "message"
msgid "05480"
msgstr ""
"Was that{pause_20_skippable}{pause_20_skippable}{pause_20_skippable} the "
"lighthouse?{end_wait}"

msgctxt "message"
msgid "05481"
msgstr "It can't be...{end_wait}"

msgctxt "message"
msgid "05482"
msgstr "Only I can...{end_wait}"

msgctxt "message"
msgid "05483"
msgstr "Oh, no...{pause_20_skippable} Alex!!!{end_wait}"

msgctxt "MsgMercuryFeelMuchBetter"
msgid "05484"
msgstr ""
"I feel much better,\n"
"thanks to {actor_name:4}.\n"
"I should be fine now.{end_wait}"

msgctxt "MsgImilHappenedInLighthouseNortheast"
msgid "05485"
msgstr ""
"What happened in the\n"
"lighthouse to the\n"
"northeast?{end_wait}"

msgctxt "MsgImilMiaIsAGoodGirlI"
msgid "05486"
msgstr ""
"{actor_name:4} is a good girl.\n"
"I wish I had a\n"
"daughter like her.{page_break}"
"It's a shame her last\n"
"apprentice, Alex,\n"
"disappeared...{page_break}"
"leaving her all alone.{end_wait}"

msgctxt "MsgImilMiaClanOnceLivedHere"
msgid "05487"
msgstr ""
"{actor_name:4}'s clan once lived\n"
"here and guarded the\n"
"lighthouse to the east.{page_break}"
"Now, she's all alone.{end_wait}"

msgctxt "MsgImilEvenIfMiaHealsUs"
msgid "05488"
msgstr ""
"Even if {actor_name:4} heals us, this\n"
"epidemic will just come\n"
"back next year. {text_effect:4}Brr...{end_wait}"

msgctxt "MsgImilCantUnderstandWhyAnyOne"
msgid "05489"
msgstr ""
"I can't understand why\n"
"any one would exercise\n"
"in this cold weather.{end_wait}"

msgctxt "MsgImilAmHealerWhileMiaOut"
msgid "05490"
msgstr ""
"I am the healer while\n"
"{actor_name:4} is out, so tell me\n"
"if you need anything.{end_wait}"

msgctxt "MsgImilFeelLikeGrownUpWhen"
msgid "05491"
msgstr ""
"I feel like a grown-up\n"
"when I am serving as\n"
"a healer. It feels great.{end_wait}"

msgctxt "MsgImilEveryoneCountsOnMiaThats"
msgid "05492"
msgstr ""
"Everyone counts on {actor_name:4}.\n"
"That's why she is always\n"
"so busy.{end_wait}"

msgctxt "MsgImilWeHaveDoWhateverWe"
msgid "05493"
msgstr ""
"We have to do whatever\n"
"we can to help {actor_name:4}.\n"
"She's way too busy.{end_wait}"

msgctxt "MsgImilHermesHealingWaterFountain"
msgid "05494"
msgstr ""
"Fountain of Healing{page_break}"
"Water of Hermes:\n"
"It brings rejuvenation\n"
"to all that lives.{end_wait}"

msgctxt "MsgImilSomebodyHere"
msgid "05495"
msgstr "Somebody...is here.{end_wait}"

msgctxt "message"
msgid "05496"
msgstr "Someone is here...{end_wait}"

msgctxt "message"
msgid "05497"
msgstr "Can you hear it, too?{end_now}"

msgctxt "message"
msgid "05498"
msgstr ""
"Alex is the only one\n"
"other than I who can\n"
"enter Mercury Lighthouse.{end_wait}"

msgctxt "message"
msgid "05499"
msgstr ""
"You can't hear it? Well,\n"
"I can. {page_break}"
"Alex is the only one\n"
"other than I who can\n"
"enter Mercury Lighthouse.{end_wait}"

msgctxt "message"
msgid "05500"
msgstr ""
"But this statue is\n"
"blocking my way...{end_wait}"

msgctxt "MsgImilStatueBlocksEntrance"
msgid "05501"
msgstr ""
"This statue is blocking\n"
"the entrance.{end_wait}"

msgctxt "MsgMercuryLighthouseSomeoneDoesntWantMeToGet"
msgid "05502"
msgstr ""
"Someone doesn't want\n"
"me to get inside.{end_wait}"

msgctxt "MsgMercuryDidThat"
msgid "05503"
msgstr "Did you do that?{end_now}"

msgctxt "message"
msgid "05504"
msgstr ""
"No, I saw it!\n"
"I'm certain that flow of\n"
"force came from you.{end_wait}"

msgctxt "message"
msgid "05505"
msgstr ""
"I knew it...\n"
"I saw a ghostly\n"
"force pushing it!{end_wait}"

msgctxt "message"
msgid "05506"
msgstr ""
"You{pause_20_skippable}...{pause_20_skippable} You could\n"
"see our Psynergy?{end_wait}"

msgctxt "message"
msgid "05507"
msgstr ""
"Psynergy... Is that what\n"
"you call that power?{end_wait}"

msgctxt "message"
msgid "05508"
msgstr ""
"We had thought you were\n"
"using Psynergy when you\n"
"healed that old man, {actor_name:4}.{end_wait}"

msgctxt "message"
msgid "05509"
msgstr ""
"That's a special power,\n"
"handed down to members\n"
"of the Mercury Clan{page_break}"
"from generation\n"
"to generation.{end_wait}"

msgctxt "message"
msgid "05510"
msgstr ""
"It is called Ply,\n"
"a power generated\n"
"through meditation.{end_wait}"

msgctxt "message"
msgid "05511"
msgstr ""
"It was once\n"
"much stronger...{end_wait}"

msgctxt "message"
msgid "05512"
msgstr ""
"This Mercury Clan\n"
"sounds a little like people\n"
"of Vale, don't you think?{end_now}"

msgctxt "message"
msgid "05513"
msgstr ""
"Sure... They're the sworn\n"
"protectors of a special\n"
"power, just like us!{end_wait}"

msgctxt "message"
msgid "05514"
msgstr ""
"Oh, come on! Both of\n"
"them are protectors of\n"
"special powers!{page_break}"
"It's just the names\n"
"that are different!{end_wait}"

msgctxt "message"
msgid "05515"
msgstr ""
"I have to go...\n"
"I have to find whoever\n"
"entered the lighthouse.{end_wait}"

msgctxt "message"
msgid "05516"
msgstr "{actor_name:4} used Ply.{end_wait}"

msgctxt "MsgMercuryMonsterInsideTower"
msgid "05517"
msgstr ""
"A monster inside\n"
"Mercury Lighthouse?\n"
"How could this be!?{end_wait}"

msgctxt "MsgMercuryLetMePass"
msgid "05518"
msgstr ""
"I have to get\n"
"past him!{end_wait}"

msgctxt "MsgMercuryLighthouseThePathIsBlockedAgainWhat"
msgid "05519"
msgstr ""
"The path is blocked again.{pause_20_skippable}\n"
"What am I going to do?{end_wait}"

msgctxt "MsgMercuryLighthouseThisStatueWasntHereBeforeI"
msgid "05520"
msgstr ""
"This statue wasn't\n"
"here before. I wonder\n"
"if Alex...{page_break}"
"No, Alex wouldn't do\n"
"that...but what if he's\n"
"not alone?{end_wait}"

msgctxt "MsgMercurySavedMeAgain"
msgid "05521"
msgstr ""
"You've saved me again,\n"
"haven't you!{end_wait}"

msgctxt "message"
msgid "05522"
msgstr ""
"Do you have business\n"
"in the lighthouse, too?{end_now}"

msgctxt "message"
msgid "05523"
msgstr ""
"Please tell me\n"
"the truth!{end_wait}"

msgctxt "message"
msgid "05524"
msgstr ""
"I can't believe you'd\n"
"go so far to help\n"
"someone you just met.{end_wait}"

msgctxt "message"
msgid "05525"
msgstr ""
"You have some errand\n"
"in this lighthouse,\n"
"don't you?{end_now}"

msgctxt "message"
msgid "05526"
msgstr ""
"Please tell me\n"
"the truth!{end_now}"

msgctxt "MsgMercuryThoughtSo"
msgid "05527"
msgstr "I thought so...{end_wait}"

msgctxt "message"
msgid "05528"
msgstr ""
"I am sure there will\n"
"be more places ahead that\n"
"I cannot pass alone.{end_wait}"

msgctxt "message"
msgid "05529"
msgstr ""
"Only those of the Mercury\n"
"Clan are permitted to\n"
"enter this place.{end_wait}"

msgctxt "message"
msgid "05530"
msgstr ""
"However, I sense\n"
"something special about\n"
"you.{page_break}"
"I feel that I\n"
"can trust you!{end_wait}"

msgctxt "message"
msgid "05531"
msgstr ""
"The Adept {actor_name:4} joined\n"
"your party!{end_wait}"

msgctxt "MsgMercuryLighthouseAlreadyLit"
msgid "05532"
msgstr ""
"It's too late! The\n"
"lighthouse has already\n"
"been lit!{end_wait}"

msgctxt "message"
msgid "05533"
msgstr "It...{pause_20_skippable} It can't be!{end_wait}"

msgctxt "message"
msgid "05534"
msgstr ""
"The beacon cannot be\n"
"lit without the\n"
"Mercury Star...{end_wait}"

msgctxt "message"
msgid "05535"
msgstr ""
"...The Elemental Stars\n"
"were stolen from Sol\n"
"Sanctum, on Mt. Aleph.{end_wait}"

msgctxt "message"
msgid "05536"
msgstr ""
"Mt. Aleph... Sol Sanctum...{pause_20_skippable}\n"
"Are you healers from\n"
"Sol Sanctum?{end_now}"

msgctxt "message"
msgid "05537"
msgstr ""
"We came from a village\n"
"called Vale to recover\n"
"the three Elemental Stars.{end_wait}"

msgctxt "message"
msgid "05538"
msgstr ""
"But, unlike you, we are\n"
"not healers.{end_wait}"

msgctxt "message"
msgid "05539"
msgstr ""
"We came from Mt. Aleph,\n"
"but we're not healers.{end_wait}"

msgctxt "message"
msgid "05540"
msgstr ""
"We came from a village\n"
"called Vale to recover\n"
"the three Elemental Stars.{end_wait}"

msgctxt "message"
msgid "05541"
msgstr "Did you say{pause_20_skippable} Vale?{end_wait}"

msgctxt "message"
msgid "05542"
msgstr ""
"Our village was there to\n"
"protect Sol Sanctum, but\n"
"the Stars were stolen.{end_wait}"

msgctxt "message"
msgid "05543"
msgstr ""
"That sounds just like\n"
"my clan...{end_wait}"

msgctxt "message"
msgid "05544"
msgstr ""
"I have failed in the\n"
"one duty placed upon me...{pause_20_skippable}{page_break}"
"This is terrible.{end_wait}"

msgctxt "message"
msgid "05545"
msgstr "{actor_name:1}! {actor_name:2}!{end_wait}"

msgctxt "message"
msgid "05546"
msgstr "So it's you, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "05547"
msgstr ""
"Heh heh! Those kids are\n"
"still alive?{end_wait}"

msgctxt "message"
msgid "05548"
msgstr ""
"You came all this way to\n"
"save {actor_name:6} and Kraden?{end_wait}"

msgctxt "message"
msgid "05549"
msgstr ""
"That's not all...\n"
"We're after the\n"
"Elemental Stars!{end_wait}"

msgctxt "message"
msgid "05550"
msgstr ""
"In other words,{pause_20_skippable} they've\n"
"come to stop us.{end_wait}"

msgctxt "message"
msgid "05551"
msgstr ""
"Then we have no choice...{page_break}"
"Let's take care of\n"
"them now, before they\n"
"can do any harm!{end_wait}"

msgctxt "message"
msgid "05552"
msgstr "Menardi... {pause_20_skippable}Wait!{end_wait}"

msgctxt "message"
msgid "05553"
msgstr ""
"Oh, Saturos...\n"
"They want to...{end_wait}"

msgctxt "message"
msgid "05554"
msgstr "I heard everything.{end_wait}"

msgctxt "message"
msgid "05555"
msgstr ""
"They were lucky to\n"
"survive the eruption of\n"
"Mt. Aleph.{end_wait}"

msgctxt "message"
msgid "05556"
msgstr ""
"You have endured so\n"
"much, and now you want\n"
"to throw your lives away?{end_wait}"

msgctxt "message"
msgid "05557"
msgstr ""
"Fine. If that is your\n"
"wish, prepare to have\n"
"it granted.{end_wait}"

msgctxt "message"
msgid "05558"
msgstr ""
"Saturos... Are you going\n"
"to fight them alone?{end_wait}"

msgctxt "message"
msgid "05559"
msgstr ""
"Menardi, I can't expect\n"
"you to leave our hostages\n"
"alone and help me, can I?{end_wait}"

msgctxt "message"
msgid "05560"
msgstr "Umm...{pause_20_skippable} That's true...{end_wait}"

msgctxt "message"
msgid "05561"
msgstr ""
"Besides, I want to\n"
"see how much their\n"
"powers have developed.{end_wait}"

msgctxt "message"
msgid "05562"
msgstr ""
"Are you sure about this,\n"
"Saturos?{end_wait}"

msgctxt "message"
msgid "05563"
msgstr ""
"Leave me be!{pause_20_skippable} Head for the\n"
"next lighthouse{em_dash}now!{end_wait}"

msgctxt "message"
msgid "05564"
msgstr "Come here, child...{end_wait}"

msgctxt "message"
msgid "05565"
msgstr ""
"Do you mean to\n"
"defy me?{end_wait}"

msgctxt "message"
msgid "05566"
msgstr ""
"I should teach you a\n"
"lesson, child, but...{end_wait}"

msgctxt "message"
msgid "05567"
msgstr ""
"{actor_name:5}, I'd get your sister\n"
"to obey me, if you hope\n"
"to keep her from harm.{end_wait}"

msgctxt "message"
msgid "05568"
msgstr ""
"{actor_name:6}{pause_20_skippable}, please...\n"
"Just do as she says\n"
"for now.{end_wait}"

msgctxt "message"
msgid "05569"
msgstr ""
"{actor_name:5}{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}"
".{end_wait}"

msgctxt "message"
msgid "05570"
msgstr "It's all right, {actor_name:6}.{end_wait}"

msgctxt "message"
msgid "05571"
msgstr ""
"{actor_name:1} and {actor_name:2}\n"
"shouldn't have come after\n"
"us...{end_wait}"

msgctxt "message"
msgid "05572"
msgstr ""
"I'm sorry, {actor_name:1},\n"
"{actor_name:2}...{end_wait}"

msgctxt "message"
msgid "05573"
msgstr "I'm counting on you!{end_wait}"

msgctxt "message"
msgid "05574"
msgstr ""
"{actor_name:1}! {actor_name:2}!\n"
"Don't{pause_20_skippable} die!{end_wait}"

msgctxt "message"
msgid "05575"
msgstr ""
"{actor_name:6}... \n"
"Kraden!{end_wait}"

msgctxt "message"
msgid "05576"
msgstr ""
"If you want to save\n"
"them, you'll have to\n"
"beat me, first!{end_wait}"

msgctxt "message"
msgid "05577"
msgstr "No! Get back!{end_wait}"

msgctxt "message"
msgid "05578"
msgstr "What's the matter!{end_wait}"

msgctxt "message"
msgid "05579"
msgstr ""
"Saturos is extremely\n"
"powerful. I could sense\n"
"it when I faced him.{end_wait}"

msgctxt "message"
msgid "05580"
msgstr ""
"You have to be very\n"
"careful when fighting him...{page_break}"
"We have to match\n"
"his strength...{end_wait}"

msgctxt "message"
msgid "05581"
msgstr ""
"Match me?{pause_20_skippable} Pah! You\n"
"think you can match\n"
"the great Saturos?{end_now}"

msgctxt "message"
msgid "05582"
msgstr ""
"You overestimate\n"
"your chances.{end_wait}"

msgctxt "message"
msgid "05583"
msgstr ""
"And yet you still want\n"
"to fight? Ship of fools...{end_wait}"

msgctxt "message"
msgid "05584"
msgstr ""
"Fine then... I'll just\n"
"teach you all a lesson!{end_wait}"

msgctxt "message"
msgid "05585"
msgstr ""
"What happened? Saturos\n"
"is moving strangely.{end_wait}"

msgctxt "message"
msgid "05586"
msgstr ""
"What's this!? The light of\n"
"Mercury... It's\n"
"weakening my Psynergy!{end_wait}"

msgctxt "message"
msgid "05587"
msgstr ""
"I must finish this\n"
"quickly... Come on, fools!{end_wait}"

msgctxt "MsgMercuryGot"
msgid "05588"
msgstr "{actor_name:1}, we got him!{end_wait}"

msgctxt "message"
msgid "05589"
msgstr ""
"Who would have thought\n"
"that Mercury Lighthouse\n"
"held such great power?{page_break}"
"If only my Psynergy had\n"
"been at its full power...{end_wait}"

msgctxt "message"
msgid "05590"
msgstr ""
"Saturos... You said\n"
"you were weakened.\n"
"What did you mean?{end_wait}"

msgctxt "message"
msgid "05591"
msgstr ""
"I{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}."
"{pause_20_skippable} I meant nothing...{end_wait}"

msgctxt "message"
msgid "05592"
msgstr ""
"I shall tell you\n"
"what he means...{end_wait}"

msgctxt "message"
msgid "05593"
msgstr "That voice! Could it be?{end_wait}"

msgctxt "message"
msgid "05594"
msgstr "Alex!{end_wait}"

msgctxt "message"
msgid "05595"
msgstr "It's been a while, {actor_name:4}.{end_wait}"

msgctxt "message"
msgid "05596"
msgstr ""
"Alex, do you realize\n"
"what you've done?{end_wait}"

msgctxt "message"
msgid "05597"
msgstr ""
"Ha! Of course... I have\n"
"freed a great power that\n"
"has long been sealed away.{end_wait}"

msgctxt "message"
msgid "05598"
msgstr ""
"Mercury, the lighthouse\n"
"of Water...\n"
"What a mighty force.{end_wait}"

msgctxt "message"
msgid "05599"
msgstr ""
"Alex, you...\n"
"Are you mad!?{end_wait}"

msgctxt "message"
msgid "05600"
msgstr ""
"No, {actor_name:4}...\n"
"Don't you understand?{end_wait}"

msgctxt "message"
msgid "05601"
msgstr ""
"The lighthouse granted\n"
"you great power during\n"
"your battle with Saturos.{end_wait}"

msgctxt "message"
msgid "05602"
msgstr ""
"It's true...\n"
"I could use my power\n"
"without ever depleting it.{end_wait}"

msgctxt "message"
msgid "05603"
msgstr ""
"Don't you see?{page_break}"
"The Mercury Lighthouse\n"
"supplied you with\n"
"limitless Psynergy.{end_wait}"

msgctxt "message"
msgid "05604"
msgstr ""
"Psynergy? Are you telling\n"
"me my powers come\n"
"from Psynergy?{end_wait}"

msgctxt "message"
msgid "05605"
msgstr ""
"You and I are both\n"
"members of Mercury\n"
"Clan...{page_break}"
"Masters of Water\n"
"Psynergy.{end_wait}"

msgctxt "message"
msgid "05606"
msgstr ""
"{actor_name:4} is an Adept\n"
"too, isn't she?{end_now}"

msgctxt "message"
msgid "05607"
msgstr ""
"Geez, {actor_name:1}, you knew\n"
"all along, and you\n"
"didn't tell us?{end_wait}"

msgctxt "message"
msgid "05608"
msgstr ""
"I know it's hard to\n"
"believe, but it looks like\n"
"{actor_name:4}'s one of us.{end_wait}"

msgctxt "message"
msgid "05609"
msgstr ""
"Tell me, Alex...\n"
"Why wasn't Saturos able\n"
"to use his full power?{end_wait}"

msgctxt "message"
msgid "05610"
msgstr ""
"Ah, yes...\n"
"I shall explain it all.{end_wait}"

msgctxt "message"
msgid "05611"
msgstr ""
"Saturos is aligned with\n"
"Mars, the clan of fire.{end_wait}"

msgctxt "message"
msgid "05612"
msgstr ""
"Fire and water are\n"
"opposing elements...{page_break}"
"His full power was bound\n"
"by the Water Psynergy\n"
"of the lighthouse.{end_wait}"

msgctxt "message"
msgid "05613"
msgstr ""
"Didn't Saturos\n"
"know that?{end_wait}"

msgctxt "message"
msgid "05614"
msgstr "Of course he knew.{end_wait}"

msgctxt "message"
msgid "05615"
msgstr ""
"However, he failed to\n"
"appreciate the power\n"
"of this lighthouse.{end_wait}"

msgctxt "message"
msgid "05616"
msgstr "As did I...{end_wait}"

msgctxt "message"
msgid "05617"
msgstr ""
"Is that why we were\n"
"able to defeat Saturos?{end_wait}"

msgctxt "message"
msgid "05618"
msgstr ""
"No...\n"
"There is more to it.{end_wait}"

msgctxt "message"
msgid "05619"
msgstr ""
"I stood by, watching your\n"
"battle from afar...{end_wait}"

msgctxt "message"
msgid "05620"
msgstr "You were watching us?{end_wait}"

msgctxt "message"
msgid "05621"
msgstr ""
"Yes. I did not help\n"
"Saturos, because I was\n"
"certain he would win.{end_wait}"

msgctxt "message"
msgid "05622"
msgstr ""
"But I was wrong... You\n"
"have become such great\n"
"fighters in a short time.{end_wait}"

msgctxt "message"
msgid "05623"
msgstr ""
"Saturos is up again!?\n"
"But we beat him!{end_wait}"

msgctxt "message"
msgid "05624"
msgstr ""
"Me? Beaten? Never!\n"
"I lost to this lighthouse,\n"
"not to you!{end_wait}"

msgctxt "message"
msgid "05625"
msgstr ""
"I was merely stalling you\n"
"until Saturos regained\n"
"his strength.{end_wait}"

msgctxt "message"
msgid "05626"
msgstr ""
"You were just buying\n"
"time! That's not fair,\n"
"Alex!{end_wait}"

msgctxt "message"
msgid "05627"
msgstr ""
"I won't let Saturos\n"
"escape!{end_wait}"

msgctxt "message"
msgid "05628"
msgstr ""
"And just what are you\n"
"going to do? Will you{pause_20_skippable}\n"
"finish him off?{end_now}"

msgctxt "message"
msgid "05629"
msgstr ""
"If that's the case,\n"
"you will have to fight\n"
"me, as well.{page_break}"
"I've seen how you fight.\n"
"You cannot hope to win.{end_wait}"

msgctxt "message"
msgid "05630"
msgstr ""
"Yes, {actor_name:1}. You seem\n"
"like a smart warrior.{page_break}"
"You can't beat our\n"
"combined might, now that\n"
"we've seen how you fight.{end_wait}"

msgctxt "message"
msgid "05631"
msgstr ""
"And I doubt you are\n"
"the type to 'finish'\n"
"anyone off!{end_wait}"

msgctxt "message"
msgid "05632"
msgstr ""
"Of course, you are\n"
"welcome to believe\n"
"whatever you want.{end_wait}"

msgctxt "message"
msgid "05633"
msgstr "He warped again!{end_wait}"

msgctxt "message"
msgid "05634"
msgstr ""
"Again?{pause_20_skippable}\n"
"He's done that before?{end_wait}"

msgctxt "message"
msgid "05635"
msgstr "Yeah, in Sol Sanctum...{end_wait}"

msgctxt "message"
msgid "05636"
msgstr ""
"That Psynergy...the warp.\n"
"Does that mean {actor_name:4}\n"
"can use it?{end_wait}"

msgctxt "message"
msgid "05637"
msgstr ""
"No, it's impossible.\n"
"Even Alex didn't have\n"
"this kind of power before.{end_wait}"

msgctxt "message"
msgid "05638"
msgstr ""
"Ah, well... I can't stay the\n"
"same Alex you knew\n"
"forever...{end_wait}"

msgctxt "message"
msgid "05639"
msgstr ""
"Well, it seems that my\n"
"ride has returned while\n"
"we were speaking.{end_wait}"

msgctxt "message"
msgid "05640"
msgstr "And so, I bid you adieu.{end_wait}"

msgctxt "message"
msgid "05641"
msgstr ""
"{actor_name:1}, Saturos\n"
"still has the\n"
"Elemental Stars!{end_wait}"

msgctxt "message"
msgid "05642"
msgstr ""
"That's right!\n"
"We can't let them\n"
"leave now!{end_wait}"

msgctxt "message"
msgid "05643"
msgstr ""
"Oh? And you want\n"
"to take the Elemental\n"
"Stars from Saturos?{end_now}"

msgctxt "message"
msgid "05644"
msgstr ""
"Ha! Too bad!\n"
"Menardi has them. You'll\n"
"have to ask her!{end_wait}"

msgctxt "message"
msgid "05645"
msgstr ""
"Ha! You're right...\n"
"Menardi has the\n"
"Elemental Stars!{end_wait}"

msgctxt "message"
msgid "05646"
msgstr "That reminds me...{end_wait}"

msgctxt "message"
msgid "05647"
msgstr ""
"Do you still have\n"
"the Mars Star?{end_now}"

msgctxt "message"
msgid "05648"
msgstr ""
"I appreciate your\n"
"honesty.{end_wait}"

msgctxt "message"
msgid "05649"
msgstr ""
"Are you telling the truth?\n"
"Well, I shall believe you\n"
"for now.{end_wait}"

msgctxt "message"
msgid "05650"
msgstr ""
"I suppose you'll be willing\n"
"to pursue us for the\n"
"Elemental Stars?{end_now}"

msgctxt "message"
msgid "05651"
msgstr ""
"I look forward to it.\n"
"I shall see you\n"
"soon, then.{end_wait}"

msgctxt "message"
msgid "05652"
msgstr ""
"That's too bad...\n"
"I shall look forward to\n"
"seeing you again.{end_wait}"

msgctxt "message"
msgid "05653"
msgstr "Good-bye.{end_wait}"

msgctxt "message"
msgid "05654"
msgstr ""
"I look forward to our\n"
"next battle.{end_wait}"

msgctxt "message"
msgid "05655"
msgstr "They're gone...{end_wait}"

msgctxt "message"
msgid "05656"
msgstr ""
"Shoot... We couldn't even\n"
"save {actor_name:6}...{end_wait}"

msgctxt "message"
msgid "05657"
msgstr ""
"I don't deserve to\n"
"be a healer...{end_wait}"

msgctxt "message"
msgid "05658"
msgstr ""
"We couldn't stop them\n"
"from lighting the\n"
"beacon.{end_wait}"

msgctxt "message"
msgid "05659"
msgstr ""
"I've failed my clan,\n"
"failed in my duty...{end_wait}"

msgctxt "message"
msgid "05660"
msgstr ""
"That's not true!\n"
"We can still beat\n"
"them, right, {actor_name:1}?{end_now}"

msgctxt "message"
msgid "05661"
msgstr ""
"That's right, {actor_name:1}!{page_break}"
"All we have to do is stop\n"
"them from lighting\n"
"all the lighthouses!{end_wait}"

msgctxt "message"
msgid "05662"
msgstr ""
"You're not helping here!{page_break}"
"We're fine as long as\n"
"the lighthouses aren't\n"
"all lit!{end_wait}"

msgctxt "message"
msgid "05663"
msgstr ""
"The beacon of Mercury\n"
"Lighthouse has been lit,{page_break}"
"but we'll stop\n"
"them next time.{end_wait}"

msgctxt "message"
msgid "05664"
msgstr ""
"That's right. We can\n"
"save {actor_name:6} at the\n"
"next lighthouse.{end_wait}"

msgctxt "message"
msgid "05665"
msgstr ""
"Yes. We won't let Alex\n"
"get away with this...{end_wait}"

msgctxt "message"
msgid "05666"
msgstr ""
"Let's go after\n"
"them now!{end_wait}"

msgctxt "message"
msgid "05667"
msgstr ""
"What's the matter?\n"
"We should hurry!{end_wait}"

msgctxt "message"
msgid "05668"
msgstr ""
"We?\n"
"{actor_name:4}, are you\n"
"coming along with us?{end_wait}"

msgctxt "message"
msgid "05669"
msgstr ""
"But the people of Imil\n"
"need you, {actor_name:4}.{end_wait}"

msgctxt "message"
msgid "05670"
msgstr "It's okay.{end_wait}"

msgctxt "message"
msgid "05671"
msgstr ""
"\"The fountain shall be\n"
"filled as long as light\n"
"fills the lighthouse.\"{page_break}"
"That's an old saying.\n"
"The fountain will run over\n"
"with healing waters now.{end_wait}"

msgctxt "message"
msgid "05672"
msgstr ""
"I have mixed feelings\n"
"about leaving, but Imil will\n"
"be fine as long as{page_break}"
"the fountain continues\n"
"to flow with the\n"
"Water of Hermes.{end_wait}"

msgctxt "message"
msgid "05673"
msgstr ""
"We should hurry if we're\n"
"going to follow them.{end_wait}"

msgctxt "MsgMercuryLighthouseTheLegendsSaidThatIfThe"
msgid "05674"
msgstr ""
"The legends said that if\n"
"the lighthouse was lit, the\n"
"fountain would fill again!{page_break}"
"It looks like the\n"
"legends were true!{end_wait}"

msgctxt "MsgMercuryLighthouseOurFountainIsBackTheySay"
msgid "05675"
msgstr ""
"Our fountain is back! They\n"
"say these waters can\n"
"heal all that lives.{end_wait}"

msgctxt "MsgMercuryLighthouseIDrankTheHealingWaterAnd"
msgid "05676"
msgstr ""
"I drank the healing water,\n"
"and now I feel great!{page_break}"
"I should get a bottle\n"
"so I can take some\n"
"home with me.{end_wait}"

msgctxt "MsgMercuryLighthouseWeDontHaveToFearAny"
msgid "05677"
msgstr ""
"We don't have to fear\n"
"any epidemic as long as\n"
"we have our fountain.{end_wait}"

msgctxt "MsgMercuryLighthouseHowDidTheFountainKnowThat"
msgid "05678"
msgstr ""
"How did the fountain\n"
"know that the beacon\n"
"was lit?{end_wait}"

msgctxt "MsgMercuryLighthouseAllThatLivesThatMeansIt"
msgid "05679"
msgstr ""
"All that lives... That means\n"
"it must work on plants and\n"
"animals, too.{end_wait}"

msgctxt "MsgMercuryLighthouseIKnewItWouldWorkBut"
msgid "05680"
msgstr ""
"I knew it would work, but\n"
"I never knew it would\n"
"work this well!{page_break}"
"I feel ten years younger!{end_wait}"

msgctxt "MsgMercuryLighthouseINeverBelievedThoseStoriesBut"
msgid "05681"
msgstr ""
"I never believed those\n"
"stories, but there's\n"
"the proof!{end_wait}"

msgctxt "MsgMercuryWhoHonorsHeart"
msgid "05682"
msgstr ""
"He who honors the heart\n"
"of the goddess shall stand\n"
"at the center of all,{page_break}"
"like a swan in the\n"
"center of a rippling\n"
"pond.{end_wait}"

msgctxt "MsgMercuryHonorsGoddessRainbows"
msgid "05683"
msgstr ""
"He who honors the\n"
"goddess of rainbows shall{page_break}"
"be guided to the heavens\n"
"upon wings of fluid grace.{end_wait}"

msgctxt "message"
msgid "05684"
msgstr "The door is shut tight.{end_wait}"

msgctxt "MsgMercuryLighthouseFountainFlowsWithWater"
msgid "05685"
msgstr ""
"The fountain is flowing\n"
"with water.{end_wait}"

msgctxt "MsgMercuryLighthouseFountainSeemsDry"
msgid "05686"
msgstr "The fountain seems dry.{end_wait}"

msgctxt "MsgMercuryLighthouseStrangeForcesBlockWay"
msgid "05687"
msgstr ""
"Strange forces are at\n"
"work... It seems\n"
"impossible to proceed.{end_wait}"

msgctxt "MsgMercuryLighthouseIsaacGot"
msgid "05688"
msgstr ""
"{argument_actor_name:1} got\n"
"{argument_item_name:2}.{end_wait}"

msgctxt "MsgMercuryDontHideTruth"
msgid "05689"
msgstr ""
"Please, don't hide\n"
"anything. Just tell\n"
"me the truth!{end_now}"

msgctxt "MsgImilTheMercuryLighthouseIsShiningMia"
msgid "05690"
msgstr ""
"The Mercury Lighthouse\n"
"is shining.{page_break}"
"{actor_name:4} will be leaving\n"
"us soon, won't she?{end_wait}"

msgctxt "MsgImilImilWillBeFineDiseaseIs"
msgid "05691"
msgstr ""
"Imil will be fine.\n"
"Disease is nothing to\n"
"the Water of Hermes.{end_wait}"

msgctxt "MsgImilCountingAfterDeparture"
msgid "05692"
msgstr ""
"One,{pause_20_skippable} two,{pause_20_skippable} "
"three,{pause_20_skippable} four...{end_wait}"

msgctxt "message"
msgid "05693"
msgstr ""
"I was training hard so\n"
"that I could withstand\n"
"any disease...{page_break}"
"And now the lighthouse\n"
"fountain is back?{end_now}"

msgctxt "message"
msgid "05694"
msgstr ""
"What did I train\n"
"so hard for all this time?{end_wait}"

msgctxt "message"
msgid "05695"
msgstr ""
"No, it can't be! Everyone\n"
"is in perfect health!{end_wait}"

msgctxt "MsgImilMiaWasOnlyInImilTo"
msgid "05696"
msgstr ""
"{actor_name:4} was only in Imil\n"
"to guard the lighthouse.{page_break}"
"Now that it's been lit,\n"
"she'll probably leave us.{end_wait}"

msgctxt "MsgImilDontWorryAboutUsMiaWell"
msgid "05697"
msgstr ""
"Don't worry about us,\n"
"{actor_name:4}. We'll protect\n"
"the village now!{end_wait}"

msgctxt "MsgImilNowThatIveLetMyGuard"
msgid "05698"
msgstr ""
"Now that I've let my\n"
"guard down, I'm getting\n"
"cold chills.{page_break}"
"Maybe I should go\n"
"and drink some of\n"
"that fountain water.{end_wait}"

msgctxt "MsgImilThatFountainWaterReallyMadeGrandpa"
msgid "05699"
msgstr ""
"That fountain water really\n"
"made Grandpa healthy.{end_wait}"

msgctxt "MsgMercuryReallySayDie"
msgid "05700"
msgstr ""
"Did I really say\n"
"I was going to die\n"
"from that disease?{end_now}"

msgctxt "message"
msgid "05701"
msgstr ""
"Ha ha ha! I must have\n"
"really felt sick to\n"
"say that!{page_break}"
"I'm good for another 30\n"
"years!{pause_20_skippable} ...Let me get\n"
"back to work!{end_wait}"

msgctxt "message"
msgid "05702"
msgstr ""
"That's right!\n"
"The strong old man of\n"
"Imil, that's me!{end_wait}"

msgctxt "MsgImilGrandpasAllBetterNowThanksTo"
msgid "05703"
msgstr ""
"Grandpa's all better\n"
"now, thanks to that\n"
"fountain water.{end_wait}"

msgctxt "MsgImilNowMiaCanLeaveTheVillage"
msgid "05704"
msgstr ""
"Now, {actor_name:4} can leave\n"
"the village without any\n"
"worries.{end_wait}"

msgctxt "MsgImilItsNiceThatTheFountainCan"
msgid "05705"
msgstr ""
"It's nice that the fountain\n"
"can heal us, but {actor_name:4} had\n"
"something...special.{end_wait}"

msgctxt "MsgImilThatBlueLightFromHerHands"
msgid "05706"
msgstr ""
"That blue light from her\n"
"hands... Could she really\n"
"be an angel?{end_wait}"

msgctxt "MsgMercuryCatchUpLostOpportunity"
msgid "05707"
msgstr ""
"I have to catch up\n"
"on lost opportunity!\n"
"It's time for business!{end_wait}"

msgctxt "MsgImilCustomersAreHardToComeBy"
msgid "05708"
msgstr ""
"Customers are hard to\n"
"come by, and I can't\n"
"afford to lose even one!{end_wait}"

msgctxt "MsgMercuryShameStoreClosed"
msgid "05709"
msgstr ""
"It's a shame the store\n"
"was closed for something\n"
"as minor as a cold.{end_wait}"

msgctxt "MsgImilTheCustomersAreBackIThought"
msgid "05710"
msgstr ""
"The customers are back!\n"
"I thought I'd lost my\n"
"business for good.!{end_wait}"

msgctxt "MsgMercuryRecoveredThanksFountain"
msgid "05711"
msgstr ""
"I'm fully recovered,\n"
"thanks to the fountain!\n"
"I can get back to work!{end_wait}"

msgctxt "MsgImilImSoHappyThatMommyIs"
msgid "05712"
msgstr ""
"I'm so happy that\n"
"Mommy is well again!{end_wait}"

msgctxt "MsgImilMiaSaidItWouldntBeGood"
msgid "05713"
msgstr ""
"{actor_name:4} said it wouldn't be\n"
"good to leave the\n"
"lighthouse lit...{page_break}"
"But it turned out to be\n"
"the best thing for Imil.{end_wait}"

msgctxt "MsgImilMyDaddysStillInKolimaIll"
msgid "05714"
msgstr ""
"My daddy's still in Kolima.\n"
"I'll be really happy\n"
"if he comes home soon!{end_wait}"

msgctxt "MsgImilItsAlmostTimeForLeave"
msgid "05715"
msgstr ""
"It's almost time for you\n"
"to leave, isn't it?{end_now}"

msgctxt "message"
msgid "05716"
msgstr ""
"Just like the legend said,\n"
"the fountain began flowing\n"
"when the light was lit.{page_break}"
"That means that Imil\n"
"needs never fear\n"
"disease again!{end_wait}"

msgctxt "message"
msgid "05717"
msgstr ""
"Oh! I'll cook a feast\n"
"for you tonight!{end_wait}"

msgctxt "MsgImilThankGoodnessTheTownIsBack"
msgid "05718"
msgstr ""
"Thank goodness the town\n"
"is back to normal again.{end_wait}"

msgctxt "MsgImilImGladTheBeaconHasBeen"
msgid "05719"
msgstr ""
"I'm glad the beacon has\n"
"been lit and the fountain\n"
"is flowing again.{page_break}"
"But it's a shame that {actor_name:4}\n"
"is leaving the village...{end_wait}"

msgctxt "MsgImilMiaWillBeLeavingWithYou"
msgid "05720"
msgstr ""
"{actor_name:4} will be\n"
"leaving with you all...{page_break}"
"I wish you could\n"
"stay a little longer...{end_wait}"

msgctxt "MsgImilTheyCameToOurVillageAnd"
msgid "05721"
msgstr ""
"They came to our village\n"
"and now the fountain\n"
"is flowing.{page_break}"
"They must truly be\n"
"our lucky charms.{end_wait}"

msgctxt "MsgImilINeverToldMiaThatI"
msgid "05722"
msgstr ""
"I never told {actor_name:4}\n"
"that I liked her...{page_break}"
"But I guess it's for\n"
"the best.{end_wait}"

msgctxt "MsgImilMia"
msgid "05723"
msgstr "{actor_name:4}...{end_wait}"

msgctxt "message"
msgid "05724"
msgstr ""
"We were worried that\n"
"you wouldn't come back!{end_wait}"

msgctxt "message"
msgid "05725"
msgstr ""
"I'm so sorry,\n"
"you two...{end_wait}"

msgctxt "message"
msgid "05726"
msgstr ""
"{actor_name:4}, we have a problem!\n"
"The Mercury Lighthouse...\n"
"It's been lit!{end_wait}"

msgctxt "message"
msgid "05727"
msgstr "{actor_name:4}, you already knew?{end_wait}"

msgctxt "message"
msgid "05728"
msgstr ""
"What's the matter?{pause_20_skippable}\n"
"You look strange\n"
"today, {actor_name:4}.{end_wait}"

msgctxt "message"
msgid "05729"
msgstr ""
"I...{pause_20_skippable}\n"
"How should I tell you?{end_wait}"

msgctxt "message"
msgid "05730"
msgstr ""
"You have something to\n"
"say? What is it?{end_wait}"

msgctxt "message"
msgid "05731"
msgstr "Well, {pause_20_skippable}I... Uh...{end_wait}"

msgctxt "message"
msgid "05732"
msgstr ""
"I...{pause_20_skippable} I'll be joining\n"
"{actor_name:1} on his quest.{end_wait}"

msgctxt "message"
msgid "05733"
msgstr ""
"It's very hard for\n"
"me to leave you, but{pause_20_skippable}\n"
"it's the lighthouse.{end_wait}"

msgctxt "message"
msgid "05734"
msgstr ""
"You said the world would\n"
"be in danger if the\n"
"lighthouse was lit, right?{end_wait}"

msgctxt "message"
msgid "05735"
msgstr ""
"Is that why you're\n"
"leaving? To protect the\n"
"world?{end_wait}"

msgctxt "message"
msgid "05736"
msgstr "Yes.{pause_20_skippable} That's right...{end_wait}"

msgctxt "message"
msgid "05737"
msgstr ""
"Then there's nothing\n"
"we can do...{end_wait}"

msgctxt "message"
msgid "05738"
msgstr ""
"We won't try\n"
"to stop you, then.{page_break}"
"After all, you are\n"
"trying to protect\n"
"the Mercury Clan.{end_wait}"

msgctxt "message"
msgid "05739"
msgstr "Yes.{pause_20_skippable} I am...{end_wait}"

msgctxt "message"
msgid "05740"
msgstr ""
"As members of the\n"
"Mercury Clan...we will\n"
"protect Imil ourselves.{page_break}"
"So don't worry, OK?{end_wait}"

msgctxt "message"
msgid "05741"
msgstr ""
"I will try hard and\n"
"learn to heal as well\n"
"as you, {actor_name:4}!{end_wait}"

msgctxt "message"
msgid "05742"
msgstr ""
"OK, I'll leave the\n"
"village in your hands,\n"
"Megan, Justin...{end_wait}"

msgctxt "message"
msgid "05743"
msgstr ""
"We can leave\n"
"without any worries, now.{end_wait}"

msgctxt "message"
msgid "05744"
msgstr ""
"I will be the healer,\n"
"because I know how, OK?{end_wait}"

msgctxt "MsgImilMiaGoingOnJourneyWith"
msgid "05745"
msgstr ""
"{actor_name:4}'s going on a\n"
"journey with you, right?{page_break}"
"Sniff... It makes me sad,\n"
"but I'll try to be a\n"
"good healer.{end_wait}"

msgctxt "MsgImilIWillBeAKindGirl"
msgid "05746"
msgstr ""
"I will be a kind girl,\n"
"like {actor_name:4}.{page_break}"
"Come back sometime\n"
"and see me all grown up.\n"
"I want you to.{end_wait}"

msgctxt "MsgImilMiasGoingToDefendTheHonor"
msgid "05747"
msgstr ""
"{actor_name:4}'s going to defend\n"
"the honor of the\n"
"Mercury Clan.{end_wait}"

msgctxt "MsgImilImSorryMiaButICant"
msgid "05748"
msgstr ""
"I'm sorry, {actor_name:4}, but\n"
"I can't stand to\n"
"see you go.{end_wait}"

msgctxt "MsgKolimaIfICouldSpeakIdTell"
msgid "05749"
msgstr ""
"If I could speak, I'd\n"
"tell them this is Kolima,\n"
"village of lumberjacks!{end_wait}"

msgctxt "MsgKolimaHowCouldAnyoneTurnAGirl"
msgid "05750"
msgstr ""
"How could anyone turn a\n"
"girl as beautiful as\n"
"me into a tree?{page_break}"
"Actually, I'm pretty\n"
"cute for a tree.{end_wait}"

msgctxt "MsgKolimaThisIsADreamItHas"
msgid "05751"
msgstr ""
"This is a dream...\n"
"It has to be a dream...{end_wait}"

msgctxt "MsgKolimaBeingUnableToMoveIsSo"
msgid "05752"
msgstr ""
"Being unable to move\n"
"is so inconvenient.{end_wait}"

msgctxt "MsgKolimaIAmOldIveLivedA"
msgid "05753"
msgstr ""
"I am old; I've lived\n"
"a full life. I don't\n"
"even mind being a tree.{page_break}"
"I just feel bad for all\n"
"those kids who were\n"
"turned into trees.{end_wait}"

msgctxt "MsgKolimaItsTheSacredTreesCurseWhy"
msgid "05754"
msgstr ""
"It's the sacred tree's\n"
"curse! Why did they\n"
"try to cut down Tret?{end_wait}"

msgctxt "MsgKolimaTheWaterAtMyFeetHuh"
msgid "05755"
msgstr ""
"The water at my feet...\n"
"{pause_20_skippable}Huh?{pause_20_skippable} Hey!{pause_20_skippable} It's "
"delicious!{end_wait}"

msgctxt "MsgKolimaIfICantMoveThenMom"
msgid "05756"
msgstr ""
"If I can't move,\n"
"then Mom can't make\n"
"me go to bed!{end_wait}"

msgctxt "MsgKolimaInteriorsWhatAreTheyStaringAtThey"
msgid "05757"
msgstr ""
"What are they staring at?\n"
"They seem awfully\n"
"young...{page_break}"
"They don't stand a\n"
"chance against Tret.{end_wait}"

msgctxt "MsgKolimaInteriorsIDreamtThatAMightyWarrior"
msgid "05758"
msgstr ""
"I dreamt that a mighty\n"
"warrior with a thick\n"
"beard ended this curse.{page_break}"
"I dream about him\n"
"a lot, actually...{end_wait}"

msgctxt "MsgKolimaInteriorsWhatWillHappenToMyTreasure"
msgid "05759"
msgstr ""
"What will happen to my\n"
"treasure if I'm stuck as\n"
"a tree forever?{end_wait}"

msgctxt "MsgKolimaInteriorsSoonAllOfKolimaWillBe"
msgid "05760"
msgstr ""
"Soon, all of Kolima will\n"
"be nothing but forest...{end_wait}"

msgctxt "MsgKolimaInteriorsIWonderWhatFathersSecretIs"
msgid "05761"
msgstr ""
"I wonder what Father's\n"
"secret is...{end_wait}"

msgctxt "MsgKolimaInteriorsMaybeWeTurnedIntoTreesBecause"
msgid "05762"
msgstr ""
"Maybe we turned into\n"
"trees because of all the\n"
"trees we've cut down.{page_break}"
"We were only doing\n"
"our jobs, though.{end_wait}"

msgctxt "MsgKolimaInteriorsAtLeastMyFatherWasntThe"
msgid "05763"
msgstr ""
"At least my father wasn't\n"
"the one who tried to cut\n"
"down the holy tree.{end_wait}"

msgctxt "MsgKolimaInteriorsTheHolyTreeOfKolimaHas"
msgid "05764"
msgstr ""
"The holy tree of Kolima\n"
"has great powers, just\n"
"like Father said.{end_wait}"

msgctxt "MsgKolimaInteriorsIUsedToCarveWeaponsOut"
msgid "05765"
msgstr ""
"I used to carve\n"
"weapons out of wood.\n"
"Now I am wood.{page_break}"
"Life's funny\n"
"like that.{end_wait}"

msgctxt "MsgKolimaInteriorsManImStuckInsideThatMeans"
msgid "05766"
msgstr ""
"Man... I'm stuck inside.\n"
"That means I can't even\n"
"become a tall tree.{end_wait}"

msgctxt "MsgKolimaInteriorsNoIDontWantToBe"
msgid "05767"
msgstr ""
"No! I don't want to\n"
"be stuck as a tree\n"
"forever!{end_wait}"

msgctxt "MsgKolimaMaybeIfIMeditateHarderIll"
msgid "05768"
msgstr ""
"Maybe if I meditate\n"
"harder, I'll turn\n"
"back into a man...{page_break}"
"Ngg{pause_20_skippable} Ung!!{pause_20_skippable} Ugagaga!!!{end_wait}"

msgctxt "MsgKolimaInteriorsWhoCausedAllThisSomeoneMust"
msgid "05769"
msgstr ""
"Who caused all this?\n"
"Someone must have tried\n"
"to cut down Tret!{end_wait}"

msgctxt "MsgKolimaInteriorsHowAmISupposedToCharge"
msgid "05770"
msgstr ""
"How am I supposed to\n"
"charge people for their\n"
"rooms if I'm a tree!?{end_wait}"

msgctxt "MsgKolimaInteriorsTheVillagersWereRightINever"
msgid "05771"
msgstr ""
"The villagers were right.\n"
"I never should have tried\n"
"to cut that tree down.{page_break}"
"Now I'll never see\n"
"my family in Imil\n"
"again...{end_wait}"

msgctxt "MsgKolimaInteriorsIfOnlyIdLeftTownA"
msgid "05772"
msgstr ""
"If only I'd left town\n"
"a day earlier. But this\n"
"room was so comfy!{end_wait}"

msgctxt "MsgKolimaThisIsKolimaVillageOfLumberjacks"
msgid "05773"
msgstr ""
"This is Kolima,\n"
"village of lumberjacks!\n"
"I'll shout it out loud!{page_break}"
"This{pause_20_skippable} is{pause_20_skippable} "
"Ko{pause_20_skippable}li{pause_20_skippable}ma!{end_wait}"

msgctxt "MsgKolimaWeRelyOnTheForestsSo"
msgid "05774"
msgstr ""
"We rely on the forests\n"
"so much, and yet we hurt\n"
"the sacred tree...{page_break}"
"Maybe we can work\n"
"to restore harmony\n"
"in the forest now.{end_wait}"

msgctxt "MsgKolimaYouKnowBeingATreeGives"
msgid "05775"
msgstr ""
"You know, being a tree\n"
"gives you a lot of\n"
"time to think.{end_wait}"

msgctxt "MsgKolimaITurnedIntoATreeRight"
msgid "05776"
msgstr ""
"I turned into a tree right\n"
"when the sparkles fell\n"
"from the sky.{end_wait}"

msgctxt "MsgKolimaDontBlameTheVillagersForBeing"
msgid "05777"
msgstr ""
"Don't blame the villagers\n"
"for being tempted by\n"
"McCoy's money...{page_break}"
"Anyone would be tempted\n"
"by such a staggering sum.{end_wait}"

msgctxt "MsgKolimaWhoWouldTryToUseThe"
msgid "05778"
msgstr ""
"Who would try to use\n"
"the holy tree to build\n"
"a palace, anyway?{end_wait}"

msgctxt "MsgKolimaIDidntMindBeingATree"
msgid "05779"
msgstr ""
"I didn't mind being\n"
"a tree...{page_break}"
"Water never tasted\n"
"so good!{end_wait}"

msgctxt "MsgKolimaYawnTreesAreSoSleepy"
msgid "05780"
msgstr ""
"Yawn... Trees are so...\n"
"sleepy...{end_wait}"

msgctxt "MsgKolimaForAWhileIThoughtId"
msgid "05781"
msgstr ""
"For a while I thought I'd\n"
"never be able to say this,\n"
"but I have to say it!{page_break}"
"I've been waiting all of\n"
"my life for this moment!{end_wait}"

msgctxt "MsgKolimaTheForestTreesAreAliveJust"
msgid "05782"
msgstr ""
"The forest trees are\n"
"alive, just as we are...{end_wait}"

msgctxt "MsgKolimaIWonderIfIdLiveLonger"
msgid "05783"
msgstr ""
"I wonder if I'd live\n"
"longer if I were still\n"
"a tree.{end_wait}"

msgctxt "MsgKolimaIfThoseSparklesStartFallingAgain"
msgid "05784"
msgstr ""
"If those sparkles start\n"
"falling again, I'm heading\n"
"for the hills.{end_wait}"

msgctxt "MsgKolimaIveBeenPoorAllMyLife"
msgid "05785"
msgstr ""
"I've been poor all my life.{page_break}"
"That's why it bothers me\n"
"that McCoy thinks money\n"
"can solve everything.{end_wait}"

msgctxt "MsgKolimaItsNotCalledTheHolyTree"
msgid "05786"
msgstr ""
"It's not called the holy\n"
"tree for nothing.{page_break}"
"We should have been\n"
"more respectful.{end_wait}"

msgctxt "MsgKolimaIfWeWereAllTreesThered"
msgid "05787"
msgstr ""
"If we were all trees,\n"
"there'd be no more wars.{pause_20_skippable}\n"
"'Cause we'd be trees.{end_wait}"

msgctxt "MsgKolimaNobodyYellsAtYouWhenYoure"
msgid "05788"
msgstr ""
"Nobody yells at you when\n"
"you're a tree...{page_break}"
"And nobody makes you go\n"
"to bed early, either.{end_wait}"

msgctxt "MsgKolimaInteriorsIHeardThatTravelingWarriorsFrom"
msgid "05789"
msgstr ""
"I heard that traveling\n"
"warriors from the Goma\n"
"Range saved the village.{page_break}"
"The warriors are said to\n"
"be enormously huge and\n"
"very strong.{page_break}"
"They supposedly defeated\n"
"Tret to remove the curse.{end_wait}"

msgctxt "MsgKolimaInteriorsBigStrongWarriorsWithGreatBeards"
msgid "05790"
msgstr ""
"Big, strong warriors\n"
"with great beards freed\n"
"Kolima from the curse.{page_break}"
"If you see them, please\n"
"thank them for me.{end_wait}"

msgctxt "MsgKolimaInteriorsIDontReallyKnowButYou"
msgid "05791"
msgstr ""
"I don't really know,\n"
"but you should be able\n"
"to tell travelers.{end_wait}"

msgctxt "MsgKolimaInteriorsAllWarriorsAreBigAndAll"
msgid "05792"
msgstr ""
"All warriors are big,\n"
"and all warriors have\n"
"huge beards.{end_wait}"

msgctxt "MsgKolimaInteriorsYouSavedKolimaWowThatMakes"
msgid "05793"
msgstr ""
"You saved Kolima? Wow!\n"
"That makes me want to\n"
"tell you a secret!{page_break}"
"But I'm not gonna. It's\n"
"too good to give away!{end_wait}"

msgctxt "MsgKolimaInteriorsMyHusbandSeemsToBeKeeping"
msgid "05794"
msgstr ""
"My husband seems to be\n"
"keeping a secret\n"
"from me.{end_wait}"

msgctxt "MsgKolimaInteriorsDaddyToldMeHisSecret"
msgid "05795"
msgstr "Daddy told me his secret.{end_wait}"

msgctxt "MsgKolimaInteriorsItsHiddenDeepInTheForest"
msgid "05796"
msgstr ""
"It's hidden deep in\n"
"the forest, but I can't\n"
"tell him that!{end_wait}"

msgctxt "MsgKolimaInteriorsIThinkHeFoundSomethingValuable"
msgid "05797"
msgstr ""
"I think he found something\n"
"valuable, but where\n"
"could he be hiding it?{end_wait}"

msgctxt "MsgKolimaInteriorsStillTellingMeItsOutsideThe"
msgid "05798"
msgstr ""
"Still, telling me it's\n"
"outside the village\n"
"doesn't help much...{end_wait}"

msgctxt "MsgKolimaInteriorsImNeverGoingToUseAn"
msgid "05799"
msgstr ""
"I'm never going to\n"
"use an axe again.{end_wait}"

msgctxt "MsgKolimaInteriorsDadWillYouPleaseGoBack"
msgid "05800"
msgstr ""
"Dad, will you please\n"
"go back to being a\n"
"lumberjack?{end_wait}"

msgctxt "MsgKolimaInteriorsDadHowAreWeGoingTo"
msgid "05801"
msgstr ""
"Dad! How are we going\n"
"to eat if you don't work?{end_wait}"

msgctxt "MsgKolimaInteriorsPeopleTurnedIntoTreesBecauseOf"
msgid "05802"
msgstr ""
"People turned into trees\n"
"because of my axe. I will\n"
"never use an axe again.{end_wait}"

msgctxt "MsgKolimaInteriorsKnowingMyDadHellStartWorking"
msgid "05803"
msgstr ""
"Knowing my Dad, he'll\n"
"start working again once\n"
"he gets hungry.{end_wait}"

msgctxt "MsgKolimaInteriorsHowAmISupposedToGrow"
msgid "05804"
msgstr ""
"How am I supposed to\n"
"grow up if I don't\n"
"eat?{page_break}"
"If he's not gonna feed me,\n"
"I'm not gonna obey him!{end_wait}"

msgctxt "MsgKolimaFuchinTempleOnOtherSide"
msgid "05805"
msgstr ""
"Fuchin Temple is on the\n"
"other side of the river.\n"
"It's quite famous.{page_break}"
"You should visit it if\n"
"you have any spare\n"
"time.{end_wait}"

msgctxt "MsgKolimaInteriorsFuchinTemplesMasterNyunpaIsSaid"
msgid "05806"
msgstr ""
"Fuchin Temple's Master\n"
"Nyunpa is said to be a\n"
"strange one...{end_wait}"

msgctxt "MsgKolimaGrandBridgeAcrossRiverPride"
msgid "05807"
msgstr ""
"The grand bridge across\n"
"the river is the\n"
"pride of Kolima.{end_wait}"

msgctxt "MsgKolimaInteriorsItsAShameWeHadTo"
msgid "05808"
msgstr ""
"It's a shame we had to\n"
"cut down so many trees\n"
"to build that bridge.{end_wait}"

msgctxt "MsgKolimaWhenWasTreeLearnedAppreciate"
msgid "05809"
msgstr ""
"When I was a tree,\n"
"I learned to appreciate\n"
"the sun.{end_wait}"

msgctxt "MsgKolimaInteriorsItFeltSoGoodWhenMy"
msgid "05810"
msgstr ""
"It felt so good\n"
"when my leaves were\n"
"bathed in sunlight.{end_wait}"

msgctxt "MsgKolimaToldHolyTrees"
msgid "05811"
msgstr ""
"I am told the holy tree's\n"
"rage caused this\n"
"horrible incident...{page_break}"
"Do you believe that\n"
"was the only cause?{end_now}"

msgctxt "message"
msgid "05812"
msgstr ""
"You may not have noticed,\n"
"but something changed\n"
"when those gems landed.{end_wait}"

msgctxt "message"
msgid "05813"
msgstr ""
"I agree. Something did\n"
"change when the gems fell.{end_wait}"

msgctxt "MsgKolimaIfTheHolyTreeAloneCaused"
msgid "05814"
msgstr ""
"If the holy tree alone\n"
"caused all this, then I've\n"
"failed in my duty.{page_break}"
"I should have stopped\n"
"them from cutting down\n"
"the tree.{end_wait}"

msgctxt "MsgKolimaTheySayMccoyHaltedConstruction"
msgid "05815"
msgstr ""
"They say that McCoy\n"
"halted construction of\n"
"the palace.{page_break}"
"With no more work, all\n"
"the lumberjacks that came\n"
"to make money will leave.{end_wait}"

msgctxt "MsgKolimaInteriorsWithNoMoreWorkHereKolima"
msgid "05816"
msgstr ""
"With no more work here,\n"
"Kolima can go back to\n"
"being a quiet little village.{end_wait}"

msgctxt "MsgKolimaInteriorsIveBeenALumberjackForYears"
msgid "05817"
msgstr ""
"I've been a lumberjack\n"
"for years, but I've never\n"
"seen anything like this.{page_break}"
"I think I'll go home\n"
"to my family in Imil.{end_wait}"

msgctxt "MsgKolimaInteriorsImOnlyAMerchantButI"
msgid "05818"
msgstr ""
"I'm only a merchant, but\n"
"I got turned into a tree\n"
"just for staying here.{page_break}"
"I think I'll head to Xian,\n"
"south of the river, now\n"
"that I'm a man again.{end_wait}"

msgctxt "MsgKolimaInteriorsTheVillageWasReallyBoomingWith"
msgid "05819"
msgstr ""
"The village was really\n"
"booming with all that\n"
"work...{page_break}"
"But what good is it if\n"
"you get turned into a\n"
"tree.{end_wait}"

msgctxt "MsgKolimaInteriorsRemainingAQuietVillageMeansRemaining"
msgid "05820"
msgstr ""
"Remaining a quiet village\n"
"means remaining poor.{page_break}"
"I was hoping Kolima\n"
"would flourish with all\n"
"the construction.{end_wait}"

msgctxt "MsgKolimaInteriorsImALumberjackAndImOkay"
msgid "05821"
msgstr ""
"I'm a lumberjack,\n"
"and I'm okay{pause_20_skippable} with that.{end_wait}"

msgctxt "MsgKolimaInteriorsIWishIdGrabbedSomeOf"
msgid "05822"
msgstr ""
"I wish I'd grabbed\n"
"some of those gems\n"
"that fell from the sky.{page_break}"
"They must be\n"
"worth a fortune!{end_wait}"

msgctxt "MsgBilibinWasTurnedIntoTreeFor"
msgid "05823"
msgstr ""
"I was turned into\n"
"a tree for a while...\n"
"Can you believe it?{end_now}"

msgctxt "message"
msgid "05824"
msgstr ""
"I think I now know what\n"
"it means to sink your\n"
"roots in one place.{page_break}"
"But I wouldn't recommend\n"
"it to anyone else.{end_wait}"

msgctxt "message"
msgid "05825"
msgstr ""
"Yeah, I can't even\n"
"believe it myself.{end_wait}"

msgctxt "MsgBilibinWelcomeToBilibinWellForgetThat"
msgid "05826"
msgstr ""
"Welcome to Bilibin.{pause_20_skippable}\n"
"We'll forget that whole\n"
"curse business in no time!{end_wait}"

msgctxt "MsgBilibinIfYoureTalkingAboutTheTravelers"
msgid "05827"
msgstr ""
"If you're talking about\n"
"the travelers from Imil,\n"
"they crossed the river.{end_wait}"

msgctxt "MsgBilibinYoureWonderingAboutTheTreeNear"
msgid "05828"
msgstr ""
"You're wondering about\n"
"the tree near the\n"
"village entrance?{page_break}"
"It turned back\n"
"into a person. Thank\n"
"goodness!{end_wait}"

msgctxt "MsgBilibinISawLordMccoyTheChief"
msgid "05829"
msgstr ""
"I saw Lord McCoy, the\n"
"chief of Bilibin,\n"
"walking through town{page_break}"
"for the first time in\n"
"a long while...{page_break}"
"He must be relieved\n"
"to see that the curse\n"
"has been broken.{end_wait}"

msgctxt "MsgBilibinIHearTheBarricadeGateThat"
msgid "05830"
msgstr ""
"I hear the barricade gate\n"
"that blocked the road\n"
"to Kolima is open again.{end_wait}"

msgctxt "MsgBilibinThoseThreeKidsVanishedDuringAll"
msgid "05831"
msgstr ""
"Those three kids vanished\n"
"during all that trouble\n"
"with the curse.{end_wait}"

msgctxt "MsgBilibinCurseWasBrokenThanksEfforts"
msgid "05832"
msgstr ""
"The curse was broken\n"
"all thanks to the efforts\n"
"of three young warriors.{page_break}"
"Say... You're not the\n"
"young warriors, are you?{end_now}"

msgctxt "message"
msgid "05833"
msgstr ""
"That's amazing! You broke\n"
"the so-called curse!{end_wait}"

msgctxt "message"
msgid "05834"
msgstr ""
"I didn't think so. You\n"
"don't look very tough\n"
"at all.{end_wait}"

msgctxt "MsgBilibinLordMccoysMenSaidTheySaw"
msgid "05835"
msgstr ""
"Lord McCoy's men said\n"
"they saw the ones who\n"
"saved the village.{end_wait}"

msgctxt "MsgBilibinHaveEverBeenVillageImil"
msgid "05836"
msgstr ""
"Have you ever been to\n"
"the village of Imil,\n"
"up north?{end_now}"

msgctxt "message"
msgid "05837"
msgstr ""
"Did you see the great\n"
"lighthouse over there?\n"
"I bet it was amazing!{end_wait}"

msgctxt "message"
msgid "05838"
msgstr ""
"If you ever go there,\n"
"be sure to visit their\n"
"famous lighthouse.{end_wait}"

msgctxt "MsgBilibinTheEruptionOnTheOtherSide"
msgid "05839"
msgstr ""
"The eruption on the other\n"
"side of the mountains\n"
"seems to have stopped.{page_break}"
"Things are finally\n"
"peaceful again.{end_wait}"

msgctxt "MsgBilibinNowThatTheCurseIsBroken"
msgid "05840"
msgstr ""
"Now that the curse\n"
"is broken, why don't we\n"
"start construction again?{end_wait}"

msgctxt "MsgBilibinItsOverOverMilordDecidedNot"
msgid "05841"
msgstr ""
"It's over! Over! Milord\n"
"decided not to\n"
"build the palace.{end_wait}"

msgctxt "MsgBilibinHmphMyPalaceIsNotFinished"
msgid "05842"
msgstr ""
"Hmph! My palace is not\n"
"finished!{page_break}"
"McCoy loves that holy\n"
"tree more than he\n"
"loves me!{end_wait}"

msgctxt "MsgBilibinINeverWantToBeTurned"
msgid "05843"
msgstr ""
"I never want to be\n"
"turned into a tree again.\n"
"It was terrible.{end_wait}"

msgctxt "MsgBilibinNotManyLumberjacksAreWillingTo"
msgid "05844"
msgstr ""
"Not many lumberjacks are\n"
"willing to cut trees in\n"
"Kolima forest anymore.{end_wait}"

msgctxt "MsgBilibinOneOfTheTwoPeopleThat"
msgid "05845"
msgstr ""
"One of the two people\n"
"that came later was\n"
"apparently injured...{end_wait}"

msgctxt "MsgBilibinThatGuyMightTurnIntoA"
msgid "05846"
msgstr ""
"That guy might turn\n"
"into a tree again if you\n"
"go near him...{end_wait}"

msgctxt "MsgBilibinLordMccoySeemsToBeHaving"
msgid "05847"
msgstr ""
"Lord McCoy seems to be\n"
"having a spat with his\n"
"wife. I wonder who'll win?{end_wait}"

msgctxt "MsgBilibinApparentlyJustAboutAnyoneCouldJust"
msgid "05848"
msgstr ""
"Apparently, just about\n"
"anyone could just waltz\n"
"through that barricade.{end_wait}"

msgctxt "MsgBilibinTheGangOfThreeHaTheyre"
msgid "05849"
msgstr ""
"\"The Gang of Three\"{em_dash}HA!\n"
"They're probably just\n"
"dozing somewhere.{end_wait}"

msgctxt "MsgBilibinImSureLordMccoyWillGive"
msgid "05850"
msgstr ""
"I'm sure Lord McCoy will\n"
"give you a great reward!\n"
"I wonder what it will be!{end_wait}"

msgctxt "MsgBilibinTheyMustBeReportingYourDeeds"
msgid "05851"
msgstr ""
"They must be reporting\n"
"your deeds to Lord\n"
"McCoy right now!{end_wait}"

msgctxt "MsgBilibinIWantToShareWithYou"
msgid "05852"
msgstr ""
"I want to share with you\n"
"this sense of joy\n"
"that I feel!{end_wait}"

msgctxt "MsgBilibinAsLongAsImOkayI"
msgid "05853"
msgstr ""
"As long as I'm okay, I\n"
"really don't care what\n"
"happens to anyone else.{end_wait}"

msgctxt "MsgBilibinWedStillBeWorkingIfWe"
msgid "05854"
msgstr ""
"We'd still be working\n"
"if we hadn't tried building\n"
"using the holy tree.{page_break}"
"I told them\n"
"not to use it.{end_wait}"

msgctxt "MsgBilibinThatWasCloseBuildingACursed"
msgid "05855"
msgstr ""
"That was close!{page_break}"
"Building a cursed\n"
"palace looks really\n"
"bad on your resume.{end_wait}"

msgctxt "MsgBilibinHeSaidHeStoppedConstructionSo"
msgid "05856"
msgstr ""
"He said he stopped\n"
"construction so that I\n"
"would not be cursed...{page_break}"
"I think he's just\n"
"trying to weasel out\n"
"of his promise!{end_wait}"

msgctxt "MsgBilibinDoKnowIfHolyTree"
msgid "05857"
msgstr ""
"Do you know if the\n"
"holy tree survived?{end_now}"

msgctxt "message"
msgid "05858"
msgstr ""
"That makes sense. Those\n"
"who were turned into\n"
"trees are back to normal.{page_break}"
"I am sure the holy tree\n"
"of Kolima Forest\n"
"survived, too!{end_wait}"

msgctxt "message"
msgid "05859"
msgstr ""
"Then how did the people\n"
"who became trees get\n"
"returned to normal?{page_break}"
"Did we just imagine\n"
"the whole thing?{end_wait}"

msgctxt "MsgBilibinThankGoodnessTheyStoppedConstructionOf"
msgid "05860"
msgstr ""
"Thank goodness they\n"
"stopped construction\n"
"of the palace.{page_break}"
"Lady McCoy seemed very\n"
"disappointed, though.{end_wait}"

msgctxt "MsgBilibinItTakesManyYearsForA"
msgid "05861"
msgstr ""
"It takes many years for a\n"
"tree to grow so old\n"
"that it becomes holy.{page_break}"
"No human should\n"
"ever kill a tree as\n"
"precious as that.{end_wait}"

msgctxt "MsgBilibinSometimesIWishICouldSee"
msgid "05862"
msgstr ""
"Sometimes, I wish I could\n"
"see what the palace\n"
"would have been like.{end_wait}"

msgctxt "MsgBilibinIAlwaysMissAltinInThe"
msgid "05863"
msgstr ""
"I always miss Altin\n"
"in the winter.{page_break}"
"I used to work there in\n"
"the mines, and the winters\n"
"were always so warm.{end_wait}"

msgctxt "MsgBilibinMyFatherSaysThatItsWarm"
msgid "05864"
msgstr ""
"My father says that it's\n"
"warm all year long on the\n"
"other side of the river.{end_wait}"

msgctxt "MsgBilibinIWonderIfThereAreStill"
msgid "05865"
msgstr ""
"I wonder if there are\n"
"still beautiful gems in\n"
"Altin Mine...{end_wait}"

msgctxt "MsgBilibinMyFatherHasTraveledAllOver"
msgid "05866"
msgstr ""
"My father has traveled\n"
"all over the world.{end_wait}"

msgctxt "MsgBilibinTheRoadToKolimaIsOpen"
msgid "05867"
msgstr ""
"The road to Kolima is\n"
"open again. You can finally\n"
"continue on your journey.{end_wait}"

msgctxt "MsgBilibinDoKnowSilk"
msgid "05868"
msgstr "Do you know what silk is?{end_now}"

msgctxt "message"
msgid "05869"
msgstr ""
"That's what they make in\n"
"Xian village on the other\n"
"side of the river.{page_break}"
"The long road that runs\n"
"from there is called\n"
"Silk Road.{end_wait}"

msgctxt "message"
msgid "05870"
msgstr ""
"Caterpillars are raised\n"
"on mulberry leaves.{page_break}"
"When the caterpillars'\n"
"cocoons are unwound,\n"
"they become silk thread.{page_break}"
"The thread is then woven\n"
"into cloth used\n"
"to make clothing{page_break}"
"for wealthy people like\n"
"Lady McCoy.{end_wait}"

msgctxt "MsgBilibinTravelingMakesYoungWarriorsStronger"
msgid "05871"
msgstr ""
"Traveling makes young\n"
"warriors stronger.{end_wait}"

msgctxt "MsgBilibinClothesMadeWithSilkAreSo"
msgid "05872"
msgstr ""
"Clothes made with silk\n"
"are so smooth and shiny.{end_wait}"

msgctxt "MsgBilibinIThoughtISawLightsIn"
msgid "05873"
msgstr ""
"I thought I saw lights in\n"
"the sky over Imil last\n"
"night.{page_break}"
"Could the legendary\n"
"lighthouse have been...?{end_wait}"

msgctxt "MsgBilibinHisEyesAreRedBecauseHe"
msgid "05874"
msgstr ""
"His eyes are red\n"
"because he stayed up\n"
"late last night.{end_wait}"

msgctxt "MsgBilibinTheresNoDoubtAboutItIts"
msgid "05875"
msgstr ""
"There's no doubt about it!\n"
"It's the light from the\n"
"lighthouse near Imil.{end_wait}"

msgctxt "MsgBilibinWhatsTheBigDealWhyAre"
msgid "05876"
msgstr ""
"What's the big deal? Why\n"
"are you making a fuss\n"
"about a lighthouse?{end_wait}"

msgctxt "MsgBilibinOurWeaponsBestCanFind"
msgid "05877"
msgstr ""
"Our weapons are the best\n"
"you can find...{page_break}"
"But you should also try\n"
"the store in Altin, south\n"
"of the river.{end_wait}"

msgctxt "MsgBilibinAltinsGotGoodWeaponsButI"
msgid "05878"
msgstr ""
"Altin's got good weapons,\n"
"but I still think my\n"
"selection is better.{end_wait}"

msgctxt "MsgBilibinForSomeReasonOceanFills"
msgid "05879"
msgstr ""
"For some reason, the\n"
"ocean fills me with\n"
"hope and desire...{page_break}"
"If you ever see the\n"
"ocean, remember men like\n"
"me, who dream about it.{end_wait}"

msgctxt "MsgBilibinIWishICouldGoOut"
msgid "05880"
msgstr ""
"I wish I could go out\n"
"onto the ocean! Maybe I\n"
"should go on a journey...{page_break}"
"But no, I don't have\n"
"that kind of courage.{end_wait}"

msgctxt "MsgBilibinTurnedOutWarriorsHiredBy"
msgid "05881"
msgstr ""
"It turned out that all\n"
"the warriors hired by\n"
"Lord McCoy were useless!{page_break}"
"Except for those cute\n"
"warriors who removed the\n"
"curse, that is.{end_wait}"

msgctxt "MsgBilibinTheyCallThemselvesWarriorsButYou"
msgid "05882"
msgstr ""
"They call themselves\n"
"warriors...{page_break}"
"but you can't count on\n"
"any of them in real\n"
"emergencies.{end_wait}"

msgctxt "MsgBilibinWasntCurseInKolimaHorrifying"
msgid "05883"
msgstr ""
"Wasn't that curse in\n"
"Kolima horrifying?{end_now}"

msgctxt "message"
msgid "05884"
msgstr ""
"Even heroes like\n"
"you can feel fear.{page_break}"
"Just imagine how\n"
"scary it was for us\n"
"poor townsfolk.{end_wait}"

msgctxt "message"
msgid "05885"
msgstr ""
"You can say that now,\n"
"because it's all over.{page_break}"
"At the time, we\n"
"were all scared out\n"
"of our pants.{end_wait}"

msgctxt "MsgBilibinThereWillBeFewerGuestsNow"
msgid "05886"
msgstr ""
"There will be fewer\n"
"guests now that the\n"
"fuss is over.{page_break}"
"Whoever ended the\n"
"curse sure didn't do\n"
"us any favors.{end_wait}"

msgctxt "MsgBilibinTwoSpecialsOneDinnerOne"
msgid "05887"
msgstr ""
"Two specials! One dinner!\n"
"One sandwich! One\n"
"dessert! Hurry up!{end_wait}"

msgctxt "message"
msgid "05888"
msgstr ""
"Hey, you! Are you done\n"
"yet?{end_wait}"

msgctxt "message"
msgid "05889"
msgstr "Almost...{end_wait}"

msgctxt "MsgBilibinIfWantMealSpeakWaitress"
msgid "05890"
msgstr ""
"If you want a meal,\n"
"speak to the waitress.{end_wait}"

msgctxt "MsgBilibinReallyThinkHeadChefHas"
msgid "05891"
msgstr ""
"I really think the\n"
"head chef has changed.\n"
"It's too much!{end_wait}"

msgctxt "message"
msgid "05892"
msgstr ""
"I can't keep up\n"
"with his energy!{end_wait}"

msgctxt "MsgBilibinLetsSeeServeThemWater"
msgid "05893"
msgstr ""
"Let's see, serve them\n"
"water...then get the\n"
"silverware.{end_wait}"

msgctxt "message"
msgid "05894"
msgstr ""
"The head chef will yell\n"
"if you slow down...{end_wait}"

msgctxt "MsgBilibinImALittleSurprisedThatThe"
msgid "05895"
msgstr ""
"I'm a little surprised\n"
"that the head chef\n"
"is working so hard.{end_wait}"

msgctxt "MsgBilibinTheresNoBusinessHereSoIm"
msgid "05896"
msgstr ""
"There's no business\n"
"here, so I'm heading south\n"
"of the river to Xian.{page_break}"
"Perhaps I'll take Silk\n"
"Road as far as Tolbi.{end_wait}"

msgctxt "MsgBilibinTheyServedSoMuchFoodToday"
msgid "05897"
msgstr ""
"They served so much food\n"
"today!{page_break}"
"If they do that\n"
"every day, they won't\n"
"make any money!{end_wait}"

msgctxt "MsgBilibinWasSomeMealDontJust"
msgid "05898"
msgstr ""
"That was some meal!\n"
"Don't you just love\n"
"the food here?{end_now}"

msgctxt "message"
msgid "05899"
msgstr ""
"I know how you feel.\n"
"Go find a table\n"
"and pig out!{end_wait}"

msgctxt "message"
msgid "05900"
msgstr ""
"What!? Why am I even\n"
"talking to you, when\n"
"I could be eating!?{end_wait}"

msgctxt "MsgBilibinOooohThatsItITriedMy"
msgid "05901"
msgstr ""
"Ooooh...{pause_20_skippable} That's it...\n"
"I tried my best, but I\n"
"couldn't eat another bite...{end_wait}"

msgctxt "MsgBilibinTheIncidentWasResolvedBeforeI"
msgid "05902"
msgstr ""
"The incident was resolved\n"
"before I knew it...{page_break}"
"Maybe I'll head south of\n"
"the river to find\n"
"another job.{end_wait}"

msgctxt "MsgBilibinIWonderWhatThatEerieHowling"
msgid "05903"
msgstr ""
"I wonder what that eerie\n"
"howling coming from south\n"
"of the river was...{page_break}"
"It really gave me\n"
"the heebie-jeebies.{end_wait}"

msgctxt "MsgBilibinWellIWasOnlyActingScared"
msgid "05904"
msgstr ""
"Well, I was only acting\n"
"scared so that I'd fit in.\n"
"I wasn't really scared.{end_wait}"

msgctxt "MsgBilibinItdBeBetterForBusinessIf"
msgid "05905"
msgstr ""
"It'd be better for\n"
"business if the curse had\n"
"not been broken so fast.{end_wait}"

msgctxt "MsgBilibinIllGoToKolimaWhenThe"
msgid "05906"
msgstr ""
"I'll go to Kolima when\n"
"the customers are gone.{page_break}"
"But in the meantime,\n"
"I'll cook like there's\n"
"no tomorrow!{end_wait}"

msgctxt "MsgBilibinLetsSeeSoupSaladAndI"
msgid "05907"
msgstr ""
"Let's see... Soup...\n"
"salad...and...\n"
"I forgot the dressing.{end_wait}"

msgctxt "MsgBilibinTheHeadChefWasSoLazy"
msgid "05908"
msgstr ""
"The head chef was so\n"
"lazy until just the\n"
"other day, but all of{page_break}"
"a sudden, I'm having\n"
"trouble keeping up with\n"
"how much he's changed.{end_wait}"

msgctxt "MsgBilibinItUsedToTakeThemSo"
msgid "05909"
msgstr ""
"It used to take them so\n"
"long to serve your order,\n"
"but not anymore!{end_wait}"

msgctxt "MsgBilibinWhenTheyStoppedBuildingThePalace"
msgid "05910"
msgstr ""
"When they stopped\n"
"building the palace, I\n"
"lost all my business.{page_break}"
"Maybe I'll buy some silk in\n"
"Xian and sell it in Tolbi.{end_wait}"

msgctxt "MsgBilibinIWishICouldEatLike"
msgid "05911"
msgstr ""
"I wish I could eat like\n"
"this all the time!{end_wait}"

msgctxt "MsgBilibinIdBetterEatALotThat"
msgid "05912"
msgstr ""
"I'd better eat a lot; that\n"
"chef's gonna burn out\n"
"in no time at this rate!{end_wait}"

msgctxt "MsgBilibinTheFoodIsSuchAGood"
msgid "05913"
msgstr ""
"The food is such a good\n"
"value at this price!{end_wait}"

msgctxt "MsgBilibinIfAKidLikeThisCould"
msgid "05914"
msgstr ""
"If a kid like this could\n"
"end the curse, maybe I\n"
"could have done the job.{end_wait}"

msgctxt "MsgBilibinItLooksLikeScaryThingsAre"
msgid "05915"
msgstr ""
"It looks like scary\n"
"things are happening all\n"
"over the world...{end_wait}"

msgctxt "MsgSanctumCurseMayOverButWe"
msgid "05916"
msgstr ""
"The curse may be over,\n"
"but we can't drop our\n"
"guard yet.{page_break}"
"It's still not entirely safe\n"
"wandering outside of\n"
"town.{end_wait}"

msgctxt "MsgSanctumHowAboutThatOurWishesHave"
msgid "05917"
msgstr ""
"How about that? Our\n"
"wishes have come true.{end_wait}"

msgctxt "MsgSanctumTheSignsOfDangerAreActually"
msgid "05918"
msgstr ""
"The signs of danger are\n"
"actually more numerous\n"
"than they were before.{end_wait}"

msgctxt "MsgSanctumPeaceWillBeKeptAsLong"
msgid "05919"
msgstr ""
"Peace will be kept\n"
"as long as we continue\n"
"our meditations.{end_wait}"

msgctxt "MsgBilibinOhItS"
msgid "05920"
msgstr "Oh!{pause_20_skippable} It's...{end_wait}"

msgctxt "message"
msgid "05921"
msgstr "Oh! Sir!{end_wait}"

msgctxt "message"
msgid "05922"
msgstr ""
"We've been looking\n"
"everywhere for you!{end_wait}"

msgctxt "message"
msgid "05923"
msgstr ""
"The curse of the holy\n"
"tree... {pause_20_skippable}You're the ones\n"
"who broke it, right?{end_now}"

msgctxt "MsgBilibinNotTrueWitnesses"
msgid "05924"
msgstr ""
"That's not true. We have\n"
"witnesses who say they\n"
"saw you in the forest!{end_wait}"

msgctxt "message"
msgid "05925"
msgstr "It was you, wasn't it?{end_now}"

msgctxt "MsgBilibinUnderArrest"
msgid "05926"
msgstr "You're under arrest!{end_wait}"

msgctxt "message"
msgid "05927"
msgstr ""
"Let's go.\n"
"Lord McCoy is waiting.{end_wait}"

msgctxt "MsgBilibinWeveBroughtWarriorsMilord"
msgid "05928"
msgstr ""
"We've brought the\n"
"warriors, milord.{end_wait}"

msgctxt "message"
msgid "05929"
msgstr ""
"We brought the warriors,\n"
"as you ordered, milord.{end_wait}"

msgctxt "message"
msgid "05930"
msgstr ""
"So{pause_20_skippable}, yeh're the wee{pause_20_skippable}{em_dash}I\n"
"mean, brave{em_dash}lads I\n"
"met before!{end_wait}"

msgctxt "message"
msgid "05931"
msgstr ""
"So{pause_20_skippable}, yeh're the wee{pause_20_skippable}{em_dash}I\n"
"mean, brave{em_dash}lads who\n"
"saved Kolima?{end_wait}"

msgctxt "message"
msgid "05932"
msgstr ""
"What were yer\n"
"names, again?{end_wait}"

msgctxt "message"
msgid "05933"
msgstr ""
"What are yer\n"
"names, then?{end_wait}"

msgctxt "message"
msgid "05934"
msgstr ""
"He's {actor_name:1}, sir,\n"
"and I'm {actor_name:2}...{end_wait}"

msgctxt "message"
msgid "05935"
msgstr "I am called {actor_name:3}.{end_wait}"

msgctxt "message"
msgid "05936"
msgstr ""
"And I am {actor_name:4}, from\n"
"the village of Imil.{end_wait}"

msgctxt "message"
msgid "05937"
msgstr "{actor_name:1} and company...{end_wait}"

msgctxt "message"
msgid "05938"
msgstr ""
"And did I not decline\n"
"yer offer when we\n"
"first met?{end_now}"

msgctxt "message"
msgid "05939"
msgstr ""
"I did nae give it enough\n"
"consideration back then.{end_wait}"

msgctxt "message"
msgid "05940"
msgstr ""
"Are yeh no' just sayin'\n"
"that tae appease me?{end_wait}"

msgctxt "message"
msgid "05941"
msgstr ""
"And yet yeh went oan tae\n"
"break the curse despite\n"
"my words, did yeh not?{end_now}"

msgctxt "message"
msgid "05942"
msgstr ""
"Are yeh no' the ones\n"
"who ended the curse\n"
"of the holy tree?{end_now}"

msgctxt "MsgBilibinHumblyThank"
msgid "05943"
msgstr "I humbly thank you.{end_wait}"

msgctxt "MsgBilibinNaeYehDinnaeNeedTae"
msgid "05944"
msgstr ""
"Nae, yeh dinnae need tae\n"
"hide it.{pause_20_skippable} My men told\n"
"me aught yeh did.{end_wait}"

msgctxt "MsgBilibinWasButWorriedYehMight"
msgid "05945"
msgstr ""
"I was but worried yeh\n"
"might nae stop here\n"
"on yer way back.{end_wait}"

msgctxt "message"
msgid "05946"
msgstr ""
"I want tae show my\n"
"appreciation for yer\n"
"help...{end_wait}"

msgctxt "message"
msgid "05947"
msgstr ""
"I relied oan my money,{pause_20_skippable}\n"
"but I forgot about\n"
"my people's needs.{end_wait}"

msgctxt "message"
msgid "05948"
msgstr ""
"Yeh reminded me\n"
"of my duties.{end_wait}"

msgctxt "message"
msgid "05949"
msgstr ""
"As lord of these lands, I\n"
"will do my best for\n"
"everyone's behalf.{end_wait}"

msgctxt "message"
msgid "05950"
msgstr ""
"{actor_name:1}, it would honor me\n"
"greatly if yeh'd accept a wee\n"
"token of my gratitude.{end_wait}"

msgctxt "message"
msgid "05951"
msgstr ""
"I could give it tae yeh\n"
"here, but would yeh no'\n"
"rather choose it yerself?{end_now}"

msgctxt "message"
msgid "05952"
msgstr ""
"Very well. Yeh can choose\n"
"somethin' that'll help\n"
"yeh along yer way.{end_wait}"

msgctxt "message"
msgid "05953"
msgstr ""
"Words are nae enough\n"
"tae express my regret\n"
"in doubting yeh.{page_break}"
"Please, choose a token\n"
"in thanks for yer\n"
"service.{end_wait}"

msgctxt "message"
msgid "05954"
msgstr ""
"I will show {actor_name:1} and\n"
"his friends the way,\n"
"milord.{end_wait}"

msgctxt "message"
msgid "05955"
msgstr ""
"Many thanks tae yeh,\n"
"and tae yer companions,\n"
"as well!!{end_wait}"

msgctxt "message"
msgid "05956"
msgstr ""
"Visit me anytime!{pause_20_skippable} Yeh'll\n"
"always find a warm\n"
"hearth here!{end_wait}"

msgctxt "message"
msgid "05957"
msgstr ""
"Follow me, and I'll\n"
"take you to the\n"
"treasure room.{end_wait}"

msgctxt "MsgBilibinLordMccoyOrdered"
msgid "05958"
msgstr ""
"Lord McCoy ordered that\n"
"{actor_name:1} and his companions\n"
"be brought here.{page_break}"
"Please show them\n"
"their reward!{end_wait}"

msgctxt "MsgBilibinYouMaySelectASingleItem"
msgid "05959"
msgstr ""
"You may select a single\n"
"item from among these\n"
"four chests.{end_wait}"

msgctxt "MsgBilibinPleaseTakeYourRewardBefore"
msgid "05960"
msgstr ""
"Please take your reward\n"
"before your depart!{end_wait}"

msgctxt "MsgBilibinAlwaysWelcomeInPalaceLord"
msgid "05961"
msgstr ""
"You are always welcome in\n"
"the palace of Lord McCoy.{end_wait}"

msgctxt "MsgBilibinTheseCourageousWarriorsDeserveToReceive"
msgid "05962"
msgstr ""
"These courageous\n"
"warriors deserve to\n"
"receive milord's treasure.{end_wait}"

msgctxt "MsgBilibinMayChooseOnlyOneItem"
msgid "05963"
msgstr ""
"You may choose only one\n"
"item, but I trust that all\n"
"of them will prove useful.{end_wait}"

msgctxt "MsgBilibinNonethelessIfYourLuckSour"
msgid "05964"
msgstr ""
"Nonetheless...if your luck\n"
"is sour, you may end up\n"
"an item you do not need.{end_wait}"

msgctxt "MsgBilibinIsaacCheckedChestButWas"
msgid "05965"
msgstr ""
"{protagonist_name} checked\n"
"the chest...{page_break}"
"but it was empty.{end_wait}"

msgctxt "MsgBilibinTreasureChestLocked"
msgid "05966"
msgstr ""
"The treasure chest\n"
"is locked.{end_wait}"

msgctxt "MsgBilibinYehveTaughtMeThatICannae"
msgid "05967"
msgstr ""
"Yeh've taught me that I\n"
"cannae judge a man by his\n"
"age or appearance.{end_wait}"

msgctxt "MsgBilibinFineWarrior"
msgid "05968"
msgstr "You{pause_20_skippable} are a fine warrior.{end_wait}"

msgctxt "MsgBilibinDoThinkCanBecomeAs"
msgid "05969"
msgstr ""
"Do you think I can\n"
"become as fine a\n"
"warrior as you?{end_now}"

msgctxt "message"
msgid "05970"
msgstr ""
"Really?{pause_20_skippable} Then I will try\n"
"my best!{end_wait}"

msgctxt "message"
msgid "05971"
msgstr ""
"Don't be so harsh...{pause_20_skippable}\n"
"Just say yes, even if\n"
"you don't mean it.{end_wait}"

msgctxt "MsgBilibinICouldNeverHaveGoneTo"
msgid "05972"
msgstr ""
"I could never have gone\n"
"to the village of Kolima\n"
"knowing the danger.{page_break}"
"You are truly courageous\n"
"warriors.{end_wait}"

msgctxt "MsgBilibinButICannaeFiggerOutHow"
msgid "05973"
msgstr ""
"But I cannae figger out\n"
"how ye got past the\n"
"barricade...{page_break}"
"when yeh did nae\n"
"e'en have the key...{end_wait}"

msgctxt "MsgBilibinSometimesWeNeedChildrenRemind"
msgid "05974"
msgstr ""
"Sometimes, we need\n"
"children to remind us of\n"
"our own responsibilities.{end_wait}"

msgctxt "MsgBilibinIWillBeAReliableWarrior"
msgid "05975"
msgstr ""
"I will be a reliable\n"
"warrior, like {actor_name:1}\n"
"and his companions.{end_wait}"

msgctxt "MsgBilibinDontLeaveIsaacBeMyMentor"
msgid "05976"
msgstr ""
"Don't leave, {actor_name:1}!\n"
"Be my mentor, and\n"
"teach me to be brave!{end_wait}"

msgctxt "MsgBilibinThePeopleOfBilibinWillNever"
msgid "05977"
msgstr ""
"The people of Bilibin\n"
"will never forget\n"
"your bravery.{end_wait}"

msgctxt "MsgBilibinIHeardYouReceivedASpectacular"
msgid "05978"
msgstr ""
"I heard you received\n"
"a spectacular reward.{page_break}"
"I hope that shows you\n"
"how nice Lord McCoy\n"
"really can be.{end_wait}"

msgctxt "MsgBilibinLadyMccoyIsQuiteUpsetThat"
msgid "05979"
msgstr ""
"Lady McCoy is quite\n"
"upset that the palace\n"
"construction was halted.{page_break}"
"You probably won't want\n"
"to approach her for a\n"
"while.{end_wait}"

msgctxt "MsgBilibinThingsAreLookingGrimSouthOf"
msgid "05980"
msgstr ""
"Things are looking grim\n"
"south of Goma Range...\n"
"Black clouds are looming.{page_break}"
"If you're headed that\n"
"way, be prepared for\n"
"rain.{end_wait}"

msgctxt "MsgBilibinMiladyWasVeryUpsetWhenShe"
msgid "05981"
msgstr ""
"Milady was very upset\n"
"when she left the room.{pause_20_skippable}\n"
"Oh my...{end_wait}"

msgctxt "MsgBilibinIFeelSorryForTheWarriors"
msgid "05982"
msgstr ""
"I feel sorry for the\n"
"warriors Lord\n"
"McCoy hired.{page_break}"
"Milord will have strong\n"
"words for them if they\n"
"ever come back.{end_wait}"

msgctxt "MsgBilibinIWonderWhatKindOfTreasure"
msgid "05983"
msgstr ""
"I wonder what kind of\n"
"treasure Lord McCoy\n"
"gave them...{end_wait}"

msgctxt "MsgBilibinIWishShedJustStopWhining"
msgid "05984"
msgstr ""
"I wish she'd just\n"
"stop whining...{page_break}"
"I don't have a palace\n"
"either, and you don't\n"
"see me crying about it.{end_wait}"

msgctxt "MsgBilibinTheydBeGuaranteedAGoodLife"
msgid "05985"
msgstr ""
"They'd be guaranteed a\n"
"good life if they stayed in\n"
"Bilibin under the trust of{page_break}"
"Lord McCoy. I wonder\n"
"why they travel on\n"
"as warriors.{end_wait}"

msgctxt "MsgBilibinICanTellWhenShesUpset"
msgid "05986"
msgstr ""
"I can tell when she's\n"
"upset{em_dash}she always\n"
"slams the door.{end_wait}"

msgctxt "MsgBilibinForOnceMilordDidntLetLady"
msgid "05987"
msgstr ""
"For once, milord didn't\n"
"let Lady McCoy push\n"
"him around!{page_break}"
"He seems much more\n"
"dashing now... Hee hee!{end_wait}"

msgctxt "MsgBilibinAaaah"
msgid "05988"
msgstr "AAAAH!!!{end_wait}"

msgctxt "message"
msgid "05989"
msgstr ""
"Oh!{pause_20_skippable} For a second, I\n"
"thought you were milady.{page_break}"
"You really startled me!{end_wait}"

msgctxt "MsgBilibinSometimesAMansJustGottaPut"
msgid "05990"
msgstr ""
"Sometimes, a man's just\n"
"gotta put his foot down.\n"
"And oh! What a man!{end_wait}"

msgctxt "MsgBilibinTheHoleInThisNightgownIs"
msgid "05991"
msgstr ""
"The hole in this nightgown\n"
"is just getting bigger.{page_break}"
"Has somebody else\n"
"been wearing it?{end_wait}"

msgctxt "MsgBilibinItsVeryRecklessForSuch"
msgid "05992"
msgstr ""
"It's very reckless for\n"
"such young warriors to\n"
"face the holy tree...{end_wait}"

msgctxt "MsgBilibinWasWatchingFromHereAfter"
msgid "05993"
msgstr ""
"I was watching from here.\n"
"After all that fuss,\n"
"you still went to Kolima?{end_now}"

msgctxt "message"
msgid "05994"
msgstr ""
"I don't know how you\n"
"removed the curse,\n"
"but you're the best!{end_wait}"

msgctxt "message"
msgid "05995"
msgstr ""
"You lie! I saw you\n"
"walking through the\n"
"barricade!{page_break}"
"And then I saw you again,\n"
"coming back through after\n"
"the forest turned green!{end_wait}"

msgctxt "MsgBilibinLookedVeryCourageousWalkingToward"
msgid "05996"
msgstr ""
"You looked very\n"
"courageous walking\n"
"toward Kolima.{end_wait}"

msgctxt "MsgBilibinACourageousWarriorWouldntThinkTwice"
msgid "05997"
msgstr ""
"A courageous warrior\n"
"wouldn't think twice about\n"
"being turned into a tree.{end_wait}"

msgctxt "MsgBilibinRewardReceivedWasIndeedGreatest"
msgid "05998"
msgstr ""
"The reward you received\n"
"was indeed the greatest\n"
"of treasures.{page_break}"
"Courageous people\n"
"have the best luck!{end_wait}"

msgctxt "MsgBilibinGotPrettyNiceRewardBut"
msgid "05999"
msgstr ""
"You got a pretty nice\n"
"reward, but I think you\n"
"were just unlucky.{page_break}"
"I don't want you to\n"
"feel bad, so I'll tell\n"
"you something good.{end_wait}"

msgctxt "MsgBilibinOhItLooksLikeSheIs"
msgid "06000"
msgstr ""
"Oh, it looks like\n"
"she is okay.{end_wait}"

msgctxt "MsgBilibinTheyCrossedTheRiverAfterPushing"
msgid "06001"
msgstr ""
"They crossed the river\n"
"after pushing us down.{page_break}"
"This is terrible!\n"
"How could anyone\n"
"do that?{end_wait}"

msgctxt "MsgBilibinShellBeSweptDownstreamIfShe"
msgid "06002"
msgstr ""
"She'll be swept\n"
"downstream if she isn't\n"
"pulled to shore!{end_wait}"

msgctxt "MsgBilibinAhhhhPleaseAnyonePleaseHelp"
msgid "06003"
msgstr ""
"AHHHH! Please! Anyone!\n"
"Please help!{end_wait}"

msgctxt "MsgBilibinThankSavedMeFromBeing"
msgid "06004"
msgstr ""
"Thank you! You saved\n"
"me from being washed\n"
"downstream!{end_wait}"

msgctxt "MsgBilibinYoureGuy"
msgid "06005"
msgstr "Hey!{pause_20_skippable} You're that guy!{end_wait}"

msgctxt "message"
msgid "06006"
msgstr ""
"Jill, are these the\n"
"people who saved you?{end_wait}"

msgctxt "message"
msgid "06007"
msgstr ""
"Remember me?\n"
"I was that tree!{end_wait}"

msgctxt "message"
msgid "06008"
msgstr ""
"I would have been swept\n"
"down the river if\n"
"it wasn't for you.{end_wait}"

msgctxt "message"
msgid "06009"
msgstr ""
"Please,{pause_20_skippable} take this.{pause_20_skippable}\n"
"It is a small token of\n"
"my appreciation.{end_wait}"

msgctxt "MsgBilibinJillGaveIsaacSpecialGift"
msgid "06010"
msgstr ""
"Jill gave {actor_name:1} a\n"
"special gift.{end_wait}"

msgctxt "message"
msgid "06011"
msgstr ""
"I will never forget what\n"
"you've done for me.\n"
"Thank you so much!{end_wait}"

msgctxt "MsgBilibinItWasAwfulLuckBeingTurned"
msgid "06012"
msgstr ""
"It was awful luck,\n"
"being turned into\n"
"trees just then.{page_break}"
"We just wanted to pick\n"
"persimmons. Who knew\n"
"what would happen?{end_wait}"

msgctxt "MsgBilibinIReallyLikeThisSpotBy"
msgid "06013"
msgstr ""
"I really like this spot\n"
"by the riverbank...\n"
"My heart feels at peace.{end_wait}"

msgctxt "MsgBilibinIWillThinkOfYouWhenever"
msgid "06014"
msgstr ""
"I will think of you\n"
"whenever I eat\n"
"persimmons.{end_wait}"

msgctxt "MsgBilibinIHeardWeWereOnceCalled"
msgid "06015"
msgstr ""
"I heard we were once\n"
"called the Gang of Three.{page_break}"
"But now that she's gone,{pause_20_skippable}\n"
"we're just the Gang of\n"
"Two...{page_break}"
"The poor girl...{end_wait}"

msgctxt "MsgBilibinIfOnlyWeHadntTriedGetting"
msgid "06016"
msgstr ""
"If only we hadn't tried\n"
"getting those persimmons,\n"
"she'd still be...{page_break}"
"We'll never climb on each\n"
"other's shoulders again...{end_wait}"

msgctxt "MsgBilibinWhoseIdeaWasItToPick"
msgid "06017"
msgstr ""
"Whose idea was it to\n"
"pick persimmons,\n"
"anyway?{end_wait}"

msgctxt "MsgBilibinWellItWasntMyIdeaTo"
msgid "06018"
msgstr ""
"Well, it wasn't my\n"
"idea to go pick\n"
"persimmons.{end_wait}"

msgctxt "MsgBilibinThesePersimmonsAreJustLikeMy"
msgid "06019"
msgstr ""
"These persimmons are\n"
"just like my memories...\n"
"So{pause_20_skippable} bitter...{end_wait}"

msgctxt "MsgBilibinWeWorkedSoHardIfOnly"
msgid "06020"
msgstr ""
"We worked so hard...\n"
"If only we had been\n"
"a little faster...{end_wait}"

msgctxt "MsgBilibinWhatACruelWorldWeJust"
msgid "06021"
msgstr ""
"What a cruel world! We\n"
"just wanted to climb on\n"
"one another's shoulders!{end_wait}"

msgctxt "MsgKolimaGoingCrossBridge"
msgid "06022"
msgstr ""
"Are you going to cross\n"
"the bridge?{end_wait}"

msgctxt "message"
msgid "06023"
msgstr ""
"Oh...{pause_20_skippable}{pause_20_skippable} Right!\n"
"Go right ahead!{end_wait}"

msgctxt "MsgKolimaForAWhileIThoughtNo"
msgid "06024"
msgstr ""
"For a while, I thought\n"
"no one would ever cross\n"
"this bridge again.{page_break}"
"Enjoy every crossing,\n"
"for it could be your last!{end_wait}"

msgctxt "MsgKolimaYouWouldntUnderstandButItsTruly"
msgid "06025"
msgstr ""
"You wouldn't understand,\n"
"but it's truly a joy\n"
"to cross this bridge.{end_wait}"

msgctxt "MsgXianHowDidGetHereBridge"
msgid "06026"
msgstr ""
"How did you get here?\n"
"Is the bridge open again?{end_now}"

msgctxt "message"
msgid "06027"
msgstr ""
"Really?!{pause_20_skippable} Then I can\n"
"go home to Kolima now?{page_break}"
"I thought I'd never go\n"
"home, what with the\n"
"cursed forest and all!{end_wait}"

msgctxt "message"
msgid "06028"
msgstr ""
"Oh... Then you came\n"
"through the forest?\n"
"That's too bad.{end_wait}"

msgctxt "MsgFuchinTempleIBeginningToThinkIllBe"
msgid "06029"
msgstr ""
"I beginning to think\n"
"I'll be stuck in Fuchin\n"
"Temple until I die.{end_wait}"

msgctxt "message"
msgid "06030"
msgstr ""
"Did you know that the\n"
"forest up ahead used to\n"
"be a vast prairie?{end_now}"

msgctxt "message"
msgid "06031"
msgstr ""
"They say the prairie became\n"
"a vast forest overnight.{page_break}"
"Nyunpa is the only person\n"
"who can pass through the\n"
"forest now...{page_break}"
"Even Nyunpa doesn't\n"
"know why the prairie\n"
"turned into a forest.{end_wait}"

msgctxt "message"
msgid "06032"
msgstr ""
"You don't believe me, do\n"
"you? Well, it's the truth.{page_break}"
"You see, these gems fell\n"
"from the sky, and\n"
"the next day,{page_break}"
"there was a forest\n"
"where the prairie\n"
"used to be.{end_wait}"

msgctxt "MsgFuchinTempleOmOmBlueLightsInThe"
msgid "06033"
msgstr ""
"Om...{pause_20_skippable} Om...\n"
"Blue lights in the north...\n"
"Terrifying!!!{page_break}"
"A rain of broken stars...\n"
"A forest suddenly grows...\n"
"All omens...{end_wait}"

msgctxt "MsgFuchinTempleGemsFromTheSkyBlueLights"
msgid "06034"
msgstr ""
"Gems from the sky,\n"
"blue lights in the north...\n"
"All omens of disaster!{page_break}"
"They match legends of\n"
"destruction described in\n"
"our oldest scrolls.{end_wait}"

msgctxt "MsgFuchinTempleNyunpaHasNotEatenInDays"
msgid "06035"
msgstr ""
"Nyunpa has not eaten in\n"
"days... He is going to\n"
"waste away to nothing.{end_wait}"

msgctxt "MsgXianIsntNobleHimTrySave"
msgid "06036"
msgstr ""
"Isn't it noble of him to\n"
"try to save the world by\n"
"becoming enlightened?{end_now}"

msgctxt "message"
msgid "06037"
msgstr ""
"However, I really do\n"
"not want to see\n"
"Nyunpa waste away.{end_wait}"

msgctxt "message"
msgid "06038"
msgstr ""
"Do you know what you\n"
"mean when you say that?{end_now}"

msgctxt "message"
msgid "06039"
msgstr ""
"Well,{pause_20_skippable} one may have many\n"
"different opinions\n"
"in this world,{pause_20_skippable} but...{page_break}"
"I wish you could\n"
"understand our beliefs.{end_wait}"

msgctxt "message"
msgid "06040"
msgstr ""
"To achieve enlightenment,\n"
"one fasts to cleanse\n"
"body and mind...{page_break}"
"Freed from worldly\n"
"concerns, one can focus\n"
"the mind's powers.{end_wait}"

msgctxt "MsgFuchinTempleIDontFeelSafeGoingHome"
msgid "06041"
msgstr ""
"I don't feel safe going\n"
"home alone... I hope a\n"
"monk will escort me.{end_wait}"

msgctxt "MsgFuchinTempleManyStarsFellFromTheSky"
msgid "06042"
msgstr ""
"Many stars fell from the\n"
"sky, just as it says\n"
"in the scrolls...{page_break}"
"Is this truly a\n"
"portent of the world's\n"
"destruction?{end_wait}"

msgctxt "MsgFuchinTempleThereIsNoPointInTraining"
msgid "06043"
msgstr ""
"There is no point in\n"
"training if the world\n"
"is to be destroyed.{page_break}"
"Maybe it is better\n"
"just to live happily.{end_wait}"

msgctxt "MsgFuchinTempleICantImagineFastingItGets"
msgid "06044"
msgstr ""
"I can't imagine fasting...\n"
"It gets me depressed just\n"
"thinking about it.{end_wait}"

msgctxt "MsgFuchinTempleIWillTrainToBecomeA"
msgid "06045"
msgstr ""
"I will train to\n"
"become a good monk.{page_break}"
"Then, I will save the\n"
"world, even if I must\n"
"sacrifice myself.{end_wait}"

msgctxt "MsgXianNyunpaMeditates"
msgid "06046"
msgstr ""
".{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}."
"{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}{end_wait}"

msgctxt "MsgXianMmmmWhoWhoSpeaksMy"
msgid "06047"
msgstr ""
"Mmmm... Who is that?\n"
"Who speaks to my mind?{end_wait}"

msgctxt "message"
msgid "06048"
msgstr ""
"Young master... Was that{pause_20_skippable}\n"
"your voice I heard\n"
"in my mind just now?{end_now}"

msgctxt "message"
msgid "06049"
msgstr "Speak no lies to me!{end_wait}"

msgctxt "message"
msgid "06050"
msgstr "I knew it!{end_wait}"

msgctxt "message"
msgid "06051"
msgstr "I knew it!{end_wait}"

msgctxt "MsgXianFollowThemDoNot"
msgid "06052"
msgstr ""
"You follow{pause_20_skippable} them,{pause_20_skippable}\n"
"do you not?{end_now}"

msgctxt "message"
msgid "06053"
msgstr ""
"You speak lies...\n"
"You are indeed\n"
"following them!{end_wait}"

msgctxt "message"
msgid "06054"
msgstr "I knew it!{end_wait}"

msgctxt "message"
msgid "06055"
msgstr ""
"But you must go\n"
"through Mogall Forest,\n"
"the endless woods.{page_break}"
"The forest itself is a\n"
"mystery, and its paths\n"
"even more so...{page_break}"
"No ordinary man can\n"
"pass from one side to\n"
"the other.{end_wait}"

msgctxt "message"
msgid "06056"
msgstr ""
"But perhaps I could,\n"
"young master.{end_wait}"

msgctxt "message"
msgid "06057"
msgstr ""
"If you can endure the\n"
"trials in the waterfall\n"
"grotto, I will tell you.{end_wait}"

msgctxt "message"
msgid "06058"
msgstr "Will you take the test?{end_now}"

msgctxt "MsgXianThenCannotTellGiveUp"
msgid "06059"
msgstr ""
"Then I cannot tell you.\n"
"Give up and go back\n"
"from whence you came.{end_wait}"

msgctxt "MsgXianMustSurviveTestGrottoBefore"
msgid "06060"
msgstr ""
"You must survive the\n"
"test of the grotto\n"
"before you can pass{page_break}"
"through Mogall Forest.\n"
"Will you take the test?{end_now}"

msgctxt "MsgXianDoNotWorryWillPermitted"
msgid "06061"
msgstr ""
"Do not worry. You will\n"
"be permitted to enter\n"
"the grotto.{end_wait}"

msgctxt "message"
msgid "06062"
msgstr "Go now,{pause_20_skippable} {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "06063"
msgstr ""
"Just remember, you are\n"
"not the only ones\n"
"who can read minds.{end_wait}"

msgctxt "MsgFuchinTempleSpeakToTheMonkStandingBeneath"
msgid "06064"
msgstr ""
"Speak to the monk\n"
"standing beneath the\n"
"falls.{end_wait}"

msgctxt "MsgXianEnjoyReadingMindsOthersDo"
msgid "06065"
msgstr ""
"You enjoy reading the\n"
"minds of others, do\n"
"you not?{end_now}"

msgctxt "message"
msgid "06066"
msgstr ""
"If you overdo it, you\n"
"will soon learn to despise\n"
"the ability.{end_wait}"

msgctxt "message"
msgid "06067"
msgstr ""
"That is good. Enjoy\n"
"reading the minds of\n"
"others while you still can.{end_wait}"

msgctxt "MsgXianAlreadyHeardTest"
msgid "06068"
msgstr ""
"I have already heard of\n"
"your test from Master\n"
"Nyunpa. You may enter.{end_wait}"

msgctxt "MsgFuchinTempleTheTestOfFuchinFallsIs"
msgid "06069"
msgstr ""
"The test of Fuchin Falls\n"
"is a difficult one. Do not\n"
"enter until you are ready.{end_wait}"

msgctxt "MsgFuchinTempleCanSuchYoungWarriorsEndureThe"
msgid "06070"
msgstr ""
"Can such young warriors\n"
"endure the trial of\n"
"the grotto?{end_wait}"

msgctxt "MsgXianYoungMasterDidCompleteTest"
msgid "06071"
msgstr ""
"Young master, did you\n"
"complete the test?{end_now}"

msgctxt "message"
msgid "06072"
msgstr ""
"Why, you have mastered\n"
"the secrets of Fuchin\n"
"Temple!?{end_wait}"

msgctxt "message"
msgid "06073"
msgstr "But you must have...{end_wait}"

msgctxt "message"
msgid "06074"
msgstr ""
"Master Nyunpa is waiting\n"
"for you...{end_wait}"

msgctxt "message"
msgid "06075"
msgstr "Proceed to the temple.{end_wait}"

msgctxt "MsgFuchinTempleMasterNyunpaIsWaitingForYou"
msgid "06076"
msgstr ""
"Master Nyunpa is waiting\n"
"for you...\n"
"Proceed to the temple.{end_wait}"

msgctxt "MsgFuchinTempleTheWarriorsHaveMasteredTheSecrets"
msgid "06077"
msgstr ""
"The warriors have\n"
"mastered the secrets\n"
"of Fuchin Temple.{end_wait}"

msgctxt "MsgXianExcellentIsaac"
msgid "06078"
msgstr "Excellent, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "06079"
msgstr ""
"I am glad to see you\n"
"master the secrets of\n"
"Fuchin Temple!{end_wait}"

msgctxt "message"
msgid "06080"
msgstr ""
"We monks call the\n"
"power you have\n"
"obtained Ki.{end_wait}"

msgctxt "message"
msgid "06081"
msgstr ""
"You seem{pause_20_skippable} confused,\n"
"{actor_name:1}.{end_now}"

msgctxt "message"
msgid "06082"
msgstr ""
"This is called \"force\" by\n"
"the western world, but it\n"
"is really spiritual power.{end_wait}"

msgctxt "message"
msgid "06083"
msgstr ""
"You possess great wisdom\n"
"for one so young, but I\n"
"feel I must explain this.{end_wait}"

msgctxt "message"
msgid "06084"
msgstr ""
"It is called \"force\" by\n"
"the western world, but it\n"
"is really spiritual power.{end_wait}"

msgctxt "message"
msgid "06085"
msgstr ""
"I will teach you, as I\n"
"promised. Use this power\n"
"to go through the forest.{end_wait}"

msgctxt "message"
msgid "06086"
msgstr ""
"What would happen if you\n"
"let loose this energy\n"
"in the forest?{end_wait}"

msgctxt "message"
msgid "06087"
msgstr ""
"Ha ha! You are\n"
"curious, no?{end_now}"

msgctxt "MsgXianCanReadMindsKnowCurious"
msgid "06088"
msgstr ""
"I can read minds, you\n"
"know.{pause_20_skippable} You are curious,\n"
"aren't you?{end_now}"

msgctxt "MsgXianMonstersWaitInHidingWould"
msgid "06089"
msgstr ""
"Monsters that wait in\n"
"hiding would show\n"
"themselves.{page_break}"
"You would then try to\n"
"defeat them, would you\n"
"not?{end_now}"

msgctxt "message"
msgid "06090"
msgstr ""
"Sometimes, you must let\n"
"go of your belief that\n"
"fighting solves problems...{end_wait}"

msgctxt "message"
msgid "06091"
msgstr ""
"Ha ha... That is right.\n"
"There is no good in\n"
"wanton destruction.{end_wait}"

msgctxt "message"
msgid "06092"
msgstr ""
"Monsters are cowardly.\n"
"They will run once they\n"
"know you can see them.{end_wait}"

msgctxt "message"
msgid "06093"
msgstr ""
"They are creatures of the\n"
"woods... So they do not\n"
"get lost there.{end_wait}"

msgctxt "MsgFuchinTempleUseThisEnergyToFindThe"
msgid "06094"
msgstr ""
"Use this energy to find\n"
"the monsters,{pause_20_skippable} then follow\n"
"them. It is that simple.{end_wait}"

msgctxt "MsgFuchinTempleNowThatIHavePassedMy"
msgid "06095"
msgstr ""
"Now that I have passed\n"
"my knowledge of Ki\n"
"along...{page_break}"
"I am without worries.\n"
"Farewell, {actor_name:1}.\n"
"Take care of yourself...{end_wait}"

msgctxt "message"
msgid "06096"
msgstr ""
"Master Nyunpa seems\n"
"quite relieved.{page_break}"
"Do not fail,\n"
"young warriors.{end_wait}"

msgctxt "message"
msgid "06097"
msgstr ""
"We cannot sit idly by.\n"
"We too must learn the\n"
"secrets of Fuchin Temple.{end_wait}"

msgctxt "MsgFuchinTempleTheFuchinTempleIsAPleasant"
msgid "06098"
msgstr ""
"The Fuchin Temple\n"
"is a pleasant place.\n"
"I feel at peace here.{end_wait}"

msgctxt "MsgFuchinTempleOhIsaacWhatTookYouSo"
msgid "06099"
msgstr ""
"Oh, {actor_name:1}! What took you so\n"
"long? Master Nyunpa has\n"
"become enlightened!{page_break}"
"He no longer\n"
"responds to our words...{end_wait}"

msgctxt "MsgFuchinTempleAhhhMasterNyunpaHeHasPassed"
msgid "06100"
msgstr ""
"Ahhh. Master Nyunpa...\n"
"He has passed away...{end_wait}"

msgctxt "MsgFuchinTempleMasterNyunpaHasWastedAwayAt"
msgid "06101"
msgstr ""
"Master Nyunpa has wasted\n"
"away at last.{end_wait}"

msgctxt "MsgXianNowHeTrulyBeyondWorlds"
msgid "06102"
msgstr ""
"Now, he truly is beyond\n"
"the world's concerns.\n"
"Is he watching over us?{end_now}"

msgctxt "message"
msgid "06103"
msgstr ""
"I believed that once.\n"
"But now, I am no\n"
"longer so sure.{end_wait}"

msgctxt "message"
msgid "06104"
msgstr ""
"Yes...{pause_20_skippable} This seems\n"
"very wrong.{page_break}"
"The world has lost\n"
"something great,\n"
"now that Nyunpa is gone...{end_wait}"

msgctxt "MsgFuchinTempleGemsFallingFromTheSkyMountains"
msgid "06105"
msgstr ""
"Gems falling from the sky,\n"
"mountains erupting,\n"
"oceans raging...{page_break}"
"Fuchin Temple is the only\n"
"haven left for me in\n"
"such a frightful world.{end_wait}"

msgctxt "MsgFuchinTempleIKnewMasterNyunpaWasFasting"
msgid "06106"
msgstr ""
"I knew Master Nyunpa\n"
"was fasting to save\n"
"the world...{page_break}"
"even if it meant his own\n"
"death... But I am saddened\n"
"that he is gone...{end_wait}"

msgctxt "MsgFuchinTempleMasterNyunpaReachedEnlightenmentDuringHis"
msgid "06107"
msgstr ""
"Master Nyunpa reached\n"
"enlightenment during his\n"
"lifetime. Amazing...{end_wait}"

msgctxt "MsgFuchinTempleMasterNyunpaIsNothingButSkin"
msgid "06108"
msgstr ""
"Master Nyunpa is nothing\n"
"but skin and bones...\n"
"like a dried fish!{end_wait}"

msgctxt "MsgFuchinTempleHeCantLeaveUsYetHe"
msgid "06109"
msgstr ""
"He can't leave us yet...\n"
"He still has so much\n"
"to teach us!{end_wait}"

msgctxt "MsgFuchinTemple"
msgid "06110"
msgstr "...............{end_wait}"

msgctxt "MsgXianIsaacAmCountingOnBring"
msgid "06111"
msgstr ""
"{actor_name:1}...{pause_20_skippable} Is that you...?{pause_20_skippable}\n"
"I am...{pause_20_skippable}counting on you...{page_break}"
"to bring peace...{pause_20_skippable}\n"
"to the world...{end_wait}"

msgctxt "MsgXianDontTryHard"
msgid "06112"
msgstr ""
"You don't have to try\n"
"so hard.{pause_20_skippable} You are curious,\n"
"are you not?{end_now}"

msgctxt "MsgFuchinDragonFlameShowsPath"
msgid "06113"
msgstr ""
"The dragon's flame\n"
"illuminates the path of\n"
"truth in darkness.{end_wait}"

msgctxt "MsgFuchinSecretKiRevealed"
msgid "06114"
msgstr ""
"The secret of Ki shall\n"
"be revealed to the\n"
"disciples of truth.{end_wait}"

msgctxt "MsgFuchinLightRevealsShadows"
msgid "06115"
msgstr ""
"Rays of light give\n"
"birth to shadows,\n"
"revealing the way.{end_wait}"

msgctxt "MsgFuchinEyelessDragon"
msgid "06116"
msgstr ""
"It's a statue of an\n"
"eyeless dragon.{page_break}"
"What went in\n"
"the sockets?{end_wait}"

msgctxt "MsgFuchinDragonRedEyes"
msgid "06117"
msgstr ""
"It's a statue of a dragon\n"
"with burning red eyes.{end_wait}"

msgctxt "MsgMogallForestBrokenSign"
msgid "06118"
msgstr ""
"The broken sign reads:{page_break}"
"North: Fuchin Temple\n"
"South: Mogall Prairie...{end_wait}"

msgctxt "MsgXianThisIsXianTravelersAreWelcome"
msgid "06119"
msgstr ""
"This is Xian. Travelers\n"
"are welcome here!\n"
"Relax. Stay long.{end_wait}"

msgctxt "MsgXianYoungWarriorsVeryGallantCame"
msgid "06120"
msgstr ""
"Young warriors,\n"
"very gallant!{page_break}"
"You came through\n"
"Mogall Forest?{end_now}"

msgctxt "message"
msgid "06121"
msgstr ""
"Incredible.\n"
"I respect your deeds.{end_wait}"

msgctxt "message"
msgid "06122"
msgstr ""
"Came from Altin?\n"
"No. That is a lie.{page_break}"
"Silk Road is blocked.\n"
"No one can come\n"
"that way.{end_wait}"

msgctxt "MsgXianXianIsTheVillageOfKinu"
msgid "06123"
msgstr ""
"Xian is the village of\n"
"kinu. Kinu means silk.\n"
"Silk makes the best cloth.{end_wait}"

msgctxt "message"
msgid "06124"
msgstr "Do you know Master Feh?{end_now}"

msgctxt "message"
msgid "06125"
msgstr ""
"There are many scary\n"
"thieves now, but Master\n"
"Feh is scarier.{page_break}"
"Xian is safe, because\n"
"thieves are afraid to go\n"
"near Master Feh.{end_wait}"

msgctxt "message"
msgid "06126"
msgstr ""
"Master Feh is a martial\n"
"artist. He is very strong.{page_break}"
"Master Feh teaches\n"
"martial arts at the Xian\n"
"school.{end_wait}"

msgctxt "MsgXianMartialArtsAreVeryPopularIn"
msgid "06127"
msgstr ""
"Martial arts are very\n"
"popular in Xian.{page_break}"
"All warriors should\n"
"learn martial arts.{end_wait}"

msgctxt "MsgXianYouWarriorsShouldVisitMasterFehs"
msgid "06128"
msgstr ""
"You warriors should visit\n"
"Master Feh's school.\n"
"You will be surprised!{end_wait}"

msgctxt "MsgXianMyClothesAreNotSilkSilk"
msgid "06129"
msgstr ""
"My clothes are not silk.\n"
"Silk is very expensive.\n"
"Only the wealthy wear it.{end_wait}"

msgctxt "MsgXianHooWhaaaHachaaa"
msgid "06130"
msgstr ""
"Hoo-whaaa...\n"
"Hachaaa!{end_wait}"

msgctxt "message"
msgid "06131"
msgstr "Heh heh heh...{end_wait}"

msgctxt "MsgXianKungFuStrong"
msgid "06132"
msgstr ""
"My kung fu is strong.{page_break}"
"If you go to Master Feh's\n"
"school every day, someday\n"
"you will be strong too.{end_wait}"

msgctxt "MsgXianDisastersFromTheSkyManyMany"
msgid "06133"
msgstr ""
"Disasters from the sky...\n"
"Many, many thieves...{page_break}"
"But I do not worry. Xian\n"
"has many kung fu masters.\n"
"Master Feh is strong.{end_wait}"

msgctxt "MsgXianThisIsTheMulberryOrchardWhen"
msgid "06134"
msgstr ""
"This is the mulberry\n"
"orchard.{page_break}"
"When the season comes,\n"
"all Xian comes to\n"
"harvest.{end_wait}"

msgctxt "MsgXianWarriorsFromSchoolStrongWarriors"
msgid "06135"
msgstr ""
"You are the warriors\n"
"from the school... Are you\n"
"strong warriors?{end_now}"

msgctxt "message"
msgid "06136"
msgstr ""
"I am happy to see strong\n"
"warriors. I hope you will\n"
"go west.{end_wait}"

msgctxt "message"
msgid "06137"
msgstr ""
"You are weak warriors?\n"
"Very few warriors would\n"
"call themselves weak.{end_wait}"

msgctxt "MsgXianDoingMadeMeSpillMy"
msgid "06138"
msgstr ""
"What are you doing! You\n"
"made me spill my water!{end_wait}"

msgctxt "MsgXianNowMustGetWaterAgain"
msgid "06139"
msgstr ""
"Now I must get water\n"
"again. This work is\n"
"hard on my back.{end_wait}"

msgctxt "message"
msgid "06140"
msgstr ""
"Do not speak to me.\n"
"I might spill my water.{end_wait}"

msgctxt "MsgXianWhaWhaHappened"
msgid "06141"
msgstr ""
"Wha{pause_20_skippable}-Wha{pause_20_skippable}-What happened?\n"
"The tree jumped on\n"
"its own!{end_wait}"

msgctxt "message"
msgid "06142"
msgstr ""
"...It jumped again...{pause_20_skippable}\n"
"I am too tired...{end_wait}"

msgctxt "MsgXianTheseChildrenMustHaveComeTo"
msgid "06143"
msgstr ""
"These children must have\n"
"come to study kung fu\n"
"at Master Feh's School.{end_wait}"

msgctxt "MsgXianYouYoungWarriorsLookStrongBut"
msgid "06144"
msgstr ""
"You young warriors look\n"
"strong. But which is\n"
"stronger...{page_break}"
"You, or the kung fu\n"
"taught at Master\n"
"Feh's school?{end_wait}"

msgctxt "MsgXianIHopeManyPeopleComeTo"
msgid "06145"
msgstr ""
"I hope many people come\n"
"to know the silk of\n"
"Xian.{end_wait}"

msgctxt "message"
msgid "06146"
msgstr ""
"Those who need no\n"
"weapons have true\n"
"strength.{page_break}"
"Master Feh is number\n"
"one.{end_wait}"

msgctxt "MsgXianFightingWithKicksAndPunchesIs"
msgid "06147"
msgstr ""
"Fighting with kicks and\n"
"punches is effective.{page_break}"
"Everyone should\n"
"remember this.{end_wait}"

msgctxt "MsgXianMasterFehsSchoolIsTrainingIt"
msgid "06148"
msgstr ""
"Master Feh's school is\n"
"training. It makes us\n"
"very strong.{end_wait}"

msgctxt "MsgXianSilkIsShinyAndSmoothIt"
msgid "06149"
msgstr ""
"Silk is shiny and smooth.\n"
"It feels good on my skin.\n"
"I'm obsessed with it.{end_wait}"

msgctxt "MsgXianBreakingTreesWithMyHandHurts"
msgid "06150"
msgstr ""
"Breaking trees with my\n"
"hand{pause_20_skippable} hurts me very much.{page_break}"
"But it does not hurt\n"
"Master Feh. He is a\n"
"great master.{end_wait}"

msgctxt "MsgXianMasterFehSaidYahAndThen"
msgid "06151"
msgstr ""
"Master Feh said \"YAH!\"\n"
"and then the thieves fell.{end_wait}"

msgctxt "MsgXianTheOrchardGivesTheVillageLife"
msgid "06152"
msgstr ""
"The orchard gives the\n"
"village life. It is very\n"
"precious to us.{end_wait}"

msgctxt "MsgXianGoingWestAloneIsVeryDangerous"
msgid "06153"
msgstr ""
"Going west alone is very\n"
"dangerous.{page_break}"
"I must find someone to\n"
"take me west.{end_wait}"

msgctxt "MsgXianIMustCarryWaterEveryDay"
msgid "06154"
msgstr ""
"I must carry water\n"
"every day. I can't\n"
"stand it!{end_wait}"

msgctxt "MsgXianInteriorsTheMulberryHarvestIsOverNow"
msgid "06155"
msgstr ""
"The mulberry harvest is\n"
"over. Now there is much\n"
"food for the caterpillars!{page_break}"
"The cocoon threads will\n"
"become silk.{page_break}"
"Merchants will buy a lot\n"
"when they come.{end_wait}"

msgctxt "MsgXianInteriorsFarmWorkIsVeryHardWarriors"
msgid "06156"
msgstr ""
"Farm work is very hard.\n"
"Warriors have no idea\n"
"how hard it is.{end_wait}"

msgctxt "MsgXianInteriorsSoonMasterHammetWillComeHe"
msgid "06157"
msgstr ""
"Soon, Master Hammet will\n"
"come. He will buy \n"
"much silk.{end_wait}"

msgctxt "MsgXianInteriorsFarmWorkIsHardOnThe"
msgid "06158"
msgstr ""
"Farm work is hard on the\n"
"shoulders. It is hard on\n"
"the back, too.{end_wait}"

msgctxt "MsgXianInteriorsXianSilkIsSentOnSilk"
msgid "06159"
msgstr ""
"Xian silk is sent on\n"
"Silk Road to Tolbi.{page_break}"
"Tolbi is a big town\n"
"in the southwest.{end_wait}"

msgctxt "MsgXianInteriorsSilkRoadEndsInTolbiIt"
msgid "06160"
msgstr ""
"Silk Road ends in\n"
"Tolbi. It is a big,\n"
"big town.{end_wait}"

msgctxt "MsgXianInteriorsSilkRoadIsFullOfSilk"
msgid "06161"
msgstr ""
"Silk Road is full\n"
"of silk merchants.{end_wait}"

msgctxt "MsgXianInteriorsMerchantsSayTolbiIsVeryBeautiful"
msgid "06162"
msgstr ""
"Merchants say Tolbi is\n"
"very beautiful,\n"
"very wonderful...{end_wait}"

msgctxt "MsgXianInteriorsFollowSilkRoadWhenYouSee"
msgid "06163"
msgstr ""
"Follow Silk Road.\n"
"When you see the mountain\n"
"fork, go north.{page_break}"
"Then you will see\n"
"Altin.{end_wait}"

msgctxt "MsgXianInteriorsThereIsAMineInAltin"
msgid "06164"
msgstr ""
"There is a mine in Altin.\n"
"There is lots of steel\n"
"and lots of gems.{end_wait}"

msgctxt "MsgXianInteriorsAltinHasManyMenAllScary"
msgid "06165"
msgstr ""
"Altin has many men.\n"
"All scary men, too.{end_wait}"

msgctxt "MsgXianInteriorsMiningIsVeryHardWorkIt"
msgid "06166"
msgstr ""
"Mining is very hard work.\n"
"It takes great strength.\n"
"It is difficult for women.{end_wait}"

msgctxt "MsgXianXianHasMartialArtsBut"
msgid "06167"
msgstr ""
"Xian has martial arts,\n"
"but kung fu alone is\n"
"not enough. People worry.{page_break}"
"For that reason, it is\n"
"not strange to sell\n"
"weapons in Xian.{end_wait}"

msgctxt "MsgXianInteriorsSomeSayFightingWithWeaponsIs"
msgid "06168"
msgstr ""
"Some say fighting with\n"
"weapons is cowardly.\n"
"I say not true.{page_break}"
"There are many\n"
"fighters, and many ways\n"
"of fighting.{end_wait}"

msgctxt "MsgXianMartialArtistsCantUseHeavy"
msgid "06169"
msgstr ""
"Martial artists can't use\n"
"heavy armor. If they do,\n"
"they can't move quickly.{page_break}"
"...But not warriors.\n"
"Using much armor is good\n"
"for them.{end_wait}"

msgctxt "MsgXianInteriorsInWarriorBattlesYouFightWith"
msgid "06170"
msgstr ""
"In warrior battles, you\n"
"fight with weapons.{page_break}"
"In kung fu, you fight\n"
"by dodging.{end_wait}"

msgctxt "MsgXianXiansSpecialArmorNotSuited"
msgid "06171"
msgstr ""
"Xian's special armor is\n"
"not suited to warriors...{page_break}"
"It is better to buy\n"
"normal armor.{end_wait}"

msgctxt "MsgXianInteriorsXianIsAVillageOfCraftsmen"
msgid "06172"
msgstr ""
"Xian is a village of\n"
"craftsmen. They never buy\n"
"items. They make them.{end_wait}"

msgctxt "MsgXianWarriorsShouldLearnAboutTowns"
msgid "06173"
msgstr ""
"Warriors should learn\n"
"about the towns they\n"
"visit.{page_break}"
"Just traveling and\n"
"fighting is a sad\n"
"life.{end_wait}"

msgctxt "MsgXianInteriorsNormallyManyMerchantsComeToThe"
msgid "06174"
msgstr ""
"Normally, many merchants\n"
"come to the village, but\n"
"they have not come yet.{page_break}"
"I think\n"
"that is strange.{end_wait}"

msgctxt "MsgXianInteriorsAllThePeopleWhoCameTo"
msgid "06175"
msgstr ""
"All the people who came\n"
"to eat are from Xian.\n"
"What happened there?{end_wait}"

msgctxt "MsgXianInteriorsWhenYouGoToANew"
msgid "06176"
msgstr ""
"When you go to a new\n"
"place, follow the rules\n"
"in the new place.{page_break}"
"This is an old\n"
"saying in Xian.{end_wait}"

msgctxt "MsgXianInteriorsWhenManyMerchantsComeMyBusiness"
msgid "06177"
msgstr ""
"When many merchants\n"
"come, my business\n"
"is good.{page_break}"
"But if no merchants\n"
"come, my business is\n"
"very bad.{end_wait}"

msgctxt "MsgXianInteriorsThereAreFewerTravelersSoFewer"
msgid "06178"
msgstr ""
"There are fewer\n"
"travelers, so fewer\n"
"people eat here.{page_break}"
"Where are all the\n"
"travelers?{end_wait}"

msgctxt "MsgSanctumCameXianFromVeryDistant"
msgid "06179"
msgstr ""
"I came to Xian from very\n"
"distant lands to spread\n"
"good will.{end_wait}"

msgctxt "MsgSanctumWhenYouStayInXianFor"
msgid "06180"
msgstr ""
"When you stay in Xian\n"
"for a long time, you\n"
"start to speak strangely.{page_break}"
"My head gets very\n"
"confused...{end_wait}"

msgctxt "MsgXianMasterFehsSchoolCameWatch"
msgid "06181"
msgstr ""
"This is Master Feh's\n"
"school...\n"
"You came to watch?{end_now}"

msgctxt "message"
msgid "06182"
msgstr ""
"Promise me you will\n"
"be quiet.{end_wait}"

msgctxt "message"
msgid "06183"
msgstr ""
"Warriors should learn\n"
"martial arts. They will\n"
"help in battles.{end_wait}"

msgctxt "MsgFuchinTempleStrongKicksAreVeryImportantKick"
msgid "06184"
msgstr ""
"Strong kicks are very\n"
"important.\n"
"Kick, kick, kick!{page_break}"
"That is how you do it.{end_wait}"

msgctxt "MsgFuchinTempleIWantToLearnSoI"
msgid "06185"
msgstr ""
"I want to learn, so\n"
"I train. Quick punches\n"
"are very good.{page_break}"
"Master Feh is very\n"
"good.{end_wait}"

msgctxt "MsgXianFlexibilityJumpingVeryImportantIn"
msgid "06186"
msgstr ""
"Flexibility and jumping\n"
"are very important in\n"
"kung fu.{end_wait}"

msgctxt "MsgFuchinTempleEveryoneInXianCanDoMartial"
msgid "06187"
msgstr ""
"Everyone in Xian can\n"
"do martial arts.{page_break}"
"But the Feh School\n"
"of martial arts is\n"
"the most elite.{end_wait}"

msgctxt "MsgFuchinTempleJustListeningDoesNotMakeOne"
msgid "06188"
msgstr ""
"Just listening does not\n"
"make one strong.\n"
"I learn by watching.{end_wait}"

msgctxt "MsgXianMasterFehVeryBusyDo"
msgid "06189"
msgstr ""
"Master Feh is very busy.\n"
"Do you still wish to\n"
"see him?{end_now}"

msgctxt "message"
msgid "06190"
msgstr ""
"Look there. You see that\n"
"line? Stand there and\n"
"use Chi.{page_break}"
"If that tree falls, I will\n"
"take you to see\n"
"Master Feh.{end_wait}"

msgctxt "message"
msgid "06191"
msgstr ""
"You will not see Master\n"
"Feh? That is\n"
"too bad.{end_wait}"

msgctxt "MsgFuchinTempleMasterFehIsVeryBusyHe"
msgid "06192"
msgstr ""
"Master Feh is very busy.\n"
"He is speaking with his\n"
"daughter, Feizhi.{page_break}"
"You cannot enter now.{end_wait}"

msgctxt "MsgFuchinTempleWarriorsFightWithWeaponsKungFu"
msgid "06193"
msgstr ""
"Warriors fight with\n"
"weapons. Kung fu means\n"
"little to you.{end_wait}"

msgctxt "MsgFuchinTemplePracticingKicksHurtsMyFeetVery"
msgid "06194"
msgstr ""
"Practicing kicks hurts\n"
"my feet very much.\n"
"But I still try hard.{end_wait}"

msgctxt "MsgFuchinTempleThatPunchWasGoodYouSurprise"
msgid "06195"
msgstr ""
"That punch was good!\n"
"You surprise me, warrior.{end_wait}"

msgctxt "MsgFuchinTempleIMoveTooQuicklyYouCant"
msgid "06196"
msgstr ""
"I move too quickly.\n"
"You can't hit me with\n"
"your weapon. Try it.{end_wait}"

msgctxt "MsgFuchinTempleWarriorsCameToLearnTheFeh"
msgid "06197"
msgstr ""
"Warriors came to learn\n"
"the Feh School's kung fu.\n"
"That is how famous it is.{end_wait}"

msgctxt "MsgFuchinTempleGreatKickKickFromTheHip"
msgid "06198"
msgstr ""
"Great kick. Kick from the\n"
"hip. That causes much pain\n"
"when it hits.{end_wait}"

msgctxt "MsgFuchinTempleYouAreTheWarriorsWhoCame"
msgid "06199"
msgstr ""
"You are the warriors who\n"
"came to study, yes?{page_break}"
"It is too much to ask\n"
"to see Master Feh.{end_wait}"

msgctxt "MsgFuchinTempleMasterFehIsTalkingWithFeizhi"
msgid "06200"
msgstr ""
"Master Feh is talking\n"
"with Feizhi about\n"
"something very important.{page_break}"
"You cannot disturb them.{end_wait}"

msgctxt "message"
msgid "06201"
msgstr ""
"Ya! What happened!?\n"
"The tree fell on its own!{end_wait}"

msgctxt "MsgXianCannotPushHands"
msgid "06202"
msgstr ""
"You cannot push it with\n"
"your hands. Attack it\n"
"with Chi.{end_wait}"

msgctxt "MsgXianDidDoWarrior"
msgid "06203"
msgstr ""
"What did you do,\n"
"warrior?{end_wait}"

msgctxt "message"
msgid "06204"
msgstr ""
"The warrior used Chi!\n"
"He did it from the line...\n"
"and the tree fell!{end_wait}"

msgctxt "message"
msgid "06205"
msgstr ""
"He knows kung fu!\n"
"Do you know kung fu?{end_now}"

msgctxt "message"
msgid "06206"
msgstr ""
"Your Chi must be\n"
"strong if you can\n"
"use it from afar.{page_break}"
"I must tell Master Feh!{end_wait}"

msgctxt "message"
msgid "06207"
msgstr ""
"It is unbelievable that\n"
"someone who does not\n"
"know kung fu can use Chi.{end_wait}"

msgctxt "message"
msgid "06208"
msgstr ""
"Ya! What happened!?\n"
"The door opened on\n"
"its own!{end_wait}"

msgctxt "message"
msgid "06209"
msgstr "Feizhi! Wait!{end_wait}"

msgctxt "message"
msgid "06210"
msgstr ""
"Are you worried\n"
"that Hsu is late?{end_wait}"

msgctxt "message"
msgid "06211"
msgstr ""
"He is only a little late\n"
"in returning from Lama\n"
"Temple. Do not worry!{end_wait}"

msgctxt "message"
msgid "06212"
msgstr ""
"Something is wrong with\n"
"Hsu... I sense it.{end_wait}"

msgctxt "message"
msgid "06213"
msgstr ""
"Ahhh, Feizhi...\n"
"Is it your power again?{end_wait}"

msgctxt "message"
msgid "06214"
msgstr ""
"Ever since gems fell from\n"
"the sky and hit me, I\n"
"have sensed bad things.{end_wait}"

msgctxt "message"
msgid "06215"
msgstr ""
"You say you sense evil\n"
"ever since you received\n"
"the power of prophecy.{page_break}"
"You have told\n"
"me already.{end_wait}"

msgctxt "message"
msgid "06216"
msgstr ""
"I do not believe it, Feizhi.\n"
"Your visions are just\n"
"coincidences.{end_wait}"

msgctxt "message"
msgid "06217"
msgstr ""
"My visions came true\n"
"many times, no?{end_wait}"

msgctxt "message"
msgid "06218"
msgstr ""
"I had a vision about\n"
"Mogall Forest, and that\n"
"came true...{end_wait}"

msgctxt "message"
msgid "06219"
msgstr ""
"Yes, your predictions\n"
"came true, Feizhi. It was\n"
"very surprising!{end_wait}"

msgctxt "message"
msgid "06220"
msgstr ""
"The flood in Altin...\n"
"Did I not predict\n"
"that, too?{end_wait}"

msgctxt "message"
msgid "06221"
msgstr ""
"All Feizhi's predictions\n"
"come true.{end_wait}"

msgctxt "message"
msgid "06222"
msgstr "See, Father?{end_wait}"

msgctxt "message"
msgid "06223"
msgstr ""
"I have heard this all.\n"
"I was surprised, too, but\n"
"it is still coincidence.{end_wait}"

msgctxt "message"
msgid "06224"
msgstr ""
"You still don't\n"
"believe it?{end_wait}"

msgctxt "message"
msgid "06225"
msgstr ""
"Hsu is late, so you\n"
"worry too much. But do\n"
"not think bad thoughts.{end_wait}"

msgctxt "message"
msgid "06226"
msgstr ""
"You sent people to\n"
"find Hsu, correct?{end_wait}"

msgctxt "message"
msgid "06227"
msgstr "Stubborn old man.{end_wait}"

msgctxt "message"
msgid "06228"
msgstr ""
"What did you say, Feizhi?\n"
"You should not speak\n"
"so to your elders.{end_wait}"

msgctxt "message"
msgid "06229"
msgstr ""
"I will not ask anyone.\n"
"I will go alone, then!{end_wait}"

msgctxt "message"
msgid "06230"
msgstr "It is too dangerous.{end_wait}"

msgctxt "message"
msgid "06231"
msgstr ""
"Ya! Master Feh!\n"
"Feizhi has gone!{end_wait}"

msgctxt "message"
msgid "06232"
msgstr ""
"Feizhi was very angry.\n"
"She was frightening!{end_wait}"

msgctxt "message"
msgid "06233"
msgstr ""
"Hsu is in danger.\n"
"Feizhi is going to help.{end_wait}"

msgctxt "message"
msgid "06234"
msgstr ""
"Feizhi knows kung fu.\n"
"She will be all right.{end_wait}"

msgctxt "message"
msgid "06235"
msgstr ""
"Feizhi is alone. She\n"
"cannot go too far.{end_wait}"

msgctxt "message"
msgid "06236"
msgstr ""
"She will give up soon\n"
"enough. Until then,\n"
"let her be.{end_wait}"

msgctxt "message"
msgid "06237"
msgstr ""
"The tree... It fell.\n"
"What happened?{end_wait}"

msgctxt "message"
msgid "06238"
msgstr ""
"The warrior did it.\n"
"He used Chi.{end_wait}"

msgctxt "message"
msgid "06239"
msgstr ""
"Warrior, you...\n"
"Can you use Chi?{end_now}"

msgctxt "message"
msgid "06240"
msgstr ""
"Do it again, warrior.\n"
"Show me your Chi.{end_wait}"

msgctxt "message"
msgid "06241"
msgstr ""
"Warrior, you speak\n"
"nonsense. You used Chi.\n"
"Do it again!{end_now}"

msgctxt "message"
msgid "06242"
msgstr ""
"Show me your Chi,\n"
"warrior.{end_wait}"

msgctxt "message"
msgid "06243"
msgstr ""
"I want to see your\n"
"Chi, warrior.{end_wait}"

msgctxt "MsgFuchinTempleWarriorLetMeSeeYourChi"
msgid "06244"
msgstr ""
"Warrior, let me see your\n"
"Chi now.{end_wait}"

msgctxt "MsgFuchinTempleFeizhiIsGoneItIsDangerous"
msgid "06245"
msgstr ""
"Feizhi is gone! It is\n"
"dangerous outside the\n"
"village. I am worried.{end_wait}"

msgctxt "MsgFuchinTempleFeizhiIsStrongerThanSheLooks"
msgid "06246"
msgstr ""
"Feizhi is stronger than\n"
"she looks. She will\n"
"be okay.{end_wait}"

msgctxt "MsgFuchinTempleWarriorShowUsYourChiLike"
msgid "06247"
msgstr ""
"Warrior, show us your\n"
"Chi, like before.{end_wait}"

msgctxt "MsgFuchinTempleWarriorThatWasGreatButMaster"
msgid "06248"
msgstr ""
"Warrior, that was great,\n"
"but Master Feh's Chi\n"
"is much stronger.{end_wait}"

msgctxt "MsgFuchinTempleWarriorShowMeYourChiI"
msgid "06249"
msgstr ""
"Warrior, show me your\n"
"Chi. I want to see it\n"
"very badly.{end_wait}"

msgctxt "MsgFuchinTempleFeizhiIKnowIKnowHow"
msgid "06250"
msgstr ""
"Feizhi, I know. I know\n"
"how you feel...{page_break}"
"But it is not good\n"
"to ignore Master Feh.{end_wait}"

msgctxt "MsgFuchinTempleMyKickAndPunchAreVery"
msgid "06251"
msgstr ""
"My kick and punch are\n"
"very loud! They cause\n"
"much pain when they hit.{end_wait}"

msgctxt "MsgFuchinTempleShowUsYourChiNowDo"
msgid "06252"
msgstr ""
"Show us your\n"
"Chi. Now. Do it now.\n"
"I want to see it.{end_wait}"

msgctxt "MsgFuchinTempleIAmShockedThatThisWarrior"
msgid "06253"
msgstr ""
"I am shocked that this\n"
"warrior can use Chi.{page_break}"
"What will Master Feh say\n"
"when he sees it?{end_wait}"

msgctxt "MsgXianWarriorWillShowMeYour"
msgid "06254"
msgstr ""
"Warrior, will you\n"
"show me your Chi?{end_now}"

msgctxt "message"
msgid "06255"
msgstr "Very good. Now show me.{end_wait}"

msgctxt "message"
msgid "06256"
msgstr ""
"What you can do\n"
"is an incredible thing.\n"
"Hiding it is not good.{end_wait}"

msgctxt "MsgFuchinTempleFeizhiIsGoneItIsDangerousOutside"
msgid "06257"
msgstr ""
"Feizhi is gone! It is\n"
"dangerous outside of\n"
"the village. I am worried.{end_wait}"

msgctxt "MsgFuchinTempleFeizhiIsStrongerThanSheLooksShe"
msgid "06258"
msgstr ""
"Feizhi is stronger than\n"
"she looks. She will be\n"
"all right.{end_wait}"

msgctxt "MsgFuchinTempleIKnowWhyYouCanUse"
msgid "06259"
msgstr ""
"I know why you can\n"
"use Chi, warrior.\n"
"I know.{end_wait}"

msgctxt "MsgFuchinTempleWarriorChiIsAGreatPower"
msgid "06260"
msgstr ""
"Warrior, Chi is a great\n"
"power. Why hide it?{page_break}"
"The master wants to see\n"
"your Chi very much.{end_wait}"

msgctxt "MsgFuchinTempleIWantToSeeTheChi"
msgid "06261"
msgstr ""
"I want to see the Chi of\n"
"a warrior who knows\n"
"martial arts.{page_break}"
"Why won't you show me,\n"
"warrior?{end_wait}"

msgctxt "MsgFuchinTempleFeizhiIKnowHowYouFeel"
msgid "06262"
msgstr ""
"Feizhi, I know how you\n"
"feel. But, it is not wise\n"
"to ignore Master Feh.{end_wait}"

msgctxt "MsgFuchinTempleMyKickAndPunchAreVeryLoud"
msgid "06263"
msgstr ""
"My kick and punch are\n"
"very loud! They cause\n"
"much pain when they hit.{end_wait}"

msgctxt "MsgFuchinTempleWarriorShowMeYourChiNow"
msgid "06264"
msgstr ""
"Warrior, show me your\n"
"Chi. Now. Do it now.\n"
"I want to see it.{end_wait}"

msgctxt "MsgFuchinTempleWarriorDoNotHideYourChi"
msgid "06265"
msgstr ""
"Warrior, do not hide your\n"
"Chi from Master Feh.\n"
"It will make me a liar!{end_wait}"

msgctxt "MsgXianLookTreeFell"
msgid "06266"
msgstr "Look! The tree fell.{end_wait}"

msgctxt "message"
msgid "06267"
msgstr ""
"Master, did you see?\n"
"The warrior used Chi!{end_wait}"

msgctxt "message"
msgid "06268"
msgstr ""
"Master, what is the\n"
"matter?{end_wait}"

msgctxt "message"
msgid "06269"
msgstr ""
"He did not do it from\n"
"the line, so I\n"
"cannot be sure.{end_wait}"

msgctxt "message"
msgid "06270"
msgstr ""
"That is not good.\n"
"Warrior, do it right!\n"
"Do it from the line.{end_wait}"

msgctxt "MsgFuchinTempleWarriorUseYourChiFromThe"
msgid "06271"
msgstr ""
"Warrior, use your Chi\n"
"from the line.{end_wait}"

msgctxt "MsgFuchinTempleWarriorPleaseUseYourChiFrom"
msgid "06272"
msgstr ""
"Warrior, please!\n"
"Use your Chi from the\n"
"line.{end_wait}"

msgctxt "MsgFuchinTempleWarriorTheRulesRequireYouTo"
msgid "06273"
msgstr ""
"Warrior, the rules\n"
"require you to use\n"
"Chi from the line!{page_break}"
"You cannot back down\n"
"now.{end_wait}"

msgctxt "MsgFuchinTempleSoCloseWarriorUseChiFrom"
msgid "06274"
msgstr ""
"So close! Warrior, use\n"
"Chi from the line.\n"
"Do it again.{end_wait}"

msgctxt "MsgXianYaTreeFell"
msgid "06275"
msgstr "Ya! The tree fell!{end_wait}"

msgctxt "message"
msgid "06276"
msgstr ""
"Master, did you see?\n"
"The warrior used Chi.{end_wait}"

msgctxt "message"
msgid "06277"
msgstr ""
"The warrior's Chi is\n"
"excellent! Are you\n"
"surprised, Master?{end_wait}"

msgctxt "message"
msgid "06278"
msgstr "What is wrong, Master?{end_wait}"

msgctxt "message"
msgid "06279"
msgstr ""
"Hmmmm... The warrior\n"
"did make the tree fall.\n"
"I grant you that...{end_wait}"

msgctxt "message"
msgid "06280"
msgstr ""
"Is something wrong with\n"
"the warrior's Chi?{end_wait}"

msgctxt "message"
msgid "06281"
msgstr ""
"What the warrior did...\n"
"It is not Chi.{end_wait}"

msgctxt "message"
msgid "06282"
msgstr "What? It is not Chi?{end_wait}"

msgctxt "message"
msgid "06283"
msgstr ""
"Hmmm... It looks very\n"
"similar...but it is not\n"
"Chi.{end_wait}"

msgctxt "message"
msgid "06284"
msgstr ""
"Warrior... Have you{pause_20_skippable}\n"
"been to Fuchin Temple?{end_now}"

msgctxt "message"
msgid "06285"
msgstr "Ah... I knew it.{end_wait}"

msgctxt "message"
msgid "06286"
msgstr "Hmmm... That is strange.{end_wait}"

msgctxt "message"
msgid "06287"
msgstr ""
"How are Chi and\n"
"Fuchin Temple related?{end_wait}"

msgctxt "message"
msgid "06288"
msgstr ""
"I learned my Chi{pause_20_skippable}\n"
"from Master Hama\n"
"of Lama Temple.{end_wait}"

msgctxt "message"
msgid "06289"
msgstr ""
"Then{pause_20_skippable} it is the same\n"
"as Chi,{pause_20_skippable} is it not?{end_wait}"

msgctxt "message"
msgid "06290"
msgstr ""
"Very similar...\n"
"But still different...{end_wait}"

msgctxt "message"
msgid "06291"
msgstr ""
"Chi concentrates the\n"
"energy of the body into\n"
"the hand...{page_break}"
"then releases it onto\n"
"a distant object.{end_wait}"

msgctxt "message"
msgid "06292"
msgstr ""
"You, warrior, used energy\n"
"focused from the mind.\n"
"Understand?{end_now}"

msgctxt "message"
msgid "06293"
msgstr ""
"This warrior is wise.{page_break}"
"The power to will\n"
"something to move\n"
"requires much wisdom.{end_wait}"

msgctxt "message"
msgid "06294"
msgstr ""
"Remember this...{page_break}"
"Wishing for something\n"
"is the same as thinking\n"
"very hard.{end_wait}"

msgctxt "message"
msgid "06295"
msgstr ""
"Fuchin's Ki releases the\n"
"mind's energy like Chi\n"
"releases the body's.{end_wait}"

msgctxt "message"
msgid "06296"
msgstr ""
"The body's energy has\n"
"limits, but mental energy{pause_20_skippable}\n"
"has few limits.{end_wait}"

msgctxt "message"
msgid "06297"
msgstr ""
"Train your Ki. It\n"
"will grow very strong.\n"
"Do your best, warrior.{end_wait}"

msgctxt "MsgFuchinTemplePracticeEveryoneChiHasItsLimits"
msgid "06298"
msgstr ""
"Practice, everyone!\n"
"Chi has its limits,\n"
"but anyone can use it.{page_break}"
"Practice, practice!\n"
"Until you learn the power\n"
"of Chi.{end_wait}"

msgctxt "MsgFuchinTempleWarriorYouAreGreatYouHave"
msgid "06299"
msgstr ""
"Warrior, you are great.\n"
"You have earned\n"
"my respect.{end_wait}"

msgctxt "MsgFuchinTempleEveryoneWantsToLearnTheChi"
msgid "06300"
msgstr ""
"Everyone wants to learn\n"
"the Chi of Master Feh.{page_break}"
"I will study kung fu\n"
"to learn Chi.{end_wait}"

msgctxt "MsgFuchinTempleConcentrateEnergyIntoTheHandsAnd"
msgid "06301"
msgstr ""
"Concentrate energy into\n"
"the hands{pause_20_skippable} and release\n"
"it as Chi.{page_break}"
"This is what Master Feh\n"
"teaches. But it is hard.{page_break}"
"Master Hsu went to\n"
"Lama Temple. There, he\n"
"learns from Master Hama.{end_wait}"

msgctxt "MsgXianLamaTempleFarWestIn"
msgid "06302"
msgstr ""
"Lama Temple is far west.\n"
"It is in Lamakan Desert.{page_break}"
"Master Hsu went there\n"
"to train. He will come\n"
"back strong.{end_wait}"

msgctxt "MsgFuchinTempleIDidNotThinkMuchOf"
msgid "06303"
msgstr ""
"I did not think much of\n"
"you, warrior. I apologize.{end_wait}"

msgctxt "MsgFuchinTempleWhereDidFeizhiGoIAm"
msgid "06304"
msgstr ""
"Where did Feizhi go?\n"
"I am very worried.{end_wait}"

msgctxt "MsgFuchinTempleMasterHsuIsLateICan"
msgid "06305"
msgstr ""
"Master Hsu is late.\n"
"I can understand why\n"
"Feizhi worries.{end_wait}"

msgctxt "MsgFuchinTempleIWillLearnChiIWill"
msgid "06306"
msgstr ""
"I will learn Chi. I will\n"
"become strong. Stronger\n"
"than Master Feh...{end_wait}"

msgctxt "MsgFuchinTempleYourChiIsFuchinTemplesHow"
msgid "06307"
msgstr ""
"Your Chi is Fuchin\n"
"Temple's. How is it\n"
"different from our Chi?{end_wait}"

msgctxt "MsgFuchinTempleIDontCareWhichChiIt"
msgid "06308"
msgstr ""
"I don't care which Chi\n"
"it is. Kung fu's\n"
"or Fuchin's...{page_break}"
"I must learn it.{end_wait}"

msgctxt "MsgFuchinTempleMasterHamasChiCanShatterBoulders"
msgid "06309"
msgstr ""
"Master Hama's Chi can\n"
"shatter boulders.{page_break}"
"Can Master Hsu\n"
"shatter boulders with\n"
"his Chi?{end_wait}"

msgctxt "MsgFuchinTempleFollowSilkRoadStraightPassThrough"
msgid "06310"
msgstr ""
"Follow Silk Road straight.\n"
"Pass through the canyon.\n"
"You will see Lama Temple.{end_wait}"

msgctxt "MsgFuchinTempleWarriorYouUseWeaponsAndChi"
msgid "06311"
msgstr ""
"Warrior, you use weapons\n"
"and Chi. You are very\n"
"dangerous.{end_wait}"

msgctxt "MsgFuchinTempleFeizhiIsNotInTheFeh"
msgid "06312"
msgstr ""
"Feizhi is not in the Feh\n"
"School anymore...\n"
"It is sad. Very lonely.{end_wait}"

msgctxt "MsgFuchinTempleFeizhiWorriesOnlyAboutMasterHsu"
msgid "06313"
msgstr ""
"Feizhi worries only about\n"
"Master Hsu. It makes\n"
"me a little jealous.{end_wait}"

msgctxt "MsgFuchinTempleLearningChiIsVeryHardMaster"
msgid "06314"
msgstr ""
"Learning Chi...\n"
"is very hard.\n"
"Master Feh is amazing.{end_wait}"

msgctxt "MsgFuchinTempleCanSuchAYoungWarriorReally"
msgid "06315"
msgstr ""
"Can such a young warrior\n"
"really do it? It is\n"
"hard to believe...{end_wait}"

msgctxt "MsgXianGreatWarriorTrain"
msgid "06316"
msgstr ""
"You are a great warrior.\n"
"I must train, like you\n"
"must have trained.{end_wait}"

msgctxt "MsgXianItIsLocked"
msgid "06317"
msgstr "It is locked.{end_wait}"

msgctxt "MsgXianWarriorsCannotUse"
msgid "06318"
msgstr ""
"Warriors cannot use...\n"
"Wait.{pause_20_skippable} This is different\n"
"from Chi.{end_wait}"

msgctxt "message"
msgid "06319"
msgstr ""
"Do not step over\n"
"the line, warrior.{end_wait}"

msgctxt "message"
msgid "06320"
msgstr ""
"Stand beyond the line.\n"
"Then try your Chi.{end_wait}"

msgctxt "message"
msgid "06321"
msgstr ""
"Do you think I am\n"
"following you, warrior?{end_now}"

msgctxt "message"
msgid "06322"
msgstr ""
"You are mistaken,\n"
"warrior. I just want\n"
"to go west.{page_break}"
"You want to go west, too.\n"
"So, we end up going west{pause_20_skippable}\n"
"together.{end_wait}"

msgctxt "message"
msgid "06323"
msgstr ""
"You are right, warrior.\n"
"I am just going west,{pause_20_skippable}\n"
"like you are going west.{end_wait}"

msgctxt "message"
msgid "06324"
msgstr ""
"You're very persistent,\n"
"warrior. I just want to\n"
"go west.{page_break}"
"So, we end up going west{pause_20_skippable}\n"
"together.{end_wait}"

msgctxt "MsgMountainYahhSilkRoadBouldersBlock"
msgid "06325"
msgstr ""
"Yahh! Silk Road!\n"
"Boulders block the road!{end_wait}"

msgctxt "message"
msgid "06326"
msgstr ""
"My vision...\n"
"It came true.{end_wait}"

msgctxt "message"
msgid "06327"
msgstr "Hsu, Hsu!{end_wait}"

msgctxt "message"
msgid "06328"
msgstr ""
"It is no good. I\n"
"cannot hear\n"
"Hsu's voice!{end_wait}"

msgctxt "MsgMountainDoDoWarriorShouldReturn"
msgid "06329"
msgstr ""
"What do I do?\n"
"Warrior, should I return\n"
"to Xian?{end_now}"

msgctxt "message"
msgid "06330"
msgstr ""
"Going back is no option.\n"
"I must find Hsu.{end_wait}"

msgctxt "message"
msgid "06331"
msgstr ""
"You are right, warrior.\n"
"Of course not.\n"
"I must find Hsu.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleHsuIsInDangerICan"
msgid "06332"
msgstr ""
"Hsu is in danger.\n"
"I can sense it. I must\n"
"find him soon.{end_wait}"

msgctxt "MsgAltinYourFirstTimeVisitAltin"
msgid "06333"
msgstr ""
"Is this your first time\n"
"to visit Altin?{end_now}"

msgctxt "message"
msgid "06334"
msgstr ""
"Look at how much Altin\n"
"has changed!{page_break}"
"You can't do much\n"
"here until the\n"
"waters subside.{end_wait}"

msgctxt "message"
msgid "06335"
msgstr ""
"We must look a\n"
"lot like a coastal\n"
"town, huh?{end_now}"

msgctxt "message"
msgid "06336"
msgstr ""
"Nothing gets by you...\n"
"Altin never even had a\n"
"well in the old days.{page_break}"
"Water-spewing\n"
"monsters are what\n"
"waterlogged the village.{end_wait}"

msgctxt "message"
msgid "06337"
msgstr ""
"The day the gems fell\n"
"from the sky{pause_20_skippable}, these\n"
"water-spewing monsters{page_break}"
"appeared out of nowhere.\n"
"Now the village is ruined\n"
"because of them!{end_wait}"

msgctxt "MsgAltinHowCanThoseCreaturesSpitUp"
msgid "06338"
msgstr ""
"How can those creatures\n"
"spit up so much water?{end_wait}"

msgctxt "MsgAltinHowHorribleMyHouseIsTotally"
msgid "06339"
msgstr ""
"How horrible! My house\n"
"is totally coated\n"
"in monster spit.{end_wait}"

msgctxt "MsgAltinEvenTheMineIsSubmergedNo"
msgid "06340"
msgstr ""
"Even the mine is\n"
"submerged. No one\n"
"can enter it.{end_wait}"

msgctxt "MsgAltinIfWeCouldJustDestroyThe"
msgid "06341"
msgstr ""
"If we could just destroy\n"
"the monsters, all the\n"
"water should drain away.{end_wait}"

msgctxt "MsgAltinAltinAlwaysUsedToRunShort"
msgid "06342"
msgstr ""
"Altin always used to run\n"
"short on water. Now\n"
"we're all flooded in.{page_break}"
"Either way, we just\n"
"have bad luck when\n"
"it comes to water.{end_wait}"

msgctxt "MsgAltinWeCantDrinkWaterMonsters"
msgid "06343"
msgstr ""
"We can't drink the water\n"
"the monsters spew!\n"
"It's disgusting.{page_break}"
"Won't anyone ever slay\n"
"those beasts?{end_wait}"

msgctxt "MsgAltinTheWatersAroundHereHaveSubsided"
msgid "06344"
msgstr ""
"The waters around here\n"
"have subsided...{page_break}"
"I wonder if the holes in\n"
"the mine allowed the\n"
"water to drain.{end_wait}"

msgctxt "MsgAltinTheWaterBeastsLookedExactlyLike"
msgid "06345"
msgstr ""
"The water beasts looked\n"
"exactly like Altin's\n"
"guardian statues...{page_break}"
"Could the guardian\n"
"statues have turned\n"
"into the monsters?{end_wait}"

msgctxt "MsgAltinTheWatersHaveFlushedOutTons"
msgid "06346"
msgstr ""
"The waters have flushed\n"
"out tons of rock\n"
"from the mine.{page_break}"
"Maybe now we'll find\n"
"gems and ore we've\n"
"never even seen before.{end_wait}"

msgctxt "MsgAltinYouCameToAltinAtA"
msgid "06347"
msgstr ""
"You came to Altin at a\n"
"bad time. You're terribly\n"
"unlucky, huh?{end_wait}"

msgctxt "MsgAltinItsAlmostLikeTheyreTurningThe"
msgid "06348"
msgstr ""
"It's almost like they're\n"
"turning the air itself\n"
"into water!{end_wait}"

msgctxt "MsgAltinImGladISavedMyVery"
msgid "06349"
msgstr ""
"I'm glad I saved my very\n"
"first love letter, but what\n"
"about everything else?{end_wait}"

msgctxt "MsgAltinEvenTheToughestOfMinersCant"
msgid "06350"
msgstr ""
"Even the toughest of\n"
"miners can't do much\n"
"in this water.{end_wait}"

msgctxt "MsgAltinIfTheWaterBeastsContinueTo"
msgid "06351"
msgstr ""
"If the water beasts\n"
"continue to flood us...{page_break}"
"our entire village will\n"
"be submerged.{end_wait}"

msgctxt "MsgAltinWaterIsNiceButNotWhen"
msgid "06352"
msgstr ""
"Water is nice, but not\n"
"when it's flooding\n"
"your home.{end_wait}"

msgctxt "MsgAltinUghTheMonstersSpewedOutAll"
msgid "06353"
msgstr ""
"Ugh. The monsters spewed\n"
"out all of this water.\n"
"It smells foul...{end_wait}"

msgctxt "MsgAltinAsTheMonstersGoAwayThe"
msgid "06354"
msgstr ""
"As the monsters go away,\n"
"the waters recede.{page_break}"
"Maybe all of the\n"
"monsters will disappear\n"
"pretty soon...{end_wait}"

msgctxt "MsgAltinComeToThinkOfItIt"
msgid "06355"
msgstr ""
"Come to think of it, it\n"
"looked like our guardian\n"
"statue was spewing water.{end_wait}"

msgctxt "MsgAltinItllBeBetterThanDiggingUp"
msgid "06356"
msgstr ""
"It'll be better than\n"
"digging up more of those\n"
"durned ancient relics.{end_wait}"

msgctxt "MsgAltinOhNoTheWholeHouseIs"
msgid "06357"
msgstr ""
"Oh no... The whole\n"
"house is soaked...{end_wait}"

msgctxt "MsgAltinIfTheMonsterThatDidThis"
msgid "06358"
msgstr ""
"If the monster that did\n"
"this were here right now,\n"
"I'd give him such a smack!{page_break}"
"I'm just\n"
"kidding... I'm opposed\n"
"to all this violence.{end_wait}"

msgctxt "MsgAltinItsGoingToTakeALot"
msgid "06359"
msgstr ""
"It's going to take\n"
"a lot of work to get\n"
"this house back in shape.{end_wait}"

msgctxt "MsgAltinOneBlowsNotEnoughJabJab"
msgid "06360"
msgstr ""
"One blow's not enough.\n"
"Jab! Jab! Hook! Then\n"
"comes the uppercut!{end_wait}"

msgctxt "MsgAltinTryingFindYourWayWest"
msgid "06361"
msgstr ""
"Are you trying to\n"
"find your way west\n"
"through the mountains?{end_now}"

msgctxt "message"
msgid "06362"
msgstr ""
"There should be a passage\n"
"that leads west at the\n"
"bottom of the mine.{end_wait}"

msgctxt "message"
msgid "06363"
msgstr ""
"I don't know what you\n"
"did, but we are grateful\n"
"you defeated the beasts.{end_wait}"

msgctxt "MsgAltinDontBeTooHarshOnThose"
msgid "06364"
msgstr ""
"Don't be too harsh\n"
"on those beasts.{end_wait}"

msgctxt "MsgAltinIThoughtTheVillageWasDone"
msgid "06365"
msgstr ""
"I thought the village was\n"
"done for. I'm glad we\n"
"didn't give up hope.{end_wait}"

msgctxt "MsgAltinImJustGladToGetMy"
msgid "06366"
msgstr ""
"I'm just glad to get\n"
"my house back.{end_wait}"

msgctxt "MsgAltinIDidntWantToLeaveMy"
msgid "06367"
msgstr ""
"I didn't want to leave\n"
"my hometown...\n"
"That's why I came back.{end_wait}"

msgctxt "MsgAltinIHeardSomeoneKilledTheWater"
msgid "06368"
msgstr ""
"I heard someone killed\n"
"the water beasts.\n"
"That's why I came back.{page_break}"
"There's no place\n"
"like home.{end_wait}"

msgctxt "MsgAltinDefeatedThoseMonstersDidnt"
msgid "06369"
msgstr ""
"You defeated those\n"
"monsters, didn't you?{end_now}"

msgctxt "message"
msgid "06370"
msgstr ""
"Here, let me thank\n"
"you with...a kiss!{page_break}"
"Hey, you're turning\n"
"beet-red!{end_wait}"

msgctxt "message"
msgid "06371"
msgstr ""
"Oh, you didn't? Still, I'm\n"
"happy to be back home,\n"
"so here's a kiss!{page_break}"
"Hey, you're turning\n"
"beet-red!{end_wait}"

msgctxt "MsgAltinTheBottomOfTheMineThe"
msgid "06372"
msgstr ""
"The bottom of the mine...\n"
"The end of the\n"
"easternmost passage...{page_break}"
"I won't give that up.{end_wait}"

msgctxt "MsgAltinMyHusbandsSenseForFindingTreasure"
msgid "06373"
msgstr ""
"My husband's sense for\n"
"finding treasure has\n"
"never failed.{page_break}"
"Once the water recedes,\n"
"we'll dig up that spot\n"
"he found.{end_wait}"

msgctxt "MsgAltinMomAndPopKnowSomethingAbout"
msgid "06374"
msgstr ""
"Mom and Pop know\n"
"something about the\n"
"bottom of the mine.{page_break}"
"I wish they'd tell\n"
"me what it was.{end_wait}"

msgctxt "MsgAltinDoWantWeapons"
msgid "06375"
msgstr "Do you want weapons?{end_now}"

msgctxt "message"
msgid "06376"
msgstr ""
"I'll sell you anything\n"
"you want once the waters\n"
"have receded.{page_break}"
"What in the world\n"
"did we do to deserve\n"
"this fate?{end_wait}"

msgctxt "message"
msgid "06377"
msgstr ""
"You wouldn't say that if\n"
"you saw my weapons. I\n"
"wish I could show you.{end_wait}"

msgctxt "MsgAltinThankGoodnessWaterHasReceded"
msgid "06378"
msgstr ""
"Thank goodness the water\n"
"has receded. I can open\n"
"up shop again!{end_wait}"

msgctxt "MsgAltinCripesIsThisHowMyWeapon"
msgid "06379"
msgstr ""
"Cripes... Is this how\n"
"my weapon shop ends?\n"
"As a sunken disaster?{end_wait}"

msgctxt "MsgAltinOnlyAMerchantKnowsTheJoy"
msgid "06380"
msgstr ""
"Only a merchant knows\n"
"the joy of being open to\n"
"do business again.{end_wait}"

msgctxt "MsgAltinMyStoreSubmergedWantSell"
msgid "06381"
msgstr ""
"My store is submerged...\n"
"I want to sell armor,\n"
"but there's no way.{end_wait}"

msgctxt "MsgAltinItsGreatCanSellArmor"
msgid "06382"
msgstr ""
"It's great that I can\n"
"sell armor out of my\n"
"shop again.{end_wait}"

msgctxt "MsgAltinAllMyArmorInventoryIsRusting"
msgid "06383"
msgstr ""
"All my armor inventory is\n"
"rusting even as we speak.{end_wait}"

msgctxt "MsgAltinWeDriedOffAllThatArmor"
msgid "06384"
msgstr ""
"We dried off all\n"
"that armor and\n"
"polished it up!{page_break}"
"There should be no trace\n"
"of rust now.{end_wait}"

msgctxt "MsgAltinWillDoIfMyMerchandise"
msgid "06385"
msgstr ""
"Oh, no! What will I do\n"
"if all my merchandise\n"
"is soaked?{end_wait}"

msgctxt "MsgAltinNoneMyGoodsWereDamaged"
msgid "06386"
msgstr ""
"None of my goods were\n"
"damaged. I'm going to sell\n"
"like there's no tomorrow!{end_wait}"

msgctxt "MsgAltinIfMyGoodsAreWetIll"
msgid "06387"
msgstr ""
"If my goods are wet, I'll\n"
"have to dry them out\n"
"before I can sell them.{end_wait}"

msgctxt "MsgAltinAFewThingsGotDampBut"
msgid "06388"
msgstr ""
"A few things got damp...{page_break}"
"But it shouldn't affect the\n"
"quality, so you can use\n"
"them without any worries.{page_break}"
"...Maybe I'll put up a\n"
"sign to explain it all.{end_wait}"

msgctxt "MsgAltinWeGotLittleDampBut"
msgid "06389"
msgstr ""
"We got a little damp, but\n"
"we're doing okay. We \n"
"must count our blessings.{end_now}"

msgctxt "message"
msgid "06390"
msgstr ""
"After all, a lot of\n"
"good people have been\n"
"hurt in this flooding.{end_wait}"

msgctxt "message"
msgid "06391"
msgstr ""
"You have to remember,\n"
"lots of people lost\n"
"everything they own.{page_break}"
"It's just sad, when\n"
"you think about it.{end_wait}"

msgctxt "MsgAltinIdGiveAnythingForSomeoneTo"
msgid "06392"
msgstr ""
"I'd give anything for\n"
"someone to return\n"
"Altin to its former glory.{page_break}"
"You look pretty young,\n"
"but if you are a true\n"
"warrior, please help us.{end_wait}"

msgctxt "MsgAltinICameFromXianICook"
msgid "06393"
msgstr ""
"I came from Xian.\n"
"I cook good food.\n"
"Eat up!{end_wait}"

msgctxt "MsgAltinNoneOfUsCanGoHome"
msgid "06394"
msgstr ""
"None of us can go\n"
"home until the\n"
"water subsides.{end_wait}"

msgctxt "MsgAltinTheGuestsInRoomOneMoved"
msgid "06395"
msgstr ""
"The guests in Room One\n"
"moved back home when\n"
"the waters receded.{end_wait}"

msgctxt "MsgAltinTheGuestsInRoomTwoAlso"
msgid "06396"
msgstr ""
"The guests in Room Two\n"
"also went home after the\n"
"waters receded.{end_wait}"

msgctxt "MsgAltinWellComeThroughThisAllRight"
msgid "06397"
msgstr ""
"We'll come through this\n"
"all right, but I'm afraid\n"
"the village is done for.{end_wait}"

msgctxt "MsgAltinIKnowTheyDontLookSo"
msgid "06398"
msgstr ""
"I know they don't look\n"
"so tough, but being\n"
"warriors and all,{page_break}"
"maybe they can help us.{end_wait}"

msgctxt "MsgAltinIBecameACookAfterI"
msgid "06399"
msgstr ""
"I became a cook after\n"
"I came to Altin, but I still\n"
"cook well.{end_wait}"

msgctxt "MsgAltinMostOfTheVillageIsStill"
msgid "06400"
msgstr ""
"Most of the village is\n"
"still submerged...{page_break}"
"It will be a long time\n"
"before Altin returns\n"
"to its former glory.{end_wait}"

msgctxt "MsgAltinItLooksLikeTheWaterHas"
msgid "06401"
msgstr ""
"It looks like the water\n"
"has receded a bit,{page_break}"
"but it will be a long\n"
"time before Altin returns\n"
"to its former glory.{end_wait}"

msgctxt "MsgAltinNoMatterWhatHappensIdNever"
msgid "06402"
msgstr ""
"No matter what happens,\n"
"I'd never abandon Altin.{end_wait}"

msgctxt "MsgAltinOfCourseOurHouseWillBe"
msgid "06403"
msgstr ""
"Of course, our house will\n"
"be ruined now.{page_break}"
"I wish I could\n"
"move away...{end_wait}"

msgctxt "MsgAltinLeavingAltinForTolbiWellThats"
msgid "06404"
msgstr ""
"Leaving Altin for Tolbi?\n"
"Well, that's just crazy.{end_wait}"

msgctxt "MsgAltinNowIFinallyHaveAnExcuse"
msgid "06405"
msgstr ""
"Now I finally have an\n"
"excuse to move to\n"
"my favorite town{em_dash}Tolbi!{end_wait}"

msgctxt "MsgAltinNotManyPeopleComeUpSilk"
msgid "06406"
msgstr ""
"Not many people come up\n"
"Silk Road to Altin. You're\n"
"an odd one, you are.{end_wait}"

msgctxt "MsgAltinItsBeenALongTimeSince"
msgid "06407"
msgstr ""
"It's been a long time\n"
"since I got a break\n"
"from doing housework.{end_wait}"

msgctxt "MsgAltinOfCourseYouCantGoWest"
msgid "06408"
msgstr ""
"Of course, you can't\n"
"go west of the mountains\n"
"without taking Silk Road.{end_wait}"

msgctxt "MsgAltinIHateSittingAroundLikeThis"
msgid "06409"
msgstr ""
"I hate sitting around\n"
"like this. I want to\n"
"go home!{end_wait}"

msgctxt "MsgSanctumWasAfterEerieNightWhen"
msgid "06410"
msgstr ""
"It was after that eerie\n"
"night when the gems\n"
"fell from the sky.{page_break}"
"That was when the\n"
"water-spewing beasts\n"
"appeared in the mine!{end_wait}"

msgctxt "MsgSanctumPleaseSaveTheHelplessInAltin"
msgid "06411"
msgstr ""
"Please save the helpless\n"
"in Altin...{end_wait}"

msgctxt "MsgAltinWeDidIsaacWeBeat"
msgid "06412"
msgstr ""
"We did it, {actor_name:1}!\n"
"We beat the last\n"
"water beast!{end_wait}"

msgctxt "message"
msgid "06413"
msgstr ""
"I wonder why Altin's\n"
"guardian statues turned\n"
"into monsters.{page_break}"
"Isn't it strange?{end_now}"

msgctxt "message"
msgid "06414"
msgstr ""
"And what's up with this\n"
"strange, tiled room at the\n"
"bottom of the mine?{end_wait}"

msgctxt "message"
msgid "06415"
msgstr ""
"Oh, I'm sure you get\n"
"that sort of thing\n"
"all the time.{page_break}"
"Still, it's strange that the\n"
"bottom of the mine was\n"
"made of carved stone.{end_wait}"

msgctxt "MsgAltinGuardianStatuesWereCreatedLong"
msgid "06416"
msgstr ""
"The guardian statues\n"
"were created long,\n"
"long ago.{end_wait}"

msgctxt "message"
msgid "06417"
msgstr "What are they for?{end_wait}"

msgctxt "message"
msgid "06418"
msgstr ""
"There's a treasure\n"
"chest behind the\n"
"guardian statue!{end_wait}"

msgctxt "message"
msgid "06419"
msgstr ""
"It must all be related\n"
"to these ruins, buried\n"
"deep in the mine...{end_wait}"

msgctxt "message"
msgid "06420"
msgstr ""
"I guess so... Hey, {actor_name:1},\n"
"we should check that\n"
"chest before we go!{end_wait}"

msgctxt "message"
msgid "06421"
msgstr ""
"In the hands of an Adept,\n"
"the Lifting Gem imparts\n"
"great power.{end_wait}"

msgctxt "message"
msgid "06422"
msgstr ""
"{actor_name:1} acquired\n"
"the Psynergy Lift.{end_wait}"

msgctxt "MsgAltinThankYouSoMuchForDefeating"
msgid "06423"
msgstr ""
"Thank you so much for\n"
"defeating the hydros\n"
"statues in the mine.{end_wait}"

msgctxt "MsgAltinDidSeeWaterGushingOut"
msgid "06424"
msgstr ""
"Did you see water\n"
"gushing out when you slew\n"
"those hydros creatures?{end_now}"

msgctxt "message"
msgid "06425"
msgstr ""
"I see... So the water\n"
"monsters are like\n"
"giant water tanks...{end_wait}"

msgctxt "message"
msgid "06426"
msgstr ""
"Really... Then how could\n"
"they have carried all\n"
"that water?{end_wait}"

msgctxt "MsgAltinOnceTheMineOpensAgainWell"
msgid "06427"
msgstr ""
"Once the mine opens\n"
"again, we'll be able to\n"
"get back on our feet.{end_wait}"

msgctxt "MsgAltinTheyAlreadyStartedMiningTheUpper"
msgid "06428"
msgstr ""
"They already started\n"
"mining the upper parts\n"
"of the mountain.{page_break}"
"But people still seem\n"
"afraid to go down to\n"
"the lower depths.{end_wait}"

msgctxt "MsgAltinTheWaterDrainedOutOfThe"
msgid "06429"
msgstr ""
"The water drained out of\n"
"the mine through all the\n"
"cracks, as I expected.{page_break}"
"But the remaining water\n"
"will probably sit here\n"
"for a while.{end_wait}"

msgctxt "MsgAltinThankGoodnessTheVillageIsFree"
msgid "06430"
msgstr ""
"Thank goodness,\n"
"the village is free\n"
"from all that water.{end_wait}"

msgctxt "MsgAltinOnesWhoDefeatedWaterBeasts"
msgid "06431"
msgstr ""
"Are you the ones who\n"
"defeated the water\n"
"beasts?{end_now}"

msgctxt "message"
msgid "06432"
msgstr ""
"We'd be much obliged\n"
"if you'd also help\n"
"rebuild the village.{end_wait}"

msgctxt "message"
msgid "06433"
msgstr ""
"I heard our rescuers\n"
"were young. I'd like\n"
"to meet them.{end_wait}"

msgctxt "MsgAltinTheVillageWentRightBackTo"
msgid "06434"
msgstr ""
"The village went right\n"
"back to normal once\n"
"the water monsters left.{page_break}"
"But it's still a mess\n"
"around here.{end_wait}"

msgctxt "MsgAltinSoThoseHydrosCreaturesReallyWere"
msgid "06435"
msgstr ""
"So those hydros creatures\n"
"really were the guardian\n"
"statues, huh?{page_break}"
"That sure is a surprise.{end_wait}"

msgctxt "MsgAltinTrueFoundAncientRuinsIn"
msgid "06436"
msgstr ""
"Is it true you found\n"
"ancient ruins in the\n"
"deepest part of the mine?{end_now}"

msgctxt "message"
msgid "06437"
msgstr ""
"Really? I always thought\n"
"that mine held some\n"
"kind of secret.{end_wait}"

msgctxt "message"
msgid "06438"
msgstr ""
"Hmmm, are you sure you\n"
"even went down there?{page_break}"
"Someone ought to\n"
"go check it out.{end_wait}"

msgctxt "MsgAltinWeCanGoBackToWork"
msgid "06439"
msgstr ""
"We can go back to\n"
"work in the\n"
"mines again.{end_wait}"

msgctxt "MsgAltinIWasAfraidMoreWaterWould"
msgid "06440"
msgstr ""
"I was afraid more water\n"
"would gush out when\n"
"the monsters were slain.{end_wait}"

msgctxt "MsgAltinIHopeAltinMineWillThrive"
msgid "06441"
msgstr ""
"I hope Altin Mine will\n"
"thrive again soon,\n"
"like it once did.{end_wait}"

msgctxt "MsgAltinTheWaterSeepedIntoTheMine"
msgid "06442"
msgstr ""
"The water seeped into\n"
"the mine shafts.{page_break}"
"I bet the rock is\n"
"very soft.{end_wait}"

msgctxt "MsgAltinItsSoHumidInsideThatCave"
msgid "06443"
msgstr ""
"It's so humid inside that\n"
"cave. It feels awful\n"
"and sticky in there!{end_wait}"

msgctxt "MsgAltinThatStrangeChamberInTheMines"
msgid "06444"
msgstr ""
"That strange chamber in\n"
"the mines creeps me out.{end_wait}"

msgctxt "MsgAltinYouFoughtPrettyWellDespiteAll"
msgid "06445"
msgstr ""
"You fought pretty well\n"
"despite all that foul water\n"
"the beasts spewed out.{end_wait}"

msgctxt "MsgAltinThatMineIsFullOfHoles"
msgid "06446"
msgstr ""
"That mine is full of holes\n"
"and chasms. That's why\n"
"it drained so well.{end_wait}"

msgctxt "MsgAltinTheOldGuardianStatuesAlwaysCreeped"
msgid "06447"
msgstr ""
"The old guardian statues\n"
"always creeped me out.\n"
"I'm glad they're gone.{end_wait}"

msgctxt "MsgAltinIUsedToFindAllSorts"
msgid "06448"
msgstr ""
"I used to find all sorts\n"
"of artifacts. I wonder if\n"
"they came from the ruins.{end_wait}"

msgctxt "MsgAltinIHearThatSilkRoadIs"
msgid "06449"
msgstr ""
"I hear that Silk\n"
"Road is closed...{page_break}"
"Or, at least, that's what\n"
"this girl from Xian said.{end_wait}"

msgctxt "MsgAltinGirlFromXianWasAsking"
msgid "06450"
msgstr ""
"A girl from Xian was\n"
"asking questions about\n"
"young warriors.{page_break}"
"Say, could she have\n"
"meant you guys?{end_now}"

msgctxt "message"
msgid "06451"
msgstr ""
"She was searching\n"
"very hard.{end_wait}"

msgctxt "message"
msgid "06452"
msgstr ""
"Well, if not, I hope she\n"
"finds whoever she was\n"
"looking for.{end_wait}"

msgctxt "MsgAltinTheMerchantsMustBeHavingA"
msgid "06453"
msgstr ""
"The merchants must be\n"
"having a hard time if\n"
"Silk Road is blocked.{page_break}"
"Who could clear\n"
"away a landslide?{end_wait}"

msgctxt "MsgAltinIWonderWhatBusinessThatGirl"
msgid "06454"
msgstr ""
"I wonder what business\n"
"that girl from Xian has\n"
"with warriors...{end_wait}"

msgctxt "MsgAltinAncientRuinsAndTreasureDefinitelyGo"
msgid "06455"
msgstr ""
"Ancient ruins and\n"
"treasure definitely go\n"
"together...{page_break}"
"What are you going\n"
"to do?{end_wait}"

msgctxt "MsgAltinIfOnlyTheyHadLeftA"
msgid "06456"
msgstr ""
"If only they had left a\n"
"water monster or two...{end_wait}"

msgctxt "MsgAltinTheySayYouCanStillFind"
msgid "06457"
msgstr ""
"They say you can still\n"
"find monsters if you go\n"
"deep enough in the mine.{page_break}"
"I'd go treasure hunting\n"
"if it weren't for those\n"
"nasty beasts.{end_wait}"

msgctxt "MsgAltinHowCanITrulyBeHappy"
msgid "06458"
msgstr ""
"How can I truly be\n"
"happy if all those cute\n"
"monsters are gone?{end_wait}"

msgctxt "MsgAltinReallyAncientRuinsAtTheBottom"
msgid "06459"
msgstr ""
"Really? Ancient ruins at\n"
"the bottom of the\n"
"mine? You don't say...{end_wait}"

msgctxt "MsgAltinThereProbablyIsntMuchTreasureIn"
msgid "06460"
msgstr ""
"There probably isn't\n"
"much treasure in the\n"
"ruins beneath the mine.{page_break}"
"Why don't you forget\n"
"about treasure and just\n"
"resume your journey?{end_wait}"

msgctxt "MsgAltinSomethingsWrongWithMomAndPop"
msgid "06461"
msgstr ""
"Something's wrong with\n"
"Mom and Pop. They've\n"
"been acting weird{page_break}"
"ever since the ruins were\n"
"found in the mine.{end_wait}"

msgctxt "MsgAltinCripesAncientRuinsDownInThe"
msgid "06462"
msgstr ""
"Cripes. Ancient ruins\n"
"down in the mine...{page_break}"
"We have to go get that\n"
"treasure right away.{end_wait}"

msgctxt "MsgAltinIHadNoIdeaThereWere"
msgid "06463"
msgstr ""
"I had no idea there were\n"
"ruins beneath the mine.{end_wait}"

msgctxt "MsgAltinIWonderIfMomAndPop"
msgid "06464"
msgstr ""
"I wonder if Mom and Pop\n"
"knew about the monument\n"
"in the mine.{end_wait}"

msgctxt "MsgAltinYoullHaveFindPassageIn"
msgid "06465"
msgstr ""
"You'll have to find the\n"
"passage in the mine\n"
"that leads west{page_break}"
"if Silk Road is blocked.{end_wait}"

msgctxt "MsgAltinIveHeardOfAPassageIn"
msgid "06466"
msgstr ""
"I've heard of a passage\n"
"in the mine that leads\n"
"west, but I've yet to meet{page_break}"
"anyone who's found it.{end_wait}"

msgctxt "MsgAltinHowAboutArentImpressedBy"
msgid "06467"
msgstr ""
"How about it? Aren't you\n"
"impressed by our vast\n"
"armor selection?{end_wait}"

msgctxt "MsgAltinWellIfYouAreImpressedThen"
msgid "06468"
msgstr ""
"Well, if you are\n"
"impressed, then make\n"
"a purchase!{end_wait}"

msgctxt "MsgAltinGirlFromXianBoughtLot"
msgid "06469"
msgstr ""
"The girl from Xian bought\n"
"a lot. I wonder if\n"
"she is on a journey.{end_wait}"

msgctxt "MsgAltinTheGirlFromXianBoughtAll"
msgid "06470"
msgstr ""
"The girl from Xian bought\n"
"all goods that had\n"
"been submerged.{end_wait}"

msgctxt "MsgAltinThereSmallTempleWestAltin"
msgid "06471"
msgstr ""
"There is a small temple\n"
"to the west of Altin Mine.{page_break}"
"They may be having\n"
"trouble with the water\n"
"from the mine.{end_wait}"

msgctxt "MsgAltinThereIsAnEndlessDesertWest"
msgid "06472"
msgstr ""
"There is an endless\n"
"desert west of\n"
"the mountains.{page_break}"
"Any travelers going\n"
"west must prepare\n"
"themselves well.{end_wait}"

msgctxt "MsgAltinWestOfTheMountainsIsVery"
msgid "06473"
msgstr ""
"West of the mountains\n"
"is very{em_dash}very hot!\n"
"It is exhausting!{page_break}"
"Eating hot food is\n"
"good. It helps you\n"
"endure the heat.{end_wait}"

msgctxt "MsgAltinThereFewBeastsInMine"
msgid "06474"
msgstr ""
"There are a few beasts in\n"
"the mine still, but they're\n"
"down deep below, right?{end_now}"

msgctxt "message"
msgid "06475"
msgstr ""
"Good. Then we can just\n"
"mine the upper\n"
"passages.{end_wait}"

msgctxt "message"
msgid "06476"
msgstr ""
"If they're in the upper\n"
"passages, then we can't\n"
"mine like we used to.{end_wait}"

msgctxt "MsgAltinIThinkThatTempleWasCalled"
msgid "06477"
msgstr ""
"I think that temple was\n"
"called Lama Temple.{page_break}"
"There are said to be\n"
"people with strange\n"
"powers there.{end_wait}"

msgctxt "MsgAltinYouWontBeAbleToGo"
msgid "06478"
msgstr ""
"You won't be able to go\n"
"to the desert for a while\n"
"since Silk Road is blocked.{end_wait}"

msgctxt "MsgAltinNoOneCanGoWestOf"
msgid "06479"
msgstr ""
"No one can go west of\n"
"the mountains now.{end_wait}"

msgctxt "MsgAltinItWillTakeSomeTimeBefore"
msgid "06480"
msgstr ""
"It will take some time\n"
"before Altin recovers\n"
"from this.{end_wait}"

msgctxt "MsgSanctumSavedAltinFromMonstersClearly"
msgid "06481"
msgstr ""
"You saved Altin from\n"
"the monsters.{page_break}"
"Clearly this is the\n"
"work of the hand of Fate.{end_wait}"

msgctxt "MsgSanctumAlmightyFateMustHaveHeardMe"
msgid "06482"
msgstr ""
"Almighty Fate must\n"
"have heard me.{end_wait}"

msgctxt "MsgAltinWatchFallingRocks"
msgid "06483"
msgstr ""
"Watch for falling rocks!{page_break}"
"Do not strike the\n"
"wall! Rocks may fall!{end_wait}"

msgctxt "message"
msgid "06484"
msgstr ""
"Tch!{pause_20_skippable} We came this deep\n"
"into the mine just to\n"
"find a dead end!{end_wait}"

msgctxt "message"
msgid "06485"
msgstr ""
"...I have a bad feeling\n"
"about this. Run,\n"
"{actor_name:1}! Now!{end_wait}"

msgctxt "MsgMountainHeWhoHasPowerSee"
msgid "06486"
msgstr ""
"He who has the power to see\n"
"that which cannot be seen\n"
"shall see the truth...{page_break}"
"So reads the writing\n"
"on the wall.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleThisIsLamaTempleWelcomeTravelers"
msgid "06487"
msgstr ""
"This is Lama Temple.\n"
"Welcome, travelers.{page_break}"
"The Lamakan Desert ahead\n"
"is a very hot land. Rest\n"
"well before you go.{end_wait}"

msgctxt "MsgMountainYoungWarriorsDoComeFrom"
msgid "06488"
msgstr ""
"Young warriors, do you\n"
"come from the east?{end_now}"

msgctxt "message"
msgid "06489"
msgstr ""
"Then you must have come\n"
"across Lamakan Desert...{end_wait}"

msgctxt "message"
msgid "06490"
msgstr ""
"Did you stop in Xian\n"
"along the way?{end_now}"

msgctxt "message"
msgid "06491"
msgstr ""
"Master Feh, in Xian, is\n"
"very close to our\n"
"Master Hama.{page_break}"
"Students from Feh's\n"
"school often continue their\n"
"kung fu training here...{end_wait}"

msgctxt "message"
msgid "06492"
msgstr ""
"Then it is good that\n"
"you have come here.{page_break}"
"Feh's kung fu is good\n"
"for warriors who\n"
"seek to better themselves.{end_wait}"

msgctxt "MsgMountainDoKnowMeditation"
msgid "06493"
msgstr ""
"Do you know what\n"
"meditation is?{end_now}"

msgctxt "message"
msgid "06494"
msgstr ""
"It allows you to find\n"
"peace by closing\n"
"your eyes...{page_break}"
"and sealing your\n"
"mind from the\n"
"world around you.{end_wait}"

msgctxt "message"
msgid "06495"
msgstr ""
"It is training in which\n"
"you clear your mind of\n"
"all thought...{page_break}"
"and try to become\n"
"as still and calm\n"
"as a stone.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleYouWhoSpeakToMeI"
msgid "06496"
msgstr ""
"You who speak to me...\n"
"I sense great insecurity\n"
"and anxiety within you.{end_wait}"

msgctxt "MsgMountainDidKnowMasterHamaGreatest"
msgid "06497"
msgstr ""
"Did you know that Master\n"
"Hama is the greatest\n"
"master of Chi?{end_now}"

msgctxt "message"
msgid "06498"
msgstr ""
"You do? Then you must\n"
"have already met Master\n"
"Feh in Xian, haven't you?{page_break}"
"But Hama's power does\n"
"not end there.{end_wait}"

msgctxt "message"
msgid "06499"
msgstr ""
"Then today, you shall\n"
"see that Master Hama is\n"
"truly the master of Chi.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleTheySeemToBeAnxiousThey"
msgid "06500"
msgstr ""
"They seem to be anxious.\n"
"They cannot survive\n"
"the desert like that.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleTheySayAPersonCanOvercome"
msgid "06501"
msgstr ""
"They say a person can\n"
"overcome any trial\n"
"once he masters kung fu.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleIAmHungry"
msgid "06502"
msgstr ""
".{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}."
"{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}\n"
".{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}."
"{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}\n"
"I{pause_20_skippable}{pause_20_skippable}{pause_20_skippable} am "
"hungry...{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleISenseImpureThoughtsFromThe"
msgid "06503"
msgstr ""
"I sense impure thoughts\n"
"from the man beside me...\n"
"His training is weak.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleChiIsButAFragmentOf"
msgid "06504"
msgstr ""
"Chi is but a fragment of\n"
"Master Hama's power...\n"
"She is a true scholar.{end_wait}"

msgctxt "MsgXianMasterHamaMeditatingPleaseExtremely"
msgid "06505"
msgstr ""
"Master Hama is\n"
"meditating. Please be\n"
"extremely quiet.{end_wait}"

msgctxt "message"
msgid "06506"
msgstr ""
"So, {actor_name:1}, you and\n"
"your Adept companions\n"
"have finally come.{end_wait}"

msgctxt "message"
msgid "06507"
msgstr ""
"Finally come?\n"
"Was she expecting us?{end_now}"

msgctxt "message"
msgid "06508"
msgstr ""
"But how did she know\n"
"we'd be here now?{end_wait}"

msgctxt "message"
msgid "06509"
msgstr ""
"Then, how come she knew\n"
"we were coming, {actor_name:1}?\n{end_wait}"

msgctxt "message"
msgid "06510"
msgstr ""
"I had{pause_20_skippable} anticipated{pause_20_skippable}\n"
"your arrival.{end_wait}"

msgctxt "message"
msgid "06511"
msgstr ""
"You knew we were\n"
"coming, then?{end_wait}"

msgctxt "message"
msgid "06512"
msgstr ""
"I have been waiting a\n"
"long while for you.{page_break}"
"You come seeking\n"
"the Elemental Stars.{end_wait}"

msgctxt "message"
msgid "06513"
msgstr ""
"You know about the\n"
"Elemental Stars, too?\n"
"Who...{pause_20_skippable} Who are you?{end_wait}"

msgctxt "message"
msgid "06514"
msgstr ""
"I am a Jupiter Adept,\n"
"just like {actor_name:3}.{end_wait}"

msgctxt "message"
msgid "06515"
msgstr ""
"I'm not a Jupiter Adept!\n"
"What are you\n"
"talking about?{end_wait}"

msgctxt "message"
msgid "06516"
msgstr ""
"You are, {actor_name:3}, although\n"
"you may not yet know it.{end_wait}"

msgctxt "message"
msgid "06517"
msgstr "Why do you say that?{end_wait}"

msgctxt "message"
msgid "06518"
msgstr ""
"Do you not have the\n"
"power to read minds?{end_wait}"

msgctxt "message"
msgid "06519"
msgstr ""
"This ability is unique\n"
"to the Jupiter Adepts.{end_wait}"

msgctxt "message"
msgid "06520"
msgstr ""
"You predicted our\n"
"coming... Is that\n"
"also{pause_20_skippable} Psynergy?{end_wait}"

msgctxt "message"
msgid "06521"
msgstr ""
"Ho ho!{pause_20_skippable} Excellent question,\n"
"Miss {actor_name:4}.{end_wait}"

msgctxt "message"
msgid "06522"
msgstr ""
"Yes, the ability to foresee\n"
"events also belongs to\n"
"the Jupiter Adepts.{end_wait}"

msgctxt "message"
msgid "06523"
msgstr ""
"Then, can {actor_name:3} learn the\n"
"power of prediction, too?{end_wait}"

msgctxt "message"
msgid "06524"
msgstr "He already has.{end_wait}"

msgctxt "message"
msgid "06525"
msgstr "I don't think I have{em_dash}{end_wait}"

msgctxt "message"
msgid "06526"
msgstr ""
"You do.{pause_20_skippable} You merely do\n"
"not yet know that\n"
"you have it.{end_wait}"

msgctxt "message"
msgid "06527"
msgstr ""
"The power of Jupiter\n"
"must be great if it\n"
"lets you see the future.{end_wait}"

msgctxt "message"
msgid "06528"
msgstr ""
"Oh, but {actor_name:3} can learn\n"
"to use an even\n"
"greater power!{end_wait}"

msgctxt "message"
msgid "06529"
msgstr "What greater power?{end_wait}"

msgctxt "message"
msgid "06530"
msgstr "Reveal.{end_wait}"

msgctxt "message"
msgid "06531"
msgstr "Reveal?{end_wait}"

msgctxt "message"
msgid "06532"
msgstr ""
"Yes. I have waited long\n"
"to pass the power of\n"
"true sight on to you.{end_wait}"

msgctxt "message"
msgid "06533"
msgstr ""
"You waited here in Lama\n"
"Temple just to teach\n"
"Reveal to {actor_name:3}?{end_wait}"

msgctxt "message"
msgid "06534"
msgstr ""
"You will need Reveal\n"
"if you are to achieve\n"
"your goals...{end_wait}"

msgctxt "message"
msgid "06535"
msgstr ""
"Jupiter Adepts can learn\n"
"Reveal on their own,\n"
"over time...{end_wait}"

msgctxt "message"
msgid "06536"
msgstr ""
"But that power alone will\n"
"not help you find Saturos\n"
"as his company moves on.{end_wait}"

msgctxt "message"
msgid "06537"
msgstr ""
"It was Saturos and his\n"
"companions who blocked\n"
"Silk Road.{end_wait}"

msgctxt "message"
msgid "06538"
msgstr ""
"{actor_name:5} and the rest\n"
"of them, huh?{pause_20_skippable}\n"
"Those cowards!{end_wait}"

msgctxt "message"
msgid "06539"
msgstr ""
"{actor_name:5} bears a terrible\n"
"fate, a burden I would\n"
"not wish on any man.{end_wait}"

msgctxt "message"
msgid "06540"
msgstr ""
"A terrible fate?\n"
"What do you mean?{end_wait}"

msgctxt "message"
msgid "06541"
msgstr ""
"I am sorry, but I can\n"
"say nothing more of\n"
"this matter.{end_wait}"

msgctxt "message"
msgid "06542"
msgstr ""
"Now, we must focus on\n"
"the power of Reveal.{end_wait}"

msgctxt "message"
msgid "06543"
msgstr ""
"You will need the power\n"
"of Reveal to cross the\n"
"evil Lamakan Desert.{end_wait}"

msgctxt "message"
msgid "06544"
msgstr ""
"An evil desert?\n"
"Is that even possible?{end_now}"

msgctxt "message"
msgid "06545"
msgstr ""
"You believe that, {actor_name:1}?\n"
"Well, I just don't buy it.{end_wait}"

msgctxt "message"
msgid "06546"
msgstr ""
"It's hard to believe,\n"
"isn't it, {actor_name:1}?\n"
"I feel the same way.{end_wait}"

msgctxt "message"
msgid "06547"
msgstr ""
"Why will we need Reveal\n"
"to cross the desert?{end_wait}"

msgctxt "message"
msgid "06548"
msgstr ""
"Crossing Lamakan Desert\n"
"was hard enough with\n"
"the extreme heat.{end_wait}"

msgctxt "message"
msgid "06549"
msgstr ""
"But evil has taken hold of\n"
"the desert, and its heat\n"
"has become unbearable.{end_wait}"

msgctxt "message"
msgid "06550"
msgstr ""
"Entering the desert now\n"
"is nothing short of\n"
"asking for death.{end_wait}"

msgctxt "message"
msgid "06551"
msgstr ""
"Then how can Saturos\n"
"cross such a deadly\n"
"place?{end_wait}"

msgctxt "message"
msgid "06552"
msgstr ""
"Saturos and Menardi\n"
"are Mars Adepts.{end_wait}"

msgctxt "message"
msgid "06553"
msgstr ""
"I am merely guessing...{page_break}"
"but their powers might\n"
"help them suppress the\n"
"heat as they cross.{end_wait}"

msgctxt "message"
msgid "06554"
msgstr ""
"I still don't understand...\n"
"How will Reveal help us\n"
"in such an evil place?{end_wait}"

msgctxt "message"
msgid "06555"
msgstr ""
"Reveal will help you\n"
"find oases to cool you\n"
"against the heat.{end_wait}"

msgctxt "message"
msgid "06556"
msgstr ""
"Why would we need\n"
"Reveal for that? Won't we\n"
"be able to see the oases?{end_wait}"

msgctxt "message"
msgid "06557"
msgstr ""
"Do you know what\n"
"a mirage is?{end_now}"

msgctxt "message"
msgid "06558"
msgstr ""
"The desert is filled with\n"
"mirages that prevent you\n"
"from seeing clearly.{page_break}"
"Without Reveal, you\n"
"cannot find the oases.{end_wait}"

msgctxt "message"
msgid "06559"
msgstr ""
"Intense heat creates\n"
"a curtain of air that\n"
"distorts the terrain.{page_break}"
"Mirages will deceive your\n"
"eyes, preventing you from\n"
"finding any oases.{end_wait}"

msgctxt "message"
msgid "06560"
msgstr ""
"Sounds like we should\n"
"have {actor_name:3} learn Reveal,\n"
"don't you think?{end_now}"

msgctxt "message"
msgid "06561"
msgstr ""
"Yeah! I don't want to\n"
"die in any\n"
"evil desert!{end_wait}"

msgctxt "message"
msgid "06562"
msgstr ""
"Oh, come on, {actor_name:1}!\n"
"If we're going to follow\n"
"{actor_name:5}, we'll need Reveal!{end_wait}"

msgctxt "message"
msgid "06563"
msgstr ""
"{actor_name:3}, you should let\n"
"Master Hama teach you\n"
"how to use Reveal.{end_wait}"

msgctxt "message"
msgid "06564"
msgstr ""
"What's wrong,\n"
"Master Hama?{page_break}"
"You{pause_20_skippable} can pass Reveal on\n"
"to me,{pause_20_skippable} can't you?{end_wait}"

msgctxt "message"
msgid "06565"
msgstr ""
"I am{pause_20_skippable} unsure that\n"
"it will work.{end_wait}"

msgctxt "message"
msgid "06566"
msgstr ""
"In preparation for\n"
"this day, I tried to\n"
"pass a power on{page_break}"
"to a young girl,\n"
"although that power\n"
"was not Reveal.{end_wait}"

msgctxt "message"
msgid "06567"
msgstr ""
"My student was\n"
"not an Adept...{end_wait}"

msgctxt "message"
msgid "06568"
msgstr ""
"But I thought anyone could\n"
"hone a skill he or she\n"
"already possessed...{end_wait}"

msgctxt "message"
msgid "06569"
msgstr ""
"However, I saw no\n"
"change in the girl.{end_wait}"

msgctxt "message"
msgid "06570"
msgstr "No! There was change!{end_wait}"

msgctxt "message"
msgid "06571"
msgstr ""
"Feizhi... Why are\n"
"you here?{end_wait}"

msgctxt "message"
msgid "06572"
msgstr "I sensed it!{end_wait}"

msgctxt "message"
msgid "06573"
msgstr ""
"Sensed it? What did\n"
"you sense?{end_wait}"

msgctxt "message"
msgid "06574"
msgstr "Hsu is in great danger!{end_wait}"

msgctxt "message"
msgid "06575"
msgstr ""
"Hsu left this place\n"
"a long time ago.{end_wait}"

msgctxt "message"
msgid "06576"
msgstr ""
"I know...\n"
"But Hsu did not\n"
"return to Xian.{end_wait}"

msgctxt "message"
msgid "06577"
msgstr ""
"...The boulders in the\n"
"mountains!{end_wait}"

msgctxt "message"
msgid "06578"
msgstr ""
"I sensed it. I came\n"
"through the mine.\n"
"I came to ask for help.{end_wait}"

msgctxt "message"
msgid "06579"
msgstr ""
"I sensed nothing, as I\n"
"was focused on {actor_name:1}'s\n"
"arrival...{end_wait}"

msgctxt "message"
msgid "06580"
msgstr ""
"But{pause_20_skippable} why has the power\n"
"come to you now, after\n"
"all this time?{end_wait}"

msgctxt "message"
msgid "06581"
msgstr ""
"Gems fell from the sky.\n"
"One hit me right\n"
"on the head.{end_wait}"

msgctxt "message"
msgid "06582"
msgstr "Gems...{end_wait}"

msgctxt "message"
msgid "06583"
msgstr "Psynergy Stones...{end_wait}"

msgctxt "message"
msgid "06584"
msgstr ""
"Then{pause_20_skippable} this may work\n"
"after all.{end_wait}"

msgctxt "message"
msgid "06585"
msgstr "What about Hsu?{end_wait}"

msgctxt "message"
msgid "06586"
msgstr ""
"Let us hurry to\n"
"Hsu's aid!{end_wait}"

msgctxt "message"
msgid "06587"
msgstr ""
"Master Hama, what about\n"
"us? What about Reveal?{end_wait}"

msgctxt "message"
msgid "06588"
msgstr "I had completely forgotten.{end_wait}"

msgctxt "message"
msgid "06589"
msgstr ""
"It seems I succeeded in\n"
"passing my power to\n"
"Feizhi. You will be fine.{end_wait}"

msgctxt "message"
msgid "06590"
msgstr ""
"This should do it.\n"
"Use Reveal to cross\n"
"the desert.{end_wait}"

msgctxt "message"
msgid "06591"
msgstr ""
"But your Reveal may not\n"
"be that strong yet...\n"
"The oases may not appear.{end_wait}"

msgctxt "message"
msgid "06592"
msgstr ""
"The rest is up to\n"
"{actor_name:3}'s abilities.{end_wait}"

msgctxt "message"
msgid "06593"
msgstr ""
"{actor_name:3}, I am very glad\n"
"to see you have grown to\n"
"be such a strong man.{end_wait}"

msgctxt "message"
msgid "06594"
msgstr ""
"{actor_name:3}, do you and\n"
"Master Hama...\n"
"know each other?{end_wait}"

msgctxt "message"
msgid "06595"
msgstr ""
"No... But she doesn't\n"
"feel like{pause_20_skippable} a stranger...{end_wait}"

msgctxt "message"
msgid "06596"
msgstr ""
"{actor_name:5} and the others\n"
"must be far ahead of\n"
"us by now...{end_now}"

msgctxt "message"
msgid "06597"
msgstr ""
"Then we'd better get\n"
"moving! Let's go!{end_wait}"

msgctxt "message"
msgid "06598"
msgstr ""
"The desert may have\n"
"slowed them down, but\n"
"we can't waste a second!{end_wait}"

msgctxt "message"
msgid "06599"
msgstr ""
"We can't just\n"
"leave like this!{end_wait}"

msgctxt "message"
msgid "06600"
msgstr ""
"Hama might need\n"
"our help...{end_wait}"

msgctxt "message"
msgid "06601"
msgstr ""
"She only has Feizhi\n"
"to assist her.\n"
"Shouldn't we help, too?{end_now}"

msgctxt "message"
msgid "06602"
msgstr ""
"I'm more worried about\n"
"{actor_name:5} and the others...{page_break}"
"But I'm not opposed\n"
"to rescuing Hsu.{end_wait}"

msgctxt "message"
msgid "06603"
msgstr ""
"I am worried about Feizhi\n"
"and Master Hama...{page_break}"
"But I understand why\n"
"you want to chase\n"
"after {actor_name:5}.{end_wait}"

msgctxt "message"
msgid "06604"
msgstr ""
"We'll go with you, {actor_name:1},\n"
"whatever you decide!{end_wait}"

msgctxt "message"
msgid "06605"
msgstr ""
"I wonder what Master\n"
"Hama was talking about...{end_wait}"

msgctxt "message"
msgid "06606"
msgstr ""
"Oh, I'm sorry...\n"
"Let's go.{end_wait}"

msgctxt "MsgMountainHsuOkay"
msgid "06607"
msgstr "Hsu, are you okay?{end_wait}"

msgctxt "message"
msgid "06608"
msgstr ""
"Master Hama, I am okay.\n"
"But the boulder...\n"
"I cannot move.{end_wait}"

msgctxt "message"
msgid "06609"
msgstr ""
"Hsu seems unhurt.\n"
"You must be glad, Feizhi.{end_wait}"

msgctxt "message"
msgid "06610"
msgstr ""
"Yes. Thank you, Master.\n"
"But how can we free him?{end_wait}"

msgctxt "message"
msgid "06611"
msgstr ""
"I{pause_20_skippable} don't know\n"
"what we can do.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleWellIsaacAdeptsYouCameTo"
msgid "06612"
msgstr ""
"Well, {actor_name:1}! Adepts!\n"
"You came to help...{page_break}"
"Hsu is in trouble,\n"
"as you can see.\n"
"What should we do?{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleBeStrongHsuWeWillHelp"
msgid "06613"
msgstr ""
"Be strong, Hsu!\n"
"We will help you!{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleIAmTrappedBetweenTheseTwo"
msgid "06614"
msgstr ""
"I am trapped between\n"
"these two boulders.{page_break}"
"At least I wasn't\n"
"crushed. I was lucky.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleHowShouldWeMoveTheBoulders"
msgid "06615"
msgstr ""
"How should we move\n"
"the boulders?{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleHsuTiresHeLooksExhaustedI"
msgid "06616"
msgstr ""
"Hsu tires. He looks\n"
"exhausted.\n"
"I am worried!{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleIWantToScreamButFeizhi"
msgid "06617"
msgstr ""
"I want to scream.\n"
"But Feizhi does not\n"
"like it when I do that.{end_wait}"

msgctxt "MsgMountainIsaacDidLiftBoulder"
msgid "06618"
msgstr ""
"{actor_name:1}, did you lift\n"
"the boulder?{end_wait}"

msgctxt "message"
msgid "06619"
msgstr ""
"Oh my! The boulder!\n"
"It floats!{end_wait}"

msgctxt "message"
msgid "06620"
msgstr ""
"Quickly, Feizhi. We must\n"
"pull Hsu free!{end_wait}"

msgctxt "message"
msgid "06621"
msgstr ""
"Ready yourself, Hsu.\n"
"I am going to pull.\n"
"One, two, three!{end_wait}"

msgctxt "message"
msgid "06622"
msgstr ""
"He is halfway out.\n"
"Just a little further.{end_wait}"

msgctxt "message"
msgid "06623"
msgstr ""
"Can you hang on just\n"
"a moment longer, {actor_name:1}?{end_now}"

msgctxt "message"
msgid "06624"
msgstr "Thank you, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "06625"
msgstr ""
"You cannot back out now!\n"
"You must be responsible!{end_wait}"

msgctxt "message"
msgid "06626"
msgstr ""
"Ready? I am going to pull!\n"
"One, two, three!{end_wait}"

msgctxt "message"
msgid "06627"
msgstr ""
"We did it! Master Hama,\n"
"Hsu is free!{end_wait}"

msgctxt "message"
msgid "06628"
msgstr "We did it, Feizhi!{end_wait}"

msgctxt "message"
msgid "06629"
msgstr "Thank you, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "06630"
msgstr ""
"We must contact Master\n"
"Feh and ask him to tend\n"
"to Hsu's injuries.{end_wait}"

msgctxt "message"
msgid "06631"
msgstr ""
"I will ask him to clean\n"
"up the rocks, too.{end_wait}"

msgctxt "message"
msgid "06632"
msgstr ""
"Excellent. If Silk Road\n"
"remains blocked,\n"
"everyone will suffer.{end_wait}"

msgctxt "MsgMountainAdeptsLetMeThankAgain"
msgid "06633"
msgstr ""
"Adepts, let me thank you\n"
"again. I am\n"
"truly grateful.{end_wait}"

msgctxt "message"
msgid "06634"
msgstr ""
"I did not expect you\n"
"to come and aid us.{end_wait}"

msgctxt "message"
msgid "06635"
msgstr ""
"No, Master Hama...\n"
"We are the ones who\n"
"should be grateful.{end_wait}"

msgctxt "message"
msgid "06636"
msgstr ""
"Thank you for passing\n"
"the power of Reveal on\n"
"to me...{page_break}"
"But{pause_20_skippable} what you said...{end_wait}"

msgctxt "message"
msgid "06637"
msgstr "What is it, {actor_name:3}?{end_wait}"

msgctxt "message"
msgid "06638"
msgstr ""
"Well, really, I was the\n"
"one who suggested we\n"
"help you,{pause_20_skippable} right?{end_now}"

msgctxt "message"
msgid "06639"
msgstr ""
"What? Didn't you want\n"
"us to hurry on to the\n"
"desert, {actor_name:2}?{end_wait}"

msgctxt "message"
msgid "06640"
msgstr ""
"Did I, {actor_name:4}? Did I really?\n"
"I think you must be{pause_20_skippable}\n"
"mistaken. Yeah, that's it!{end_wait}"

msgctxt "message"
msgid "06641"
msgstr ""
"No, {actor_name:2}...\n"
"You wanted us\n"
"to get moving!{end_wait}"

msgctxt "message"
msgid "06642"
msgstr ""
"{actor_name:1}, {actor_name:4}...\n"
"Don't make me look\n"
"like a fool...{end_wait}"

msgctxt "message"
msgid "06643"
msgstr ""
"Do not worry, {actor_name:2}.\n"
"I do not mind.{end_wait}"

msgctxt "message"
msgid "06644"
msgstr "Travel well, my friends.{end_wait}"

msgctxt "message"
msgid "06645"
msgstr ""
"I hope to see\n"
"you soon.{end_wait}"

msgctxt "message"
msgid "06646"
msgstr ""
"Weren't you going to ask\n"
"Master Hama what she\n"
"meant earlier?{end_wait}"

msgctxt "message"
msgid "06647"
msgstr ""
"We do not know when we\n"
"will be able to see\n"
"Master Hama again.{end_wait}"

msgctxt "message"
msgid "06648"
msgstr ""
"{actor_name:1}, don't you think\n"
"we should ask Master\n"
"Hama what she meant?{end_now}"

msgctxt "message"
msgid "06649"
msgstr ""
"See? If it's bothering\n"
"you, you should just go\n"
"ahead and ask now!{end_wait}"

msgctxt "message"
msgid "06650"
msgstr ""
"Huh? You think we should\n"
"just leave it as is?{end_wait}"

msgctxt "message"
msgid "06651"
msgstr "Thank you, everyone...{end_wait}"

msgctxt "message"
msgid "06652"
msgstr ""
"but it is better\n"
"that we leave now.{end_wait}"

msgctxt "message"
msgid "06653"
msgstr "What do you mean?{end_wait}"

msgctxt "message"
msgid "06654"
msgstr ""
"Master Hama hasn't\n"
"looked me in the eye since\n"
"she said those words.{end_wait}"

msgctxt "message"
msgid "06655"
msgstr ""
"Well, that just makes\n"
"me even more curious!{end_wait}"

msgctxt "message"
msgid "06656"
msgstr ""
"Don't worry about it.\n"
"I doubt she would even\n"
"tell me if I asked.{end_wait}"

msgctxt "message"
msgid "06657"
msgstr "Well, that's just...{end_wait}"

msgctxt "message"
msgid "06658"
msgstr ""
"Master Hama will\n"
"tell me when we have\n"
"completed our mission.{end_wait}"

msgctxt "message"
msgid "06659"
msgstr "I have to believe that...{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleItIsVeryDangerousToCross"
msgid "06660"
msgstr ""
"It is very dangerous to\n"
"cross Lamakan Desert.\n"
"Be very careful!{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleTheEvilDesertIsHotterThan"
msgid "06661"
msgstr ""
"The evil desert is hotter\n"
"than the sun itself.\n"
"Look for oases!{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleIBelieveItIsPossibleTo"
msgid "06662"
msgstr ""
"I believe it is possible\n"
"to learn the power of\n"
"prediction by meditating.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleIWillBeMostThankfulOnce"
msgid "06663"
msgstr ""
"I will be most thankful\n"
"once the evil desert\n"
"returns to normal.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleWhenYourTemperatureReachesItsMaximum"
msgid "06664"
msgstr ""
"When your temperature\n"
"reaches its maximum,{page_break}"
"you will take\n"
"tremendous damage.{page_break}"
"Go quickly, and find\n"
"yourselves an oasis\n"
"when you get too hot.{end_wait}"

msgctxt "MsgFuchinTempleMasterHamaIsMeditatingAskingFor"
msgid "06665"
msgstr ""
"Master Hama is\n"
"meditating, asking for\n"
"your safety.{end_wait}"

msgctxt "MsgFuchinTempleTheFutureHoldsManyHardshipsBut"
msgid "06666"
msgstr ""
"The future holds many\n"
"hardships, but you must\n"
"not give up the fight.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleICannotCrossTheDesertIt"
msgid "06667"
msgstr ""
"I cannot cross the\n"
"desert. It is too\n"
"fearsome for me.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleTheEvilInTheDesertDistorts"
msgid "06668"
msgstr ""
"The evil in the desert\n"
"distorts all{em_dash}even light.\n"
"What could be the cause?{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleHowNiceItWouldBeIf"
msgid "06669"
msgstr ""
"How nice it would be\n"
"if I could see the\n"
"future.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleMasterHamaWillBeVerySad"
msgid "06670"
msgstr ""
"Master Hama will be very\n"
"sad if you are lost\n"
"in the desert.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleWithRevealYouWillFindOases"
msgid "06671"
msgstr ""
"With Reveal, you will find\n"
"oases with your mind,\n"
"not with your eyes.{end_wait}"

msgctxt "MsgFuchinTempleIDoNotThinkMasterHama"
msgid "06672"
msgstr ""
"I do not think Master\n"
"Hama wants {actor_name:3} to go...{end_wait}"

msgctxt "MsgFuchinTempleICannotSeeYourFutureClearly"
msgid "06673"
msgstr ""
"I cannot see your\n"
"future clearly...{page_break}"
"It must be because\n"
"I cannot be impartial\n"
"to it...or to you.{end_wait}"

msgctxt "MsgMountainNorthAltinMineWestLama"
msgid "06674"
msgstr ""
"North: Altin Mine\n"
"West: Lama Temple{end_wait}"

msgctxt "message"
msgid "06675"
msgstr ""
"Agh...{pause_20_skippable} This desert is much\n"
"hotter than I ever\n"
"imagined...{end_wait}"

msgctxt "message"
msgid "06676"
msgstr ""
"Just walking around\n"
"here saps every\n"
"ounce of my strength.{end_wait}"

msgctxt "message"
msgid "06677"
msgstr ""
"I can't stop sweating...{pause_20_skippable}\n"
"I wish I'd brought\n"
"a change of clothes...{end_wait}"

msgctxt "message"
msgid "06678"
msgstr ""
"I'm so thirsty...{pause_20_skippable} Water!{pause_20_skippable}\n"
"I need some water!{end_wait}"

msgctxt "message"
msgid "06679"
msgstr ""
"I can't keep my cool\n"
"when it's this hot...{end_wait}"

msgctxt "message"
msgid "06680"
msgstr ""
"Ew... My clothes are\n"
"drenched in sweat!\n"
"This is gross!{end_wait}"

msgctxt "message"
msgid "06681"
msgstr ""
"Aghh!{pause_20_skippable} I can't stand it!{pause_20_skippable}\n"
"My feet are burning!{end_wait}"

msgctxt "message"
msgid "06682"
msgstr ""
"I can't stand another\n"
"minute of this!\n"
"Where's an oasis?{end_wait}"

msgctxt "message"
msgid "06683"
msgstr ""
"If we don't find an\n"
"oasis soon, I'm gonna\n"
"shrivel up and blow away!{end_wait}"

msgctxt "MsgXianImTravelingAroundWorldSpread"
msgid "06684"
msgstr ""
"I'm traveling around\n"
"the world to spread\n"
"good will.{end_wait}"

msgctxt "MsgFuchinTempleSinceImHereIdLikeTo"
msgid "06685"
msgstr ""
"Since I'm here, I'd like\n"
"to learn the secrets\n"
"of Fuchin Temple,{page_break}"
"but that won't happen\n"
"unless I undergo\n"
"intense training.{end_wait}"

msgctxt "MsgMountainAmTravelingAroundWorldSpread"
msgid "06686"
msgstr ""
"I am traveling around\n"
"the world to spread\n"
"good will.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleForSomeReasonThesePeopleGive"
msgid "06687"
msgstr ""
"For some reason, these\n"
"people give me the\n"
"same feeling I got{page_break}"
"from the master of\n"
"the temple, Master Hama.{page_break}"
"Yes... I feel as though\n"
"my mind is being\n"
"read somehow...{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleWeMovedTheRocksNowPeople"
msgid "06688"
msgstr ""
"We moved the rocks.\n"
"Now people can pass.{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleManyPeopleFromXianHelpedMove"
msgid "06689"
msgstr ""
"Many people from Xian\n"
"helped move the rocks.\n"
"They were very heavy!{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleWeClearedTheWayButWhat"
msgid "06690"
msgstr ""
"We cleared the way.\n"
"But what about these\n"
"rocks? Must we{page_break}"
"clear these?{end_wait}"

msgctxt "MsgAlpineCrossingLamaTempleIAlmostHurtMyBackIt"
msgid "06691"
msgstr ""
"I almost hurt my back.\n"
"It is because I have\n"
"not been training.{end_wait}"

msgctxt "MsgXianXianIsAPeacefulVillageBut"
msgid "06692"
msgstr ""
"Xian is a peaceful\n"
"village, but we have had\n"
"trouble lately.{page_break}"
"Hsu is Master Feh's\n"
"apprentice. He was\n"
"trapped under a boulder.{end_wait}"

msgctxt "MsgXianThereWasARockslideOnSilk"
msgid "06693"
msgstr ""
"There was a rockslide on\n"
"Silk Road. It had\n"
"us all in shock.{end_wait}"

msgctxt "MsgXianIWentToHelpMoveBoulders"
msgid "06694"
msgstr ""
"I went to help move\n"
"boulders...\n"
"Now, my back hurts.{end_wait}"

msgctxt "MsgXianThePeopleWhoClearedTheRockslide"
msgid "06695"
msgstr ""
"The people who cleared\n"
"the rockslide told me\n"
"Lamakan Desert is red.{page_break}"
"Why is it red?{end_wait}"

msgctxt "MsgXianHsuIsVeryGoodAtKung"
msgid "06696"
msgstr ""
"Hsu is very good at\n"
"kung fu, but boulders are\n"
"very hard.{page_break}"
"Kung fu is no good\n"
"against boulders.{end_wait}"

msgctxt "MsgXianThePeopleOfXianLoveTheir"
msgid "06697"
msgstr ""
"The people of Xian love\n"
"their village. They almost\n"
"never leave it.{page_break}"
"But everyone left town\n"
"to help clear the rocks\n"
"off Silk Road.{end_wait}"

msgctxt "MsgXianAltinWasFloodedWithWaterBut"
msgid "06698"
msgstr ""
"Altin was flooded with\n"
"water, but young warriors\n"
"fixed it. Feizhi said so.{end_wait}"

msgctxt "MsgXianWeClearedTheRocksFromSilk"
msgid "06699"
msgstr ""
"We cleared the rocks\n"
"from Silk Road. It was\n"
"very hard work.{end_wait}"

msgctxt "MsgXianManyStrangeThingsHappenedAllAt"
msgid "06700"
msgstr ""
"Many strange things\n"
"happened all at once.\n"
"What is going on?{end_wait}"

msgctxt "MsgXianHsuWasCaughtUnderABoulder"
msgid "06701"
msgstr ""
"Hsu was caught under\n"
"a boulder, but he only\n"
"broke one leg.{end_wait}"

msgctxt "MsgXianTheRocksThereWereVeryHard"
msgid "06702"
msgstr ""
"The rocks there were\n"
"very hard. Why did they\n"
"fall? It seems strange.{end_wait}"

msgctxt "MsgXianSomePeopleDidNotCarryRocks"
msgid "06703"
msgstr ""
"Some people did not carry\n"
"rocks. I thought we\n"
"would cooperate.{page_break}"
"I was foolish.{end_wait}"

msgctxt "MsgXianSandIsTheColorOfThe"
msgid "06704"
msgstr ""
"Sand is the color of\n"
"the camel. Red sand\n"
"is very strange.{end_wait}"

msgctxt "MsgXianHsuIsStrongHeadedHeWould"
msgid "06705"
msgstr ""
"Hsu is strong-headed.\n"
"He would not run from\n"
"falling boulders.{page_break}"
"That is what happened.{end_wait}"

msgctxt "MsgXianEveryoneStaysInXianTheyDo"
msgid "06706"
msgstr ""
"Everyone stays in Xian.\n"
"They do not know about\n"
"the outside world.{end_wait}"

msgctxt "MsgXianThisWarriorSavedAltinVillageNo"
msgid "06707"
msgstr ""
"This warrior saved Altin\n"
"village, no?{end_wait}"

msgctxt "MsgXianItIsBadForXianIf"
msgid "06708"
msgstr ""
"It is bad for Xian if\n"
"rocks stay there.{page_break}"
"Caravans cannot pass.\n"
"Silk merchants cannot\n"
"come to Xian.{end_wait}"

msgctxt "MsgXianIWasHappyToSeeGems"
msgid "06709"
msgstr ""
"I was happy to see\n"
"gems falling from the sky,\n"
"but it was very strange.{page_break}"
"I could sense bad\n"
"things coming.{end_wait}"

msgctxt "MsgXianWhereAreTheMerchantsNoOne"
msgid "06710"
msgstr ""
"Where are the merchants?\n"
"No one comes. I hope\n"
"they come buy silk.{end_wait}"

msgctxt "MsgXianInteriorsMerchantsBringUsCoinsTheyMust"
msgid "06711"
msgstr ""
"Merchants bring us coins.\n"
"They must bring\n"
"them soon.{page_break}"
"We need them to buy\n"
"food for winter.{end_wait}"

msgctxt "MsgXianInteriorsWhyDoesMasterHammetNotCome"
msgid "06712"
msgstr ""
"Why does Master Hammet\n"
"not come? We need him.{end_wait}"

msgctxt "MsgXianInteriorsMerchantsSellSilkItIsLike"
msgid "06713"
msgstr ""
"Merchants sell silk. It is\n"
"like a carnival. It\n"
"will be sad to miss it.{end_wait}"

msgctxt "MsgXianSomethingWrongOnSilkRoad"
msgid "06714"
msgstr ""
"Is something wrong on\n"
"Silk Road? In Lamakan\n"
"Desert, too?{end_now}"

msgctxt "message"
msgid "06715"
msgstr ""
"That is terrible. No one\n"
"can use Silk Road!{end_wait}"

msgctxt "message"
msgid "06716"
msgstr ""
"The desert is fine?\n"
"That is good to hear.{end_wait}"

msgctxt "MsgXianInteriorsNoneCanPassThroughLamakanThis"
msgid "06717"
msgstr ""
"None can pass through\n"
"Lamakan. This is very,\n"
"very sad.{end_wait}"

msgctxt "MsgXianInteriorsFeizhiSaidTheDesertBecameEvil"
msgid "06718"
msgstr ""
"Feizhi said the desert\n"
"became evil.{end_wait}"

msgctxt "MsgXianInteriorsTheDesertWasVeryHotNow"
msgid "06719"
msgstr ""
"The desert was very hot.\n"
"Now it is hotter...\n"
"No one can survive it.{end_wait}"

msgctxt "MsgXianDidMonstersInAltinSpit"
msgid "06720"
msgstr ""
"Did the monsters in\n"
"Altin spit water?{end_now}"

msgctxt "message"
msgid "06721"
msgstr ""
"The town was flooded by\n"
"monsters? That takes\n"
"much water. How strange!{end_wait}"

msgctxt "message"
msgid "06722"
msgstr ""
"It is not true?\n"
"But why would Feizhi lie?{end_wait}"

msgctxt "MsgXianInteriorsTheMineInAltinFilledWith"
msgid "06723"
msgstr ""
"The mine in Altin filled\n"
"with water. I wanted\n"
"to see it.{end_wait}"

msgctxt "MsgXianInteriorsTheVillageIsFloodedBecauseOf"
msgid "06724"
msgstr ""
"The village is flooded?\n"
"Because of monsters?{page_break}"
"I am very confused...{end_wait}"

msgctxt "MsgXianInteriorsWaterMonstersHowTerribleForAltin"
msgid "06725"
msgstr ""
"Water monsters... How\n"
"terrible for Altin.{page_break}"
"But Xian has Master Feh.\n"
"He will defeat them.{end_wait}"

msgctxt "MsgXianHsusInjuryTaughtGoodLesson"
msgid "06726"
msgstr ""
"Hsu's injury taught a\n"
"good lesson.{page_break}"
"Even kung fu is no\n"
"good against boulders.{end_wait}"

msgctxt "MsgXianInteriorsHsuWasPummeledByHugeBoulders"
msgid "06727"
msgstr ""
"Hsu was pummeled by\n"
"huge boulders. His\n"
"injuries are not serious.{page_break}"
"Kung fu helped him.{end_wait}"

msgctxt "MsgXianKungFuMakesQuickDoes"
msgid "06728"
msgstr ""
"Kung fu makes you quick,\n"
"does it not?{page_break}"
"Even so, Hsu could not\n"
"outrun the falling rocks.{end_wait}"

msgctxt "MsgXianInteriorsWeShouldSellArmorToKung"
msgid "06729"
msgstr ""
"We should sell armor\n"
"to kung fu masters,\n"
"as well.{end_wait}"

msgctxt "MsgXianDoPlanCrossDesertWarrior"
msgid "06730"
msgstr ""
"Do you plan to cross\n"
"the desert, warrior?{end_now}"

msgctxt "message"
msgid "06731"
msgstr ""
"It will take much\n"
"strength. Perhaps you\n"
"should buy many supplies.{end_wait}"

msgctxt "message"
msgid "06732"
msgstr ""
"You are wise, warrior.\n"
"The wise man knows to\n"
"avoid danger.{end_wait}"

msgctxt "MsgXianInteriorsYouLoseStrengthInHeatUse"
msgid "06733"
msgstr ""
"You lose strength in heat.\n"
"Use my goods to recover\n"
"your strength.{end_wait}"

msgctxt "MsgXianWeHaveFewCustomersThese"
msgid "06734"
msgstr ""
"We have few customers\n"
"these days.{page_break}"
"Customers can't come\n"
"if Silk Road is\n"
"completely blocked.{end_wait}"

msgctxt "MsgXianInteriorsWhenLamakanDesertBurnsItIs"
msgid "06735"
msgstr ""
"When Lamakan Desert\n"
"burns, it is bad\n"
"for Xian.{page_break}"
"Xian cannot sell silk.\n"
"The villagers cannot\n"
"survive winter.{end_wait}"

msgctxt "MsgXianInteriorsHotFoodIsGoodForCrossing"
msgid "06736"
msgstr ""
"Hot food is good for\n"
"crossing Lamakan Desert.{page_break}"
"Hot food brings back\n"
"your appetite.{end_wait}"

msgctxt "MsgXianInteriorsCaravansCannotBringMerchantsHereWhen"
msgid "06737"
msgstr ""
"Caravans cannot bring\n"
"merchants here when\n"
"boulders block the road.{end_wait}"

msgctxt "MsgXianInteriorsTheMerchantsDoNotComeBecause"
msgid "06738"
msgstr ""
"The merchants do not\n"
"come, because the Lamakan\n"
"Desert burns.{page_break}"
"It is bad for business.{end_wait}"

msgctxt "MsgXianInteriorsEatWarriorIWillAddMany"
msgid "06739"
msgstr ""
"Eat, warrior. I will add\n"
"many hot peppers and\n"
"savory spices.{end_wait}"

msgctxt "message"
msgid "06740"
msgstr ""
"Mogall Prairie is now a\n"
"forest, and Lamakan is\n"
"an evil desert.{page_break}"
"We cannot go anywhere\n"
"from here now.{end_wait}"

msgctxt "message"
msgid "06741"
msgstr ""
"If I cannot go east or\n"
"west, I will have to stay\n"
"in Xian until I die.{end_wait}"

msgctxt "MsgFuchinTempleThisIsMasterFehsKungFu"
msgid "06742"
msgstr ""
"This is Master Feh's\n"
"kung fu school.{page_break}"
"Studying martial arts\n"
"keeps Xian peaceful.{end_wait}"

msgctxt "MsgFuchinTempleBouldersOvercameHsuKungFuShould"
msgid "06743"
msgstr ""
"Boulders overcame Hsu.\n"
"Kung fu should never\n"
"be overcome.{page_break}"
"We have to practice more.{end_wait}"

msgctxt "MsgXianWaterMonstersFloodedAltinDid"
msgid "06744"
msgstr ""
"Water monsters flooded\n"
"Altin. Did you defeat\n"
"them, warrior?{end_now}"

msgctxt "message"
msgid "06745"
msgstr ""
"You are much stronger\n"
"than you look, warrior.{page_break}"
"I have much respect\n"
"for you now.{end_wait}"

msgctxt "message"
msgid "06746"
msgstr ""
"Oh... You are not the\n"
"strong warrior Feizhi\n"
"spoke of?{end_wait}"

msgctxt "MsgXianHsuDidNotPracticeJumping"
msgid "06747"
msgstr ""
"Hsu did not practice\n"
"jumping enough.{page_break}"
"He could have dodged\n"
"boulders by jumping.{end_wait}"

msgctxt "MsgFuchinTempleFeizhiPredictedHsusDangerHerProphecy"
msgid "06748"
msgstr ""
"Feizhi predicted Hsu's\n"
"danger. Her prophecy\n"
"came true...{page_break}"
"That saved Hsu. Now\n"
"he has returned.\n"
"It is quite odd.{end_wait}"

msgctxt "MsgFuchinTempleHsuIsRestingFeizhiIsWatching"
msgid "06749"
msgstr ""
"Hsu is resting. Feizhi\n"
"is watching over him. They\n"
"will be glad to see you.{end_wait}"

msgctxt "MsgFuchinTemplePeaceHasReturnedToXianBut"
msgid "06750"
msgstr ""
"Peace has returned to\n"
"Xian, but danger still\n"
"lurks both east and west.{end_wait}"

msgctxt "MsgFuchinTempleNoMatterHowMuchYouPractice"
msgid "06751"
msgstr ""
"No matter how much you\n"
"practice your kicks,{page_break}"
"your feet will never\n"
"be harder than a boulder.{end_wait}"

msgctxt "MsgFuchinTempleTheMonstersAreVeryLargeStriking"
msgid "06752"
msgstr ""
"The monsters are very\n"
"large. Striking one would\n"
"hurt your hand.{page_break}"
"Should we train with\n"
"weapons, perhaps?{end_wait}"

msgctxt "MsgFuchinTempleWhenABoulderFallsJumpRepeat"
msgid "06753"
msgstr ""
"When a boulder falls,\n"
"jump. Repeat as needed.\n"
"That is all it takes.{end_wait}"

msgctxt "MsgFuchinTempleWhereDidFeizhiGainThePower"
msgid "06754"
msgstr ""
"Where did Feizhi gain the\n"
"power to foresee trouble?\n"
"I want it, too.{end_wait}"

msgctxt "MsgFuchinTempleMasterFehIsVeryWorriedAbout"
msgid "06755"
msgstr ""
"Master Feh is very\n"
"worried about\n"
"those two.{end_wait}"

msgctxt "MsgXianWarriorWelcome"
msgid "06756"
msgstr "Oh, warrior! Welcome!{end_wait}"

msgctxt "message"
msgid "06757"
msgstr ""
"Hsu was saved, thanks\n"
"to you and Master Hama.{page_break}"
"You have my deepest\n"
"gratitude.{end_wait}"

msgctxt "MsgXianInteriorsIWasInjuredByRocksOn"
msgid "06758"
msgstr ""
"I was injured by rocks\n"
"on my way from\n"
"Lama Temple.{page_break}"
"I am sad my training\n"
"could not help me.{end_wait}"

msgctxt "MsgXianInteriorsFeizhisPredictionCameTrueNowI"
msgid "06759"
msgstr ""
"Feizhi's prediction\n"
"came true.{page_break}"
"Now, I believe she\n"
"can foresee things.{end_wait}"

msgctxt "MsgXianInteriorsMasterHamaHasGreatPowerYou"
msgid "06760"
msgstr ""
"Master Hama has great\n"
"power. You do, too,\n"
"young warrior.{page_break}"
"You are both amazing.{end_wait}"

msgctxt "MsgXianInteriorsIKnewHelpWouldComeWhen"
msgid "06761"
msgstr ""
"I knew help would come\n"
"when I was trapped.\n"
"I must thank everyone.{end_wait}"

msgctxt "MsgXianInteriorsFeizhisAbilityToSenseTroubleIs"
msgid "06762"
msgstr ""
"Feizhi's ability to sense\n"
"trouble is real. I am\n"
"quite surprised.{end_wait}"

msgctxt "MsgXianInteriorsHsuWasTrappedUnderTheRocks"
msgid "06763"
msgstr ""
"Hsu was trapped under\n"
"the rocks, but he was\n"
"all right.{page_break}"
"We have Master Hama to\n"
"thank for that.{end_wait}"

msgctxt "MsgXianInteriorsIWasInjuredByBouldersOn"
msgid "06764"
msgstr ""
"I was injured by boulders\n"
"on my way from\n"
"Lama Temple.{page_break}"
"I am sad my training\n"
"could not help me.{end_wait}"

msgctxt "MsgXianInteriorsFeizhisPredictionCameTrueNowIBelieve"
msgid "06765"
msgstr ""
"Feizhi's prediction\n"
"came true.{page_break}"
"Now, I believe she\n"
"can foresee things.{end_wait}"

msgctxt "MsgXianInteriorsMasterHamaHasGreatPowerSome"
msgid "06766"
msgstr ""
"Master Hama has great\n"
"power. Some was passed\n"
"on to me.{page_break}"
"I am quite happy.{end_wait}"

msgctxt "MsgXianInteriorsIKnewHelpWouldComeWhenI"
msgid "06767"
msgstr ""
"I knew help would come\n"
"when I was trapped.\n"
"I must thank everyone.{end_wait}"

msgctxt "MsgXianInteriorsFeizhisAbilityToForeseeIsReal"
msgid "06768"
msgstr ""
"Feizhi's ability to foresee\n"
"is real. I am\n"
"quite surprised.{end_wait}"

msgctxt "MsgKalayWelcomeInPeace"
msgid "06769"
msgstr ""
"Welcome to Kalay! You\n"
"may enter, so long as you\n"
"do not disrupt the peace.{end_wait}"

msgctxt "MsgKalaySoldiersProtectPeace"
msgid "06770"
msgstr ""
"We soldiers protect\n"
"the peace in Kalay with\n"
"our lives.{end_wait}"

msgctxt "MsgKalayHammetGenerousMerchant"
msgid "06771"
msgstr ""
"Lord Hammet, the\n"
"founder of Kalay, is a\n"
"great merchant.{end_wait}"

msgctxt "MsgKalayHammetOnJourney"
msgid "06772"
msgstr ""
"Lord Hammet is still out\n"
"with his caravans\n"
"on business.{page_break}"
"I wonder where he\n"
"could be now.{end_wait}"

msgctxt "MsgKalayNorthernBridgeRebuilt"
msgid "06773"
msgstr ""
"The bridge to the north\n"
"was destroyed by lava.{page_break}"
"Thankfully, it has been\n"
"rebuilt since then.{end_wait}"

msgctxt "MsgKalayLamakanTrouble"
msgid "06774"
msgstr ""
"I heard a rumor that\n"
"there's trouble in\n"
"Lamakan Desert.{end_wait}"

msgctxt "MsgKalayElderTownNews"
msgid "06775"
msgstr ""
"Kalay sits at a great\n"
"crossroads. Xian lies\n"
"east, and Tolbi west.{page_break}"
"This is the perfect\n"
"place to do business.{end_wait}"

msgctxt "MsgKalayInnFestivalTourists"
msgid "06776"
msgstr ""
"The guests at the inn\n"
"are tourists on their\n"
"way to see Colosso.{page_break}"
"It seems like a lot of\n"
"hassle to travel to Tolbi\n"
"just for a carnival.{end_wait}"

msgctxt "MsgKalayChildWantsFestival"
msgid "06777"
msgstr ""
"I hear Colosso is\n"
"incredible. I'd love to see\n"
"such a huge carnival.{end_wait}"

msgctxt "MsgKalayTraderTownNews"
msgid "06778"
msgstr ""
"A huge mountain north\n"
"of the river erupted\n"
"violently.{page_break}"
"I think it was\n"
"called Mt. Aleph.{end_wait}"

msgctxt "MsgKalayHammetBusinessSkill"
msgid "06779"
msgstr ""
"Lord Hammet's knack for\n"
"business is the reason\n"
"Kalay has flourished.{end_wait}"

msgctxt "MsgKalayCameKalayBecauseDidntLike"
msgid "06780"
msgstr ""
"I came to Kalay because\n"
"I didn't like Tolbi...\n"
"You want to know why?{end_now}"

msgctxt "message"
msgid "06781"
msgstr ""
"Because Babi, the ruler\n"
"of Tolbi, frightens me.{page_break}"
"He has ruled Tolbi for\n"
"more than a hundred\n"
"years, they say.{end_wait}"

msgctxt "message"
msgid "06782"
msgstr ""
"Kalay is a much better\n"
"town than Tolbi.\n"
"I won't go back.{end_wait}"

msgctxt "MsgKalayHammetCapturedRumor"
msgid "06783"
msgstr ""
"I can't put the rumors\n"
"about Lord Hammet being\n"
"captured by thieves{page_break}"
"out of my head... But the\n"
"lord's wife, Layana,\n"
"speaks little of it.{end_wait}"

msgctxt "MsgKalayHammetWentNorth"
msgid "06784"
msgstr ""
"People say Lord Hammet\n"
"went north from Vault\n"
"after Mt. Aleph erupted.{page_break}"
"No one knows what\n"
"happened to him or his\n"
"caravan after that.{end_wait}"

msgctxt "MsgKalayWarriorHonestEyes"
msgid "06785"
msgstr ""
"Hmm... This young warrior\n"
"has honest eyes and a\n"
"good demeanor.{page_break}"
"A man like that is\n"
"never evil.{end_wait}"

msgctxt "MsgKalayGuardsJudgeVisitors"
msgid "06786"
msgstr ""
"Our job requires us to\n"
"judge whether to allow\n"
"a visitor into Kalay.{end_wait}"

msgctxt "MsgKalayHammetPeaceAndLiberty"
msgid "06787"
msgstr ""
"Lord Hammet's love for\n"
"liberty and peace gave\n"
"birth to this town.{end_wait}"

msgctxt "MsgKalayHammetCanBeRash"
msgid "06788"
msgstr ""
"Despite his appearance,\n"
"Lord Hammet can be\n"
"very rash.{page_break}"
"That's why I'm worried.{end_wait}"

msgctxt "MsgKalaySoldiersWentToVault"
msgid "06789"
msgstr ""
"Lord Hammet's soldiers\n"
"went to Vault after\n"
"the bridge was rebuilt.{page_break}"
"The palace has been\n"
"very quiet ever since...{end_wait}"

msgctxt "MsgKalayStrangeEvents"
msgid "06790"
msgstr ""
"Strange things have been\n"
"happening all across the\n"
"land lately...{page_break}"
"What is the\n"
"world coming to?{end_wait}"

msgctxt "MsgKalayElderThoughts"
msgid "06791"
msgstr ""
"Hammet chose to build\n"
"Kalay here because it's in\n"
"a prime trading location.{page_break}"
"Lord Hammet truly is\n"
"a smart man.{end_wait}"

msgctxt "MsgKalayWishSavedForFestival"
msgid "06792"
msgstr ""
"Actually... I wish I\n"
"were going to Colosso.{page_break}"
"I should have saved\n"
"my money. Then I'd be\n"
"on that tour, too.{end_wait}"

msgctxt "MsgKalayChildFestivalDream"
msgid "06793"
msgstr ""
"Maybe when I'm older,\n"
"I'll even get to go\n"
"fight in Colosso!{end_wait}"

msgctxt "MsgKalayTraderThoughts"
msgid "06794"
msgstr ""
"During the volcano's\n"
"eruption, odd gems and\n"
"rocks fell from the sky.{end_wait}"

msgctxt "MsgKalayHammetValuesTrust"
msgid "06795"
msgstr ""
"Lord Hammet is a very\n"
"honest man, who values\n"
"trust above all.{page_break}"
"That's probably why\n"
"he's so respected.{end_wait}"

msgctxt "MsgKalayTrustAgainstForce"
msgid "06796"
msgstr ""
"The difference between\n"
"Kalay and Tolbi\n"
"is their leaders.{page_break}"
"Lord Hammet rules with\n"
"trust, while Lord Babi\n"
"rules with force.{end_wait}"

msgctxt "MsgKalayLunpaNorthOfVault"
msgid "06797"
msgstr ""
"I had no idea that Lunpa\n"
"was just north of Vault.{page_break}"
"It's funny that a city\n"
"of merchants would be so\n"
"close to a city of thieves.{end_wait}"

msgctxt "MsgKalayRumorsHideTruth"
msgid "06798"
msgstr ""
"There are so many\n"
"rumors now, no one knows\n"
"what the truth is.{end_wait}"

msgctxt "MsgKalayCanLiveInPeaceIn"
msgid "06799"
msgstr ""
"You can live in peace in\n"
"Kalay, as long as you\n"
"practice good will.{end_wait}"

msgctxt "MsgKalayInteriorsICameHereToSpreadGood"
msgid "06800"
msgstr ""
"I came here to spread\n"
"good will...{page_break}"
"But Lord Hammet seems\n"
"to be the source of all\n"
"their good will.{page_break}"
"This is not good...{end_wait}"

msgctxt "MsgKalayOkListeningLets"
msgid "06801"
msgstr ""
"OK!{pause_20_skippable} Are we all\n"
"listening? Let's stop\n"
"right here.{end_wait}"

msgctxt "MsgKalayWhyWeStoppingAtPlace"
msgid "06802"
msgstr ""
"Why are we stopping\n"
"at a place like this?{end_wait}"

msgctxt "message"
msgid "06803"
msgstr ""
"Yeah!{pause_20_skippable} We have to hurry,\n"
"or we'll be late\n"
"for Colosso!{end_wait}"

msgctxt "message"
msgid "06804"
msgstr ""
"Late for Colosso?\n"
"We can't have that!{end_wait}"

msgctxt "message"
msgid "06805"
msgstr "That won't do at all!{end_wait}"

msgctxt "message"
msgid "06806"
msgstr ""
"We paid good money to\n"
"see Colosso!\n"
"We can't be late!{end_wait}"

msgctxt "message"
msgid "06807"
msgstr ""
"Everything will be just\n"
"fine, folks!{end_wait}"

msgctxt "message"
msgid "06808"
msgstr ""
"We're just checking\n"
"to make sure no one\n"
"is missing!{end_wait}"

msgctxt "message"
msgid "06809"
msgstr "Well, I guess that's OK...{end_wait}"

msgctxt "message"
msgid "06810"
msgstr ""
"But if anyone is\n"
"missing, we're the one's\n"
"who'll miss out.{end_wait}"

msgctxt "message"
msgid "06811"
msgstr ""
"Forget about them!\n"
"Let's just get a move on!{end_wait}"

msgctxt "message"
msgid "06812"
msgstr "Oh, dear...{end_wait}"

msgctxt "message"
msgid "06813"
msgstr ""
"All right, hurry up\n"
"and start counting!{end_wait}"

msgctxt "MsgKalayShortOnePerson"
msgid "06814"
msgstr ""
"Uh-oh... We're short one\n"
"person... Now where\n"
"could he be?{end_wait}"

msgctxt "message"
msgid "06815"
msgstr ""
"What's going on?\n"
"Why aren't we leaving\n"
"for Tolbi yet?{end_wait}"

msgctxt "message"
msgid "06816"
msgstr ""
"There are a lot of\n"
"people waiting to see\n"
"Colosso, here!{end_wait}"

msgctxt "message"
msgid "06817"
msgstr ""
"Hey? What's up? Why are\n"
"the guides pacing\n"
"back and forth?{end_wait}"

msgctxt "MsgKalayDecideEnteringColosso"
msgid "06818"
msgstr ""
"We have to decide if\n"
"we're entering Colosso\n"
"once we reach Tolbi.{end_wait}"

msgctxt "message"
msgid "06819"
msgstr ""
"I hear there was a\n"
"landslide on the road\n"
"to Tolbi.{page_break}"
"We paid good money to\n"
"take this cruise to\n"
"see Colosso!{end_wait}"

msgctxt "message"
msgid "06820"
msgstr ""
"Come on! Why aren't\n"
"we leaving yet?{end_wait}"

msgctxt "message"
msgid "06821"
msgstr ""
"Right when we're leaving,\n"
"they tell us we have\n"
"to ride a boat?{page_break}"
"I can't stand boats...{pause_20_skippable}\n"
"If I had known,\n"
"I never would have come.{end_wait}"

msgctxt "message"
msgid "06822"
msgstr ""
"It's just a shame a\n"
"man like you can't ride\n"
"on a boat, Ouranos.{end_wait}"

msgctxt "message"
msgid "06823"
msgstr ""
"That's odd. No matter\n"
"how many times I count,\n"
"we're still one short.{end_wait}"

msgctxt "message"
msgid "06824"
msgstr ""
"I counted everyone at\n"
"the inn... So where\n"
"did we lose him?{end_wait}"

msgctxt "message"
msgid "06825"
msgstr ""
"Who's missing? Come on,\n"
"we're all waiting!{end_wait}"

msgctxt "message"
msgid "06826"
msgstr ""
"There are a lot of\n"
"people taking the tour\n"
"to Tolbi this year.{end_wait}"

msgctxt "message"
msgid "06827"
msgstr ""
"Can't we just forget\n"
"about that missing guy\n"
"and get moving!?{end_wait}"

msgctxt "message"
msgid "06828"
msgstr ""
"With so many going to\n"
"Tolbi, I'm sure a few of\n"
"them are entering Colosso.{end_wait}"

msgctxt "message"
msgid "06829"
msgstr ""
"I'm a little worried, with\n"
"all these strange things\n"
"happening everywhere!{end_wait}"

msgctxt "message"
msgid "06830"
msgstr ""
"This an embarassment!\n"
"Waiting around after\n"
"announcing we're leaving!{end_wait}"

msgctxt "message"
msgid "06831"
msgstr ""
"I'm embarrassed to say\n"
"this, but I can't swim.{page_break}"
"What am I going to do\n"
"if the boat capsizes...{end_wait}"

msgctxt "message"
msgid "06832"
msgstr ""
"That's why I've been\n"
"telling you I'd teach\n"
"you how to swim...{end_wait}"

msgctxt "message"
msgid "06833"
msgstr ""
"Maybe I should go check\n"
"and see if he's still at\n"
"the inn. What should I do?{end_wait}"

msgctxt "MsgKalayThatsWeCantWaitAny"
msgid "06834"
msgstr ""
"That's it... {pause_20_skippable}We can't\n"
"wait any longer!{end_wait}"

msgctxt "message"
msgid "06835"
msgstr ""
"Can't wait? What do\n"
"you mean?{end_wait}"

msgctxt "message"
msgid "06836"
msgstr ""
"We all knew that anyone\n"
"who was late would be\n"
"left behind, right?{end_wait}"

msgctxt "message"
msgid "06837"
msgstr "Everyone understood that.{end_wait}"

msgctxt "message"
msgid "06838"
msgstr ""
"Then what's the problem?{pause_20_skippable}\n"
"We'll miss the boat if\n"
"we wait any longer!{end_wait}"

msgctxt "message"
msgid "06839"
msgstr ""
"Miss the boat?{pause_20_skippable}\n"
"We can't let that happen!{end_wait}"

msgctxt "message"
msgid "06840"
msgstr ""
"We paid a lot of money...{page_break}"
"We have to arrive\n"
"before the\n"
"carnival starts!{end_wait}"

msgctxt "message"
msgid "06841"
msgstr ""
"There's nothing we can\n"
"do...{pause_20_skippable}{pause_20_skippable} Let's go!{end_wait}"

msgctxt "message"
msgid "06842"
msgstr "Yeah! Let's go!{end_wait}"

msgctxt "message"
msgid "06843"
msgstr ""
"OK...{pause_20_skippable} Follow me, and\n"
"stay in line!{end_wait}"

msgctxt "message"
msgid "06844"
msgstr ""
"Hmm... {pause_20_skippable}Now where did my\n"
"tour group get to...?{end_wait}"

msgctxt "message"
msgid "06845"
msgstr ""
"No! They wouldn't have\n"
"left without me{pause_20_skippable}{pause_20_skippable},\n"
"would they?{end_wait}"

msgctxt "message"
msgid "06846"
msgstr ""
"Oh, no! I'd better\n"
"get moving!{end_wait}"

msgctxt "MsgKalayInteriorsImShockedToHearTheRighteous"
msgid "06847"
msgstr ""
"I'm shocked to hear the\n"
"righteous thieves of\n"
"Lunpa have gone bad.{page_break}"
"They say Lunpa's grandson\n"
"is responsible for it.{end_wait}"

msgctxt "MsgKalayInteriorsLunpaWasAKindThiefHis"
msgid "06848"
msgstr ""
"Lunpa was a kind thief.\n"
"His son is Donpa{em_dash}he's\n"
"an honorable thief, too.{page_break}"
"He stole, but he was\n"
"just. Lunpa's grandson,\n"
"Dodonpa, is another story.{page_break}"
"He doesn't even\n"
"think twice about\n"
"doing evil...{end_wait}"

msgctxt "MsgKalayInteriorsTheRegionNorthOfVaultWas"
msgid "06849"
msgstr ""
"The region north of Vault\n"
"was once a safe place...{page_break}"
"but nowadays it is\n"
"very dangerous.{end_wait}"

msgctxt "MsgKalayInteriorsLunpasReputationIsVeryBadNowadays"
msgid "06850"
msgstr ""
"Lunpa's reputation is\n"
"very bad nowadays.{end_wait}"

msgctxt "MsgKalayInteriorsSomehowTheNorthHasBecomeThe"
msgid "06851"
msgstr ""
"Somehow, the north has\n"
"become the center of\n"
"much attention lately.{page_break}"
"Why is that?{end_wait}"

msgctxt "MsgKalayInteriorsAMerchantFromVaultHadBeen"
msgid "06852"
msgstr ""
"A merchant from Vault\n"
"had been saying many\n"
"things about the north...{page_break}"
"Then the soldiers came\n"
"and took him to\n"
"Lord Hammet's Palace.{end_wait}"

msgctxt "MsgKalayInteriorsThreeYearsAgoThievesRaidedMt"
msgid "06853"
msgstr ""
"Three years ago, thieves\n"
"raided Mt. Aleph...\n"
"It was quite a story.{page_break}"
"Ever since, the north\n"
"lost its reputation for\n"
"being a safe place.{end_wait}"

msgctxt "MsgKalayInteriorsTheySayOtherNorthernPartsAre"
msgid "06854"
msgstr ""
"They say other northern\n"
"parts are dangerous too.{page_break}"
"Maybe our town is the\n"
"only place that's\n"
"still safe.{end_wait}"

msgctxt "MsgKalayInteriorsNoOneIsAllowedToGo"
msgid "06855"
msgstr ""
"No one is allowed to go\n"
"to Vault, even though the\n"
"bridge has been rebuilt.{page_break}"
"But I doubt it's\n"
"because of the eruption\n"
"of Mt. Aleph.{end_wait}"

msgctxt "MsgKalayInteriorsIDoNotWantMySon"
msgid "06856"
msgstr ""
"I do not want my son\n"
"to face any danger.{page_break}"
"I am actually grateful\n"
"for Lady Layana's orders.{end_wait}"

msgctxt "MsgKalayInteriorsImAnAdultNowIDont"
msgid "06857"
msgstr ""
"I'm an adult, now.\n"
"I don't want my father\n"
"ordering me around...{end_wait}"

msgctxt "MsgKalayInteriorsIDontCareHowMySon"
msgid "06858"
msgstr ""
"I don't care how my son\n"
"feels. I can't allow\n"
"him to go north.{end_wait}"

msgctxt "MsgKalayInteriorsTheMostImportantSkillForA"
msgid "06859"
msgstr ""
"The most important skill\n"
"for a merchant is the\n"
"ability to discern quality.{page_break}"
"Anyone who can do that\n"
"can be a successful\n"
"merchant these days.{end_wait}"

msgctxt "MsgKalayInteriorsMySonReceivedHisKnackFor"
msgid "06860"
msgstr ""
"My son received his\n"
"knack for business from\n"
"Lord Hammet.{end_wait}"

msgctxt "MsgKalayInteriorsTheMostImportantThingIsNot"
msgid "06861"
msgstr ""
"The most important thing\n"
"is not to betray your\n"
"customer's trust in you.{page_break}"
"Lord Hammet's lessons are\n"
"more precious to me\n"
"than treasure.{page_break}"
"They will make me a\n"
"lot of money!{end_wait}"

msgctxt "MsgKalayInteriorsMySonIsVeryTightWith"
msgid "06862"
msgstr ""
"My son is very tight\n"
"with money, even when it\n"
"comes to me.{page_break}"
"I feel like I am living\n"
"with a merchant...\n"
"Actually, he is one!{end_wait}"

msgctxt "MsgKalayLordHammetSellsHisBest"
msgid "06863"
msgstr ""
"Lord Hammet sells all\n"
"his best weapons\n"
"elsewhere.{page_break}"
"These weapons are good,\n"
"but they're not the\n"
"best Kalay makes.{end_wait}"

msgctxt "MsgKalayWishBetterWeapons"
msgid "06864"
msgstr ""
"We would be able to make\n"
"more money if he left\n"
"more good weapons here.{end_wait}"

msgctxt "MsgKalayDidFindNeededInWeapon"
msgid "06865"
msgstr ""
"Did you find what you\n"
"needed in the\n"
"Weapon Shop?{end_now}"

msgctxt "MsgKalayLikeOurArmor"
msgid "06866"
msgstr ""
"Then you'll like our\n"
"armor, too.{end_wait}"

msgctxt "MsgKalayFinestEquipment"
msgid "06867"
msgstr ""
"Ah...{pause_20_skippable} You seek only\n"
"the finest items.{page_break}"
"Kalay's weapons and\n"
"armor are without equal.{end_wait}"

msgctxt "MsgKalayWeaponsHaveSoul"
msgid "06868"
msgstr ""
"Weapons and armor from\n"
"Tolbi may be stronger, but\n"
"ours have soul.{end_wait}"

msgctxt "MsgKalayLadyLayanaSharedInLord"
msgid "06869"
msgstr ""
"Lady Layana shared in\n"
"Lord Hammet's hardships\n"
"when he built Kalay.{page_break}"
"Her love for this town\n"
"is why we flourish.{end_wait}"

msgctxt "MsgKalayPalaceWaterSupply"
msgid "06870"
msgstr ""
"The aqueducts in Hammet\n"
"Palace are another reason\n"
"Kalay flourished.{end_wait}"

msgctxt "MsgKalayGoingTolbiAlso"
msgid "06871"
msgstr ""
"Are you going to\n"
"Tolbi also?{end_now}"

msgctxt "message"
msgid "06872"
msgstr ""
"Oh, so you must be\n"
"taking the Colosso\n"
"tour, too...{page_break}"
"The annual Colosso\n"
"festival starts in\n"
"Tolbi soon.{end_wait}"

msgctxt "message"
msgid "06873"
msgstr ""
"Merchants are always\n"
"coming up with new ideas.\n"
"A Colosso tour... Ha!{page_break}"
"They're meeting in the\n"
"restaurant... It must be\n"
"time for them to leave.{end_wait}"

msgctxt "MsgKalayInteriorsEveryoneIsGoingToTolbiTo"
msgid "06874"
msgstr ""
"Everyone is going to\n"
"Tolbi to see the Colosso\n"
"carnival there.{page_break}"
"Kalay will feel so empty.{end_wait}"

msgctxt "MsgKalayInteriorsIveSignedOnForATour"
msgid "06875"
msgstr ""
"I've signed on for\n"
"a tour group going\n"
"to Tolbi.{page_break}"
"I can't believe it's\n"
"almost time for Colosso\n"
"to begin!{end_wait}"

msgctxt "MsgKalayInteriorsTheColossoGladiatorsAreAllStrong"
msgid "06876"
msgstr ""
"The Colosso gladiators\n"
"are all strong, muscular\n"
"men!{end_wait}"

msgctxt "MsgKalayPleaseFinishEatingIfTaking"
msgid "06877"
msgstr ""
"Please finish eating if you\n"
"are taking the tour!{pause_20_skippable}\n"
"We'll be leaving soon!{end_wait}"

msgctxt "MsgKalayInteriorsEveryoneLooksForwardToGoingTo"
msgid "06878"
msgstr ""
"Everyone looks forward\n"
"to going to Tolbi\n"
"once a year.{page_break}"
"Tolbi has many spots\n"
"to visit besides Colosso,\n"
"like Tolbi Springs.{end_wait}"

msgctxt "MsgKalayInteriorsSurelyLordHammetWillPopUp"
msgid "06879"
msgstr ""
"Surely Lord Hammet will\n"
"pop up in Tolbi.{page_break}"
"He loves Colosso.{end_wait}"

msgctxt "MsgKalayInteriorsIWouldHaveEnteredColossoIf"
msgid "06880"
msgstr ""
"I would have entered\n"
"Colosso if I were only\n"
"a little younger.{page_break}"
"What a shame.{end_wait}"

msgctxt "MsgKalayInteriorsManyOfTheGuestsHereSeem"
msgid "06881"
msgstr ""
"Many of the guests here\n"
"seem to be heading to\n"
"Tolbi.{end_wait}"

msgctxt "MsgKalayInteriorsArentYouGoingToColossoYou"
msgid "06882"
msgstr ""
"Aren't you going to\n"
"Colosso? You guys are\n"
"warriors!{page_break}"
"All warriors dream\n"
"of winning fame in\n"
"Colosso!{end_wait}"

msgctxt "MsgKalayDoKnowAboutContinentSouth"
msgid "06883"
msgstr ""
"Do you know about the\n"
"continent south of Tolbi?{end_now}"

msgctxt "message"
msgid "06884"
msgstr ""
"The guest next door\n"
"is dressed like he comes\n"
"from Gondowan.{end_wait}"

msgctxt "message"
msgid "06885"
msgstr ""
"That continent is called\n"
"Gondowan. It is very\n"
"large.{page_break}"
"They say that it is the\n"
"second largest continent\n"
"next to Angara.{page_break}"
"I hear it is very\n"
"warm in Gondowan.{end_wait}"

msgctxt "MsgKalayInteriorsIBetterGetReadyTheColosso"
msgid "06886"
msgstr ""
"I better get ready!\n"
"The Colosso Tour\n"
"is about to leave!{page_break}"
"We're going all the\n"
"way to Tolbi to see the\n"
"Colosso.{page_break}"
"I hope we can visit the\n"
"southern continent, too.{end_wait}"

msgctxt "MsgKalayInteriorsWeFledFromGondowanToThe"
msgid "06887"
msgstr ""
"We fled from Gondowan,\n"
"to the south.{page_break}"
"We lived in Lalivero,\n"
"which was a great village\n"
"until the Tolbians came.{end_wait}"

msgctxt "MsgKalayInteriorsLaliveroWhereImFromIsThe"
msgid "06888"
msgstr ""
"Lalivero, where I'm from,\n"
"is the largest village\n"
"in Gondowan.{page_break}"
"Kalay is quite large, too,\n"
"but it's a little too\n"
"noisy around here.{end_wait}"

msgctxt "MsgKalayInteriorsIfYouAreEnteringColossoYou"
msgid "06889"
msgstr ""
"If you are entering\n"
"Colosso{pause_20_skippable}, you don't stand\n"
"a chance of winning...{page_break}"
"because this year, both\n"
"of us are entering.{end_wait}"

msgctxt "MsgKalayInteriorsWereSoStrongMakingTheFinals"
msgid "06890"
msgstr ""
"We're so strong, making\n"
"the finals will be\n"
"a piece of cake!{page_break}"
"Then, Ouranos and I will\n"
"fight each other for\n"
"the championship.{end_wait}"

msgctxt "MsgKalayInteriorsHesAShrewdMerchantIfHe"
msgid "06891"
msgstr ""
"He's a shrewd merchant\n"
"if he can turn travel\n"
"into a business.{page_break}"
"I'm impressed that he's\n"
"got so many customers.{end_wait}"

msgctxt "MsgKalayInteriorsEveryYearEveryoneGoesToTolbi"
msgid "06892"
msgstr ""
"Every year, everyone\n"
"goes to Tolbi for Colosso.\n"
"We can't help that...{end_wait}"

msgctxt "MsgKalayInteriorsJoiningATourGroupIsThe"
msgid "06893"
msgstr ""
"Joining a tour group is\n"
"the only way to travel.\n"
"Every need is cared for.{end_wait}"

msgctxt "MsgKalayInteriorsIWonderWhichWarriorWillWin"
msgid "06894"
msgstr ""
"I wonder which warrior\n"
"will win Colosso this year.\n"
"I can't wait!{end_wait}"

msgctxt "MsgKalayInteriorsItsBusinessSoYouCantHelp"
msgid "06895"
msgstr ""
"It's business, so you\n"
"can't help it, but\n"
"many of these folk{page_break}"
"aren't used to\n"
"traveling.{end_wait}"

msgctxt "MsgKalayInteriorsImExhaustedFromPreparingThisTour"
msgid "06896"
msgstr ""
"I'm exhausted from\n"
"preparing this tour.{page_break}"
"I can't wait until I'm\n"
"in Tolbi and I can\n"
"rest a bit...{end_wait}"

msgctxt "MsgKalayInteriorsIWasSoExcitedICouldnt"
msgid "06897"
msgstr ""
"I was so excited, I\n"
"couldn't sleep last night.\n"
"But I have to keep cool.{page_break}"
"I don't want anyone to\n"
"know this is my\n"
"first time at Colosso.{end_wait}"

msgctxt "MsgKalayInteriorsMyAnimalInstinctsStartWakingUp"
msgid "06898"
msgstr ""
"My animal instincts start\n"
"waking up as soon as\n"
"I see the Colosso battles!{end_wait}"

msgctxt "MsgKalayInteriorsColossoIsSoCommonWhatsSo"
msgid "06899"
msgstr ""
"Colosso is so...common.\n"
"What's so great about it?{end_wait}"

msgctxt "MsgKalayInteriorsImGoingToSignUpFor"
msgid "06900"
msgstr ""
"I'm going to sign up for\n"
"Colosso as soon as I\n"
"arrive in Tolbi.{page_break}"
"There may be more\n"
"like me, though.{end_wait}"

msgctxt "MsgKalayInteriorsPeopleFromTheContinentSouthOf"
msgid "06901"
msgstr ""
"People from the continent\n"
"south of Angara have\n"
"rich, bronze skin.{end_wait}"

msgctxt "MsgKalayInteriorsImPrettyExcitedBecauseThisIs"
msgid "06902"
msgstr ""
"I'm pretty excited,\n"
"because this is my first\n"
"time visiting Tolbi.{page_break}"
"Let's hurry up and\n"
"get going!{end_wait}"

msgctxt "MsgKalayInteriorsIFledAllThisWayNow"
msgid "06903"
msgstr ""
"I fled all this way. Now I\n"
"won't get in trouble\n"
"for speaking the truth.{page_break}"
"How wonderful it is\n"
"to be free!{end_wait}"

msgctxt "MsgKalayInteriorsItLooksLikeColossoWillSoon"
msgid "06904"
msgstr ""
"It looks like\n"
"Colosso will soon\n"
"begin in Tolbi.{page_break}"
"All this fuss just\n"
"to go to a festival seems\n"
"kind of ridiculous!{end_wait}"

msgctxt "MsgKalayInteriorsIHavePowerAndSeanHas"
msgid "06905"
msgstr ""
"I have power, and Sean\n"
"has speed. Together, we\n"
"have nothing to fear.{end_wait}"

msgctxt "MsgKalayInteriorsWeAreTheToughestOfAll"
msgid "06906"
msgstr ""
"We are the toughest of\n"
"all warriors. We will\n"
"never lose.{end_wait}"

msgctxt "MsgKalayOurInnFeelsEmptyNow"
msgid "06907"
msgstr ""
"Our inn feels so empty,\n"
"now that the Colosso\n"
"tour group has left.{end_wait}"

msgctxt "MsgKalayInteriorsEvenOurChefLeftSoWe"
msgid "06908"
msgstr ""
"Even our chef left, so\n"
"we can't keep our\n"
"business open.{page_break}"
"Not that it matters. We\n"
"will have few customers\n"
"until Colosso ends.{end_wait}"

msgctxt "MsgKalayInteriorsUhOhHesStillHereEven"
msgid "06909"
msgstr ""
"Uh-oh.{pause_20_skippable} He's still here,\n"
"even though his group\n"
"has left!{end_wait}"

msgctxt "MsgKalayInteriorsWeCameHereToEscapeThe"
msgid "06910"
msgstr ""
"We came here to escape\n"
"the southern lands, but\n"
"this city is so strange.{page_break}"
"Everyone is leaving for\n"
"some carnival. I've never\n"
"seen anything like it!{end_wait}"

msgctxt "MsgKalayInteriorsWeEscapedFromTheNortheasternRegion"
msgid "06911"
msgstr ""
"We escaped from the\n"
"northeastern region of the\n"
"southern continent.{page_break}"
"It is so quiet here\n"
"now that everyone left...\n"
"I feel relieved.{end_wait}"

msgctxt "MsgKalayInteriorsIdHaveGoneOnTheColosso"
msgid "06912"
msgstr ""
"I'd have gone on the\n"
"Colosso Tour if I knew\n"
"business would be so slow.{end_wait}"

msgctxt "MsgKalayInteriorsEvenIfMyHusbandWantedTo"
msgid "06913"
msgstr ""
"Even if my husband\n"
"wanted to go on the\n"
"Colosso tour, I would{page_break}"
"never let him. There's no\n"
"telling what he'd do\n"
"without me watching him.{end_wait}"

msgctxt "MsgKalayInteriorsICantSeemToRelaxNow"
msgid "06914"
msgstr ""
"I can't seem to relax, now\n"
"that everyone is gone.\n"
"Maybe I should go back...{end_wait}"

msgctxt "MsgKalayInteriorsIWonderWhatColossoIsLike"
msgid "06915"
msgstr ""
"I wonder what Colosso\n"
"is like. Is it really\n"
"that great?{page_break}"
"Wait...{pause_20_skippable} I didn't flee\n"
"Lalivero to go to Tolbi.{end_wait}"

msgctxt "MsgKalayInteriorsIWasSoScaredComingTo"
msgid "06916"
msgstr ""
"I was so scared coming\n"
"to Angara from Gondowan,\n"
"where Lalivero is.{page_break}"
"Now I'm beginning to feel\n"
"like I am truly free.{end_wait}"

msgctxt "MsgKalayLordHammetsPalaceLordAway"
msgid "06917"
msgstr ""
"This is Lord Hammet's\n"
"palace.{pause_20_skippable} The lord is away.\n"
"Please, begone.{end_wait}"

msgctxt "message"
msgid "06918"
msgstr ""
"We will happily welcome\n"
"visitors once Lord\n"
"Hammet has returned.{end_wait}"

msgctxt "message"
msgid "06919"
msgstr "Leave this to me.{end_wait}"

msgctxt "message"
msgid "06920"
msgstr ""
"It is I... {pause_20_skippable} Please permit\n"
"me to see Lady Layana.{end_wait}"

msgctxt "message"
msgid "06921"
msgstr ""
"Don't you recognize me?{pause_20_skippable}\n"
"I am {actor_name:3}, servant\n"
"to Lord Hammet!{end_wait}"

msgctxt "message"
msgid "06922"
msgstr "{actor_name:3}...{pause_20_skippable}?{end_wait}"

msgctxt "message"
msgid "06923"
msgstr ""
"I didn't recognize you{em_dash}\n"
"You're so tan!\n"
"But it really is you, {actor_name:3}!{end_wait}"

msgctxt "message"
msgid "06924"
msgstr ""
"Oh, it's {actor_name:3}!{pause_20_skippable} You've\n"
"grown so much in such a\n"
"short time, {actor_name:3}!{end_wait}"

msgctxt "message"
msgid "06925"
msgstr ""
"Have I really changed\n"
"that much?{end_now}"

msgctxt "message"
msgid "06926"
msgstr ""
"Really?{pause_20_skippable} I'm surprised...\n"
"It doesn't feel like\n"
"it's been that long...{end_wait}"

msgctxt "message"
msgid "06927"
msgstr ""
"You probably wouldn't\n"
"know. You only met me\n"
"after I got left in Vault.{end_wait}"

msgctxt "message"
msgid "06928"
msgstr ""
"That doesn't matter...\n"
"What's important is that\n"
"the thieves freed you!{end_wait}"

msgctxt "message"
msgid "06929"
msgstr ""
"Please tell us,\n"
"will Lord Hammet be\n"
"freed soon, too?{end_wait}"

msgctxt "message"
msgid "06930"
msgstr ""
"Freed?\n"
"Lord Hammet is\n"
"a prisoner?{end_wait}"

msgctxt "message"
msgid "06931"
msgstr ""
".{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}You haven't "
"heard?\n"
"I can see we'll need to\n"
"fill you in on everything.{page_break}"
"This is a private matter.\n"
"Would your friends\n"
"please leave?{end_now}"

msgctxt "message"
msgid "06932"
msgstr ""
"No, {actor_name:1}! There\n"
"are no secrets\n"
"between us!{end_wait}"

msgctxt "message"
msgid "06933"
msgstr ""
"My companions and I\n"
"have overcome many\n"
"hardships together!{end_wait}"

msgctxt "message"
msgid "06934"
msgstr ""
"Very well, then...\n"
"Why were you not\n"
"with Lord Hammet?{end_wait}"

msgctxt "message"
msgid "06935"
msgstr ""
"I remained in Vault to\n"
"look for his stolen rod.{end_wait}"

msgctxt "message"
msgid "06936"
msgstr ""
"Stolen?\n"
"Someone stole his rod?{end_wait}"

msgctxt "message"
msgid "06937"
msgstr ""
"Yes, the Shaman's Rod.{pause_20_skippable}\n"
"But I was able to\n"
"recover it...{end_wait}"

msgctxt "message"
msgid "06938"
msgstr ""
"Then Lord Hammet must\n"
"still be imprisoned\n"
"in Lunpa...{end_wait}"

msgctxt "message"
msgid "06939"
msgstr ""
"I must report this\n"
"to Lady Layana!{end_wait}"

msgctxt "message"
msgid "06940"
msgstr ""
"{actor_name:3}, come see Lady\n"
"Layana with me... You can\n"
"explain it all to her.{end_wait}"

msgctxt "message"
msgid "06941"
msgstr ""
"{actor_name:1}, you saw Lord\n"
"Hammet heading north,\n"
"didn't you?{end_now}"

msgctxt "message"
msgid "06942"
msgstr ""
"That must have been when\n"
"Lord Hammet went\n"
"toward Lunpa.{end_wait}"

msgctxt "message"
msgid "06943"
msgstr ""
"No, I mean the day Lord\n"
"Hammet went toward\n"
"Lunpa...{end_wait}"

msgctxt "message"
msgid "06944"
msgstr ""
"Lady Layana will surely\n"
"be glad to hear\n"
"your tale.{page_break}"
"Please, come with me,\n"
"and tell her the\n"
"full story.{end_wait}"

msgctxt "MsgKalayWhenHeardWereBackIvan"
msgid "06945"
msgstr ""
"When I heard that you\n"
"were back, {actor_name:3}, I had\n"
"dared to hope...{page_break}"
"that Lord Hammet had\n"
"returned with you.{end_wait}"

msgctxt "message"
msgid "06946"
msgstr ""
"We thought Lord Hammet\n"
"had been released\n"
"from Lunpa, too.{end_wait}"

msgctxt "message"
msgid "06947"
msgstr ""
"We sent the ransom money\n"
"they demanded, so he\n"
"should return soon,{pause_20_skippable} right?{end_wait}"

msgctxt "message"
msgid "06948"
msgstr ""
"What's been happening in\n"
"Lunpa these days?{end_wait}"

msgctxt "message"
msgid "06949"
msgstr ""
"The leadership in Lunpa\n"
"passed from its founder,\n"
"Lunpa, the noble thief,{page_break}"
"to his son Donpa,\n"
"and then to Lunpa's\n"
"grandson...{end_wait}"

msgctxt "message"
msgid "06950"
msgstr ""
"Dodonpa is a very\n"
"evil man.{page_break}"
"His father, Donpa,\n"
"is heartbroken at the\n"
"state of Lunpa now.{end_wait}"

msgctxt "message"
msgid "06951"
msgstr ""
"When did you send\n"
"the ransom money?{end_wait}"

msgctxt "message"
msgid "06952"
msgstr ""
"Let's see...{pause_20_skippable} First, the\n"
"volcano erupted...{end_wait}"

msgctxt "message"
msgid "06953"
msgstr ""
"And the ransom note\n"
"came right after\n"
"the eruption.{end_wait}"

msgctxt "message"
msgid "06954"
msgstr ""
"We rushed the money\n"
"to them right away.\n"
"I remember it well.{end_wait}"

msgctxt "message"
msgid "06955"
msgstr ""
"It's been quite a while\n"
"since the eruption...{end_wait}"

msgctxt "message"
msgid "06956"
msgstr ""
"Is it possible they have\n"
"no intention of letting\n"
"Lord Hammet go?{end_now}"

msgctxt "message"
msgid "06957"
msgstr ""
"You think so, too,\n"
"{actor_name:1}?{end_wait}"

msgctxt "message"
msgid "06958"
msgstr ""
"I don't want to believe\n"
"it either,{pause_20_skippable} but something\n"
"seems wrong about this.{end_wait}"

msgctxt "message"
msgid "06959"
msgstr ""
"Are you saying Dodonpa\n"
"won't release Hammet!?{end_wait}"

msgctxt "message"
msgid "06960"
msgstr ""
"I agree with {actor_name:3}.{page_break}"
"If they were going to\n"
"release him, they'd\n"
"have done it by now.{end_wait}"

msgctxt "message"
msgid "06961"
msgstr ""
"I am sorry, Lady\n"
"Layana, but I think\n"
"{actor_name:3} might be right.{end_wait}"

msgctxt "message"
msgid "06962"
msgstr ""
"What should we do?{pause_20_skippable}\n"
"How can we rescue\n"
"Hammet?{end_wait}"

msgctxt "message"
msgid "06963"
msgstr ""
"What... {pause_20_skippable}What if something\n"
"has happened to him!?{end_wait}"

msgctxt "message"
msgid "06964"
msgstr "Let us handle this!{end_wait}"

msgctxt "message"
msgid "06965"
msgstr ""
"My lady, this is exactly\n"
"what the soldiers of\n"
"Kalay are here for!{end_wait}"

msgctxt "message"
msgid "06966"
msgstr ""
"Yes, Lady Layana!{pause_20_skippable}\n"
"Please let us handle this!{end_wait}"

msgctxt "message"
msgid "06967"
msgstr ""
"Command us to attack,\n"
"and we shall!{end_wait}"

msgctxt "message"
msgid "06968"
msgstr ""
"I cannot do that...{pause_20_skippable}\n"
"Not without thinking\n"
"it over carefully...{end_wait}"

msgctxt "message"
msgid "06969"
msgstr ""
"How can we guarantee\n"
"Hammet's safety if we\n"
"send soldiers to attack?{end_wait}"

msgctxt "message"
msgid "06970"
msgstr ""
"I cannot do it.{pause_20_skippable} I\n"
"cannot put Hammet's\n"
"life at risk...{end_wait}"

msgctxt "message"
msgid "06971"
msgstr ""
"Can't we do something\n"
"to help?{end_now}"

msgctxt "message"
msgid "06972"
msgstr ""
"Oh!{pause_20_skippable} Well, it's about\n"
"time you started\n"
"agreeing with me, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "06973"
msgstr ""
"What!? Look, we both\n"
"know Hammet's life is\n"
"in danger!{end_wait}"

msgctxt "message"
msgid "06974"
msgstr ""
"What are you two\n"
"talking about?{end_wait}"

msgctxt "message"
msgid "06975"
msgstr ""
"{actor_name:2} thinks that\n"
"we can help.{end_wait}"

msgctxt "message"
msgid "06976"
msgstr ""
"It is too dangerous...{pause_20_skippable}\n"
"If you fail, your lives\n"
"would be in danger, too.{end_wait}"

msgctxt "message"
msgid "06977"
msgstr ""
"Besides, don't you have\n"
"your own quests to\n"
"pursue?{end_now}"

msgctxt "message"
msgid "06978"
msgstr ""
"I thought so... I knew\n"
"there had to be a reason\n"
"{actor_name:3} had stayed with you,{page_break}"
"instead of returning\n"
"home directly from\n"
"Vault.{end_wait}"

msgctxt "message"
msgid "06979"
msgstr ""
"I do not believe that...\n"
"{actor_name:3} would not have stayed\n"
"with you for so long{page_break}"
"if you did not have an\n"
"important task ahead.{end_wait}"

msgctxt "message"
msgid "06980"
msgstr ""
"Then what will happen\n"
"to Lord Hammet?{end_wait}"

msgctxt "message"
msgid "06981"
msgstr ""
"Hammet is a good hostage\n"
"for them...{pause_20_skippable}\n"
"They will not kill him.{end_wait}"

msgctxt "message"
msgid "06982"
msgstr ""
"We shall wait for another\n"
"message from Lunpa.{end_wait}"

msgctxt "message"
msgid "06983"
msgstr ""
"Lady Layana,{pause_20_skippable} I cannot\n"
"leave like this...{end_wait}"

msgctxt "message"
msgid "06984"
msgstr ""
"It will be fine, {actor_name:3}.{pause_20_skippable}\n"
"Hammet would not want to\n"
"distract you from{em_dash}{end_wait}"

msgctxt "message"
msgid "06985"
msgstr ""
"I apologize. I have said\n"
"more than I should...{end_wait}"

msgctxt "message"
msgid "06986"
msgstr ""
"It sounds like Hammet\n"
"knows about our mission\n"
"...doesn't it?{end_wait}"

msgctxt "message"
msgid "06987"
msgstr ""
"I suppose I can keep\n"
"it a secret no longer...{end_wait}"

msgctxt "message"
msgid "06988"
msgstr ""
"Very well,{pause_20_skippable} I shall tell\n"
"you.{pause_20_skippable}.{pause_20_skippable}.{page_break}"
"He swore an oath\n"
"to a Jupiter Adept.{end_wait}"

msgctxt "message"
msgid "06989"
msgstr "A Jupiter Adept!?{end_wait}"

msgctxt "message"
msgid "06990"
msgstr ""
"Have you heard of a\n"
"village called Vale?{end_now}"

msgctxt "message"
msgid "06991"
msgstr ""
"You {text_effect:2}are{reset_text_style} from Vale?\n"
"Really? Then the prophecy\n"
"was true.{end_wait}"

msgctxt "message"
msgid "06992"
msgstr ""
"Give me a break! You\n"
"don't know Vale!? It's\n"
"our hometown!{end_wait}"

msgctxt "message"
msgid "06993"
msgstr ""
"You are from Vale...?\n"
"Really? Then the prophecy\n"
"was true.{end_wait}"

msgctxt "message"
msgid "06994"
msgstr "What prophecy?{end_wait}"

msgctxt "message"
msgid "06995"
msgstr ""
"Three years after the\n"
"terrible storm that struck\n"
"only Mt. Aleph...{end_wait}"

msgctxt "message"
msgid "06996"
msgstr ""
"{actor_name:3} must depart on a\n"
"journey with warriors\n"
"from Vale...{page_break}"
"So it was foretold.{end_wait}"

msgctxt "message"
msgid "06997"
msgstr ""
"I've heard nothing of\n"
"any such prophecy.{end_wait}"

msgctxt "message"
msgid "06998"
msgstr ""
"It happened several\n"
"years before Hammet\n"
"founded Kalay...{page_break}"
"He was off traveling.{end_wait}"

msgctxt "message"
msgid "06999"
msgstr ""
"Hammet felt he had\n"
"reached an impasse as\n"
"a merchant then.{end_wait}"

msgctxt "message"
msgid "07000"
msgstr ""
"He risked his life on a\n"
"journey to find a new\n"
"source of business...{end_wait}"

msgctxt "message"
msgid "07001"
msgstr ""
"He was in mortal danger\n"
"at the southwestern\n"
"edge of the world,{page_break}"
"when some Adepts\n"
"appeared and saved\n"
"his life.{end_wait}"

msgctxt "message"
msgid "07002"
msgstr ""
"He had lost consciousness.\n"
"When he awoke, he found\n"
"himself in their village.{end_wait}"

msgctxt "message"
msgid "07003"
msgstr ""
"Just a moment... Am I\n"
"from that village?{end_wait}"

msgctxt "message"
msgid "07004"
msgstr ""
"Yes.{pause_20_skippable} The Adept gave him\n"
"the Shaman's Rod{pause_20_skippable} and you...\n"
"along with some doubloons.{end_wait}"

msgctxt "message"
msgid "07005"
msgstr ""
"Doubloons...{pause_20_skippable}{pause_20_skippable} Were they\n"
"{pause_20_skippable}golden doubloons?{end_wait}"

msgctxt "message"
msgid "07006"
msgstr ""
"Yes...{pause_20_skippable} Let's see...\n"
"You are...called...{end_wait}"

msgctxt "message"
msgid "07007"
msgstr "I am {actor_name:4}, Lady Layana.{end_wait}"

msgctxt "message"
msgid "07008"
msgstr ""
"It was a lot of gold, {actor_name:4},{pause_20_skippable}\n"
"but he also received\n"
"some business advice.{end_wait}"

msgctxt "message"
msgid "07009"
msgstr ""
"Business advice? Hammet?\n"
"The greatest merchant\n"
"ever known?{end_wait}"

msgctxt "message"
msgid "07010"
msgstr ""
"Yes, {actor_name:2}{pause_20_skippable}. Hammet\n"
"has the Adepts to thank\n"
"for his success.{end_wait}"

msgctxt "message"
msgid "07011"
msgstr ""
"Wow... I've never heard\n"
"anything like that...{end_wait}"

msgctxt "message"
msgid "07012"
msgstr ""
"He was advised to buy\n"
"silk in Xian and sell\n"
"it in Tolbi.{end_wait}"

msgctxt "message"
msgid "07013"
msgstr ""
"To see anything sell\n"
"so well, it's like a\n"
"dream come true.{end_wait}"

msgctxt "message"
msgid "07014"
msgstr ""
"There's no denying that\n"
"was when Hammet picked\n"
"up his knack for business.{end_wait}"

msgctxt "message"
msgid "07015"
msgstr ""
"Did he have to promise\n"
"them anything in return?{end_wait}"

msgctxt "message"
msgid "07016"
msgstr ""
"Ah, yes, {actor_name:3}...{pause_20_skippable} It is\n"
"something you will\n"
"need on your journey.{end_wait}"

msgctxt "message"
msgid "07017"
msgstr ""
"Something we need on\n"
"our journey...{end_wait}"

msgctxt "message"
msgid "07018"
msgstr ""
"The Adept asked Hammet\n"
"to use the Shaman's Rod\n"
"to obtain it.{end_wait}"

msgctxt "message"
msgid "07019"
msgstr ""
"He looked for this\n"
"object wherever he\n"
"went...{page_break}"
"But he could never\n"
"find it.{end_wait}"

msgctxt "message"
msgid "07020"
msgstr ""
"Then, three years ago, a\n"
"storm struck, one that hit\n"
"only Mt. Aleph...{end_wait}"

msgctxt "message"
msgid "07021"
msgstr ""
"Hammet was worried{pause_20_skippable}{pause_20_skippable} that\n"
"time{pause_20_skippable} was running out...{end_wait}"

msgctxt "message"
msgid "07022"
msgstr ""
"But he had managed\n"
"to unearth a clue\n"
"just in time.{end_wait}"

msgctxt "message"
msgid "07023"
msgstr ""
"That, {actor_name:3}, is why he took\n"
"you with the caravan on\n"
"his last journey north.{end_wait}"

msgctxt "message"
msgid "07024"
msgstr ""
"I had no idea...{pause_20_skippable} So that\n"
"must be why he left the\n"
"rod in my care.{pause_20_skippable}{pause_20_skippable} But "
"then{em_dash}{end_wait}"

msgctxt "message"
msgid "07025"
msgstr ""
"No, {actor_name:3}...{pause_20_skippable} You mustn't\n"
"blame yourself...{end_wait}"

msgctxt "message"
msgid "07026"
msgstr ""
"It was my carelessness\n"
"that caused the rod to\n"
"be stolen. And ultimately,{page_break}"
"that's why Lord Hammet\n"
"is being held in\n"
"Lunpa...{end_wait}"

msgctxt "message"
msgid "07027"
msgstr ""
"You must continue your\n"
"journey and complete your\n"
"quest.{page_break}"
"You can't blame yourself.{end_wait}"

msgctxt "message"
msgid "07028"
msgstr ""
"But what will happen\n"
"to Hammet?{end_wait}"

msgctxt "message"
msgid "07029"
msgstr "I will handle this.{end_wait}"

msgctxt "message"
msgid "07030"
msgstr ""
"And don't forget the\n"
"soldiers of Kalay!{end_wait}"

msgctxt "message"
msgid "07031"
msgstr ""
"Continue on your journey,\n"
"and do not worry about\n"
"Hammet!{end_wait}"

msgctxt "message"
msgid "07032"
msgstr ""
"I am sorry I cannot tell\n"
"you more about the\n"
"Shaman's Rod...{end_wait}"

msgctxt "message"
msgid "07033"
msgstr "No,{pause_20_skippable} don't apologize...{end_wait}"

msgctxt "message"
msgid "07034"
msgstr ""
"The Shaman's Rod'll help us\n"
"find that thing we need\n"
"for our quest, right?{end_wait}"

msgctxt "message"
msgid "07035"
msgstr "Will you look for it?{end_now}"

msgctxt "message"
msgid "07036"
msgstr ""
"If {actor_name:1} says we will,\n"
"then there's nothing\n"
"to worry about!{end_wait}"

msgctxt "message"
msgid "07037"
msgstr ""
"What's wrong with you,\n"
"{actor_name:1}? Did you forget\n"
"why we're here?{end_wait}"

msgctxt "message"
msgid "07038"
msgstr ""
"If we need it for our\n"
"quest, we'll have to\n"
"find it sooner or later.{end_wait}"

msgctxt "message"
msgid "07039"
msgstr ""
"Very well...{pause_20_skippable} Take care\n"
"of yourselves.{end_wait}"

msgctxt "message"
msgid "07040"
msgstr ""
"Return to your posts,\n"
"everyone!{end_wait}"

msgctxt "MsgHammetPalaceDodonpaIsAVeryShrewdMan"
msgid "07041"
msgstr ""
"Dodonpa is a very shrewd\n"
"man. He may have sent\n"
"spies into Kalay.{page_break}"
"We can't risk sending\n"
"our soldiers yet.{end_wait}"

msgctxt "MsgHammetPalaceTheTownsfolkDontKnowAboutLord"
msgid "07042"
msgstr ""
"The townsfolk don't\n"
"know about Lord Hammet\n"
"yet, do they?{end_wait}"

msgctxt "MsgKalayLordHammetWillReleasedSoon"
msgid "07043"
msgstr ""
"Lord Hammet will be\n"
"released soon. Right?{end_now}"

msgctxt "message"
msgid "07044"
msgstr ""
"I hope so. Otherwise,\n"
"Layana will be\n"
"overwhelmed by sorrow.{end_wait}"

msgctxt "message"
msgid "07045"
msgstr ""
"It wouldn't hurt you to\n"
"lie a little, you know!{end_wait}"

msgctxt "MsgHammetPalaceLayanaIsPuttingUpAStrong"
msgid "07046"
msgstr ""
"Layana is putting up a\n"
"strong front whenever\n"
"people are around.{page_break}"
"It's so hard to\n"
"see her like this.{end_wait}"

msgctxt "MsgHammetPalaceMerchantsAreSupposedToBeProtected"
msgid "07047"
msgstr ""
"Merchants are supposed\n"
"to be protected under\n"
"the laws of Angara.{page_break}"
"Dodonpa must truly be\n"
"evil to break such a law!{end_wait}"

msgctxt "MsgKalayHasLegacyLordHammetsSilk"
msgid "07048"
msgstr ""
"Has the legacy of Lord\n"
"Hammet's silk trading\n"
"come to an end?{end_now}"

msgctxt "message"
msgid "07049"
msgstr ""
"How can you say that!\n"
"Lady Layana would be\n"
"devastated!{end_wait}"

msgctxt "message"
msgid "07050"
msgstr ""
"You're right. I never\n"
"should have said that.\n"
"I feel terrible now.{end_wait}"

msgctxt "MsgHammetPalaceIsThisTheRightDecisionHammet"
msgid "07051"
msgstr ""
"Is this the right\n"
"decision, Hammet?\n"
"Am I making a mistake?{end_wait}"

msgctxt "MsgHammetPalaceImSureTheVillagersWouldPanic"
msgid "07052"
msgstr ""
"I'm sure the villagers\n"
"would panic if they knew\n"
"Hammet was a hostage...{page_break}"
"We must be sure we do\n"
"not show it...{end_wait}"

msgctxt "MsgHammetPalaceEveryonesWorriedAboutLordHammetBut"
msgid "07053"
msgstr ""
"Everyone's worried about\n"
"Lord Hammet, but no one\n"
"can talk about it openly.{page_break}"
"If he isn't freed, it will\n"
"mean the end of Kalay...{end_wait}"

msgctxt "MsgHammetPalaceLadyLayanaWasCryingAgainLast"
msgid "07054"
msgstr ""
"Lady Layana was crying\n"
"again last night.{page_break}"
"I wish there were\n"
"something I could do.{end_wait}"

msgctxt "MsgHammetPalaceAndToThinkIAlmostWent"
msgid "07055"
msgstr ""
"And to think...\n"
"I almost went on that\n"
"caravan with Hammet!{end_wait}"

msgctxt "MsgHammetPalaceLordHammetIsALegendAmong"
msgid "07056"
msgstr ""
"Lord Hammet is a legend\n"
"among merchants. Kalay\n"
"can't survive without him.{end_wait}"

msgctxt "MsgKalayIsaacSneakedIntoLunpaThats"
msgid "07057"
msgstr ""
"{actor_name:1}{pause_20_skippable}, you sneaked into\n"
"Lunpa? That's far too\n"
"dangerous!{end_wait}"

msgctxt "message"
msgid "07058"
msgstr ""
"But{pause_20_skippable} I am happy to\n"
"learn that Hammet\n"
"is not hurt.{end_wait}"

msgctxt "message"
msgid "07059"
msgstr ""
"Thank you, {actor_name:1}...{pause_20_skippable}\n"
"But please, do not go\n"
"to Lunpa again.{end_wait}"

msgctxt "message"
msgid "07060"
msgstr "Please, fulfill your quest.{end_wait}"

msgctxt "MsgHammetPalaceDodonpaPlansToUseHammetTo"
msgid "07061"
msgstr ""
"Dodonpa plans to use\n"
"Hammet to get every last\n"
"penny he can from Kalay.{page_break}"
"We shall have to\n"
"appease him until\n"
"we can rescue Hammet.{end_wait}"

msgctxt "MsgHammetPalaceIDontCareAboutTheMoney"
msgid "07062"
msgstr ""
"I don't care about the\n"
"money, as long as Hammet\n"
"comes home safely...{end_wait}"

msgctxt "MsgKalaySoldiersHandleAffairs"
msgid "07063"
msgstr ""
"The soldiers of Kalay\n"
"will handle this\n"
"matter ourselves.{page_break}"
"Please, go on with your\n"
"journey, as Lady Layana\n"
"requested.{end_wait}"

msgctxt "MsgKalaySoldiersRescueHammet"
msgid "07064"
msgstr ""
"We'll take care of\n"
"this kidnapping incident\n"
"just fine.{page_break}"
"You should continue on\n"
"your quest.{end_wait}"

msgctxt "MsgKalayPrayForHammetSafety"
msgid "07065"
msgstr ""
"I'm worried about Lord\n"
"Hammet, but Lady Layana\n"
"insists we do nothing.{page_break}"
"I can only hope for\n"
"Lord Hammet's safety...{end_wait}"

msgctxt "MsgKalayWarriorsWillSaveHammet"
msgid "07066"
msgstr ""
"The warriors of Kalay\n"
"will save Lord Hammet,\n"
"no matter the toll.{end_wait}"

msgctxt "MsgKalayFormerInnFestivalTourists"
msgid "07067"
msgstr ""
"The people in the inn\n"
"were tourists going to\n"
"see the Colosso.{page_break}"
"All that fuss just to\n"
"see a carnival in Tolbi!\n"
"I don't get it.{end_wait}"

msgctxt "MsgLunpaWestGuardAsksAboutEntering"
msgid "07068"
msgstr ""
"What's with you?\n"
"You wanna enter Lunpa?{end_now}"

msgctxt "message"
msgid "07069"
msgstr ""
"Well, you can't!\n"
"Go back to where\n"
"you came from!{end_wait}"

msgctxt "message"
msgid "07070"
msgstr ""
"You came all this way\n"
"for nothing? That\n"
"doesn't make any sense...{page_break}"
"Lunpa's no place for\n"
"people like you. Go back\n"
"where you came from!{end_wait}"

msgctxt "MsgLunpaEastGuardAsksIfFrom"
msgid "07071"
msgstr ""
"You're not from Kalay,{pause_20_skippable}\n"
"are you?{end_now}"

msgctxt "message"
msgid "07072"
msgstr ""
"That last group said the\n"
"same thing, but we\n"
"didn't trust them, either.{page_break}"
"Leave now if you don't\n"
"want to get hurt.{end_wait}"

msgctxt "message"
msgid "07073"
msgstr ""
"You're not here to\n"
"save Hammet,{pause_20_skippable} are you?{end_now}"

msgctxt "message"
msgid "07074"
msgstr ""
"We'll return Hammet to\n"
"Kalay very soon. Just\n"
"wait a little longer...{page_break}"
"That's what Dodonpa\n"
"told us to say.{end_wait}"

msgctxt "message"
msgid "07075"
msgstr ""
"Oh, please! No one would\n"
"come to Lunpa unless\n"
"it was to save Hammet!{page_break}"
"You don't want to make\n"
"me angry. You wouldn't\n"
"like me when I'm angry!{end_wait}"

msgctxt "MsgLunpaVillageWestGuardSealedThoughts"
msgid "07076"
msgstr ""
"I wonder if these guys\n"
"will try to enter from the\n"
"cave west of town?{page_break}"
"Well, the gate there is\n"
"too heavy for them to\n"
"lift, anyway. No worries!{end_wait}"

msgctxt "MsgLunpaEastGuardTrustsCaveGate"
msgid "07077"
msgstr ""
"Even if they enter\n"
"through the cave, they\n"
"can't get into town.{page_break}"
"The gate in the cave\n"
"can only be opened\n"
"from the inside.{end_wait}"

msgctxt "MsgLunpaVillagerAAsksHowLong"
msgid "07078"
msgstr ""
"Have you been in Lunpa\n"
"long?{end_now}"

msgctxt "message"
msgid "07079"
msgstr ""
"Hmm... Your face doesn't\n"
"ring a bell. I guess you\n"
"don't really stand out.{end_wait}"

msgctxt "message"
msgid "07080"
msgstr ""
"Oh, so you're a new\n"
"member of Dodonpa's\n"
"gang?{end_wait}"

msgctxt "MsgLunpaVillageVillagerBSealed"
msgid "07081"
msgstr ""
"We've had no freedom\n"
"ever since the caravan\n"
"came to the village.{page_break}"
"We can't leave the\n"
"village, and no one is\n"
"allowed in. I hate it...{end_wait}"

msgctxt "MsgLunpaVillagerCAsksAboutKidnapping"
msgid "07082"
msgstr ""
"Is it true that Dodonpa\n"
"kidnapped Hammet and\n"
"extorted ransom for him?{end_now}"

msgctxt "message"
msgid "07083"
msgstr ""
"Then I guess Dodonpa's\n"
"men were telling the\n"
"truth.{end_wait}"

msgctxt "message"
msgid "07084"
msgstr ""
"I didn't think so. Not\n"
"even Dodonpa would do\n"
"such a terrible thing.{end_wait}"

msgctxt "MsgLunpaVillageVillagerDSealed"
msgid "07085"
msgstr ""
"Donpa is too old to lead,\n"
"so his men do whatever\n"
"Dodonpa says.{end_wait}"

msgctxt "MsgLunpaVillageVillagerESealed"
msgid "07086"
msgstr ""
"The righteous thief, Lunpa,\n"
"and his son, Donpa{em_dash}\n"
"They were great men.{end_wait}"

msgctxt "MsgLunpaVillageVillagerFSealed"
msgid "07087"
msgstr ""
"Donpa has no idea what\n"
"Dodonpa is doing.{page_break}"
"This village would change\n"
"if Donpa heard about\n"
"Dodonpa's evil deeds...{end_wait}"

msgctxt "MsgLunpaVillagerGAsksAboutDonpa"
msgid "07088"
msgstr "You want to see Donpa?{end_now}"

msgctxt "message"
msgid "07089"
msgstr ""
"Donpa is in the fortress.\n"
"You'll have to go there\n"
"if you want to see him.{page_break}"
"But security at the\n"
"fortress is very tight.{end_wait}"

msgctxt "message"
msgid "07090"
msgstr ""
"I didn't think so...\n"
"It's impossible to\n"
"see Donpa now.{end_wait}"

msgctxt "MsgLunpaVillageVillagerHSealed"
msgid "07091"
msgstr ""
"The chef from the inn\n"
"has been delivering meals\n"
"to the fortress lately.{page_break}"
"He says security is very\n"
"tight{em_dash}even inside the\n"
"fortress.{end_wait}"

msgctxt "message"
msgid "07092"
msgstr "Don't come any closer.{end_wait}"

msgctxt "MsgLunpaLeftGuardResentsDodonpa"
msgid "07093"
msgstr ""
"How can Dodonpa be so\n"
"devious?{page_break}"
"I can't believe he\n"
"is the son of Donpa.{end_wait}"

msgctxt "MsgLunpaRightGuardBoasts"
msgid "07094"
msgstr ""
"Not even a mouse could\n"
"enter this fortress\n"
"while I'm on the watch!{end_wait}"

msgctxt "MsgLunpaVillageVillagerASealedThoughts"
msgid "07095"
msgstr ""
"I doubt anyone could\n"
"enter Lunpa now with all\n"
"this tight security.{end_wait}"

msgctxt "MsgLunpaVillageVillagerBSealedThoughts"
msgid "07096"
msgstr ""
"It sure was strange\n"
"of Hammet to come here\n"
"just to get caught.{end_wait}"

msgctxt "MsgLunpaVillageVillagerCSealedThoughts"
msgid "07097"
msgstr ""
"Once they get the ransom,\n"
"they'll set the hostages\n"
"free, no matter what.{page_break}"
"But the merchant caravan\n"
"hasn't left yet.\n"
"What's going on?{end_wait}"

msgctxt "MsgLunpaVillageVillagerDSealedThoughts"
msgid "07098"
msgstr ""
"Lunpa died when Donpa\n"
"was still young. It\n"
"made Donpa a lonely man...{page_break}"
"They say that's why he\n"
"spoiled Dodonpa so much...\n"
"What a mistake that was.{end_wait}"

msgctxt "MsgLunpaVillageVillagerESealedThoughts"
msgid "07099"
msgstr ""
"Dodonpa can do his evil\n"
"deeds, but how can he\n"
"live like this?{page_break}"
"If he makes any money,\n"
"he should pass it around\n"
"to us poor villagers.{end_wait}"

msgctxt "MsgLunpaVillageVillagerFSealedThoughts"
msgid "07100"
msgstr ""
"Dodonpa keeps Donpa\n"
"hidden away in the\n"
"fortress so that he won't{page_break}"
"find out about all the\n"
"evil things Dodonpa has\n"
"been up to.{end_wait}"

msgctxt "MsgLunpaVillageVillagerGSealedThoughts"
msgid "07101"
msgstr ""
"The fortress is guarded\n"
"all day long.{page_break}"
"No one outside the\n"
"fortress can get in to\n"
"see Donpa.{end_wait}"

msgctxt "MsgLunpaVillageVillagerHSealedThoughts"
msgid "07102"
msgstr ""
"The chef said the\n"
"fortress is so scary, he\n"
"never wants to go back.{end_wait}"

msgctxt "MsgLunpaLeftGuardThoughts"
msgid "07103"
msgstr ""
"Dodonpa is a genius!\n"
"Not releasing Hammet\n"
"is so smart...{page_break}"
"It's a great way to use\n"
"Hammet to keep extorting\n"
"money from Kalay.{end_wait}"

msgctxt "MsgLunpaYoudShadowSneak"
msgid "07104"
msgstr ""
"You'd have to be a\n"
"shadow to sneak past me.{end_wait}"

msgctxt "MsgLunpaInteriorsFirstHomeASealed"
msgid "07105"
msgstr ""
"My late grandfather\n"
"traveled the continent\n"
"with Lunpa.{page_break}"
"He would be very sad\n"
"to see the things\n"
"Dodonpa is doing now.{end_wait}"

msgctxt "MsgLunpaInteriorsFirstHomeBSealed"
msgid "07106"
msgstr ""
"We may live in Lunpa, but\n"
"we'll never work for\n"
"Dodonpa.{end_wait}"

msgctxt "MsgLunpaInteriorsFirstHomeASealedThoughts"
msgid "07107"
msgstr ""
"Lunpa used to be a good\n"
"place, but not anymore.{end_wait}"

msgctxt "MsgLunpaInteriorsFirstHomeBSealedThoughts"
msgid "07108"
msgstr ""
"They keep pushing us\n"
"to work for Dodonpa!\n"
"I can't stand it!{end_wait}"

msgctxt "MsgLunpaInteriorsSecondHomeASealed"
msgid "07109"
msgstr ""
"The fortress was built\n"
"during Donpa's rule.{page_break}"
"He built his fortress\n"
"so well, not even an ant\n"
"could sneak in.{end_wait}"

msgctxt "MsgLunpaInteriorsSecondHomeBSealed"
msgid "07110"
msgstr ""
"The inn's chef is the\n"
"only one in town who can\n"
"enter the fortress.{end_wait}"

msgctxt "MsgLunpaInteriorsSecondHomeASealedThoughts"
msgid "07111"
msgstr ""
"The fortress was built so\n"
"its guards could see\n"
"every corner.{end_wait}"

msgctxt "MsgLunpaInteriorsSecondHomeBSealedThoughts"
msgid "07112"
msgstr ""
"After the caravan\n"
"of merchants was\n"
"captured...{page_break}"
"That was when they\n"
"ordered the chef inside\n"
"the fortress.{end_wait}"

msgctxt "MsgLunpaInteriorsThirdHomeASealed"
msgid "07113"
msgstr ""
"Lunpa passed away long\n"
"ago, when the world was\n"
"hit by a huge flood.{page_break}"
"Lunpa had gone south{pause_20_skippable}...\n"
"and he was never seen\n"
"again after the flood.{end_wait}"

msgctxt "MsgLunpaInteriorsThirdHomeBSealed"
msgid "07114"
msgstr ""
"Lunpa was caught in the\n"
"great flood while traveling\n"
"with someone named Babi.{end_wait}"

msgctxt "MsgLunpaInteriorsThirdHomeASealedThoughts"
msgid "07115"
msgstr ""
"They say the flood claimed\n"
"many lives, all across\n"
"the continent.{end_wait}"

msgctxt "MsgLunpaInteriorsThirdHomeBSealedThoughts"
msgid "07116"
msgstr ""
"What kind of name\n"
"is Babi, anyway?{end_wait}"

msgctxt "MsgLunpaWeaponMerchantSealed"
msgid "07117"
msgstr ""
"The village is sealed,\n"
"so we can't buy or sell\n"
"anything.{page_break}"
"Dodonpa doesn't care\n"
"about my business.{end_wait}"

msgctxt "MsgLunpaArmorMerchantSealed"
msgid "07118"
msgstr ""
"I'll sell you as much\n"
"armor as you like, once\n"
"the village is reopened.{end_wait}"

msgctxt "MsgLunpaItemMerchantSealed"
msgid "07119"
msgstr ""
"They bought a lot of\n"
"stock, which is why\n"
"they're holding up,{page_break}"
"but I still feel bad\n"
"for them and all\n"
"the lost business.{end_wait}"

msgctxt "MsgLunpaInnkeeperOffersOwnHome"
msgid "07120"
msgstr ""
"Do you want to sleep at\n"
"my place?{end_now}"

msgctxt "message"
msgid "07121"
msgstr ""
"You must be kidding.\n"
"Go rest in your\n"
"own home!{end_wait}"

msgctxt "message"
msgid "07122"
msgstr ""
"Of course not! With no\n"
"travelers in town, no one\n"
"wants to stay here.{end_wait}"

msgctxt "MsgLunpaInteriorsInnClerkSealed"
msgid "07123"
msgstr ""
"Dodonpa made a pretty\n"
"penny for himself by\n"
"capturing Hammet,{page_break}"
"but he doesn't care\n"
"about what happens to\n"
"us villagers at all.{end_wait}"

msgctxt "MsgLunpaInteriorsInnWorkerSealed"
msgid "07124"
msgstr ""
"It doesn't matter how\n"
"much we clean or wait\n"
"for customers.{page_break}"
"No one will come.{end_wait}"

msgctxt "MsgLunpaChefOffersStory"
msgid "07125"
msgstr ""
"Do you want to hear\n"
"about how I delivered\n"
"meals to the fortress?{end_now}"

msgctxt "message"
msgid "07126"
msgstr ""
"I was blindfolded and\n"
"guided along a cool path.\n"
"I walked for a while.{page_break}"
"I heard my footsteps\n"
"echoing, so it must have\n"
"been an underground path.{end_wait}"

msgctxt "message"
msgid "07127"
msgstr ""
"I was so relieved when\n"
"I got back to the\n"
"village.{page_break}"
"The guy I delivered\n"
"food to? They called\n"
"him Hammet.{end_wait}"

msgctxt "MsgLunpaInteriorsInnkeeperSealedThoughts"
msgid "07128"
msgstr ""
"I just have to hang in\n"
"there. I'm not closing my\n"
"inn 'til the village is free.{end_wait}"

msgctxt "MsgLunpaInteriorsInnClerkSealedThoughts"
msgid "07129"
msgstr ""
"Dodonpa doesn't care\n"
"about anyone but himself.\n"
"That's why he does this...{end_wait}"

msgctxt "MsgLunpaInteriorsInnWorkerSealedThoughts"
msgid "07130"
msgstr ""
"At this rate,\n"
"I'll be fired before\n"
"I know it...{end_wait}"

msgctxt "MsgLunpaChefThinksOfPrisoner"
msgid "07131"
msgstr ""
"I feel bad for that poor\n"
"man they've got locked\n"
"up in the dungeon...{end_wait}"

msgctxt "MsgLunpaTemplePriestSealed"
msgid "07132"
msgstr ""
"I think that thief Dodonpa\n"
"is a terrible man.{page_break}"
"But it's not fair to blame\n"
"the Lunpans for it.\n"
"They need our care, too.{end_wait}"

msgctxt "MsgLunpaInteriorsTemplePriestSealedThoughts"
msgid "07133"
msgstr ""
"We can't leave Lunpa{em_dash}\n"
"not when Dodonpa's men\n"
"are watching like that.{end_wait}"

msgctxt "MsgLunpaWeaponMerchantSealedThoughts"
msgid "07134"
msgstr ""
"I'll have to close this\n"
"shop soon if things\n"
"don't change...{end_wait}"

msgctxt "MsgLunpaArmorMerchantSealedThoughts"
msgid "07135"
msgstr ""
"I should have bought\n"
"more stock while I\n"
"had the chance...{end_wait}"

msgctxt "MsgLunpaItemMerchantSealedThoughts"
msgid "07136"
msgstr ""
"I bought a lot of\n"
"stock, but I'm already\n"
"running out...{end_wait}"

msgctxt "MsgLunpaEastGuardDemandsAuthorization"
msgid "07137"
msgstr ""
"This is Lunpa. You\n"
"cannot enter without\n"
"Dodonpa's authorization.{end_wait}"

msgctxt "MsgLunpaEastGuardFearsBlame"
msgid "07138"
msgstr ""
"If outsiders cause any\n"
"trouble in the village,{page_break}"
"Dodonpa will hold\n"
"us responsible.{end_wait}"

msgctxt "MsgValeYouCameBackHome"
msgid "07139"
msgstr ""
"Hey,{pause_20_skippable} if it isn't\n"
"{actor_name:1}! You came back\n"
"home, huh?{end_wait}"

msgctxt "MsgValeThisIsVale"
msgid "07140"
msgstr ""
"This is Vale!{pause_20_skippable}\n"
"...Wait, you already know\n"
"that, right, {actor_name:1}?{end_wait}"

msgctxt "MsgValeCameBackSooner"
msgid "07141"
msgstr ""
"Oh, {actor_name:1}!\n"
"You came back sooner\n"
"than I thought!{end_wait}"

msgctxt "MsgValeMadeFriendsOnJourney"
msgid "07142"
msgstr ""
"It looks like you made\n"
"some friends in your\n"
"travels, {actor_name:1}.{page_break}"
"I'm glad to see that.{end_wait}"

msgctxt "MsgValeRiverHeatedAndCooled"
msgid "07143"
msgstr ""
"The river in town\n"
"grew so hot after\n"
"Mt. Aleph erupted.{page_break}"
"Everyone got excited,\n"
"thinking there were hot\n"
"springs on the mountain,{page_break}"
"but then the river\n"
"cooled down again.{end_wait}"

msgctxt "MsgValeAnythingInterestingOnYourTrip"
msgid "07144"
msgstr ""
"Did you see anything\n"
"interesting on your trip,\n"
"{actor_name:1}?{end_now}"

msgctxt "message"
msgid "07145"
msgstr ""
"You didn't, hmm? I can\n"
"see in your eyes that\n"
"you're not being honest.{end_wait}"

msgctxt "message"
msgid "07146"
msgstr ""
"Oh, really? That must\n"
"have been exciting!{page_break}"
"Maybe I can join you\n"
"on your next journey?{end_now}"

msgctxt "message"
msgid "07147"
msgstr ""
"Ha ha, really?{page_break}"
"I was just kidding.\n"
"You don't need to be\n"
"so polite.{end_wait}"

msgctxt "message"
msgid "07148"
msgstr ""
"Yeah... I knew you\n"
"would say no...{end_wait}"

msgctxt "MsgValeReturnHowHaveYouBeen"
msgid "07149"
msgstr ""
"Oh, my! {actor_name:1}!\n"
"How have you been!{end_wait}"

msgctxt "MsgValeWelcomeHome"
msgid "07150"
msgstr ""
"Welcome back, {actor_name:1}!\n"
"It's good to have you\n"
"home!{end_wait}"

msgctxt "MsgValeWantToMakeFriends"
msgid "07151"
msgstr ""
"I see you made many\n"
"friends on your journey.{page_break}"
"I wish I could be\n"
"like you, {actor_name:1}.{end_wait}"

msgctxt "MsgValeEruptionMadeMess"
msgid "07152"
msgstr ""
"The eruption created\n"
"a terrible mess on the\n"
"other side of Mt. Aleph.{end_wait}"

msgctxt "MsgValeNorthwestCrack"
msgid "07153"
msgstr ""
"The eruption caused a\n"
"crack to open on Mt.\n"
"Aleph's northwest side.{end_wait}"

msgctxt "MsgValeSurprisedByEarlyReturn"
msgid "07154"
msgstr ""
"You surprised us, {actor_name:1}!\n"
"You're back sooner\n"
"than anyone expected!{end_wait}"

msgctxt "MsgValeIsaacHasGrown"
msgid "07155"
msgstr ""
"{actor_name:1} has grown so\n"
"much so quickly. He\n"
"looks splendid...{end_wait}"

msgctxt "MsgValeNewFriendsAreAdepts"
msgid "07156"
msgstr ""
"{actor_name:1}'s new friends\n"
"look interesting.{page_break}"
"I wonder if they're\n"
"Adepts, like us?{end_wait}"

msgctxt "MsgValeEruptionHeatsRiver"
msgid "07157"
msgstr ""
"Eruptions must have\n"
"great power if they\n"
"can heat a river!{end_wait}"

msgctxt "MsgValeStrangeEventsElsewhere"
msgid "07158"
msgstr ""
"I sense that Mt. Aleph is\n"
"not the only place to\n"
"see strange events.{page_break}"
"Crossing the continent\n"
"must indeed be\n"
"difficult.{end_wait}"

msgctxt "MsgValeWhenDidYouReturn"
msgid "07159"
msgstr ""
"Oh, my! When did you\n"
"return to Vale, {actor_name:1}?{end_wait}"

msgctxt "MsgValePlayTogetherAgain"
msgid "07160"
msgstr ""
"I wonder if we can play\n"
"with {actor_name:1} and his pals\n"
"again, like we used to.{end_wait}"

msgctxt "MsgValeWantToJourney"
msgid "07161"
msgstr ""
"I want to go on a\n"
"journey and make new\n"
"friends, too!{end_wait}"

msgctxt "MsgValeLavaBurntOtherSide"
msgid "07162"
msgstr ""
"A river of lava burnt\n"
"everything on the other\n"
"side of Mt. Aleph.{end_wait}"

msgctxt "MsgValeCrackWidening"
msgid "07163"
msgstr ""
"The crack on Mt. Aleph's\n"
"northwest side is\n"
"widening.{page_break}"
"At this rate, the whole\n"
"continent will split in half!{end_wait}"

msgctxt "MsgSanctumPathSolSanctumStillClosed"
msgid "07164"
msgstr ""
"The path to Sol Sanctum\n"
"is still closed.{page_break}"
"You'll have to wait\n"
"until the volcanic\n"
"activity subsides.{end_wait}"

msgctxt "MsgSanctumIsaacYourNewFriendsAdepts"
msgid "07165"
msgstr ""
"{actor_name:1}, are your new\n"
"friends Adepts by\n"
"any chance?{end_now}"

msgctxt "message"
msgid "07166"
msgstr ""
"So, there are others\n"
"besides Valeans who have\n"
"been granted Psynergy?{end_wait}"

msgctxt "message"
msgid "07167"
msgstr "......"

msgctxt "message"
msgid "07168"
msgstr "......"

msgctxt "message"
msgid "07169"
msgstr ""
"Your friend seems\n"
"angered by your\n"
"words, {actor_name:1}...{page_break}"
"That means...\n"
"they {text_effect:2}must{reset_text_style} be Adepts!{end_wait}"

msgctxt "MsgSanctumWhyIsItThatDifferentAdepts"
msgid "07170"
msgstr ""
"Why is it that different\n"
"Adepts have different\n"
"powers?{page_break}"
"Is it because they\n"
"meditate more, like\n"
"the Great Healer?{end_wait}"

msgctxt "MsgSanctumItllBeDifficultToReachSol"
msgid "07171"
msgstr ""
"It'll be difficult to reach\n"
"Sol Sanctum until Mt.\n"
"Aleph returns to normal.{end_wait}"

msgctxt "MsgSanctumISeeABeautifulGirlHas"
msgid "07172"
msgstr ""
"I see a beautiful girl\n"
"has joined {actor_name:1}\n"
"on his journey.{page_break}"
"I wonder what {actor_name:6}\n"
"will think when she\n"
"sees this.{end_wait}"

msgctxt "MsgSanctumItsNotFairIWantTo"
msgid "07173"
msgstr ""
"It's not fair! I want to\n"
"have strong Psynergy, but\n"
"I hate working for it.{end_wait}"

msgctxt "MsgValeYouCameBack"
msgid "07174"
msgstr ""
"Oh, {pause_20_skippable}it's you, {actor_name:1}.\n"
"You came back?{end_now}"

msgctxt "message"
msgid "07175"
msgstr ""
"Vale won't be very\n"
"quiet anymore...{page_break}"
"But I'm glad to see you.\n"
"Your mother, Dora, will\n"
"be, too.{end_wait}"

msgctxt "message"
msgid "07176"
msgstr ""
"Oh, you're not back for\n"
"good? That's too bad.{end_wait}"

msgctxt "MsgValeTheRumorWasTrue"
msgid "07177"
msgstr ""
"I heard you were back.\n"
"I guess the rumor was\n"
"true.{page_break}"
"Are you going to tell\n"
"us all the great tales\n"
"from your journey?{end_wait}"

msgctxt "MsgValeWhenDidYouComeBack"
msgid "07178"
msgstr ""
"{actor_name:1}! When did you\n"
"come back? After the\n"
"way you left,{page_break}"
"I thought I might\n"
"never see you again.{page_break}"
"I'm very happy to\n"
"see you.{end_wait}"

msgctxt "MsgValeOwItsGonnaBeYearsBefore"
msgid "07179"
msgstr ""
"Ow!{pause_20_skippable} It's gonna be years\n"
"before I'm a grown-up!\n"
"But {actor_name:1}'s back already!{page_break}"
"Oh...\n"
"You are just visiting...\n"
"You got me surprised.{end_wait}"

msgctxt "MsgValeWelcomeHomeIsaacOhWhatHappened"
msgid "07180"
msgstr ""
"Welcome home, {actor_name:1}!\n"
"Oh...{pause_20_skippable} ...\n"
"What happened?{page_break}"
"Why are you walking\n"
"around with some girl\n"
"who's not {actor_name:6}?{end_wait}"

msgctxt "MsgValeWeveSeenManyMonstersLatelyAnd"
msgid "07181"
msgstr ""
"We've seen many monsters\n"
"lately, and it's become\n"
"quite dangerous outside{page_break}"
"the village.\n"
"That's why weapons\n"
"are selling well.{page_break}"
"If only the blacksmiths\n"
"could make better\n"
"weapons...{end_wait}"

msgctxt "MsgValeIWishICouldLearnThe"
msgid "07182"
msgstr ""
"I wish I could learn the\n"
"secret to making\n"
"good weapons...{end_wait}"

msgctxt "MsgValeIGaveHimAFarewellGift"
msgid "07183"
msgstr ""
"I gave him a farewell\n"
"gift thinking I'd\n"
"never see him again...{page_break}"
"But I didn't have to...{page_break}"
"And wasn't he supposed\n"
"to bring {actor_name:6} back\n"
"with him...?{end_wait}"

msgctxt "MsgValeIPromisedIdBecomeAGreat"
msgid "07184"
msgstr ""
"I promised I'd become\n"
"a great blacksmith before\n"
"{actor_name:1} comes back again.{page_break}"
"It's a man's promise,\n"
"and I have to keep it.{end_wait}"

msgctxt "MsgValeThatShyGirlWithIsaacSure"
msgid "07185"
msgstr ""
"That shy girl with\n"
"{actor_name:1}{pause_20_skippable} sure looks\n"
"like a nice girl.{end_wait}"

msgctxt "MsgValeWhatHappenedToJennaHaventYou"
msgid "07186"
msgstr ""
"What happened to {actor_name:6}?\n"
"Haven't you found\n"
"her yet?{end_wait}"

msgctxt "MsgValeYouveGrownSoMuch"
msgid "07187"
msgstr ""
"Well if it isn't {actor_name:1}!{page_break}"
"You've grown so much,\n"
"I almost didn't\n"
"recognize you!{end_wait}"

msgctxt "MsgValeCameBack2"
msgid "07188"
msgstr ""
"Oh, it's you, {actor_name:1}.\n"
"You came back, huh?{end_wait}"

msgctxt "MsgValeHomeJustToStay"
msgid "07189"
msgstr ""
"You've come all the way\n"
"home just to stay\n"
"here? Are you sure?{end_now}"

msgctxt "message"
msgid "07190"
msgstr ""
"Oh, I see... You don't want\n"
"to get used to staying\n"
"at home...{page_break}"
"In that case, you're\n"
"more than welcome...{end_wait}"

msgctxt "message"
msgid "07191"
msgstr ""
"That's better! You've come\n"
"all the way back. Now,\n"
"go on home.{end_wait}"

msgctxt "MsgValeYouTraveledAroundTheEasternEdge"
msgid "07192"
msgstr ""
"You traveled around the\n"
"eastern edge of the\n"
"continent?{page_break}"
"You must be\n"
"exhausted!{end_wait}"

msgctxt "MsgValeArentYouGladToSeeThe"
msgid "07193"
msgstr ""
"Aren't you glad to see\n"
"the village hasn't\n"
"changed?{end_wait}"

msgctxt "MsgValeDoraWasStruckWithIllness"
msgid "07194"
msgstr ""
"Does {actor_name:1} know that\n"
"Dora was struck with\n"
"an illness?{end_wait}"

msgctxt "MsgValeDoraWouldntLetHimStay"
msgid "07195"
msgstr ""
"I wonder if {actor_name:1}\n"
"came here because Dora\n"
"wouldn't let him stay...{page_break}"
"Other than the mayor,\n"
"no one else knows\n"
"about Dora's illness...{end_wait}"

msgctxt "MsgValeIWonderIfIsaacWillContinue"
msgid "07196"
msgstr ""
"I wonder if {actor_name:1} will\n"
"continue his journey.\n"
"It must be quite difficult.{end_wait}"

msgctxt "MsgValeValeWillNeverChangeSoYou"
msgid "07197"
msgstr ""
"Vale will never change,\n"
"so you can come\n"
"home whenever you like.{end_wait}"

msgctxt "MsgValeHey2"
msgid "07198"
msgstr "Hey...{end_wait}"

msgctxt "message"
msgid "07199"
msgstr "What?{end_wait}"

msgctxt "message"
msgid "07200"
msgstr ""
"Shouldn't we look\n"
"for {actor_name:2}?{end_wait}"

msgctxt "message"
msgid "07201"
msgstr "Why?{end_wait}"

msgctxt "message"
msgid "07202"
msgstr ""
"{actor_name:1} still doesn't know\n"
"about Dora...{pause_20_skippable}right?\n"
"Someone should tell him.{end_wait}"

msgctxt "message"
msgid "07203"
msgstr ""
"You miss {actor_name:2}, don't you?\n"
"You're looking for an\n"
"excuse to find him.{end_wait}"

msgctxt "message"
msgid "07204"
msgstr "What? No! I just...{end_wait}"

msgctxt "message"
msgid "07205"
msgstr ""
"{text_effect:4}Guh...{pause_20_skippable}{pause_20_skippable} "
"Gah...{pause_20_skippable} Ugh...{end_wait}"

msgctxt "message"
msgid "07206"
msgstr ""
"Grandma! What's the\n"
"matter? Are you\n"
"choking?{end_wait}"

msgctxt "message"
msgid "07207"
msgstr "It's... It's {actor_name:2}!{end_wait}"

msgctxt "message"
msgid "07208"
msgstr ""
"She must miss\n"
"{actor_name:2}, too...{end_wait}"

msgctxt "message"
msgid "07209"
msgstr ""
"No, it's really {actor_name:2}!\n"
"Look, look!{end_wait}"

msgctxt "message"
msgid "07210"
msgstr "{actor_name:2}!{end_now}"

msgctxt "message"
msgid "07211"
msgstr "Oh, {actor_name:2}...!{end_now}"

msgctxt "message"
msgid "07212"
msgstr "Mom, Dad...{pause_20_skippable} I'm home...{end_wait}"

msgctxt "message"
msgid "07213"
msgstr "What,{pause_20_skippable} {actor_name:2}?{end_wait}"

msgctxt "message"
msgid "07214"
msgstr "Oh, {actor_name:2}...!{end_wait}"

msgctxt "message"
msgid "07215"
msgstr ""
"Grandpa,\n"
"I'm home...{end_wait}"

msgctxt "message"
msgid "07216"
msgstr ""
"Yes, yes...{pause_20_skippable} Did you\n"
"complete your mission\n"
"for the Wise One?{end_now}"

msgctxt "message"
msgid "07217"
msgstr ""
"Oh, you mean it's going\n"
"well? You probably have\n"
"to continue on soon, then.{end_wait}"

msgctxt "message"
msgid "07218"
msgstr ""
"Not yet? Well, I'm glad\n"
"you're home, even if it's\n"
"just for a little while...{end_wait}"

msgctxt "MsgValeYoureLeavingAgainSoon"
msgid "07219"
msgstr ""
"You're leaving again\n"
"soon...aren't you?{end_wait}"

msgctxt "message"
msgid "07220"
msgstr ""
"I'm just glad to see\n"
"you're doing well!{end_wait}"

msgctxt "message"
msgid "07221"
msgstr "That's right.{end_wait}"

msgctxt "message"
msgid "07222"
msgstr ""
"Let me introduce you\n"
"to my new friends.{end_wait}"

msgctxt "message"
msgid "07223"
msgstr ""
"Umm...{pause_20_skippable} I am {actor_name:3}.\n"
"Pleased to meet you.{end_wait}"

msgctxt "message"
msgid "07224"
msgstr ""
"I am {actor_name:4}, from Imil.\n"
"Nice to meet you.{end_wait}"

msgctxt "message"
msgid "07225"
msgstr ""
"Nice to meet you.\n"
"Please look after\n"
"young {actor_name:2} for us.{end_wait}"

msgctxt "message"
msgid "07226"
msgstr ""
"Well{pause_20_skippable}, enough chit-chat.\n"
"Relax and enjoy your\n"
"stay here...{end_wait}"

msgctxt "MsgValeMiaIsSuchANiceGirl"
msgid "07227"
msgstr ""
"{actor_name:4} is such a\n"
"nice girl.{page_break}"
"I wonder who {actor_name:2}\n"
"likes more, {actor_name:4} or\n"
"{actor_name:6}...{end_wait}"

msgctxt "MsgValeThatIvanSeemsToBeA"
msgid "07228"
msgstr ""
"That {actor_name:3} seems to be\n"
"a smart boy...{page_break}"
"I wish you could be more\n"
"like {actor_name:3}, {actor_name:2}.{end_wait}"

msgctxt "MsgValeDidYouHearAboutDora"
msgid "07229"
msgstr ""
"Did you hear us talking\n"
"about Dora just now?{end_now}"

msgctxt "message"
msgid "07230"
msgstr ""
"Dora told us not to\n"
"worry...that it's just\n"
"a fever.{page_break}"
"Don't worry too much,\n"
"{actor_name:1}.{end_wait}"

msgctxt "message"
msgid "07231"
msgstr ""
"You didn't hear? But you\n"
"look concerned.{page_break}"
"We'll be looking after\n"
"your mother, so don't\n"
"worry.{end_wait}"

msgctxt "MsgValeHopeDidntGet"
msgid "07232"
msgstr ""
"I hope you didn't get\n"
"sick during your\n"
"travels...{page_break}"
"{actor_name:2} always eats\n"
"too much... He always\n"
"makes his mother worry.{end_wait}"

msgctxt "MsgValeItMustBeNiceToBe"
msgid "07233"
msgstr ""
"It must be nice to be\n"
"young and gallivant\n"
"about with lovely girls!{end_wait}"

msgctxt "MsgValeHisNewFriendsAreAllSo"
msgid "07234"
msgstr ""
"His new friends are all\n"
"so polite. I'm very happy\n"
"to see that.{end_wait}"

msgctxt "MsgValeItWasntTooSmartToTalk"
msgid "07235"
msgstr ""
"It wasn't too smart to\n"
"talk about Dora without\n"
"checking for {actor_name:1}.{page_break}"
"I wish we could tell\n"
"him the truth.{end_wait}"

msgctxt "MsgValeGaretSeemsToHaveGrownUp"
msgid "07236"
msgstr ""
"{actor_name:2} seems to have\n"
"grown up a bit on\n"
"this difficult journey.{end_wait}"

msgctxt "MsgValeAh"
msgid "07237"
msgstr "Ah!{end_wait}"

msgctxt "message"
msgid "07238"
msgstr "It's been a while...{end_wait}"

msgctxt "message"
msgid "07239"
msgstr "You're back?{end_wait}"

msgctxt "message"
msgid "07240"
msgstr ""
"Have you gone home\n"
"to see Dad yet?{end_now}"

msgctxt "message"
msgid "07241"
msgstr ""
"Really?{pause_20_skippable} He must have\n"
"been happy to see you.{page_break}"
"He has been so\n"
"worried about you.{end_wait}"

msgctxt "message"
msgid "07242"
msgstr ""
"You have to see him...{pause_20_skippable}\n"
"He's been worried\n"
"about you.{end_wait}"

msgctxt "message"
msgid "07243"
msgstr "...{pause_20_skippable}So have I.{end_wait}"

msgctxt "message"
msgid "07244"
msgstr "Sis...{end_wait}"

msgctxt "message"
msgid "07245"
msgstr ""
"Don't get me wrong.{pause_20_skippable} I...\n"
"I was just worried you\n"
"might get into trouble,{page_break}"
"because, you know,\n"
"you're not that bright...{end_wait}"

msgctxt "message"
msgid "07246"
msgstr ""
"Yeah, all right...\n"
"Thanks, Sis.{end_wait}"

msgctxt "message"
msgid "07247"
msgstr ""
"So, {pause_20_skippable}{pause_20_skippable}are you home\n"
"for good? Or...{end_wait}"

msgctxt "message"
msgid "07248"
msgstr "Not just yet...{end_wait}"

msgctxt "message"
msgid "07249"
msgstr ""
"You're leaving...{pause_20_skippable}\n"
"again?{end_wait}"

msgctxt "message"
msgid "07250"
msgstr ""
"Don't push yourself too\n"
"hard...{pause_20_skippable}when you\n"
"leave again.{end_wait}"

msgctxt "MsgValeHowHaveYouBeen"
msgid "07251"
msgstr "Hey, how have you been?{end_wait}"

msgctxt "message"
msgid "07252"
msgstr ""
"Oh,{pause_20_skippable} {actor_name:2}!\n"
"And {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "07253"
msgstr ""
"What happened!?\n"
"You're back already!?{end_wait}"

msgctxt "message"
msgid "07254"
msgstr ""
"Already? What kind of\n"
"way is that to\n"
"greet us?{end_wait}"

msgctxt "message"
msgid "07255"
msgstr ""
"But{em_dash}But they said\n"
"you might never come\n"
"back!{end_wait}"

msgctxt "message"
msgid "07256"
msgstr ""
"And it still seems like\n"
"you're not back for good,\n"
"like you're just visiting.{end_wait}"

msgctxt "message"
msgid "07257"
msgstr ""
"Really?{pause_20_skippable} Is that\n"
"what it seems like?{end_wait}"

msgctxt "message"
msgid "07258"
msgstr ""
"Yeah... You and your\n"
"friends... You all look like\n"
"you are about to leave.{end_wait}"

msgctxt "message"
msgid "07259"
msgstr ""
"You're smarter than\n"
"you look.{end_wait}"

msgctxt "message"
msgid "07260"
msgstr ""
"I have to shape up\n"
"while you're gone, right?\n"
"If not...{end_wait}"

msgctxt "message"
msgid "07261"
msgstr ""
"Hey, the family'll be fine,\n"
"as long as you're here!\n"
"Am I right, or what?{end_now}"

msgctxt "message"
msgid "07262"
msgstr ""
"Take care of our family\n"
"while I'm gone.\n"
"All right?{end_wait}"

msgctxt "message"
msgid "07263"
msgstr ""
"Hey! You're not\n"
"helping here!{end_wait}"

msgctxt "MsgValeEverProtectFamily"
msgid "07264"
msgstr ""
"WHAT{pause_20_skippable}EVER{pause_20_skippable} YOU{pause_20_skippable} "
"DO{pause_20_skippable},\n"
"you must protect the\n"
"family while I'm gone.{page_break}"
"All right? I'm counting\n"
"on you!{end_wait}"

msgctxt "message"
msgid "07265"
msgstr ""
"Don't push yourself\n"
"too hard,{pause_20_skippable}{pause_20_skippable} OK?{end_wait}"

msgctxt "MsgValeICanTellJustByLooking"
msgid "07266"
msgstr ""
"I can tell just by looking\n"
"at you that you've been\n"
"through a lot.{page_break}"
"You look so much\n"
"more mature now.{end_wait}"

msgctxt "MsgValeIWillDoMyBestTo"
msgid "07267"
msgstr ""
"I will do my best to\n"
"show everyone that I\n"
"am strong enough{page_break}"
"to protect our family\n"
"and Vale.{end_wait}"

msgctxt "MsgValeYouGuysAreWorkingSoHard"
msgid "07268"
msgstr ""
"You guys are working so\n"
"hard, but I'm worried.\n"
"Are you really all right?{end_wait}"

msgctxt "MsgValeICouldGoWithYouIf"
msgid "07269"
msgstr ""
"I could go with you if I\n"
"were a little older...\n"
"It's not fair...{end_wait}"

msgctxt "MsgValeCoughCoughWho"
msgid "07270"
msgstr ""
"{text_effect:4}Cough, cough{pause_20_skippable}{pause_20_skippable}! "
"{reset_text_style}Who is it?{pause_20_skippable}\n"
"Is it the innkeeper?{pause_20_skippable}{pause_20_skippable}\n"
"Is it time to eat?{end_wait}"

msgctxt "message"
msgid "07271"
msgstr ""
"No? "
"{text_effect:4}Cough...{reset_text_style}{pause_20_skippable}"
"{pause_20_skippable}"
"\n"
"Then who{em_dash}{end_wait}"

msgctxt "message"
msgid "07272"
msgstr "{actor_name:1}...{end_wait}"

msgctxt "message"
msgid "07273"
msgstr ""
"Are you finally home?\n"
"Have you completed\n"
"your mission!?{end_wait}"

msgctxt "message"
msgid "07274"
msgstr "You haven't, have you?{end_wait}"

msgctxt "message"
msgid "07275"
msgstr ""
"Have you forgotten your\n"
"promise, {actor_name:1}?{end_wait}"

msgctxt "message"
msgid "07276"
msgstr ""
"You promised you wouldn't\n"
"come back until your\n"
"quest was complete, right?{end_now}"

msgctxt "message"
msgid "07277"
msgstr ""
"You broke your promise\n"
"because you were worried\n"
"about me?{end_wait}"

msgctxt "message"
msgid "07278"
msgstr ""
"You were more worried\n"
"about me than about\n"
"keeping your promise?{end_wait}"

msgctxt "MsgValeWhoToldIll"
msgid "07279"
msgstr ""
"Who told you I was ill?\n"
"The mayor? Or {text_effect:4}cough{reset_text_style}\n"
"...was it the innkeeper?{end_now}"

msgctxt "message"
msgid "07280"
msgstr ""
"So you came because\n"
"you were worried after\n"
"hearing about me.{end_wait}"

msgctxt "message"
msgid "07281"
msgstr ""
"Are you telling me\n"
"you were surprised to\n"
"see me in bed?{end_wait}"

msgctxt "message"
msgid "07282"
msgstr ""
"You can't get out of your\n"
"promises just because\n"
"you're worried about me.{page_break}"
"{text_effect:4}Cough...{reset_text_style}{end_wait}"

msgctxt "message"
msgid "07283"
msgstr ""
"I... {text_effect:4}Cough...{reset_text_style}{pause_20_skippable}\n"
"I just caught a\n"
"cold. That's all.{end_wait}"

msgctxt "message"
msgid "07284"
msgstr ""
"But I'm fine now. {pause_20_skippable}{pause_20_skippable}\n"
"{text_effect:4}Cough...{reset_text_style}{pause_20_skippable} Look!{end_wait}"

msgctxt "message"
msgid "07285"
msgstr "See?{pause_20_skippable} I'm fine!{end_wait}"

msgctxt "message"
msgid "07286"
msgstr ""
"Don't worry about me.\n"
"Go on. Do your best to\n"
"complete your quest.{pause_20_skippable}{pause_20_skippable} OK?{end_wait}"

msgctxt "MsgValeDontWorryBest"
msgid "07287"
msgstr ""
"Don't you worry about\n"
"me. Just do your best\n"
"to complete your quest.{page_break}"
"{text_effect:4}Cough cough...{reset_text_style}{end_wait}"

msgctxt "MsgValeImSorryISeemedSoHarsh"
msgid "07288"
msgstr ""
"I'm sorry I seemed so\n"
"harsh, {actor_name:1}...{page_break}"
"I'm so happy to see you.\n"
"I'll be waiting for you to\n"
"come home for good...{end_wait}"

msgctxt "MsgValeUnnOhhKyle"
msgid "07289"
msgstr ""
"{text_effect:4}Unn...{pause_20_skippable} "
"Ohh...{pause_20_skippable}{pause_20_skippable}\n"
"Kyle...{pause_20_skippable} Don't go...{end_wait}"

msgctxt "message"
msgid "07290"
msgstr ""
"I think Dora\n"
"is dreaming.{end_wait}"

msgctxt "MsgValeKyleWatchOutTheBoulderThe"
msgid "07291"
msgstr ""
"Kyle, watch out!{pause_20_skippable}{pause_20_skippable}\n"
"The boulder!!!{pause_20_skippable}\n"
"The boulder...{end_wait}"

msgctxt "MsgValeOhSoYouStillHaventRescued"
msgid "07292"
msgstr ""
"Oh, so you still haven't\n"
"rescued {actor_name:6}...{end_wait}"

msgctxt "MsgValeIGetOverColdsQuicklyBut"
msgid "07293"
msgstr ""
"I get over colds quickly.{page_break}"
"But it sure is taking\n"
"Dora a long time to\n"
"recover from hers.{end_wait}"

msgctxt "MsgValeAColdIsGoingAroundI"
msgid "07294"
msgstr ""
"A cold is going around.\n"
"I should be careful.{end_wait}"

msgctxt "MsgValeWillIEverSeeJennaAnd"
msgid "07295"
msgstr ""
"Will I ever see {actor_name:6}\n"
"and {actor_name:5} again\n"
"before I die?{end_wait}"

msgctxt "MsgValeDoraSaysItsJustACold"
msgid "07296"
msgstr ""
"Dora says it's just a\n"
"cold, but she's been like\n"
"this ever since...{page_break}"
"{actor_name:1} left...\n"
"It's taking her so\n"
"long to recover...{end_wait}"

msgctxt "MsgValeIKnowThatThereAreAlways"
msgid "07297"
msgstr ""
"I know that there are\n"
