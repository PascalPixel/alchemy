msgctxt "message"
msgid "03156"
msgstr ""
"I am a Venus Djinni.\n"
"My name is "
"{text_color:yellow}{argument_ability_name}{text_color:white}.{end_wait}"

msgctxt "message"
msgid "03157"
msgstr ""
"I must find my comrades.{page_break}"
"We were separated from\n"
"each other when the\n"
"volcano erupted.{end_wait}"

msgctxt "message"
msgid "03158"
msgstr ""
"...Maybe you can help\n"
"gather my friends\n"
"together as you travel.{end_wait}"

msgctxt "message"
msgid "03159"
msgstr ""
"If you let me join you,\n"
"I'll prove to be very\n"
"beneficial to you Adepts!{end_wait}"

msgctxt "message"
msgid "03160"
msgstr ""
"Your Psynergy will grow\n"
"stronger, and your Adept\n"
"skills will also improve.{end_wait}"

msgctxt "message"
msgid "03161"
msgstr ""
