msgctxt "message"
msgid "06089"
msgstr "C'est Xian. Voyageurs,{line_break}bienvenue! Reposez-vous.{line_break}Restez longtemps.{end_wait}"

msgctxt "message"
msgid "06090"
msgstr "Jeunes guerriers,{line_break}bravo!{page_break}Vous avez traversé{line_break}la forêt de Mogall?{end_now}"

msgctxt "message"
msgid "06091"
msgstr "Incroyable.{line_break}Je respecte vos{line_break}hauts faits.{end_wait}"

msgctxt "message"
msgid "06092"
