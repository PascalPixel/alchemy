msgctxt "message"
msgid "09865"
msgstr "Ya veo. Faran también...{end_wait}"

msgctxt "message"
msgid "09866"
msgstr ""
"¡{actor_name:1}! Debemos ir\n"
"al Faro de Babi también.{end_wait}"

msgctxt "message"
msgid "09867"
msgstr ""
"¿Te preocupan\n"
