msgstr ""
"Mont Alpha, temple de\n"
"Sol...{pause_20_skippable} Etes-vous\n"
"des guérisseurs du{page_break}"
"temple de Sol?"

#, alchemy-end-wait
msgctxt "message"
msgid "05507"
msgstr ""
"Nous venons d'un village\n"
"appelé Val pour récupérer\n"
"les Etoiles Elémentaires."

#, alchemy-end-wait
msgctxt "message"
msgid "05508"
msgstr ""
"Mais contrairement à\n"
"toi, nous ne sommes\n"
"pas guérisseurs."

#, alchemy-end-wait
msgctxt "message"
msgid "05509"
msgstr ""
"Nous venons du Mont\n"
"Alpha, mais nous ne\n"
"sommes pas guérisseurs."

#, alchemy-end-wait
msgctxt "message"
msgid "05510"
msgstr ""
"Nous venons d'un village\n"
"appelé Val pour récupérer\n"
"les Etoiles Elémentaires."

#, alchemy-end-wait
msgctxt "message"
msgid "05511"
msgstr "Vous avez dit{pause_20_skippable} Val?"

#, alchemy-end-wait
msgctxt "message"
msgid "05512"
msgstr ""
"Notre village était là\n"
"pour défendre le temple\n"
"de Sol, mais les{page_break}"
"Etoiles ont été volées."

#, alchemy-end-wait
msgctxt "message"
msgid "05513"
msgstr ""
"Ca ressemble à\n"
"mon Clan..."

#, alchemy-end-wait
msgctxt "message"
msgid "05514"
msgstr ""
"J'ai échoué dans ma\n"
"tâche... C'est terrible."

#, alchemy-end-wait
msgctxt "message"
msgid "05515"
msgstr "{actor_name:1}! {actor_name:2}!"

#, alchemy-end-wait
msgctxt "message"
msgid "05516"
msgstr "Alors c'est toi, {actor_name:1}!"

#, alchemy-end-wait
msgctxt "message"
msgid "05517"
msgstr ""
"Hé! Hé! Ces enfants sont\n"
"encore vivants?"

#, alchemy-end-wait
msgctxt "message"
msgid "05518"
msgstr ""
"Vous avez fait tout ce\n"
"chemin pour sauver\n"
"{actor_name:6} et Thélos?"

#, alchemy-end-wait
msgctxt "message"
msgid "05519"
msgstr ""
"Ca n'est pas tout...\n"
"Nous sommes après les\n"
"Etoiles Elémentaires!"

#, alchemy-end-wait
msgctxt "message"
msgid "05520"
msgstr ""
"En d'autres termes,{pause_20_skippable} ils\n"
"sont venus nous arrêter."

#, alchemy-end-wait
msgctxt "message"
msgid "05521"
msgstr ""
"Nous n'avons pas le choix...{page_break}"
"Débarrassons-nous d'eux\n"
"maintenant avant qu'ils\n"
"nous nuisent!"

#, alchemy-end-wait
msgctxt "message"
msgid "05522"
msgstr "Phoenixia... {pause_20_skippable}Attends!"

#, alchemy-end-wait
msgctxt "message"
msgid "05523"
msgstr ""
"Oh! Salamandar...\n"
"Ils veulent..."

#, alchemy-end-wait
msgctxt "message"
msgid "05524"
msgstr "J'ai tout entendu."

#, alchemy-end-wait
msgctxt "message"
msgid "05525"
msgstr ""
"Ils ont eu de la\n"
"chance de survivre\n"
"à l'éruption du{page_break}"
"Mont Alpha."

#, alchemy-end-wait
msgctxt "message"
msgid "05526"
msgstr ""
"Vous avez enduré tant de\n"
"choses et vous voulez\n"
"gâcher vos vies?"

#, alchemy-end-wait
msgctxt "message"
msgid "05527"
msgstr ""
"Bien. Si tel est\n"
"votre souhait, je\n"
"vais l'exaucer."

#, alchemy-end-wait
msgctxt "message"
msgid "05528"
msgstr ""
"Salamandar... Tu vas te\n"
"battre contre eux\n"
"tout seul?"

#, alchemy-end-wait
msgctxt "message"
msgid "05529"
msgstr ""
"Phoenixia, tu ne peux\n"
"pas laisser nos otages\n"
"et m'aider, n'est-ce pas?"

#, alchemy-end-wait
msgctxt "message"
msgid "05530"
msgstr "Hum...{pause_20_skippable} C'est vrai..."

#, alchemy-end-wait
msgctxt "message"
msgid "05531"
msgstr ""
"De plus, je veux\n"
"voir quel niveau\n"
"ils ont atteint."

#, alchemy-end-wait
msgctxt "message"
msgid "05532"
msgstr ""
"En es-tu certain,\n"
"Salamandar?"

#, alchemy-end-wait
msgctxt "message"
msgid "05533"
msgstr ""
"Laissez-moi!{pause_20_skippable} Dirigez-vous\n"
"vers le prochain phare!"

#, alchemy-end-wait
msgctxt "message"
msgid "05534"
msgstr "Venez par ici..."

#, alchemy-end-wait
msgctxt "message"
msgid "05535"
msgstr ""
"Vous voulez me\n"
"défier?"

#, alchemy-end-wait
msgctxt "message"
msgid "05536"
msgstr ""
"Je devrais vous donner\n"
"une leçon, mais..."

#, alchemy-end-wait
msgctxt "message"
msgid "05537"
msgstr ""
"{actor_name:5}, tu devrais\n"
"m'obéir si tu veux\n"
"qu'elle s'en tire."

#, alchemy-end-wait
msgctxt "message"
msgid "05538"
msgstr ""
"{actor_name:6}{pause_20_skippable}...\n"
"Fais ce qu'elle te dit\n"
"pour le moment."

#, alchemy-end-wait
msgctxt "message"
msgid "05539"
msgstr ""
"{actor_name:5}{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}"
"."

#, alchemy-end-wait
msgctxt "message"
msgid "05540"
msgstr "Ca va, {actor_name:6}."

#, alchemy-end-wait
msgctxt "message"
msgid "05541"
msgstr ""
"{actor_name:1} et {actor_name:2}\n"
"n'auraient pas dû\n"
"nous poursuivre..."

#, alchemy-end-wait
msgctxt "message"
msgid "05542"
msgstr ""
"Pardon, {actor_name:1},\n"
"{actor_name:2}..."

#, alchemy-end-wait
msgctxt "message"
msgid "05543"
msgstr "Je compte sur vous!"

#, alchemy-end-wait
msgctxt "message"
msgid "05544"
msgstr ""
"{actor_name:1}! {actor_name:2}!\n"
"Ne{pause_20_skippable} mourez{pause_20_skippable} pas!"

#, alchemy-end-wait
msgctxt "message"
msgid "05545"
msgstr ""
"{actor_name:6}... \n"
"Thélos!"

#, alchemy-end-wait
msgctxt "message"
msgid "05546"
msgstr ""
"Si vous voulez les\n"
"sauver, il faudra\n"
"me battre d'abord!"

#, alchemy-end-wait
msgctxt "message"
msgid "05547"
msgstr "Non! Reculez!"

#, alchemy-end-wait
msgctxt "message"
msgid "05548"
msgstr "Qu'y a-t-il?"

#, alchemy-end-wait
msgctxt "message"
msgid "05549"
msgstr ""
"Salamandar est redoutable.\n"
"Je l'ai senti rien\n"
"qu'en le regardant."

#, alchemy-end-wait
msgctxt "message"
msgid "05550"
msgstr ""
"Vous devrez faire attention\n"
"en l'affrontant...{page_break}"
"Nous devrons être à\n"
"la hauteur..."

#, alchemy-end-now
msgctxt "message"
msgid "05551"
msgstr ""
"Me surpasser, moi?\n"
"Vous pensez vraiment\n"
"accomplir un tel exploit?"

#, alchemy-end-wait
msgctxt "message"
msgid "05552"
msgstr ""
"Vous surestimez\n"
"vos capacités."

#, alchemy-end-wait
msgctxt "message"
msgid "05553"
msgstr ""
"Et vous persistez à\n"
"vouloir vous battre?\n"
"Bande d'inconscients..."

#, alchemy-end-wait
msgctxt "message"
msgid "05554"
msgstr ""
"Bien... Je vais vous\n"
"donner une bonne leçon!"

#, alchemy-end-wait
msgctxt "message"
msgid "05555"
msgstr ""
"Que se passe-t-il?\n"
"Salamandar se déplace\n"
"bizarrement."

#, alchemy-end-wait
msgctxt "message"
msgid "05556"
msgstr ""
"Quoi? La lumière de\n"
"Mercure... Elle\n"
"affaiblit ma Psynergie!"

#, alchemy-end-wait
msgctxt "message"
msgid "05557"
msgstr ""
"Je dois en finir au\n"
"plus vite... Allons-y!"

#, alchemy-end-wait
msgctxt "MsgMercuryGot"
msgid "05558"
msgstr "{actor_name:1}, on l'a eu!"

#, alchemy-end-wait
msgctxt "message"
msgid "05559"
msgstr ""
"Qui aurait cru que le\n"
"Phare de Mercure détenait\n"
"une telle puissance?{page_break}"
"Si seulement ma\n"
"Psynergie avait été à\n"
"son meilleur niveau..."

#, alchemy-end-wait
msgctxt "message"
msgid "05560"
msgstr ""
"Salamandar... Tu as dit\n"
"que tu avais été affaibli.\n"
"Que veux-tu dire?"

#, alchemy-end-wait
msgctxt "message"
msgid "05561"
msgstr ""
"Je{pause_20_skippable}.{pause_20_skippable}.{pause_20_skippable}."
"{pause_20_skippable} n'ai rien voulu dire..."

#, alchemy-end-wait
msgctxt "message"
msgid "05562"
msgstr ""
"Je vais vous expliquer\n"
"ce qu'il a dit..."

#, alchemy-end-wait
msgctxt "message"
msgid "05563"
msgstr "Cette voix! Se pourrait-il..."

#, alchemy-end-wait
msgctxt "message"
msgid "05564"
msgstr "Alex!"

#, alchemy-end-wait
msgctxt "message"
msgid "05565"
msgstr "Ca faisait longtemps, {actor_name:4}."

#, alchemy-end-wait
msgctxt "message"
msgid "05566"
msgstr ""
"Alex, te rends-tu compte\n"
"de ce que tu as fait?"

#, alchemy-end-wait
msgctxt "message"
msgid "05567"
msgstr ""
"Ha! Bien sûr... J'ai\n"
"libéré un pouvoir scellé\n"
"depuis des lustres."

#, alchemy-end-wait
msgctxt "message"
msgid "05568"
msgstr ""
"Mercure, le phare de\n"
"l'Eau...\n"
"Quelle puissance!"

#, alchemy-end-wait
msgctxt "message"
msgid "05569"
msgstr ""
"Alex, tu...\n"
"Tu es cinglé!"

#, alchemy-end-wait
msgctxt "message"
msgid "05570"
msgstr ""
"Non, {actor_name:4}...\n"
"Ne comprends-tu pas?"

#, alchemy-end-wait
msgctxt "message"
msgid "05571"
msgstr ""
"Le phare vous a donné\n"
"de grands pouvoirs\n"
"pendant votre combat{page_break}"
"contre Salamandar."

#, alchemy-end-wait
msgctxt "message"
msgid "05572"
msgstr ""
"C'est vrai...\n"
"Je pouvais utiliser mon\n"
"pouvoir sans l'épuiser."

#, alchemy-end-wait
msgctxt "message"
msgid "05573"
msgstr ""
"Tu ne comprends pas?{page_break}"
"Le Phare de Mercure\n"
"t'a donné un peu de\n"
"sa Psynergie illimitée."

#, alchemy-end-wait
msgctxt "message"
msgid "05574"
msgstr ""
"Psynergie? Tu veux dire\n"
"que mes pouvoirs viennent\n"
"de la Psynergie?"

#, alchemy-end-wait
msgctxt "message"
msgid "05575"
msgstr ""
"Nous sommes tous deux\n"
"des membres du Clan\n"
"de Mercure...{page_break}"
"Maîtres de la\n"
"Psynergie Eau."

#, alchemy-end-now
msgctxt "message"
msgid "05576"
msgstr ""
"{actor_name:4} est aussi\n"
"une mystique, hein?"

#, alchemy-end-wait
msgctxt "message"
msgid "05577"
msgstr ""
"{actor_name:1}! Tu le savais\n"
"depuis le début et\n"
"tu ne nous as rien dit?"

#, alchemy-end-wait
msgctxt "message"
msgid "05578"
msgstr ""
"Je sais que c'est\n"
"difficile à croire, mais\n"
"on dirait que {actor_name:4}{page_break}"
"est l'une d'entre nous."

#, alchemy-end-wait
msgctxt "message"
msgid "05579"
msgstr ""
"Dis-moi, Alex...\n"
"Pourquoi Salamandar\n"
"n'a pas pu se servir{page_break}"
"de tout son pouvoir?"

#, alchemy-end-wait
msgctxt "message"
msgid "05580"
msgstr ""
"Ah! Oui...\n"
"Je vais tout vous expliquer."

#, alchemy-end-wait
msgctxt "message"
msgid "05581"
msgstr ""
"Salamandar est en\n"
"symbiose avec Mars,\n"
"le Clan du Feu."

#, alchemy-end-wait
msgctxt "message"
msgid "05582"
msgstr ""
"Le feu et l'eau sont\n"
"des éléments opposés...{page_break}"
"La Psynergie Eau du\n"
"phare entravait son\n"
"pouvoir."

#, alchemy-end-wait
msgctxt "message"
msgid "05583"
msgstr ""
"Salamandar ne le\n"
"savait pas?"

#, alchemy-end-wait
msgctxt "message"
msgid "05584"
msgstr "Bien sûr qu'il savait."

#, alchemy-end-wait
msgctxt "message"
msgid "05585"
msgstr ""
"Mais il a mal jaugé\n"
"la puissance de ce\n"
"phare."

#, alchemy-end-wait
msgctxt "message"
msgid "05586"
msgstr "Comme moi..."

#, alchemy-end-wait
msgctxt "message"
msgid "05587"
msgstr ""
"C'est pour ça qu'on\n"
"a pu battre Salamandar?"

#, alchemy-end-wait
msgctxt "message"
msgid "05588"
msgstr ""
"Non...\n"
"Il y a autre chose."

#, alchemy-end-wait
msgctxt "message"
msgid "05589"
msgstr ""
"J'ai observé votre\n"
"combat à distance..."

#, alchemy-end-wait
msgctxt "message"
msgid "05590"
msgstr "Tu nous observais?"

#, alchemy-end-wait
msgctxt "message"
msgid "05591"
msgstr ""
"Oui. Je n'ai pas aidé\n"
"Salamandar, car j'étais\n"
"sûr qu'il gagnerait."

#, alchemy-end-wait
msgctxt "message"
msgid "05592"
msgstr ""
"Mais je me suis trompé...\n"
"Vous êtes devenus de\n"
"grands guerriers en{page_break}"
"bien peu de temps."

#, alchemy-end-wait
msgctxt "message"
msgid "05593"
msgstr ""
"Salamandar est encore debout!\n"
"Mais nous l'avons battu!"

#, alchemy-end-wait
msgctxt "message"
msgid "05594"
msgstr ""
"Moi? Battu? Jamais!\n"
"J'ai perdu contre ce\n"
"phare, pas contre vous!"

#, alchemy-end-wait
msgctxt "message"
msgid "05595"
msgstr ""
"Je ne faisais que\n"
"gagner du temps\n"
"pour permettre à{page_break}"
"Salamandar de récupérer\n"
"sa force."

#, alchemy-end-wait
msgctxt "message"
msgid "05596"
msgstr ""
"Tu gagnais du temps?\n"
"Ca n'est pas juste,\n"
"Alex!"

#, alchemy-end-wait
msgctxt "message"
msgid "05597"
msgstr ""
"Je ne laisserai pas\n"
"fuir Salamandar!"

#, alchemy-end-now
msgctxt "message"
msgid "05598"
msgstr ""
"Et qu'allez-vous\n"
"faire? Allez-vous{pause_20_skippable}\n"
"l'achever?"

#, alchemy-end-wait
msgctxt "message"
msgid "05599"
msgstr ""
"Dans ce cas, vous\n"
"devrez me combattre.{page_break}"
"Et vu votre niveau,\n"
"vous n'avez pas la\n"
"moindre chance."

#, alchemy-end-wait
msgctxt "message"
msgid "05600"
msgstr ""
"Oui, {actor_name:1}. Tu as\n"
"l'air malin.{page_break}"
"Tu sais que tu ne\n"
"peux battre nos forces\n"
"combinées maintenant{page_break}"
"que nous avons vu\n"
"ta technique."

#, alchemy-end-wait
msgctxt "message"
msgid "05601"
msgstr ""
"Et je doute que tu\n"
"sois du genre à\n"
"achever quelqu'un!"

#, alchemy-end-wait
msgctxt "message"
msgid "05602"
msgstr ""
"Bien sûr, tu es\n"
"libre de ton choix..."

#, alchemy-end-wait
msgctxt "message"
msgid "05603"
msgstr ""
"Il s'est téléporté\n"
"à nouveau!"

#, alchemy-end-wait
msgctxt "message"
msgid "05604"
msgstr ""
"A nouveau?{pause_20_skippable}\n"
"Il l'a déjà fait?"

#, alchemy-end-wait
msgctxt "message"
msgid "05605"
msgstr "Oui, au temple de Sol..."

#, alchemy-end-wait
msgctxt "message"
msgid "05606"
msgstr ""
"Cette Psynergie...\n"
"La téléportation...\n"
"Ca voudrait dire que{page_break}"
"{actor_name:4} peut\n"
"s'en servir?"

#, alchemy-end-wait
msgctxt "message"
msgid "05607"
msgstr ""
"Non, c'est impossible.\n"
"Même Alex n'avait pas\n"
"ce genre de pouvoirs."

#, alchemy-end-wait
msgctxt "message"
msgid "05608"
msgstr ""
"Et bien... Je ne pouvais\n"
"rester l'Alex que tu\n"
"connaissais..."

#, alchemy-end-wait
msgctxt "message"
msgid "05609"
msgstr ""
"Bien, on dirait que\n"
"mon ascenseur est\n"
"enfin revenu."

#, alchemy-end-wait
msgctxt "message"
msgid "05610"
msgstr "Adieu!"

#, alchemy-end-wait
msgctxt "message"
msgid "05611"
msgstr ""
"{actor_name:1}, Salamandar\n"
"a toujours les\n"
"Etoiles Elémentaires!"

#, alchemy-end-wait
msgctxt "message"
msgid "05612"
msgstr ""
"C'est vrai!\n"
"Nous ne pouvons\n"
"pas les laisser partir!"

#, alchemy-end-now
msgctxt "message"
msgid "05613"
msgstr ""
"Oh? Et vous voulez\n"
"lui prendre les Etoiles\n"
"Elémentaires?"

#, alchemy-end-wait
msgctxt "message"
msgid "05614"
msgstr ""
"Ha! Dommage!\n"
"C'est Phoenixia qui\n"
"les a. Demandez-les lui!"

#, alchemy-end-wait
msgctxt "message"
msgid "05615"
msgstr ""
"Ha! Tu as raison...\n"
"Phoenixia a les\n"
"Etoiles Elémentaires!"

#, alchemy-end-wait
msgctxt "message"
msgid "05616"
msgstr "Au fait..."

#, alchemy-end-now
msgctxt "message"
msgid "05617"
msgstr ""
"Vous avez toujours\n"
"l'Etoile de Mars?"

#, alchemy-end-wait
msgctxt "message"
msgid "05618"
msgstr ""
"J'apprécie votre\n"
"franchise."

#, alchemy-end-wait
msgctxt "message"
msgid "05619"
msgstr ""
"Vous me dites la vérité?\n"
"Bien, je vous crois\n"
"pour l'instant."

#, alchemy-end-now
msgctxt "message"
msgid "05620"
msgstr ""
"Je suppose que vous nous\n"
"poursuivrez pour les\n"
"Etoiles Elémentaires?"

#, alchemy-end-wait
msgctxt "message"
msgid "05621"
msgstr ""
"Très bien.\n"
"Nous nous reverrons\n"
"bientôt, alors."

#, alchemy-end-wait
msgctxt "message"
msgid "05622"
msgstr ""
"Tant pis...\n"
"J'espère qu'on se\n"
"reverra un jour!"

#, alchemy-end-wait
msgctxt "message"
msgid "05623"
msgstr "Au revoir."

#, alchemy-end-wait
msgctxt "message"
msgid "05624"
msgstr ""
"A notre prochain\n"
"combat."

#, alchemy-end-wait
msgctxt "message"
msgid "05625"
msgstr "Ils sont partis..."

#, alchemy-end-wait
msgctxt "message"
msgid "05626"
msgstr ""
"Mince... Nous n'avons\n"
"pas pu sauver {actor_name:6}..."

#, alchemy-end-wait
msgctxt "message"
msgid "05627"
msgstr ""
"Je ne mérite pas d'être\n"
"une guérisseuse..."

#, alchemy-end-wait
msgctxt "message"
msgid "05628"
msgstr ""
"Nous n'avons pas pu\n"
"les empêcher d'allumer\n"
"le phare."

#, alchemy-end-wait
msgctxt "message"
msgid "05629"
msgstr ""
"J'ai failli à mon\n"
"Clan, à mon devoir..."

#, alchemy-end-now
msgctxt "message"
msgid "05630"
msgstr ""
"C'est pas vrai!\n"
"On peut toujours les\n"
"avoir, hein, {actor_name:1}?"

#, alchemy-end-wait
msgctxt "message"
msgid "05631"
msgstr ""
"C'est vrai, {actor_name:1}!{page_break}"
"Tout ce qu'on a à faire,\n"
"c'est de les empêcher\n"
"d'allumer tous les phares!"

#, alchemy-end-wait
msgctxt "message"
msgid "05632"
msgstr ""
"Tu ne nous aides pas!{page_break}"
"Tout ira bien tant\n"
"qu'au moins un phare\n"
"reste éteint!"

#, alchemy-end-wait
msgctxt "message"
msgid "05633"
msgstr ""
"Le Phare de Mercure\n"
"est allumé, mais{page_break}"
"nous les arrêterons\n"
"la prochaine fois."

#, alchemy-end-wait
msgctxt "message"
msgid "05634"
msgstr ""
"C'est vrai. Nous pouvons\n"
"sauver {actor_name:6} au\n"
"prochain phare!"

#, alchemy-end-wait
msgctxt "message"
msgid "05635"
msgstr ""
"Oui. Nous ne laisserons\n"
"pas Alex s'en tirer\n"
"à si bon compte..."

#, alchemy-end-wait
msgctxt "message"
msgid "05636"
msgstr ""
"Poursuivons-les\n"
"maintenant!"

#, alchemy-end-wait
msgctxt "message"
msgid "05637"
msgstr ""
"Qu'y a-t-il?\n"
"Nous devrions nous\n"
"hâter!"

#, alchemy-end-wait
msgctxt "message"
msgid "05638"
msgstr ""
"Nous?\n"
"{actor_name:4}, viens-tu\n"
"avec nous?"

#, alchemy-end-wait
msgctxt "message"
msgid "05639"
msgstr ""
"Mais les habitants\n"
"d'Imil ont besoin\n"
"de toi, {actor_name:4}."

#, alchemy-end-wait
msgctxt "message"
msgid "05640"
msgstr "C'est OK."

#, alchemy-end-wait
msgctxt "message"
msgid "05641"
msgstr ""
"\"La fontaine sera\n"
"pleine tant que le\n"
"phare sera illuminé.\"{page_break}"
"C'est un vieux dicton.\n"
"De la fontaine couleront\n"
"les eaux de guérison."

#, alchemy-end-wait
msgctxt "message"
msgid "05642"
msgstr ""
"Mon coeur balance,\n"
"mais Imil ira bien\n"
"tant que la fontaine{page_break}"
"continuera à fournir\n"
"de l'Eau Miracle."

