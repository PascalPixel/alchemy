msgctxt "message"
msgid "06994"
msgstr "Garoh esiste per proteggere{line_break}la Roccia dell'Aria.{page_break}In cambio noi abbiamo{line_break}ricevuto questi poteri...{end_wait}"

msgctxt "message"
msgid "06995"
msgstr "Voi conoscete Turbine? La{line_break}maggior parte delle persone no...{page_break}Anche a Garoh, solo i{line_break}prescelti possono usarlo.{end_wait}"

msgctxt "message"
msgid "06996"
