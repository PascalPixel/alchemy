msgctxt "message"
msgid "08857"
msgstr "{protagonist_name} ottiene{line_break}{argument_item_name:2}.{end_wait}"

msgctxt "message"
msgid "08858"
msgstr "Sono felice di avervela data{line_break}prima della partenza.{end_wait}"

msgctxt "message"
msgid "08859"
msgstr "I vostri viaggi vi portano{line_break}di pericolo in pericolo.{line_break}State attenti.{end_wait}"

msgctxt "message"
msgid "08860"
