msgctxt "message"
msgid "08909"
msgstr "Stupida {actor_name:7}...{end_wait}"

msgctxt "message"
msgid "08910"
msgstr "Comunque, per ora, dovremmo{line_break}continuare verso il Faro di{line_break}Giove come stabilito.{end_wait}"

