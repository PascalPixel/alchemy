msgctxt "message"
msgid "03676"
msgstr "Si stanno tutti raccogliendo{line_break}a sud, sulla piazza.{end_wait}"

msgctxt "message"
msgid "03677"
msgstr "Non dobbiamo andare a{line_break}nord! Finiremo proprio{line_break}al Monte Aleph!{end_wait}"

msgctxt "message"
msgid "03678"
msgstr "La piazza è da questa{line_break}parte: dobbiamo andare{line_break}a sud.{end_wait}"

msgctxt "message"
msgid "03679"
msgstr "Non possiamo oltrepassare{line_break}questa roccia!{end_wait}"

msgctxt "message"
msgid "03680"
