OUTPUT_ARCH(arm)
ENTRY(Entry)
INCLUDE "games/THE LOST AGE/CONSTANTS.LD"

MEMORY
{
    EWRAM (rwx) : ORIGIN = 0x2000000, LENGTH = 256K
