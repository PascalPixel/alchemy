"Eh, {actor_name:1}, ¿vas a\n"
"luchar solo?{page_break}"
"Estarás\n"
"bromeando.{end_wait}"

msgctxt "message"
msgid "10550"
msgstr ""
"Vaya... ¿Y tengo\n"
"que aguantarme?{page_break}"
"Vale...\n"
"Estoy un poco\n"
"decepcionado.{end_wait}"

msgctxt "message"
msgid "10551"
msgstr ""
"Vaya... No debería\n"
