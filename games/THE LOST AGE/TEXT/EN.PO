msgid "05219"
msgstr "That was a great{line_break}battle..{line_break}What excitement!{end_wait}"

msgctxt "message"
msgid "05220"
msgstr "Too bad. Sometimes, you{line_break}have to be lucky to win.{line_break}Don't be too disappointed.{end_wait}"

