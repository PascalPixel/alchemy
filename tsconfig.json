{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    // Off deliberately, and for the whole scope rather than per file. This tree
    // parses ROM images: indexed byte access is its core operation and its
    // bounds are established by surrounding loop conditions, so the rule
    // produced 2,114 of 2,200 violations and would be paid for in non-null
    // assertions -- ceremony that hides the few genuine cases. Turning it on is
    // its own wave, not an exception list bolted to this one.
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "skipLibCheck": true
  },
  "include": ["tools/**/*.ts"],
  "exclude": ["tools/metrics/dashboard/client.ts"]
}
