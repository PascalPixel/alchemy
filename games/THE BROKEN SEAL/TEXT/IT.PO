msgid "07541"
msgstr "Volete far{line_break}partire la nave?{end_wait}"

msgctxt "message"
msgid "07542"
msgstr "Non possiamo partire con{line_break}un mare così pericoloso!{end_wait}"

msgctxt "message"
msgid "07543"
msgstr "Cos'è stato?{end_wait}"

msgctxt "message"
msgid "07544"
msgstr "Non ce ne importa nulla!{page_break}Noi abbiamo pagato, e ora{line_break}vogliamo vedere la{line_break}nave partire!{end_wait}"

msgctxt "message"
msgid "07545"
