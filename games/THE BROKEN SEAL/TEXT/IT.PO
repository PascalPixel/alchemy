msgctxt "message"
msgid "07787"
msgstr "Grrr...{pause_20_skippable} Non posso{line_break}credere di essere{line_break}stato scelto.{page_break}Non posso essere assegnato{line_break}ad un lavoro{line_break}così umile!{end_wait}"

msgctxt "message"
msgid "07788"
