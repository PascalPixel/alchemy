# clang-format's default (LLVM) style (Pascal, 2026-10-15).
BasedOnStyle: LLVM
# Include order is load-bearing here: it decides which declarations are in
# scope, and so the generated bytes.
SortIncludes:
  Enabled: false
# The integer types the games define, so that a cast such as (u32)&x is read
# as a cast and not as a bitwise and.
TypeNames: [s8, u8, s16, u16, s32, u32, s64, u64]
