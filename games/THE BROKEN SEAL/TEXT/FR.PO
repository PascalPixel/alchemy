msgctxt "message"
msgid "08797"
msgstr "Nous apprécions ton{line_break}geste, {actor_name:1}.{line_break}Suis-moi.{end_wait}"

msgctxt "message"
msgid "08798"
msgstr "Pourquoi es-tu{line_break}aussi têtu?{end_wait}"

msgctxt "message"
msgid "08799"
msgstr "{actor_name:2}, pourquoi tu{line_break}ne te ferais pas passer{line_break}pour notre chef...{page_break}Jusqu'à ce que nous{line_break}soyons dans la salle{line_break}des participants?{end_wait}"

msgctxt "message"
msgid "08800"
msgstr "Oui. Peut-être qu'une{line_break}fois là-bas, {actor_name:1}{line_break}aura changé d'avis.{end_wait}"

msgctxt "message"
msgid "08801"
msgstr "Parfait!{line_break}Allons-y!{end_wait}"

msgctxt "message"
msgid "08802"
msgstr "{actor_name:1}!{page_break}Réveille-toi, {actor_name:1}!{end_wait}"

msgctxt "message"
msgid "08803"
