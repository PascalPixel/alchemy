msgctxt "message"
msgid "09804"
msgstr "Pensavo di essere già morto!{line_break}È davvero una fortuna{line_break}che sia ancora vivo...{page_break}Quelle strane persone con{line_break}quei capelli... Erano troppo{line_break}forti per noi.{end_wait}"

msgctxt "message"
msgid "09805"
