msgid "08917"
msgstr "{actor_name:7}? {actor_name:8}?{line_break}Siete pronti?{end_wait}"

msgctxt "message"
msgid "08918"
msgstr "Allora andiamo,{line_break}giusto, {actor_name:5}?{end_wait}"

msgctxt "message"
msgid "08919"
msgstr "Oh! {actor_name:8}! Dopo il modo{line_break}in cui ti abbiamo trattato{line_break}pensavo che non saresti tornato!{page_break}So che non ci siamo comportati{line_break}bene... Spero potrai perdonarci.{end_wait}"

msgctxt "message"
msgid "08920"
msgstr "Shin ha sviluppato una paura{line_break}enorme del freddo. Teme{line_break}di diventare un ghiacciolo.{page_break}Di' a {actor_name:8} di smetterla con{line_break}il trucco del ghiaccio, OK?{end_wait}"

