msgctxt "message"
msgid "05908"
msgstr "Ils... {pause_20_skippable}sont en vie!{end_wait}"

msgctxt "message"
msgid "05909"
msgstr "Ils sont vivants!{end_wait}"

msgctxt "message"
msgid "05910"
msgstr ""
"Qu'est-ce donc?\n"
"Alex, que s'est-il passé?{end_wait}"

msgctxt "message"
msgid "05911"
msgstr ""
"{text_effect:4}{actor_name:1}, you are the final\n"
"warrior, and this shall not\n"
"be forgotten.{page_break}"
"{text_effect:6}I'll be here, so when you get\n"
"done checking things out, just\n"
"give me a call.{page_break}"
"{text_effect:2}All right?{end_wait}"

