msgctxt "message"
msgid "06856"
msgstr "Nessuno era al sicuro dai{line_break}champa... neanche le{line_break}donne innocenti!{page_break}Dovrei imparare{line_break}a difendermi!{end_wait}"

msgctxt "message"
msgid "06857"
msgstr "Sotto il letto,{line_break}ecco dov'ero...{page_break}Ma mica lo{line_break}dico!{end_wait}"

msgctxt "message"
msgid "06858"
msgstr "Chi ha un buon karma{line_break}si è salvato.{page_break}Chi ha un cattivo karma,{line_break}è stato ferito, sicuro...{end_wait}"

msgctxt "message"
msgid "06859"
msgstr "Se volete passare di qui,{line_break}avrete bisogno del{line_break}permesso dell'anziano!{end_wait}"

msgctxt "message"
msgid "06860"
msgstr "Senza permesso nessuno{line_break}passerà da questo ponte!{end_wait}"

msgctxt "message"
msgid "06861"
msgstr "Andate in Osenia?{end_now}"

msgctxt "message"
msgid "06862"
msgstr "Dovete tornare in città{line_break}e ottenere il permesso!{page_break}Andate alla casa dell'anziano{line_break}e chiedete gentilmente.{end_wait}"

msgctxt "message"
msgid "06863"
msgstr "Allora allontanatevi.{line_break}Queste zone possono{line_break}essere pericolose...{end_wait}"

msgctxt "message"
msgid "06864"
msgstr "Se avete il permesso, potete{line_break}passare in qualsiasi momento.{page_break}Ma se provate a passare{line_break}illegalmente, vi metteremo a far{line_break}compagnia al Sig. capelli blu!{end_wait}"

msgctxt "message"
msgid "06865"
