msgctxt "message"
msgid "07693"
msgstr "Potremo contare{line_break}su di loro?{end_wait}"

msgctxt "message"
msgid "07694"
msgstr "{actor_name:1} e i compagni{line_break}hanno lottato anche più{line_break}di me, non c'è proprio{page_break}nulla di cui{line_break}preoccuparsi.{end_wait}"

msgctxt "message"
msgid "07695"
msgstr "Kaja, se lo dici{line_break}tu ci fidiamo.{end_wait}"

msgctxt "message"
msgid "07696"
msgstr "E che succede se{line_break}uno di voi non potrà{line_break}più remare?{end_wait}"

msgctxt "message"
msgid "07697"
msgstr "Beh, non saprei...{line_break}Che succede in quel caso?!{end_wait}"

msgctxt "message"
msgid "07698"
msgstr "Un altro passeggero{line_break}aiuterà a remare.{end_wait}"

msgctxt "message"
msgid "07699"
msgstr "Nessun problema!{line_break}Ho già parlato{line_break}con i passeggeri.{end_wait}"

msgctxt "message"
msgid "07700"
msgstr "Chi andrà a dare gli{line_break}ordini quando sarà{line_break}il momento?{end_wait}"

msgctxt "message"
msgid "07701"
msgstr "Hmmm.{pause_20_skippable} Bella domanda...{end_wait}"

msgctxt "message"
msgid "07702"
msgstr "Tu dovrai andare a scegliere{line_break}un sostituto e{line_break}portarlo qui.{end_wait}"

msgctxt "message"
msgid "07703"
msgstr "Remare è un lavoro di squadra.{page_break}Bilancia sempre{line_break}le due squadre.{end_wait}"

msgctxt "message"
msgid "07704"
msgstr "È vero. Per remare{line_break}bene è importante{line_break}essere bilanciati.{end_wait}"

msgctxt "message"
msgid "07705"
msgstr "Bene. Ora conosci{line_break}gli ordini.{end_wait}"

msgctxt "message"
msgid "07706"
msgstr "So che farai del{line_break}tuo meglio.{end_wait}"

msgctxt "message"
msgid "07707"
msgstr "Preparazione...{pause_20_skippable} Completata!{end_wait}"

msgctxt "message"
msgid "07708"
msgstr "Rotta della nave...{pause_20_skippable} Libera!{end_wait}"

msgctxt "message"
msgid "07709"
msgstr "Bene! Molliamo gli ormeggi!{end_wait}"

msgctxt "message"
msgid "07710"
msgstr "Remate a tutta forza!{end_wait}"

msgctxt "message"
msgid "07711"
msgstr "Bene, siamo partiti!{end_wait}"

msgctxt "message"
msgid "07712"
msgstr "Stop!{end_wait}"

msgctxt "message"
msgid "07713"
msgstr "Avvistati dei mostri!{end_wait}"

msgctxt "message"
msgid "07714"
msgstr "Mostri?{end_wait}"

msgctxt "message"
msgid "07715"
msgstr "Sì, capitano!{line_break}Mostri marini!{end_wait}"

msgctxt "message"
msgid "07716"
