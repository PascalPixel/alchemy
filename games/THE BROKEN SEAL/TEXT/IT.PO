msgctxt "message"
msgid "07743"
msgstr "{text_effect:4}Aaah! Mostri{line_break}marini in carne ed ossa!{page_break}Pensavo di aver visto mostri{line_break}di ogni tipo, ma questi{line_break}mi mancavano!{end_wait}"

msgctxt "message"
msgid "07744"
