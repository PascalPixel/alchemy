msgctxt "message"
msgid "07536"
msgstr "Davvero...{end_wait}"

msgctxt "message"
msgid "07537"
msgstr "Ah!{pause_20_skippable} A rischio di dire{line_break}sempre le stesse cose, ripeto:{line_break}non ho fatto niente!{end_wait}"

msgctxt "message"
msgid "07538"
