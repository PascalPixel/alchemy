"Voulez-vous combattre un\n"
"monstre plus puissant?{end_now}"

msgctxt "message"
msgid "05578"
msgstr ""
"Vous {text_effect:2}êtes{reset_text_style} doués!\n"
"Voulez-vous combattre le\n"
"monstre suivant?{end_now}"

msgctxt "message"
msgid "05579"
msgstr ""
"Vous êtes forts!\n"
"Voulez-vous combattre un\n"
"monstre plus puissant?{end_now}"

msgctxt "message"
msgid "05580"
msgstr ""
"Vous êtes forts!\n"
"Voulez-vous combattre le\n"
"monstre suivant?{end_now}"

msgctxt "message"
msgid "05581"
msgstr ""
"Vous êtes très forts!\n"
"Voulez-vous combattre un\n"
"monstre très puissant?{end_now}"

msgctxt "message"
msgid "05582"
msgstr ""
"Vous êtes très forts!\n"
"Voulez-vous combattre le\n"
"monstre suivant?{end_now}"

msgctxt "message"
msgid "05583"
msgstr ""
"Vous êtes incroyables!{page_break}"
"Voulez-vous combattre\n"
"un des monstres les\n"
"plus forts?{end_now}"

msgctxt "message"
msgid "05584"
msgstr ""
"Vous êtes incroyables!\n"
"Voulez-vous combattre le\n"
"monstre suivant?{end_now}"

msgctxt "message"
msgid "05585"
msgstr ""
"Vous êtes étonnants!!!{page_break}"
"Voulez-vous combattre\n"
