msgctxt "message"
msgid "08376"
msgstr "Por favor, mira allí.{end_wait}"

msgctxt "message"
msgid "08377"
msgstr ""
"Ése es el punto de\n"
"salida de la primera\n"
"fase de las finales.{end_wait}"

