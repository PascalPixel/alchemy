msgctxt "message"
msgid "07683"
msgstr "Hanno chiesto ai passeggeri{line_break}di aiutare a remare...{page_break}Il viaggio si preannuncia{line_break}pieno di problemi.{end_wait}"

msgctxt "message"
msgid "07684"
