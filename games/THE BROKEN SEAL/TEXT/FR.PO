msgctxt "message"
msgid "08787"
msgstr "Bien, par ici, je{line_break}vous prie.{end_wait}"

msgctxt "message"
msgid "08788"
msgstr "{actor_name:1}! Vous ne pouvez{line_break}pas {text_effect:2}assister{reset_text_style} aux finales!{line_break}Vous y combattez!{end_wait}"

msgctxt "message"
msgid "08789"
