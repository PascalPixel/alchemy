msgctxt "message"
msgid "07639"
msgstr "Rimane una sola{line_break}cosa da fare...{end_wait}"

msgctxt "message"
msgid "07640"
msgstr "Oh, no... Che altro c'è?{end_wait}"

msgctxt "message"
msgid "07641"
msgstr "Servono volontari che{line_break}in caso d'emergenza{line_break}possano remare.{end_wait}"

msgctxt "message"
msgid "07642"
