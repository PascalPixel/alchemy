msgctxt "message"
msgid "07610"
msgstr "Nessuno può aver rubato{line_break}quel ciondolo... Sarà qui,{line_break}da qualche parte.{end_wait}"

msgctxt "message"
msgid "07611"
msgstr "Se la nave non parte{line_break}subito potremmo perderci{line_break}il Colossum.{end_wait}"

msgctxt "message"
msgid "07612"
msgstr "Questa storia si{line_break}sta facendo pericolosa.{line_break}Devo confessare di averlo{page_break}nascosto in cima{line_break}all'albero della nave.{end_wait}"

msgctxt "message"
msgid "07613"
