msgstr "Fresh omelettes!{page_break}Bilibin omelettes use{line_break}Wild Mushrooms{line_break}caught in the area.{end_wait}"

msgctxt "message"
msgid "05357"
msgstr "There's a book{line_break}entitled \"All About Items.\"{page_break}According to the book,{line_break}there are many unknown{line_break}items in the world.{end_wait}"

