#, alchemy-end-wait
msgctxt "MsgVaultMasterHammetsServantCantReturnTo"
msgid "04618"
msgstr ""
"Le serviteur de Maître\n"
"Hammet ne peut pas{page_break}"
"retourner à Kalay sans\n"
