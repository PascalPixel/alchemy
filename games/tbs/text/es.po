msgctxt "message"
msgid "10477"
msgstr ""
"Sea lo que sea, esta\n"
"será la primera vez\n"
"que surquemos el océano.{end_wait}"

msgctxt "message"
msgid "10478"
msgstr ""
"Entonces, éste es el\n"
"océano que Kraden\n"
"quería que viera.{end_wait}"

msgctxt "message"
msgid "10479"
msgstr ""
"Hay muchas olas.\n"
"¿Creéis que estaremos\n"
