"Y a pas de problème."

#, alchemy-end-wait
msgctxt "message"
msgid "09439"
msgstr ""
"Bien, comme vous voulez.{page_break}"
"Revenez ici quand vous\n"
"voulez."

#, alchemy-end-now
msgctxt "MsgLunpaInnClerkAsksAboutGuest"
msgid "09440"
msgstr ""
"Etes-vous l'invité\n"
"de Donpa?"

#, alchemy-end-wait
msgctxt "message"
msgid "09441"
msgstr ""
"Alors, vous êtes celui\n"
