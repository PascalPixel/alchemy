msgstr "{actor_name:5} e il suo gruppo{line_break}passano la notte{line_break}nella locanda.{end_wait}"

msgctxt "message"
msgid "07097"
msgstr "Non avete dormito molto{line_break}l'altra notte... Sembra che non{line_break}abbiate riposato affatto.{end_wait}"

msgctxt "message"
msgid "07098"
msgstr "Il Capobranco Maha ci ha detto{line_break}tutto di voi. Non preoccupatevi{line_break}per il conto, ci pensiamo noi.{end_wait}"

msgctxt "message"
msgid "07099"
msgstr "Addio, amici.{end_wait}"

msgctxt "message"
msgid "07100"
msgstr "Il Capobranco Maha{line_break}dice che anche voi{line_break}siete speciali...{page_break}Non c'è bisogno che{line_break}vi teniamo nascosto{line_break}il nostro segreto!{end_wait}"

msgctxt "message"
msgid "07101"
