msgctxt "MsgBabiLighthouseThereWereStrangeFolkGoingTo"
msgid "09882"
msgstr ""
"Vimos unos tipos extraños\n"
"yendo hacia las ruinas...\n"
"Faran los siguió.{end_wait}"

msgctxt "MsgBabiLighthouseItsOddThatBabiWouldBuild"
msgid "09883"
msgstr ""
"Es raro que Babi construyera\n"
"un faro en un sitio como este.{page_break}"
"Quizás pensó que usando\n"
"las ruinas como cimientos,\n"
"sería más fácil.{end_wait}"

msgctxt "MsgBabiLighthouseCuttingTheseStonesAndStackingThem"
msgid "09884"
msgstr ""
"Cortar estas rocas y\n"
"encajarlas en las\n"
"ruinas no es fácil.{page_break}"
"¿Que lo hagamos más\n"
"rápido? ¡Entonces intenta\n"
"hacerlo tú mismo!{end_wait}"

msgctxt "MsgLaliveroIfOnlyTheyDidntHaveActor"
msgid "09885"
msgstr ""
"Ojalá no tuvieran a\n"
"{actor_name:7} prisionera...{page_break}"
"Pero aunque no la hubieran\n"
"tomado como rehén, no habríamos\n"
"podido con ellos.{end_wait}"

msgctxt "MsgLaliveroTheyUsedFireOnUsThats"
msgid "09886"
msgstr ""
"¡Usaron fuego contra nosotros!\n"
"¡Eso no está bien!{end_wait}"

msgctxt "MsgLaliveroCursesWeCouldntStopActorAnd"
msgid "09887"
msgstr ""
"¡Maldición! No pudimos detener\n"
"a {actor_name:7} ni a los otros...{end_wait}"

msgctxt "MsgLaliveroWhatDoTheyPlanToDo"
msgid "09888"
msgstr ""
"¿Qué planean hacer con\n"
"{actor_name:7} en las ruinas...?{page_break}"
"No... No debo pensar en\n"
"cosas tan escabrosas...{end_wait}"

msgctxt "MsgLaliveroWeNeverShouldHaveLetTolbi"
msgid "09889"
msgstr ""
"Nunca debimos dejar que\n"
"Tolbi apartara a {actor_name:7}\n"
"de nosotros.{end_wait}"

msgctxt "MsgLaliveroFaranStillDoesNotReturnWhat"
msgid "09890"
msgstr ""
"Faran no ha regresado aún...\n"
"¿Qué estará sucediendo?{end_wait}"

msgctxt "MsgLaliveroWeHaveSeenManyOmensOf"
msgid "09891"
msgstr ""
"Han ocurrido muchas cosas\n"
"que auguran lo peor.{page_break}"
"Vimos una cuando {actor_name:7}\n"
"fue tomada de Lalivero...{end_wait}"

msgctxt "MsgLaliveroTheStonesWeStackedForThe"
msgid "09892"
msgstr ""
"Las piedras que colocamos\n"
"para el faro no se caerán,\n"
"¿a que no?{end_wait}"

msgctxt "MsgLaliveroITriedToStepInFront"
msgid "09893"
msgstr ""
"Intenté ponerme delante\n"
"de ellos para salvarla...{page_break}"
"Pero mi corazón\n"
"temblaba...\n"
"No pude detenerles...{end_wait}"

msgctxt "MsgLaliveroTheyAllHaveALessonComing"
msgid "09894"
msgstr ""
"Todos van a aprender\n"
"una lección.{page_break}"
"¡Aprenderán por qué {actor_name:7}\n"
"se llama la hija sagrada\n"
"de Lalivero!{end_wait}"

msgctxt "MsgBabiLighthouseThereWasABigFightThat"
msgid "09895"
msgstr ""
"Hubo una gran pelea\n"
"que terminó con unos\n"
"rehenes capturados.{page_break}"
"Trágico, lo sé, pero cualquier\n"
"cosa que me aparte del trabajo\n"
"no puede ser mala.{end_wait}"

msgctxt "MsgBabiLighthouseIfFaranWentAfterThemThen"
msgid "09896"
msgstr ""
"¡Si Faran fue tras ellos,\n"
"entonces esto debe ser serio!{page_break}"
"Si seguimos así, no\n"
"terminaremos de\n"
"construir el faro.{end_wait}"

msgctxt "MsgBabiLighthouseWhyWouldTheyWantToRush"
msgid "09897"
msgstr ""
"¿Por qué querrían acelerar\n"
"la construcción del faro?{page_break}"
"Quizás esperan dominar\n"
"los mares y controlar\n"
"tierras más distantes...{end_wait}"

msgctxt "MsgBabiLighthouseNowThatIThinkOfIt"
msgid "09898"
msgstr ""
"Ahora que lo pienso,\n"
"encontramos una cueva\n"
"extraña en la cantera.{end_wait}"

msgctxt "MsgLaliveroInteriorsOfCourseIHaveSeenActor"
msgid "09899"
msgstr ""
"Por supuesto que he\n"
"visto el poder de {actor_name:7}...\n"
"¡Es increíble!{page_break}"
"¿Cómo podría alguien\n"
"con tal poder ser\n"
"capturado como rehén?{end_wait}"

msgctxt "MsgLaliveroInteriorsThereAreSomeWhoDoNot"
msgid "09900"
msgstr ""
"Hay algunos que no creen\n"
"que {actor_name:7} tenga poderes...{page_break}"
"¿Dudar de {actor_name:7}?\n"
"¡Tonterías!{end_wait}"

msgctxt "MsgLaliveroInteriorsCouldFaranHaveTrickedUsAll"
msgid "09901"
msgstr ""
"A lo mejor, Faran se ha\n"
"burlado de nosotros.{page_break}"
