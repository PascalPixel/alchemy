.DS_Store
*.gba
out/
tools/out/
# Worktree convenience symlink to the shared ROM set.
/roms
# Native pixel, palette, packed map and unidentified byte inputs of every game
# are private: recon/<game>/private-inputs.json registers them and
# `alchemy build assets --extract-sources ROM [--target TARGET]` regenerates
# them from the verified local ROM.
/games/*/SRC/**/CHR.PNG
/games/*/SRC/**/*_CHR.PNG
/games/*/SRC/**/*.BIN
/games/*/SRC/GRAPHICS/COMMON/PALETTE.JSON
/games/*/SRC/GRAPHICS/COMMON/STILL.PNG
/games/*/SRC/GRAPHICS/COMMON/TILE.PNG
/games/*/SRC/GRAPHICS/COMMON/PORTRAIT.PNG
/games/*/SRC/GRAPHICS/COMMON/TILE_BANK.PNG
/games/*/SRC/GRAPHICS/CHARACTER/CHAR_*.PNG
/games/*/SRC/GRAPHICS/CHARACTER/BATTLE_*.PNG
