"¡Qué horror!{end_wait}"

msgctxt "MsgLaliveroOhhTheyTookShebaHeaded"
msgid "09873"
msgstr ""
"{text_effect:4}Ohh...{reset_text_style} Cogieron a {actor_name:7}\n"
